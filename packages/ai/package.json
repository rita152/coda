{
	"name": "@coda/ai",
	"version": "0.1.0",
	"description": "Provider-neutral model access for the Coda coding agent",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./providers/opencode-go": {
			"types": "./dist/providers/opencode-go.d.ts",
			"import": "./dist/providers/opencode-go.js"
		},
		"./providers/opencode-go.models": {
			"types": "./dist/providers/opencode-go.models.d.ts",
			"import": "./dist/providers/opencode-go.models.js"
		},
		"./api/anthropic-messages": {
			"types": "./dist/api/anthropic-messages.d.ts",
			"import": "./dist/api/anthropic-messages.js"
		},
		"./api/anthropic-messages.lazy": {
			"types": "./dist/api/anthropic-messages.lazy.d.ts",
			"import": "./dist/api/anthropic-messages.lazy.js"
		},
		"./api/openai-completions": {
			"types": "./dist/api/openai-completions.d.ts",
			"import": "./dist/api/openai-completions.js"
		},
		"./api/openai-completions.lazy": {
			"types": "./dist/api/openai-completions.lazy.d.ts",
			"import": "./dist/api/openai-completions.lazy.js"
		},
		"./api/openai-responses": {
			"types": "./dist/api/openai-responses.d.ts",
			"import": "./dist/api/openai-responses.js"
		},
		"./api/openai-responses.lazy": {
			"types": "./dist/api/openai-responses.lazy.d.ts",
			"import": "./dist/api/openai-responses.lazy.js"
		}
	},
	"files": [
		"compatibility",
		"dist",
		"LICENSE",
		"README.md",
		"src/providers/data/manifest.json",
		"src/providers/data/opencode-go.changes.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p tsconfig.json && biome check src test scripts vitest.config.ts vitest.live.config.ts",
		"models:update": "tsx scripts/update-opencode-go-models.ts",
		"test": "vitest run",
		"test:live": "vitest run --config vitest.live.config.ts",
		"pack:dry-run": "npm pack --dry-run"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.91.1",
		"openai": "6.26.0",
		"partial-json": "0.1.7",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"tsx": "4.22.1",
		"vitest": "4.1.9"
	},
	"license": "MIT"
}
