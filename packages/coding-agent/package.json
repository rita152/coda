{
	"name": "@coda/coding-agent",
	"version": "0.1.0",
	"description": "Terminal Coding Agent application for Coda",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"bin": {
		"coda": "./dist/bin.js"
	},
	"exports": {},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/mark-bin-executable.mjs dist/bin.js",
		"check": "tsc --noEmit -p tsconfig.json && biome check src test scripts vitest*.config.ts",
		"test": "vitest run",
		"test:live": "vitest run --config vitest.live.config.ts",
		"test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
		"pack:dry-run": "npm pack --dry-run"
	},
	"dependencies": {
		"@coda/agent": "0.1.0",
		"@coda/ai": "0.1.0",
		"@coda/mcp": "0.1.0",
		"@coda/permission": "0.1.0",
		"@coda/runtime": "0.1.0",
		"@coda/sandbox": "0.1.0",
		"@coda/skills": "0.1.0",
		"@coda/tui": "0.1.0",
		"@mozilla/readability": "^0.6.0",
		"fflate": "^0.8.3",
		"jsdom": "^29.1.1",
		"mammoth": "^1.12.1",
		"pdfjs-dist": "^6.2.108",
		"sharp": "0.34.4",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"undici": "^7.29.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/jsdom": "^30.0.0",
		"@types/node": "24.12.4",
		"@types/turndown": "^5.0.6",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"license": "MIT"
}
