{
	"name": "@coda/evals",
	"version": "0.1.0",
	"description": "Deterministic behavioral evaluation harness for Coda's Agent",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"fixtures",
		"pier/*.py",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p tsconfig.json && biome check src test scripts vitest.config.ts",
		"test": "vitest run && npm run test:pier",
		"test:pier": "python3 -B -m unittest discover -s test/pier -p 'test_*.py'",
		"eval:deep-swe": "tsx scripts/deep-swe.ts",
		"eval:offline": "tsx scripts/offline.ts",
		"eval:live": "tsx scripts/live.ts"
	},
	"dependencies": {
		"@coda/agent": "0.1.0",
		"@coda/ai": "0.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"tsx": "4.22.1",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"license": "MIT"
}
