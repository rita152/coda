	},
	"limits": {
		"maxTurns": 5,
		"maxTools": 4,
		"maxRepeatedToolBatches": 0,
		"maxPermissionEscalationAttempts": 1,
		"maxElapsedMs": 900,
		"minScore": 90
	},
	"toolElapsedMs": 10
}
