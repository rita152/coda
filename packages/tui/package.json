{
	"name": "@coda/tui",
	"version": "0.1.0",
	"description": "Full-screen terminal lifecycle and rendering primitives for Coda",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p tsconfig.json && biome check src test vitest.config.ts",
		"test": "vitest run",
		"pack:dry-run": "npm pack --dry-run"
	},
	"dependencies": {
		"@coda/ai": "0.1.0",
		"get-east-asian-width": "1.6.0",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-gfm": "3.1.0",
		"micromark-extension-gfm": "3.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"license": "MIT"
}
