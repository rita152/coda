{
  "name": "coda",
  "version": "0.0.1",
  "private": true,
  "description": "TypeScript terminal coding agent — internal protocol core with provider adapters (see docs/)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "coda": "./dist/main.js"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./coding-capabilities": {
      "types": "./dist/integrations/coding-capabilities/index.d.ts",
      "import": "./dist/coding-capabilities/index.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "lint": "bun run --bun eslint . --max-warnings 0",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun --no-env-file run scripts/test.ts",
    "test:unit": "bun --no-env-file run scripts/test.ts unit",
    "test:e2e": "bun --no-env-file run scripts/test.ts e2e",
    "check": "bun run lint && bun run typecheck && bun run test",
    "demo:m1": "bun run scripts/demo-m1.ts",
    "smoke": "bun run scripts/smoke-stream.ts",
    "smoke:anthropic": "bun run scripts/smoke-anthropic.ts",
    "record:fixture": "bun run scripts/record-fixture.ts",
    "record:anthropic": "bun run scripts/record-fixture-anthropic.ts",
    "fixtures:openai-responses": "bun run scripts/generate-openai-responses-fixtures.ts",
    "fixtures:provider-models": "bun run scripts/generate-provider-model-fixtures.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/diff": "^7.0.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@opentui/core": "^0.4.5",
    "@vscode/ripgrep": "^1.18.0",
    "diff": "^9.0.0",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  }
}
