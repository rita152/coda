{
  "name": "coda",
  "version": "0.0.1",
  "private": true,
  "description": "TypeScript terminal coding agent — internal protocol core with provider adapters (see docs/)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "coda": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test",
    "demo:m1": "tsx scripts/demo-m1.ts",
    "smoke": "tsx scripts/smoke-stream.ts",
    "record:fixture": "tsx scripts/record-fixture.ts"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "rollup": "^4.62.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.3",
    "@rollup/rollup-linux-x64-gnu": "^4.62.3",
    "@vscode/ripgrep-darwin-arm64": "^1.18.0",
    "@vscode/ripgrep-linux-x64": "^1.18.0"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "diff": "^9.0.0",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  }
}
