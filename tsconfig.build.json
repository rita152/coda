{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/capabilities/**/*.ts",
    "src/integrations/legacy-coding-tools/**/*.ts",
    "src/protocol/**/*.ts",
    "src/runtime/**/*.ts",
    "src/shared/**/*.ts",
    "src/tools/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
